(** One client's garbage leaves the others alone, a silent TCP close is an error, and a client that says nothing is closed. *)
use std/tls
use std/http
use std/net
use std/sys
use std/fiber
use std/io
use std/result
use std/text

served = net.Listen(0)!   (* a port the system gives free *)
port = net.Port(served)

crlf = "\r\n"

defn garbage()
  c = net.Connect("127.0.0.1", port)?
  net.Write(c, "this is not TLS at all")?
  net.Read(c)
  net.Close(c)
  result.Ok(missing)
end

defn mute()
  c = net.Connect("127.0.0.1", port)?
  got = net.Read(c)
  net.Close(c)
  io.Print("mute client closed", result.IsOk(got) and text.ByteLength(got.Value) == 0)
  result.Ok(missing)
end

defn truncating(wrap, listener)
  c = net.Accept(listener)?
  conn = wrap(c)?
  conn.Read()?
  conn.Write("HTTP/1.1 200 OK$crlf$(crlf)partial")?
  net.Close(c)
  net.Close(listener)
  result.Ok(missing)
end

defn main()
  api = tls.Open()?
  wrap = tls.Server(sys.Args[1], sys.Args[2], api)?
  a = http.Get("/", req -> http.Plain("over tls"), http.App())
  fiber.Spawn(() -> http.Serve(a, listener = served, wrap = wrap, timeout = 0.2))
  sys.Sleep(0.05)
  client = tls.Client(api, verify = false)
  for k in 1..20
    garbage()?
  end
  io.Print(http.Fetch("https://127.0.0.1:$port/", secure = client) then result.MapOk(it.Body))
  mute()?
  cut = net.Listen(0)?
  fiber.Spawn(() -> truncating(wrap, cut))
  sys.Sleep(0.02)
  io.Print(http.Fetch("https://127.0.0.1:$(net.Port(cut))/", secure = client) then result.MapErr(it.Message))
  result.Ok(missing)
end

io.Print(main())
