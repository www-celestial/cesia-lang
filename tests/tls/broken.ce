(** One client's garbage leaves the others alone, a silent TCP close is an error, and a client that says nothing is closed. *)
use std/tls
use std/web
use std/http
use std/net
use std/sys
use std/fiber
use std/io
use std/result
use std/text

crlf = "\r\n"

defn garbage()
  c = net.Connect("127.0.0.1", 18208)?
  net.Write(c, "this is not TLS at all")?
  net.Read(c)
  net.Close(c)
  result.Ok(missing)
end

defn mute()
  c = net.Connect("127.0.0.1", 18208)?
  got = net.Read(c)
  net.Close(c)
  io.Print("mute client closed", result.IsOk(got) and text.ByteLength(got.Value) == 0)
  result.Ok(missing)
end

defn truncating(wrap)
  listener = net.Listen(18209)?
  c = net.Accept(listener)?
  io = wrap(c)?
  io.Read()?
  io.Write("HTTP/1.1 200 OK$crlf$(crlf)partial")?
  net.Close(c)
  net.Close(listener)
  result.Ok(missing)
end

defn main()
  api = tls.Open()?
  wrap = tls.Server(sys.Args[1], sys.Args[2], api)?
  a = web.Get("/", req -> web.Plain("over tls"), web.App())
  fiber.Spawn(() -> web.Serve(a, port = 18208, wrap = wrap, timeout = 0.2))
  sys.Sleep(0.05)
  client = tls.Client(api, verify = false)
  for k in 1..20
    garbage()?
  end
  io.Print(http.Get("https://127.0.0.1:18208/", secure = client) then result.MapOk(it.Body))
  mute()?
  fiber.Spawn(() -> truncating(wrap))
  sys.Sleep(0.02)
  io.Print(http.Get("https://127.0.0.1:18209/", secure = client) then result.MapErr(it.Message))
  result.Ok(missing)
end

io.Print(main())
