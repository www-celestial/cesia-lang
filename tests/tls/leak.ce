(** Failed handshakes give back their memory: this limit stops the server otherwise. *)
use std/tls
use std/http
use std/net
use std/sys
use std/fiber
use std/io
use std/result

defn garbage()
  c = net.Connect("127.0.0.1", 18210)?
  net.Write(c, "not TLS")?
  net.Read(c)
  net.Close(c)
  result.Ok(missing)
end

defn main()
  api = tls.Open()?
  wrap = tls.Server(sys.Args[1], sys.Args[2], api)?
  fiber.Spawn(() -> http.Serve(http.App(), port = 18210, wrap = wrap))
  sys.Sleep(0.05)
  for k in 1..600
    garbage()?
  end
  io.Print("done")
  result.Ok(missing)
end

io.Print(main())
