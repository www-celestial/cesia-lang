(** The window waits without stopping the other fibers: only one of them can end it. *)
use tests/sdl/probe
use std/sdl
use std/sys
use std/fiber
use std/io
use std/result

update(event, state) = match event
  {Kind: "quit"} -> missing
  else -> state
end

view(state) = [{Kind: "clear", Color: 0x000000}]

defn worker()
  for i in 1..5
    sys.Sleep(0.002)
  end
  io.Print("the worker ran")
  probe.PushQuit()
end

defn check()
  window = sdl.Open("test", 320, 200, "../../examples/fonts/JetBrainsMono-Regular.ttf")?
  fiber.Spawn(worker)
  io.Print(sdl.Run("state", update, view, window))
  result.Ok(missing)
end

io.Print(check())
