use tests/sdl/probe
use std/sdl
use std/sys
use std/fiber
use std/io
use std/result

defn update(event, state)
  match event
    {Kind: "quit"} -> missing
    {Kind: "tick"} -> {Ticks: state.Ticks + 1}
    else -> state
  end
end

defn view(state)
  io.Print("view")
  [{Kind: "clear", Color: 0x000000}]
end

defn later()
  sys.Sleep(0.05)
  probe.PushQuit()
end

defn check()
  w = sdl.Open("test", 320, 200, "../../examples/fonts/JetBrainsMono-Regular.ttf")?
  fiber.Spawn(later)
  last = sdl.Run({Ticks: 0}, update, view, w)
  io.Print(last.Ticks)
  result.Ok("ran")
end

io.Print(check())
