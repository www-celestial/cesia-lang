-- The window waits without stopping the other fibers: only one of them can end it.
use "./probe"
use sdl
use sys

update(event, state) = match event
  {kind: "quit"} -> missing
  else -> state
end

view(state) = [{kind: "clear", color: 0x000000}]

defn worker()
  for i in 1:5
    sys.sleep(0.002)
  end
  print("the worker ran")
  probe.push_quit()
end

defn check()
  window = sdl.open("test", 320, 200, "../../fonts/JetBrainsMono-Regular.ttf")?
  spawn(worker)
  print(sdl.run("state", update, view, window))
  Ok(missing)
end

print(check())
