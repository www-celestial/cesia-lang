use tests/sdl/probe
use std/sdl
use std/io
use std/math
use std/result

white = 0xFFFFFF

defn check()
  w = sdl.Open("test", 320, 200, "../../examples/fonts/JetBrainsMono-Regular.ttf")?
  a = sdl.Draw([{Kind: "clear", Color: white}, {Kind: "shadow", X: 100, Y: 60, Width: 120, Height: 60, Alpha: 200}], w)
  image = probe.Pixels(a, 320, 200)
  io.Print(math.Mod(probe.Pixel(160, 124, image), 256) < 200)
  io.Print(probe.Pixel(20, 20, image) == white)
  io.Print(probe.Pixel(300, 180, image) == white)
  b = sdl.Draw([{Kind: "clear", Color: white}, {Kind: "shadow", X: 140, Y: 80, Width: 40, Height: 20, Alpha: 200}], a)
  small = probe.Pixels(b, 320, 200)
  io.Print(math.Abs(math.Mod(probe.Pixel(135, 90, small), 256) - math.Mod(probe.Pixel(184, 90, small), 256)) <= 8)
  io.Print(math.Mod(probe.Pixel(135, 90, small), 256) < 250)
  io.Print(math.Abs(math.Mod(probe.Pixel(160, 90, small), 256) - math.Mod(probe.Pixel(150, 90, small), 256)) <= 8)
  io.Print(math.Mod(probe.Pixel(160, 74, small), 256) >= math.Mod(probe.Pixel(160, 90, small), 256))
  io.Print(math.Abs(math.Mod(probe.Pixel(150, 90, small), 256) - math.Mod(probe.Pixel(170, 90, small), 256)) <= 4)
  c1 = sdl.Draw([{Kind: "clear", Color: white}, {Kind: "shadow", X: 140, Y: 80, Width: 0, Height: 20, Alpha: 200}], b)
  sdl.Frame([{Kind: "clear", Color: white}], c1)
  io.Print(sdl.Close(c1))
  result.Ok("closed")
end

io.Print(check())
