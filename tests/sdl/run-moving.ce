use tests/sdl/probe
use std/sdl
use std/sys
use std/fiber
use std/io
use std/result

defn tick(event, state)
  if event.Seconds <= 0.0 or event.Seconds > 0.05
    io.Print("bad seconds $(event.Seconds)")
  end
  if state.Left == 3
    sys.Sleep(0.07)
  end
  {Left: state.Left - 1}
end

defn update(event, state)
  match event
    {Kind: "quit"} -> missing
    {Kind: "tick"} -> tick(event, state)
    else -> state
  end
end

defn view(state)
  io.Print("view $(state.Left)")
  [{Kind: "clear", Color: 0x000000}]
end

defn later()
  sys.Sleep(0.1)
  probe.PushQuit()
end

defn check()
  w = sdl.Open("test", 320, 200, "../../examples/fonts/JetBrainsMono-Regular.ttf")?
  fiber.Spawn(later)
  last = sdl.Run({Left: 5}, update, view, w, moving = s -> s.Left > 0)
  io.Print(last.Left)
  result.Ok("ran")
end

io.Print(check())
