use std/sdl
use std/io
use std/result

defn check()
  window = sdl.Open("test", 320, 200, "../../examples/fonts/JetBrainsMono-Regular.ttf")?
  one = sdl.TextSize("a", window)
  two = sdl.TextSize("aa", window)
  io.Print(two.Width == 2 * one.Width, one.Height > 0, one.Width > 0)
  result.Ok(missing)
end

io.Print(check())
