use "./probe"
use sdl
use sys

defn update(event, state)
  match event
    {kind: "quit"} -> missing
    {kind: "tick"} -> {ticks: state.ticks + 1}
    else -> state
  end
end

defn view(state)
  print("view")
  [{kind: "clear", color: 0x000000}]
end

defn later()
  sys.sleep(0.05)
  probe.push_quit()
end

defn check()
  w = sdl.open("test", 320, 200, "../../examples/fonts/JetBrainsMono-Regular.ttf")?
  spawn(later)
  last = sdl.run({ticks: 0}, update, view, w)
  print(last.ticks)
  Ok("ran")
end

print(check())
