(** A window event asks for a frame and wakes no update: under Wayland, the frame of the window applies only with the next frame. *)
use tests/sdl/probe
use std/sdl
use std/sys
use std/fiber
use std/io
use std/result

defn noted(state)
  io.Print("update")
  state
end

defn update(event, state)
  match event
    {Kind: "quit"} -> missing
    else -> noted(state)
  end
end

defn view(state)
  io.Print("view")
  [{Kind: "clear", Color: 0x000000}]
end

defn later()
  sys.Sleep(0.05)
  io.Print("exposed")
  probe.Push(0x204, [])
  sys.Sleep(0.05)
  io.Print("quit")
  probe.PushQuit()
end

defn check()
  w = sdl.Open("test", 320, 200, "../../examples/fonts/JetBrainsMono-Regular.ttf")?
  fiber.Spawn(later)
  sdl.Run(0, update, view, w)
  result.Ok("ran")
end

io.Print(check())
