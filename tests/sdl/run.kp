use "./probe"
use sdl
use sys

function update(event, state)
  match event
    {kind: "quit"} -> missing
    {kind: "text", text} -> {typed: "$(state.typed)$text"}
    else -> state
  end
end

function view(state)
  print("view ""$(state.typed)""")
  [{kind: "clear", color: 0x000000}, {kind: "text", x: 8, y: 8, text: state.typed, color: 0xFFFFFF}]
end

function later()
  sys.sleep(0.03)
  probe.push_text([0x63])
  probe.push_quit()
end

function check()
  window = sdl.open("test", 320, 200, "../../kepacs/fonts/JetBrainsMono-Regular.ttf")?
  probe.push_text([0x61])
  probe.push_text([0x62])
  spawn(later)
  print(sdl.run({typed: ""}, update, view, window))
  sdl.close(window)
  Ok(missing)
end

print(check())
