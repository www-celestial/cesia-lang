-- A window event asks for a frame and wakes no update: under Wayland, the frame of the window applies only with the next frame.
use "./probe"
use sdl
use sys

defn noted(state)
  print("update")
  state
end

defn update(event, state)
  match event
    {kind: "quit"} -> missing
    else -> noted(state)
  end
end

defn view(state)
  print("view")
  [{kind: "clear", color: 0x000000}]
end

defn later()
  sys.sleep(0.05)
  print("exposed")
  probe.push(0x204, [])
  sys.sleep(0.05)
  print("quit")
  probe.push_quit()
end

defn check()
  w = sdl.open("test", 320, 200, "../../examples/fonts/JetBrainsMono-Regular.ttf")?
  spawn(later)
  sdl.run(0, update, view, w)
  Ok("ran")
end

print(check())
