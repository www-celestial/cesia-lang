use std/sdl
use std/fiber
use std/io
use std/list
use std/result
use std/text

font = "../../examples/fonts/JetBrainsMono-Regular.ttf"
line(words) = {Kind: "text", X: 10, Y: 10, Text: words, Color: 0xFFFFFF}
long = text.Join("", list.Fill("a", 5000))

defn check()
  window = sdl.Open("test", 320, 200, font)?
  once = sdl.Draw(list.Map(line, ["", "é€", "😀", long]), window)
  io.Print("drawn")
  match fiber.Wait(fiber.Spawn(() -> sdl.Draw([line("a$(text.Char(0))b")], once)))
    result.Err(e) -> io.Print(e.Message)
    else -> io.Print("no panic")
  end
  result.Ok(missing)
end

io.Print(check())
