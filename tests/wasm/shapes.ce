use std/io
use std/value
use std/result

(* Maps of literals whose keys and kinds the compiler knows hold their values typed; everything else sees maps. *)
defn moved(n)
  ps = [{X: i * 1.0, Y: 0.5, N: i} for i in 1..n]
  for i in 1..n
    p = ps[i]
    dy = p.Y * 2.0
    ps[i] = {X: p.X + dy, Y: dy, N: p.N + 1}
  end
  ps
end
ps = moved(3)
io.Print(ps, ps.X, value.Len(ps[1]), ps[2] == {X: 3.0, Y: 1.0, N: 3}, ps[2] == {N: 3, X: 3.0, Y: 1.0})
q = ps[1]
r = q
r.X = "text"
r.Z = true
io.Print(q, r, value.IsDict(q), value.Text(q), q["N"], q.N + 1)
match q
  {X: x, N: n} -> io.Print("matched", x, n)
  _ -> io.Print("no")
end

(* A guess that fails: an X that isn't a float in a list of typed maps. *)
defn total(xs)
  t = 0.0
  for i in 1..value.Len(xs)
    p = xs[i]
    t = t + p.X * p.Y
  end
  t
end
mixed = [{X: 1.5, Y: 2.0, N: 1}, {X: 2, Y: 3.0, N: 2}, {X: 0.5, Y: 4.0, N: 3}]
io.Print(total(mixed), mixed[2])
odd = [{X: 1.5, Y: 2.0, N: 1}, {Y: 1.0, X: 2.0}, {X: 1, Y: 1}]
io.Print(total(odd))
copy = mixed
copy[1] = {X: 9.5, Y: 1.0, N: 0}
io.Print(mixed[1], copy[1], mixed == copy)
e = result.Err({Message: "a typed error", Code: 7})
io.Print(e)
bad = [{X: 1.5, Y: 2.0, N: 1}, {X: "x", Y: 2.0, N: 1}]
io.Print(total(bad))
