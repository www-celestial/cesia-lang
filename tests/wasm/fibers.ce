use std/bug
use std/fiber
use std/io
use std/result
use std/sys

(* Fibers compiled to WebAssembly: each wait parks the fiber's stack by JSPI, the loader's scheduler runs the next one in
   the interpreter's order. *)
ch = fiber.Channel()
t = fiber.Spawn(defn ()
  for k in 1..3
    fiber.Send(k, ch)
  end
  "done"
end)
io.Print([result.Unwrap(fiber.Receive(ch)) for k in 1..3], fiber.Wait(t))
io.Print(fiber.Receive(ch, timeout = 0).Error.Kind)

(* A channel of size 1: the second Send waits for a receiver. *)
small = fiber.Channel(size = 1)
fiber.Send(1, small)
fiber.Spawn(() -> fiber.Send(2, small))
io.Print(fiber.Receive(small), fiber.Receive(small))

(* Of size 0, a Send waits for its receiver. *)
meet = fiber.Channel(size = 0)
log = fiber.Channel()
fiber.Spawn(defn ()
  fiber.Send("a", meet)
  fiber.Send("sent", log)
end)
sys.Sleep(0)
io.Print(fiber.Receive(log, timeout = 0).Error.Kind, fiber.Receive(meet).Value)
sys.Sleep(0)
io.Print(fiber.Receive(log, timeout = 0).Value)

(* Timeouts. *)
start = sys.Now()
late = fiber.Receive(ch, timeout = 0.03)
io.Print(late.Error.Kind, sys.Now() - start >= 0.02)
slow = fiber.Spawn(() -> sys.Sleep(10))
io.Print(fiber.Wait(slow, timeout = 0.01).Error.Kind)

(* Cancel: at its wait, or before it starts. *)
fiber.Cancel(slow)
io.Print(fiber.Wait(slow).Error.Kind)
never = fiber.Spawn(() -> io.Print("never"))
fiber.Cancel(never)
io.Print(fiber.Wait(never).Error.Message)

(* Close: what is left comes, then the end. *)
c = fiber.Channel()
fiber.Send(1, c)
fiber.Close(c)
io.Print(fiber.Receive(c), fiber.Receive(c).Error.Kind)
waiting = fiber.Channel()
reader = fiber.Spawn(() -> fiber.Receive(waiting))
sys.Sleep(0)
fiber.Close(waiting)
io.Print(fiber.Wait(reader).Value.Error.Kind)

(* A panic in a fiber is its task's Err. *)
bad = fiber.Wait(fiber.Spawn(() -> 1 + "a"))
io.Print(bad.Error.Kind, bad.Error.Line)
io.Print(fiber.Wait(fiber.Spawn(() -> bug.Panic("x"))).Error.Kind)

(* Many fibers, each its own stack. *)
deep(n) = if n == 0 0 else 1 + deep(n - 1) end
tasks = [fiber.Spawn(() -> deep(200 + k)) for k in 1..100]
io.Print(sum([result.Unwrap(fiber.Wait(x)) for x in tasks]))
defn sum(xs)
  s = 0
  for x in xs
    s += x
  end
  s
end
io.Print(ch, t)
