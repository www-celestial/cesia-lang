(* Slices, masks, two dimensions, in, list.Fill of rows by columns, list.Max and Min, integer keys. *)
use std/dict
use std/io
use std/list
use std/matrix

xs = [10, 20, 30, 40]
io.Print(xs[2..3], xs[[true, false, true, false]], 2 in [1, 2], 5 in xs, "a" in {a: 1}, "b" in {a: 1})
m = matrix.Zeros(2, 3)
m[2, 3] = 5.0
m[1, 2] = 1
io.Print(m, m[2, 3], m[1..2, 2..3], m[2, 1..3])
f = list.Fill("x", 2, 2)
io.Print(f)
io.Print(list.Max([3, 1, 2]), list.Min([3, 1, 2]), list.Max(1, 2), list.Min(1.5, 0.5), list.Max([1, 5], [4, 2]), list.Max(missing, 1))
a = 3
b = 4.5
io.Print(list.Max(a, 7), list.Min(b, 2.5))
d = {}
d["k"] = 1
d[3] = "three"
io.Print(d, d[3], d["k"])
io.Print(xs[2..10])
