(* Properties that fail shrink to their smallest case: cesia test --seed 1 forall.test.ce. *)
use std/test
use std/gen
use std/list
use std/value
use std/text
use std/math
use std/random

struct Order
  Item Text
  Qty Int
  Price Float
end

defn badSort(xs)
  if value.Len(xs) > 1 and xs[1] < 0
    xs
  else
    list.Sort(xs)
  end
end
total(o) = o.Qty * o.Price

isSortAgrees() = test.ForAll(xs -> value.Equal(badSort(xs), list.Sort(xs)), gen.List(gen.Int()))
isSquareRoot() = test.ForAll(x -> math.Sqrt(x) * math.Sqrt(x) == x, gen.Float(0, 100))
isNoDash() = test.ForAll(t -> not text.Contains("-", t), gen.Text())
isCheapOrders() = test.ForAll(o -> total(o) < 500, gen.Of(Order, with = {Qty: gen.Int(1, 20), Price: gen.Float(0, 100)}))
isFirstIsSmallest() = test.ForAll(xs -> xs[1] == list.Min(xs), gen.List(gen.Int(), min = 1))
isHolds() = test.ForAll(n -> n + 1 > n, gen.Int())
(* std/random draws from the same seed: a test's numbers come again with --seed. *)
isSeeded() = random.Int(1, 1000) < 0
