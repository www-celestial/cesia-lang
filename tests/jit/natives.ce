use std/dict
use std/io
use std/text
use std/value

(* Natives called from machine code, through OCaml: values kept across calls that allocate, so that a tiny young heap
   collects in each and moves them; texts and functions as constants; results that inference says are numbers; and a
   native that calls back into Cesia, whose callback calls natives itself. *)
defn churn(n)
  m = {A: "x", B: "y"}
  keep = text.Repeat(3, "ab")
  total = 0
  last = missing
  for k in 1..n
    parts = text.Split(",", "a,b,c,d")
    big = text.Repeat(40, "z")
    has = dict.Has("A", m)
    size = text.ByteLength(big)
    if has
      total = total + size
    end
    last = dict.Put("C", parts, m)
  end
  [total, keep, value.Len(last), dict.Get("C", last), m]
end

struct Bag { n, word }

(* What value.Len counts: a callback from the native. *)
(b Bag) len() = text.ByteLength(text.Repeat(b.n, b.word))

defn sizes(n)
  total = 0
  for k in 1..n
    s = value.Len(Bag(3, "ab"))
    total = total + s
  end
  total
end

io.Print(churn(20000))
io.Print(sizes(20000))
