use std/io
use std/list
use std/matrix

(* A transpose in compressed columns: i and t are assigned in each turn of the inner loop before it reads them, so the
   outer loop's machine code needs no value of theirs to start. Called again after other calls, which leave floats and
   arrays in the slots i and t will take, it starts as machine code each time, without falling back. *)
defn transposed(start, index, rows, cols)
  count = list.Fill(0, rows + 1)
  for q in 1..start[cols + 1] - 1
    count[index[q]] += 1
  end
  next = list.Fill(0, rows)
  p = 1
  for r in 1..rows
    next[r] = p
    p += count[r]
  end
  out = list.Fill(0, start[cols + 1] - 1)
  for j in 1..cols
    for q in start[j]..start[j + 1] - 1
      i = index[q]
      t = next[i]
      out[t] = j
      next[i] = t + 1
    end
  end
  out
end

defn noise(n)
  (** Floats and arrays in the first sixteen slots of a frame. *)
  xs = matrix.Zeros(n)
  a = 0.5
  b = [1.0, 2.0]
  c = 2.5
  d = [3.0]
  e = 1.5
  f = [4.0]
  g = 0.25
  h = [5.0]
  u = 0.125
  v = [6.0]
  w = 0.0625
  y = [7.0]
  z = 0.03125
  for k in 1..n
    xs[k] = a * k + c + e + g + u + w + z
  end
  list.Sum(xs) + b[1] + d[1] + f[1] + h[1] + v[1] + y[1]
end

n = 2000
start = [2 * j - 1 for j in 1..n + 1]
index = list.Fill(0, 2 * n)
for j in 1..n
  index[2 * j - 1] = j
  index[2 * j] = if j < n j + 1 else 1 end
end
total = 0
for r in 1..12
  total += list.Sum(transposed(start, index, n, n))
  total += noise(100)
end
io.Print(total)
