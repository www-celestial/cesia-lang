use std/io
use std/list
use std/math

(* A guard that fails after a step of the same statement, a call's: the run goes back with the fuel of the statement's
   start, so the limit of steps comes at the interpreter's step. *)
twice(x) = x * 2.0 + 1.0
defn run(ms, n)
  total = 0.0
  for i in 1..n
    total = total + twice(i * 1.0) + ms[i].X
  end
  total
end
n = 40000
ms = list.Fill(0, n)
for i in 1..n
  ms[i] = if math.Mod(i, 3) == 0 {X: 1.0, Y: 2.0} else {X: 1.0} end
end
io.Print(run(ms, n))
io.Print(run(ms, n))
for r in 1..1000
  io.Print(run(ms, n))
end
