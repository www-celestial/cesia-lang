use std/io
use std/matrix

(* An inlined callee and a deep call in a loop that writes: either bails where the stack would be short. *)

defn sq(x)
  x * x + 1.0
end

defn depth(n)
  if n == 0
    0.0
  else
    1.0 + depth(n - 1)
  end
end

defn fill(xs, n, d)
  for i in 1..n
    xs[i] = sq(i * 1.0) + depth(d)
  end
  xs[n]
end

xs = matrix.Zeros(100000)
io.Print(fill(xs, 100000, 2))
io.Print(fill(xs, 300, 9000))
io.Print(fill(xs, 100000, 2))
