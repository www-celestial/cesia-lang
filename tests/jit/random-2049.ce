end
defn batchf12(n0, m0, x0)
  a = Zeros(29)
  b = Zeros(31)
  for i in 1..Len(a)
    a[i] = i * 0.5 - 1.0
  end
  for i in 1..Len(b)
    b[i] = 3.0 - i * 0.25
  end
  acc = 0
  for j in 1..3
    acc = Mod(acc * 31 + f1(n0 + Mod(j, 3), m0, x0, a, b), 1000000007)
  end
  Print(a[1], b[Len(b)], a[Len(a)])
  acc
end
Print(batchf00(3, -22, 5.61))
Print(batchf01(1, -33, 1e-300))
Print(batchf02(20, -15, 5e-324))
Print(batchf10(1, -17, 2.5))
Print(batchf11(-2, -20, 1e300))
Print(batchf12(17, 22, -3.40))
