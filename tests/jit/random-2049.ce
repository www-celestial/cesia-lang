defn batchf10(n0, m0, x0)
  a = Zeros(32)
  b = Zeros(29)
  for i in 1..Len(a)
    a[i] = i * 0.5 - 1.0
  end
  for i in 1..Len(b)
    b[i] = 3.0 - i * 0.25
  end
  acc = 0
  for j in 1..1100
    acc = Mod(acc * 31 + f1(n0 + Mod(j, 3), m0, x0, a, b), 1000000007)
  end
  Print(a[1], b[Len(b)], a[Len(a)])
  acc
end
defn batchf11(n0, m0, x0)
  a = Zeros(23)
  b = Zeros(36)
  for i in 1..Len(a)
    a[i] = i * 0.5 - 1.0
  end
  for i in 1..Len(b)
    b[i] = 3.0 - i * 0.25
  end
  acc = 0
  for j in 1..3
    acc = Mod(acc * 31 + f1(n0 + Mod(j, 3), m0, x0, a, b), 1000000007)
  end
  Print(a[1], b[Len(b)], a[Len(a)])
