(* A random program of the three-way differential test. *)
defn h0(p0, p1)
  if ((if p1 >= -3 p0 else p1 end) >= p0 and 925 < Mod(p1, (Mod(p1, 4) + 1)))
    (-7.97 * (if p1 < p0 (if p0 < p0 8.92 else 1e-300 end) else (9007199254740993.0 * 1.7976931348623157e308) end))
  else
    (((-(p0)) * 1.0 + (9.65 * -2.83)) + (if 3037000499 > p1 5e-324 else (-(8.39)) end))
  end
end
defn h1(p0)
  if ((if -811 >= p0 -1 else 4 end) != (if 4 != p0 468 else 3 end) and (-2 - -3) != (4 + -6))
    p0
  else
    p0
  end
end
defn h2(n, x)
  if n <= 0 or n > 9
    x
  else
    h2(n - 1, x + 1.0) * 0.5 + h2(n - 2, x) + 1.0
  end
end
defn f0(n, m, x, a, b)
  t = m
  y = x
  x = (a[Mod((-(9)), Len(a)) + 1] ^ x)
  y = (if (n > y or 7 <= t) y else y end)
  if (-(Div(9, (Mod(1537228672809129301, 4) + 1)))) <= (Len(a) - (1099511627776 * t))
    return x
  end
  t = (n - t)
  for l0 in 1..5
    l0 = l0 + 2
    b[2 * l0 - 1] = (if m > (-(m)) 0.82 else a[l0 + t] end)
    t = (-((if t >= l0 (-(t)) else (if l0 == m m else m end) end)))
    for l1 in 2..2
      n = ((m - l1) + t)
      if Len(a) == (if y <= x t else (if 0 >= y n else m end) end)
        for l2 in 1..Mod(0, 8) + 1
          x = (if (l1 >= l1 or t > y) (-(Mod(t, 2))) else Mod(Div(l0, (Mod(l2, 4) + 1)), 7) end) * 1.0
          m = -7
          y = ((y / 2.5) / Sqrt((-(1e-300))))
          if n >= 4
            break
          end
        end
        m = (Len(a) + (if 0.1 > y Len(a) else l1 end))
        b[2 * l0 - 1] = b[Len(b) - l1 + 1]
      else
        if l0 != m
          n = Len(b)
          a[Mod((if n <= m Mod(-158, 7) else n end), Len(a)) + 1] = ((if l1 != n (if x != y x else y end) else Sqrt(1.98) end) * Abs((if m >= l1 y else x end)))
          m = ((if l0 == 2 t else Div(n, -3) end) - t)
          if y < x
            b[Len(b) - l0 + 1] = ((Mod(l0, -3) * 1.0 + (if n < m x else 7.12 end)) / x)
            a[Mod(Len(b), Len(a)) + 1] = (x * (b[l0 + l1] ^ (4611686018427387904.0 * -2.24)))
          end
        end
        b[l1 + l0] = ((if 82510 != y x else y end) - a[l0 + m])
        if ((t * t) + (l0 * 6)) >= (m + Mod(l0, (l1 * 0 + 5)))
          return -2.71
        end
      end
    end
  end
  n = m
  y + x
end
defn f1(n, m, x, a, b)
  t = m
  y = x
  x = Sqrt(h0((-(n)), (if -359 > -5 -8 else m end)))
  y = (x - y)
  n = (if (-(m)) < t (Div(n, -3) - n) else (-(m)) end)
  t + n
end
defn batchf00(n0, m0, x0)
  a = Zeros(28)
  b = Zeros(33)
  for i in 1..Len(a)
    a[i] = i * 0.5 - 1.0
  end
  for i in 1..Len(b)
    b[i] = 3.0 - i * 0.25
  end
  acc = 0.0
  for j in 1..1100
    acc = acc + f0(n0 + Mod(j, 3), m0, x0, a, b)
  end
  Print(a[1], b[Len(b)], a[Len(a)])
  acc
end
