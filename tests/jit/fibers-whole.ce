(* A module number that the top code changes while another fiber is inside a call of a function whose native code is
   the whole function (inner, called often, with an Int result): no error, and each call's count is between those of
   the values k held, as the interpreter's, which may see k change inside a call. Native code that keeps the numbers it
   started with until the call ends, as a fiber switch waits for nested native frames, gives one of a value k held. Kinds:
   Int only, Float only, then both in turn. *)
use std/fiber
use std/io
use std/list
use std/math
use std/value
k = 2
defn inner(m)
  n = 0
  for i in 1..m
    if i * 0.75 < k
      n += 1
    end
  end
  n
end
defn expect(m, v)
  n = 0
  for i in 1..m
    if i * 0.75 < v
      n += 1
    end
  end
  n
end
defn work(n)
  rs = list.Fill(0, n)
  j = 0
  while j < n
    j = j + value.Len("x")
    rs[j] = inner(500)
  end
  rs
end
for kinds in 1..3
  k = 2
  held = [2]
  f = fiber.Spawn(() -> work(12000))
  for j in 1..400
    k = if kinds == 1 j else if kinds == 2 j * 0.5 else if math.Mod(j, 3) == 0 j else j * 0.25 end
    held = list.Concat(held, [k])
    s = 0
    for q in 1..5000
      s = s + q
    end
  end
  rs = fiber.Wait(f).Value
  valid = [expect(500, v) for v in held]
  lo = list.Min(valid)
  hi = list.Max(valid)
  io.Print("kinds $kinds: $(value.Len(rs)) calls, each between the counts of the values k held: $(list.All([r >= lo and r <= hi for r in rs]))")
end
