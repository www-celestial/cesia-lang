use std/io

(* Entering native code deep in a recursion grows the stack before writing the hidden slots. *)
defn r(n)
  if n > 0
    return r(n - 1) + 0
  end
  s = 0
  for a in 1..2
    for b in 1..2
      for c in 1..2
        for d in 1..2
          for e in 1..2
            for f in 1..40000
              a = a + 0
              b = b + 0
              c = c + 0
              d = d + 0
              e = e + 0
              f = f + 0
              s = s + 1
            end
          end
        end
      end
    end
  end
  io.Print("s $(s)")
  s
end
r(408)

r(817)
