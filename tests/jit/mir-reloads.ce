(* A random program whose stores of spilled doubles made MIR abort. *)
defn f0(n, m, x, a, b)
  t = m
  y = x
  w0 = 0
  while w0 < 11 and m <= Len(a)
    if ((-2.84 <= y and t < n) or -2 <= n)
      for l1 in 3..Mod(2, 8) + 3
        if (m - -8) <= ((if m <= x 2.86 else y end) + y)
          if (if w0 < x (-(x)) else x end) != y
            if Exp(x) >= x
              x = (a[l1 + l1] ^ b[l1 * -1 + 1])
            end
            for l2 in 2..Mod(n, 9)
              if y == a[Mod(1, Len(a)) + 1]
                if Len(a) <= ((if y <= y 61162 else w0 end) - Div(-713, (t * 0 + 5)))
                end
                b[Mod((if l2 != 4611686018427387903 Len(b) else Mod(928, 7) end), Len(b)) + 1] = (if Div(w0, (n * 0 + 5)) > (if m > l2 l2 else n end) y else Sin((x * y)) end)
                y = w0 * 1.0
              end
            end
            y = (Len(a) + Div((n + 3), 2)) * 1.0
          end
        end
      end
      if w0 < ((if y > x n else m end) - (n - w0))
        for l3 in 3..8
        end
      end
    end
  end
  t = (if t < (x + 7.0) (if n >= x (t - m) else (if 0.1 >= x t else m end) end) else ((if n >= t n else m end) - n) end)
  t + n
end
defn batchf01(n0, m0, x0)
  a = Zeros(32)
  b = Zeros(28)
  for i in 1..Len(a)
  end
  for i in 1..Len(b)
  end
  acc = 0
  for j in 1..1100
    acc = Mod(acc * 31 + f0(n0 + Mod(j, 3), m0, x0, a, b), 1000000007)
  end
end
Print(batchf01(-1, -47, 9007199254740993.0))
