use std/io

defn h(x, y)
  if x > y
  end
  x + y
end

(** A list of integers that takes a float from an inlined call, in an if that also holds an empty if. *)
defn Run(n, fs)
  for i in 1..n
    if i > n - 10
      fs[2] = h(1, 3) * 1.0
      if i == 49
      end
    end
  end
  fs
end

io.Print(Run(100000, [1, 2, 3]))
io.Print(Run(50, [1, 2, 3]))
