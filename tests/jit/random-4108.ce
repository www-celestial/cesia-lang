use std/io
use std/math
use std/matrix
use std/value

(* A random program whose loop writes its variable while reading arrays. *)
defn h0(p0)
  ((-(9007199254740993.0)) + 0.1)
end
defn h1(n, x)
  if n <= 0 or n > 9
    math.Mod(n, 7)
  else
    h1(n - 1, x) + h1(n - 2, x * 0.5) + n
  end
end
defn h2(p0)
  math.Div(p0, (math.Mod((-(p0)), 4) + 1))
end
defn h3(n, x)
  if n <= 0 or n > 300
    x
  else
    h3(n - 1, x + n * 1.0)
  end
end
defn f0(n, m, x, a, b)
  t = m
  y = x
  for l0 in 3..9
    l0 = l0 + 3
    if math.Div((n + n), t) < t
      return b[l0 + n]
    end
  end
  for l1 in math.Mod((-274 - -986), 5)..0
    for l2 in 3..math.Mod(2, 8) + 3
      y = ((m - m) * 1.0 + 4611686018427387904.0)
      x = math.Abs(((3.33 * x) - (x + x)))
      y = -654 * 1.0
    end
    x = (if value.Len(b) == 8 (y * 3.74) else ((if l1 != y 4.83 else y end) * a[value.Len(a) - l1 + 1]) end)
    b[l1] = x
    x = (-((y * (if 2147483648 != m x else x end))))
  end
  a[math.Mod(math.Mod(m, (m * 0 + 5)), value.Len(a)) + 1] = y
  y + x
end
defn batchf00(n0, m0, x0)
  a = matrix.Zeros(38)
  b = matrix.Zeros(21)
  for i in 1..value.Len(a)
    a[i] = i * 0.5 - 1.0
  end
  for i in 1..value.Len(b)
    b[i] = 3.0 - i * 0.25
  end
  acc = 0.0
  for j in 1..1100
    acc = acc + f0(n0 + math.Mod(j, 3), m0, x0, a, b)
  end
  io.Print(a[1], b[value.Len(b)], a[value.Len(a)])
  acc
end
defn batchf01(n0, m0, x0)
  a = matrix.Zeros(27)
  b = matrix.Zeros(39)
  for i in 1..value.Len(a)
    a[i] = i * 0.5 - 1.0
  end
  for i in 1..value.Len(b)
    b[i] = 3.0 - i * 0.25
  end
  acc = 0.0
  for j in 1..1100
    acc = acc + f0(n0 + math.Mod(j, 3), m0, x0, a, a)
  end
  io.Print(a[1], b[value.Len(b)], a[value.Len(a)])
  acc
end
defn batchf02(n0, m0, x0)
  a = matrix.Zeros(23)
  b = matrix.Zeros(27)
  for i in 1..value.Len(a)
    a[i] = i * 0.5 - 1.0
  end
  for i in 1..value.Len(b)
    b[i] = 3.0 - i * 0.25
  end
  acc = 0.0
  for j in 1..1100
    acc = acc + f0(n0 + math.Mod(j, 3), m0, x0, a, b)
  end
  io.Print(a[1], b[value.Len(b)], a[value.Len(a)])
  acc
end
io.Print(batchf00(-4, 50, 0.29))
io.Print(batchf01(12, -7, 3.41))
io.Print(batchf02(4, 48, -8.55))
