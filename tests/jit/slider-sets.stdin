{"Do": "run", "Code": "use std/io\nuse std/cells", "Line": 1, "Path": "slider.ce"}
{"Do": "run", "Code": "(* %% Parameters *)\nk = cells.Slider(3.0, 0.0, 10.0, step = 0.25)\nm = cells.Slider(2, 1, 5)", "Line": 4, "Path": "slider.ce"}
{"Do": "run", "Code": "(* %% Loop *)\ndefn run(f, n)\n  y = [1.0, 0.0]\n  for i in 1..n\n    y = y + 0.001 * f(i * 0.001, y)\n  end\n  y[1]\nend", "Line": 8, "Path": "slider.ce"}
{"Do": "run", "Code": "(* %% Spring *)\nspring(t, y) = [y[2], -k * y[1]]\nrun(spring, 100000)", "Line": 17, "Path": "slider.ce"}
