use std/io
use std/value

(* A function of a value inlined in a loop: its number path in machine code, its text path back to the interpreter,
   which makes the call again; tests of kinds, tests compared, and a small function of one test made in place. *)
isFinite(x) = value.IsNumber(x) and x - x == 0.0
defn value1(f, x)
  y = f(x)
  if not isFinite(y)
    return "f($x) is $y"
  end
  1.0 * y
end
defn iterate(f, x0, n)
  x = x0
  count = 0
  while count < n
    fx = value1(f, x)
    count += 1
    if value.IsText(fx)
      return {Error: fx, Count: count}
    end
    if (fx > 0.0) == (x > 1.0)
      x = x - fx * 0.001
    else
      x = x + 0.0001
    end
  end
  {X: x, Count: count}
end
g = x -> x * x - 2.0
io.Print(iterate(g, 1.0, 40000))
h = x -> if x > 1.3 1.0 / 0.0 else x - 1.0 end
io.Print(iterate(h, 1.2, 40000))
k = x -> if x > 1.25 0.0 / 0.0 else x - 2.0 end
io.Print(iterate(k, 1.2, 40000))
(* Many short runs, each ending at its return. *)
total = 0
for r in 1..4000
  total = total + iterate(g, 1.0 + r * 0.0001, 12).Count
end
io.Print(total, iterate(g, 1.0, 12))
