use std/io
use std/list
use std/math
use std/value

(* Small arrays of floats in loops that get hot: kept in slots, made only when the run ends; the same cells, steps and
   errors as the interpreter's. *)
sigma = 10.0
rho = 28.0
beta = 8.0 / 3.0
lorenz(t, y) = [sigma * (y[2] - y[1]), y[1] * (rho - y[3]) - y[2], y[1] * y[2] - beta * y[3]]

defn rk4(f, y, h, n)
  t = 0.0
  for i in 1..n
    k1 = f(t, y)
    k2 = f(t + h / 2.0, y + (h / 2.0) * k1)
    k3 = f(t + h / 2.0, y + (h / 2.0) * k2)
    k4 = f(t + h, y + h * k3)
    y = y + (h / 6.0) * (k1 + 2.0 * k2 + 2.0 * k3 + k4)
    t = t + h
  end
  y
end
io.Print(rk4(lorenz, [1.0, 1.0, 1.0], 0.001, 30000))

(* Cells by index, sums, the largest of each pair, absolute values, a negation and a column. *)
defn mix(n)
  a = [0.5, -1.5, 2.0]
  b = [1.0, 1.0, -3.0]
  s = 0.0
  m = 0.0
  for i in 1..n
    c = list.Max(math.Abs(a), b) - a / 4.0
    a = -c * 0.5 + b
    for j in 1..3
      s = s + a[j] * j
    end
    m = m + list.Sum(c * c) + list.Max(a) - list.Min(b)
  end
  io.Print(a, s, m)
  col = [1.0; 2.0]
  for i in 1..n
    col = col * 0.999 + [0.001; 0.002]
  end
  io.Print(col, value.Size(col))
end
mix(20000)

(* A function that gives an array of another size at some turn: the interpreter takes the turn over. *)
grow(t, y) = if t < 15000.0 [y[1] + 1.0, y[2]] else [y[1], y[2], 1.0] end
defn walk(f, n)
  y = [0.0, 0.0]
  total = 0.0
  for i in 1..n
    k = f(i * 1.0, y)
    total = total + k[1]
    if value.Len(k) == 2
      y = k
    end
  end
  io.Print(y, total)
end
walk(grow, 30000)
