use std/io
use std/list

(* An index j + k whose k is far from 0, with j as far the other way, so that j + k is inside the array: the machine
   code reads the cell at j + k from a register of its own, or checks it at each turn, never at an address made of k
   alone. The same sums as the interpreter's, in a loop around another and in an innermost one. *)
defn around(colptr, xs, lo, hi)
  s = 0.0
  for j in lo..hi
    for q in colptr[1]..colptr[2] - 1
      s = s + 1.0
    end
    s = s + xs[j + 4611686018427387000]
  end
  s
end

defn inner(xs, lo, hi)
  s = 0.0
  for j in lo..hi
    s = s + xs[j + 4611686018427387000]
  end
  s
end

xs = list.Fill(0.5, 3000)
for i in 1..3000
  xs[i] = i * 0.25
end
colptr = [1, 3, 5]
lo = 1 - 4611686018427387000
for r in 1..30
  a = around(colptr, xs, lo, lo + 2999)
  b = inner(xs, lo, lo + 2999)
end
io.Print(a, b)
io.Print(around(colptr, xs, lo + 2990, lo + 3000))
