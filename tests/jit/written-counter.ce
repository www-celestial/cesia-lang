use std/io
use std/matrix

(* A loop whose body writes its variable: the index is the variable, not the counter. *)
defn g(a, n)
  s = 0.0
  for i in 1..n
    i = i + 1
    s = s + a[i]
  end
  s
end
a = matrix.Zeros(10)
for k in 1..10
  a[k] = k * 1.0
end
io.Print(g(a, 9))
t = 0.0
for j in 1..2000
  t = t + g(a, 9)
end
io.Print(t)
