use std/io
use std/list
use std/matrix

(* Arrays of two and three dimensions read and written by index in hot loops: native code takes their sizes at each
   entry, with the interpreter's results and errors. *)
defn filled(n)
  a = matrix.Zeros(n, n, n)
  for k in 1..n
    for j in 1..n
      for i in 1..n
        a[i, j, k] = i + 10.0 * j + 100.0 * k
      end
    end
  end
  a
end

defn total(a, n)
  s = 0.0
  for k in 1..n
    for j in 1..n
      for i in 1..n
        s = s + a[i, j, k]
      end
    end
  end
  s
end

defn smooth(a, n)
  b = matrix.Zeros(n, n, n)
  for k in 2..n - 1
    for j in 2..n - 1
      for i in 2..n - 1
        b[i, j, k] = (a[i - 1, j, k] + a[i + 1, j, k] + a[i, j - 1, k] + a[i, j + 1, k] + a[i, j, k - 1] + a[i, j, k + 1]) / 6.0
      end
    end
  end
  b
end

defn weighted(m, n)
  s = 0.0
  for j in 1..n
    for i in 1..n
      s = s + m[i, j] * i
    end
  end
  s
end

(* An array of values: reads guessed as floats, writes of boxed numbers. *)
defn mixed(v)
  w = list.Fill(missing, 3, 4, 4)
  s = 0.0
  for k in 1..4
    for j in 1..4
      for i in 1..3
        s = s + v[i, j, k]
        w[i, j, k] = s
      end
    end
  end
  s + w[3, 4, 4]
end

a = filled(30)
io.Print(list.Sum(a), total(a, 30))
io.Print(list.Sum(smooth(a, 30)))
io.Print(weighted(matrix.Reshape([300, 300], 1.0 * (1..90000)), 300))
v = list.Fill(2.5, 3, 4, 5)
v[3, 4, 5] = missing
t = 0.0
for r in 1..2000
  t = t + mixed(v)
end
io.Print(t)
io.Print(total(a, 31))
