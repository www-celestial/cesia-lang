use std/io
use std/matrix

(* Native code for three indexes takes any array of three dimensions; another count goes to the interpreter, whose error
   says how many indexes the array takes. *)
defn along(a, n)
  s = 0.0
  for i in 1..n
    s = s + a[i, 1, 1]
  end
  s
end
c = matrix.Ones(1000, 1, 2)
t = 0.0
for r in 1..300
  t = t + along(c, 1000)
end
io.Print(t)
io.Print(along(matrix.Ones(7, 2, 2), 7))
io.Print(along(matrix.Ones(3, 3), 3))
