use std/io
use std/fiber
use std/list
use std/math
use std/result
use std/value

(* Calls through a value in a native loop: each function the call reached is tested in turn, and any other goes back to
   the interpreter, with the same results. *)
defn run(ops, xs, n)
  total = 0.0
  for i in 1..n
    f = ops[math.Mod(i, value.Len(ops)) + 1]
    x = xs[math.Mod(i, 4) + 1]
    total = f(total, x)
    if total > 1000000.0
      total = total / 2
    end
  end
  total
end

add(a, b) = a + b
half(a, b) = a * 0.5 + b
twice(a, b) = a * 2.0 - b
ints(a, b) = 3
k = 0.25
captured(a, b) = a * k + b

xs = [1, 2.5, 3, 4.5]
(* Two functions, each always with the same kinds. *)
io.Print(run([add, half], xs, 200000))
(* A third arrives after the loop is native: it goes back to the interpreter. *)
io.Print(run([add, twice], xs, 200000))
io.Print(run([add, half, twice], xs, 200000))
(* Functions that give an integer and a float. *)
io.Print(run([add, ints], xs, 200000))
(* A function of a variable outside it. *)
io.Print(run([captured, add], xs, 200000))
(* More functions than a call remembers. *)
io.Print(run([add, half, twice, captured, (a, b) -> a - b], xs, 200000))
(* An error inside a function called through a value, at its line, as the interpreter says. *)
big(a, b) = 4611686018427387903 + b
defn overflow(n)
  ops = [(a, b) -> a + b, big]
  total = 0
  for i in 1..n
    f = ops[math.Mod(i, 2) + 1]
    total = f(total, 1)
  end
  total
end
io.Print(fiber.Wait(fiber.Spawn(() -> overflow(200000))) then result.MapErr(it.Message))
