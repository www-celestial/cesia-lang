use std/io
use std/list
use std/matrix

(* A float among the rows: the list is no longer a list of integers, so the machine code made for one doesn't take it
   and the interpreter runs the loop. 2.0 is a whole number and an index; 2.5 is the interpreter's error. *)
defn mul(colptr, rowidx, vals, x, n)
  y = matrix.Zeros(n)
  for j in 1..n
    xj = x[j]
    for q in colptr[j]..colptr[j + 1] - 1
      i = rowidx[q]
      y[i] = y[i] + vals[q] * xj
    end
  end
  y
end

(* A tridiagonal matrix of n columns, in CSC. *)
defn tri(n)
  colptr = list.Fill(0, n + 1)
  rowidx = list.Fill(0, 3 * n)
  p = 1
  for j in 1..n
    colptr[j] = p
    for i in j - 1..j + 1
      if i >= 1 and i <= n
        rowidx[p] = i
        p += 1
      end
    end
  end
  colptr[n + 1] = p
  {Colptr: colptr, Rowidx: list.Take(p - 1, rowidx), N: n}
end

a = tri(3000)
vals = matrix.Zeros(3 * a.N) + 1.0
x = matrix.Zeros(a.N) + 0.5
for r in 1..30
  y = mul(a.Colptr, a.Rowidx, vals, x, a.N)
end
io.Print(y[1], y[2], y[a.N], list.Sum(y))
rows = a.Rowidx
rows[2500] = 2.0
y = mul(a.Colptr, rows, vals, x, a.N)
io.Print(y[1], y[2], y[a.N], list.Sum(y))
y = mul(a.Colptr, a.Rowidx, vals, x, a.N)
io.Print(y[1], y[2], y[a.N], list.Sum(y))
rows[2500] = 2.5
y = mul(a.Colptr, rows, vals, x, a.N)
io.Print("not reached")
