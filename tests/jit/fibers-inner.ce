use std/fiber
use std/io
use std/math

(* Fibers switch inside an inner native loop at the interpreter's step. *)
defn work(n)
  s = 0
  for i in 1..1
    for j in 1..n
      s = s + math.Mod(j, 3)
    end
  end
  s
end
defn noisy()
  for r in 1..6
    io.Print("b $(r)")
    k = 0
    for q in 1..300000
      k = k + 1
    end
  end
  0
end
b = fiber.Spawn(noisy)
io.Print("a $(work(2500000))")
fiber.Wait(b)
