use std/io
use std/list

(* A while loop whose test reads maps: a failed guard there goes back to the test. *)
defn walk(cells, n)
  i = 1
  s = 0.0
  while i <= n and cells[i].Open
    s = s + cells[i].W
    i = i + 1
  end
  io.Print(i, s)
end

cells = list.Fill(0, 150000)
for i in 1..150000
  cells[i] = {Open: true, W: 0.5}
end
walk(cells, 150000)
walk(cells, 150000)
cells[120000] = {Open: false, W: 0.5}
walk(cells, 150000)
cells[120000] = {Open: 1, W: 0.5}
walk(cells, 150000)
