use std/io
use std/list
use std/matrix

(* The list of rows written while the loops run over it: an integer keeps it a list of integers and the next turn reads
   it; a float makes it a list of floats, in the interpreter, and the run goes on there; a row past y written ahead is
   the interpreter's error when it is read. *)
defn mul(colptr, rowidx, vals, x, n, at, v)
  y = matrix.Zeros(n)
  (* Its own copy, which the loops may write in place. *)
  rowidx[1] = rowidx[1]
  for j in 1..n
    xj = x[j]
    for q in colptr[j]..colptr[j + 1] - 1
      i = rowidx[q]
      y[i] = y[i] + vals[q] * xj
      if q == at
        rowidx[q + 1] = v
      end
    end
  end
  y
end

(* A tridiagonal matrix of n columns, in CSC. *)
defn tri(n)
  colptr = list.Fill(0, n + 1)
  rowidx = list.Fill(0, 3 * n)
  p = 1
  for j in 1..n
    colptr[j] = p
    for i in j - 1..j + 1
      if i >= 1 and i <= n
        rowidx[p] = i
        p += 1
      end
    end
  end
  colptr[n + 1] = p
  {Colptr: colptr, Rowidx: list.Take(p - 1, rowidx), N: n}
end

a = tri(3000)
vals = matrix.Zeros(3 * a.N) + 1.0
x = matrix.Zeros(a.N) + 0.5
for r in 1..30
  y = mul(a.Colptr, a.Rowidx, vals, x, a.N, 0, 0)
end
io.Print(y[1], y[2], y[a.N], list.Sum(y))
y = mul(a.Colptr, a.Rowidx, vals, x, a.N, 4000, 1)
io.Print(y[1], y[2], y[a.N], list.Sum(y))
y = mul(a.Colptr, a.Rowidx, vals, x, a.N, 4000, 1.0)
io.Print(y[1], y[2], y[a.N], list.Sum(y))
y = mul(a.Colptr, a.Rowidx, vals, x, a.N, 6000, a.N + 1)
io.Print("not reached")
