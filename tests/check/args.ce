(* Calls to a known function, struct or native with arguments that don't fit, though none of these lines runs. *)
use std/io
use std/text

struct Point { X, Y = 0 }

defn Area(w, h)
  w * h
end

defn Never()
  Area(1)
  Area(1, 2, 3)
  Area(w = 1, d = 2)
  Area(1, w = 2)
  Point(1, 2, 3)
  text.Upper("a", "b")
  io.Print(text.Split(sep = ",", s = "a,b", n = 2))
end
