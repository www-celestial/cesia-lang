(** A circle, and what it adds to the rectangle of rect.ce. *)
struct Circle { Radius }

scale(x) = 2 * x

(c Circle) Half() = half(c.Radius)   (** Half the radius, with a small function of rect.ce. *)

(r Rect) Perimeter() = 2 * (r.Width + r.Height)   (** A method in another file than its struct. *)

Rect.Square(side) = Rect(side, side)   (** A static method in another file than its struct. *)

(r Rect) Tag() = r.tag   (** A small field declared in rect.ce. *)

(r Rect) doubled() = r.Width * 2

(r Rect) Doubled() = r.doubled()   (** A small method, called from this file. *)

readSeen() = seen

Early() = early   (** What readSeen gave during the statements of rect.ce. *)
