(** Writes the cesia.lock of the current folder for its std/ and deps/, made by hand in a test, as cesia pkg install would
    write it. Run with --allow read,write. *)
use std/sys
use std/cesia
use std/list
use std/result
use std/text

defn walk(dir)
  (** The files under a folder, at any depth. *)
  listed = sys.List(dir)
  found = []
  if result.IsOk(listed)
    for name in listed.Value
      path = "$dir/$name"
      found = if sys.Stat(path)?.IsDir list.Concat(found, walk(path)) else list.Append(path, found) end
    end
  end
  found
end

q = text.Char(34)
lines = ["[std]", "cesia = $q$(cesia.Version())$q", "files = ["]
for f in list.Sort(list.Concat(walk("std"), walk("deps")))
  lines = list.Append("  $q$f $(cesia.Fingerprint(result.Unwrap(sys.Read(f))))$q,", lines)
end
result.Unwrap(sys.Write("cesia.lock", text.Join("\n", list.Concat(lines, ["]", ""]))))
