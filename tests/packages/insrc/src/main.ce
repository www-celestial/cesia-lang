(** A use is the path of a folder from the root: a package in src/, a folder inside one, a name in both places, and a folder
    at the root. *)
use src/shapes
use src/shapes/round
use src/both
use helper
use std/io

io.Print(shapes.Where())
io.Print(round.Where())
io.Print(both.Where())
io.Print(helper.Where())
