(* The packages of the project are modules of the docs, and DocEntry says where their names are. *)
use std/cesia
use std/io
use std/list
use std/text

io.Print(list.Filter(m -> not text.StartsWith("std/", m), cesia.DocNames()))
io.Print(cesia.DocNames("shapes"), cesia.DocNames("notes"))
e = cesia.DocEntry("shapes.Unit")
io.Print(e.Module, e.Signature, e.Text, e.File, e.Line, e.Builtin)
