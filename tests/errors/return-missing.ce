(** A return with no value gives missing, which a type without ? refuses. *)
use std/io
use std/value

defn Find(xs Array, x) Int?
  for i in 1..value.Len(xs)
    if xs[i] == x
      return i
    end
  end
end
defn F(x) Int
  if x > 0
    return
  end
  x
end
io.Print(Find([1, 2], 3))
io.Print(F(0))
io.Print(F(1))
