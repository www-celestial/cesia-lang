crlf.ce
fmt: 1
use std/io
use std/list

defn twice(x)
  (** Two times x, written out of the style:
      its comment moves with its line. *)
  y = x * 2
  if y > 3
    io.Print("big", [k for k in 1..3 if k > 1])
  else if y > 1
    io.Print("mid")
  else
    io.Print("small")
  end
  match y
    4 -> io.Print("four")
    v if v > 4 ->
      io.Print("more",
               v)
    else -> io.Print("other")
  end
  t = "a text that
   keeps its spaces   
      and its lines"
  y
end

struct Point
  X
  Y = 0   (** a default *)
end
help =
  "Commands"
io.Print(twice(3), Point(1).Y, help)
