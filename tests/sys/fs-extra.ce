use std/sys
use std/io
use std/result
use std/text

defn main()
  sys.Write("stat_a.txt", "hello")?
  s = sys.Stat("stat_a.txt")?
  io.Print(s.Size, s.IsDir, s.Modified > 1000000000)
  sys.Rename("stat_a.txt", "stat_b.txt")?
  io.Print(sys.Exists("stat_a.txt"), sys.Read("stat_b.txt"))
  io.Print(sys.Stat(".")?.IsDir)
  io.Print(result.IsErr(sys.Stat("no_such_file")))
  sys.Remove("stat_b.txt")?
  (* A write that waits for the disk, then a file of several reads of 64 KiB: read in one text of its size. *)
  big = text.Repeat(20000, "0123456789")
  io.Print(sys.Write("big.txt", big, sync = true), sys.Read("big.txt")? == big, text.ByteLength(sys.Read("big.txt")?))
  io.Print(sys.Write("big.txt", "small", sync = false), sys.Read("big.txt"))
  sys.Remove("big.txt")?
  result.Ok(missing)
end

io.Print(main())
