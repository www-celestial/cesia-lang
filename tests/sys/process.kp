use sys

defn all_output(p, seen)
  got = sys.read_output(p)?
  if got == "" Ok(seen) else all_output(p, "$seen$got") end
end

defn main()
  p = sys.start("sh", args = ["-c", "cat; echo err >&2; exit 3"])?
  sys.write_input(p, "hello\n")?
  print(sys.read_output(p))
  sys.close_input(p)
  print(all_output(p, ""))
  print(sys.wait_exit(p))
  long = sys.start("sh", args = ["-c", "exec sleep 5"])?
  sys.stop(long)
  print(sys.wait_exit(long) != 0)
  ticks = spawn(() -> 1 + 1)
  slow = sys.start("sh", args = ["-c", "sleep 0.05; echo late"])?
  print(wait(ticks), all_output(slow, ""))
  sys.wait_exit(slow)
  print(wait(spawn(() -> sys.wait_exit(p))) then map_err(it.message))
  Ok(missing)
end

print(main())
print(sys.start("kepler_no_such_command"))
