use std/sys
use std/io
use std/result
io.Print(sys.Run("sh", args = ["-c", "echo out; echo err >&2; exit 3"]))
io.Print(sys.Run("sh", args = ["-c", "cat"], input = "typed"))
io.Print(sys.Run("sh", args = ["-c", "echo \"$1\"", "--", "a; rm -rf b"]) then result.MapOk(it.Out))
io.Print(sys.Run("sh", input = "x", args = ["-c", "cat"]) then result.MapOk(it.Out))
