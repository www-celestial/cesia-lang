(** Every function under a permission, run the same way under the cases of permissions-*.cmd; the port is that of
    Args[1]. *)
use std/net
use std/sys
use std/fiber
use std/io
use std/list
use std/result
use std/text

port = text.Number(sys.Args[1])
calls = [
  ["write", () -> sys.Write("perm_work/a", "x")],
  ["append", () -> sys.Append("perm_work/a", "y")],
  ["read", () -> sys.Read("perm_work/a")],
  ["list", () -> sys.List("perm_work")],
  ["exists", () -> sys.Exists("perm_work/a")],
  ["mkdir", () -> sys.Mkdir("perm_work/sub")],
  ["remove", () -> sys.Remove("perm_work/a")],
  ["env", () -> sys.Env("CESIA_PERM")],
  ["run", () -> sys.Run("true")],
  ["listen", () -> net.Listen(port)],
  ["connect", () -> net.Connect("127.0.0.1", port)]
]

defn outcome(call)
  name = call[1]
  got = match fiber.Wait(fiber.Spawn(call[2]))
    result.Err(e) -> e.Kind
    result.Ok(result.Err(e)) -> e.Kind
    else -> "ran"
  end
  io.Print("$name: $got")
end

list.Map(outcome, calls)
