use std/sys
(* dir is where the command runs; past timeout it is killed and its Code is -1, and this program goes on at once. *)
Print(sys.Run("sh", args = ["-c", "pwd"], dir = "/") then MapOk(it.Out))
Print(sys.Run("sh", args = ["-c", "true"], dir = "/no/such/folder") then MapErr(it.Message))
start = sys.Now()
Print(sys.Run("sh", args = ["-c", "sleep 5"], timeout = 0.2) then MapOk(it.Code), sys.Now() - start < 2)
Print(sys.Run("sh", args = ["-c", "echo quick"], timeout = 5) then MapOk(it.Out))
