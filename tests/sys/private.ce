(* Folders and files with private = true are their owner's alone, 0700 and 0600, made so or made so again; the others
   are as before. A private file is a new file, renamed over the old one: a reader of the old one keeps the old text, and
   a link is replaced, its target untouched. private.cmd makes the reader and the link, and shows the modes. *)
use std/io
use std/sys

io.Print(sys.Mkdir("open/inside"))
io.Print(sys.Write("open/plain.txt", "plain"))
io.Print(sys.Mkdir("keys/deep/er", private = true))
io.Print(sys.Write("keys/key.txt", "secret", private = true))
io.Print(sys.Write("keys/key.txt", "secret again", private = true), sys.Read("keys/key.txt"))
io.Print(sys.Write("open/was-plain.txt", "one"))
io.Print(sys.Write("open/was-plain.txt", "two", private = true), sys.Read("open/was-plain.txt"))
io.Print(sys.Write("open/reader.txt", "SECRET", private = true), sys.Read("open/reader.txt"))
io.Print(sys.Write("open/link.txt", "SECRET", private = true), sys.Read("open/link.txt"), sys.Read("target.txt"))
io.Print(sys.Mkdir("open/inside", private = true))
io.Print(sys.Mkdir("open/plain.txt", private = true))
io.Print(sys.Write("keys", "not a file", private = true))
