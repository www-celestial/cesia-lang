use std/sys
use std/fiber
use std/io
use std/result

defn allOutput(p, seen)
  got = sys.ReadOutput(p)?
  if got == "" result.Ok(seen) else allOutput(p, "$seen$got") end
end

defn main()
  p = sys.Start("sh", args = ["-c", "cat; echo err >&2; exit 3"])?
  sys.WriteInput(p, "hello\n")?
  io.Print(sys.ReadOutput(p))
  sys.CloseInput(p)
  io.Print(allOutput(p, ""))
  io.Print(sys.WaitExit(p))
  long = sys.Start("sh", args = ["-c", "exec sleep 5"])?
  sys.Stop(long)
  io.Print(sys.WaitExit(long) != 0)
  ticks = fiber.Spawn(() -> 1 + 1)
  slow = sys.Start("sh", args = ["-c", "sleep 0.05; echo late"])?
  io.Print(fiber.Wait(ticks), allOutput(slow, ""))
  sys.WaitExit(slow)
  io.Print(fiber.Wait(fiber.Spawn(() -> sys.WaitExit(p))) then result.MapErr(it.Message))
  result.Ok(missing)
end

io.Print(main())
io.Print(sys.Start("cesia_no_such_command"))
