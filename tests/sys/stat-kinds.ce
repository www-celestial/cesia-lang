(** sys.Stat tells a regular file from the rest: a device or a FIFO has the size of an empty file, and reading one never ends.
    sys.Remove of a link deletes the link, never what it points to. *)
use std/sys
use std/io
use std/result

defn show(path)
  s = sys.Stat(path)?
  io.Print(path, s.IsFile, s.IsDir, s.IsLink, if s.IsDir "folder" else s.Size end)
  result.Ok(missing)
end

defn main()
  sys.Write("empty.txt", "")?
  sys.Write("text.txt", "hello")?
  show("empty.txt")?
  show("text.txt")?
  show("link-text")?
  show(".")?
  show("link-folder")?
  show("/dev/zero")?
  show("link-device")?
  show("pipe")?
  show("link-pipe")?
  io.Print("broken link", result.IsErr(sys.Stat("link-broken")))
  sys.Write("folder/kept.txt", "kept")?
  sys.Remove("link-folder")?
  io.Print("link removed", not sys.Exists("link-folder"), sys.Read("folder/kept.txt")?)
  (* A real file of size 0 on Linux. Other systems have no such file, and nothing to check. *)
  io.Print("proc", not sys.Exists("/proc/version") or sys.Stat("/proc/version")?.IsFile)
  result.Ok(missing)
end

io.Print(main())
