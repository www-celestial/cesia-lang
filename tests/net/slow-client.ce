(** A client that sends half a request and waits: the server closes it at its deadline. *)
use std/http
use std/net
use std/sys
use std/fiber
use std/io
use std/result
use std/text

fiber.Spawn(() -> http.Serve(http.App() then http.AnyMethod("*", r -> {Status: 200, Body: "ok"}), port = 18203, timeout = 0.1))
sys.Sleep(0.05)

defn main()
  c = net.Connect("127.0.0.1", 18203)?
  net.Write(c, "GET / HT")?
  start = sys.Now()
  got = net.Read(c)?
  io.Print(text.ByteLength(got), sys.Now() - start < 1.0)
  result.Ok(missing)
end

io.Print(main())
