use std/http
use std/net
use std/sys
use std/fiber
use std/io
use std/result
use std/text

crlf = "$(text.Char(13))$(text.Char(10))"
handle(r) = {Status: 200, Body: "fine"}

defn openAll(n, opened)
  if n == 0
    opened
  else
    match net.Connect("127.0.0.1", 18094)
      result.Ok(c) -> openAll(n - 1, [c, opened])
      else -> opened
    end
  end
end

defn ask(c)
  net.Write(c, "GET / HTTP/1.1$(crlf)Host: a$(crlf)$crlf")?
  net.Read(c) then result.MapOk(reply -> text.Split(crlf, reply)[1])
end

fiber.Spawn(() -> http.Serve(handle, port = 18094))
sys.Sleep(0)
first = result.Unwrap(net.Connect("127.0.0.1", 18094))
io.Print(ask(first))
openAll(100, missing)
sys.Sleep(0.4)
io.Print(ask(first))
