(** A chunked response cut anywhere is an Err of the client, never a panic. *)
use std/http
use std/net
use std/fiber
use std/io
use std/result

crlf = "\r\n"
head = "HTTP/1.1 200 OK$(crlf)transfer-encoding: chunked$crlf$crlf"

defn serveOne(listener, reply)
  c = net.Accept(listener)?
  net.Read(c)?
  net.Write(c, reply)?
  net.Close(c)
  result.Ok(missing)
end

defn ask(reply)
  listener = net.Listen(18211)?
  server = fiber.Spawn(() -> serveOne(listener, reply))
  got = http.Fetch("http://127.0.0.1:18211/")
  fiber.Wait(server)
  net.Close(listener)
  got
end

shown(r) = r then result.MapOk(it.Body) then result.MapErr(it.Message)

io.Print(shown(ask("$(head)5$(crlf)hello$(crlf)0$crlf$crlf")))
io.Print(shown(ask("$(head)5$(crlf)hello")))
io.Print(shown(ask("$(head)5$(crlf)hello$crlf")))
io.Print(shown(ask(head)))
