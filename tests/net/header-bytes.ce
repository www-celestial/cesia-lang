(** Every byte of a header name against the list of RFC 9110, and a line end refused anywhere in the line: the server answers
    400 to what a proxy in front could read otherwise. *)
use std/http
use std/net
use std/sys
use std/fiber
use std/io
use std/list
use std/result
use std/text
use std/value

crlf = "\r\n"
fiber.Spawn(() -> http.Serve(r -> {Status: 200, Body: "ok"}, port = 18212))
sys.Sleep(0.05)

defn status(line)
  (** The status of the answer to a request with this header line. *)
  c = net.Connect("127.0.0.1", 18212)?
  net.Write(c, "GET / HTTP/1.1$(crlf)connection: close$crlf$line$crlf$crlf")?
  got = net.Read(c)?
  net.Close(c)
  result.Ok(text.Split(" ", got)[2])
end

allowed = text.Bytes("!#$$%&'*+-.^_`|~abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")
accepted(b) = result.Unwrap(status("$(text.FromBytes([b])): value")) == "200"

io.Print(value.Equal(list.Filter(accepted, [b for b in 0..255]), list.Sort(allowed)))
io.Print(status("a: b"))
io.Print(status(": b"))
io.Print(status("a : b"))
io.Print(status("a\nb: c"))
io.Print(status("a: b\nc"))
io.Print(status("a: b\rc"))
io.Print(status("a: tab	space é"))
