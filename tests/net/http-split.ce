use std/http
use std/net
use std/sys
use std/fiber
use std/io
use std/result
use std/text
use std/value

crlf = "$(text.Char(13))$(text.Char(10))"
request = "GET /x HTTP/1.1$(crlf)Host: a$(crlf)$crlf"
handle(r) = {Status: 200, Body: r.Path}

count(s) = value.Len(text.Split("HTTP/1.1", s)) - 1

defn readUntil(c, wanted, got)
  if count(got) >= wanted
    result.Ok(got)
  else
    more = net.Read(c)?
    readUntil(c, wanted, "$got$more")
  end
end

defn client()
  c = net.Connect("127.0.0.1", 18091)?
  net.Write(c, "GET /x HT")?
  sys.Sleep(0.01)
  net.Write(c, text.Slice(10, value.Len(request), request))?
  first = readUntil(c, 1, "")?
  net.Write(c, "$request$request")?
  both = readUntil(c, 2, "")?
  result.Ok([count(first), count(both)])
end

fiber.Spawn(() -> http.Serve(http.App() then http.AnyMethod("*", handle), port = 18091))
sys.Sleep(0)
io.Print(client())
