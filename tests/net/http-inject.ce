use std/http
use std/net
use std/sys
use std/fiber
use std/io
use std/result
use std/text

crlf = "$(text.Char(13))$(text.Char(10))"
forged = "1$(crlf)x-injected: yes"

handle(r) = match r.Path
  "/value" -> {Status: 200, Body: "x", Headers: [{Name: "x-echo", Value: forged}]}
  "/name" -> {Status: 200, Body: "x", Headers: [{Name: forged, Value: "1"}]}
  else -> {Status: "200$(crlf)x-injected: yes", Body: "x"}
end

defn get(path)
  c = net.Connect("127.0.0.1", 18100)?
  net.Write(c, "GET $path HTTP/1.1$(crlf)Host: a$(crlf)$crlf")?
  net.Read(c) then result.MapOk(r -> [text.Split(crlf, r)[1], r then text.Contains("x-injected")])
end

fiber.Spawn(() -> http.Serve(http.App() then http.AnyMethod("*", handle), port = 18100))
sys.Sleep(0)
io.Print(get("/value"))
io.Print(get("/name"))
io.Print(get("/status"))
