use std/http
use std/sys
use std/bug
use std/dict
use std/fiber
use std/io
use std/result

base = "http://127.0.0.1:18201"

defn hello(req)
  http.Plain("hello $(req.Params["name"]) $(dict.GetOr("q", "none", req.Query))")
end

defn add(req)
  input = http.BodyJson(req)?
  result.Ok(http.Json({"sum": input["a"] + input["b"]}, status = 201))
end

defn notes(req)
  http.Plain(http.Form(req)["text"])
end

defn tag(next, req)
  http.WithHeader("x-tag", "seen", next(req))
end

a = http.App()
a = http.Get("/", req -> http.Html("<h1>home</h1>"), a)
a = http.Get("/hello/:name", hello, a)
a = http.Post("/add", add, a)
a = http.Post("/notes", notes, a)
a = http.Get("/boom", req -> bug.Panic("boom"), a)
a = http.Get("/err", req -> result.Err("no"), a)
a = http.Get("/cookie", req -> http.SetCookie("id", "a b", http.Plain("set")), a)
a = http.Get("/seen", req -> http.Plain(dict.GetOr("id", "none", req.Cookies)), a)
a = http.Get("/go", req -> http.Redirect("/"), a)
a = http.Get("/tpl", req -> http.Html(http.Template("<b>{{name}}</b>", {"name": req.Query["n"]})), a)
a = http.Static("/files", ".", a)
a = http.Wrap(tag, a)
a = http.Wrap(http.Cors("*"), a)

defn show(r)
  match r
    result.Ok(v) -> io.Print(v.Status, v.Body)
    result.Err(e) -> io.Print("error", e.Message)
  end
end

defn hdr(name, r)
  io.Print(name, http.HeaderValue(name, r.Value.Headers))
end

fiber.Spawn(() -> http.Serve(a, port = 18201))
sys.Sleep(0.05)
show(http.Fetch("$base/"))
show(http.Fetch("$base/hello/ann?q=x%20y"))
show(http.Fetch("$base/hello/a%20b"))
show(http.Fetch("$base/nothing"))
show(http.Fetch("$base/hello"))
show(http.Fetch("$base/", method = "DELETE"))
show(http.Fetch("$base/add", method = "POST", body = "{\"a\": 2, \"b\": 3}"))
show(http.Fetch("$base/add", method = "POST", body = "not json"))
show(http.Fetch("$base/notes", method = "POST", body = "text=a+b%21"))
show(http.Fetch("$base/boom"))
show(http.Fetch("$base/err"))
r = http.Fetch("$base/cookie")
hdr("set-cookie", r)
hdr("x-tag", r)
hdr("access-control-allow-origin", r)
show(http.Fetch("$base/seen", headers = [{Name: "cookie", Value: "id=a%20b; z=1"}]))
r2 = http.Fetch("$base/go")
io.Print(r2.Value.Status)
hdr("location", r2)
show(http.Fetch("$base/tpl?n=%3Cscript%3E"))
show(http.Fetch("$base/files/web.txt"))
hdr("content-type", http.Fetch("$base/files/web.txt"))
show(http.Fetch("$base/files/../web.ce"))
show(http.Fetch("$base/files/missing.txt"))
io.Print(http.Escape("<a href=\"x\">&'"))
