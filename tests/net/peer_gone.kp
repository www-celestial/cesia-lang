use net
use sys

function keep_writing(c, n)
  if n == 0
    Ok("never failed")
  else
    net.write(c, "hello")?
    sys.sleep(0.001)
    keep_writing(c, n - 1)
  end
end

listener = unwrap(net.listen(18082))
server = spawn(() -> net.accept(listener) then and_then(c -> keep_writing(c, 200)))
sys.sleep(0)
net.close(unwrap(net.connect("127.0.0.1", 18082)))
print(unwrap(wait(server)) then map_err(it.kind))
print("alive")
