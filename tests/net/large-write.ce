use std/net
use std/sys
use std/fiber
use std/io
use std/list
use std/result
use std/text
use std/value

big = text.Join("", list.Fill("0123456789abcdef", 655360))

defn serveBig(listener)
  c = net.Accept(listener)?
  net.Write(c, big)?
  net.Close(c)
  result.Ok(missing)
end

defn readAll(c, total)
  got = net.Read(c)?
  sys.Sleep(0)
  if value.Len(got) == 0 result.Ok(total) else readAll(c, total + value.Len(got)) end
end

defn client()
  c = net.Connect("127.0.0.1", 18087)?
  first = net.Read(c)?
  fiber.Wait(fiber.Spawn(() -> io.Print("ticking")))
  readAll(c, value.Len(first))
end

listener = result.Unwrap(net.Listen(18087))
server = fiber.Spawn(() -> serveBig(listener))
sys.Sleep(0)
io.Print(client())
io.Print(fiber.Wait(server))
