use std/net
use std/sys
use std/fiber
use std/io
use std/result

defn serveOnce(listener)
  c = net.Accept(listener)?
  text = net.Read(c)?
  net.Write(c, "echo: $text")?
  net.Close(c)
  result.Ok(missing)
end

defn client()
  c = net.Connect("127.0.0.1", 18081)?
  net.Write(c, "hello")?
  reply = net.Read(c)?
  net.Close(c)
  result.Ok(reply)
end

listener = result.Unwrap(net.Listen(18081))
server = fiber.Spawn(() -> serveOnce(listener))
sys.Sleep(0)
io.Print(client())
io.Print(fiber.Wait(server))
