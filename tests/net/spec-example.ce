use std/http
use std/net
use std/sys
use std/fiber
use std/io
use std/list
use std/result
use std/text

handle(request) = match sys.Read("page.html")
  result.Ok(page) -> {Status: 200, Body: page}
  result.Err(e) -> {Status: 404, Body: e.Message}
end

crlf = "$(text.Char(13))$(text.Char(10))"
(* The Date, which changes with the clock, is checked by tests/net/http-date.ce. *)
undated(line) = if text.StartsWith("date: ", line) "date: (now)" else line end

defn client()
  c = net.Connect("127.0.0.1", 18096)?
  net.Write(c, "GET / HTTP/1.1$(crlf)Host: a$(crlf)$crlf")?
  net.Read(c) then result.MapOk(r -> list.Map(undated, text.Split(crlf, r)))
end

fiber.Spawn(() -> http.Serve(http.App() then http.AnyMethod("*", handle), port = 18096))
sys.Sleep(0)
io.Print(client())
