(* What a handler finds in its request: the address of the client, without its port, and what a middleware put there. *)
use std/dict
use std/fiber
use std/http
use std/io
use std/result
use std/sys

signed(next, r) = next(dict.Put("User", "Ana", r))
app = http.App() then http.Get("/", r -> http.Plain("$(r.User) from $(r.Peer)")) then http.Wrap(signed)
fiber.Spawn(() -> http.Serve(app, port = 18117))
sys.Sleep(0)
io.Print(http.Fetch("http://127.0.0.1:18117/") then result.MapOk(x -> x.Body))
