use http
use net
use sys

crlf = "$(char(13))$(char(10))"
request = "GET /x HTTP/1.1$(crlf)Host: a$(crlf)$crlf"
handle(r) = {status: 200, body: r.path}

count(text) = length(split("HTTP/1.1", text)) - 1

defn read_until(c, wanted, got)
  if count(got) >= wanted
    Ok(got)
  else
    more = net.read(c)?
    read_until(c, wanted, "$got$more")
  end
end

defn client()
  c = net.connect("127.0.0.1", 18091)?
  net.write(c, "GET /x HT")?
  sys.sleep(0.01)
  net.write(c, slice(10, length(request), request))?
  first = read_until(c, 1, "")?
  net.write(c, "$request$request")?
  both = read_until(c, 2, "")?
  Ok([count(first), count(both)])
end

spawn(() -> http.serve(handle, port = 18091))
sys.sleep(0)
print(client())
