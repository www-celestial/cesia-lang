use std/net
use std/sys
use std/fiber
use std/io
use std/result

defn forever()
  while true end
end

defn answer(listener)
  c = net.Accept(listener)?
  net.Write(c, "pong")?
  result.Ok(missing)
end

listener = result.Unwrap(net.Listen(18083))
server = fiber.Spawn(() -> answer(listener))
spinner = fiber.Spawn(forever)
sys.Sleep(0)
c = result.Unwrap(net.Connect("127.0.0.1", 18083))
io.Print(net.Read(c))
