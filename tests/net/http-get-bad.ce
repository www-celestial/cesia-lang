use std/http
use std/net
use std/sys
use std/fiber
use std/io
use std/result
use std/text

defn reply(listener, answer)
  c = net.Accept(listener)?
  net.Read(c)?
  net.Write(c, answer)?
  net.Close(c)
  result.Ok(missing)
end

kind(r) = r then result.MapErr(it.Kind)

defn replies(listener)
  reply(listener, "not http at all")?
  reply(listener, "HTTP/1.1 200 OK$(crlf)Content-Length: 99$(crlf)$(crlf)short")?
  reply(listener, "HTTP/1.1 200 OK$(crlf)Content-Length: abc$(crlf)$(crlf)short")?
  reply(listener, "HTTP/1.1 200 OK$(crlf)Transfer-Encoding: chunked$(crlf)$(crlf)zz$(crlf)x")?
  reply(listener, "HTTP/1.1 200 OK$(crlf)Transfer-Encoding: chunked$(crlf)$(crlf)ffffffffffffffffffff$(crlf)x$(crlf)0$(crlf)$crlf")
end

crlf = "$(text.Char(13))$(text.Char(10))"
listener = result.Unwrap(net.Listen(18099))
fiber.Spawn(() -> replies(listener))
sys.Sleep(0)
io.Print(http.Get("https://example.com/") then result.MapErr(it.Message))
io.Print(http.Get("ftp://example.com/") then result.MapErr(it.Message))
io.Print(kind(http.Get("http://127.0.0.1:18099/")))
io.Print(kind(http.Get("http://127.0.0.1:18099/")))
io.Print(kind(http.Get("http://127.0.0.1:18099/")))
io.Print(kind(http.Get("http://127.0.0.1:18099/")))
io.Print(kind(http.Get("http://127.0.0.1:18099/")))
io.Print(kind(http.Get("http://127.0.0.1:18079/")))
