use std/web
use std/net
use std/sys
use std/encode
use std/fiber
use std/io
use std/list
use std/result
use std/math
use std/text

crlf = "$(text.Char(13))$(text.Char(10))"

(** Masks a client's payload: each byte xor the byte of the key at its place, the key repeated. *)
mask(key, s) = text.FromBytes([math.BitXor(text.Byte(k, s), text.Byte(math.Mod(k - 1, 4) + 1, key)) for k in 1..text.ByteLength(s)])

a = web.App()
a = web.Websocket("/echo", (m, send) -> send("got $m"), a)
fiber.Spawn(() -> web.Serve(a, port = 18202))
sys.Sleep(0.05)

defn masked(opcode, textValue)
  (** A frame from a client: always masked. *)
  key = "abcd"
  "$(text.FromBytes([128 + opcode, 128 + text.ByteLength(textValue)]))$key$(mask(key, textValue))"
end

defn main()
  c = net.Connect("127.0.0.1", 18202)?
  net.Write(c, "GET /echo HTTP/1.1$(crlf)Host: a$(crlf)Upgrade: websocket$(crlf)Connection: Upgrade$(crlf)Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==$(crlf)$crlf")?
  head = net.Read(c)?
  io.Print(text.Split(crlf, head)[1])
  io.Print(list.Filter(l -> text.StartsWith("sec-websocket-accept", l), text.Split(crlf, head)))
  net.Write(c, masked(1, "hello"))?
  io.Print(text.Bytes(net.Read(c)?))
  net.Write(c, masked(9, "ping"))?
  io.Print(text.Bytes(net.Read(c)?))
  net.Write(c, masked(8, ""))?
  io.Print(text.Bytes(net.Read(c)?))
  result.Ok(missing)
end

io.Print(main())
