(** Requests that a front proxy could read otherwise are refused, and HEAD has no body. *)
use std/http
use std/net
use std/sys
use std/fiber
use std/io
use std/result
use std/text

crlf = "\r\n"
fiber.Spawn(() -> http.Serve(r -> {Status: 200, Body: "hello"}, port = 18206))
sys.Sleep(0.05)

defn exchange(raw)
  c = net.Connect("127.0.0.1", 18206)?
  net.Write(c, raw)?
  got = net.Read(c)?
  net.Close(c)
  result.Ok(got)
end

first(r) = text.Split(crlf, result.Unwrap(r))[1]
h(lines) = "$(text.Join(crlf, lines))$crlf$crlf"

io.Print(first(exchange(h(["GET / HTTP/1.1", "Content-Length : 2"]))))
io.Print(first(exchange(h(["GET / HTTP/1.1", "Transfer-Encoding : chunked"]))))
io.Print(first(exchange(h(["GET / HTTP/1.1", "X: y\nContent-Length: 2"]))))
io.Print(first(exchange(h(["GET / HTTP/1.1", " Content-Length: 2"]))))
io.Print(first(exchange(h(["GET / HTTP/1.9"]))))
io.Print(first(exchange(h(["GET / HTTP/1.1", "Content-Length: +2"]))))
io.Print(first(exchange(h(["GET / HTTP/1.1"]))))
head = result.Unwrap(exchange(h(["HEAD / HTTP/1.1", "Connection: close"])))
io.Print(text.EndsWith(crlf, head), text.Contains("hello", head), text.Contains("content-length: 5", head))
io.Print(http.Get("http://127.0.0.1:18206/a\r\nX: 1") then result.MapErr(it.Message))
io.Print(http.Request("GET X", "http://127.0.0.1:18206/") then result.MapErr(it.Message))
