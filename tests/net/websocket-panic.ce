(** A panic in a WebSocket handler closes its connection, and an idle one reaches its deadline. *)
use std/http
use std/net
use std/sys
use std/bug
use std/fiber
use std/io
use std/result
use std/math
use std/text

crlf = "\r\n"

(** Masks a client's payload: each byte xor the byte of the key at its place, the key repeated. *)
mask(key, s) = text.FromBytes([math.BitXor(text.Byte(k, s), text.Byte(math.Mod(k - 1, 4) + 1, key)) for k in 1..text.ByteLength(s)])

a = http.Websocket("/boom", (m, send) -> bug.Panic("boom"), http.App(), idle = 0.2)
a = http.Websocket("/echo", (m, send) -> send(m), a, idle = 0.1)
(** The reaper passes every 0.5 s: idle closes by 0.6 s, the timeout alone never before 1 s. *)
fiber.Spawn(() -> http.Serve(a, port = 18207, timeout = 1))
sys.Sleep(0.05)

defn opened(path)
  c = net.Connect("127.0.0.1", 18207)?
  net.Write(c, "GET $path HTTP/1.1$(crlf)Host: a$(crlf)Upgrade: websocket$(crlf)Connection: Upgrade$(crlf)Sec-WebSocket-Key: x$(crlf)$crlf")?
  net.Read(c)?
  result.Ok(c)
end

defn main()
  c = opened("/boom")?
  key = "abcd"
  net.Write(c, "$(text.FromBytes([129, 129]))$key$(mask(key, "x"))")?
  io.Print(text.ByteLength(net.Read(c)?))
  net.Close(c)
  idle = opened("/echo")?
  start = sys.Now()
  io.Print(text.ByteLength(net.Read(idle)?), sys.Now() - start < 0.9)
  net.Close(idle)
  result.Ok(missing)
end

io.Print(main())
