(** A panic in a WebSocket handler closes its connection, and an idle one reaches its deadline. *)
use std/web
use std/net
use std/sys
use std/bug
use std/fiber
use std/io
use std/result
use std/text

crlf = "\r\n"
a = web.Websocket("/boom", (m, send) -> bug.Panic("boom"), web.App(), idle = 0.2)
a = web.Websocket("/echo", (m, send) -> send(m), a, idle = 0.1)
(** The reaper passes every 0.5 s: idle closes by 0.6 s, the timeout alone never before 1 s. *)
fiber.Spawn(() -> web.Serve(a, port = 18207, timeout = 1))
sys.Sleep(0.05)

defn opened(path)
  c = net.Connect("127.0.0.1", 18207)?
  net.Write(c, "GET $path HTTP/1.1$(crlf)Host: a$(crlf)Upgrade: websocket$(crlf)Connection: Upgrade$(crlf)Sec-WebSocket-Key: x$(crlf)$crlf")?
  net.Read(c)?
  result.Ok(c)
end

defn main()
  c = opened("/boom")?
  key = "abcd"
  net.Write(c, "$(text.FromBytes([129, 129]))$key$(text.XorBytes(key, "x"))")?
  io.Print(text.ByteLength(net.Read(c)?))
  net.Close(c)
  idle = opened("/echo")?
  start = sys.Now()
  io.Print(text.ByteLength(net.Read(idle)?), sys.Now() - start < 0.9)
  net.Close(idle)
  sys.Sleep(0.05)
  io.Print(net.OpenCount())
  result.Ok(missing)
end

io.Print(main())
