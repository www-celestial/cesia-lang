use pkg/http
use net
use sys

crlf = "$(Char(13))$(Char(10))"
handle(r) = {Status: 200, Body: "$(r.Method) $(r.Path) $(r.Query) $(r.Headers[2].Value)"}

defn exchange(c, request)
  net.Write(c, request)?
  net.Read(c)
end

defn client()
  c = net.Connect("127.0.0.1", 18090)?
  request = "GET /a?x=1 HTTP/1.1$(crlf)Host: cesia$(crlf)X-Two: 2$(crlf)$crlf"
  first = exchange(c, request)?
  second = exchange(c, request)?
  net.Close(c)
  Ok([first, second])
end

Spawn(() -> http.Serve(handle, port = 18090))
sys.Sleep(0)
Print(client() then MapOk(xs -> Map(t -> Replace(crlf, "|", t), xs)))
