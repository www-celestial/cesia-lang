use std/http
use std/net
use std/sys
use std/fiber
use std/io
use std/list
use std/result
use std/text

crlf = "$(text.Char(13))$(text.Char(10))"
handle(r) = {Status: 200, Body: "$(r.Method) $(r.Path) $(r.Query["x"]) $(r.Headers[2].Value)"}

defn exchange(c, request)
  net.Write(c, request)?
  net.Read(c)
end

defn client()
  c = net.Connect("127.0.0.1", 18090)?
  request = "GET /a?x=1 HTTP/1.1$(crlf)Host: cesia$(crlf)X-Two: 2$(crlf)$crlf"
  first = exchange(c, request)?
  second = exchange(c, request)?
  net.Close(c)
  result.Ok([first, second])
end

fiber.Spawn(() -> http.Serve(http.App() then http.AnyMethod("*", handle), port = 18090))
sys.Sleep(0)
io.Print(client() then result.MapOk(xs -> list.Map(t -> text.Replace(crlf, "|", t), xs)))
