== add: geometry, and what it uses
deps/alice/shapes: v1.0.0, src/area, src/geometry.
deps/bob/units: v1.0.0, src/meters.
deps/alice/shapes/cesia.toml
deps/alice/shapes/src/area/area.ce
deps/alice/shapes/src/geometry/geometry.ce
deps/bob/units/cesia.toml
deps/bob/units/src/meters/meters.ce

[deps.shapes]
from = "file://TOP/repos/alice/shapes"
version = "v1.0.0"
take = ["geometry"]
