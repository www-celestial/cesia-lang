(** A program under --watch that takes the stop signals and ends by itself once it has heard enough of them, as an editor with
    unsaved text asks first. See tools/reload-test.sh. *)
use std/sys
use std/io

run() = 1
(** How many stop signals end the program. *)
needed() = 1
(** Does the program end by itself, without a signal? *)
closing() = false

defn main()
  sys.TakeStops(true)
  io.Print("open $(run())")
  heard = 0
  while heard < needed() and not closing()
    if sys.StopAsked()
      heard = heard + 1
      io.Print("quit $heard")
    end
    sys.Sleep(0.005)
  end
  sys.TakeStops(false)
  io.Print("ended $(run())")
end

main()
