(** Runs forever: tools/reload-test.sh edits this file while it runs. *)
use lib

Print("start")

struct Point { X }

value() = 1
following() = value() + 1
point() = Point(1).X
readKept(xs) = xs[1]
(p Point) Value() = 1
Point.Made() = Point(1)
method() = Point.Made().Value()
held = Point(1)
old() = held.Value()
struct Box { V Int }
box = Box(1)
made() = Box(2).V
heldBox() = box.V
scaled(by Int) = by * 2
param() = scaled(1.5)
answer() Int = 1.5
interface Sized { Size() }
struct Tile { N }
(t Tile) Size() = t.N
(s Sized) Twice() = 2 * s.Size()
sized(s Sized) = s.Size()
measured() = sized(Tile(2))
twice() = Tile(1).Twice()

defn boxed()
  b = box
  b.V = 1.5
  b.V
end

defn report(label, before, after)
  if not Equal(before, after)
    Print("$label $after")
  end
  after
end

attempt(f) = match Wait(Spawn(f))
  Ok(v) -> v
  Err(e) -> e.Kind
end

defn mainLoop()
  a = value()
  Print("value $a")
  b = 0
  c = 0
  d = 0
  e = 0
  f = 0
  g = 0
  h = 0
  i = 0
  j = 0
  k = 0
  l = 0
  m = 0
  n = 0
  o = 0
  q = 0
  r = 0
  tile = Tile(1)
  x = [1, 2]
  while true
    a = report("value", a, value())
    b = report("following", b, attempt(following))
    c = report("direct", c, attempt(() -> value() + 1))
    d = report("lib", d, lib.Constant())
    e = report("point", e, point())
    f = report("kept", f, readKept(x))
    g = report("owner", g, x[1])
    h = report("method", h, attempt(method))
    i = report("old", i, attempt(old))
    j = report("made", j, attempt(made))
    k = report("held", k, attempt(heldBox))
    l = report("param", l, attempt(param))
    m = report("box", m, attempt(boxed))
    n = report("iface", n, attempt(measured))
    o = report("twice", o, attempt(twice))
    q = report("loop", q, attempt(() -> tile.Twice()))
    r = report("result", r, attempt(answer))
  end
end

defn watcher(seen)
  v = value()
  if not Equal(v, seen)
    Print("fiber $v")
  end
  watcher(v)
end

background = Spawn(() -> watcher(0))
mainLoop()
