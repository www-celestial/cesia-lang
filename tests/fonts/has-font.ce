(** Stops when SDL3_ttf or the font JetBrains Mono is missing: tools/test.sh then skips this folder. *)
use std/bug
use std/c
use std/result
use std/sys
bug.Assert(result.IsOk(c.Open("SDL3_ttf", version = 0)) and sys.Exists("/usr/share/fonts/TTF/JetBrainsMono-Regular.ttf"), "No SDL3_ttf or no JetBrains Mono.")
