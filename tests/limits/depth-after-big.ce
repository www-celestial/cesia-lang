(** Large frames first, small ones next: the limit stays exact. *)
use std/io

defn big(n)
  a = 1
  b = a + 1
  c = b + 1
  d = [c]
  e = [c, d]
  f = [c, e]
  g = [c, f]
  h = [c, g]
  i = [c, h]
  j = [c, i]
  k = [c, j]
  l = [c, k]
  m = [c, l]
  o = [c, m]
  p = [c, o]
  if n == 0 0 else 1 + big(n - 1) end
end
small(n) = if n == 0 0 else 1 + small(n - 1) end
io.Print("big", big(95))
io.Print("small", small(1500))
