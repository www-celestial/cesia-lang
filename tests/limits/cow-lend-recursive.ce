(** A tree walk that passes the sheet down, as a formula does. *)
use std/io
use std/list

defn walk(depth, xs, i)
  if depth == 0
    xs[i]
  else
    walk(depth - 1, xs, i) + walk(depth - 1, xs, i)
  end
end

defn run(n)
  x = list.Fill(0.75, n)
  for i in 1..n
    x[i] = walk(2, x, i)
  end
  x[n]
end
io.Print(run(100000))
