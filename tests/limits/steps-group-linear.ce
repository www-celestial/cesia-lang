use std/fn
use std/io
use std/list
use std/math
use std/value

struct P { A, B }
n = 20000
mixed = list.Concat([k for k in 1..n], [1e300])
texts = list.Concat([value.Text(k) for k in 1..n], [[1]])
pairs = [[k, 0.5 * math.Mod(k, 7)] for k in 1..n]
maps = [{A: k, B: "x"} for k in 1..n]
structs = [P(k, math.Mod(k, 3)) for k in 1..n]
bigs = list.Concat([9007199254740993 + 2 * k for k in 1..n], [9007199254740992.0])
io.Print(value.Len(list.Group(fn.Identity, mixed)), value.Len(list.Group(fn.Identity, texts)), value.Len(list.Group(fn.Identity, pairs)), value.Len(list.Group(fn.Identity, maps)), value.Len(list.Group(fn.Identity, structs)), value.Len(list.Group(x -> [x], bigs)))
