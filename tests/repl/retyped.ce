(* A function defined again with results of another type: the loop that runs since before takes it at its next call. *)
use std/io
use std/sys
defn F(x)
  x + 1
end
defn loop()
  for k in 1..3
    s = 0
    for i in 1..1000
      s = s + F(i)
    end
    io.Print(s)
    sys.Sleep(0)
  end
end
loop()
io.Print(F(1))
