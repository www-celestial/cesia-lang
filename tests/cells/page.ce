(* The page that client.ce makes: the notebook without its slow cell. *)
use std/cells
use std/frame
use std/io
use std/plot

(* %% Data *)
n = 4
xs = [i * i for i in 1..n]
df = frame.Of({"i": [1, 2, 3], "sq": [1.0, 4.0, 9.0]})
df

(* %% Sum *)
defn total(v)
  s = 0
  for x in v
    s = s + x
  end
  s
end
io.Print("total $(total(xs))")
total(xs) + n

(* %% Graph *)
plot.Line([1, 2, 3], [1, 4, 9])

(* %% Moving *)
plot.Frames([plot.Line([1, 2, 3], [k, 4 * k, 9 * k], label = "k") for k in 1..3], fps = 6)

(* %% Surface *)
plot.Surface([1, 2, 3; 2, 4, 1])

(* %% Two *)
io.Print("first")
cells.Show(plot.Frames([plot.Line([1, 2], [k, 2 * k]) for k in 1..2], fps = 4))
io.Print("then")
cells.Show(9)
plot.Line([1, 2], [2, 1])
