(* The file of the sliders of sliders.ce and set.cmd: a cell of sliders, a function that reads one, and a cell that calls
   it. *)
use std/cells
use std/io

(* %% Parameters *)
rho = cells.Slider(28.0, 0.0, 50.0, step = 0.5)
n = cells.Slider(3, 0, 10)

(* %% Rate *)
defn rate(x)
  x * rho
end
label = "a text"

(* %% Use *)
io.Print("n is $n")
rate(2)
