(* std/cells from the side of a program that runs cells: a session on notebook.ce, its runs, its variables, a stop, the
   names forgotten, and the page of the file. *)
use std/cells
use std/fiber
use std/io
use std/list
use std/result
use std/sys
use std/text
use std/value

defn shown(r)
  (** A run without its time. *)
  match r
    result.Ok(x) -> "Ok: output $(x.Output), value $(x.Value), error $(x.Error)"
    result.Err(e) -> "Err: $(e.Message)"
  end
end

defn Main()
  (** The steps, each printed. *)
  cs = cells.Parse(sys.Read("notebook.ce")?)
  io.Print([c.Title for c in cs])
  a = cells.Analyse(cs)
  io.Print([x.Defines for x in a])
  io.Print(cells.ToRun(a, 2))
  s = cells.Session("notebook.ce")?
  for i in 1..3
    io.Print(shown(cells.Run(s, cs[i])))
  end
  io.Print(cells.Variables(s)?)
  slow = fiber.Spawn(() -> cells.Run(s, cs[4]))
  sys.Sleep(0.2)
  s = cells.Stop(s)?
  io.Print("restarted: $(s.Restarted)")
  io.Print(shown(fiber.Wait(slow)?))
  io.Print(shown(cells.Run(s, {Title: "", From: 30, To: 30, Source: "n + 1"})))
  cells.Forget(s, ["n"])?
  io.Print(shown(cells.Run(s, {Title: "", From: 30, To: 30, Source: "n + 1"})))
  io.Print([v.Name for v in cells.Variables(s)?])
  page = cells.Html("page.ce")
  io.Print("$(value.Len(text.Split("<section>", page?)) - 1) sections")
  io.Print(text.Contains("<td>9.0</td>", page?), text.Contains("total 30", page?))
  result.Ok(missing)
end

r = Main()
if result.IsErr(r)
  io.Print(r)
end
