(* std/cells from the side of a program that runs cells: a session on notebook.ce, its runs, its variables, a stop, the
   names forgotten, and the page of the file. *)
use std/cells
use std/dict
use std/fiber
use std/io
use std/list
use std/plot
use std/result
use std/sys
use std/text
use std/value

defn shown(r)
  (** A run without its time. *)
  match r
    result.Ok(x) -> "Ok: output $(x.Output), value $(x.Value), error $(x.Error)"
    result.Err(e) -> "Err: $(e.Message)"
  end
end

defn Main()
  (** The steps, each printed. *)
  cs = cells.Parse(sys.Read("notebook.ce")?)
  io.Print([c.Title for c in cs])
  a = cells.Analyse(cs)
  io.Print([x.Defines for x in a])
  io.Print(cells.ToRun(a, 2))
  s = cells.Session("notebook.ce")?
  for i in 1..3
    io.Print(shown(cells.Run(s, cs[i])))
  end
  io.Print(cells.Variables(s)?)
  slow = fiber.Spawn(() -> cells.Run(s, cs[4]))
  sys.Sleep(0.2)
  s = cells.Stop(s)?
  io.Print("restarted: $(s.Restarted)")
  io.Print(shown(fiber.Wait(slow)?))
  io.Print(shown(cells.Run(s, {Title: "", From: 30, To: 30, Source: "n + 1"})))
  cells.Forget(s, ["n"])?
  io.Print(shown(cells.Run(s, {Title: "", From: 30, To: 30, Source: "n + 1"})))
  io.Print([v.Name for v in cells.Variables(s)?])
  g = cells.Run(s, {Title: "", From: 40, To: 41, Source: "use std/plot\nplot.Line([1, 2], [3, 4])"}, width = 500)?.Value
  io.Print("graph: $(g.Kind), $(g.Scene.Width) by $(g.Scene.Height), $(value.Len(g.Scene.Items) > 10) items")
  io.Print("again: $(cells.Scene(s, g.Key, 300)?.Width) wide")
  (* A graph keeps the shape of its own size, at the width asked or its own when it is less: a polar graph square. *)
  round = cells.Run(s, {Title: "", From: 41, To: 41, Source: "plot.Of([plot.Line([0, 90], [1, 2])], polar = true)"}, width = 900)?.Value
  io.Print("polar: $(round.Scene.Width) by $(round.Scene.Height), at 300 $(cells.Scene(s, round.Key, 300)?.Height) high")
  long = cells.Run(s, {Title: "", From: 41, To: 41, Source: "plot.Of([plot.Line([1, 2], [3, 4])], size = [800, 300])"}, width = 1000)?.Value
  io.Print("long: $(long.Scene.Width) by $(long.Scene.Height), at 400 $(cells.Scene(s, long.Key, 400)?.Height) high")
  io.Print(shown(cells.Run(s, {Title: "", From: 42, To: 42, Source: "plot.Line([1, 2], [1])"})))
  moving = cells.Run(s, {Title: "", From: 43, To: 43, Source: "plot.Frames([plot.Line([1, 2], [k, 2 * k]) for k in 1..4], fps = 12)"}, width = 500)?.Value
  io.Print("animation: $(moving.Frames) frames at $(moving.Fps) a second, and its scene says $(moving.Scene.Frames)")
  third = cells.Scene(s, moving.Key, 300, frame = 3)?
  io.Print("frame 3: $(third.Width) wide, $(third.Frames) frames, $(value.Len(third.Items) > 10) items")
  io.Print(cells.Scene(s, moving.Key, 300, frame = 5))
  io.Print(cells.Scene(s, g.Key, 300, frame = 2))
  solid = cells.Run(s, {Title: "", From: 44, To: 44, Source: "plot.Of([plot.Surface([1, 2, 3; 2, 4, 1])], view = [10, 20])"}, width = 500)?.Value
  io.Print("surface: view $(solid.View), its scene's $(solid.Scene.View)")
  turned = cells.Scene(s, solid.Key, 400, view = [-62.5, 20])?
  io.Print("turned: $(turned.Width) wide, view $(turned.View), $(value.Len([x for x in turned.Items if x.Kind == "mesh"])) mesh")
  io.Print(cells.Scene(s, g.Key, 300, view = [0, 30]))
  io.Print(cells.Scene(s, solid.Key, 300, view = [0, 91]))
  both = cells.Run(s, {Title: "", From: 45, To: 50, Source: "use std/cells\nuse std/io\nio.Print(\"before\")\ncells.Show(plot.Line([1, 2], [2, 1]))\nio.Print(\"after\")\ncells.Show(3)\n4"}, width = 500)?
  io.Print("shown: $(both.Output), $([x.After for x in both.Shown]), $([x.Value.Kind for x in both.Shown]), $(both.Shown[2].Value.Text), value $(both.Value.Text)")
  io.Print("shown again: $(cells.Scene(s, both.Shown[1].Value.Key, 300)?.Width) wide, key $(both.Shown[1].Value.Key)")
  (* A table that a run showed is read again by its key, a screen at a time, sorted and filtered in the session, each row
     with its place in the value; a graph of as many points is marked at a row: a ring and the box of its values, and the
     places of its points on the screen. *)
  day = cells.Run(s, {Title: "", From: 46, To: 49, Source: "use std/frame\nhours = frame.Of({hour: [7, 8, 9], elevation: [0.48, 9.99, 18.14]})\ncells.Show(hours)\nplot.Of([plot.Line(frame.Column(\"hour\", hours), frame.Column(\"elevation\", hours)), plot.Points([1, 2], [3, 4])])"}, width = 500)?
  table = day.Shown[1].Value
  io.Print("table: key $(table.Key), $(table.Count) rows; graph key $(day.Value.Key)")
  io.Print(cells.Rows(s, table.Key, 1, 2, sort = {Column: "elevation", Descending: true}, find = 1))
  io.Print(cells.Rows(s, "hours", 1, 3, filter = "9."))
  marked = cells.Scene(s, day.Value.Key, 400, mark = [2, 3])?
  io.Print("marked: $([[p.Layer, p.Kind, p.At, value.Len(p.Xs)] for p in marked.Points]), $([x.Text for x in marked.Items if x.Role == "mark" and x.Kind == "text"]), $(value.Len([x for x in marked.Items if x.Role == "mark" and x.Kind == "line"])) lines")
  io.Print("unmarked: $(dict.Has("Points", cells.Scene(s, day.Value.Key, 400)?)), $(value.Len([x for x in cells.Scene(s, day.Value.Key, 400)?.Items if x.Role == "mark"])) marks")
  io.Print(cells.Scene(s, day.Value.Key, 400, mark = [4, 3]))
  (* The points of every layer, their values and the axes, for the mouse of an editor; other ranges, as a zoom; the SVG
     of the graph, as plot.Save writes it. *)
  pointed = cells.Scene(s, day.Value.Key, 400, points = true, xlim = [6, 10], ylim = [0, 20])?
  io.Print("pointed: $([[p.Layer, p.Count, p.At, p.Values.X, p.Values.Y] for p in pointed.Points]), x $(pointed.Axes.X.Scale) from $(pointed.Axes.X.Low) to $(pointed.Axes.X.High), y to $(pointed.Axes.Y.High)")
  both = cells.Scene(s, day.Value.Key, 400, mark = [2, 3], points = true)?
  io.Print("marked and pointed: $([p.Layer for p in both.Points]) layers, $(value.Len([x for x in both.Items if x.Role == "mark" and x.Kind == "line"])) lines")
  io.Print(cells.Scene(s, day.Value.Key, 400, xlim = [10, 6]))
  io.Print("svg: $(text.StartsWith("<svg", cells.Svg(s, day.Value.Key)?)), the same as plot.Svg: $(cells.Svg(s, day.Value.Key)? == plot.Svg(plot.Of([plot.Line([7, 8, 9], [0.48, 9.99, 18.14]), plot.Points([1, 2], [3, 4])]))?)")
  io.Print(cells.Svg(s, "999"))
  io.Print(cells.Rows(s, day.Value.Key, 1, 3))
  (* An ask gives at most 1000 rows, 20,000 cells and 256 columns, and a cell's text is cut at 200 characters. *)
  _ = cells.Run(s, {Title: "", From: 50, To: 50, Source: "use std/text\nlong = frame.Of({a: [k for k in 1..1500]})\nwide = frame.Table([\"c$$j\" for j in 1..300], [[j for k in 1..100] for j in 1..300])\nwordy = frame.Of({t: [text.Repeat(500, \"x\")]})"})?
  io.Print("caps: $(value.Len(cells.Rows(s, "long", 1, 1500)?.Rows)) rows; $(value.Len(cells.Rows(s, "wide", 1, 100)?.Columns)) columns, $(value.Len(cells.Rows(s, "wide", 1, 100)?.Rows)) rows; $(value.Len(cells.Rows(s, "wordy", 1, 1)?.Rows[1][1])) characters")
  page = cells.Html("page.ce")
  io.Print("$(value.Len(text.Split("<section>", page?)) - 1) sections")
  io.Print(text.Contains("<td class=\"n\">9.0</td>", page?), text.Contains("total 30", page?), text.Contains("<div class=\"graph\"><svg", page?))
  io.Print(text.Contains("<title>Surface, 2 × 3 points, z from 1 to 4</title>", page?))
  io.Print(text.Contains("<div class=\"graph anim\"><input type=\"checkbox\" class=\"play\" id=\"play5\"><label for=\"play5\">Play</label>\n<svg", page?), text.Contains(".anim .f { animation-play-state: paused; }", page?))
  (* The cell of two: what it printed and what it showed, in their order, its own animation's box named apart, then its value. *)
  (* A table of the page: its header, each text escaped, the numbers on the right, their decimal points in a column. *)
  io.Print(text.Contains("<thead><tr><th>place &lt;b&gt;</th><th class=\"n\">elevation</th></tr></thead>", page?), text.Contains("<td>&lt;script&gt;alert(1)&lt;/script&gt;</td><td class=\"n\">9.99&#8199;</td>", page?),
    text.Contains("<td class=\"n\">28.5&#8199;&#8199;</td>", page?), not text.Contains("<script>", page?), text.Contains("a &amp; &quot;b&quot;", page?))
  two = text.Split("<h2>Two</h2>", text.Split("<h2>Table</h2>", page?)[1])[2]
  order = [text.Find(w, two) for w in ["<pre class=\"output\">first</pre>", "id=\"play7-1\"", "<pre class=\"output\">then</pre>", "<pre class=\"value\">9</pre>", "<div class=\"graph\"><svg"]]
  io.Print("two: $(list.All([value.IsSome(k) for k in order]) and value.Equal(order, list.Sort(order)))")
  result.Ok(missing)
end

r = Main()
if result.IsErr(r)
  io.Print(r)
end
