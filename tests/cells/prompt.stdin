{"Do": "run", "Code": "x = 1", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "x = x + 1", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "x", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "use std/text\nx = \"a\"", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "text.Join(\"-\", [x, \"b\"])", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "xs = [1, 2]", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "xs[2] = 7", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "xs", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "struct Point { X, Y = 0 }\np = Point(1, 2)", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "p.X = 3", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "q = p", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "q.X = 10", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "[p, q]", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "s = 0", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "for i in 1..3\n  s = s + i\nend", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "[s, i]", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "for i in 1..3\n  s = s + i\nend\ns", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "y = 5", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "y = y + 1\nz = [1, 2][7]", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "y", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "y = y + \"a\"", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "y", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "k = 10", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "defn scale(a)\n  a * k\nend\ng = (v) -> v + k\ndefn total(m)\n  t = 0\n  for i in 1..m\n    t = t + k\n  end\n  t\nend", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "[scale(2), g(1), total(100000)]", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "k = k + 1", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "[scale(2), g(1), total(100000)]", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "k = 0.5\n[scale(2), g(1), total(100000)]", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "k = \"a\"\ntotal(100000)", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "k = 3\n[scale(2), g(1), total(100000)]", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "defn f(a)\n  a + 1\nend", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "defn f(a)\n  a * 10\nend\nf(2)", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "use std/cells\nuse std/io", "Line": 3, "Path": "knobs.ce"}
{"Do": "run", "Code": "(* %% Parameters *)\nrho = cells.Slider(28.0, 0.0, 50.0, step = 0.5)\nn = cells.Slider(3, 0, 10)", "Line": 6, "Path": "knobs.ce"}
{"Do": "run", "Code": "(* %% Rate *)\ndefn rate(x)\n  x * rho\nend\nlabel = \"a text\"", "Line": 10, "Path": "knobs.ce"}
{"Do": "run", "Code": "rho = rho + 1\nrate(2)", "Line": 0, "Path": "knobs.ce"}
{"Do": "set", "Name": "rho", "Text": "31.5"}
{"Do": "run", "Code": "[rho, rate(2)]", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "rho = \"high\"", "Line": 0, "Path": "knobs.ce"}
{"Do": "set", "Name": "rho", "Text": "1"}
{"Do": "run", "Code": "rho = 2.0", "Line": 0, "Path": "knobs.ce"}
{"Do": "set", "Name": "rho", "Text": "4.5"}
{"Do": "run", "Code": "[rho, rate(2)]", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "defn count(m)\n  c = 0\n  for i in 1..m\n    c = c + n\n  end\n  c\nend\ncount(100000)", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "n = n + 1\ncount(100000)", "Line": 0, "Path": "knobs.ce"}
{"Do": "set", "Name": "n", "Text": "3.5"}
{"Do": "run", "Code": "count(100000)", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "n = n * 2\ncount(100000)", "Line": 0, "Path": "knobs.ce"}
{"Do": "run", "Code": "(* %% Parameters *)\nrho = cells.Slider(28.0, 0.0, 50.0, step = 0.5)\nn = cells.Slider(3, 0, 10)", "Line": 6, "Path": "knobs.ce"}
{"Do": "run", "Code": "[rho, n]", "Line": 0, "Path": "knobs.ce"}
{"Do": "variables"}
{"Do": "stop"}
