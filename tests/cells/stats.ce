(* std/cells with std/stats: a cell's random draws are the same each time it runs, whatever ran before, as the
   generator starts again from the seed of the session and the cell's title; an Ok of a struct shows the struct, and a
   struct shows as a table of its fields, each cut at 80 characters, and formats no more of a long list than that; a
   Monte Carlo estimate, run again after another cell, is the same. *)
use std/cells
use std/io
use std/result
use std/sys
use std/text
use std/value

defn Main()
  cs = cells.Parse(sys.Read("stats-notebook.ce")?)
  s = cells.Session("stats-notebook.ce")?
  cells.Run(s, cs[1])?
  first = cells.Run(s, cs[2])?.Value
  cells.Run(s, cs[3])?
  again = cells.Run(s, cs[2])?.Value
  io.Print("same draws: $(value.Equal(first, again))")
  t = cells.Run(s, cs[3])?.Value
  io.Print(t.Kind, t.Columns, t.Rows[1], t.Rows[5][1], t.Count)
  g = cells.Run(s, cs[4])?.Value
  io.Print(g.Kind, g.Rows)
  long = cells.Run(s, cs[5])?.Value
  io.Print(long.Kind, long.Rows)
  d = cells.Run(s, cs[6])?.Value
  io.Print(d.Kind, value.Len(d.Text), text.Slice(1, 30, d.Text))
  mc = cells.Run(s, cs[7])?.Value
  cells.Run(s, cs[2])?
  again2 = cells.Run(s, cs[7])?.Value
  io.Print("same estimate: $(value.Equal(mc, again2))", mc.Kind, mc.Columns, [r[1] for r in mc.Rows])
  result.Ok(missing)
end

r = Main()
if result.IsErr(r)
  io.Print(r)
end
