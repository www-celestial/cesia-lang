use set
use queue
use heap
use algo

is_set_of() = equal(set.items(set.of([2, 1, 2])), [1, 2])
is_set_member() = set.member(1, set.of([1])) and not set.member(2, set.of([1]))
is_set_add_remove() = set.count(set.remove(1, set.add(2, set.of([1])))) == 1
is_set_union() = equal(set.items(set.union(set.of([1]), set.of([2]))), [1, 2])
is_set_intersection() = equal(set.items(set.intersection(set.of([1, 2]), set.of([2, 3]))), [2])
is_set_difference() = equal(set.items(set.difference(set.of([1, 2]), set.of([2]))), [1])
is_set_subset() = set.subset(set.of([1]), set.of([1, 2])) and not set.subset(set.of([3]), set.of([1, 2]))
is_queue_order() = equal(queue.items(queue.pop(queue.of([1, 2, 3]))), [2, 3])
is_queue_ends() = queue.first(queue.of([1, 2])) == 1 and queue.last(queue.of([1, 2])) == 2
is_queue_front() = equal(queue.items(queue.push_front(0, queue.of([1]))), [0, 1])
is_queue_back() = equal(queue.items(queue.pop_back(queue.of([1, 2]))), [1])
is_queue_empty() = queue.is_empty(queue.pop(queue.of([1]))) and is_missing(queue.first(queue.empty()))
is_queue_empty_pop() = queue.is_empty(queue.pop(queue.empty()))

defn is_queue_many()
  q = queue.empty()
  for i in 1:3000
    q = queue.push(i, q)
  end
  while queue.count(q) > 1
    q = queue.pop(q)
  end
  queue.first(q) == 3000
end

defn is_heap_sorts()
  h = heap.empty()
  for k in [5, 1, 4, 2, 3]
    h = heap.insert(k, "v$k", h)
  end
  equal(map(it.key, heap.items(h)), [1, 2, 3, 4, 5]) and heap.peek(h).value == "v1"
end

is_heap_empty() = heap.is_empty(heap.empty()) and equal(heap.items(heap.empty()), [])
is_gcd() = algo.gcd(12, 18) == 6 and algo.gcd(7, 0) == 7 and algo.lcm(4, 6) == 12
is_prime_test() = algo.is_prime(97) and not algo.is_prime(1) and not algo.is_prime(91)
is_primes() = equal(algo.primes(20), [2, 3, 5, 7, 11, 13, 17, 19]) and equal(algo.primes(1), [])
is_search() = algo.binary_search(3, [1, 3, 5]) == 2 and is_missing(algo.binary_search(2, [1, 3, 5]))
is_lower_bound() = algo.lower_bound(4, [1, 3, 5]) == 3 and algo.lower_bound(9, [1]) == 2
is_partition() = equal(algo.partition(it > 1, [1, 2, 3]), {yes: [2, 3], no: [1]})
is_chunk() = equal(algo.chunk(2, [1, 2, 3]), [[1, 2], [3]])
is_windows() = equal(algo.windows(2, [1, 2, 3]), [[1, 2], [2, 3]])
is_permutations() = length(algo.permutations([1, 2, 3])) == 6 and equal(algo.permutations([1, 2])[2], [2, 1])
is_combinations() = equal(algo.combinations(2, [1, 2, 3]), [[1, 2], [1, 3], [2, 3]])
is_levenshtein() = algo.levenshtein("kitten", "sitting") == 3 and algo.levenshtein("", "ab") == 2

graph = {1: [2, 3], 2: [4], 3: [4], 4: [1]}
is_bfs() = equal(algo.bfs(1, n -> graph[n]), [1, 2, 3, 4])
is_dfs() = equal(algo.dfs(1, n -> graph[n]), [1, 2, 4, 3])

weights = {"a": [{node: "b", weight: 7}, {node: "c", weight: 1}], "b": [], "c": [{node: "b", weight: 2}]}
is_dijkstra() = equal(algo.dijkstra("a", n -> weights[n]), {"a": 0, "b": 3, "c": 1})

deps = {"app": ["lib", "log"], "lib": ["log"], "log": []}
is_topological() = equal(unwrap(algo.topological_sort(["app"], n -> deps[n])), ["log", "lib", "app"])
is_topological_cycle() = is_err(algo.topological_sort([1], n -> [1]))
