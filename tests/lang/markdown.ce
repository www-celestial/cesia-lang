(** Markdown to HTML, std/markdown: CommonMark and GitHub's tables, each case with the HTML that cmark-gfm, GitHub's own, gives
    for it. What differs on purpose has its own test: raw HTML and entities are text, a link leads only to http, https,
    mailto or a page, and a line indented by four spaces is no code. *)
use std/markdown
use std/cesia
use std/list
use std/text
use std/value

html(source) = markdown.Html(markdown.Parse(source), markdown.Plain)
failing(cases) = list.Filter(c -> html(c[1]) != c[2], cases)

headings = [
  ["# Title", "<h1>Title</h1>\n"],
  ["## Two ##", "<h2>Two</h2>\n"],
  ["####### seven", "<p>####### seven</p>\n"],
  ["#5 bolt", "<p>#5 bolt</p>\n"],
  ["#", "<h1></h1>\n"],
  ["### a ### b", "<h3>a ### b</h3>\n"],
  ["# foo#", "<h1>foo#</h1>\n"],
  ["  ## indented", "<h2>indented</h2>\n"],
  ["Title\n=====", "<h1>Title</h1>\n"],
  ["Sub\n---", "<h2>Sub</h2>\n"],
  ["a\nb\n---", "<h2>a\nb</h2>\n"],
  ["---", "<hr />\n"],
  ["***", "<hr />\n"],
  ["_ _ _", "<hr />\n"],
  ["Foo *bar*\n=========", "<h1>Foo <em>bar</em></h1>\n"],
  ["Foo\n-------------------------", "<h2>Foo</h2>\n"],
  ["   Foo\n---", "<h2>Foo</h2>\n"],
  ["Foo  \n-----", "<h2>Foo</h2>\n"],
  ["Foo\\\n----", "<h2>Foo\\</h2>\n"],
  ["`Foo\n----\n`", "<h2>`Foo</h2>\n<p>`</p>\n"],
  ["Foo\nbar\n---\nbaz", "<h2>Foo\nbar</h2>\n<p>baz</p>\n"],
  ["\n====", "<p>====</p>\n"],
  ["---\n---", "<hr />\n<hr />\n"],
  ["Foo\n---\nbar", "<h2>Foo</h2>\n<p>bar</p>\n"],
  ["# foo *bar* \\*baz\\*", "<h1>foo <em>bar</em> *baz*</h1>\n"],
  ["#                  foo                     ", "<h1>foo</h1>\n"],
  [" ### foo", "<h3>foo</h3>\n"],
  ["  ## foo", "<h2>foo</h2>\n"],
  ["## foo ##", "<h2>foo</h2>\n"],
  ["  ###   bar    ###", "<h3>bar</h3>\n"],
  ["# foo ##################################", "<h1>foo</h1>\n"],
  ["##### foo ##", "<h5>foo</h5>\n"],
  ["### foo ###     ", "<h3>foo</h3>\n"],
  ["### foo ### b", "<h3>foo ### b</h3>\n"],
  ["### foo \\###", "<h3>foo ###</h3>\n"],
  ["## foo #\\##", "<h2>foo ###</h2>\n"],
  ["# foo \\#", "<h1>foo #</h1>\n"],
  ["## \n#\n### ###", "<h2></h2>\n<h1></h1>\n<h3></h3>\n"],
  ["_ _ _ _ a\n\na------\n\n---a---", "<p>_ _ _ _ a</p>\n<p>a------</p>\n<p>---a---</p>\n"],
  ["### foo\\", "<h3>foo\\</h3>\n"],
  ["### foo  ", "<h3>foo</h3>\n"]
]
isHeadingsAndRules() = value.Equal(failing(headings), [])

paragraphs = [
  ["--", "<p>--</p>\n"],
  ["one\ntwo", "<p>one\ntwo</p>\n"],
  ["one  \ntwo", "<p>one<br />\ntwo</p>\n"],
  ["one\\\ntwo", "<p>one<br />\ntwo</p>\n"],
  ["a\n\nb", "<p>a</p>\n<p>b</p>\n"],
  ["  lead spaces\n   more", "<p>lead spaces\nmore</p>\n"],
  ["back\\slash \\a", "<p>back\\slash \\a</p>\n"],
  ["text\n- item", "<p>text</p>\n<ul>\n<li>item</li>\n</ul>\n"],
  ["text\n2. item", "<p>text\n2. item</p>\n"],
  ["text\n1. item", "<p>text</p>\n<ol>\n<li>item</li>\n</ol>\n"],
  ["| a |\n| b |", "<p>| a |\n| b |</p>\n"],
  ["one\n\n\n\ntwo", "<p>one</p>\n<p>two</p>\n"],
  ["  \n  \na", "<p>a</p>\n"],
  ["a\n# h\nb", "<p>a</p>\n<h1>h</h1>\n<p>b</p>\n"],
  ["a\n> q", "<p>a</p>\n<blockquote>\n<p>q</p>\n</blockquote>\n"],
  ["a\\\nb", "<p>a<br />\nb</p>\n"],
  ["trailing   ", "<p>trailing</p>\n"],
  ["-one\n\n2.two", "<p>-one</p>\n<p>2.two</p>\n"],
  ["-1. not ok", "<p>-1. not ok</p>\n"],
  ["Foo\n- bar\n- baz", "<p>Foo</p>\n<ul>\n<li>bar</li>\n<li>baz</li>\n</ul>\n"],
  ["The number of windows in my house is\n14.  The number of doors is 6.", "<p>The number of windows in my house is\n14.  The number of doors is 6.</p>\n"],
  ["foo\n> bar", "<p>foo</p>\n<blockquote>\n<p>bar</p>\n</blockquote>\n"],
  ["Foo\n= =", "<p>Foo\n= =</p>\n"],
  ["Foo bar\n# baz\nBar foo", "<p>Foo bar</p>\n<h1>baz</h1>\n<p>Bar foo</p>\n"],
  ["http://example.com", "<p>http://example.com</p>\n"],
  ["foo@bar.example.com", "<p>foo@bar.example.com</p>\n"],
  ["foo  \nbaz", "<p>foo<br />\nbaz</p>\n"],
  ["foo\\\nbaz", "<p>foo<br />\nbaz</p>\n"],
  ["foo       \nbaz", "<p>foo<br />\nbaz</p>\n"],
  ["foo  \n     bar", "<p>foo<br />\nbar</p>\n"],
  ["foo\\\n     bar", "<p>foo<br />\nbar</p>\n"],
  ["foo\\", "<p>foo\\</p>\n"],
  ["foo  ", "<p>foo</p>\n"],
  ["foo \nbaz", "<p>foo\nbaz</p>\n"],
  ["foo \n baz", "<p>foo\nbaz</p>\n"],
  ["\\\t\\A\\a\\ \\3\\φ\\«", "<p>\\\t\\A\\a\\ \\3\\φ\\«</p>\n"]
]
isParagraphs() = value.Equal(failing(paragraphs), [])

