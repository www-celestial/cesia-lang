  ["| abc | def |\n| --- | --- |\n| bar | baz |\n> bar", "<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>bar</td>\n<td>baz</td>\n</tr>\n</tbody>\n</table>\n<blockquote>\n<p>bar</p>\n</blockquote>\n"],
  ["| abc | def |\n| --- | --- |\n| bar | baz |\nbar\n\nbar", "<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>bar</td>\n<td>baz</td>\n</tr>\n<tr>\n<td>bar</td>\n<td></td>\n</tr>\n</tbody>\n</table>\n<p>bar</p>\n"],
  ["| abc | def |\n| --- |\n| bar |", "<p>| abc | def |\n| --- |\n| bar |</p>\n"],
  ["| abc | def |\n| --- | --- |\n| bar |\n| bar | baz | boo |", "<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>bar</td>\n<td></td>\n</tr>\n<tr>\n<td>bar</td>\n<td>baz</td>\n</tr>\n</tbody>\n</table>\n"],
  ["| abc | def |\n| --- | --- |", "<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n</table>\n"],
  ["| a |\n| --- |\n- b", "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n</table>\n<ul>\n<li>b</li>\n</ul>\n"],
  ["| a |\n| --- |\n# b", "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n</table>\n<h1>b</h1>\n"],
  ["\\!\\\"\\#\\$$\\%\\&\\'\\(\\)\\*\\+\\,\\-\\.\\/\\:\\;\\<\\=\\>\\?\\@\\[\\\\\\]\\^\\_\\`\\{\\|\\}\\~", "<p>!&quot;#$$%&amp;'()*+,-./:;&lt;=&gt;?@[\\]^_`{|}~</p>\n"]
]
isTables() = value.Equal(failing(tables), [])

isRawHtmlIsText() = html("<script>alert(1)</script>") == "<p>&lt;script&gt;alert(1)&lt;/script&gt;</p>\n" and html("<b>a</b>") == "<p>&lt;b&gt;a&lt;/b&gt;</p>\n"
isEntityIsText() = html("&copy; &amp;") == "<p>&amp;copy; &amp;amp;</p>\n"
isScriptLinkIsText() = html("[a](javascript:alert(1))") == "<p>[a](javascript:alert(1))</p>\n" and html("[a](JavaScript:x)") == "<p>[a](JavaScript:x)</p>\n"
isDataLinkIsText() = html("[a](data:text/html,x)") == "<p>[a](data:text/html,x)</p>\n" and html("<vbscript:x>") == "<p>&lt;vbscript:x&gt;</p>\n"
isQuoteInATitleIsEscaped() = html("[a](x \"\\\"onclick=y\")") == "<p><a href=\"x\" title=\"&quot;onclick=y\">a</a></p>\n"
isIndentedLineIsAParagraph() = html("    code") == "<p>code</p>\n"

hooks = {Code: (info, s, line) -> "<pre class=\"$info\">$line</pre>\n", Link: (target, line) -> if target == "Sort" "ref/Sort.html" else missing end, Url: (url, line) -> text.Replace(".md", ".html", url), Anchor: (level, s, line) -> text.Lower(s)}
withHooks(source) = markdown.Html(markdown.Parse(source), hooks)
isLinkHookMakesALink() = withHooks("See [Sort].") == "<p>See <a href=\"ref/Sort.html\">Sort</a>.</p>\n"
isLinkHookLeavesText() = withHooks("[x] and [Nope]") == "<p>[x] and [Nope]</p>\n"
isCodeHookColors() = withHooks("a\n\n```cesia\nx\n```") == "<p>a</p>\n<pre class=\"cesia\">3</pre>\n"
isAnchorHook() = withHooks("## Hello") == "<h2 id=\"hello\">Hello</h2>\n"
isUrlHook() = withHooks("[Values](values.md#texts)") == "<p><a href=\"values.html#texts\">Values</a></p>\n"
isUrlHookStillSafe() = withHooks("[a](javascript:x.md)") == "<p>[a](javascript:x.md)</p>\n"
isLinesOfBlocks() = value.Equal([b.Line for b in markdown.Parse("# a\n\ntext\nmore\n\n- x\n- y\n\n```\nc\n```")], [1, 3, 6, 9])
isListItemsAreBlocks() = markdown.Parse("- a\n- b")[1].Items[2][1].Text == "b"

defn docTexts()
  (** Every text of the documentation of Cesia: the modules, the names and the keywords. *)
  names = list.FlatMap(m -> cesia.DocNames(m), cesia.DocNames())
  list.Concat([cesia.Doc(m) for m in cesia.DocNames()], list.Concat([cesia.Doc(n) for n in names], [cesia.Doc(k) for k in cesia.Keywords()]))
end

isEveryDocTextGoesThrough() = list.All([value.IsText(html(t)) for t in list.Filter(value.IsText, docTexts())])
isEveryLineOfStdGoesThrough() = list.All([value.IsText(html(l.Source)) for l in cesia.Libraries()])
