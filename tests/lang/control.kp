defn m(p)
  match p
    {status: "ok", amount} if amount > 0 -> amount
    [a, b] -> a + b
    0 -> "zero"
    x if is_text(x) -> x
    else -> "other"
  end
end
is_struct_pattern() = m({status: "ok", amount: 5}) == 5
is_guard() = m({status: "ok", amount: -5}) == "other"
is_array_pattern() = m([1, 2]) == 3
is_length() = m([1, 2, 3]) == "other"
is_literal() = m(0) == "zero"
is_name() = m("t") == "t"

defn if_expr(x)
  if x < 0 "neg" else if x == 0 "zero" else "pos" end
end
is_if_chain() = if_expr(-1) == "neg" and if_expr(0) == "zero" and if_expr(1) == "pos"

is_panic_kind() = (wait(spawn(() -> panic("x"))) then map_err(it.kind)) == Err("user")
is_assert() = (wait(spawn(() -> assert(false))) then map_err(it.kind)) == Err("user")

defn deep(n)
  if n == 0
    panic("bottom")
  end
  deep(n - 1) + 1
end
defn repeated_panics()
  for i in 1:20000
    wait(spawn(() -> deep(3)))
  end
  true
end
is_panic_keeps_the_stack() = repeated_panics()
