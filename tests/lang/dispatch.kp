f(x) = x + 1
g(x) = x * 2.0
choose(c) = if c f else g end
apply(h, x) = h(x)
is_called_value() = choose(true)(1) == 2 and choose(false)(1) == 2.0
is_function_parameter() = apply(f, 1) == 2 and apply(g, 1.5) == 3.0
is_dynamic_default() = apply((a, b = 2) -> a + b, 1) == 3

function same_site()
  s = 0
  for x in [1, 2.5, "a"]
    s = s + (if is_text(x) 1 else f(x) end)
  end
  s == 6.5
end
is_two_signatures_same_site() = same_site()

poly(a, b) = 1
function bomb()
  vals = [1, 1.5, "a", zeros(1)]
  n = 0
  for a in vals
    for b in vals
      n += poly(a, b)
    end
  end
  n == 16
end
is_bounded_8() = bomb()

plus_one(x) = x + 1
with_one(h) = h(1)
no_argument(h) = h()
function cache_by_arity()
  with_one(plus_one)
  (wait(spawn(() -> no_argument(plus_one))) then map_err(it.message)) == Err("plus_one needs the argument ""x"".")
end
is_cache_by_arity() = cache_by_arity()

three(a, b = 2, c = 3) = a + b + c
via_names(h) = h(a = 1, c = 5)
is_named_skips_default() = via_names(three) == 8
