(** The small functions of the prelude, in the spirit of clojure.core. *)
use std/dict
use std/fn
use std/list
use std/math
use std/text
use std/value

isIncDec() = math.Inc(1) == 2 and math.Dec(1) == 0 and value.Equal(math.Inc([1, 2]), [2, 3]) and math.Inc(1.5) == 2.5
isAddSubMul() = list.Reduce(math.Add, 0, [1, 2, 3]) == 6 and math.Sub(5, 2) == 3 and list.Reduce(math.Mul, 1, [2, 3]) == 6
isSigns() = math.IsZero(0) and math.IsPos(1) and math.IsNeg(-1) and not math.IsZero(1) and not math.IsPos(0) and not math.IsNeg(0)
isParity() = math.IsEven(2) and math.IsOdd(3) and not math.IsEven(3) and math.IsEven(0) and math.IsOdd(-1)
isSomeValue() = value.IsSome(0) and not value.IsSome(missing)

isIdentity() = fn.Identity(3) == 3
isConstantly() = fn.Constantly(7)(1) == 7
isCompose() = fn.Compose(math.Inc, it * 2)(3) == 7 and fn.Compose(math.Inc, math.Inc, math.Inc)(0) == 3
isComplement() = fn.Complement(math.IsEven)(3) and not fn.Complement(math.IsEven)(2)
isJuxt() = value.Equal(fn.Juxt(math.Inc, math.Dec)(1), [2, 0]) and value.Equal(fn.Juxt(math.Inc, math.Dec, fn.Identity)(1), [2, 0, 1])

isFirstSecondLast() = list.First([1, 2, 3]) == 1 and list.Second([1, 2, 3]) == 2 and list.Last([1, 2, 3]) == 3
isFirstOfNothing() = value.IsMissing(list.First([])) and value.IsMissing(list.Second([1])) and value.IsMissing(list.Last([]))
isNth() = list.Nth(2, [5, 6]) == 6
isIsEmpty() = value.IsEmpty([]) and not value.IsEmpty([1]) and value.IsEmpty("") and value.IsEmpty(dict.Dict())
isPrepend() = value.Equal(list.Prepend(1, [2]), [1, 2]) and value.Equal(list.Prepend(1, []), [1])
isTakeLast() = value.Equal(list.TakeLast(2, [1, 2, 3]), [2, 3]) and value.Equal(list.TakeLast(5, [1]), [1]) and value.Equal(list.TakeLast(0, [1]), [])
isDropLast() = value.Equal(list.DropLast(2, [1, 2, 3]), [1]) and value.Equal(list.DropLast(5, [1]), [])
isTakeWhile() = value.Equal(list.TakeWhile(math.IsOdd, [1, 3, 4, 5]), [1, 3]) and value.Equal(list.TakeWhile(math.IsOdd, []), []) and value.Equal(list.TakeWhile(math.IsOdd, [2]), [])
isDropWhile() = value.Equal(list.DropWhile(math.IsOdd, [1, 3, 4, 5]), [4, 5]) and value.Equal(list.DropWhile(math.IsOdd, [1]), [])
isFindFirst() = list.FindFirst(math.IsEven, [1, 2, 4]) == 2 and value.IsMissing(list.FindFirst(math.IsEven, [1]))
isRemove() = value.Equal(list.Remove(math.IsEven, [1, 2, 3]), [1, 3])
isKeep() = value.Equal(list.Keep(x -> if x > 1 x * 2 else missing end, [1, 2, 3]), [4, 6])
isMapIndexed() = value.Equal(list.MapIndexed((k, x) -> k * x, [5, 6]), [5, 12])
isInterleave() = value.Equal(list.Interleave([1, 2, 3], ["a", "b"]), [1, "a", 2, "b"])
isInterpose() = value.Equal(list.Interpose(0, [1, 2, 3]), [1, 0, 2, 0, 3]) and value.Equal(list.Interpose(0, [1]), [1]) and value.Equal(list.Interpose(0, []), [])
isIterate() = value.Equal(list.Iterate(math.Inc, 1, 3), [1, 2, 3]) and value.Equal(list.Iterate(math.Inc, 1, 0), [])
isRepeatedly() = value.Equal(list.Repeatedly(() -> 5, 2), [5, 5]) and value.Equal(list.Repeatedly(() -> 5, 0), [])
isFrequencies() = value.Equal(list.Frequencies(["a", "b", "a"]), {"a": 2, "b": 1})
isMinByMaxBy() = list.MinBy(math.Abs, [-3, 1, 2]) == 1 and list.MaxBy(math.Abs, [-3, 1, 2]) == -3 and value.IsMissing(list.MinBy(math.Abs, []))

isUpdate() = value.Equal(dict.Update("a", math.Inc, {"a": 1}), {"a": 2}) and value.Equal(dict.Update("b", value.IsMissing, {"a": 1}), {"a": 1, "b": true})
isMerge() = value.Equal(dict.Merge({"a": 1, "b": 2}, {"b": 3}), {"a": 1, "b": 3})
isMergeWith() = value.Equal(dict.MergeWith(math.Add, {"a": 1, "b": 2}, {"b": 3}), {"a": 1, "b": 5})
isSelectKeys() = value.Equal(dict.SelectKeys(["a", "z"], {"a": 1, "b": 2}), {"a": 1})
isZipmap() = value.Equal(dict.Zipmap(["a", "b"], [1, 2]), {"a": 1, "b": 2})
isInvert() = value.Equal(dict.Invert({"a": 1}), {1: "a"})
isGetIn() = dict.GetIn(["a", "b"], {"a": {"b": 2}}) == 2 and value.IsMissing(dict.GetIn(["a", "z"], {"a": {"b": 2}})) and value.IsMissing(dict.GetIn(["a", "b"], {"a": 1}))
isPutIn() = value.Equal(dict.PutIn(["a", "b"], 3, {"a": {"b": 2}}), {"a": {"b": 3}}) and value.Equal(dict.PutIn(["x", "y"], 1, dict.Dict()), {"x": {"y": 1}})
isUpdateIn() = value.Equal(dict.UpdateIn(["a", "b"], math.Inc, {"a": {"b": 2}}), {"a": {"b": 3}})

isStr() = text.Str() == "" and text.Str("a", 1, 2.5, [1]) == "a12.5[1]" and text.Str(missing) == "missing"
