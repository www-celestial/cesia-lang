use frame

sales = frame.table(["city", "item", "amount"], [["Paris", "Lyon", "Paris", "Nice"], ["a", "b", "b", "a"], [10, 20, 30, missing]])
places = frame.table(["city", "country"], [["Paris", "Lyon"], ["FR", "FR"]])

is_shape() = frame.rows(sales) == 4 and equal(frame.columns(sales), ["city", "item", "amount"])
is_of() = equal(frame.columns(frame.of({"b": [1], "a": [2]})), ["a", "b"])
is_column() = equal(frame.column("item", sales), ["a", "b", "b", "a"])
is_row() = frame.row(2, sales)["city"] == "Lyon"
is_records() = length(frame.records(sales)) == 4
is_from_records() = equal(frame.column("x", frame.from_records(["x"], [{"x": 1}, {"x": 2}])), [1, 2])
is_head() = frame.rows(frame.head(2, sales)) == 2 and frame.rows(frame.head(9, sales)) == 4
is_tail() = equal(frame.column("city", frame.tail(1, sales)), ["Nice"])
is_select() = equal(frame.columns(frame.select(["amount"], sales)), ["amount"])
is_drop_column() = equal(frame.columns(frame.drop_column("item", sales)), ["city", "amount"])
is_set_column() = equal(frame.column("n", frame.set_column("n", [1, 2, 3, 4], sales)), [1, 2, 3, 4])
is_with_column() = frame.column("up", frame.with_column("up", r -> upper(r["city"]), sales))[1] == "PARIS"
is_rename() = equal(frame.columns(frame.rename("item", "kind", sales)), ["city", "kind", "amount"])
is_where() = frame.rows(frame.where(r -> r["city"] == "Paris", sales)) == 2
is_where_column() = frame.rows(frame.where_column("item", it == "a", sales)) == 2
is_sort() = equal(frame.column("city", frame.sort_by("city", sales)), ["Lyon", "Nice", "Paris", "Paris"])
is_sort_descending() = frame.column("city", frame.sort_by("city", sales, descending = true))[1] == "Paris"
is_append() = frame.rows(frame.append(sales, sales)) == 8
is_drop_missing() = frame.rows(frame.drop_missing(sales)) == 3
is_fill_missing() = frame.column("amount", frame.fill_missing(0, sales))[4] == 0

defn is_group_by()
  g = frame.group_by(["city"], [frame.agg("total", "amount", sum), frame.agg("n", "amount", length)], sales)
  equal(frame.column("city", g), ["Paris", "Lyon", "Nice"]) and equal(frame.column("total", g), [40, 20, 0]) and equal(frame.column("n", g), [2, 1, 0])
end

defn is_group_two_keys()
  frame.rows(frame.group_by(["city", "item"], [], sales)) == 4
end

defn is_value_counts()
  v = frame.value_counts("item", sales)
  equal(frame.column("count", v), [2, 2])
end

defn is_join()
  j = frame.join_on("city", sales, places)
  frame.rows(j) == 3 and equal(frame.column("country", j), ["FR", "FR", "FR"])
end

defn is_left_join()
  j = frame.join_on("city", sales, places, how = "left")
  frame.rows(j) == 4 and is_missing(frame.column("country", j)[4])
end

defn is_describe()
  d = frame.describe(sales)
  equal(frame.column("column", d), ["amount"]) and frame.column("mean", d)[1] == 20.0 and frame.column("count", d)[1] == 3
end

csv_text = "name,age,score\nann,30,1.5\nbob,,2.5\n"
is_from_csv() = equal(frame.column("age", frame.from_csv(csv_text)), [30, missing]) and frame.column("score", frame.from_csv(csv_text))[2] == 2.5
is_to_csv() = frame.to_csv(frame.table(["a", "b"], [[1], ["x,y"]])) == "a,b\n1,\"x,y\"\n"
is_csv_round_trip() = equal(frame.column("name", frame.from_csv(frame.to_csv(frame.from_csv(csv_text)))), ["ann", "bob"])
is_show() = frame.show(frame.table(["a", "bb"], [[1, 22], ["x", missing]])) == "a   bb\n1   x \n22    "
