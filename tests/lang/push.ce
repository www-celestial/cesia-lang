(** push keeps free cells behind a list, so a loop of pushes stays linear. No list may ever see them, or another list's cells. *)
use std/list
use std/math
use std/matrix
use std/text
use std/value

same(a, b) = "$a" == "$b"   (** Two lists alike, whatever their cells: == works cell by cell. *)

defn pushed(n, first)
  xs = first
  for k in 1..n
    xs = list.Append(k * 2, xs)
  end
  xs
end

isGrows() = same(pushed(3, [0]), [0, 2, 4, 6])
isFromEmpty() = same(pushed(2, []), [2, 4])
isLength() = value.Len(pushed(20, [])) == 20

defn isOlderListUnchanged()
  (** Two lists pushed from one list don't see each other. *)
  xs = pushed(20, [])
  y = list.Append(99, xs)
  z = list.Append(100, xs)
  value.Len(xs) == 20 and value.Len(y) == 21 and y[21] == 99 and z[21] == 100
end

defn isChainFromTheMiddle()
  a = pushed(9, [])
  b = list.Append(1, a)
  c = list.Append(2, b)
  d = list.Append(3, b)
  c[11] == 2 and d[11] == 3 and b[10] == 1 and value.Len(a) == 9
end

defn isWriteAfterPush()
  (** A write copies: neither list sees the write of the other. *)
  xs = pushed(20, [])
  ys = list.Append(1, xs)
  ys[1] = 77
  xs[2] = 88
  xs[1] == 2 and ys[1] == 77 and ys[2] == 4 and xs[2] == 88
end

defn isWriteThenPush()
  xs = pushed(20, [])
  xs[1] = 5
  ys = list.Append(6, xs)
  ys[1] == 5 and ys[21] == 6 and value.Len(ys) == 21
end

defn floats(n)
  xs = [0.5]
  for k in 1..n
    xs = list.Append(k * 1.5, xs)
  end
  xs
end

defn texts(n)
  xs = ["a"]
  for k in 1..n
    xs = list.Append("b", xs)
  end
  xs
end

isFloats() = same(floats(2), [0.5, 1.5, 3.0])
isTexts() = same(texts(2), ["a", "b", "b"])
isAFloatInInts() = same(list.Append(1.5, pushed(2, [])), [2, 4, 1.5])
isATextInFloats() = same(list.Append("x", floats(1)), [0.5, 1.5, "x"])
isAListInAList() = same(list.Append([1], pushed(1, [])), [2, [1]])

defn isInnerListUnchanged()
  inner = [1, 2]
  outer = list.Append(inner, pushed(9, []))
  inner[1] = 5
  same(outer[10], [1, 2])
end

isSumInts() = list.Sum(pushed(9, [])) == 90   (** Everything that reads a whole list must stop at its last cell. *)
isSumFloats() = math.Abs(list.Sum(floats(9)) - 68.0) < 0.001
isAdd() = same(floats(9) + floats(9), floats(9) * 2.0)
isAddLength() = value.Len(floats(9) + 1.0) == 10
(** A list with free cells against one without, either way round. *)
isAddOtherRoom() = same(floats(1) + [1.0, 2.0], [1.5, 3.5])
isAddOtherRoomLeft() = same([1.0, 2.0] + floats(1), [1.5, 3.5])
isTimesOtherRoom() = math.Abs(list.Sum(floats(9) * floats(9)[1..10]) - list.Sum(floats(9)[1..10] * floats(9))) < 0.001
isMatmulList() = math.Abs(list.Sum(matrix.Matmul(floats(2), matrix.Transpose(floats(2))))) > 0.0
isMap() = value.Len(math.Sqrt(floats(9))) == 10
isEqual() = list.All(pushed(9, []) == pushed(9, []))
isPrint() = "$(pushed(2, []))" == "[2, 4]"
isSort() = list.Sort(pushed(9, []))[9] == 18
isReverse() = list.Reverse(pushed(9, []))[1] == 18
isConcat() = value.Len(list.Concat(pushed(9, []), pushed(9, []))) == 18
isMapFunction() = value.Len(list.Map(x -> x, pushed(9, []))) == 9
isFor() = list.Reduce((a, x) -> a + 1, 0, pushed(9, [])) == 9
isTranspose() = value.Len(matrix.Transpose(floats(9))) == 10
isTransposeTexts() = value.Len(matrix.Transpose(texts(9))) == 10
isTransposeInts() = value.Len(matrix.Transpose(pushed(9, []))) == 9
isReshape() = same(value.Size(matrix.Reshape(floats(9), 2, 5)), [2, 5])
isSlice() = same(pushed(9, [])[2..3], [4, 6])
isIn() = not (0 in pushed(9, []))
isTextList() = text.Join(",", texts(1)) == "a,b"
