(* A comment
   on several lines. *)
print(1)
(* on one line *) print(2)
print(3 (* in the middle *) + 4)
(* An outer comment (* with an inner one *)
   is still open here. *)
print(8)
(**)
(***)
(** a documentation comment **)
print(9)
-- (* a line comment opens nothing
print(10)
print("(* a text *)")
(* a quote " in a comment *) print(11)
x = 1 + (* over
two lines *) 2
print(x)
