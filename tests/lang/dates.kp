use date
use csv

is_epoch() = date.format(date.from_unix(0)) == "1970-01-01T00:00:00Z"
is_known() = date.format(date.from_unix(1793534400)) == "2026-11-01T12:00:00Z"
is_before_epoch() = date.format(date.from_unix(-1)) == "1969-12-31T23:59:59Z"
is_leap_day() = date.format_date(date.from_unix(date.to_unix(date.Date(2024, 2, 29)))) == "2024-02-29"
is_round_trip() = date.to_unix(date.from_unix(1234567890)) == 1234567890
is_leap_rules() = date.is_leap(2000) and date.is_leap(2024) and not date.is_leap(1900) and not date.is_leap(2026)
is_days_in_month() = date.days_in_month(2024, 2) == 29 and date.days_in_month(2026, 4) == 30
is_weekday() = date.weekday(date.Date(2026, 11, 1)) == 7 and date.weekday(date.Date(1970, 1, 1)) == 4
is_add_days() = date.format_date(date.add_days(31, date.Date(2026, 12, 15))) == "2027-01-15"
is_between() = date.days_between(date.Date(2026, 1, 1), date.Date(2026, 12, 31)) == 364
is_parse() = date.to_unix(unwrap(date.parse("1970-01-02T00:00:01Z"))) == 86401
is_parse_day() = unwrap(date.parse("2026-11-01")).month == 11
is_parse_bad() = all(map(is_err, map(date.parse, ["", "2026", "2026-13-01", "2026-02-30", "a-b-c", "2026-01-01T25:00:00Z"])))

is_csv_plain() = equal(csv.parse("a,b\n1,2\n"), [["a", "b"], ["1", "2"]])
is_csv_no_last_newline() = equal(csv.parse("a,b"), [["a", "b"]])
is_csv_crlf() = equal(csv.parse("a\r\nb\r\n"), [["a"], ["b"]])
is_csv_quotes() = equal(csv.parse("\"a,b\",\"c\"\"d\"\n"), [["a,b", "c\"d"]])
is_csv_newline_in_quotes() = equal(csv.parse("\"a\nb\",c\n"), [["a\nb", "c"]])
is_csv_empty_fields() = equal(csv.parse(",\n"), [["", ""]])
is_csv_empty() = equal(csv.parse(""), [])
is_csv_separator() = equal(csv.parse("a;b\n", separator = ";"), [["a", "b"]])
is_csv_records() = csv.records("name,age\nann,30\n")[1]["age"] == "30"
is_csv_write() = csv.write([["a", "b,c"], [1, "d\"e"]]) == "a,\"b,c\"\n1,\"d\"\"e\"\n"
is_csv_round_trip() = equal(csv.parse(csv.write([["a,b", "c\nd", "e\"f"]])), [["a,b", "c\nd", "e\"f"]])
