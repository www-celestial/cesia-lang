-- The small functions of the prelude, in the spirit of clojure.core.

is_inc_dec() = inc(1) == 2 and dec(1) == 0 and equal(inc([1, 2]), [2, 3]) and inc(1.5) == 2.5
is_add_sub_mul() = reduce(add, 0, [1, 2, 3]) == 6 and sub(5, 2) == 3 and reduce(mul, 1, [2, 3]) == 6
is_signs() = is_zero(0) and is_pos(1) and is_neg(-1) and not is_zero(1) and not is_pos(0) and not is_neg(0)
is_parity() = is_even(2) and is_odd(3) and not is_even(3) and is_even(0) and is_odd(-1)
is_some_value() = is_some(0) and not is_some(missing)

is_identity() = identity(3) == 3
is_constantly() = constantly(7)(1) == 7
is_comp() = comp(inc, it * 2)(3) == 7 and comp(inc, inc, inc)(0) == 3
is_partial() = partial(add, 2)(3) == 5 and equal(partial(map, inc)([1, 2]), [2, 3])
is_complement() = complement(is_even)(3) and not complement(is_even)(2)
is_juxt() = equal(juxt(inc, dec)(1), [2, 0]) and equal(juxt(inc, dec, identity)(1), [2, 0, 1])
is_pipe() = pipe(1, inc) == 2 and pipe(1, inc, it * 3) == 6 and pipe(1, inc, inc, inc, inc) == 5

is_first_second_last() = first([1, 2, 3]) == 1 and second([1, 2, 3]) == 2 and last([1, 2, 3]) == 3
is_first_of_nothing() = is_missing(first([])) and is_missing(second([1])) and is_missing(last([]))
is_rest() = equal(rest([1, 2, 3]), [2, 3]) and equal(rest([1]), []) and equal(rest([]), [])
is_butlast() = equal(butlast([1, 2, 3]), [1, 2]) and equal(butlast([]), [])
is_nth() = nth(2, [5, 6]) == 6
is_is_empty() = is_empty([]) and not is_empty([1]) and is_empty("") and is_empty(dict())
is_prepend() = equal(prepend(1, [2]), [1, 2]) and equal(prepend(1, []), [1])
is_take_last() = equal(take_last(2, [1, 2, 3]), [2, 3]) and equal(take_last(5, [1]), [1]) and equal(take_last(0, [1]), [])
is_drop_last() = equal(drop_last(2, [1, 2, 3]), [1]) and equal(drop_last(5, [1]), [])
is_take_while() = equal(take_while(is_odd, [1, 3, 4, 5]), [1, 3]) and equal(take_while(is_odd, []), []) and equal(take_while(is_odd, [2]), [])
is_drop_while() = equal(drop_while(is_odd, [1, 3, 4, 5]), [4, 5]) and equal(drop_while(is_odd, [1]), [])
is_find_first() = find_first(is_even, [1, 2, 4]) == 2 and is_missing(find_first(is_even, [1]))
is_remove() = equal(remove(is_even, [1, 2, 3]), [1, 3])
is_keep() = equal(keep(x -> if x > 1 x * 2 else missing end, [1, 2, 3]), [4, 6])
is_map_indexed() = equal(map_indexed((k, x) -> k * x, [5, 6]), [5, 12])
is_interleave() = equal(interleave([1, 2, 3], ["a", "b"]), [1, "a", 2, "b"])
is_interpose() = equal(interpose(0, [1, 2, 3]), [1, 0, 2, 0, 3]) and equal(interpose(0, [1]), [1]) and equal(interpose(0, []), [])
is_every() = every(is_odd, [1, 3]) and not every(is_odd, [1, 2]) and every(is_odd, [])
is_some_of() = some(is_odd, [2, 3]) and not some(is_odd, [2]) and not some(is_odd, [])
is_iterate() = equal(iterate(inc, 1, 3), [1, 2, 3]) and equal(iterate(inc, 1, 0), [])
is_repeatedly() = equal(repeatedly(() -> 5, 2), [5, 5]) and equal(repeatedly(() -> 5, 0), [])
is_frequencies() = equal(frequencies(["a", "b", "a"]), {"a": 2, "b": 1})
is_min_by_max_by() = min_by(abs, [-3, 1, 2]) == 1 and max_by(abs, [-3, 1, 2]) == -3 and is_missing(min_by(abs, []))

is_update() = equal(update("a", inc, {"a": 1}), {"a": 2}) and equal(update("b", is_missing, {"a": 1}), {"a": 1, "b": true})
is_merge() = equal(merge({"a": 1, "b": 2}, {"b": 3}), {"a": 1, "b": 3})
is_merge_with() = equal(merge_with(add, {"a": 1, "b": 2}, {"b": 3}), {"a": 1, "b": 5})
is_select_keys() = equal(select_keys(["a", "z"], {"a": 1, "b": 2}), {"a": 1})
is_zipmap() = equal(zipmap(["a", "b"], [1, 2]), {"a": 1, "b": 2})
is_invert() = equal(invert({"a": 1}), {1: "a"})
is_get_in() = get_in(["a", "b"], {"a": {"b": 2}}) == 2 and is_missing(get_in(["a", "z"], {"a": {"b": 2}})) and is_missing(get_in(["a", "b"], {"a": 1}))
is_put_in() = equal(put_in(["a", "b"], 3, {"a": {"b": 2}}), {"a": {"b": 3}}) and equal(put_in(["x", "y"], 1, dict()), {"x": {"y": 1}})
is_update_in() = equal(update_in(["a", "b"], inc, {"a": {"b": 2}}), {"a": {"b": 3}})

is_str() = str() == "" and str("a", 1, 2.5, [1]) == "a12.5[1]" and str(missing) == "missing"
