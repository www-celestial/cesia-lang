(** The tests of stats.Lm: the datasets of NIST's Statistical Reference Datasets for linear regression, of lower to
    higher difficulty, against their certified values to 15 digits, as the number of digits that agree (the LRE of
    McCullough, 1998); R's summary(lm) table on the cars of mtcars, with a text column; and its errors. *)
use std/fiber
use std/frame
use std/list
use std/math
use std/result
use std/stats
use std/value

message(f) = fiber.Wait(fiber.Spawn(f)) then result.MapErr(it.Message)

defn lre(got, want)
  (** The digits of got that agree with want: -log10 of the relative error, 15 at most. *)
  if got == want
    return 15.0
  end
  e = if want == 0.0 math.Abs(got) else math.Abs(got - want) / math.Abs(want) end
  list.Min(15.0, -math.Log(e) / math.Log(10.0))
end

defn digits(set, tol)
  (** The smallest LRE of the estimates, of their standard errors, of the residual sd and of R-squared. *)
  fit = result.Unwrap(stats.Lm("y", set.Xs, set.Df, intercept = set.Intercept, tol = tol))
  est = frame.Column("estimate", fit.Coefficients)
  se = frame.Column("std error", fit.Coefficients)
  worst = 15.0
  for k in 1..value.Len(set.Estimates)
    worst = list.Min(worst, list.Min(lre(est[k], set.Estimates[k]), lre(se[k], set.Errors[k])))
  end
  list.Min(worst, list.Min(lre(fit.Sigma, set.Sd), lre(fit.RSquared, set.R2)))
end

