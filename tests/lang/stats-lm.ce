(* The targets: 12 digits on the sets of lower and average difficulty, 9 on Longley and Wampler 1 to 3, and on the
   hardest what R reaches: Wampler 4 and 5, and Filip, a polynomial of degree 10, with tol = 1e-10. *)
isNorris() = digits(norris(), 1e-7) >= 12.0
isPontius() = digits(pontius(), 1e-7) >= 12.0
isNoInt1() = digits(noint1(), 1e-7) >= 12.0
isNoInt2() = digits(noint2(), 1e-7) >= 12.0
isLongley() = digits(longley(), 1e-7) >= 12.0
isWampler1() = digits(wampler1(), 1e-7) >= 9.0
isWampler2() = digits(wampler2(), 1e-7) >= 12.0
isWampler3() = digits(wampler3(), 1e-7) >= 9.0
isWampler4() = digits(wampler4(), 1e-7) >= 7.5
isWampler5() = digits(wampler5(), 1e-7) >= 5.5
isFilip() = digits(filip(), 1e-10) >= 7.0
defn isFilipDropsAColumn()
  (** With R's tolerance, Filip's x^10 is a combination of the columns before it, as in R: its estimate is missing. *)
  f = filip()
  fit = result.Unwrap(stats.Lm("y", f.Xs, f.Df))
  fit.Rank == 10 and value.IsMissing(frame.Column("estimate", fit.Coefficients)[11])
end

(* R 4.6.2's summary(lm(mpg ~ wt + hp + cyl, mtcars)), cyl as a text column: the treatment coding of its levels. *)
cars = frame.Of({"mpg": [21.0, 21.0, 22.8, 21.4, 18.7, 18.1, 14.3, 24.4, 22.8, 19.2, 17.8, 16.4, 17.3, 15.2, 10.4, 10.4, 14.7, 32.4, 30.4, 33.9, 21.5, 15.5, 15.2, 13.3, 19.2, 27.3, 26.0, 30.4, 15.8, 19.7, 15.0, 21.4], "wt": [2.62, 2.875, 2.32, 3.215, 3.44, 3.46, 3.57, 3.19, 3.15, 3.44, 3.44, 4.07, 3.73, 3.78, 5.25, 5.424, 5.345, 2.2, 1.615, 1.835, 2.465, 3.52, 3.435, 3.84, 3.845, 1.935, 2.14, 1.513, 3.17, 2.77, 3.57, 2.78], "hp": [110, 110, 93, 110, 175, 105, 245, 62, 95, 123, 123, 180, 180, 180, 205, 215, 230, 66, 52, 65, 97, 150, 150, 245, 175, 66, 91, 113, 264, 175, 335, 109], "cyl": ["6", "6", "4", "6", "8", "6", "8", "4", "4", "6", "6", "8", "8", "8", "8", "8", "8", "4", "4", "4", "4", "8", "8", "8", "8", "4", "4", "4", "8", "6", "8", "4"]})
fit = result.Unwrap(stats.Lm("mpg", ["wt", "hp", "cyl"], cars))
near(xs, want, n) = list.All([math.Abs(xs[k] - want[k]) <= n * 2.220446049250313e-16 * math.Abs(want[k]) for k in 1..value.Len(want)])
isTerms() = value.Equal(frame.Column("term", fit.Coefficients), ["(intercept)", "wt", "hp", "cyl[6]", "cyl[8]"])
isEstimates() = near(frame.Column("estimate", fit.Coefficients), [35.845995315187714, -3.1814040466796158, -0.023119809154454662, -3.3590248959359514, -3.1858844449775261], 64.0)
isErrors() = near(frame.Column("std error", fit.Coefficients), [2.0410190714103309, 0.71960100213438905, 0.011952196008800819, 1.4016697192928618, 2.1704752896998918], 64.0)
isTValues() = near(frame.Column("t value", fit.Coefficients), [17.56279292893543, -4.4210667262042982, -1.9343565933348768, -2.3964453606307266, -1.4678280190962383], 64.0)
isPValues() = near(frame.Column("p value", fit.Coefficients), [2.6703201406812734e-16, 0.00014417557610598369, 0.063612686401873592, 0.023747180276686347, 0.15370474056762357], 1024.0)
isSummary() = near([fit.Sigma, fit.RSquared, fit.AdjustedRSquared], [2.4402309695225082, 0.85721945246219755, 0.83606677875289348], 64.0) and fit.Df == 27 and fit.Rows == 32 and fit.Rank == 5
isFTest() = near([fit.F.Statistic, fit.F.PValue], [40.525347492366741, 4.8691419315967091e-11], 1024.0) and value.Equal(fit.F.Df, [4, 27])
isConfint() = near(frame.Column("low", fit.Confint()), [31.658170099749743, -4.6579033425487504, -0.047643689664266048, -6.2350136000074006, -7.6393318796501521], 256.0) and near(frame.Column("high", fit.Confint()), [40.033820530625682, -1.7049047508104815, 0.0014040713553567265, -0.48303619186450275, 1.2675629896950995], 256.0)
new = frame.Of({"wt": [2.5, 3.5], "hp": [100, 200], "cyl": ["4", "8"]})
isPredict() = near(fit.Predict(new), [25.580504283043208, 16.901234875940602], 64.0)
isConfidence() = near(fit.Band(new).Low, [23.981825752922443, 15.358754756112294], 256.0) and near(fit.Band(new).High, [27.179182813163973, 18.443714995768911], 256.0)
isPrediction() = near(fit.Band(new, kind = "prediction").Low, [20.324533876288839, 11.662084487368602], 256.0) and near(fit.Band(new, kind = "prediction").High, [30.836474689797576, 22.140385264512602], 256.0)
isResiduals() = math.Abs(list.Sum(fit.Residuals)) < 1e-12 and near(fit.Fitted + fit.Residuals, frame.Column("mpg", cars), 4.0)

(* Errors and bugs. *)
isMissingValue() = stats.Lm("y", ["x"], frame.Of({"y": [1.0, 2.0, 3.0], "x": [1.0, missing, 3.0]})).Error.Message == "stats.Lm: column \"x\" is missing at row 2; frame.DropMissing(frame.Select([...], df)) drops such rows."
isNoColumn() = stats.Lm("y", ["z"], frame.Of({"y": [1.0, 2.0], "x": [1.0, 2.0]})).Error.Message == "stats.Lm: the frame has no column \"z\"; its columns are [\"y\", \"x\"]."
isNoInterceptR2() = result.Unwrap(stats.Lm("y", ["x"], frame.Of({"y": [2.0, 4.1, 5.9], "x": [1.0, 2.0, 3.0]}), intercept = false)).Rank == 1
isBadTol() = message(() -> stats.Lm("y", ["x"], frame.Of({"y": [1.0, 2.0], "x": [1.0, 2.0]}), tol = -1)) == result.Err("stats.Lm: tol is -1; give a number from 0 to 1.")
isBadKind() = message(() -> fit.Band(new, kind = "both")) == result.Err("stats.Model.Band: kind is \"both\"; give \"confidence\" or \"prediction\".")
