use std/dict
use std/result
use std/value

isLiteral() = {"a": 1, "b": 2}["b"] == 2
isNumberKeys() = {1: "x", 2: "y"}[2] == "y"
isWholeFloatKey() = {1: "x"}[1.0] == "x"
isFloatKey() = {1.5: "x"}[1.5] == "x"
isComputedKey() = {(1 + 1): "x"}[2] == "x"
isGet() = dict.Get("a", {"a": 1}) == 1
isGetAbsent() = value.IsMissing(dict.Get("z", {"a": 1}))
isGetOr() = dict.GetOr("z", 5, {"a": 1}) == 5 and dict.GetOr("a", 5, {"a": 1}) == 1
isHas() = dict.Has("a", {"a": 1}) and not dict.Has("b", {"a": 1})
isIn() = "a" in {"a": 1} and not ("b" in {"a": 1})
isEmpty() = value.Len(dict.Dict()) == 0
isLength() = value.Len({"a": 1, "b": 2}) == 2
isKeysInOrder() = value.Equal(dict.Keys({"b": 1, "a": 2, 3: 3}), ["b", "a", 3])
isValues() = value.Equal(dict.Values({"b": 1, "a": 2}), [1, 2])
isPairs() = value.Equal(dict.Pairs({"a": 1}), [{Key: "a", Value: 1}])
isFromPairs() = value.Equal(dict.Dict([{Key: "a", Value: 1}]), {"a": 1})
isRoundTrip() = value.Equal(dict.Dict(dict.Pairs({"a": 1, "b": 2})), {"a": 1, "b": 2})
isEqualAnyOrder() = {"a": 1, "b": 2} == {"b": 2, "a": 1}
isNotEqual() = {"a": 1} != {"a": 2} and {"a": 1} != {"b": 1}
isTextForm() = value.Text({"b": 1, 2: "x"}) == "{b: 1, 2: \"x\"}" and value.Text({"a-b": 1, "if": 2}) == "{\"a-b\": 1, \"if\": 2}"
isKind() = value.IsDict({"a": 1}) and value.IsDict({A: 1}) and not value.IsDict(result.Ok(1))
isLaterWins() = {"a": 1, "a": 2}["a"] == 2

defn isPutKeepsTheOriginal()
  a = {"x": 1}
  b = dict.Put("x", 2, a)
  a["x"] == 1 and b["x"] == 2
end

defn isDrop()
  a = {"x": 1, "y": 2}
  b = dict.Drop("x", a)
  value.Len(a) == 2 and value.Len(b) == 1 and not dict.Has("x", b) and value.Equal(dict.Drop("z", b), b)
end

defn isAssign()
  d = dict.Dict()
  d["a"] = 1
  d[2] = "two"
  d["a"] = 3
  value.Len(d) == 2 and d["a"] == 3 and d[2] == "two"
end

defn isAssignKeepsACopy()
  a = {"x": 1}
  b = a
  b["x"] = 2
  a["x"] == 1 and b["x"] == 2
end

defn isArrayInside()
  a = {"x": [1, 2]}
  b = a
  b["x"][1] = 9
  a["x"][1] == 1 and b["x"][1] == 9
end

defn isDictInside()
  a = {"x": {"y": {"z": 1}}}
  b = a
  b["x"]["y"]["z"] = 2
  b["x"]["y"]["w"] = 3
  a["x"]["y"]["z"] == 1 and b["x"]["y"]["z"] == 2 and b["x"]["y"]["w"] == 3
end

defn isInAStruct()
  s = {D: {"a": 1}}
  s.D["a"] = 2
  s.D["b"] = 3
  s.D["a"] == 2 and s.D["b"] == 3
end

defn isInAnArray()
  xs = [{"a": 1}, {"a": 2}]
  xs[2]["a"] = 5
  xs[1]["a"] == 1 and xs[2]["a"] == 5
end

defn isCompoundAssign()
  d = {"n": 1}
  d["n"] += 2
  d["n"] == 3
end

defn isMany()
  d = dict.Dict()
  for i in 1..5000
    d[i * 7 - 3] = i
  end
  total = 0
  for i in 1..5000
    total += d[i * 7 - 3]
  end
  for i in 1..2500
    d = dict.Drop(i * 7 - 3, d)
  end
  value.Len(d) == 2500 and total == 12502500 and value.Equal(dict.Keys(d)[1], 2501 * 7 - 3)
end

defn isStructKeepsLiteral()
  x = {A: 1}
  x.A == 1
end

