(** The tests of quad.Integral: its rules against Laurie's algorithm and their degrees, the test families of QUADPACK's
    kind against their closed forms and against the work of QUADPACK's own code, infinite bounds, points, every Err and
    every bad argument. *)
use std/bug
use std/fiber
use std/list
use std/math
use std/matrix
use std/num
use std/quad
use std/result
use std/special
use std/text
use std/value

eps = 2.220446049250313e-16
pi = math.Pi
message(f) = fiber.Wait(fiber.Spawn(f)) then result.MapErr(it.Message)

defn first(f, a, b)
  (** The integral of f by the first rule alone, on the whole interval: limit = 1. *)
  match quad.Integral(f, a, b, limit = 1)
    result.Ok(q) -> q
    result.Err(e) -> {Value: e.Value, Error: e.Error}
  end
end

defn calls(f, a, b, limit)
  (** The places where Integral calls f, in the order of the calls. *)
  ch = fiber.Channel()
  quad.Integral(defn (x)
    fiber.Send(x, ch)
    f(x)
  end, a, b, limit = limit)
  xs = []
  while true
    got = fiber.Receive(ch, timeout = 0.0)
    if result.IsErr(got)
      break
    end
    xs = list.Append(result.Unwrap(got), xs)
  end
  xs
end

(* Laurie (1997): the Jacobi–Kronrod matrix of order 2n + 1 from the Jacobi matrix of Legendre's weight, in the form of
   Gautschi's r_kronrod: its eigenvalues are the 2n + 1 points of Kronrod's rule, as the rule is the Gauss rule of that
   matrix. Written here from the paper, independently of the rule's values in std/quad. num.Eigen gives the points to
   a few 1e-15; two steps of Newton's method on the matrix's characteristic polynomial, by its three-term recurrence,
   bring them to the last bits. The weights are Christoffel's numbers of the same recurrence, 1 / Σ q_k(x)², q_k the
   orthonormal polynomials of the matrix. *)
defn kronrod(n)
  size = 2 * n + 2
  a = matrix.Zeros(1, size)
  b = matrix.Zeros(1, size)
  b[1] = 2.0
  for k in 1..math.Div(3 * n + 1, 2)
    b[k + 1] = 1.0 * k * k / (4.0 * k * k - 1.0)
  end
  s = matrix.Zeros(1, math.Div(n, 2) + 3)
  t = matrix.Zeros(1, math.Div(n, 2) + 3)
  t[2] = b[n + 2]
  for m in 0..n - 2
    acc = 0.0
    k = math.Div(m + 1, 2)
    while k >= 0   (* k from (m + 1) / 2 down to 0 *)
      l = m - k
      acc = acc + (a[k + n + 2] - a[l + 1]) * t[k + 2] + b[k + n + 2] * s[k + 1] - b[l + 1] * s[k + 2]
      s[k + 2] = acc
      k = k - 1
    end
    swap = s
    s = t
    t = swap
  end
  j = math.Div(n, 2)
  while j >= 0
    s[j + 2] = s[j + 1]
    j = j - 1
  end
  for m in n - 1..2 * n - 3
    acc = 0.0
    j = 0
    for k in m + 1 - n..math.Div(m - 1, 2)
      j = n - 1 - (m - k)
      acc = acc - (a[k + n + 2] - a[m - k + 1]) * t[j + 2] - b[k + n + 2] * s[j + 2] + b[m - k + 1] * s[j + 3]
      s[j + 2] = acc
    end
    k = math.Div(m + 1, 2)
    if math.Mod(m, 2) == 0
      a[k + n + 2] = a[k + 1] + (s[j + 2] - b[k + n + 2] * s[j + 3]) / t[j + 3]
    else
      b[k + n + 2] = s[j + 2] / s[j + 3]
    end
    swap = s
    s = t
    t = swap
  end
  a[2 * n + 1] = a[n] - b[2 * n + 1] * s[2] / t[2]
  order = 2 * n + 1
  jm = matrix.Zeros(order, order)
  for i in 1..order
    jm[i, i] = a[i]
    if i < order
      jm[i, i + 1] = math.Sqrt(b[i + 1])
      jm[i + 1, i] = jm[i, i + 1]
    end
  end
  xs = list.Sort(num.Eigen(jm).Values)
  for i in 1..order
    for step in 1..2
      p0 = 1.0
      d0 = 0.0
      p1 = xs[i] - a[1]
      d1 = 1.0
      for k in 2..order
        p2 = (xs[i] - a[k]) * p1 - b[k] * p0
        d2 = p1 + (xs[i] - a[k]) * d1 - b[k] * d0
        p0 = p1
        d0 = d1
        p1 = p2
        d1 = d2
      end
      xs[i] = xs[i] - p1 / d1
    end
  end
  ws = matrix.Zeros(1, order)
  for i in 1..order
    q0 = 0.0
    q1 = 1.0 / math.Sqrt(b[1])
    sum = q1 * q1
    for k in 1..order - 1
      q2 = ((xs[i] - a[k]) * q1 - (if k > 1 math.Sqrt(b[k]) else 0.0 end) * q0) / math.Sqrt(b[k + 1])
      q0 = q1
      q1 = q2
      sum = sum + q1 * q1
    end
    ws[i] = 1.0 / sum
  end
  {X: xs, W: ws}
end

k21 = kronrod(10)
k15 = kronrod(7)

(* The points of the rule of 21 on [-1, 1] are Laurie's, and so are its weights: f is 1 at one point, 0 elsewhere. *)
defn isLauriePoints21()
  xs = list.Sort(calls(x -> 1.0, -1.0, 1.0, 1))
  value.Len(xs) == 21 and list.Max(math.Abs(xs - k21.X)) <= 2.0 * eps
end
defn isLaurieWeights21()
  ws = [first(x -> if x == p 1.0 else 0.0 end, -1.0, 1.0).Value for p in list.Sort(calls(x -> 1.0, -1.0, 1.0, 1))]
  list.Max(math.Abs(ws - k21.W)) <= 2.0 * eps
end
(* The rule of 15 for an infinite bound, at t = 1 / (1 + x) in (0, 1]: Laurie's points mapped there. *)
defn isLauriePoints15()
  ts = list.Sort(1.0 / (1.0 + calls(x -> 1.0 / (1.0 + x) ^ 2, 0.0, math.Inf, 1)))
  value.Len(ts) == 15 and list.Max(math.Abs(ts - (0.5 + 0.5 * k15.X))) <= 4.0 * eps
end

(* Degrees: Kronrod's 21 points integrate x^k exactly up to k = 31, not 32; Gauss's 10 among them up to 19, not 20, which
   shows in the error estimate, |K - G| scaled: at the floor of 50 eps times the integral of |f| while G is exact. *)
defn isKronrodDegree31()
  exact = [if math.Mod(k, 2) == 1 0.0 else 2.0 / (k + 1) end for k in 0..31]
  got = [first(x -> x ^ k, -1.0, 1.0).Value for k in 0..31]
  list.Max(math.Abs(got - exact)) <= 4.0 * eps and math.Abs(first(x -> x ^ 32, -1.0, 1.0).Value - 2.0 / 33.0) > 1.0e-13
end
defn isGaussDegree19()
  floor = [first(x -> x ^ k, -1.0, 1.0).Error <= 51.0 * eps * 2.0 / (k + 1) for k in 0..19]
  list.All(floor) and first(x -> x ^ 20, -1.0, 1.0).Error > 1.0e-8
end
(* Kronrod's 15 points on (0, 1] through x = (1 - t) / t: ∫ (1 + x)^-(k+2) from 0 to ∞ is ∫ t^k from 0 to 1. *)
isKronrod15Degree23() = list.Max([math.Abs(first(x -> (1.0 + x) ^ (-k - 2), 0.0, math.Inf).Value * (k + 1) - 1.0) for k in 0..23]) <= 1.0e-14

(* The test families, of the kinds the QUADPACK book uses: end and inner singularities, a peak, a pole near an end,
   oscillation, infinite bounds, jumps. Each: f, a, b, points, the closed form, and the evaluations and pieces of scipy
   1.18.1's quad, QUADPACK's own code, at the same tolerances and limit. *)
defn families()
  cs = []
  for c in [[-0.9, 399, 10], [-0.5, 315, 8], [0.0, 231, 6], [2.0, 231, 6]]
    al = c[1]
    cs = list.Append({F: x -> x ^ al * math.Log(1.0 / x), A: 0.0, B: 1.0, P: [], Exact: 1.0 / (al + 1.0) ^ 2, Calls: c[2], Pieces: c[3]}, cs)
  end
  for c in [[0.0, 21, 1], [2.0, 231, 6], [4.0, 483, 12], [6.0, 777, 19], [8.0, 1071, 26]]
    al = c[1]
    cs = list.Append({F: x -> 4.0 ^ (-al) / ((x - pi / 4.0) ^ 2 + 16.0 ^ (-al)), A: 0.0, B: 1.0, P: [], Exact: math.Atan((4.0 - pi) * 4.0 ^ (al - 1.0)) + math.Atan(pi * 4.0 ^ (al - 1.0)), Calls: c[2], Pieces: c[3]}, cs)
  end
  for c in [[-0.8, 231, 6, 462, 12], [-0.5, 231, 6, 462, 12], [0.5, 231, 6, 378, 10]]
    al = c[1]
    exact = ((2.0 / 3.0) ^ (al + 1.0) + (1.0 / 3.0) ^ (al + 1.0)) / (al + 1.0)
    cs = list.Append({F: x -> math.Abs(x - 1.0 / 3.0) ^ al, A: 0.0, B: 1.0, P: [], Exact: exact, Calls: c[2], Pieces: c[3]}, cs)
    cs = list.Append({F: x -> math.Abs(x - 1.0 / 3.0) ^ al, A: 0.0, B: 1.0, P: [1.0 / 3.0], Exact: exact, Calls: c[4], Pieces: c[5]}, cs)
  end
  for c in [[1.0, 735, 18], [3.0, 903, 22], [5.0, 1071, 26]]
    al = c[1]
    cs = list.Append({F: x -> (1.0 - x * x) ^ (-0.5) / (x + 1.0 + 2.0 ^ (-al)), A: -1.0, B: 1.0, P: [], Exact: pi / math.Sqrt((1.0 + 2.0 ^ (-al)) ^ 2 - 1.0), Calls: c[2], Pieces: c[3]}, cs)
  end
  for c in [[0.2, 315, 8], [0.5, 315, 8], [2.0, 21, 1]]
    al = c[1]
    cs = list.Append({F: x -> math.Sin(x) ^ (al - 1.0), A: 0.0, B: pi / 2.0, P: [], Exact: special.Beta(al / 2.0, 0.5) / 2.0, Calls: c[2], Pieces: c[3]}, cs)
  end
  for c in [[0.5, 819, 20], [1.5, 903, 22], [3.0, 315, 8]]
    al = c[1]
    cs = list.Append({F: x -> math.Log(1.0 / x) ^ (al - 1.0), A: 0.0, B: 1.0, P: [], Exact: special.Gamma(al), Calls: c[2], Pieces: c[3]}, cs)
  end
  for c in [[-0.5, 375, 13], [0.0, 135, 5], [1.5, 345, 12], [4.0, 225, 8]]
    al = c[1]
    cs = list.Append({F: x -> x ^ al * math.Exp(-x), A: 0.0, B: math.Inf, P: [], Exact: special.Gamma(al + 1.0), Calls: c[2], Pieces: c[3]}, cs)
  end
  list.Concat(cs, [
    {F: x -> 1.0 / math.Sqrt(x), A: 0.0, B: 1.0, P: [], Exact: 2.0, Calls: 231, Pieces: 6},
    {F: x -> math.Exp(-x * x), A: 0.0, B: math.Inf, P: [], Exact: math.Sqrt(pi) / 2.0, Calls: 195, Pieces: 7},
    {F: x -> math.Exp(-x * x), A: -math.Inf, B: math.Inf, P: [], Exact: math.Sqrt(pi), Calls: 390, Pieces: 7},
    {F: x -> math.Exp(-math.Abs(x)), A: -math.Inf, B: math.Inf, P: [], Exact: 2.0, Calls: 270, Pieces: 5},
    {F: x -> math.Exp(x), A: -math.Inf, B: 0.0, P: [], Exact: 1.0, Calls: 135, Pieces: 5},
    {F: x -> 1.0 / (1.0 + x * x), A: 0.0, B: math.Inf, P: [], Exact: pi / 2.0, Calls: 75, Pieces: 3},
    {F: x -> 1.0 / ((1.0 + x) * math.Sqrt(x)), A: 0.0, B: math.Inf, P: [], Exact: pi, Calls: 525, Pieces: 18},
    {F: x -> x * math.Sin(30.0 * x) * math.Cos(x), A: 0.0, B: 2.0 * pi, P: [], Exact: -60.0 * pi / 899.0, Calls: 1281, Pieces: 31},
    {F: x -> 4.0 / (1.0 + x * x), A: 0.0, B: 1.0, P: [], Exact: pi, Calls: 21, Pieces: 1},
    {F: x -> math.Cos(100.0 * x), A: 0.0, B: 1.0, P: [], Exact: math.Sin(100.0) / 100.0, Calls: 651, Pieces: 16},
    {F: x -> if x < 0.3 1.0 else 2.0 end, A: 0.0, B: 1.0, P: [0.3], Exact: 1.7, Calls: 42, Pieces: 2},
    {F: x -> if x < 0.3 1.0 else 2.0 end, A: 0.0, B: 1.0, P: [], Exact: 1.7, Calls: 357, Pieces: 9},
    {F: x -> x * x, A: 1.0, B: 0.0, P: [], Exact: -1.0 / 3.0, Calls: 21, Pieces: 1},
    {F: x -> math.Exp(-x), A: math.Inf, B: 0.0, P: [], Exact: -1.0, Calls: 135, Pieces: 5}])
end

cases = families()
solved = [quad.Integral(c.F, c.A, c.B, points = c.P) for c in cases]

(* Each is an Ok whose true error is within the tolerance asked, max(1e-12, 1e-10 |I|), and within its own Error. *)
defn isFamiliesWithinTolerance()
  for i in 1..value.Len(cases)
    q = result.Unwrap(solved[i])
    wrong = math.Abs(q.Value - cases[i].Exact)
    if wrong > list.Max([1.0e-12, 1.0e-10 * math.Abs(cases[i].Exact)]) or wrong > q.Error
      return false
    end
  end
  value.Len(cases) == 42
end
(* The same work as QUADPACK's own code: the same pieces cut in the same order. *)
isFamiliesSameWorkAsQuadpack() = list.All([result.Unwrap(solved[i]).Evaluations == cases[i].Calls and result.Unwrap(solved[i]).Intervals == cases[i].Pieces for i in 1..value.Len(cases)])
(* And the same numbers: scipy's value and error estimate, to the last bit, as on all 42 when this was written; here
   three of them. *)
isSameBitsAsQuadpack() = result.Unwrap(quad.Integral(x -> x ^ (-0.5) * math.Log(1.0 / x), 0.0, 1.0)) == {Value: 4.000000000000071, Error: 2.1582735598713043e-13, Evaluations: 315, Intervals: 8}
isSameBitsInfinite() = result.Unwrap(quad.Integral(x -> math.Exp(-x * x), -math.Inf, math.Inf)) == {Value: 1.772453850905516, Error: 1.0306805682733654e-12, Evaluations: 390, Intervals: 7}

(* An odd f on an interval centred on 0: the pairs f(-x) + f(x) cancel exactly. *)
isOddIsZero() = quad.Integral(x -> x ^ 3 * math.Exp(-x * x), -1.0, 1.0).Value.Value == 0.0
isReversed() = quad.Integral(x -> math.Exp(x), 1.0, 0.0).Value.Value == -quad.Integral(x -> math.Exp(x), 0.0, 1.0).Value.Value
isReversedInfinite() = quad.Integral(x -> math.Exp(x), 0.0, -math.Inf).Value.Value == -quad.Integral(x -> math.Exp(x), -math.Inf, 0.0).Value.Value
isEmpty() = quad.Integral(x -> never(), 2.0, 2.0) == result.Ok({Value: 0.0, Error: 0.0, Evaluations: 0, Intervals: 0})
isIntegers() = quad.Integral(x -> 1, 0, 2).Value.Value == 2.0
isPointsKept() = quad.Integral(x -> math.Abs(x - 0.3), 0.0, 1.0, points = [1.0, 0.3, 0.0, 0.3]) == quad.Integral(x -> math.Abs(x - 0.3), 0.0, 1.0, points = [0.3])
isPointsReversed() = quad.Integral(x -> math.Abs(x - 0.3), 1.0, 0.0, points = [0.3]).Value.Value == -0.29
(* A looser tolerance stops sooner, by either test: 315 calls instead of 651, as QUADPACK's code. The value is checked to
   4 ulps, not to the bit: math.Cos is the system's, and macOS's differs from glibc's in the last bit. *)
isRelativeTolerance() = loose(quad.Integral(x -> math.Cos(100.0 * x), 0.0, 1.0, rtol = 1.0e-3, atol = 0.0), -0.005063656411098236)
loose(r, v) = r.Value.Evaluations == 315 and r.Value.Intervals == 8 and math.Abs(r.Value.Value - v) <= 4.0 * 2.220446049250313e-16 * math.Abs(v)
isAbsoluteTolerance() = quad.Integral(x -> math.Cos(100.0 * x), 0.0, 1.0, rtol = 0.0, atol = 1.0e-6).Value.Evaluations == 315
never() = 1 / 0

(* The Errs, with the best estimate. Each of QUADPACK's flags, on integrands that raise it in its own code too. *)
isLimit() = quad.Integral(x -> 1.0 / x, 0.0, 1.0, limit = 20) == result.Err({Kind: "quad", Message: "quad.Integral: the error estimate 9.350560373140297 is above the tolerance 2.0882425258589698e-9 after 20 pieces, the limit; raise limit, or give in points the places where f jumps or is singular.", Value: 20.882425258589677, Error: 9.350560373140297})
isDivergent() = quad.Integral(x -> x ^ (-1.1), 0.0, 1.0).Error == {Kind: "quad", Message: "quad.Integral: the integral looks divergent, or converges too slowly to be computed.", Value: -9.999999999996493, Error: 1.1652900866465643e-11}
isDivergentInfinite() = text.Contains("divergent", quad.Integral(x -> x, 0.0, math.Inf).Error.Message)
isRoundoff() = text.Contains("roundoff stops the error estimate", quad.Integral(x -> math.Cos(100.0 * x), 0.0, 1.0, rtol = 1.2e-14, atol = 0.0).Error.Message)
isExtrapolationFails() = text.Contains("the extrapolation does not converge", quad.Integral(x -> math.Sin(x), 0.0, math.Inf).Error.Message)
isBadPlace() = quad.Integral(x -> 1.0 / math.Abs(x - (1.0e10 + 1.0 / 3.0)), 1.0e10, 1.0e10 + 1.0).Error.Message == "quad.Integral: f behaves too badly near 10000000000.333374 for the piece around it to be cut again: a singularity that may not be integrable, or a jump; give it in points."
(* A narrow peak that no point of the rule sees: Integral can't know, as any method that only samples f. *)
(* A double integral as two nested calls: the area of the unit disk. *)
isNested() = math.Near(quad.Integral(x -> quad.Integral(y -> 1.0, -math.Sqrt(1.0 - x * x), math.Sqrt(1.0 - x * x)).Value.Value, -1.0, 1.0).Value.Value, pi, rel = 1.0e-10)
isPeakMissed() = quad.Integral(x -> math.Exp(-x * x), -1.0e300, 1.0e300) == result.Ok({Value: 0.0, Error: 0.0, Evaluations: 63, Intervals: 2})

(* What f gives is checked: a NaN, an infinity, a text, a bool, an Err are Errs that name the place; a panic stays one. *)
defn isNan()
  e = quad.Integral(x -> if x > 0.5 math.Nan else 1.0 end, 0.0, 1.0).Error
  e.Message == "quad.Integral: f(0.9869532642585859) is nan, not a finite number." and e.Value != e.Value and e.Error == math.Inf
end
isInfinity() = quad.Integral(x -> 1.0 / (x - 0.5), 0.0, 1.0).Error.Message == "quad.Integral: f(0.5) is inf, not a finite number."
isText() = quad.Integral(x -> "a", 0.0, 1.0).Error.Message == "quad.Integral: f(0.5) is \"a\", not a finite number."
isBool() = quad.Integral(x -> x > 0.5, 0.0, 1.0).Error.Message == "quad.Integral: f(0.5) is false, not a finite number."
isErrFromF() = text.Contains("not a finite number", quad.Integral(x -> result.Err("no"), 0.0, 1.0).Error.Message)
isMissingFromF() = text.Contains("is missing, not a finite number", quad.Integral(x -> missing, 0.0, 1.0).Error.Message)
isOverflow() = quad.Integral(x -> 1.0e308, 0.0, 1.0).Error.Message == "quad.Integral: the values of f near 0.5 are too large: their sum overflows."
isInfinityFarOut() = quad.Integral(x -> math.Exp(x), 0.0, math.Inf).Error.Message == "quad.Integral: f(935.2606747597932) is inf, not a finite number."
isPanicInF() = message(() -> quad.Integral(x -> bug.Panic("f broke"), 0.0, 1.0)) == result.Err("f broke")
(* limit bounds the calls of f: 21 for the first rule, 42 for each piece cut. *)
isCallsBounded() = value.Len(calls(x -> math.Sin(1.0 / x), 0.0, 1.0, 10)) == 21 * (2 * 10 - 1)

(* A bad argument is a panic that names it. *)
isBadF() = message(() -> quad.Integral(1.0, 0.0, 1.0)) == result.Err("quad.Integral: f is 1.0; give a function of one number.")
isBadA() = message(() -> quad.Integral(x -> x, math.Nan, 1.0)) == result.Err("quad.Integral: a is nan; give a number, or math.Inf or -math.Inf.")
isBadB() = message(() -> quad.Integral(x -> x, 0.0, "1")) == result.Err("quad.Integral: b is \"1\"; give a number, or math.Inf or -math.Inf.")
isBadRtol() = message(() -> quad.Integral(x -> x, 0.0, 1.0, rtol = -1.0)) == result.Err("quad.Integral: rtol is -1.0; give a number of 0.0 or more.")
isBadAtol() = message(() -> quad.Integral(x -> x, 0.0, 1.0, atol = math.Inf)) == result.Err("quad.Integral: atol is inf; give a number of 0.0 or more.")
isNoTolerance() = message(() -> quad.Integral(x -> x, 0.0, 1.0, rtol = 1.0e-15, atol = 0.0)) == result.Err("quad.Integral: rtol is 1e-15 and atol is 0.0; give rtol of at least 50 eps, 1.1102230246251565e-14, or atol above 0.0.")
isBadLimit() = message(() -> quad.Integral(x -> x, 0.0, 1.0, limit = 0)) == result.Err("quad.Integral: limit is 0; give a whole number of 1 or more.")
isFloatLimit() = result.IsErr(message(() -> quad.Integral(x -> x, 0.0, 1.0, limit = 10.0)))
isPointOutside() = message(() -> quad.Integral(x -> x, 0.0, 1.0, points = [0.5, 2.0])) == result.Err("quad.Integral: points[2] is 2.0, outside the interval from 0.0 to 1.0.")
isPointNan() = message(() -> quad.Integral(x -> x, 0.0, 1.0, points = [math.Nan])) == result.Err("quad.Integral: points[1] is nan; give finite numbers.")
isPointsInfinite() = message(() -> quad.Integral(x -> x, 0.0, math.Inf, points = [1.0])) == result.Err("quad.Integral: points needs a finite interval; integrate from a to a point and from there to the infinite bound, in two calls.")
isLimitUnderPieces() = message(() -> quad.Integral(x -> x, 0.0, 1.0, points = [0.25, 0.5], limit = 2)) == result.Err("quad.Integral: limit is 2, and points makes 3 pieces; give limit of at least that.")
isTooWide() = message(() -> quad.Integral(x -> x, -1.0e308, 1.0e308)) == result.Err("quad.Integral: b - a is inf, too large for a float; give math.Inf for an infinite bound.")
