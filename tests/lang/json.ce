use std/json
use std/dict
use std/fiber
use std/io
use std/list
use std/result
use std/text
use std/value

defn fails(f, kind)
  (fiber.Wait(fiber.Spawn(f)) then result.MapErr(it.Kind)) == result.Err(kind)
end
ok(s) = result.Unwrap(json.Parse(s))
isNull() = value.IsMissing(ok("null"))
isBools() = ok("true") == true and ok("false") == false
isWhole() = ok("42") == 42 and value.IsInt(ok("-7"))
isDecimal() = ok("1.5") == 1.5 and ok("1e3") == 1000.0 and value.IsFloat(ok("2.0"))
isBigInt() = value.IsFloat(ok("123456789012345678901234567890"))
isText() = ok("\"a\"") == "a"
isEscapes() = ok("\"\\n\\t\\\"\\\\\\/\"") == "\n\t\"\\/"
isUnicode() = ok("\"\u00e9\"") == "é" and ok("\"\ud83d\ude00\"") == "😀"
isArray() = value.Equal(ok("[1, \"a\", null, [2]]"), [1, "a", missing, [2]])
isEmptyArray() = value.Equal(ok("[]"), [])
isObject() = value.Equal(ok("{\"a\": 1, \"b\": [true]}"), {"a": 1, "b": [true]})
isEmptyObject() = value.Equal(ok("{}"), dict.Dict())
isSpaces() = value.Equal(ok(" \n { \"a\" : 1 } \t"), {"a": 1})
isLaterKey() = ok("{\"a\": 1, \"a\": 2}")["a"] == 2
isNested() = ok("{\"a\": {\"b\": [{\"c\": 1}]}}")["a"]["b"][1]["c"] == 1
bad(s) = result.IsErr(json.Parse(s))
isBadInputs() = list.All([bad(s) for s in ["", "{", "[1,", "tru", "01", "1.", "[1 2]", "{1: 2}", "\"a", "\"\x\"", "nul", "[1]]", "-", "\"\ud83d\""]])
isErrorShape() = (json.Parse("{") then result.MapErr(it.Kind)) == result.Err("json")
isTooDeep() = bad(text.Repeat(5000, "["))
isDeepEnough() = result.IsOk(json.Parse("$(text.Repeat(200, "["))$(text.Repeat(200, "]"))"))
isWriteScalars() = json.Text(1) == "1" and json.Text(1.5) == "1.5" and json.Text(true) == "true" and json.Text(missing) == "null"
isWriteControl() = json.Text(text.Char(1)) == "\"\\u0001\""
isWriteArray() = json.Text([1, "a", [true]]) == "[1,\"a\",[true]]"
isWriteStruct() = json.Text({A: 1, B: "x"}) == "{\"A\":1,\"B\":\"x\"}"
isWriteDict() = json.Text({"z": 1, 2: 3}) == "{\"z\":1,\"2\":3}"
isWriteWholeFloat() = json.Text(2.0) == "2.0"
isWriteNan() = fails(() -> json.Text(0.0 / 0.0), "type")
isWriteFunction() = fails(() -> json.Text(io.Print), "type")
isRoundTrip() = value.Equal(ok(json.Text({"a": [1, 2.5, "x", missing, {"b": true}]})), {"a": [1, 2.5, "x", missing, {"b": true}]})
isPretty() = json.Pretty({"a": [1]}) == "{\n  \"a\": [\n    1\n  ]\n}"
isPrettyEmpty() = json.Pretty([]) == "[]"
isWriteText() = json.Text("a\"\n\\é") == "\"a\\\"\\n\\\\é\""
isNestingStaysInItsFiber() = result.IsErr(fiber.Wait(fiber.Spawn(() -> value.Text(deep(700))))) and value.Text(1) == "1"
isHugeExponent() = bad("1e999")

defn deep(n)
  x = 1
  for k in 1..n
    x = {A: x}
  end
  x
end
