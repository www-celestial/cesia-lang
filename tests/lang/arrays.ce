use std/list
use std/math
use std/matrix
use std/value

isRow() = value.Equal(value.Size([1, 2, 3]), [1, 3])
isColumn() = value.Equal(value.Size([1; 2; 3]), [3, 1])
isMatrix() = [1 2; 3 4][2, 1] == 3
isEmpty() = value.Len([]) == 0
isSpaceMinus() = value.Len([1 -2]) == 2 and value.Len([1 - 2]) == 1 and value.Len([1-2]) == 1
isCallInRow() = value.Len([math.Abs(1) math.Abs(2)]) == 2 and value.Len([math.Abs (1)]) == 2
isMultipleRows() = value.Equal(
  [1 2
   3 4], [1 2; 3 4])
isCommaNewline() = value.Equal([1,
  2], [1, 2])
isByColumns() = [1 2; 3 4][2] == 3
isWholeRow() = value.Equal([1 2; 3 4][2, :], [3, 4])
isWholeColumn() = value.Equal([1 2; 3 4][:, 2], [2; 4])
isSlice() = value.Equal([1, 2, 3, 4, 5][2..4], [2, 3, 4])
isEnd() = [1, 2, 3][end] == 3 and value.Equal([1, 2, 3][2..end], [2, 3])
isMaskAsIndex() = value.Equal([1, 2, 3][[true, false, true]], [1, 3])
isWholeFloatIndex() = [1, 2, 3][2.0] == 2
isZeros() = value.Equal(matrix.Zeros(2), [0.0, 0.0]) and value.Equal(value.Size(matrix.Zeros(2, 3)), [2, 3])
isFill() = value.Equal(list.Fill("a", 2), ["a", "a"])
isIntInF() = intInF()
isComp() = value.Equal([v * 2 for v in [1, -2, 3] if v > 0], [2, 6])
isCompLocal() = compLocal()
isForArray() = sumFor([1, 2, 3]) == 6
isForEmpty() = sumFor([]) == 0
isRangeArray() = value.Equal(1..3, [1, 2, 3])
isRangeEmpty() = value.Len(3..1) == 0
isIn() = 2 in [1, 2] and not (3 in 1..2)
isArrayInArray() = value.Len([[1, 2], 3]) == 2

defn intInF()
  x = matrix.Zeros(2)
  x[1] = 5
  value.IsFloat(x[1])
end
defn compLocal()
  v = 9
  r = [v for v in [1]]
  v == 9
end
defn sumFor(xs)
  s = 0
  for v in xs
    s += v
  end
  s
end
