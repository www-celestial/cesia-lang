is_map() = equal(map(it * 2, [1, 2]), [2, 4])
is_map_column() = equal(map(it * 2, [1; 2]), [2; 4])
is_map_native() = equal(map(sqrt, [4.0]), [2.0])
is_filter() = equal(filter(it > 1, [1, 2, 3]), [2, 3])
is_reduce() = reduce((a, x) -> a + x, 0, [1, 2, 3]) == 6
is_scan() = equal(scan((a, x) -> a + x, 0, [1, 2, 3]), [1, 3, 6])
is_range_step() = equal(range(1, 10, step = 3), [1, 4, 7, 10])
is_range_float() = equal(range(0, 1, step = 0.25), [0.0, 0.25, 0.5, 0.75, 1.0])
is_range_rounding() = length(range(0, 8, step = 0.001)) == 8001
is_range_descending() = equal(range(3, 1, step = -1), [3, 2, 1])
is_group() = equal(group(mod(it, 2), [1, 2, 3, 4]), [{key: 1, values: [1, 3]}, {key: 0, values: [2, 4]}])
is_group_summary() = equal(group(mod(it, 2), [1, 2, 3, 4], summary = g -> {total: sum(g)}),
                          [{key: 1, total: 4}, {key: 0, total: 6}])
is_group_value() = equal(group(mod(it, 2), [1, 2], summary = sum), [{key: 1, value: 1}, {key: 0, value: 2}])
is_top() = equal(top(2, [5, 1, 9, 3]), [9, 5])
is_top_by() = equal(top(1, [{v: 1}, {v: 7}], by = it.v), [{v: 7}])
is_top_stable() = equal(top(2, [{v: 1, n: 1}, {v: 1, n: 2}], by = it.v), [{v: 1, n: 1}, {v: 1, n: 2}])
is_top_nan() = length(top(2, [nan, 1.0, 2.0])) == 2
