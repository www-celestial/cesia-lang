  {Law: "Poisson", Params: [0.3], X: 0.0, Pdf: 0.74081822068171788, Cdf: 0.74081822068171788, CdfTol: 21, Upper: 0.25918177931828212, UpperTol: 30},
  {Law: "Poisson", Params: [3.0], X: 1.0, Pdf: 0.14936120510359183, Cdf: 0.19914827347145578, CdfTol: 52, Upper: 0.80085172652854419, UpperTol: 25},
  {Law: "Poisson", Params: [47.5], X: 39.0, Pdf: 0.028345087902109361, Cdf: 0.12082397889465635, CdfTol: 194, Upper: 0.87917602110534365, UpperTol: 41},
  {Law: "Poisson", Params: [2500.0], X: 2563.0, Pdf: 0.0035862336247306768, Cdf: 0.89760090144047244, CdfTol: 176, Upper: 0.10239909855952752, UpperTol: 1417},
  {Law: "Poisson", Params: [1000000.0], X: 1001135.0, Pdf: 0.00020942811110292596, Cdf: 0.87190697588514687, CdfTol: 3859, Upper: 0.12809302411485313, UpperTol: 26176}]

(* Against the 70-digit values: the Pdf within 64 eps or the bound of the Cdf, the larger, and both tails. *)
isPdfTable() = list.All([near(law(r.Law, r.Params).Pdf(r.X), r.Pdf, list.Max(64.0, r.CdfTol)) for r in lawPoints])
isCdfTable() = list.All([near(law(r.Law, r.Params).Cdf(r.X), r.Cdf, r.CdfTol) for r in lawPoints])
isUpperTable() = list.All([near(law(r.Law, r.Params).Cdf(r.X, upper = true), r.Upper, r.UpperTol) for r in lawPoints])

(* Closed forms. *)
xs = [0.001, 0.1, 0.5, 1.0, 2.0, 7.5, 30.0]
isChiSquared2() = list.All([near(stats.ChiSquared(2).Cdf(x, upper = true), math.Exp(-x / 2.0), 8.0) for x in xs])
isChiSquared1() = list.All([near(stats.ChiSquared(1).Cdf(x), special.Erf(math.Sqrt(x / 2.0)), 8.0) for x in xs])
isCauchy() = list.All([near(stats.StudentT(1).Cdf(t), 0.5 + math.Atan(t) / math.Pi, 8.0) for t in [-3.0, -0.5, 0.25, 1.0, 9.0]])
isStudent2() = list.All([near(stats.StudentT(2).Cdf(t), 0.5 + t / (2.0 * math.Sqrt(2.0 + t * t)), 8.0) for t in [-3.0, -0.5, 0.25, 1.0, 9.0]])
isBetaPower() = list.All([near(stats.Beta(2.5, 1).Cdf(x), x ^ 2.5, 8.0) for x in [0.01, 0.2, 0.5, 0.9]])
isBetaUniform() = list.All([near(stats.Beta(1, 1).Cdf(x), stats.Uniform(0, 1).Cdf(x), 2.0) for x in [0.01, 0.2, 0.5, 0.9]])
isGammaExponential() = list.All([near(stats.Gamma(1, 2.5).Cdf(x), stats.Exponential(2.5).Cdf(x), 8.0) and near(stats.Gamma(1, 2.5).Pdf(x), stats.Exponential(2.5).Pdf(x), 8.0) for x in xs])
isFisherBeta() = list.All([near(stats.FisherF(5, 9).Cdf(f), stats.Beta(2.5, 4.5).Cdf(5.0 * f / (5.0 * f + 9.0)), 16.0) for f in [0.1, 0.8, 1.0, 3.0]])
isChiGamma() = list.All([near(stats.ChiSquared(7).Pdf(x), stats.Gamma(3.5, 0.5).Pdf(x), 8.0) for x in xs])
isStudentInfinite() = stats.StudentT(1.0 / 0.0).Cdf(1.3) == stats.Normal(0, 1).Cdf(1.3) and stats.StudentT(1.0 / 0.0).Quantile(0.9) == stats.Normal(0, 1).Quantile(0.9)

(* Both tails, exactly symmetric where the law is. *)
isNormalSymmetric() = list.All([stats.Normal(0, 1).Cdf(-x) == stats.Normal(0, 1).Cdf(x, upper = true) for x in [0.1, 0.5, 1.96, 8.0, 37.0]])
isStudentSymmetric() = list.All([stats.StudentT(4.5).Cdf(-x) == stats.StudentT(4.5).Cdf(x, upper = true) for x in [0.1, 0.5, 1.96, 8.0, 1e6]])
isNormalFarTail() = near(stats.Normal(0, 1).Cdf(-37.5), 4.605353009581956e-308, 4.0) and near(stats.Normal(0, 1).Cdf(10, upper = true), 7.619853024160527e-24, 4.0)
isUpperDigits() = stats.ChiSquared(10).Cdf(100, upper = true) > 0.0 and 1.0 - stats.ChiSquared(10).Cdf(100) == 0.0

(* Quantiles back through the Cdf: the Cdf at the answer is p within tol (1 + c) eps, c = |x Pdf(x)| / p, as the
   answer is a float, rounded: near x = 1, the 1 - x of a beta law keeps no more digits than x, and an answer that
   rounds to 1 is skipped. *)
ps = [1e-300, 1e-100, 1e-20, 1e-5, 0.01, 0.2, 0.5, 0.7, 0.99, 0.999999]
defn backThrough(d, tol)
  ok = true
  for p in ps
    for up in [false, true]
      x = d.Quantile(p, upper = up)
      if x - x == 0.0 and math.Abs(x) > 1e-300 and x != 1.0
        c = math.Abs(x * d.Pdf(x)) / p
        if c - c == 0.0
          ok = ok and near(d.Cdf(x, upper = up), p, tol * (1.0 + c))
        end
      end
    end
  end
  ok
end
isNormalBack() = backThrough(stats.Normal(3, 2), 4096.0)
isStudentBack() = list.All([backThrough(stats.StudentT(nu), 8192.0) for nu in [0.5, 1.0, 2.0, 3.0, 12.0, 300.0, 1e6]])
isChiSquaredBack() = list.All([backThrough(stats.ChiSquared(k), 8192.0) for k in [0.3, 1.0, 5.0, 60.0, 5000.0]])
isFisherBack() = list.All(list.Flatten([[backThrough(stats.FisherF(a, b), 8192.0) for b in [1.5, 40.0]] for a in [0.7, 5.0, 300.0]]))
isGammaBack() = list.All([backThrough(stats.Gamma(a, 2.0), 8192.0) for a in [0.01, 0.5, 3.0, 2000.0]])
isBetaBack() = list.All(list.Flatten([[backThrough(stats.Beta(a, b), 8192.0) for b in [0.3, 4.0, 1200.0]] for a in [0.05, 1.0, 7.0, 900.0]]))
isExponentialBack() = backThrough(stats.Exponential(0.25), 64.0)
isNormalQuantileExact() = stats.Normal(0, 1).Quantile(0.975) == 1.9599639845400536 and stats.Normal(0, 1).Quantile(1e-300) == -37.0470962993612
isStudentTiny() = stats.StudentT(0.24163878828558052).Quantile(6.0929166903934015e-62) < -1e251
isQuantileEnds() = stats.Normal(0, 1).Quantile(0) == -1.0 / 0.0 and stats.Normal(0, 1).Quantile(1) == 1.0 / 0.0 and stats.ChiSquared(3).Quantile(0) == 0.0 and stats.ChiSquared(3).Quantile(1) == 1.0 / 0.0 and stats.Beta(2, 3).Quantile(1) == 1.0
isQuantileOutside() = nan(stats.Normal(0, 1).Quantile(1.5)) and nan(stats.Gamma(2, 1).Quantile(-0.1)) and nan(stats.Binomial(10, 0.3).Quantile(2.0))

(* The discrete laws: the Cdf is the sum of the masses, the masses sum to 1, and the quantile is the smallest k. *)
defn sums(d, top)
  total = 0.0
  ok = true
  for k in 0..top
    total = total + d.Pdf(k)
    ok = ok and math.Abs(d.Cdf(k) - total) <= 1e-13
  end
  ok
end
isBinomialSums() = sums(stats.Binomial(40, 0.37), 40) and math.Abs(list.Sum(stats.Binomial(40, 0.37).Pdf(0..40)) - 1.0) <= 1e-14
isPoissonSums() = sums(stats.Poisson(6.5), 60) and math.Abs(list.Sum(stats.Poisson(6.5).Pdf(0..80)) - 1.0) <= 1e-14
defn smallest(d, p)
  k = d.Quantile(p)
  d.Cdf(k) >= p * (1.0 - 64.0 * eps) and (k == 0.0 or d.Cdf(k - 1.0) < p)
end
isBinomialQuantile() = list.All(list.Flatten([[smallest(stats.Binomial(n, 0.3), p) for p in [1e-10, 0.05, 0.5, 0.95, 0.999]] for n in [1, 10, 1000, 1000000]]))
isPoissonQuantile() = list.All(list.Flatten([[smallest(stats.Poisson(lam), p) for p in [1e-10, 0.05, 0.5, 0.95, 0.999]] for lam in [0.1, 4.0, 300.0, 1e7]]))
isBinomialUpperQuantile() = list.All([stats.Binomial(50, 0.4).Cdf(stats.Binomial(50, 0.4).Quantile(p, upper = true), upper = true) <= p * (1.0 + 64.0 * eps) for p in [0.001, 0.3, 0.9]])
isNotWhole() = stats.Binomial(10, 0.5).Pdf(2.5) == 0.0 and stats.Poisson(2).Pdf(-1) == 0.0 and stats.Binomial(10, 0.5).Cdf(2.5) == stats.Binomial(10, 0.5).Cdf(2)
isDegenerate() = stats.Binomial(10, 0).Pdf(0) == 1.0 and stats.Binomial(10, 1).Cdf(9) == 0.0 and stats.Poisson(0).Pdf(0) == 1.0 and stats.Poisson(0).Quantile(0.7) == 0.0

(* Arrays, NaN and infinities. *)
isArrayShape() = value.Equal(value.Size(stats.Normal(0, 1).Cdf(matrix.Reshape([2, 3], [1, 2, 3, 4, 5, 6]))), [2, 3])
isArrayValues() = stats.Gamma(2, 1).Cdf([0.5, 1.0])[2] == stats.Gamma(2, 1).Cdf(1.0) and stats.Beta(2, 3).Quantile([0.25, 0.5])[1] == stats.Beta(2, 3).Quantile(0.25)
isNanThrough() = nan(stats.Normal(0, 1).Cdf(math.Nan)) and nan(stats.StudentT(3).Pdf(math.Nan)) and nan(stats.Poisson(3).Cdf(math.Nan))
isInfinities() = stats.Normal(0, 1).Cdf(1.0 / 0.0) == 1.0 and stats.StudentT(2).Cdf(-1.0 / 0.0) == 0.0 and stats.ChiSquared(4).Cdf(1.0 / 0.0, upper = true) == 0.0 and stats.Poisson(4).Cdf(1.0 / 0.0) == 1.0
isOutsideSupport() = stats.Beta(2, 3).Pdf(1.5) == 0.0 and stats.Gamma(2, 1).Cdf(-1) == 0.0 and stats.Uniform(0, 1).Cdf(2) == 1.0 and stats.Exponential(1).Pdf(-1) == 0.0

(* Wrong parameters are bugs of the caller. *)
isBadSd() = message(() -> stats.Normal(0, -1).Cdf(0)) == result.Err("stats.Normal: Sd is -1; give a finite number above 0.")
isBadDf() = message(() -> stats.StudentT(0).Quantile(0.5)) == result.Err("stats.StudentT: Df is 0; give a number above 0.")
isBadN() = message(() -> stats.Binomial(10.5, 0.3).Pdf(1)) == result.Err("stats.Binomial: N is 10.5; give a whole number of 0 or more.")
isBadP() = message(() -> stats.Binomial(10, 1.5).Cdf(1)) == result.Err("stats.Binomial: P is 1.5; give a number from 0 to 1.")
isBadUniform() = message(() -> stats.Uniform(2, 1).Pdf(1)) == result.Err("stats.Uniform: High is 1; give a number above Low, 2.")
isBadNan() = message(() -> stats.Gamma(math.Nan, 1).Cdf(1)) == result.Err("stats.Gamma: Shape is nan; give a finite number above 0.")
isBadElement() = message(() -> stats.Normal(0, 1).Cdf([1.0, "a"])) == result.Err("stats.Normal.Cdf: x[2] is \"a\"; give numbers (frame.Present drops the missing ones).")
isBadCount() = message(() -> stats.Normal(0, 1).Sample(-1)) == result.Err("stats.Normal.Sample: n is -1; give a whole number of 0 or more.")
