  {Law: "Gamma", Params: [0.3, 1.0], X: 0.3315359272181729, Pdf: 0.51969116682725913, Cdf: 0.74419687614128416, CdfTol: 21, Upper: 0.25580312385871579, UpperTol: 32},
  {Law: "Gamma", Params: [1.0, 2.0], X: 0.5134569965666609, Pdf: 0.71622077643572823, Cdf: 0.64188961178213588, CdfTol: 27, Upper: 0.35811038821786412, UpperTol: 35},
  {Law: "Gamma", Params: [2.5, 0.5], X: 19.036247739740485, Pdf: 0.00081188058975448761, Cdf: 0.99810751779072338, CdfTol: 16, Upper: 0.0018924822092765785, UpperTol: 147},
  {Law: "Gamma", Params: [40.0, 3.0], X: 24.98529228712713, Pdf: 5.3955328904606876e-06, Cdf: 0.99999635030740852, CdfTol: 16, Upper: 3.6496925914568831e-06, UpperTol: 607},
  {Law: "Gamma", Params: [900.0, 1.5], X: 444.9851140162473, Pdf: 3.8691828812643351e-18, Cdf: 7.3167028090042877e-18, CdfTol: 4372, Upper: 1, UpperTol: 16},
  {Law: "Beta", Params: [0.5, 0.5], X: 0.4138692761387841, Pdf: 0.64628085393288959, Cdf: 0.44489260827136429, CdfTol: 27, Upper: 0.55510739172863566, UpperTol: 25},
  {Law: "Beta", Params: [2.0, 3.0], X: 0.6152156427197661, Pdf: 1.0930585660133225, Cdf: 0.83788125277860825, CdfTol: 29, Upper: 0.16211874722139172, UpperTol: 82},
  {Law: "Beta", Params: [0.2, 8.0], X: 0.001, Pdf: 81.524585983626523, Cdf: 0.41000961859563573, CdfTol: 31, Upper: 0.58999038140436433, UpperTol: 26},
  {Law: "Beta", Params: [30.0, 60.0], X: 0.3450285305661081, Pdf: 7.6567889959354885, Cdf: 0.60188834613219511, CdfTol: 86, Upper: 0.39811165386780489, UpperTol: 122},
  {Law: "Beta", Params: [700.0, 900.0], X: 0.4370595549260584, Pdf: 32.149488246430153, Cdf: 0.48667333164537607, CdfTol: 478, Upper: 0.51332666835462393, UpperTol: 454},
  {Law: "Exponential", Params: [0.5], X: 1.9552739692769152, Pdf: 0.18809950670402342, Cdf: 0.62380098659195315, CdfTol: 25, Upper: 0.37619901340804685, UpperTol: 32},
  {Law: "Exponential", Params: [3.0], X: 0.2058605676951359, Pdf: 1.617740763688946, Cdf: 0.46075307877035132, CdfTol: 28, Upper: 0.53924692122964868, UpperTol: 26},
  {Law: "Binomial", Params: [10.0, 0.5], X: 5.0, Pdf: 0.24609375, Cdf: 0.623046875, CdfTol: 48, Upper: 0.376953125, UpperTol: 68},
  {Law: "Binomial", Params: [37.0, 0.13], X: 0.0, Pdf: 0.0057837877472081559, Cdf: 0.0057837877472081559, CdfTol: 104, Upper: 0.99421621225279189, UpperTol: 17},
  {Law: "Binomial", Params: [1000.0, 0.7], X: 697.0, Pdf: 0.026862627267833439, Cdf: 0.42976791474899262, CdfTol: 723, Upper: 0.57023208525100733, UpperTol: 549},
