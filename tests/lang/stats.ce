(** The tests of the laws of std/stats: values computed to 70 digits with the decimal arithmetic of Python, from the
    exact floats of the arguments; closed forms; both tails; quantiles back through the Cdf; the discrete laws against
    their masses; arrays, NaN, infinities and wrong parameters. A point's bounds are in eps: 16 (1 + c), c the largest
    |d log F / d log v| over x and each parameter, how much F changes for a relative change of eps in one of them. *)
use std/fiber
use std/list
use std/math
use std/matrix
use std/num
use std/result
use std/special
use std/stats
use std/value

eps = 2.220446049250313e-16
message(f) = fiber.Wait(fiber.Spawn(f)) then result.MapErr(it.Message)
relative(got, want) = math.Abs(got - want) / math.Abs(want) / eps
near(got, want, n) = relative(got, want) <= n
nan(x) = x != x

defn law(name, p)
  (** The law of a point of the table. *)
  match name
    "Normal" -> stats.Normal(p[1], p[2])
    "StudentT" -> stats.StudentT(p[1])
    "ChiSquared" -> stats.ChiSquared(p[1])
    "FisherF" -> stats.FisherF(p[1], p[2])
    "Gamma" -> stats.Gamma(p[1], p[2])
    "Beta" -> stats.Beta(p[1], p[2])
    "Exponential" -> stats.Exponential(p[1])
    "Binomial" -> stats.Binomial(p[1], p[2])
    "Poisson" -> stats.Poisson(p[1])
    else -> stats.Uniform(p[1], p[2])
  end
end

lawPoints = [{Law: "Normal", Params: [-4.194998486093776, 0.26318868194069955], X: -4.379775870166171, Pdf: 1.184704120872027, Cdf: 0.24131715547864988, CdfTol: 360, Upper: 0.75868284452135015, UpperTol: 125},
  {Law: "Normal", Params: [4.403764075850579, 2.5748722427049273], X: -2.0841246464153693, Pdf: 0.0064791497387920935, Cdf: 0.0058728539236819468, CdfTol: 131, Upper: 0.99412714607631802, UpperTol: 17},
  {Law: "Normal", Params: [-2.598078176185228, 0.14136259495731882], X: -2.652389538522588, Pdf: 2.6213360732339055, Cdf: 0.35041549356424578, CdfTol: 333, Upper: 0.64958450643575416, UpperTol: 187},
  {Law: "Normal", Params: [-2.119589395973619, 0.24565571567415329], X: -2.1261284594118455, Pdf: 1.6234141625169145, Cdf: 0.48938188418015188, CdfTol: 129, Upper: 0.51061811581984817, UpperTol: 124},
  {Law: "Normal", Params: [7.123074189626614, 0.5121670336969021], X: 7.086429194522812, Pdf: 0.77693880690919093, Cdf: 0.47148044822366747, CdfTol: 204, Upper: 0.52851955177633259, UpperTol: 184},
  {Law: "Normal", Params: [1.6057206109533806, 0.2141721507008376], X: 2.2002446813131136, Pdf: 0.039525058434904378, Cdf: 0.99724768532228358, CdfTol: 17, Upper: 0.0027523146777164659, UpperTol: 522},
  {Law: "StudentT", Params: [1.0], X: -1.0663141548836739, Pdf: 0.14894994469825912, Cdf: 0.23978799589842734, CdfTol: 27, Upper: 0.76021200410157264, UpperTol: 19},
  {Law: "StudentT", Params: [2.0], X: 2.7742046932835915, Pdf: 0.033120498733681634, Cdf: 0.94545871752582056, CdfTol: 18, Upper: 0.05454128247417947, UpperTol: 43},
