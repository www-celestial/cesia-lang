(* cesia.DocEntry on a function with parts, a struct with fields, a method, a static method and a native of a fake std. *)
use std/cesia
use std/io

defn show(name)
  e = cesia.DocEntry(name)
  io.Print(name, "|", e.Module, "|", e.Signature, "|", e.Builtin, e.File, e.Line)
  io.Print(e.Text)
  io.Print(e.Parts, e.Examples)
end

show("places.Scaled")
show("places.Rect")
show("date.Date.Next")
show("date.Date.Parse")
show("list.NewNative")
