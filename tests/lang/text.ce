use std/fiber
use std/list
use std/result
use std/text
use std/value

defn fails(f, kind)
  (fiber.Wait(fiber.Spawn(f)) then result.MapErr(it.Kind)) == result.Err(kind)
end
isSplit() = value.Equal("a,b,,c" then text.Split(","), ["a", "b", "", "c"])
isSplitNone() = value.Equal("abc" then text.Split(","), ["abc"])
isSplitEmptyText() = value.Equal("" then text.Split(","), [""])
isSplitLongSep() = value.Equal("a--b" then text.Split("--"), ["a", "b"])
isSplitEmptySep() = fails(() -> text.Split("", "a"), "type")
isJoin() = (["a", "b"] then text.Join(", ")) == "a, b"
isJoinValues() = ([1, 2.5] then text.Join("-")) == "1-2.5"
isJoinEmpty() = ([] then text.Join(",")) == ""
isJoinNotArray() = fails(() -> text.Join(",", 1), "type")
isTrim() = text.Trim("  a b  ") == "a b"
isTrimLines() = text.Trim("
a
") == "a"
isSlice() = ("hello" then text.Slice(2, 4)) == "ell"
isSliceAccents() = ("été" then text.Slice(2, 3)) == "té"
isSliceAll() = ("ab" then text.Slice(1, 2)) == "ab"
isSliceEmpty() = ("ab" then text.Slice(2, 1)) == ""
isSliceLow() = fails(() -> text.Slice(0, 1, "ab"), "index")
isSliceHigh() = fails(() -> text.Slice(1, 3, "ab"), "index")
isLower() = text.Lower("AbC-1") == "abc-1"
isStartsWith() = ("hello" then text.StartsWith("he")) and not ("he" then text.StartsWith("hello"))
isContains() = ("hello" then text.Contains("ll")) and ("hello" then text.Contains("")) and not ("a" then text.Contains("b"))
isReplace() = ("a-b-c" then text.Replace("-", "+")) == "a+b+c"
isReplaceNone() = ("abc" then text.Replace("x", "y")) == "abc"
isReplaceGrows() = ("aa" then text.Replace("a", "bb")) == "bbbb"
isReplaceEmpty() = fails(() -> text.Replace("", "x", "a"), "type")
isNumberInt() = text.Number("42") == 42 and value.IsInt(text.Number("-42"))
isNumberFloat() = text.Number("1.5e3") == 1500.0 and value.IsFloat(text.Number("1.5"))
isNumberNo() = value.IsMissing(text.Number("")) and value.IsMissing(text.Number("0x10")) and value.IsMissing(text.Number(" 1"))
isNumberShapes() = value.IsMissing(text.Number("1.")) and value.IsMissing(text.Number(".5")) and value.IsMissing(text.Number("1e")) and value.IsMissing(text.Number("1_000"))
isNumberOverflow() = value.IsFloat(text.Number("99999999999999999999"))
isNotText() = fails(() -> text.Lower(1), "type")
isEscapeNewline() = text.ByteLength("a\nb") == 3 and text.Byte(2, "a\nb") == 10
isEscapeTab() = text.Byte(1, "\t") == 9
isEscapeReturn() = text.Byte(1, "\r") == 13
isEscapeBackslash() = text.ByteLength("\\") == 1
isEscapeQuote() = "\"" == "\""
isOtherBackslashStays() = text.ByteLength("\d") == 2
isEmptyArraysEqual() = value.Equal(list.Filter(it > 9, [1]), [])
isTextOrder() = "a" < "b" and "b" > "a" and "a" <= "a" and "a" >= "a" and not ("b" < "a")

isDecimals() = text.Decimals(2, 3.14159) == "3.14" and text.Decimals(3, 2) == "2.000" and text.Decimals(0, 7) == "7"
isDecimalsHalves() = text.Decimals(0, 0.5) == "1" and text.Decimals(0, -2.5) == "-3" and text.Decimals(2, 0.125) == "0.13"
isDecimalsBinary() = text.Decimals(2, 2.675) == "2.67" and text.Decimals(1, 0.05) == "0.1" and text.Decimals(2, 1.005) == "1.00"
isDecimalsZero() = text.Decimals(2, -0.001) == "0.00" and text.Decimals(0, -0.4) == "0" and text.Decimals(1, -0.0) == "0.0"
isDecimalsLarge() = text.Decimals(1, 1e20) == "100000000000000000000.0" and text.Decimals(2, 9007199254740993) == "9007199254740993.00"
isDecimalsNoFloat() = text.Decimals(2, 123456.789) == "123456.79" and text.Decimals(4, 1.0 / 3) == "0.3333"
