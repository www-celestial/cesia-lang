use std/fiber
use std/list
use std/random
use std/result
use std/text
use std/value

defn fails(f, kind)
  (fiber.Wait(fiber.Spawn(f)) then result.MapErr(it.Kind)) == result.Err(kind)
end
isSplit() = value.Equal("a,b,,c" then text.Split(","), ["a", "b", "", "c"])
isSplitNone() = value.Equal("abc" then text.Split(","), ["abc"])
isSplitEmptyText() = value.Equal("" then text.Split(","), [""])
isSplitLongSep() = value.Equal("a--b" then text.Split("--"), ["a", "b"])
isSplitEmptySep() = fails(() -> text.Split("", "a"), "type")
isJoin() = (["a", "b"] then text.Join(", ")) == "a, b"
isJoinValues() = ([1, 2.5] then text.Join("-")) == "1-2.5"
isJoinEmpty() = ([] then text.Join(",")) == ""
isJoinNotArray() = fails(() -> text.Join(",", 1), "type")
isTrim() = text.Trim("  a b  ") == "a b"
isTrimLines() = text.Trim("
a
") == "a"
isSlice() = ("hello" then text.Slice(2, 4)) == "ell"
isSliceAccents() = ("été" then text.Slice(2, 3)) == "té"
isSliceAll() = ("ab" then text.Slice(1, 2)) == "ab"
isSliceEmpty() = ("ab" then text.Slice(2, 1)) == ""
isSliceLow() = fails(() -> text.Slice(0, 1, "ab"), "index")
isSliceHigh() = fails(() -> text.Slice(1, 3, "ab"), "index")
isLower() = text.Lower("AbC-1") == "abc-1"
isStartsWith() = ("hello" then text.StartsWith("he")) and not ("he" then text.StartsWith("hello"))
isContains() = ("hello" then text.Contains("ll")) and ("hello" then text.Contains("")) and not ("a" then text.Contains("b"))
isReplace() = ("a-b-c" then text.Replace("-", "+")) == "a+b+c"
isReplaceNone() = ("abc" then text.Replace("x", "y")) == "abc"
isReplaceGrows() = ("aa" then text.Replace("a", "bb")) == "bbbb"
isReplaceEmpty() = fails(() -> text.Replace("", "x", "a"), "type")
isNumberInt() = text.Number("42") == 42 and value.IsInt(text.Number("-42"))
isNumberFloat() = text.Number("1.5e3") == 1500.0 and value.IsFloat(text.Number("1.5"))
isNumberNo() = value.IsMissing(text.Number("")) and value.IsMissing(text.Number("0x10")) and value.IsMissing(text.Number(" 1"))
isNumberShapes() = value.IsMissing(text.Number("1.")) and value.IsMissing(text.Number(".5")) and value.IsMissing(text.Number("1e")) and value.IsMissing(text.Number("1_000"))
isNumberOverflow() = value.IsFloat(text.Number("99999999999999999999"))
isNotText() = fails(() -> text.Lower(1), "type")
isEscapeNewline() = text.ByteLength("a\nb") == 3 and text.Byte(2, "a\nb") == 10
isEscapeTab() = text.Byte(1, "\t") == 9
isEscapeReturn() = text.Byte(1, "\r") == 13
isEscapeBackslash() = text.ByteLength("\\") == 1
isEscapeQuote() = "\"" == "\""
isOtherBackslashStays() = text.ByteLength("\d") == 2
isEmptyArraysEqual() = value.Equal(list.Filter(it > 9, [1]), [])
isTextOrder() = "a" < "b" and "b" > "a" and "a" <= "a" and "a" >= "a" and not ("b" < "a")

isDecimals() = text.Decimals(2, 3.14159) == "3.14" and text.Decimals(3, 2) == "2.000" and text.Decimals(0, 7) == "7"
isDecimalsHalves() = text.Decimals(0, 0.5) == "1" and text.Decimals(0, -2.5) == "-3" and text.Decimals(2, 0.125) == "0.13"
isDecimalsBinary() = text.Decimals(2, 2.675) == "2.67" and text.Decimals(1, 0.05) == "0.1" and text.Decimals(2, 1.005) == "1.00"
isDecimalsZero() = text.Decimals(2, -0.001) == "0.00" and text.Decimals(0, -0.4) == "0" and text.Decimals(1, -0.0) == "0.0"
isDecimalsLarge() = text.Decimals(1, 1e20) == "100000000000000000000.0" and text.Decimals(2, 9007199254740993) == "9007199254740993.00"
isDecimalsNoFloat() = text.Decimals(2, 123456.789) == "123456.79" and text.Decimals(4, 1.0 / 3) == "0.3333"
(* text.Count: one byte eight at a time, and its last bytes; longer parts without overlaps; the same answer as Split. *)
isCountByte() = text.Count("\n", "a\nb\nc") == 2 and text.Count("x", "") == 0 and text.Count("x", "abc") == 0
isCountEveryLength() = list.All([text.Count("a", text.Repeat(n, "a")) == n and text.Count("a", text.Repeat(n, "ba")) == n for n in 0..40])
isCountTail() = list.All([text.Count("z", "$(text.Repeat(n, "y"))z") == 1 for n in 0..20])
isCountNoOverlap() = text.Count("aa", "aaaa") == 2 and text.Count("aa", "aaa") == 1 and text.Count("aba", "ababa") == 1
isCountLong() = text.Count("abc", "abcabcab") == 2 and text.Count("abcd", "abc") == 0
isCountAccents() = text.Count("é", "été") == 2 and text.Count(text.FromBytes([0xA9]), "été") == 2
sameAsSplit(p) = list.All([text.Count(p, s) == value.Len(text.Split(p, s)) - 1 for s in ["", "a", "aaaaaaaaa", "abababababababab", "x\ny\n\nz\n", "aaxyzaaxyzxy", text.Repeat(9, "ab\n")]])
isCountAsSplit() = list.All([sameAsSplit(p) for p in ["a", "ab", "\n", "aa", "xyz"]])
isCountEmpty() = fails(() -> text.Count("", "a"), "type")
isCountNotText() = fails(() -> text.Count("a", 1), "type")
(* text.IsUtf8, as RFC 3629: the ASCII words, then each character, at every place of a word. *)
bytes(xs) = text.FromBytes(xs)
isUtf8Valid() = list.All([text.IsUtf8(s) for s in ["", "a", "héllo", "日本語", "😀", text.Repeat(17, "a"), text.Repeat(9, "aé")]])
isUtf8Edges() = list.All([text.IsUtf8(bytes(xs)) for xs in [[0x7F], [0xC2, 0x80], [0xDF, 0xBF], [0xE0, 0xA0, 0x80], [0xED, 0x9F, 0xBF], [0xEE, 0x80, 0x80], [0xEF, 0xBF, 0xBF], [0xF0, 0x90, 0x80, 0x80], [0xF4, 0x8F, 0xBF, 0xBF]]])
isUtf8Invalid() = not list.Any([text.IsUtf8(bytes(xs)) for xs in [[0x80], [0xBF], [0xC0, 0x80], [0xC1, 0xBF], [0xE0, 0x80, 0x80], [0xE0, 0x9F, 0xBF], [0xED, 0xA0, 0x80], [0xED, 0xBF, 0xBF], [0xF0, 0x80, 0x80, 0x80], [0xF0, 0x8F, 0xBF, 0xBF], [0xF4, 0x90, 0x80, 0x80], [0xF5, 0x80, 0x80, 0x80], [0xFE], [0xFF], [0xC3], [0xE2, 0x82], [0xF0, 0x9F, 0x98], [0xC3, 0x41]]])
badAt(n) = "$(text.Repeat(n, "a"))$(bytes([0xFF]))$(text.Repeat(9, "b"))"
goodAt(n) = "$(text.Repeat(n, "a"))é$(text.Repeat(9, "b"))"
isUtf8EveryPlace() = list.All([not text.IsUtf8(badAt(n)) and text.IsUtf8(goodAt(n)) for n in 0..20])
isUtf8NotText() = fails(() -> text.IsUtf8(1), "type")
(* text.ByteFind: the rarest byte of the part eight bytes at a time, then the part whole; from every byte, the same answer
   as a search byte by byte; with fold, the same as on both texts in lower case; a part of 32 bytes or more by KMP. *)
defn slowFind(p, from, s)
  n = text.ByteLength(p)
  for i in from..(text.ByteLength(s) - n + 1)
    if text.ByteSlice(i, i + n - 1, s) == p
      return i
    end
  end
  missing
end
long = "abcdefghijklmnopqrstuvwxyz012345"
finds = ["a", "abcabc", "$(text.Repeat(20, "x"))the", "Hello World, hello WORLD", "été et ÉTÉ", text.Repeat(5, "zq\nZQ "), "the THE tHe", "xx$(long)yy$(text.Repeat(3, "ABCDEFGHIJKLMNOPQRSTUVWXYZ012345"))"]
parts = ["a", "the", "zq", "\n", "o w", "é", "World", "ÉTÉ", "xthe", "q\nz", long, "z0"]
sameFinds(p, s) = list.All([value.Equal(text.ByteFind(p, f, s), slowFind(p, f, s)) for f in 1..text.ByteLength(s)])
sameFolds(p, s) = list.All([value.Equal(text.ByteFind(p, f, s, fold = true), text.ByteFind(text.Lower(p), f, text.Lower(s))) for f in 1..text.ByteLength(s)])
isByteFindAsSlow() = list.All([list.All([sameFinds(p, s) for p in parts]) for s in finds])
isByteFindFold() = list.All([list.All([sameFolds(p, s) for p in parts]) for s in finds])
isByteFindFoldCases() = text.ByteFind("World", 1, "hello WORLD", fold = true) == 7 and text.ByteFind("é", 1, "aÉé", fold = true) == 4 and value.IsMissing(text.ByteFind("World", 1, "hello WORLD"))
isByteFindFoldOnlyLetters() = value.IsMissing(text.ByteFind("[", 1, "{", fold = true)) and value.IsMissing(text.ByteFind("@", 1, "`", fold = true))
isByteFindEdges() = text.ByteFind("", 3, "abc") == 3 and value.IsMissing(text.ByteFind("a", 4, "abc")) and value.IsMissing(text.ByteFind("a", 1, ""))
isByteFindFoldNotBool() = fails(() -> text.ByteFind("a", 1, "a", fold = 1), "type")
(* text.Fold: Unicode's simple case folding, for search and comparison; text.Lower and text.Upper stay ASCII. *)
isFold() = text.Fold("Élodie") == text.Fold("ÉLODIE") and text.Fold("ÉLODIE") == "élodie"
isFoldAscii() = text.Fold("AbC-1 [@`{]") == "abc-1 [@`{]"
isFoldSigma() = text.Fold("Σ") == "σ" and text.Fold("ς") == "σ" and text.Fold("ΣΊΣΥΦΟΣ") == "σίσυφοσ"
isFoldKelvin() = text.Fold(text.Char(0x212A)) == "k" and text.Fold(text.Char(0x17F)) == "s"
isFoldSimpleOnly() = text.Fold("ß") == "ß" and text.Fold(text.Char(0x1E9E)) == "ß" and text.Fold("ŉ") == "ŉ"
isFoldCherokee() = text.Fold(text.Char(0xAB70)) == text.Char(0x13A0) and text.Fold(text.Char(0x13F8)) == text.Char(0x13F0)
isFoldGrows() = text.Fold("ȺȾ") == text.Str(text.Char(0x2C65), text.Char(0x2C66)) and text.ByteLength(text.Fold("ȺȾ")) == 6
isFoldFourBytes() = text.Fold(text.Char(0x10400)) == text.Char(0x10428) and text.Fold(text.Char(0x1E900)) == text.Char(0x1E922)
isFoldKeepsBadBytes() = text.Fold(text.FromBytes([0xFF, 0x41, 0xC3])) == text.FromBytes([0xFF, 0x61, 0xC3])
isFoldNotText() = fails(() -> text.Fold(1), "type")
isLowerStaysAscii() = text.Lower(text.Str("ÉA", text.Char(0x212A))) == text.Str("Éa", text.Char(0x212A)) and text.Upper("éa") == "éA"
(* Any bytes: folding twice is folding once, and the folded text is at most half again as long. *)
someBytes = [0x41, 0x5A, 0x61, 0x80, 0x84, 0x89, 0x9E, 0xA4, 0xAA, 0xBA, 0xC3, 0xC8, 0xE2, 0xED, 0xF0, 0xFF]
defn foldsOnce()
  s = text.FromBytes([random.Pick(someBytes) for k in 1..random.Int(0, 12)])
  f = text.Fold(s)
  text.Fold(f) == f and 2 * text.ByteLength(f) <= 3 * text.ByteLength(s)
end
isFoldAnyBytes() = list.All([foldsOnce() for k in 1..3000])
