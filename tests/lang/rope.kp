use rope
use history
use num

big = join("\n", ["line $k" for k in 1:2000])

is_of() = rope.text(rope.of("abc")) == "abc" and rope.size(rope.of("abc")) == 3
is_big() = rope.text(rope.of(big)) == big and rope.line_count(rope.of(big)) == 2000
is_balanced() = rope.of(big).height < 8
is_insert() = rope.text(rope.insert(1, "XY", rope.of("abc"))) == "aXYbc"
is_insert_ends() = rope.text(rope.insert(0, "<", rope.insert(3, ">", rope.of("abc")))) == "<abc>"
is_delete() = rope.text(rope.delete(1, 3, rope.of("abcd"))) == "ad"
is_slice() = rope.slice(1, 3, rope.of("abcd")) == "bc"
is_line() = rope.line(2, rope.of("a\nbc\nd")) == "bc" and rope.line(3, rope.of("a\nbc\nd")) == "d"
is_big_line() = rope.line(1500, rope.of(big)) == "line 1500"
is_line_start() = rope.line_start(3, rope.of("a\nbc\nd")) == 5 and rope.line_start(1, rope.of("x")) == 0
is_line_of() = rope.line_of(0, rope.of("a\nb")) == 1 and rope.line_of(2, rope.of("a\nb")) == 2 and rope.line_of(1, rope.of("a\nb")) == 1
is_empty() = rope.text(rope.of("")) == "" and rope.line_count(rope.of("")) == 1 and rope.line(1, rope.of("")) == ""
is_keeps_the_original() = kept() == "abc"

defn kept()
  r = rope.of("abc")
  rope.insert(1, "X", r)
  rope.text(r)
end

-- Random edits against a plain text.
defn is_against_a_model()
  r = rope.of(big)
  model = big
  dice = num.uniform(3000, num.seeded(5)).values
  for k in 1:1000
    n = byte_length(model)
    at = floor(dice[3 * k - 2] * n)
    if dice[3 * k - 1] < 0.6
      piece = if mod(k, 7) == 0 "new\nline" else "ab" end
      r = rope.insert(at, piece, r)
      before = if at == 0 "" else byte_slice(1, at, model) end
      after = if at == n "" else byte_slice(at + 1, n, model) end
      model = "$before$piece$after"
    else
      to = min(at + floor(dice[3 * k] * 40), n)
      r = rope.delete(at, to, r)
      before = if at == 0 "" else byte_slice(1, at, model) end
      after = if to == n "" else byte_slice(to + 1, n, model) end
      model = "$before$after"
    end
    -- The count of lines only moves by steps, so a drift stays visible at the next check.
    if r.size != byte_length(model) or (mod(k, 50) == 0 and r.lines != length(split("\n", model)) - 1)
      return false
    end
  end
  rope.text(r) == model and rope.line(rope.line_count(r), r) == split("\n", model)[rope.line_count(r)]
end

is_history() = history.current(history.undo(history.record(2, history.of(1)))) == 1
is_redo() = history.current(history.redo(history.undo(history.record(2, history.of(1))))) == 2
is_record_clears_redo() = not history.can_redo(history.record(3, history.undo(history.record(2, history.of(1)))))
is_undo_at_start() = history.current(history.undo(history.of(1))) == 1 and history.current(history.redo(history.of(1))) == 1
is_limit() = length(reduce((h, x) -> history.record(x, h), history.of(0, limit = 3), [1, 2, 3, 4, 5]).past) == 3
