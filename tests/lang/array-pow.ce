(** The tests of ^ on arrays: a store of floats or of integers goes in one loop, and gives the values, the bits, the kind
    of store and the errors that ^ gives cell by cell. *)
use std/columns
use std/fiber
use std/list
use std/math
use std/num
use std/result
use std/value

message(f) = fiber.Wait(fiber.Spawn(f)) then result.MapErr(it.Message)
cellwise(xs, f) = [f(x) for x in xs]
sameBits(a, b) = value.Len(a) == value.Len(b) and list.All([a[k] == b[k] or (a[k] != a[k] and b[k] != b[k]) for k in 1..value.Len(a)])

xs = [0.5, 1.5, -2.0, 0.0, 3.25, 1.0e-300, 1.0e300, -0.0]
isPowFloatsByFloat() = sameBits(xs ^ 1.5, cellwise(xs, x -> x ^ 1.5)) and columns.Kind(xs ^ 1.5) == "float"
isPowFloatsByInt() = sameBits(xs ^ 2, cellwise(xs, x -> x ^ 2)) and columns.Kind(xs ^ 2) == "float"
isPowFloatsByFloats() = sameBits(xs ^ (xs * 0.5), [xs[k] ^ (xs[k] * 0.5) for k in 1..value.Len(xs)])
isPowFloatBase() = sameBits(2.5 ^ xs, cellwise(xs, x -> 2.5 ^ x)) and sameBits(3 ^ xs, cellwise(xs, x -> 3 ^ x))
isPowNan() = value.Equal([math.Nan, 1.0] ^ 0, [1.0, 1.0]) and sameBits([math.Nan, -1.0] ^ 0.5, [math.Nan, math.Nan])
isPowInf() = sameBits([math.Inf, 0.0, -math.Inf] ^ -1, [0.0, math.Inf, -0.0])
isPowInts() = value.Equal([1, 2, 3] ^ 2, [1, 4, 9]) and columns.Kind([1, 2, 3] ^ 2) == "int"
isPowIntsByInts() = value.Equal([2, 3, 4] ^ [0, 1, 3], [1, 3, 64]) and columns.Kind([2, 3] ^ [1, 2]) == "int"
isPowIntBase() = value.Equal(2 ^ [1, 2, 10], [2, 4, 1024]) and columns.Kind(2 ^ [1, 2]) == "int"
isPowIntsNegative() = value.Equal([1, 2, 4] ^ -1, [1.0, 0.5, 0.25]) and columns.Kind([1, 2, 4] ^ -1) == "float"
isPowIntsMixed() = value.Equal([2, 2] ^ [2, -1], [4, 0.5]) and value.IsInt(([2, 2] ^ [2, -1])[1])
isPowIntsByFloat() = sameBits([1, 2, 3] ^ 0.5, cellwise([1, 2, 3], x -> x ^ 0.5)) and columns.Kind([1, 2] ^ 0.5) == "float"
isPowIntsByFloats() = sameBits([4, 9] ^ [0.5, 1.5], [4 ^ 0.5, 9 ^ 1.5])
isPowOverflow() = message(() -> [2, 3, 2] ^ [3, 40, 63]) == message(() -> 3 ^ 40)
isPowOverflowFirst() = message(() -> [10, 3] ^ [19, 40]) == message(() -> 10 ^ 19)
isPowShape() = message(() -> [1.0, 2.0] ^ [1.0, 2.0, 3.0]) == message(() -> [1.0, 2.0] + [1.0, 2.0, 3.0])
isPowEmpty() = value.Len(([] ^ 2)) == 0
isPowMatrix() = value.Equal([1.0 2.0; 3.0 4.0] ^ 2, [1.0 4.0; 9.0 16.0]) and value.Equal(value.Size([1 2; 3 4] ^ 2), [2, 2])
isPowBools() = value.Equal([true, false] ^ 2, [1, 0])
isPowText() = message(() -> [1.0, 2.0] ^ "a") == message(() -> 1.0 ^ "a")
isPowMissing() = value.IsMissing(([1.0, missing] ^ 2)[2]) and ([1.0, missing] ^ 2)[1] == 1.0
defn isPowLarge()
  (** Past the size at which the loop splits among the cores. *)
  ys = num.Uniform(300000) * 4.0 - 2.0
  zs = ys ^ 1.5
  sameBits(zs, cellwise(ys, y -> y ^ 1.5)) and columns.Kind(zs) == "float"
end
defn isPowLargeInts()
  (** Integers past that size too, each checked. *)
  ns = list.Range(1, 300000)
  value.Equal(ns ^ 2, cellwise(ns, n -> n * n)) and columns.Kind(ns ^ 2) == "int"
end
