(** The tests of optimize.Root: closed forms, the test problems of Alefeld, Potra and Shi (1995), a property on
    polynomials with a known simple root, the bound on its calls of f, and its errors; those of Minimize and Simplex for
    each shape of x, their calls of f and their errors. Their tests on the problems of Moré, Garbow and Hillstrom are in
    optimize-mgh.ce. *)
use std/bug
use std/fiber
use std/gen
use std/list
use std/math
use std/optimize
use std/result
use std/test
use std/text
use std/value

eps = 2.220446049250313e-16
message(f) = fiber.Wait(fiber.Spawn(f)) then result.MapErr(it.Message)
rootOf(r) = result.Unwrap(r).X
within(x, want) = math.Abs(x - want) <= 2.0 * eps * math.Abs(want)   (** as close as Root promises *)

(* Closed forms: the float nearest to the zero, or one of the two around it. *)
isCubic() = rootOf(optimize.Root(x -> x ^ 3 - 2.0 * x - 5.0, [2.0, 3.0])) == 2.0945514815423265
isCosine() = rootOf(optimize.Root(x -> math.Cos(x) - x, [0.0, 1.0])) == 0.7390851332151607
isLog2() = rootOf(optimize.Root(x -> math.Exp(x) - 2.0, [0.0, 1.0])) == math.Log(2.0)
isSqrt2Backwards() = within(rootOf(optimize.Root(x -> x * x - 2.0, [2.0, 0.0])), math.Sqrt(2.0))
isEndIsRoot() = rootOf(optimize.Root(x -> x - 1.0, [1.0, 3.0])) == 1.0 and optimize.Root(x -> x - 1.0, [1.0, 3.0]).Value.Evaluations == 2
isTolerance() = math.Abs(rootOf(optimize.Root(x -> x ^ 3 - 2.0 * x - 5.0, [2.0, 3.0], tol = 1.0e-6)) - 2.0945514815423265) <= 2.0e-6 + 2.0 * eps * 2.1

(* From one start: a bracket is found first. *)
isStartCosine() = rootOf(optimize.Root(x -> math.Cos(x) - x, 1.0)) == 0.7390851332151607
isStartZero() = rootOf(optimize.Root(x -> x - 0.5, 0.0)) == 0.5
isStartRoot() = optimize.Root(x -> x - 2.0, 2.0).Value == {X: 2.0, F: 0.0, Evaluations: 1}
isStartPastNan() = within(rootOf(optimize.Root(x -> math.Sqrt(x) - 2.0, 1.0)), 4.0)

defn aps(p, args)
  (** Problem p of Alefeld, Potra and Shi (1995), with its parameters, as a function of x. *)
  a = if value.Len(args) >= 1 args[1] else 0.0 end
  b = if value.Len(args) >= 2 args[2] else 0.0 end
  if p == 1
    return x -> math.Sin(x) - x / 2.0
  end
  if p == 2
    return defn (x)
      s = 0.0
      for i in 1..20
        s = s + (2.0 * i - 5.0) ^ 2 / (x - 1.0 * i * i) ^ 3
      end
      -2.0 * s
    end
  end
  if p == 3
    return x -> a * x * math.Exp(b * x)
  end
  if p == 4
    return x -> x ^ a - b
  end
  if p == 5
    return x -> math.Sin(x) - 0.5
  end
  if p == 6
    return x -> 2.0 * x * math.Exp(-a) - 2.0 * math.Exp(-a * x) + 1.0
  end
  if p == 7
    return x -> (1.0 + (1.0 - a) ^ 2) * x - (1.0 - a * x) ^ 2
  end
  if p == 8
    return x -> x * x - (1.0 - x) ^ a
  end
  if p == 9
    return x -> (1.0 + (1.0 - a) ^ 4) * x - (1.0 - a * x) ^ 4
  end
  if p == 10
    return x -> math.Exp(-a * x) * (x - 1.0) + x ^ a
  end
  if p == 11
    return x -> (a * x - 1.0) / ((a - 1.0) * x)
  end
  if p == 12
    return x -> x ^ (1.0 / a) - a ^ (1.0 / a)
  end
  if p == 13
    return defn (x)
      if x == 0.0
        return 0.0
      end
      y = 1.0 / (x * x)
      if y > 709.782712893384
        return 0.0
      end
      x / math.Exp(y)
    end
  end
  if p == 14
    return x -> if x <= 0.0 (-a / 20.0) else a / 20.0 * (x / 1.5 + math.Sin(x) - 1.0) end
  end
  defn (x)
    if x < 0.0
      return -0.859
    end
    if x > 2.0e-3 / (1.0 + a)
      return math.Exp(1.0) - 1.859
    end
    math.Exp((a + 1.0) * x / 2.0 * 1000.0) - 1.859
  end
end

