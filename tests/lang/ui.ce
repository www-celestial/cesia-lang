use pkg/ui

r = {X: 10, Y: 20, Width: 100, Height: 40}

defn isLeftAddsUp()
  cut = ui.Left(30, r)
  cut.Part.X == 10 and cut.Part.Width == 30 and cut.Rest.X == 40 and cut.Rest.Width == 70 and cut.Rest.Height == 40
end

defn isRightAddsUp()
  cut = ui.Right(30, r)
  cut.Part.X == 80 and cut.Part.Width == 30 and cut.Rest.X == 10 and cut.Rest.Width == 70
end

defn isTopAddsUp()
  cut = ui.Top(10, r)
  cut.Part.Y == 20 and cut.Part.Height == 10 and cut.Rest.Y == 30 and cut.Rest.Height == 30
end

defn isBottomAddsUp()
  cut = ui.Bottom(10, r)
  cut.Part.Y == 50 and cut.Part.Height == 10 and cut.Rest.Y == 20 and cut.Rest.Height == 30
end

defn isCutPastTheEnd()
  cut = ui.Left(500, {X: 0, Y: 0, Width: 100, Height: 10})
  cut.Part.Width == 100 and cut.Rest.Width == 0 and cut.Rest.X == 100
end

defn isCutOfANegativeSize()
  cut = ui.Top(-5, r)
  cut.Part.Height == 0 and cut.Rest.Height == 40
end

defn isInsetKeepsTheMiddle()
  smaller = ui.Inset(4, r)
  smaller.X == 14 and smaller.Y == 24 and smaller.Width == 92 and smaller.Height == 32
end

defn isInsetPastTheMiddle()
  smaller = ui.Inset(60, r)
  smaller.Width == 0 and smaller.Height == 0
end

defn isContainsEdges()
  ui.Contains({X: 10, Y: 20}, r) and not ui.Contains({X: 110, Y: 20}, r) and not ui.Contains({X: 10, Y: 60}, r) and ui.Contains({X: 109, Y: 59}, r)
end

defn stepped(n, seconds)
  value = 0.0
  for k in 1:n
    value = ui.Ease(value, 1.0, seconds)
  end
  value
end

isEaseStaysTheSameInSteps() = Abs(stepped(10, 0.001) - stepped(1, 0.01)) < 0.0001
isEaseOfNoTime() = ui.Ease(1.0, 2.0, 0.0) == 1.0
isEaseReachesItsGoal() = ui.Rests(stepped(200, 0.016), 1.0)
isRests() = ui.Rests(1.0, 1.001) and not ui.Rests(1.0, 1.01)

defn isSliderValueAtBothEnds()
  ui.SliderValue({X: 10, Y: 0}, r) == 0.0 and ui.SliderValue({X: 110, Y: 0}, r) == 1.0 and ui.SliderValue({X: 60, Y: 0}, r) == 0.5 and ui.SliderValue({X: 0, Y: 0}, r) == 0.0 and ui.SliderValue({X: 900, Y: 0}, r) == 1.0
end

isSliderOfNoWidth() = ui.SliderValue({X: 10, Y: 0}, {X: 10, Y: 0, Width: 0, Height: 4}) == 0.0

themeFields(t) = [t.Ground, t.Panel, t.Header, t.Tab, t.Well, t.Edge, t.Line, t.Code, t.Ink, t.Bright, t.Muted, t.Faint, t.Accent, t.Fill, t.Hover, t.Picked, t.Graph, t.Body, t.Big, t.Shadow, t.GridMinor, t.GridMajor]

isThemesHaveTheSameFields() = Len(themeFields(ui.Dark)) == Len(themeFields(ui.Light)) and Len(ui.Dark.Syntax) == 7 and Len(ui.Light.Syntax) == 7
isLightPalette() = ui.Light.Ground == 0xEBECF0 and ui.Light.Panel == 0xF7F8FA and ui.Light.Graph == 0xFFFFFF and ui.Light.Code == 0xFFFFFF

defn isLookHoldsItsParts()
  look = ui.Look(ui.Dark, (words, font) -> Len(words) * 7, 16)
  look.Height == 16 and look.Width("abc", "body") == 21 and look.Theme.Ground == ui.Dark.Ground
end

look = ui.Look(ui.Dark, (words, font) -> Len(words) * 7, 16)
area = {X: 10, Y: 10, Width: 300, Height: 200}
nothing = {X: 10, Y: 10, Width: 0, Height: 0}
arrow = ui.Icons.Arrow

pin(name) = {Name: name, Color: 0xE8C547}
nodeA = {X: 20, Y: 20, Width: 100, Title: "A", Color: 0x336699, Inputs: [], Outputs: [pin("Out")], Body: 0}
nodeB = {X: 60, Y: 40, Width: 100, Title: "B", Color: 0x336699, Inputs: [pin("In"), pin("Other")], Outputs: [], Body: 30}
two = [nodeA, nodeB]
link = {From: 1, Output: 1, To: 2, Input: 1, Color: 0xE8C547}
known = ["clear", "rect", "box", "ring", "fade", "shadow", "text", "image", "tile", "icon", "curves"]

isKnown(commands) = All(Map(c -> c.Kind in known, commands))

defn widgets(rect)
  tools = [{Shape: arrow, Name: "Save", Color: 0x8E8E8E}, missing, {Shape: arrow, Name: "Run", Color: 0x3FA34D}]
  items = [{Name: "Math", Header: true}, {Name: "Add", Header: false}]
  lines = [[[1, "defn "], [2, "f"]], [], [[6, "x"]]]
  [ui.Panel("Title", rect, look), ui.Panel("Title", rect, look, active = true), ui.MenuBar(["File", "Edit"], "Name", rect, look), ui.ToolBar(tools, {X: 0, Y: 0}, rect, look),
    ui.Section("Name", rect, look), ui.Field("Words", rect, look), ui.Dropdown("Words", rect, look), ui.Slider(0.5, rect, look), ui.Slider(0.0, rect, look), ui.Checkbox(true, rect, look),
    ui.Checkbox(false, rect, look), ui.Swatch(0xD98F4E, "#D98F4E", rect, look), ui.List(items, 2, 40.0, rect, look), ui.Code(lines, 1, rect, look), ui.Grid(rect, look), ui.Nodes(two, 1, [link], look), ui.Links([link], two, look)]
end

isWidgetsGiveKnownKinds() = All(Map(isKnown, widgets(area)))
isWidgetsOfAnEmptyRectangle() = All(Map(isKnown, widgets(nothing)))
isWidgetsOfNothing() = Equal(ui.List([], 0, missing, area, look), []) and isKnown(ui.Nodes([], 0, [], look)) and isKnown(ui.Links([], [], look)) and isKnown(ui.Code([], 0, area, look)) and isKnown(ui.MenuBar([], "", area, look)) and isKnown(ui.ToolBar([], {X: 0, Y: 0}, area, look))

accents(commands) = Len(Filter(c -> c.Kind == "box" and c.Color == ui.Dark.Accent, commands))
isOnlyActivePanelHasAccent() = accents(ui.Panel("T", area, look, active = true)) == 1 and accents(ui.Panel("T", area, look)) == 0

boxes(commands) = Len(Filter(it.Kind == "box", commands))

defn isToolAnswersTheMouse()
  tools = [{Shape: arrow, Name: "Save", Color: 0x8E8E8E}]
  bar = {X: 0, Y: 0, Width: 300, Height: 32}
  boxes(ui.ToolBar(tools, {X: 15, Y: 15}, bar, look)) == 1 and boxes(ui.ToolBar(tools, {X: 250, Y: 15}, bar, look)) == 0
end

rings(commands) = Filter(c -> c.Kind == "ring" and c.Width == 10, commands)

defn isPinHollowWhenUnlinked()
  Len(rings(ui.Nodes(two, 0, [link], look))) == 1 and Len(rings(ui.Nodes(two, 0, [], look))) == 3
end

isNodeAtTakesTheTop() = ui.NodeAt({X: 70, Y: 50}, two) == 2 and ui.NodeAt({X: 25, Y: 25}, two) == 1 and ui.NodeAt({X: 250, Y: 150}, two) == 0
isNodeAtOfNothing() = ui.NodeAt({X: 0, Y: 0}, []) == 0

defn isMoveNodeStaysInside()
  moved = ui.MoveNode(1, {X: 5000, Y: 5000}, {X: 0, Y: 0}, area, two)
  moved[1].X + moved[1].Width <= 310 and moved[1].Y + ui.NodeHeight(moved[1]) <= 210
end

defn isMoveNodeLeavesNodesAlone()
  moved = ui.MoveNode(1, {X: 100, Y: 100}, {X: 10, Y: 10}, area, two)
  moved[1].X == 90 and moved[1].Y == 90 and two[1].X == 20 and moved[2].X == 60
end

defn isCodeCountsCodePoints()
  texts = Filter(it.Kind == "text", ui.Code([[[6, "é"], [1, "x"]]], 0, area, look))
  places = [c.X for c in Filter(it.Text != "1", texts)]
  places[2] - places[1] == 7
end

defn isSliderValueMeasured()
  wide = ui.Look(ui.Dark, (words, font) -> Len(words) * 7 + 3, 16)
  texts = Filter(it.Kind == "text", ui.Slider(0.1, area, wide))
  Last(texts).X + wide.Width(Last(texts).Text, "body") == area.X + area.Width - 9
end

isCodeFont() = All(Map(c -> c.Kind != "text" or c.Font == "code", ui.Code([[[6, "x"]]], 1, area, look)))
isOnlyCodeUsesIt() = All(Map(c -> c.Kind != "text" or fontIsNotCode(c), Flatten(withoutCode(widgets(area)))))

defn fontIsNotCode(c)
  match c
    {Font: font} -> font != "code"
    else -> true
  end
end

withoutCode(allWidgets) = [allWidgets[k] for k in 1:Len(allWidgets) if k != 14]

defn isOutputSitsUnderABody()
  withBody = {X: 0, Y: 0, Width: 100, Title: "T", Color: 0, Inputs: [], Outputs: [pin("O")], Body: 30}
  ui.OutputAt(withBody, 1).Y == 68.0 and ui.InputAt(nodeB, 1).Y == 78.0 and ui.OutputAt(withBody, 1).X == 100.0
end

defn isLinksAreOneCommand()
  drawn = ui.Links([link], two, look)
  Len(drawn) == 1 and Len(drawn[1].Items) == 1 and drawn[1].Items[1].X0 == 120.0
end

defn isHintIsFaint()
  hinted = Filter(it.Kind == "text", ui.Field("Search", area, look, hint = true))
  plain = Filter(it.Kind == "text", ui.Field("Search", area, look))
  hinted[1].Color == ui.Dark.Faint and plain[1].Color == ui.Dark.Ink
end

(* A slider stays inside its rectangle, whatever its value: its tick goes to both ends and follows the round corners. *)
zone = {X: 100, Y: 50, Width: 200, Height: 22}

defn sliderInside(value)
  shapes = Filter(it.Kind == "box" or it.Kind == "rect", ui.Slider(value, zone, look))
  All(Map(c -> c.X >= zone.X and c.Y >= zone.Y and c.X + c.Width <= zone.X + zone.Width and c.Y + c.Height <= zone.Y + zone.Height, shapes))
end

tickOf(value) = Filter(it.Kind == "rect" and it.Color == ui.Dark.Accent, ui.Slider(value, zone, look))[1]

(** The commands of the filled part, of any shape. *)
fillOf(value) = Filter((it.Kind == "rect" or it.Kind == "box") and it.Color == ui.Dark.Fill, ui.Slider(value, zone, look))

isSliderInsideAtZero() = sliderInside(0.0)
isSliderInsideAtOne() = sliderInside(1.0)
isSliderInsidePastOne() = sliderInside(1.5)
isSliderInsideBelowZero() = sliderInside(-0.5)
isTickReachesTheLeftEnd() = tickOf(0.0).X == zone.X
isTickReachesTheRightEnd() = tickOf(1.0).X + tickOf(1.0).Width == zone.X + zone.Width
isTickFollowsTheCorners() = tickOf(0.0).Y == zone.Y + 4 and tickOf(0.0).Height == zone.Height - 8
isTickMoves() = tickOf(0.2).X < tickOf(0.8).X
isNothingFilledAtZero() = Len(fillOf(0.0)) == 0
isALittleFilledShows() = Len(fillOf(0.01)) > 0 and Len(fillOf(0.02)) > 0 and Len(fillOf(0.03)) > 0
isSmallFillInside() = sliderInside(0.01) and sliderInside(0.02) and sliderInside(0.03)
isSmallFillFollowsTheCorner() = fillOf(0.02)[1].Y > zone.Y
isTickFullHeight() = tickOf(0.5).Y == zone.Y and tickOf(0.5).Height == zone.Height

