(* sparse.Solve on Poisson's matrices, against their closed forms, and on an arrow, whose full row AMD puts last. *)
use std/list
use std/math
use std/matrix
use std/result
use std/sparse

defn poisson(k)
  t = sparse.Diags([-1.0, 2.0, -1.0], [-1, 0, 1], k)
  sparse.Add(sparse.Kron(sparse.Eye(k), t), sparse.Kron(t, sparse.Eye(k)))
end

defn isPoisson1d()
  (** -u'' = 1 on n points: the second differences of i (n + 1 - i) / 2 are -1, exactly. *)
  n = 200
  x = result.Unwrap(sparse.Solve(sparse.Diags([-1.0, 2.0, -1.0], [-1, 0, 1], n), matrix.Ones(1, n)))
  math.Near(x, [i * (n + 1.0 - i) / 2.0 for i in 1..n], rel = 1e-12)
end

defn isPoisson2d()
  (** b an eigenvector of the 2-D Laplacian of k × k points, sin(p π i h) sin(q π j h), gives b / λ, with
      λ = 4 - 2 cos(p π h) - 2 cos(q π h), h = 1 / (k + 1). *)
  k = 24
  h = 1.0 / (k + 1)
  ok = true
  for pq in [[1, 1], [3, 7], [24, 2]]
    p = pq[1]
    q = pq[2]
    b = matrix.Zeros(1, k * k)
    for j in 1..k
      for i in 1..k
        b[(j - 1) * k + i] = math.Sin(p * math.Pi * i * h) * math.Sin(q * math.Pi * j * h)
      end
    end
    l = 4.0 - 2.0 * math.Cos(p * math.Pi * h) - 2.0 * math.Cos(q * math.Pi * h)
    ok = ok and math.Near(result.Unwrap(sparse.Solve(poisson(k), b)), b / l, abs = 1e-12)
  end
  ok
end

defn isArrow()
  (** A full first row and column: AMD puts that unknown last, so the factor stays as sparse as the matrix. *)
  n = 2000
  i = list.Concat([k for k in 1..n], list.Concat([1 for k in 2..n], [k for k in 2..n]))
  j = list.Concat([k for k in 1..n], list.Concat([k for k in 2..n], [1 for k in 2..n]))
  v = list.Concat([1.0 * n for k in 1..n], matrix.Ones(1, 2 * n - 2))
  a = sparse.Of(i, j, v, n, n)
  x = [1.0 + math.Mod(k, 3) for k in 1..n]
  math.Near(result.Unwrap(sparse.Solve(a, sparse.Mul(a, x))), x, rel = 1e-12)
end
