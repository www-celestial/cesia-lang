is_assignment() = assignment()
is_argument() = argument()
is_field() = field()
is_capture() = capture()
is_nested() = nested()
is_path() = nested_path()
is_for_copies() = for_copies()
is_return_keeps() = equal(build(3), [1.0, 1.0, 1.0])
is_destructure() = destructure() == 3

function assignment()
  a = [1, 2]
  b = a
  b[1] = 9
  a[1] == 1 and b[1] == 9
end
function touch(x)
  x[1] = 9
  x
end
function argument()
  a = [1, 2]
  b = touch(a)
  a[1] == 1 and b[1] == 9
end
function field()
  a = [1, 2]
  s = {v: a}
  a[1] = 9
  s.v[1] == 1
end
function capture()
  a = [1, 2]
  f = () -> a[1]
  a[1] = 9
  f() == 1
end
function nested()
  a = [[1, 2], [3, 4]]
  b = a
  b[1][1] = 9
  a[1][1] == 1 and b[1][1] == 9
end
function nested_path()
  s = {a: {b: [{c: 1}]}}
  t = s
  t.a.b[1].c = 2
  s.a.b[1].c == 1 and t.a.b[1].c == 2
end
function for_copies()
  xs = [1, 2, 3]
  seen = zeros(3)
  i = 1
  for v in xs
    xs[3] = 100
    seen[i] = v
    i += 1
  end
  equal(seen, [1.0, 2.0, 3.0])
end
function build(n)
  x = zeros(n)
  for i in 1:n
    x[i] = 1
  end
  x
end
function destructure()
  {a, b} = {a: 1, b: 2}
  [x, y] = [a, b]
  x + y
end

-- A native returning one of its inputs: the result must stay a logical copy.
function returns_sum()
  s = {a: 1}
  t = sum(s)
  t.a = 99
  s.a == 1 and t.a == 99
end
function returns_mean()
  s = {a: 1}
  t = mean(s)
  t.a = 99
  s.a == 1 and t.a == 99
end
function returns_min()
  s = {a: 1}
  t = min(s)
  t.a = 99
  s.a == 1 and t.a == 99
end
function returns_max()
  s = {a: 1}
  t = max(s)
  t.a = 99
  s.a == 1 and t.a == 99
end
function returns_transpose()
  s = {a: 1}
  t = transpose(s)
  t.a = 99
  s.a == 1 and t.a == 99
end
function returns_element()
  xs = [{a: 1}]
  t = sum(xs[1])
  t.a = 99
  xs[1].a == 1 and t.a == 99
end
is_native_returns_sum() = returns_sum()
is_native_returns_mean() = returns_mean()
is_native_returns_min() = returns_min()
is_native_returns_max() = returns_max()
is_native_returns_transpose() = returns_transpose()
is_native_returns_element() = returns_element()

-- Measuring a variable does not copy it: otherwise this loop would become quadratic.
function measure_keeps()
  x = zeros(2000)
  for i in 1:2000
    x[i] = length(x) + sum(x[1:1])
  end
  x[2000] == 4000
end
is_measuring_does_not_copy() = measure_keeps()
