use std/io

(* A comment
   on several lines. *)
io.Print(1)
(* on one line *) io.Print(2)
io.Print(3 (* in the middle *) + 4)
(* An outer comment (* with an inner one *)
   is still open here. *)
io.Print(8)
(**)
(***)
(** a documentation comment **)
io.Print(9)
(* a comment (* holds another *) and ends after it *)
io.Print(10)
io.Print("(* a text *)")
(* a quote " in a comment *) io.Print(11)
x = 1 + (* over
two lines *) 2
io.Print(x)
io.Print("a -- b (* c *) d")
io.Print(5 - -2)
