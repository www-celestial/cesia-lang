(* num.Solve against a slow sure Gaussian elimination, on generated systems kept away from singular ones; num.Dot, -x,
   math.Abs, list.Max and list.Min on arrays of floats, which take one pass in native code, against the rule cell by
   cell. *)
use std/test
use std/gen
use std/list
use std/num
use std/math
use std/matrix
use std/result
use std/value

defn eliminate(m, b)
  (** Gaussian elimination with partial pivoting, in plain Cesia: slow, but sure. *)
  n = value.Len(b)
  a = m
  x = b
  for k in 1..n
    p = k
    for i in k + 1..n
      if math.Abs(a[i, k]) > math.Abs(a[p, k])
        p = i
      end
    end
    for j in 1..n
      t = a[k, j]
      a[k, j] = a[p, j]
      a[p, j] = t
    end
    t = x[k]
    x[k] = x[p]
    x[p] = t
    for i in k + 1..n
      f = a[i, k] / a[k, k]
      for j in k..n
        a[i, j] = a[i, j] - f * a[k, j]
      end
      x[i] = x[i] - f * x[k]
    end
  end
  for k in 1..n
    i = n - k + 1
    s = x[i]
    for j in i + 1..n
      s = s - a[i, j] * x[j]
    end
    x[i] = s / a[i, i]
  end
  x
end

(* A system whose diagonal outweighs the rest of its row: never singular. *)
defn system(cells)
  m = matrix.Reshape([3, 3], cells.M)
  for i in 1..3
    m[i, i] = m[i, i] + 40.0
  end
  {M: m, B: cells.B}
end
cells = gen.Map(system, gen.Of({M: gen.List(gen.Float(-10, 10), min = 9, max = 9), B: gen.List(gen.Float(-10, 10), min = 3, max = 3)}))

isSolveAsElimination() = test.ForAll(s -> math.Near(result.Unwrap(num.Solve(s.M, s.B)), eliminate(s.M, s.B), rel = 1e-9, abs = 1e-12), cells)
isSolveSolves() = test.ForAll(s -> math.Near(matrix.Matmul(s.M, matrix.Reshape([3, 1], result.Unwrap(num.Solve(s.M, s.B)))), matrix.Reshape([3, 1], s.B), abs = 1e-9), cells)

(* Two arrays of floats of one length, from 1 to 40, with the infinities, NaN and -0.0 among them. *)
floatPairs = gen.Map(ps -> {A: [p.A for p in ps] * 1.0, B: [p.B for p in ps] * 1.0},
  gen.List(gen.Of({A: gen.Float(-1e6, 1e6, special = true), B: gen.Float(-1e6, 1e6, special = true)}), min = 1, max = 40))
same(a, b) = value.Equal(a, b) or a != a and b != b   (** equal, or both NaN *)
largest(xs) = list.Reduce((m, v) -> if v > m v else m end, xs[1], xs)
smallest(xs) = list.Reduce((m, v) -> if v < m v else m end, xs[1], xs)

isDotAsSum() = test.ForAll(p -> same(num.Dot(p.A, p.B), list.Sum(p.A * p.B)), floatPairs)
isNegAsCells() = test.ForAll(p -> value.Equal(-p.A, [-v for v in p.A] * 1.0), floatPairs)
isAbsAsCells() = test.ForAll(p -> value.Equal(math.Abs(p.A), [math.Abs(v) for v in p.A] * 1.0), floatPairs)
isMaxAsCells() = test.ForAll(p -> same(list.Max(p.A), largest(p.A)) and same(list.Min(p.A), smallest(p.A)), floatPairs)

defn isDotPastOneBlock()
  (** Past 65,536 cells the sums go by blocks: num.Dot keeps their order. *)
  a = matrix.Zeros(70001) + 0.1
  b = matrix.Zeros(70001) + 0.3
  for k in 1..70001
    a[k] = 1.0 / k
  end
  num.Dot(a, b) == list.Sum(a * b) and num.Dot([1, 2], [3, 4]) == 11
end
