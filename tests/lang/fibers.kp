add(a, b) = a + b
defn wait_twice()
  t = spawn(() -> 1)
  wait(t) == wait(t)
end
defn copied()
  a = [1, 2]
  t = spawn(() -> a[1])
  a[1] = 9
  wait(t) == Ok(1)
end
is_wait_value() = wait(spawn(() -> add(1, 2))) == Ok(3)
is_wait_twice() = wait_twice()
is_panic_is_err() = is_err(wait(spawn(() -> panic("x"))))
is_panic_message() = (wait(spawn(() -> panic("x"))) then map_err(it.message)) == Err("x")
is_type_panic() = (wait(spawn(() -> 1 + "a")) then map_err(it.kind)) == Err("type")
is_value_copied() = copied()
is_wait_not_a_task() = is_err(wait(spawn(() -> wait(1))))
is_spawn_in_spawn() = wait(spawn(() -> wait(spawn(() -> 1)))) == Ok(Ok(1))

half(x) = Ok(div(x, 2))
count_down(n) = if n == 0 0 else 0 + count_down(n - 1) end
is_pmap() = equal([1, 2, 3] then pmap(it * 2), [2, 4, 6])
is_pmap_empty() = equal([] then pmap(it * 2), [])
is_pmap_collect() = equal([2, 4] then pmap(half) then collect, Ok([1, 2]))
is_pmap_panics() = is_err(wait(spawn(() -> pmap(x -> panic("x"), [1]))))
is_many_fibers() = length(pmap(it + 1, 1:10000)) == 10000
is_deep_in_fiber() = wait(spawn(() -> count_down(5000))) == Ok(0)
