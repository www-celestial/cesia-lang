]
isEachError() = list.All([message(e[1]) == e[2] for e in errors])
isErrorKind() = value.Equal(result.MapErr(e -> e.Kind, plot.Svg(plot.Line([], []))), result.Err("plot"))
message0(r) = match r
  result.Err(e) -> e.Message
  else -> "no error"
end
isSceneErrors() = message0(plot.Scene(1, 640, 400)) == "plot.Scene needs a graph, as plot.Line or plot.Of makes, not 1." and message0(plot.Scene(plot.Line([1], [1]), 50, 400)) == "plot.Scene needs at least 100 by 80 pixels, not 50 by 400."
isFrameErrors() = message0(plot.Scene(anim, 640, 400, frame = 4)) == "plot.Scene: frame is 4; this animation has frames 1 to 3." and message0(plot.Scene(anim, 640, 400, frame = 1.0)) == "plot.Scene: frame is 1.0; this animation has frames 1 to 3." and message0(plot.Scene(plot.Line([1], [1]), 640, 400, frame = 2)) == "plot.Scene: frame is 2; a graph that is no animation has frame 1 only." and message0(plot.Scene(plot.Frames([]), 640, 400)) == "plot.Frames needs 1 to 300 graphs, not 0."
isViewErrors() = message0(plot.Scene(plot.Line([1], [1]), 640, 400, view = [1, 2])) == "plot.Scene: view turns a 3D graph, of plot.Surface or plot.Line3; this graph is 2D." and message0(plot.Scene(plot.Surface([1, 2; 3, 4]), 640, 400, view = [1, 200])) == "plot.Scene: view is [1, 200]; give [az, el] in degrees, el from -90 to 90." and message0(plot.Scene(plot.Grid([plot.Surface([1, 2; 3, 4])]), 640, 400, view = [1, 2])) == "plot.Scene: view turns one 3D graph; a grid shows each of its graphs at the view of their code." and message0(plot.Scene(waves, 640, 400, view = [1, 2])) == "plot.Scene: view turns one 3D graph; an animation shows its frames at the view of their code."
isSaveNeedsSvg() = message0(plot.Save(plot.Line([1], [1]), "a.png")) == "plot.Save writes SVG, to a name that ends in .svg, not \"a.png\"."
isDropped() = scene(plot.Points([1, math.Nan, 3], [1, 2, missing]), 640, 400).Dropped == 2

(* Past one cell per pixel, cells merge by their mean: by matrix products without NaN, by a loop with one. Both give the
   same colors, but for the block that holds the NaN, which is neither the least value nor the greatest. *)
defn isMergeWaysAgree()
  m = matrix.Zeros(9, 3001)
  for i in 1..9
    for j in 1..3001
      m[i, j] = j * 1.0 + i
    end
  end
  full = role(scene(plot.Heatmap(m), 640, 400), "data")[1]
  m[5, 1500] = math.Nan
  holed = role(scene(plot.Heatmap(m), 640, 400), "data")[1]
  n = value.Len(full.Colors)
  n > 1 and n < 3001 * 9 and n == value.Len(holed.Colors) and list.Count(k -> full.Colors[k] != holed.Colors[k], 1..n) <= 1
end

(* A long line seen through a narrow xlim: M4 groups the points left and right of the plot, so the work and the scene
   stay as small as the plot, and the part inside is drawn as before. *)
defn isM4PastXlim()
  n = 200000
  t = [i * 1.0 for i in 1..n]
  v = math.Sin(t * 0.001)
  s = scene(plot.Of([plot.Line(t, v)], xlim = [100000, 100010], ylim = [-1.5, 1.5]), 640, 400)
  kept = role(s, "data")
  list.Sum([value.Len(l.Xs) for l in kept]) < 4 * 700
end
