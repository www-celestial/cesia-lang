use std/cesia
use std/text

(* The places of the documentation, read by Doc: inside a block, at the end of a line, on parameters. *)

defn Halved(x)
  (** Half of a number, documented inside its block.

        Halved(4) --> 2.0 *)
  x / 2
end

Tripled(x) = 3 * x   (** Three times a number. *)

defn Grown(
  r,    (** the number to grow *)
  by    (** how many times larger *)
)       (** the larger number *)
  (** A number larger by some factor. *)
  r * by
end

(** Above a block, this documents nothing. *)
defn Above(x)
  x
end

isDocInsideABlock() = text.StartsWith("Halved(x)\n\nHalf of a number, documented inside its block.", cesia.Doc(Halved))
isDocExampleInsideABlock() = text.Contains("  Halved(4) --> 2.0", cesia.Doc(Halved))
isDocAtTheEndOfALine() = cesia.Doc(Tripled) == "Tripled(x)\n\nThree times a number."
isDocListsTheParts() = text.EndsWith("\n\n  r       the number to grow\n  by      how many times larger\n  result  the larger number", cesia.Doc(Grown))
isDocAboveABlockIsNone() = cesia.Doc(Above) == "Above(x)"
