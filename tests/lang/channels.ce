(** Channels between fibers: order, senders, waiting receivers and timeouts. *)
use sys

defn isChannelKeepsOrder()
  ch = Channel()
  for k in 1:5
    Send(k, ch)
  end
  Equal([Receive(ch)? for k in 1:5], [1, 2, 3, 4, 5])
end

defn isChannelManySenders()
  ch = Channel()
  tasks = [Spawn(() -> Send(k, ch)) for k in 1:20]
  for t in tasks
    Wait(t)
  end
  Equal(Sort([Receive(ch)? for k in 1:20]), [k for k in 1:20])
end

defn isChannelReceiveWaits()
  ch = Channel()
  reader = Spawn(() -> Receive(ch)? * 2)
  sys.Sleep(0.01)
  Send(21, ch)
  Wait(reader) == Ok(42)
end

isChannelTimeout() = (Receive(Channel(), timeout = 0.02) then MapErr(it.Kind)) == Err("timeout")

defn isChannelTimeoutZeroNeverWaits()
  ch = Channel()
  first = Receive(ch, timeout = 0) then MapErr(it.Kind)
  Send("a", ch)
  first == Err("timeout") and Receive(ch, timeout = 0) == Ok("a")
end

defn later(x, ch)
  sys.Sleep(0.01)
  Send(x, ch)
end

defn isChannelValueBeforeTimeout()
  ch = Channel()
  Spawn(() -> later("late", ch))
  Receive(ch, timeout = 0.5) == Ok("late")
end

defn isChannelTwoReceivers()
  ch = Channel()
  a = Spawn(() -> Receive(ch)?)
  b = Spawn(() -> Receive(ch)?)
  sys.Sleep(0.01)
  Send(1, ch)
  Send(2, ch)
  Equal(Sort([Wait(a)?, Wait(b)?]), [1, 2])
end

defn isChannelWokenReceiverKeepsItsPlace()
  (** A receiver woken whose value another took parks again first, before the one that came after it. *)
  ch = Channel()
  a = Spawn(() -> Receive(ch)?)
  sys.Sleep(0.001)
  b = Spawn(() -> Receive(ch)?)
  sys.Sleep(0.001)
  Send(1, ch)
  stolen = Receive(ch, timeout = 0)
  sys.Sleep(0.001)
  Send(2, ch)
  sys.Sleep(0.001)
  Send(3, ch)
  stolen == Ok(1) and Wait(a) == Ok(2) and Wait(b) == Ok(3)
end

isWaitNeedsATask() = not IsOk(Wait(Spawn(() -> Wait(Channel()))))
