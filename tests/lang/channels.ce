(** Channels between fibers: order, senders, waiting receivers and timeouts. *)
use std/sys
use std/fiber
use std/list
use std/result
use std/value

defn isChannelKeepsOrder()
  ch = fiber.Channel()
  for k in 1..5
    fiber.Send(k, ch)
  end
  value.Equal([fiber.Receive(ch)? for k in 1..5], [1, 2, 3, 4, 5])
end

defn isChannelManySenders()
  ch = fiber.Channel()
  tasks = [fiber.Spawn(() -> fiber.Send(k, ch)) for k in 1..20]
  for t in tasks
    fiber.Wait(t)
  end
  value.Equal(list.Sort([fiber.Receive(ch)? for k in 1..20]), [k for k in 1..20])
end

defn isChannelReceiveWaits()
  ch = fiber.Channel()
  reader = fiber.Spawn(() -> fiber.Receive(ch)? * 2)
  sys.Sleep(0.01)
  fiber.Send(21, ch)
  fiber.Wait(reader) == result.Ok(42)
end

isChannelTimeout() = (fiber.Receive(fiber.Channel(), timeout = 0.02) then result.MapErr(it.Kind)) == result.Err("timeout")

defn isChannelTimeoutZeroNeverWaits()
  ch = fiber.Channel()
  first = fiber.Receive(ch, timeout = 0) then result.MapErr(it.Kind)
  fiber.Send("a", ch)
  first == result.Err("timeout") and fiber.Receive(ch, timeout = 0) == result.Ok("a")
end

defn later(x, ch)
  sys.Sleep(0.01)
  fiber.Send(x, ch)
end

defn isChannelValueBeforeTimeout()
  ch = fiber.Channel()
  fiber.Spawn(() -> later("late", ch))
  fiber.Receive(ch, timeout = 0.5) == result.Ok("late")
end

defn isChannelTwoReceivers()
  ch = fiber.Channel()
  a = fiber.Spawn(() -> fiber.Receive(ch)?)
  b = fiber.Spawn(() -> fiber.Receive(ch)?)
  sys.Sleep(0.01)
  fiber.Send(1, ch)
  fiber.Send(2, ch)
  value.Equal(list.Sort([fiber.Wait(a)?, fiber.Wait(b)?]), [1, 2])
end

defn isChannelWokenReceiverKeepsItsPlace()
  (** A receiver woken whose value another took parks again first, before the one that came after it. *)
  ch = fiber.Channel()
  a = fiber.Spawn(() -> fiber.Receive(ch)?)
  sys.Sleep(0.001)
  b = fiber.Spawn(() -> fiber.Receive(ch)?)
  sys.Sleep(0.001)
  fiber.Send(1, ch)
  stolen = fiber.Receive(ch, timeout = 0)
  sys.Sleep(0.001)
  fiber.Send(2, ch)
  sys.Sleep(0.001)
  fiber.Send(3, ch)
  stolen == result.Ok(1) and fiber.Wait(a) == result.Ok(2) and fiber.Wait(b) == result.Ok(3)
end

isWaitNeedsATask() = not result.IsOk(fiber.Wait(fiber.Spawn(() -> fiber.Wait(fiber.Channel()))))
