(** Interfaces and their methods, for the tests of a use. *)
use tests/lang/mods/far

interface Measured { Area() }   (** Something measured by its area. *)

interface sided
  Side()
end

(m Measured) Double() = 2 * m.Area()   (** Twice the area of what is measured. *)

(m Measured) Label() = "measured"   (** What is measured, by geo. *)

(m Measured) Shown() = m.half() + 1   (** Half the area, and one. *)

(m Measured) half() = m.Area() / 2

(s sided) Sides() = 4 * s.Side()   (** Four times the side. *)

struct Rect { Width, Height }   (** A rectangle of geo. *)

(r Rect) Area() = r.Width * r.Height   (** The area of a rectangle. *)

(r Rect) Side() = r.Width   (** The width. *)

MakeRect(width, height) = Rect(width, height)   (** A rectangle. *)

Total(m Measured) = m.Area()   (** The area of what is measured. *)

Extra(x) = x.Extra()   (** A method of an interface of far, which geo uses. *)
