(** Shapes, for the test of cesia doc on interfaces. *)

interface Shape
  (** Something with an area and a perimeter.

        total(Square(2)) --> 12 *)
  Area()
  (* Not a definition: Wheels(4) = 4 *)
Perimeter()
end

interface Named { Name() }   (** Something with a name. *)

struct Square { Side }   (** A square. *)

(s Square) Area() = s.Side * s.Side   (** The area of a square. *)

(s Square) Perimeter() = 4 * s.Side   (** The perimeter of a square. *)

(** What a shape is.

      Square(1).Describe() --> "area 1, perimeter 4" *)
(s Shape) Describe() = "area $(s.Area()), perimeter $(s.Perimeter())"

total(s Shape) = s.Area() + s.Perimeter()
