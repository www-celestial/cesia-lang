(** A date, for the test of cesia doc on methods. *)
struct Date { Year }
struct piece { Size }

Date.Parse(text) = Date(1)   (** A date from its text. *)

(** The next year.

      Date(1).Next().Year --> 2 *)
(d Date) Next() = Date(d.Year + 1)

(d Date) hidden() = d.Year
(p piece) Size2() = p.Size
