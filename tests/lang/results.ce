use std/math
use std/result
use std/value

half(x) = if math.Mod(x, 2) == 0 result.Ok(math.Div(x, 2)) else result.Err("odd") end

isValue() = result.Ok(1).Value == 1
isEqual() = result.Ok(1) == result.Ok(1) and result.Ok(1) != result.Err(1)
isAndThen() = (half(8) then result.AndThen(half)) == result.Ok(2)
isAndThenErr() = (half(3) then result.AndThen(half)) == result.Err("odd")
isMapOk() = (half(8) then result.MapOk(it + 1)) == result.Ok(5)
isMapErr() = (half(3) then result.MapErr(x -> "$(x)!")) == result.Err("odd!")
isUnwrapOr() = (half(3) then result.UnwrapOr(0)) == 0
isUnwrap() = result.Unwrap(result.Ok(1)) == 1
isKinds() = result.IsOk(result.Ok(1)) and result.IsErr(result.Err(1)) and not result.IsOk(result.Err(1))
isCollect() = value.Equal(result.Collect([result.Ok(1), result.Ok(2)]), result.Ok([1, 2]))
isCollectFirstErr() = result.Collect([result.Ok(1), result.Err("a"), result.Err("b")]) == result.Err("a")
isCollectEmpty() = value.Equal(result.Collect([]), result.Ok([]))

defn quarter(x)
  a = half(x)?
  b = half(a)?
  result.Ok(b)
end
defn chain()
  half(half(8)?)
end
defn inLoop()
  for i in 1..3
    half(i)?
  end
  result.Ok("done")
end
isQuestion() = quarter(8) == result.Ok(2)
isQuestionPropagates() = quarter(6) == result.Err("odd")
isQuestionInLambda() = (x -> result.Ok(half(x)? + 1))(4) == result.Ok(3)
isQuestionChain() = chain() == result.Ok(2)
isQuestionInLoop() = inLoop() == result.Err("odd")
