is_mul_elements() = equal([1, 2] * [3, 4], [3, 8])
is_scalar() = equal([1.0, 2.0] * 2, [2.0, 4.0]) and equal(2 + [1, 2], [3, 4])
is_mask() = equal([1, 2, 3] > 1, [false, true, true])
is_count_mask() = sum([1, 2, 3] > 1) == 2
is_mask_missing() = any([missing, true]) and not all([missing, true])
is_matmul() = equal(matmul([1 2; 3 4], [1; 1]), [3.0; 7.0])
is_transpose() = equal(transpose([1, 2]), [1; 2])
is_reshape() = equal(reshape([1, 2, 3, 4], 2, 2), [1 3; 2 4])
is_sqrt_array() = equal(sqrt([4.0, 9.0]), [2.0, 3.0])
is_min_one() = min([3, 1, 2]) == 1
is_max_two() = equal(max([1, 5], [4, 2]), [4, 5])
is_sum_int() = is_int(sum([1, 2]))
is_mean() = mean([1, 2]) == 1.5
is_sum_missing() = is_missing(sum([1, missing]))
