use json
use tests/errors/priv/fields as f

(* One map, whatever way it is built: a literal, Dict, json, grown by names or by a variable, past 16 keys. *)
literal() = {Name: "Ana", Age: 30}
texts() = {"Name": "Ana", "Age": 30}
pairs() = Dict([{Key: "Name", Value: "Ana"}, {Key: "Age", Value: 30}])
parsed() = Unwrap(json.Parse("{""Name"": ""Ana"", ""Age"": 30}"))

defn grown()
  m = {}
  m.Name = "Ana"
  m["Age"] = 30
  m
end

defn byVariable()
  m = Dict()
  for k in ["Name", "Age"]
    m[k] = if k == "Name" "Ana" else 30 end
  end
  m
end

all() = [literal(), texts(), pairs(), parsed(), grown(), byVariable()]
same(f) = All([Equal(f(m), f(literal())) for m in all()])

isOneKind() = All([m == literal() and IsDict(m) and not IsStruct(m) for m in all()])
isSameKeys() = same(Keys) and Equal(Keys(literal()), ["Name", "Age"])
isSameValues() = same(Values) and Equal(Values(literal()), ["Ana", 30])
isSameText() = same(Text) and Text(literal()) == "{Name: ""Ana"", Age: 30}"
isSameJson() = same(json.Text) and json.Text(literal()) == "{""Name"":""Ana"",""Age"":30}"
isDotIsIndex() = All([m.Name == m["Name"] and m.Age == 30 for m in all()])
isGetHas() = All([Get("Age", m) == 30 and Has("Name", m) and not Has("City", m) and IsMissing(Get("City", m)) for m in all()])
isLen() = All([Len(m) == 2 for m in all()])
isIn() = All(["Name" in m and not ("City" in m) for m in all()])
isPattern() = All([(match m
  {Name: n} -> n
  else -> "no"
end) == "Ana" for m in all()])

defn isDestructure()
  {Age: a} = parsed()
  a == 30
end

(* Keys keep the order of insertion. *)
isLiteralOrder() = Equal(Keys({B: 1, A: 2, C: 3}), ["B", "A", "C"]) and Equal(Keys({"b": 1, 2: 2, "a": 3}), ["b", 2, "a"])
isPutOrder() = Equal(Keys(Put("A", 1, Put("Z", 1, Dict()))), ["Z", "A"]) and Equal(Keys(Put("C", 3, {B: 1, A: 2})), ["B", "A", "C"])
isJsonOrder() = Equal(Keys(Unwrap(json.Parse("{""z"": 1, ""a"": 2, ""m"": 3}"))), ["z", "a", "m"])
isRewriteKeepsPlace() = Equal(Keys(Put("B", 9, {B: 1, A: 2})), ["B", "A"]) and Equal(Keys(Put("Z", 9, Put("A", 1, Put("Z", 1, Dict())))), ["Z", "A"])
isDropThenPutGoesLast() = Equal(Keys(Put("B", 1, Drop("B", {B: 1, A: 2}))), ["A", "B"])
isEqualWithoutOrder() = {A: 1, B: 2} == {B: 2, A: 1} and Put("A", 1, Put("B", 2, Dict())) == {A: 1, B: 2} and {A: 1} != {A: 1, B: 2}

defn isOrderAfterSwitch()
  m = {B: 1, A: 2}
  k = "C"
  m[k] = 3
  Equal(Keys(m), ["B", "A", "C"]) and Equal(Values(m), [1, 2, 3])
end

defn isManyKeys()
  m = {}
  for i in 1:40
    m["k$(i)"] = i
  end
  Len(m) == 40 and Keys(m)[1] == "k1" and Keys(m)[40] == "k40" and m.k17 == 17
end

defn isGrowPastSixteen()
  m = {A: 1, B: 2, C: 3, D: 4, E: 5, F: 6, G: 7, H: 8, I: 9, J: 10, K: 11, L: 12, M: 13, N: 14, O: 15, P: 16}
  m.Q = 17
  m.R = 18
  Len(m) == 18 and m.Q == 17 and Keys(m)[17] == "Q" and Keys(m)[1] == "A"
end

isBigLiteral() = Keys({A: 1, B: 2, C: 3, D: 4, E: 5, F: 6, G: 7, H: 8, I: 9, J: 10, K: 11, L: 12, M: 13, N: 14, O: 15, P: 16, Q: 17})[17] == "Q"

defn isDropMany()
  m = Dict()
  for i in 1:20
    m[i] = i
  end
  for i in 1:15
    m = Drop(i, m)
  end
  Equal(Keys(m), [16, 17, 18, 19, 20]) and Equal(Keys(Put(1, 0, m)), [16, 17, 18, 19, 20, 1])
end

(* Keys are data: any first letter, from any package. *)
isSmallKeys() = parsed().Name == "Ana" and Unwrap(json.Parse("{""name"": 1}")).name == 1 and f.Record().size == 1
isProtoIsAKey() = Equal(Keys({"__proto__": 1, "constructor": 2}), ["__proto__", "constructor"])
isStructNoMap() = IsStruct(Ok(1)) and not IsDict(Ok(1))
isMapOfStructFails() = stop(() -> Keys(Ok(1))) == "type: Keys needs a dictionary, not an Ok."
isMissingKey() = stop(() -> literal().City) == "index: This dictionary has no key: the text ""City""." and stop(() -> parsed().City) == "index: This dictionary has no key: the text ""City""."

defn isMerge()
  Equal(Keys(Merge({A: 1, B: 2}, {C: 3, A: 4})), ["A", "B", "C"]) and Merge({A: 1, B: 2}, {C: 3, A: 4}).A == 4
end

stop(f) = match Wait(Spawn(f))   (** What a call that stops says: its kind and its message. *)
  Err(e) -> "$(e.Kind): $(e.Message)"
  Ok(v) -> v
end

(* Structs and maps: From, Fields, json.Text. *)
struct User { Id Int, Name Text, secret Text = "s", Age Int = 0 }
(u User) Greeting() = "Bonjour $(u.Name)"

isFrom() = Unwrap(User.From({Id: 1, Name: "Ana"})) == User(1, "Ana") and Unwrap(User.From(parsed() then Put("Id", 2, it) then Drop("Age", it))).Name == "Ana"
isFromJson() = Unwrap(User.From(Unwrap(json.Parse("{""Id"": 7, ""Name"": ""Bo""}")))).Greeting() == "Bonjour Bo"
isFromDefaults() = Unwrap(User.From({Id: 1, Name: "Ana"})).Age == 0 and Unwrap(User.From({Id: 1, Name: "Ana", Age: 3})).Age == 3
isFromExcess() = MapErr(it.Message, User.From({Id: 1, Name: "Ana", Admin: true})) == Err("User has no field ""Admin"".")
isFromMissing() = MapErr(it.Message, User.From({Id: 1})) == Err("User needs the field ""Name"".")
isFromWrongType() = MapErr(it.Message, User.From({Id: "1", Name: "Ana"})) == Err("User: Id must be an Int, found a Text.") and IsErr(User.From(Put(3, 4, {Id: 1, Name: "Ana"})))
isFromKind() = MapErr(it.Kind, User.From({})) == Err("field")
isFromSmallInside() = Unwrap(User.From({Id: 1, Name: "Ana", secret: "x"})).secret == "x"
isFromSmallOutside() = MapErr(it.Message, f.Secret.From({key: "k", Label: "l"})) == Err("Secret has no field ""key"".") and MapErr(it.Message, f.Secret.From({Label: "l"})) == Err("Secret needs a field that is private to its package.")
isFromAsValue() = Equal(Map(it.Value.Id, Map(User.From, [{Id: 1, Name: "a"}, {Id: 2, Name: "b"}])), [1, 2])
isFromNoMap() = stop(() -> User.From(3)) == "type: User.From needs a dictionary, not the number 3."
isFields() = Fields(User(1, "Ana")) == {Id: 1, Name: "Ana", secret: "s", Age: 0} and Equal(Keys(Fields(User(1, "Ana"))), ["Id", "Name", "secret", "Age"])
isFieldsOutside() = Fields(f.New()) == {Label: "public"}
isFieldsRoundTrip() = Unwrap(User.From(Fields(User(1, "Ana", Age = 4)))) == User(1, "Ana", Age = 4)
isFieldsNoMap() = stop(() -> Fields({A: 1})) == "type: Fields needs a struct, not a dictionary."
isJsonOfStruct() = json.Text(User(1, "Ana")) == "{""Id"":1,""Name"":""Ana"",""Age"":0}" and json.Text(f.New()) == "{""Label"":""public""}"
isMapFunctionsRefuseStructs() = stop(() -> Values(Ok(1))) == "type: Values needs a dictionary, not an Ok." and stop(() -> Put("A", 1, Ok(1))) == "type: Put needs a dictionary, not an Ok."

(* A new map from another one holds the same values: a write through the old one must not show in the new one. *)
defn isPutCopies()
  m = {A: [1, 2], B: 1}
  added = Put("C", 1, m)
  kept = Put("B", 2, m)
  dropped = Drop("B", m)
  m.A[1] = 99
  Equal(added.A, [1, 2]) and Equal(kept.A, [1, 2]) and Equal(dropped.A, [1, 2])
end

(* A map meets an interface whatever its storage: by a literal, by a variable key, past 16 keys, after Drop. *)
interface Labelled { Label() }
(x Labelled) Shout() = Upper(x.Label())
labelOf(x Labelled) = x.Label()
defn treeOf(n)
  m = Dict()
  k = "Label"
  m[k] = () -> n
  m
end
defn isTreeMeetsInterface()
  big = treeOf("big")
  for i in 1:20
    big["k$(i)"] = i
  end
  labelOf(treeOf("t")) == "t" and treeOf("t").Shout() == "T" and labelOf(big) == "big" and labelOf(Drop("x", {Label: () -> "d", x: 1})) == "d"
end
isTreeLacksInterface() = stop(() -> labelOf(Put(1, 2, {Label: 3}))) == "type: labelOf: x must be a Labelled, found a Dict, which has no Label()."

(* One storage at every size: a map grows by one block, then by more of the same kind, and the program sees none of it. *)
defn sized(n)
  m = Dict()
  for i in 1:n
    m["k$(i)"] = i
  end
  m
end

defn sameAtSize(n)
  m = sized(n)
  p = Put("k1", 0, m)
  d = Drop("k1", m)
  back = Put("k1", 9, d)
  full = n == 0 or (m["k1"] == 1 and m["k$(n)"] == n and Keys(m)[n] == "k$(n)" and Values(m)[1] == 1 and p["k1"] == 0 and Keys(p)[1] == "k1")
  dropped = Len(d) == (if n == 0 0 else n - 1 end) and not Has("k1", d) and (n < 2 or Keys(d)[1] == "k2")
  last = n == 0 or Keys(back)[n] == "k1"
  Len(m) == n and full and dropped and last and m == sized(n) and Unwrap(json.Parse(json.Text(m))) == m
end

isEverySize() = All([sameAtSize(n) for n in [0, 1, 31, 32, 33, 1000, 100000]])

(* m = Put(k, x, m) writes in place, but never through another name. *)
defn isPutOnItself()
  a = sized(40)
  b = a
  b = Put("k1", 0, b)
  c = {A: 1}
  d = c
  d = Put("B", 2, d)
  a["k1"] == 1 and b["k1"] == 0 and c == {A: 1} and d == {A: 1, B: 2}
end

defn isSharedDeepKept()
  a = sized(100)
  b = a
  b["k5"] = 0
  b["new"] = 1
  a["k5"] == 5 and not Has("new", a) and b["k5"] == 0 and Len(b) == 101 and Keys(b)[101] == "new"
end

(* Keys from one place shared by maps of other sizes: each map sees its own keys only. *)
defn isGrownApart()
  a = {A: 1}
  b = a
  a.B = 2
  b.C = 3
  a.D = 4
  Equal(Keys(a), ["A", "B", "D"]) and Equal(Keys(b), ["A", "C"]) and b.C == 3 and not Has("B", b) and a.D == 4
end
