use std/json
use tests/errors/priv/fields as f
use std/dict
use std/fiber
use std/list
use std/result
use std/text
use std/value

(* One map, whatever way it is built: a literal, Dict, json, grown by names or by a variable, past 16 keys. *)
literal() = {Name: "Ana", Age: 30}
texts() = {"Name": "Ana", "Age": 30}
pairs() = dict.Dict([{Key: "Name", Value: "Ana"}, {Key: "Age", Value: 30}])
parsed() = result.Unwrap(json.Parse("{\"Name\": \"Ana\", \"Age\": 30}"))

defn grown()
  m = {}
  m.Name = "Ana"
  m["Age"] = 30
  m
end

defn byVariable()
  m = dict.Dict()
  for k in ["Name", "Age"]
    m[k] = if k == "Name" "Ana" else 30 end
  end
  m
end

all() = [literal(), texts(), pairs(), parsed(), grown(), byVariable()]
same(f) = list.All([value.Equal(f(m), f(literal())) for m in all()])

isOneKind() = list.All([m == literal() and value.IsDict(m) and not value.IsStruct(m) for m in all()])
isSameKeys() = same(dict.Keys) and value.Equal(dict.Keys(literal()), ["Name", "Age"])
isSameValues() = same(dict.Values) and value.Equal(dict.Values(literal()), ["Ana", 30])
isSameText() = same(value.Text) and value.Text(literal()) == "{Name: \"Ana\", Age: 30}"
isSameJson() = same(json.Text) and json.Text(literal()) == "{\"Name\":\"Ana\",\"Age\":30}"
isDotIsIndex() = list.All([m.Name == m["Name"] and m.Age == 30 for m in all()])
isGetHas() = list.All([dict.Get("Age", m) == 30 and dict.Has("Name", m) and not dict.Has("City", m) and value.IsMissing(dict.Get("City", m)) for m in all()])
isLen() = list.All([value.Len(m) == 2 for m in all()])
isIn() = list.All(["Name" in m and not ("City" in m) for m in all()])
isPattern() = list.All([(match m
  {Name: n} -> n
  else -> "no"
end) == "Ana" for m in all()])

defn isDestructure()
  {Age: a} = parsed()
  a == 30
end

(* Keys keep the order of insertion. *)
isLiteralOrder() = value.Equal(dict.Keys({B: 1, A: 2, C: 3}), ["B", "A", "C"]) and value.Equal(dict.Keys({"b": 1, 2: 2, "a": 3}), ["b", 2, "a"])
isPutOrder() = value.Equal(dict.Keys(dict.Put("A", 1, dict.Put("Z", 1, dict.Dict()))), ["Z", "A"]) and value.Equal(dict.Keys(dict.Put("C", 3, {B: 1, A: 2})), ["B", "A", "C"])
isJsonOrder() = value.Equal(dict.Keys(result.Unwrap(json.Parse("{\"z\": 1, \"a\": 2, \"m\": 3}"))), ["z", "a", "m"])
isRewriteKeepsPlace() = value.Equal(dict.Keys(dict.Put("B", 9, {B: 1, A: 2})), ["B", "A"]) and value.Equal(dict.Keys(dict.Put("Z", 9, dict.Put("A", 1, dict.Put("Z", 1, dict.Dict())))), ["Z", "A"])
isDropThenPutGoesLast() = value.Equal(dict.Keys(dict.Put("B", 1, dict.Drop("B", {B: 1, A: 2}))), ["A", "B"])
isEqualWithoutOrder() = {A: 1, B: 2} == {B: 2, A: 1} and dict.Put("A", 1, dict.Put("B", 2, dict.Dict())) == {A: 1, B: 2} and {A: 1} != {A: 1, B: 2}

defn isOrderAfterSwitch()
  m = {B: 1, A: 2}
  k = "C"
  m[k] = 3
  value.Equal(dict.Keys(m), ["B", "A", "C"]) and value.Equal(dict.Values(m), [1, 2, 3])
end

defn isManyKeys()
  m = {}
  for i in 1..40
    m["k$(i)"] = i
  end
  value.Len(m) == 40 and dict.Keys(m)[1] == "k1" and dict.Keys(m)[40] == "k40" and m.k17 == 17
end

defn isGrowPastSixteen()
  m = {A: 1, B: 2, C: 3, D: 4, E: 5, F: 6, G: 7, H: 8, I: 9, J: 10, K: 11, L: 12, M: 13, N: 14, O: 15, P: 16}
  m.Q = 17
  m.R = 18
  value.Len(m) == 18 and m.Q == 17 and dict.Keys(m)[17] == "Q" and dict.Keys(m)[1] == "A"
end

isBigLiteral() = dict.Keys({A: 1, B: 2, C: 3, D: 4, E: 5, F: 6, G: 7, H: 8, I: 9, J: 10, K: 11, L: 12, M: 13, N: 14, O: 15, P: 16, Q: 17})[17] == "Q"

defn isDropMany()
  m = dict.Dict()
  for i in 1..20
    m[i] = i
  end
  for i in 1..15
    m = dict.Drop(i, m)
  end
  value.Equal(dict.Keys(m), [16, 17, 18, 19, 20]) and value.Equal(dict.Keys(dict.Put(1, 0, m)), [16, 17, 18, 19, 20, 1])
end

(* Keys are data: any first letter, from any package. *)
isSmallKeys() = parsed().Name == "Ana" and result.Unwrap(json.Parse("{\"name\": 1}")).name == 1 and f.Record().size == 1
isProtoIsAKey() = value.Equal(dict.Keys({"__proto__": 1, "constructor": 2}), ["__proto__", "constructor"])
isStructNoMap() = value.IsStruct(result.Ok(1)) and not value.IsDict(result.Ok(1))
isMapOfStructFails() = stop(() -> dict.Keys(result.Ok(1))) == "type: Keys needs a dictionary, not an Ok."
isMissingKey() = stop(() -> literal().City) == "index: This dictionary has no key: the text \"City\"." and stop(() -> parsed().City) == "index: This dictionary has no key: the text \"City\"."

defn isMerge()
  value.Equal(dict.Keys(dict.Merge({A: 1, B: 2}, {C: 3, A: 4})), ["A", "B", "C"]) and dict.Merge({A: 1, B: 2}, {C: 3, A: 4}).A == 4
end

stop(f) = match fiber.Wait(fiber.Spawn(f))   (** What a call that stops says: its kind and its message. *)
  result.Err(e) -> "$(e.Kind): $(e.Message)"
  result.Ok(v) -> v
end

(* Structs and maps: From, Fields, json.Text. *)
struct User { Id Int, Name Text, secret Text = "s", Age Int = 0 }
(u User) Greeting() = "Bonjour $(u.Name)"

isFrom() = result.Unwrap(User.From({Id: 1, Name: "Ana"})) == User(1, "Ana") and result.Unwrap(User.From(parsed() then dict.Put("Id", 2, it) then dict.Drop("Age", it))).Name == "Ana"
isFromJson() = result.Unwrap(User.From(result.Unwrap(json.Parse("{\"Id\": 7, \"Name\": \"Bo\"}")))).Greeting() == "Bonjour Bo"
isFromDefaults() = result.Unwrap(User.From({Id: 1, Name: "Ana"})).Age == 0 and result.Unwrap(User.From({Id: 1, Name: "Ana", Age: 3})).Age == 3
isFromExcess() = result.MapErr(it.Message, User.From({Id: 1, Name: "Ana", Admin: true})) == result.Err("User has no field \"Admin\".")
isFromMissing() = result.MapErr(it.Message, User.From({Id: 1})) == result.Err("User needs the field \"Name\".")
isFromWrongType() = result.MapErr(it.Message, User.From({Id: "1", Name: "Ana"})) == result.Err("User: Id must be an Int, found a Text.") and result.IsErr(User.From(dict.Put(3, 4, {Id: 1, Name: "Ana"})))
isFromKind() = result.MapErr(it.Kind, User.From({})) == result.Err("field")
(* Keys from outside, as JSON or SQL write them: name and created_at give Name and CreatedAt. *)
struct Row { CreatedAt Text }
isFromOutsideNames() = result.Unwrap(User.From({"id": 1, "name": "Ana", "age": 3})).Age == 3 and result.Unwrap(Row.From({"created_at": "x"})).CreatedAt == "x"
isFromTwoKeys() = result.MapErr(it.Message, User.From({"Id": 1, "Name": "a", "name": "b"})) == result.Err("User gets its field \"Name\" from two keys: \"Name\" and \"name\".")
isFromSmallInside() = result.Unwrap(User.From({Id: 1, Name: "Ana", secret: "x"})).secret == "x"
isFromSmallOutside() = result.MapErr(it.Message, f.Secret.From({key: "k", Label: "l"})) == result.Err("Secret has no field \"key\".") and result.MapErr(it.Message, f.Secret.From({Label: "l"})) == result.Err("Secret needs a field that is private to its package.")
isFromAsValue() = value.Equal(list.Map(it.Value.Id, list.Map(User.From, [{Id: 1, Name: "a"}, {Id: 2, Name: "b"}])), [1, 2])
isFromNoMap() = stop(() -> User.From(3)) == "type: User.From needs a dictionary, not the number 3."
isFields() = dict.Fields(User(1, "Ana")) == {Id: 1, Name: "Ana", secret: "s", Age: 0} and value.Equal(dict.Keys(dict.Fields(User(1, "Ana"))), ["Id", "Name", "secret", "Age"])
isFieldsOutside() = dict.Fields(f.New()) == {Label: "public"}
isFieldsRoundTrip() = result.Unwrap(User.From(dict.Fields(User(1, "Ana", Age = 4)))) == User(1, "Ana", Age = 4)
isFieldsNoMap() = stop(() -> dict.Fields({A: 1})) == "type: Fields needs a struct, not a dictionary."
isJsonOfStruct() = json.Text(User(1, "Ana")) == "{\"Id\":1,\"Name\":\"Ana\",\"Age\":0}" and json.Text(f.New()) == "{\"Label\":\"public\"}"
isMapFunctionsRefuseStructs() = stop(() -> dict.Values(result.Ok(1))) == "type: Values needs a dictionary, not an Ok." and stop(() -> dict.Put("A", 1, result.Ok(1))) == "type: Put needs a dictionary, not an Ok."

(* A new map from another one holds the same values: a write through the old one must not show in the new one. *)
defn isPutCopies()
  m = {A: [1, 2], B: 1}
  added = dict.Put("C", 1, m)
  kept = dict.Put("B", 2, m)
  dropped = dict.Drop("B", m)
  m.A[1] = 99
  value.Equal(added.A, [1, 2]) and value.Equal(kept.A, [1, 2]) and value.Equal(dropped.A, [1, 2])
end

(* A map meets an interface whatever its storage: by a literal, by a variable key, past 16 keys, after Drop. *)
interface Labelled { Label() }
(x Labelled) Shout() = text.Upper(x.Label())
labelOf(x Labelled) = x.Label()
defn treeOf(n)
  m = dict.Dict()
  k = "Label"
  m[k] = () -> n
  m
end
defn isTreeMeetsInterface()
  big = treeOf("big")
  for i in 1..20
    big["k$(i)"] = i
  end
  labelOf(treeOf("t")) == "t" and treeOf("t").Shout() == "T" and labelOf(big) == "big" and labelOf(dict.Drop("x", {Label: () -> "d", x: 1})) == "d"
end
isTreeLacksInterface() = stop(() -> labelOf(dict.Put(1, 2, {Label: 3}))) == "type: labelOf: x must be a Labelled, found a Dict, which has no Label()."

(* One storage at every size: a map grows by one block, then by more of the same kind, and the program sees none of it. *)
defn sized(n)
  m = dict.Dict()
  for i in 1..n
    m["k$(i)"] = i
  end
  m
end

defn sameAtSize(n)
  m = sized(n)
  p = dict.Put("k1", 0, m)
  d = dict.Drop("k1", m)
  back = dict.Put("k1", 9, d)
  full = n == 0 or (m["k1"] == 1 and m["k$(n)"] == n and dict.Keys(m)[n] == "k$(n)" and dict.Values(m)[1] == 1 and p["k1"] == 0 and dict.Keys(p)[1] == "k1")
  dropped = value.Len(d) == (if n == 0 0 else n - 1 end) and not dict.Has("k1", d) and (n < 2 or dict.Keys(d)[1] == "k2")
  last = n == 0 or dict.Keys(back)[n] == "k1"
  value.Len(m) == n and full and dropped and last and m == sized(n) and result.Unwrap(json.Parse(json.Text(m))) == m
end

isEverySize() = list.All([sameAtSize(n) for n in [0, 1, 31, 32, 33, 1000, 100000]])

(* m = Put(k, x, m) writes in place, but never through another name. *)
defn isPutOnItself()
  a = sized(40)
  b = a
  b = dict.Put("k1", 0, b)
  c = {A: 1}
  d = c
  d = dict.Put("B", 2, d)
  a["k1"] == 1 and b["k1"] == 0 and c == {A: 1} and d == {A: 1, B: 2}
end

defn isSharedDeepKept()
  a = sized(100)
  b = a
  b["k5"] = 0
  b["new"] = 1
  a["k5"] == 5 and not dict.Has("new", a) and b["k5"] == 0 and value.Len(b) == 101 and dict.Keys(b)[101] == "new"
end

(* Keys from one place shared by maps of other sizes: each map sees its own keys only. *)
defn isGrownApart()
  a = {A: 1}
  b = a
  a.B = 2
  b.C = 3
  a.D = 4
  value.Equal(dict.Keys(a), ["A", "B", "D"]) and value.Equal(dict.Keys(b), ["A", "C"]) and b.C == 3 and not dict.Has("B", b) and a.D == 4
end
