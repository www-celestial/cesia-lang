use encode

is_hex() = encode.hex("é!") == "c3a921"
is_unhex() = unwrap(encode.unhex("c3A921")) == "é!" and is_err(encode.unhex("0")) and is_err(encode.unhex("zz"))
is_base64() = encode.base64("hello") == "aGVsbG8=" and encode.base64("hi") == "aGk=" and encode.base64("abc") == "YWJj" and encode.base64("") == ""
is_unbase64() = unwrap(encode.unbase64("aGVsbG8=")) == "hello" and unwrap(encode.unbase64("aGk")) == "hi" and is_err(encode.unbase64("a")) and is_err(encode.unbase64("a!bc"))
is_base64_round_trip() = unwrap(encode.unbase64(encode.base64(from_bytes([0, 255, 128, 7])))) == from_bytes([0, 255, 128, 7])
is_url_encode() = encode.url_encode("a b&é") == "a%20b%26%C3%A9"
is_url_decode() = encode.url_decode("a%20b+c%26%C3%A9") == "a b c&é" and encode.url_decode("100%") == "100%"
is_query() = equal(encode.parse_query("a=1&b=two+words&c=&d"), {"a": "1", "b": "two words", "c": "", "d": ""})
is_query_empty() = equal(encode.parse_query(""), dict())
is_sha1() = encode.hex(encode.sha1("abc")) == "a9993e364706816aba3e25717850c26c9cd0d89d" and encode.hex(encode.sha1("")) == "da39a3ee5e6b4b0d3255bfef95601890afd80709"
is_sha1_long() = encode.hex(encode.sha1(repeat(1000, "a"))) == "291e9a6c66994949b57ba5e650361e98fc36b1ba"
is_websocket_accept() = encode.base64(encode.sha1("dGhlIHNhbXBsZSBub25jZQ==258EAFA5-E914-47DA-95CA-C5AB0DC85B11")) == "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="
