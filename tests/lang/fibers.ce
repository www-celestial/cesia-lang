use std/bug
use std/fiber
use std/math
use std/result
use std/value

add(a, b) = a + b
defn waitTwice()
  t = fiber.Spawn(() -> 1)
  fiber.Wait(t) == fiber.Wait(t)
end
defn copied()
  a = [1, 2]
  t = fiber.Spawn(() -> a[1])
  a[1] = 9
  fiber.Wait(t) == result.Ok(1)
end
isWaitValue() = fiber.Wait(fiber.Spawn(() -> add(1, 2))) == result.Ok(3)
isWaitTwice() = waitTwice()
isPanicIsErr() = result.IsErr(fiber.Wait(fiber.Spawn(() -> bug.Panic("x"))))
isPanicMessage() = (fiber.Wait(fiber.Spawn(() -> bug.Panic("x"))) then result.MapErr(it.Message)) == result.Err("x")
isTypePanic() = (fiber.Wait(fiber.Spawn(() -> 1 + "a")) then result.MapErr(it.Kind)) == result.Err("type")
isValueCopied() = copied()
isWaitNotATask() = result.IsErr(fiber.Wait(fiber.Spawn(() -> fiber.Wait(1))))
isSpawnInSpawn() = fiber.Wait(fiber.Spawn(() -> fiber.Wait(fiber.Spawn(() -> 1)))) == result.Ok(result.Ok(1))

half(x) = result.Ok(math.Div(x, 2))
countDown(n) = if n == 0 0 else 0 + countDown(n - 1) end
isPmap() = value.Equal([1, 2, 3] then fiber.Pmap(it * 2), [2, 4, 6])
isPmapEmpty() = value.Equal([] then fiber.Pmap(it * 2), [])
isPmapCollect() = value.Equal([2, 4] then fiber.Pmap(half) then result.Collect, result.Ok([1, 2]))
isPmapPanics() = result.IsErr(fiber.Wait(fiber.Spawn(() -> fiber.Pmap(x -> bug.Panic("x"), [1]))))
isManyFibers() = value.Len(fiber.Pmap(it + 1, 1..10000)) == 10000
isDeepInFiber() = fiber.Wait(fiber.Spawn(() -> countDown(5000))) == result.Ok(0)
