use std/dict
use std/fiber
use std/list
use std/math
use std/matrix
use std/result
use std/text
use std/value

struct Point
  X
  Y
end

struct Box
  Inside
end

defn fails(f, kind)
  (fiber.Wait(fiber.Spawn(f)) then result.MapErr(it.Kind)) == result.Err(kind)
end

defn cut(n, t)
  (** The rule written plainly: the whole text when it fits, else its first n - 1 characters and an ellipsis. *)
  if value.Len(t) <= n t else "$(text.Slice(1, n - 1, t))…" end
end

defn deepMap()
  (** A map of 40 keys, past one block, with keys that are no names. *)
  d = {}
  for k in 1..40
    d = dict.Put(if math.Mod(k, 2) == 0 "k$k" else k end, k * 1.5, d)
  end
  d
end

samples = [missing, true, false, 0, -12345, 1.5, 1e300, math.Sqrt(-1.0), "", "plain", "a \"quoted\" \\ text", "héllo wörld ✓",
  [], [1, 2, 3], [1.5; 2.5], [1, 2; 3, 4], ["a", 1; "b", 2], matrix.Reshape([2, 2, 2], 1..8), [[1, [2, "é"]], {A: 1}],
  dict.Put(3, "x", dict.Put("b-c", [2], {A: 1})), deepMap(), Point(1, "y"), Box([1, 2]), result.Ok(Point(1.5, missing)), (x) -> x, math.Sqrt,
  [text.Repeat(12, "é\"😀ab\\")]]

defn sameAsWhole()
  (** For every sample and every most up to past its length, the rule, character by character. *)
  for v in samples
    t = "$v"
    for most in 1..(value.Len(t) + 2)
      if value.Text(v, most) != cut(most, t)
        return "$most: $(value.Text(v, most)) for $t"
      end
    end
  end
  true
end

isSameAsWhole() = sameAsWhole()
isWhole() = value.Text([1, 2, 3], 9) == "[1, 2, 3]"
isCut() = value.Text([1, 2, 3], 5) == "[1, …"
isNoMoreThanMost() = value.Len(value.Text([1, 2, 3], 5)) == 5
isMostOne() = value.Text("ab", 1) == "…" and value.Text("a", 1) == "a"
isCodePoints() = value.Text("héllo wörld", 4) == "hél…"
isTextRaw() = value.Text("a\"b", 3) == "a\"b"
isQuotedInside() = value.Text(["a\"b"], 5) == "[\"a\\…"
isNamed() = value.Text("abcdef", most = 3) == "ab…"
isMissingMostWhole() = value.Text([1, 2], missing) == "[1, 2]"
isWholeFloat() = value.Text("abcd", 3.0) == "ab…"
isMostZero() = fails(() -> value.Text(1, 0), "type")
isMostNegative() = fails(() -> value.Text(1, -1), "type")
isMostHalf() = fails(() -> value.Text(1, 1.5), "type")
isMostText() = fails(() -> value.Text(1, "3"), "type")
isMostMessage() = fiber.Wait(fiber.Spawn(() -> value.Text(1, 0))).Error.Message == "value.Text needs a count of 1 or more characters as most, not the number 0."

(* Values that "$v" can't show in reasonable time or memory: the walk stops at most. *)
isShared() = value.Text(list.Fill(list.Fill(1..1000, 1000), 1000), 12) == "[[[1, 2, 3,…"
isLongText() = value.Text([text.Repeat(10000000, "ab")], 6) == "[\"aba…"
isLongTextRaw() = value.Text(text.Repeat(10000000, "é"), 3) == "éé…"
isLongMatrix() = value.Text(matrix.Zeros(1000, 1000), 10) == "[0.0 0.0 …"

defn deep(n)
  d = []
  for k in 1..n
    d = [d]
  end
  d
end

isDeep() = value.Text(deep(100000), 6) == "[[[[[…"
isDeepWholeFails() = result.IsErr(fiber.Wait(fiber.Spawn(() -> "$(deep(100000))")))
isMostHuge() = value.Text([1, 2], 4611686018427387903) == "[1, 2]" and value.Text("ab", 1e18) == "ab"
isWideCharacters() = value.Text("a😀b", 2) == "a…" and value.Text(["😀😀"], 3) == "[\"…" and value.Text("😀😀", 2) == "😀😀"
isLongWideText() = value.Text([text.Repeat(1000000, "😀")], 5) == "[\"😀😀…"
