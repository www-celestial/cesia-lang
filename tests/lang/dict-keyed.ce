(* dict.Get, Has and GetOr of a key written in the code go through a cache of the map's keys at their call: maps of one
   literal, of another, grown by a write, deep, a key absent, a default that is a list, and what isn't a map, which the
   native refuses. Each answer is the one the natives give. *)
use std/dict
use std/io
use std/list

defn probe(m)
  "$(dict.Has("B", m)) $(dict.Get("B", m)) $(dict.GetOr("B", 0, m)) $(dict.Has("Z", m)) $(dict.Get("Z", m)) $(dict.GetOr("Z", -1, m))"
end

grown = {A: 1}
grown.B = 2
deep = dict.Dict()
for k in 1..40
  deep["k$k"] = k
end
deep.B = 7
ms = [{A: 1, B: 2}, {B: "two", C: 3}, {A: 1, B: 2}, grown, {X: 0}, deep, dict.Dict(), {A: 1, B: 2}]
for m in ms
  io.Print(probe(m))
end
for m in ms
  io.Print(probe(m))
end
d = [1, 2]
got = dict.GetOr("Z", d, {A: 1})
got[1] = 9
io.Print("$d $got")
kept = {L: [1, 2]}
l = dict.Get("L", kept)
l[1] = 5
io.Print("$(kept.L) $l")
io.Print(dict.Has("B", [1, 2]))
