add_two(a, b) = a + b
both(a, b) = [a, b]
apply(f, x) = f(x)
ordered(by = 0) = by({v: 7})

is_last_positional() = (10 then add_two(1)) == 11
is_value_alone() = (4 then sqrt) == 2.0
is_it_placed() = equal(1 then both(it, 2), [1, 2])
is_last_keeps_order() = equal(1 then both(2), [2, 1])
is_expression_it() = (2 then it * 3) == 6
is_anonymous_function() = (2 then (x -> x + 1)) == 3
is_argument_it() = apply(it + 1, 1) == 2
is_it_alone_in_call() = apply(add_two(it, 2), 1) == 3
is_named() = ordered(by = it.v) == 7
is_nested_function() = apply(x -> (y -> y)(x), 1) == 1
is_lambda_precedence() = (x -> x then abs)(-1) == 1
is_multiline() = multi() == 6

defn multi()
  [1, 2, 3]
    then map(it * 2)
    then sum(it) / 2
end
