(** Linear algebra above the size where a library takes over, when there is one. The answers hold with it or without it. *)
use std/num
use std/list
use std/math
use std/matrix
use std/result
use std/value

defn sample(n)
  m = matrix.Zeros(n, n)
  for i in 1..n
    for j in 1..n
      m[i, j] = 1.0 / (i + j) + if i == j 2.0 else 0.0 end
    end
  end
  m
end

defn slowMatmul(a, b)
  n = value.Size(a, 1)
  out = matrix.Zeros(n, n)
  for i in 1..n
    for j in 1..n
      total = 0.0
      for k in 1..n
        total += a[i, k] * b[k, j]
      end
      out[i, j] = total
    end
  end
  out
end

near(a, b) = list.Max(math.Abs(a - b)) < 1e-8
big = sample(40)

isMatmul() = near(matrix.Matmul(big, big), slowMatmul(big, big))

defn isSolve()
  b = [1.0 * k for k in 1..40]
  x = result.Unwrap(num.Solve(big, b))
  near(matrix.Matmul(big, matrix.Reshape([40, 1], x)), matrix.Reshape([40, 1], b))
end

defn isSolveSingular()
  r = num.Solve(matrix.Zeros(40, 40) + 1.0, [1.0 for k in 1..40])
  result.IsErr(r) and r.Error.Kind == "math"
end

isInverse() = near(matrix.Matmul(big, result.Unwrap(num.Inverse(big))), num.Eye(40))

defn isDetIsTheProductOfTheEigenvalues()
  values = num.Eigen(big).Values
  a = list.Reduce((acc, x) -> acc * x, 1.0, values)
  math.Abs(num.Det(big) / a - 1.0) < 1e-8
end

defn isQr()
  f = num.Qr(big)
  near(matrix.Matmul(f.Q, f.R), big) and near(matrix.Matmul(matrix.Transpose(f.Q), f.Q), num.Eye(40))
end

defn isQrPositiveDiagonal()
  r = num.Qr(big).R
  list.All([r[k, k] > 0.0 for k in 1..40])
end

defn isQrTall()
  m = sample(50)[1..50, 1..40]
  f = num.Qr(m)
  value.Size(f.Q, 1) == 50 and value.Size(f.R, 1) == 40 and near(matrix.Matmul(f.Q, f.R), m)
end

defn isEigen()
  e = num.Eigen(big)
  near(matrix.Matmul(big, e.Vectors), matrix.Matmul(e.Vectors, num.Diag(e.Values)))
end

isBackendNamesALibraryOrNothing() = value.IsMissing(num.Backend()) or value.IsText(num.Backend())
