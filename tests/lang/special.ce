(** The tests of std/special: values computed to 70 digits with the decimal arithmetic of Python, from the exact
    floats of their arguments, closed forms, identities, special points, arrays and wrong arguments. A table's last
    column for GammaInc and BetaInc is its bound in eps: 16 (1 + c), c = |x f'(x) / f(x)|, how much f changes for a
    relative change of x, as the function itself loses digits there whatever computes it. *)
use std/fiber
use std/list
use std/math
use std/matrix
use std/result
use std/special
use std/value

eps = 2.220446049250313e-16
message(f) = fiber.Wait(fiber.Spawn(f)) then result.MapErr(it.Message)
relative(got, want) = math.Abs(got - want) / math.Abs(want) / eps
near(got, want, n) = relative(got, want) <= n
nearAbs(got, want, n) = math.Abs(got - want) <= n * eps

