is_literal() = {"a": 1, "b": 2}["b"] == 2
is_number_keys() = {1: "x", 2: "y"}[2] == "y"
is_whole_float_key() = {1: "x"}[1.0] == "x"
is_float_key() = {1.5: "x"}[1.5] == "x"
is_computed_key() = {(1 + 1): "x"}[2] == "x"
is_get() = get("a", {"a": 1}) == 1
is_get_absent() = is_missing(get("z", {"a": 1}))
is_get_or() = get_or("z", 5, {"a": 1}) == 5 and get_or("a", 5, {"a": 1}) == 1
is_has() = has("a", {"a": 1}) and not has("b", {"a": 1})
is_in() = "a" in {"a": 1} and not ("b" in {"a": 1})
is_empty() = length(dict()) == 0
is_length() = length({"a": 1, "b": 2}) == 2
is_keys_sorted() = equal(keys({"b": 1, "a": 2, 3: 3}), [3, "a", "b"])
is_values() = equal(values({"b": 1, "a": 2}), [2, 1])
is_pairs() = equal(pairs({"a": 1}), [{key: "a", value: 1}])
is_from_pairs() = equal(dict([{key: "a", value: 1}]), {"a": 1})
is_round_trip() = equal(dict(pairs({"a": 1, "b": 2})), {"a": 1, "b": 2})
is_equal_any_order() = {"a": 1, "b": 2} == {"b": 2, "a": 1}
is_not_equal() = {"a": 1} != {"a": 2} and {"a": 1} != {"b": 1}
is_text_form() = text({"b": 1, 2: "x"}) == "{2: ""x"", ""b"": 1}"
is_kind() = is_dict({"a": 1}) and not is_dict({a: 1})
is_later_wins() = {"a": 1, "a": 2}["a"] == 2

defn is_put_keeps_the_original()
  a = {"x": 1}
  b = put("x", 2, a)
  a["x"] == 1 and b["x"] == 2
end

defn is_drop()
  a = {"x": 1, "y": 2}
  b = drop("x", a)
  length(a) == 2 and length(b) == 1 and not has("x", b) and equal(drop("z", b), b)
end

defn is_assign()
  d = dict()
  d["a"] = 1
  d[2] = "two"
  d["a"] = 3
  length(d) == 2 and d["a"] == 3 and d[2] == "two"
end

defn is_assign_keeps_a_copy()
  a = {"x": 1}
  b = a
  b["x"] = 2
  a["x"] == 1 and b["x"] == 2
end

defn is_array_inside()
  a = {"x": [1, 2]}
  b = a
  b["x"][1] = 9
  a["x"][1] == 1 and b["x"][1] == 9
end

defn is_dict_inside()
  a = {"x": {"y": {"z": 1}}}
  b = a
  b["x"]["y"]["z"] = 2
  b["x"]["y"]["w"] = 3
  a["x"]["y"]["z"] == 1 and b["x"]["y"]["z"] == 2 and b["x"]["y"]["w"] == 3
end

defn is_in_a_struct()
  s = {d: {"a": 1}}
  s.d["a"] = 2
  s.d["b"] = 3
  s.d["a"] == 2 and s.d["b"] == 3
end

defn is_in_an_array()
  xs = [{"a": 1}, {"a": 2}]
  xs[2]["a"] = 5
  xs[1]["a"] == 1 and xs[2]["a"] == 5
end

defn is_compound_assign()
  d = {"n": 1}
  d["n"] += 2
  d["n"] == 3
end

defn is_many()
  d = dict()
  for i in 1:5000
    d[i * 7 - 3] = i
  end
  total = 0
  for i in 1:5000
    total += d[i * 7 - 3]
  end
  for i in 1:2500
    d = drop(i * 7 - 3, d)
  end
  length(d) == 2500 and total == 12502500 and equal(keys(d)[1], 2501 * 7 - 3)
end

defn is_struct_keeps_literal()
  x = {a: 1}
  x.a == 1
end

