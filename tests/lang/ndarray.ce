(** Arrays of three dimensions and more: built, read and written by index, summed along a dimension, shown. *)
use std/columns
use std/fiber
use std/json
use std/list
use std/math
use std/matrix
use std/result
use std/value

message(f) = fiber.Wait(fiber.Spawn(f)) then result.MapErr(it.Message)
cube() = matrix.Reshape([2, 3, 4], 1..24)

isZerosOfThree() = value.Equal(value.Size(matrix.Zeros(2, 3, 4)), [2, 3, 4]) and value.Len(matrix.Zeros(2, 3, 4)) == 24 and columns.Kind(matrix.Zeros(2, 3, 4)) == "float"
isOnesAndFill() = matrix.Ones(2, 2, 2)[2, 2, 2] == 1.0 and list.Fill("a", 2, 1, 3)[2, 1, 3] == "a" and value.Equal(value.Size(list.Fill(0, 1, 2, 3, 4)), [1, 2, 3, 4])
isLowerDimsUnchanged() = value.Equal(value.Size(matrix.Zeros(3)), [1, 3]) and value.Equal(value.Size(matrix.Zeros(3, 4)), [3, 4])
isColumnMajor() = cube()[1, 1, 1] == 1 and cube()[2, 1, 1] == 2 and cube()[1, 2, 1] == 3 and cube()[1, 1, 2] == 7 and cube()[2, 3, 4] == 24
isLinearIndex() = cube()[15] == 15 and cube()[1, 2, 3] == cube()[15]

defn isWriteThenRead()
  a = matrix.Zeros(2, 3, 4)
  a[1, 2, 3] = 5.0
  a[24] = 1.5
  a[1, 2, 3] == 5.0 and a[15] == 5.0 and a[2, 3, 4] == 1.5 and list.Sum(a) == 6.5
end

defn isWriteValues()
  a = list.Fill("", 2, 2, 2)
  a[2, 1, 2] = "x"
  a[6] == "x" and a[2, 1, 2] == "x"
end

defn isWriteInts()
  a = cube()
  a[2, 3, 4] = 0
  a[24] == 0 and columns.Kind(a) == "int"
end

defn isCopyOnWrite()
  a = matrix.Zeros(2, 2, 2)
  b = a
  b[1, 1, 1] = 9.0
  a[1, 1, 1] == 0.0 and b[1, 1, 1] == 9.0
end

defn isLoopIndexes()
  a = matrix.Zeros(3, 4, 5)
  for k in 1..5
    for j in 1..4
      for i in 1..3
        a[i, j, k] = i + 10.0 * j + 100.0 * k
      end
    end
  end
  s = 0.0
  for k in 1..5
    for j in 1..4
      for i in 1..3
        s = s + a[i, j, k]
      end
    end
  end
  a[3, 4, 5] == 543.0 and s == list.Sum(a) and a[2] == 112.0
end

isEnd() = cube()[end, end, end] == 24 and cube()[end, 1, 1] == 2 and cube()[1, end, 1] == 5
isSize() = value.Size(cube(), 3) == 4 and value.Size(cube(), dim = 2) == 3 and value.Len(value.Size(matrix.Zeros(1, 1, 1, 1))) == 4
isSizeDimOutside() = message(() -> value.Size(cube(), 4)) == result.Err("Size's dimension must be from 1 to 3, not the number 4.")
isTrailingOneKept() = value.Equal(value.Size(matrix.Zeros(2, 3, 1)), [2, 3, 1]) and matrix.Zeros(2, 3, 1)[2, 3, 1] == 0.0

isReshape() = value.Equal(value.Size(matrix.Reshape([6, 4], cube())), [6, 4]) and matrix.Reshape([6, 4], cube())[1, 3] == 13 and value.Equal(matrix.Reshape([24], cube()), 1..24)
isReshapeKeepsTheSource() = value.Equal(value.Size(cube()), [2, 3, 4])
isReshapeCount() = message(() -> matrix.Reshape([5, 5], cube())) == result.Err("Can't reshape 24 elements into 5 by 5.")
isReshapeShape() = message(() -> matrix.Reshape(2, cube())) == result.Err("Reshape needs its shape as a list of sizes, not the number 2.")

isSumAlongLast() = value.Equal(list.Sum(cube(), dim = 3), [40 48 56; 44 52 60]) and value.Equal(value.Size(list.Sum(cube(), dim = 3)), [2, 3])
isSumAlongFirst() = value.Equal(list.Sum(cube(), dim = 1), matrix.Reshape([3, 4], [3, 7, 11, 15, 19, 23, 27, 31, 35, 39, 43, 47]))
isSumAlongMiddle() = value.Equal(value.Size(list.Sum(cube(), dim = 2)), [2, 4]) and list.Sum(cube(), dim = 2)[1, 1] == 9
isSumOfFloats() = value.Equal(list.Sum(1.0 * cube(), dim = 3), [40.0 48.0 56.0; 44.0 52.0 60.0]) and columns.Kind(list.Sum(1.0 * cube(), dim = 3)) == "float"
isSumOfValues() = value.Equal(list.Sum(matrix.Reshape([2, 2], [1, missing, 2.5, 3]), dim = 1), [missing, 5.5])
isSumOfAMatrix() = value.Equal(list.Sum([1 2; 3 4], dim = 1), [4, 6]) and value.Equal(list.Sum([1 2; 3 4], dim = 2), [3, 7]) and value.Equal(list.Sum([1, 2, 3], dim = 2), [6])
isSumWhole() = list.Sum(cube()) == 300 and list.Sum(cube(), dim = missing) == 300
isMeanAlong() = value.Equal(list.Mean(cube(), dim = 1), list.Sum(cube(), dim = 1) / 2) and value.Equal(list.Mean([1 2; 3 4], dim = 2), [1.5, 3.5])
isMeanOfEmpty() = list.Mean(matrix.Zeros(2, 0), dim = 2)[1] != list.Mean(matrix.Zeros(2, 0), dim = 2)[1]
isSumDimOutside() = message(() -> list.Sum(cube(), dim = 4)) == result.Err("Sum's dimension must be from 1 to 3, not the number 4.") and message(() -> list.Sum([1, 2], dim = 3)) == result.Err("Sum's dimension must be 1 or 2, not the number 3.")
isSumOverflow() = message(() -> list.Sum(matrix.Reshape([2, 1, 1], [4611686018427387903, 1]), dim = 1)) == result.Err("The integer result of 4611686018427387903 + 1 doesn't fit in 63 bits.")

defn isSumAlongMany()
  big = matrix.Reshape([50, 40, 30], 1.0 * (1..60000))
  s1 = list.Sum(big, dim = 1)
  s3 = list.Sum(big, dim = 3)
  value.Equal(value.Size(s1), [40, 30]) and s1[40, 30] == list.Sum(1.0 * (59951..60000)) and s3[50, 40] == list.Sum(1.0 * [2000 * k for k in 1..30])
end

isElementwise() = value.Equal(value.Size(cube() + 1.0), [2, 3, 4]) and (cube() + 1.0)[2, 3, 4] == 25.0 and (cube() * cube())[2, 1, 2] == 64 and (2 - cube())[1, 1, 1] == 1
isElementwiseKinds() = columns.Kind(cube() * 2) == "int" and columns.Kind(cube() / 2) == "float" and value.Equal(value.Size(-cube()), [2, 3, 4])
isMaskKeepsTheShape() = value.Equal(value.Size(cube() > 12), [2, 3, 4]) and (cube() > 12)[1, 1, 3] and list.Sum(cube() > 12) == 12
isMathKeepsTheShape() = value.Equal(value.Size(math.Sqrt(cube())), [2, 3, 4]) and value.Equal(value.Size(math.Abs(1.0 * cube())), [2, 3, 4]) and value.Equal(value.Size(math.Floor(cube())), [2, 3, 4])
isMapKeepsTheShape() = value.Equal(value.Size(list.Map(it * 2, cube())), [2, 3, 4]) and list.Map(it * 2, cube())[2, 3, 4] == 48
isMixedShapes() = message(() -> cube() + matrix.Reshape([2, 12], 1..24)) == result.Err("Can't combine an array of 2 by 3 by 4 with an array of 2 by 12.")

isEqual() = value.Equal(cube(), cube()) and value.Equal(cube(), 1.0 * cube()) and not value.Equal(cube(), matrix.Reshape([2, 12], 1..24)) and not value.Equal(cube(), matrix.Reshape([2, 4, 3], 1..24))
isShow() = value.Text(matrix.Reshape([2, 2, 2], 1..8)) == "[1 3; 2 4;;; 5 7; 6 8]" and value.Text(matrix.Reshape([1, 2, 2, 2], 1..8)) == "[1 2;;; 3 4;;;; 5 6;;; 7 8]" and value.Text(list.Fill("a", 1, 1, 2)) == "[\"a\";;; \"a\"]"
isJson() = json.Text(matrix.Reshape([2, 2, 2], 1..8)) == "[[[1,5],[3,7]],[[2,6],[4,8]]]" and json.Text(matrix.Reshape([2, 2], 1..4)) == "[1,2,3,4]"

isIndexCount() = message(() -> cube()[1, 2]) == result.Err("This array has 3 dimensions: use 3 indexes, or one.") and message(() -> [1 2; 3 4][1, 1, 1]) == result.Err("This array has 2 dimensions: use 2 indexes, or one.")
isIndexOutside() = message(() -> cube()[3, 1, 1]) == result.Err("Index [3, 1, 1] is outside this array of 2 by 3 by 4.") and message(() -> cube()[1, 1, 0]) == result.Err("Index [1, 1, 0] is outside this array of 2 by 3 by 4.")
isIndexSlice() = message(() -> cube()[1, :, :]) == result.Err("An array of 3 dimensions takes a whole number for each index, not a slice.")
isIndexType() = message(() -> cube()[1, 1.5, 1]) == result.Err("An index must be a whole number, not the number 1.5.")

defn writeTwo(a)
  a[1, 1] = 0
  a
end

isWriteCount() = message(() -> writeTwo(cube())) == result.Err("This array has 3 dimensions: use 3 indexes, or one.")

isMatmulTwoDims() = message(() -> matrix.Matmul(cube(), cube())) == result.Err("Matmul works on arrays of 2 dimensions, not 3.") and message(() -> matrix.Transpose(cube())) == result.Err("Transpose works on arrays of 2 dimensions, not 3.")
isFourDims() = matrix.Reshape([2, 2, 2, 2], 1..16)[2, 2, 2, 2] == 16 and matrix.Reshape([2, 2, 2, 2], 1..16)[1, 2, 1, 2] == 11 and value.Equal(value.Size(list.Sum(matrix.Reshape([2, 2, 2, 2], 1..16), dim = 4)), [2, 2, 2])
