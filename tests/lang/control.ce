use std/bug
use std/fiber
use std/result
use std/value

defn m(p)
  match p
    {Status: "ok", Amount: amount} if amount > 0 -> amount
    [a, b] -> a + b
    0 -> "zero"
    x if value.IsText(x) -> x
    else -> "other"
  end
end
isStructPattern() = m({Status: "ok", Amount: 5}) == 5
isGuard() = m({Status: "ok", Amount: -5}) == "other"
isArrayPattern() = m([1, 2]) == 3
isLength() = m([1, 2, 3]) == "other"
isLiteral() = m(0) == "zero"
isName() = m("t") == "t"

defn ifExpr(x)
  if x < 0 "neg" else if x == 0 "zero" else "pos" end
end
isIfChain() = ifExpr(-1) == "neg" and ifExpr(0) == "zero" and ifExpr(1) == "pos"

isPanicKind() = (fiber.Wait(fiber.Spawn(() -> bug.Panic("x"))) then result.MapErr(it.Kind)) == result.Err("user")
isAssert() = (fiber.Wait(fiber.Spawn(() -> bug.Assert(false))) then result.MapErr(it.Kind)) == result.Err("user")

defn deep(n)
  if n == 0
    bug.Panic("bottom")
  end
  deep(n - 1) + 1
end
defn repeatedPanics()
  for i in 1..20000
    fiber.Wait(fiber.Spawn(() -> deep(3)))
  end
  true
end
isPanicKeepsTheStack() = repeatedPanics()
