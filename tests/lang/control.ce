use std/bug
use std/fiber
use std/result
use std/value

defn m(p)
  match p
    {Status: "ok", Amount: amount} if amount > 0 -> amount
    [a, b] -> a + b
    0 -> "zero"
    x if value.IsText(x) -> x
    else -> "other"
  end
end
isStructPattern() = m({Status: "ok", Amount: 5}) == 5
isGuard() = m({Status: "ok", Amount: -5}) == "other"
isArrayPattern() = m([1, 2]) == 3
isLength() = m([1, 2, 3]) == "other"
isLiteral() = m(0) == "zero"
isName() = m("t") == "t"

defn ifExpr(x)
  if x < 0 "neg" else if x == 0 "zero" else "pos" end
end
isIfChain() = ifExpr(-1) == "neg" and ifExpr(0) == "zero" and ifExpr(1) == "pos"

isPanicKind() = (fiber.Wait(fiber.Spawn(() -> bug.Panic("x"))) then result.MapErr(it.Kind)) == result.Err("user")
isAssert() = (fiber.Wait(fiber.Spawn(() -> bug.Assert(false))) then result.MapErr(it.Kind)) == result.Err("user")

defn deep(n)
  if n == 0
    bug.Panic("bottom")
  end
  deep(n - 1) + 1
end
defn repeatedPanics()
  for i in 1..20000
    fiber.Wait(fiber.Spawn(() -> deep(3)))
  end
  true
end
isPanicKeepsTheStack() = repeatedPanics()

defn firstNegative(xs) for x in xs return x if x < 0 end "none" end
isReturnIf() = firstNegative([3, -2, -7]) == -2 and firstNegative([1, 2]) == "none"
defn sumUpTo(xs, n)
  total = 0
  for x in xs
    break if total + x > n
    total += x
  end
  total
end
isBreakIf() = sumUpTo([4, 4, 4], 9) == 8 and sumUpTo([], 9) == 0
isValueIf() = (1 if 2 > 1 else 2) == 1 and ("a" if false else "b" if false else "c") == "c"
isValueIfInList() = value.Equal([x * 2 if x > 0 else 0 for x in [1, -2, 3] if x != 3], [2, 0])
defn pick(c) return if c "yes" else "no" end end
isReturnOfIf() = pick(true) == "yes" and pick(false) == "no"
defn countTwos(xs)
  n = 0
  for x in xs if x == 2 n += 1 end end
  n
end
isIfAfterBlockHead() = countTwos([2, 1, 2]) == 2
