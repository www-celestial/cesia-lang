(** The documentation of the language, from the language: what an editor shows. *)
use std/num
use std/sys
use std/cesia
use std/list
use std/math
use std/text
use std/value

(** Twice x, for the test of a function of this file.

      Twice(2) --> 4 *)
Twice(x) = 2 * x

defn Undocumented(a, b = 1)
  a + b
end

(** Two lines
    of documentation.
      Documented(1) --> 2 **)
Documented(x) = x + 1

(** On one line. *)
Short(x) = x

(* Not documentation.
hidden(x) = x *)
Plain(x) = x

isDocBlock() = text.StartsWith("Documented(x)", cesia.Doc(Documented)) and text.Contains("Two lines", cesia.Doc(Documented)) and text.Contains("of documentation.", cesia.Doc(Documented))
isDocBlockOnOneLine() = text.Contains("On one line.", cesia.Doc(Short))
isDocBlockKeepsNoMarks() = not text.Contains("(*", cesia.Doc(Documented)) and not text.Contains("*)", cesia.Doc(Documented)) and not text.Contains("*)", cesia.Doc(Short))
isDocPlainCommentIsNoDoc() = not text.Contains("Not documentation", cesia.Doc(Plain))

isDocOfACesiaFunction() = text.Contains("One more", cesia.Doc("math.Inc")) and text.StartsWith("Inc(x)", cesia.Doc("math.Inc"))
isDocKeepsTheExamples() = text.Contains("Inc(1) --> 2", cesia.Doc("math.Inc"))
isDocOfADefn() = text.StartsWith("FindFirst(f, xs)", cesia.Doc("list.FindFirst"))
isDocOfAModuleFunction() = text.StartsWith("Solve(m, b)", cesia.Doc("num.Solve"))
isDocOfANative() = text.StartsWith("list.Sort(xs)", cesia.Doc("list.Sort"))
isDocOfAModuleNative() = text.StartsWith("sys.Now()", cesia.Doc("sys.Now"))
isDocOfAConstant() = text.StartsWith("math.Pi", cesia.Doc("math.Pi"))
isDocOfAValue() = cesia.Doc(math.Inc) == cesia.Doc("math.Inc") and cesia.Doc(list.Sort) == cesia.Doc("list.Sort") and cesia.Doc(num.Solve) == cesia.Doc("num.Solve")
isDocOfALocalFunction() = text.Contains("Twice x", cesia.Doc(Twice))
isDocWithoutAComment() = text.StartsWith("Undocumented(a, b = 1)", cesia.Doc(Undocumented)) and not text.Contains("\n", cesia.Doc(Undocumented))
isDocOfNothing() = value.IsMissing(cesia.Doc("NoSuchName")) and value.IsMissing(cesia.Doc("num.NoSuchName")) and value.IsMissing(cesia.Doc("no_such_module.X"))
isDocHidesPrivateNames() = value.IsMissing(cesia.Doc("list.runLength")) and value.IsMissing(cesia.Doc("Inc"))
isDocOfALambda() = value.IsMissing(cesia.Doc(x -> x))

isDocNamesOfTheModules() = "std/num" in cesia.DocNames() and not ("num" in cesia.DocNames()) and "std/sys" in cesia.DocNames() and "std/io" in cesia.DocNames() and not ("natives" in cesia.DocNames()) and not ("prelude" in cesia.DocNames())
isDocNamesOfNativesAndCesia() = "list.Map" in cesia.DocNames("std/list") and "list.Sort" in cesia.DocNames("std/list") and not ("list.runLength" in cesia.DocNames("std/list")) and "io.Print" in cesia.DocNames("std/io")
isDocNamesOfAModule() = "num.Solve" in cesia.DocNames("std/num") and value.Equal(cesia.DocNames("pkg/num"), []) and "sys.Now" in cesia.DocNames("std/sys")
isDocNamesOfNothing() = value.Equal(cesia.DocNames("no_such_module"), [])
isDocNamesHasNoKeywords() = not ("keywords" in cesia.DocNames())

isDocOfAKeyword() = text.StartsWith("match\n", cesia.Doc("match")) and text.Contains("patterns", cesia.Doc("match")) and text.StartsWith("?\n", cesia.Doc("?"))
isEveryKeywordHasABlock() = value.Equal(list.Filter(k -> value.IsMissing(cesia.DocEntry(k)), cesia.Keywords()), [])
isKeywordsHoldTheReservedWords() = value.Len(cesia.Keywords()) == 26 and "!" in cesia.Keywords() and "interface" in cesia.Keywords() and "it" in cesia.Keywords()

defn isDocEntryOfANative()
  e = cesia.DocEntry("list.Sort")
  e.Name == "list.Sort" and e.Module == "std/list" and e.Signature == "list.Sort(xs)" and e.Builtin and e.File == "std/natives.ce" and
    value.Equal(e.Examples, ["list.Sort([3, 1, 2]) --> [1, 2, 3]"]) and not text.Contains("-->", e.Text)
end

defn isDocEntryOfAFunction()
  e = cesia.DocEntry("num.Solve")
  e.Module == "std/num" and text.StartsWith("Solve(m, b)", e.Signature) and not e.Builtin and e.File == "std/num.ce" and e.Line > 1
end

isDocEntryOfAModuleNative() = cesia.DocEntry("sys.Read").Module == "std/sys" and cesia.DocEntry("sys.Read").Builtin
isDocEntryOfAKeyword() = cesia.DocEntry("if").Module == "" and cesia.DocEntry("if").Builtin and value.Len(cesia.DocEntry("if").Examples) > 0
isDocEntryOfNothing() = value.IsMissing(cesia.DocEntry("NoSuchName")) and value.IsMissing(cesia.DocEntry("runLength"))
isAssetsOfTheSite() = value.IsText(cesia.Asset("site.css")) and value.IsText(cesia.Asset("site.js")) and value.IsMissing(cesia.Asset("site.ce"))

defn undocumentedNames()
  (** A name without a comment shows only its signature, on one line. *)
  out = []
  for m in cesia.DocNames()
    for name in cesia.DocNames(m)
      doc = cesia.Doc(name)
      if value.IsMissing(doc) or not text.Contains("\n", doc)
        out = list.Append(name, out)
      end
    end
  end
  out
end

isEverythingPublicHasAComment() = value.Equal(undocumentedNames(), [])
