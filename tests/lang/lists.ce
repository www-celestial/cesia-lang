use std/dict
use std/fiber
use std/list
use std/math
use std/result
use std/text
use std/value

defn fails(f, kind)
  (fiber.Wait(fiber.Spawn(f)) then result.MapErr(it.Kind)) == result.Err(kind)
end
isPush() = value.Equal(list.Append(3, [1, 2]), [1, 2, 3]) and value.Equal(list.Append("a", []), ["a"])
isConcat() = value.Equal(list.Concat([1], [2, 3]), [1, 2, 3]) and value.Equal(list.Concat([], []), [])
isReverse() = value.Equal(list.Reverse([1, 2, 3]), [3, 2, 1])
isTake() = value.Equal(list.Take(2, [1, 2, 3]), [1, 2]) and value.Equal(list.Take(9, [1]), [1]) and value.Equal(list.Take(0, [1]), [])
isSkip() = value.Equal(list.Skip(1, [1, 2, 3]), [2, 3]) and value.Equal(list.Skip(9, [1]), [])
isIndexOf() = list.IndexOf(2, [1, 2]) == 2 and value.IsMissing(list.IndexOf(9, [1]))
isSort() = value.Equal(list.Sort([3, 1.5, 2]), [1.5, 2, 3]) and value.Equal(list.Sort(["b", "a"]), ["a", "b"])
isSortKeepsTheOriginal() = value.Equal(kept(), [2, 1])
isOrder() = value.Equal(list.Order([30, 10, 20]), [2, 3, 1])
isOrderStable() = value.Equal(list.Order([1, 1, 0]), [3, 1, 2])
isSortBy() = value.Equal(list.SortBy(it.Age, [{Age: 3}, {Age: 1}]), [{Age: 1}, {Age: 3}])
isSortMixed() = fails(() -> list.Sort([1, "a"]), "type")
isUnique() = value.Equal(list.Unique([1, 2, 1, "a", "a", 1.0]), [1, 2, "a"])
isUniqueAny() = value.Equal(list.Unique([[1], [1], {A: 1}, {A: 1}]), [[1], {A: 1}])
isFlatten() = value.Equal(list.Flatten([[1, 2], [3], 4]), [1, 2, 3, 4])
isZip() = value.Equal(list.Zip([1, 2, 3], ["a", "b"]), [[1, "a"], [2, "b"]])
isCount() = list.Count(it > 1, [1, 2, 3]) == 2
isFlatMap() = value.Equal(list.FlatMap(x -> [x, x], [1, 2]), [1, 1, 2, 2])
isMapValues() = value.Equal(dict.MapValues(it * 2, {"a": 1}), {"a": 2})
isUpper() = text.Upper("aB-é") == "AB-é"
isEndsWith() = ("hello" then text.EndsWith("llo")) and not ("lo" then text.EndsWith("hello"))
isFind() = text.Find("l", "été hello") == 7 and value.IsMissing(text.Find("z", "a")) and text.Find("", "a") == 1
isRepeat() = text.Repeat(3, "ab") == "ababab" and text.Repeat(0, "a") == ""
isChars() = value.Equal(text.Chars("aé"), ["a", "é"])
isCode() = text.Code("é") == 233 and text.Code("a") == 97
isLines() = value.Equal(text.Lines("a\nb\r\nc\n"), ["a", "b", "c"]) and value.Equal(text.Lines(""), [])
isPadLeft() = text.PadLeft(3, "0", "7") == "007" and text.PadLeft(1, "0", "12") == "12"
isPadRight() = text.PadRight(3, ".", "é") == "é.."
isBytes() = value.Equal(text.Bytes("é"), [195, 169]) and text.FromBytes([195, 169]) == "é"
isByte() = text.Byte(1, "a") == 97 and text.ByteLength("é") == 2
isByteSlice() = text.ByteSlice(2, 3, "abcd") == "bc"
isByteFind() = text.ByteFind("c", 1, "abcabc") == 3 and text.ByteFind("c", 4, "abcabc") == 6 and value.IsMissing(text.ByteFind("z", 1, "a"))
isRepeatTooBig() = fails(() -> text.Repeat(-1, "a"), "type")

defn kept()
  xs = [2, 1]
  list.Sort(xs)
  xs
end
isBits() = math.BitAnd(12, 10) == 8 and math.BitOr(12, 10) == 14 and math.BitXor(12, 10) == 6 and math.BitNot(0) == -1
isShift() = math.BitShift(1, 4) == 16 and math.BitShift(16, -4) == 1 and math.BitShift(1, 70) == 0 and math.BitShift(-1, -1) > 0
isRepeatEmpty() = text.Repeat(1000000000000, "") == ""
isPadEmptyFiller() = text.PadLeft(5, "", "a") == "a"
