use std/math
use std/matrix
use std/value
use std/fiber
use std/result

struct P
  X
  Y
end
struct Q
  X
  Y
end
inf = 1 / 0.0

isIntAndFloat() = math.Near(1, 1.0) and math.Near(3, 3.0000000000001)
isNegativeZero() = math.Near(-0.0, 0.0)
isTinyAgainstZero() = not math.Near(1e-300, 0) and math.Near(1e-300, 0, abs = 1e-200)
isNanNearNothing() = not math.Near(math.Nan, math.Nan) and not math.Near(math.Nan, 1.0)
isInfinities() = math.Near(inf, inf) and not math.Near(inf, -inf) and not math.Near(inf, 1e308)
isRelative() = math.Near(100, 101, rel = 0.01) and not math.Near(100, 102, rel = 0.01)
isAbsolute() = math.Near(0.5, 0.6, abs = 0.1) and not math.Near(0.5, 0.7, abs = 0.1)
isTheLargerWins() = math.Near(1e6, 1e6 + 0.5, rel = 1e-9, abs = 1.0)
isFloatArrays() = math.Near(matrix.Ones(2, 3), matrix.Ones(2, 3) + 1e-12) and not math.Near(matrix.Zeros(2, 3), matrix.Ones(2, 3))
isIntArrays() = math.Near([1, 2, 3], [1.0, 2.0, 3.0])
isMixedArrays() = math.Near([1, "a", 2.0], [1.0, "a", 2.0])
isShapes() = not math.Near([1.0, 2.0], [1.0, 2.0, 3.0]) and not math.Near(matrix.Zeros(2, 3), matrix.Zeros(3, 2))
isNested() = math.Near([[1.0, 2.0], [3.0]], [[1.0, 2.0 + 1e-12], [3.0]])
isMaps() = math.Near({A: 1.0, B: [2.0]}, {B: [2.0 + 1e-12], A: 1.0})
isMissingKey() = not math.Near({A: 1.0}, {A: 1.0, B: 2.0}) and not math.Near({A: 1.0, B: 2.0}, {A: 1.0})
isStructs() = math.Near(P(1.0, 2.0), P(1.0, 2.0 + 1e-12)) and not math.Near(P(1.0, 2.0), Q(1.0, 2.0))
isTextAgainstNumber() = not math.Near("1", 1) and math.Near("a", "a")
isNegativeTolerance() = result.IsErr(fiber.Wait(fiber.Spawn(() -> math.Near(1, 1, rel = -1))))
