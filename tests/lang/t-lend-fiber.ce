(** A module variable can be reached by two fibers: a function that sleeps on it keeps the value it was given. *)
use std/sys
use std/fiber
use std/io
use std/result

cell = [1, 2]

defn hold(p)
  sys.Sleep(0.02)
  p[1]
end

readsCell() = hold(cell)

t = fiber.Spawn(readsCell)
sys.Sleep(0.005)
cell[1] = 9
io.Print(result.Unwrap(fiber.Wait(t)))
io.Print(cell[1])
