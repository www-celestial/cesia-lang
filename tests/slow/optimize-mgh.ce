(* Gradients written by hand, for the problems where differences limit the answer, and for Rosenbrock's. *)
defn rosenbrockGradient(x)
  n = value.Len(x)
  g = matrix.Zeros(n)
  for i in 1..n / 2
    a = x[2 * i - 1]
    b = x[2 * i]
    g[2 * i - 1] = -400.0 * a * (b - a * a) - 2.0 * (1.0 - a)
    g[2 * i] = 200.0 * (b - a * a)
  end
  g
end

defn meyerGradient(x)
  g = matrix.Zeros(3)
  for i in 1..16
    d = 45.0 + 5.0 * i + x[3]
    e = math.Exp(x[2] / d)
    g = g + 2.0 * (x[1] * e - meyerY[i]) * [e, x[1] * e / d, -x[1] * e * x[2] / (d * d)]
  end
  g
end

defn gulfGradient(x)
  g = matrix.Zeros(3)
  for i in 1..10
    t = i / 100.0
    y = 25.0 + (-50.0 * math.Log(t)) ^ (2.0 / 3.0)
    u = math.Abs(y - x[2])
    p = u ^ x[3]
    e = math.Exp(-p / x[1])
    side = if y >= x[2] 1.0 else -1.0 end
    g = g + 2.0 * (e - t) * [e * p / (x[1] * x[1]), e * x[3] * u ^ (x[3] - 1.0) * side / x[1], -e * p * math.Log(u) / x[1]]
  end
  g
end

defn osborne1Gradient(x)
  g = matrix.Zeros(5)
  for i in 1..33
    t = 10.0 * (i - 1)
    a = math.Exp(-t * x[4])
    b = math.Exp(-t * x[5])
    g = g - 2.0 * (osborne1Y[i] - (x[1] + x[2] * a + x[3] * b)) * [1.0, a, b, -t * x[2] * a, -t * x[3] * b]
  end
  g
end

defn watsonGradient(x)
  n = value.Len(x)
  g = matrix.Zeros(n)
  for i in 1..29
    t = i / 29.0
    s1 = 0.0
    s2 = 0.0
    for j in 1..n
      if j >= 2
        s1 += (j - 1) * x[j] * t ^ (j - 2)
      end
      s2 += x[j] * t ^ (j - 1)
    end
    r = s1 - s2 ^ 2 - 1.0
    for j in 1..n
      d = -2.0 * s2 * t ^ (j - 1)
      if j >= 2
        d += (j - 1) * t ^ (j - 2)
      end
      g[j] += 2.0 * r * d
    end
  end
  r31 = x[2] - x[1] ^ 2 - 1.0
  g[1] += 2.0 * x[1] - 4.0 * r31 * x[1]
  g[2] += 2.0 * r31
  g
end

gradients = [
  {Name: "rosenbrock", G: rosenbrockGradient},
  {Name: "extended-rosenbrock-10", G: rosenbrockGradient},
  {Name: "meyer", G: meyerGradient},
  {Name: "gulf", G: gulfGradient},
  {Name: "osborne-1", G: osborne1Gradient},
  {Name: "watson-6", G: watsonGradient},
  {Name: "watson-9", G: watsonGradient}
]

sumOfSquares(c) = x -> list.Sum(c.R(x) ^ 2)
named(name) = list.FindFirst(c -> c.Name == name, cases)
relative(g, want) = list.Max(math.Abs(g - want)) / list.Max(math.Abs(want))
tolOf(c) = if c.Name == "gulf" 1.0e-10 else 1.0e-8 end   (** Gulf's valley is flat: at 1e-8, f stops at 4.7e-8 *)

defn reached(fx, want)
  (** Is fx within 1e-8 of one of the minima, relative to it when it isn't 0? *)
  for w in want
    if w == 0.0 and math.Abs(fx) <= 1.0e-8 or w != 0.0 and math.Abs(fx - w) <= 1.0e-8 * math.Abs(w)
      return true
    end
  end
  false
end

isStarts() = list.Count(c -> math.Abs(sumOfSquares(c)(c.X0) - c.F0) > 4.0 * 2.2e-16 * c.F0, cases) == 0
isGradientsByHand() = list.Count(p -> relative(p.G(named(p.Name).X0), named(p.Name).G0) > 1.0e-14, gradients) == 0

defn isGradientsByDifferences()
  (** The gradient of Minimize by central differences at each start, against the exact one: within 1e-7 of its largest
      component, but where the error of the formula is larger, as it says: Brown's badly scaled function has f = 1e12
      there, so that rounding, eps |f| / h, is about 37 against a gradient of 2e6; Osborne 1's exp(-t x4), t up to 320,
      has a third derivative near 1e8, and h^2 |f'''| / 6 is about 3e-4 against 411. *)
  for c in cases
    r = optimize.Minimize(sumOfSquares(c), c.X0, steps = 0)
    g = if result.IsOk(r) r.Value.Gradient else r.Error.Best.Gradient end
    bound = if c.Name == "brown-badly-scaled" 1.0e-5 else if c.Name == "osborne-1" 2.0e-6 else 1.0e-7 end
    if relative(g, c.G0) > bound
      return false
    end
  end
  true
end

limited = ["meyer", "osborne-1", "watson-9"]   (** where the gradient by differences limits f, as below *)

(* Minimize without a gradient from each start, at its tol of 1e-8, run once for the three tests that read it. *)
byDifferences = [optimize.Minimize(sumOfSquares(c), c.X0) for c in cases]
ranFrom(name) = byDifferences[list.IndexOf(name, [c.Name for c in cases])]

defn isMinimizeByDifferences()
  (** From every start but three, Minimize without a gradient reaches a minimum within 1e-8. *)
  for k in 1..value.Len(cases)
    c = cases[k]
    if list.Count(n -> n == c.Name, limited) == 0
      r = if tolOf(c) == 1.0e-8 byDifferences[k] else optimize.Minimize(sumOfSquares(c), c.X0, tol = tolOf(c)) end
      if not (result.IsOk(r) and reached(r.Value.F, c.Want))
        return false
      end
    end
  end
  true
end

defn isMinimizeWithGradients()
  (** With their gradient, the three that differences limit reach it too, and so do the others written by hand. *)
  for p in gradients
    c = named(p.Name)
    r = optimize.Minimize(sumOfSquares(c), c.X0, gradient = p.G, tol = tolOf(c))
    if not (result.IsOk(r) and reached(r.Value.F, c.Want))
      return false
    end
  end
  true
end

defn isLimitOfDifferences()
  (** Without a gradient, the three stop where f no longer falls, short of the last digits: Meyer's within 1e-3 of its
      minimum and Watson's at n = 9 within 1e-5, an Ok, as their gradient has shrunk to 1.5e-8 of its size at the
      start; Osborne 1's within 1e-5 too, but its gradient is still 2.3e-8 of that size: an Err that asks for it. *)
  meyer = ranFrom("meyer")
  watson = ranFrom("watson-9")
  osborne = ranFrom("osborne-1")
  near(r, name, rel) = math.Abs(r.F - named(name).Want[1]) <= rel * named(name).Want[1]
  result.IsOk(meyer) and near(meyer.Value, "meyer", 1.0e-3) and result.IsOk(watson) and
    near(watson.Value, "watson-9", 1.0e-5) and result.IsErr(osborne) and near(osborne.Error.Best, "osborne-1", 1.0e-5) and
    text.Contains("give the gradient", osborne.Error.Message)
end

defn isMinimizeCalls()
  (** The points where f and its gradient are evaluated, each 2n + 1 calls of f by differences: 3,772 on the 39 cases,
      where scipy's L-BFGS-B, given the gradient, takes 2,956; most of the gap is on Meyer, Powell's badly scaled and
      Jennrich and Sampson's, where it stops far from the minimum. *)
  points = 0.0
  for k in 1..value.Len(cases)
    r = byDifferences[k]
    v = if result.IsOk(r) r.Value else r.Error.Best end
    points += v.Evaluations / (2.0 * value.Len(cases[k].X0) + 1.0)
  end
  points <= 3800.0
end

defn isSimplex()
  (** Simplex reaches a minimum within 1e-8 from every start but Box's three-dimensional one, where it stops at 0.0756,
      as scipy's Nelder-Mead does: the method has no proof that it ends at a minimum. It calls f 88,705 times on the 39
      cases, where scipy's Nelder-Mead with the same coefficients makes 90,002 calls. *)
  total = 0
  for c in cases
    r = optimize.Simplex(sumOfSquares(c), c.X0, steps = 100000)
    if not result.IsOk(r)
      return false
    end
    total += r.Value.Evaluations
    if c.Name == "box-3d"
      if math.Abs(r.Value.F - 0.0755887) > 1.0e-6
        return false
      end
    else if not reached(r.Value.F, c.Want)
      return false
    end
  end
  total <= 90002
end
