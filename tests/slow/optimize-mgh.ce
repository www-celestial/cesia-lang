(** The tests of optimize.Minimize and optimize.Simplex on the 35 problems of Moré, Garbow and Hillstrom (1981), from
    their standard starts, four of them at two sizes: f is the sum of the squares of residuals r(x), written from the
    paper. F0 and G0, f and its gradient at the start, come from a second transcription, in Python, with derivatives by
    complex steps; Want holds the minima a case may reach: 0 where the paper gives 0, else the value of MINPACK's
    Levenberg-Marquardt (scipy's least_squares) from the same start at tight tolerances, which matches the paper's six
    digits, or a local minimum that the paper lists beside it. Slow by nature, the whole suite to its last digits: 1.6 s
    of CPU on the typed path, 4 s on the other; tools/check.sh runs it, past the change loop, and tests/lang/optimize.ce
    stays in the loop. *)
use std/list
use std/math
use std/matrix
use std/optimize
use std/result
use std/text
use std/value

defn rosenbrock(x)
  [10.0 * (x[2] - x[1] ^ 2), 1.0 - x[1]]
end

defn freudensteinRoth(x)
  [-13.0 + x[1] + ((5.0 - x[2]) * x[2] - 2.0) * x[2], -29.0 + x[1] + ((x[2] + 1.0) * x[2] - 14.0) * x[2]]
end

powellBadlyScaled(x) = [1.0e4 * x[1] * x[2] - 1.0, math.Exp(-x[1]) + math.Exp(-x[2]) - 1.0001]
brownBadlyScaled(x) = [x[1] - 1.0e6, x[2] - 2.0e-6, x[1] * x[2] - 2.0]
beale(x) = [1.5 - x[1] * (1.0 - x[2]), 2.25 - x[1] * (1.0 - x[2] ^ 2), 2.625 - x[1] * (1.0 - x[2] ^ 3)]
jennrichSampson(x) = [2.0 + 2.0 * i - (math.Exp(i * x[1]) + math.Exp(i * x[2])) for i in 1..10]

defn helicalValley(x)
  theta = 0.25
  if x[1] > 0.0
    theta = math.Atan(x[2] / x[1]) / (2.0 * math.Pi)
  else if x[1] < 0.0
    theta = math.Atan(x[2] / x[1]) / (2.0 * math.Pi) + 0.5
  else if x[2] < 0.0
    theta = -0.25
  end
  [10.0 * (x[3] - 10.0 * theta), 10.0 * (math.Sqrt(x[1] ^ 2 + x[2] ^ 2) - 1.0), x[3]]
end

bardY = [0.14, 0.18, 0.22, 0.25, 0.29, 0.32, 0.35, 0.39, 0.37, 0.58, 0.73, 0.96, 1.34, 2.10, 4.39]
bard(x) = [bardY[i] - (x[1] + i / ((16 - i) * x[2] + list.Min(i, 16 - i) * x[3])) for i in 1..15]
gaussianY = [0.0009, 0.0044, 0.0175, 0.0540, 0.1295, 0.2420, 0.3521, 0.3989, 0.3521, 0.2420, 0.1295, 0.0540, 0.0175, 0.0044, 0.0009]
gaussian(x) = [x[1] * math.Exp(-x[2] * ((8.0 - i) / 2.0 - x[3]) ^ 2 / 2.0) - gaussianY[i] for i in 1..15]
meyerY = [34780.0, 28610.0, 23650.0, 19630.0, 16370.0, 13720.0, 11540.0, 9744.0, 8261.0, 7030.0, 6005.0, 5147.0, 4427.0, 3820.0, 3307.0, 2872.0]
meyer(x) = [x[1] * math.Exp(x[2] / (45.0 + 5.0 * i + x[3])) - meyerY[i] for i in 1..16]

defn gulf(x)
  r = matrix.Zeros(10)
  for i in 1..10
    t = i / 100.0
    y = 25.0 + (-50.0 * math.Log(t)) ^ (2.0 / 3.0)
    r[i] = math.Exp(-math.Abs(y - x[2]) ^ x[3] / x[1]) - t
  end
  r
end

box3d(x) = [math.Exp(-0.1 * i * x[1]) - math.Exp(-0.1 * i * x[2]) - x[3] * (math.Exp(-0.1 * i) - math.Exp(-1.0 * i)) for i in 1..10]
powellSingular(x) = [x[1] + 10.0 * x[2], math.Sqrt(5.0) * (x[3] - x[4]), (x[2] - 2.0 * x[3]) ^ 2, math.Sqrt(10.0) * (x[1] - x[4]) ^ 2]
wood(x) = [10.0 * (x[2] - x[1] ^ 2), 1.0 - x[1], math.Sqrt(90.0) * (x[4] - x[3] ^ 2), 1.0 - x[3], math.Sqrt(10.0) * (x[2] + x[4] - 2.0), (x[2] - x[4]) / math.Sqrt(10.0)]
kowalikY = [0.1957, 0.1947, 0.1735, 0.1600, 0.0844, 0.0627, 0.0456, 0.0342, 0.0323, 0.0235, 0.0246]
kowalikU = [4.0, 2.0, 1.0, 0.5, 0.25, 0.167, 0.125, 0.1, 0.0833, 0.0714, 0.0625]
kowalikOsborne(x) = [kowalikY[i] - x[1] * (kowalikU[i] ^ 2 + kowalikU[i] * x[2]) / (kowalikU[i] ^ 2 + kowalikU[i] * x[3] + x[4]) for i in 1..11]
brownDennis(x) = [(x[1] + i / 5.0 * x[2] - math.Exp(i / 5.0)) ^ 2 + (x[3] + x[4] * math.Sin(i / 5.0) - math.Cos(i / 5.0)) ^ 2 for i in 1..20]
osborne1Y = [0.844, 0.908, 0.932, 0.936, 0.925, 0.908, 0.881, 0.850, 0.818, 0.784, 0.751, 0.718, 0.685, 0.658, 0.628, 0.603, 0.580,
             0.558, 0.538, 0.522, 0.506, 0.490, 0.478, 0.467, 0.457, 0.448, 0.438, 0.431, 0.424, 0.420, 0.414, 0.411, 0.406]
osborne1(x) = [osborne1Y[i] - (x[1] + x[2] * math.Exp(-10.0 * (i - 1) * x[4]) + x[3] * math.Exp(-10.0 * (i - 1) * x[5])) for i in 1..33]

defn biggs(x)
  r = matrix.Zeros(13)
  for i in 1..13
    t = 0.1 * i
    y = math.Exp(-t) - 5.0 * math.Exp(-10.0 * t) + 3.0 * math.Exp(-4.0 * t)
    r[i] = x[3] * math.Exp(-t * x[1]) - x[4] * math.Exp(-t * x[2]) + x[6] * math.Exp(-t * x[5]) - y
  end
  r
end

osborne2Y = [1.366, 1.191, 1.112, 1.013, 0.991, 0.885, 0.831, 0.847, 0.786, 0.725, 0.746, 0.679, 0.608, 0.655, 0.616, 0.606,
             0.602, 0.626, 0.651, 0.724, 0.649, 0.649, 0.694, 0.644, 0.624, 0.661, 0.612, 0.558, 0.533, 0.495, 0.500, 0.423,
             0.395, 0.375, 0.372, 0.391, 0.396, 0.405, 0.428, 0.429, 0.523, 0.562, 0.607, 0.653, 0.672, 0.708, 0.633, 0.668,
             0.645, 0.632, 0.591, 0.559, 0.597, 0.625, 0.739, 0.710, 0.729, 0.720, 0.636, 0.581, 0.428, 0.292, 0.162, 0.098,
             0.054]

defn osborne2(x)
  r = matrix.Zeros(65)
  for i in 1..65
    t = (i - 1) / 10.0
    r[i] = osborne2Y[i] - (x[1] * math.Exp(-t * x[5]) + x[2] * math.Exp(-(t - x[9]) ^ 2 * x[6]) +
      x[3] * math.Exp(-(t - x[10]) ^ 2 * x[7]) + x[4] * math.Exp(-(t - x[11]) ^ 2 * x[8]))
  end
  r
end

defn watson(x)
  n = value.Len(x)
  r = matrix.Zeros(31)
  for i in 1..29
    t = i / 29.0
    s1 = 0.0
    for j in 2..n
      s1 += (j - 1) * x[j] * t ^ (j - 2)
    end
    s2 = 0.0
    for j in 1..n
      s2 += x[j] * t ^ (j - 1)
    end
    r[i] = s1 - s2 ^ 2 - 1.0
  end
  r[30] = x[1]
  r[31] = x[2] - x[1] ^ 2 - 1.0
  r
end

defn extendedRosenbrock(x)
  n = value.Len(x)
  r = matrix.Zeros(n)
  for i in 1..n / 2
    r[2 * i - 1] = 10.0 * (x[2 * i] - x[2 * i - 1] ^ 2)
    r[2 * i] = 1.0 - x[2 * i - 1]
  end
  r
end

defn extendedPowell(x)
  n = value.Len(x)
  r = matrix.Zeros(n)
  for i in 1..n / 4
    k = 4 * i - 3
    r[k] = x[k] + 10.0 * x[k + 1]
    r[k + 1] = math.Sqrt(5.0) * (x[k + 2] - x[k + 3])
    r[k + 2] = (x[k + 1] - 2.0 * x[k + 2]) ^ 2
    r[k + 3] = math.Sqrt(10.0) * (x[k] - x[k + 3]) ^ 2
  end
  r
end

defn penalty1(x)
  n = value.Len(x)
  r = matrix.Zeros(n + 1)
  for i in 1..n
    r[i] = math.Sqrt(1.0e-5) * (x[i] - 1.0)
  end
  r[n + 1] = list.Sum(x * x) - 0.25
  r
end

defn penalty2(x)
  n = value.Len(x)
  r = matrix.Zeros(2 * n)
  a = math.Sqrt(1.0e-5)
  r[1] = x[1] - 0.2
  for i in 2..n
    y = math.Exp(i / 10.0) + math.Exp((i - 1) / 10.0)
    r[i] = a * (math.Exp(x[i] / 10.0) + math.Exp(x[i - 1] / 10.0) - y)
  end
  for i in n + 1..2 * n - 1
    r[i] = a * (math.Exp(x[i - n + 1] / 10.0) - math.Exp(-0.1))
  end
  s = 0.0
  for j in 1..n
    s += (n - j + 1) * x[j] ^ 2
  end
  r[2 * n] = s - 1.0
  r
end

defn variablyDimensioned(x)
  n = value.Len(x)
  r = matrix.Zeros(n + 2)
  s = 0.0
  for j in 1..n
    r[j] = x[j] - 1.0
    s += j * (x[j] - 1.0)
  end
  r[n + 1] = s
  r[n + 2] = s ^ 2
  r
end

defn trigonometric(x)
  n = value.Len(x)
  c = list.Sum(math.Cos(x))
  [n - c + i * (1.0 - math.Cos(x[i])) - math.Sin(x[i]) for i in 1..n]
end

defn brownAlmostLinear(x)
  n = value.Len(x)
  s = list.Sum(x)
  r = matrix.Zeros(n)
  p = 1.0
  for i in 1..n
    p *= x[i]
  end
  for i in 1..n - 1
    r[i] = x[i] + s - (n + 1)
  end
  r[n] = p - 1.0
  r
end

defn boundaryValue(x)
  n = value.Len(x)
  h = 1.0 / (n + 1)
  r = matrix.Zeros(n)
  for i in 1..n
    before = if i > 1 x[i - 1] else 0.0 end
    after = if i < n x[i + 1] else 0.0 end
    r[i] = 2.0 * x[i] - before - after + h ^ 2 * (x[i] + i * h + 1.0) ^ 3 / 2.0
  end
  r
end

defn integralEquation(x)
  n = value.Len(x)
  h = 1.0 / (n + 1)
  r = matrix.Zeros(n)
  for i in 1..n
    ti = i * h
    s1 = 0.0
    for j in 1..i
      s1 += j * h * (x[j] + j * h + 1.0) ^ 3
    end
    s2 = 0.0
    for j in i + 1..n
      s2 += (1.0 - j * h) * (x[j] + j * h + 1.0) ^ 3
    end
    r[i] = x[i] + h * ((1.0 - ti) * s1 + ti * s2) / 2.0
  end
  r
end

defn broydenTridiagonal(x)
  n = value.Len(x)
  r = matrix.Zeros(n)
  for i in 1..n
    before = if i > 1 x[i - 1] else 0.0 end
    after = if i < n x[i + 1] else 0.0 end
    r[i] = (3.0 - 2.0 * x[i]) * x[i] - before - 2.0 * after + 1.0
  end
  r
end

defn broydenBanded(x)
  n = value.Len(x)
  r = matrix.Zeros(n)
  for i in 1..n
    s = 0.0
    for j in list.Max(1, i - 5)..list.Min(n, i + 1)
      if j != i
        s += x[j] * (1.0 + x[j])
      end
    end
    r[i] = x[i] * (2.0 + 5.0 * x[i] ^ 2) + 1.0 - s
  end
  r
end

defn linearFullRank(x)
  n = value.Len(x)
  m = 20
  s = list.Sum(x)
  r = matrix.Zeros(m)
  for i in 1..m
    r[i] = -2.0 / m * s - 1.0
    if i <= n
      r[i] += x[i]
    end
  end
  r
end

defn linearRank1(x)
  s = 0.0
  for j in 1..value.Len(x)
    s += j * x[j]
  end
  [i * s - 1.0 for i in 1..20]
end

defn linearRank1Zero(x)
  n = value.Len(x)
  s = 0.0
  for j in 2..n - 1
    s += j * x[j]
  end
  r = [(i - 1) * s - 1.0 for i in 1..20]
  r[1] = -1.0
  r[20] = -1.0
  r
end

defn chebyquad(x)
  n = value.Len(x)
  r = matrix.Zeros(n)
  for j in 1..n
    y = 2.0 * x[j] - 1.0
    t0 = 1.0
    t1 = y
    r[1] += t1
    for i in 2..n
      t2 = 2.0 * y * t1 - t0
      r[i] += t2
      t0 = t1
      t1 = t2
    end
  end
  for i in 1..n
    r[i] = r[i] / n - (if math.Mod(i, 2) == 1 0.0 else -1.0 / (i * i - 1.0) end)
  end
  r
end

