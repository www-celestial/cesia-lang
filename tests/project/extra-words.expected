usage: cesia run [--allow LIST] [--limit LIST] [--watch] [--debugger FILE] [--no-spec] [--no-jit] [--seed N] file.ce [args...]
       cesia test [path] [--no-spec]
       cesia do [task]
       cesia new name
       cesia pkg [install | update [label] [--to tag] | add url@tag [package...] | move old new | --check]
       cesia upgrade [--nightly]
       cesia doc [name]
       cesia doc --site [folder] [--open]
       cesia version
exit 2
