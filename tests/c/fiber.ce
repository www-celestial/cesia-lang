(** A C function that needs a large stack, from a fiber whose own stack is small. *)
use std/c
use std/fiber
use std/io
use std/result
use std/sys

lib = result.Unwrap(c.Open(sys.Args[1]))
deep = result.Unwrap(c.Fn("deep_stack", [], "i64", lib))
io.Print(fiber.Wait(fiber.Spawn(() -> deep())) == result.Ok(deep()))
