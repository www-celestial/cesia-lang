(** A name is scanned for a zero byte, without any permission: a long one pays like any other long text. *)
use std/c
use std/fiber
use std/io

name = "abcdefghij"
for i in 1..17
  name = "$name$name"
end
for i in 1..20
  fiber.Wait(fiber.Spawn(() -> c.Open(name)))
end
io.Print("the limit should have stopped this")
