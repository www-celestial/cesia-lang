(** Bytes could spell any address, so a pointer can't come from a block before a library is open. *)
use std/c
use std/fiber
use std/io
use std/result
use std/value

defn message(f)
  match fiber.Wait(fiber.Spawn(f))
    result.Err(e) -> io.Print(e.Message)
    result.Ok(v) -> io.Print("no panic: $v")
  end
end

b = c.Alloc(8)
c.Set("i64", 0, 12345, b)
message(() -> c.Get("ptr", 0, b))
message(() -> c.Text(b))
message(() -> c.Text(missing))
message(() -> c.Set("ptr", 0, b, b))
c.Open("m", version = 6)
io.Print(value.IsMissing(c.Get("ptr", 0, b)))
