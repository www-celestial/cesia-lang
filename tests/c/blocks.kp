-- Blocks need no permission: they are checked, and counted against the memory limit.
use c

b = c.alloc(64)
print(c.get("i64", 0, b), c.get("u8", 63, b), c.get("f64", 56, b), c.get("bool", 0, b))

function round_trip(type, value, last)
  c.set(type, 0, value, b)
  c.set(type, last, value, b)
  [c.get(type, 0, b), c.get(type, last, b)]
end

print(round_trip("i8", -5, 63))
print(round_trip("u8", 250, 63))
print(round_trip("i16", -300, 62))
print(round_trip("u16", 65000, 62))
print(round_trip("i32", -70000, 60))
print(round_trip("u32", 4000000000, 60))
print(round_trip("i64", -5000000000, 56))
print(round_trip("u64", 5000000000, 56))
print(round_trip("f32", 1.5, 60))
print(round_trip("f64", 0.1, 56))
print(round_trip("bool", true, 63))
print(c.free(b))
