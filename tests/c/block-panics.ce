use std/c
use std/fiber
use std/io
use std/result
use std/sys

lib = result.Unwrap(c.Open(sys.Args[1]))
echo = result.Unwrap(c.Fn("echo_ptr", ["ptr"], "ptr", lib))

defn message(f)
  match fiber.Wait(fiber.Spawn(f))
    result.Err(e) -> io.Print(e.Message)
    result.Ok(v) -> io.Print("no panic: $v")
  end
end

b = c.Alloc(64)
freed = c.Alloc(8)
c.Free(freed)

message(() -> c.Alloc(0))
message(() -> c.Alloc(-1))
message(() -> c.Alloc("x"))
message(() -> c.Get("i32", 61, b))
message(() -> c.Get("i32", -1, b))
message(() -> c.Get("u8", 64, b))
message(() -> c.Get("i32", 4611686018427387903, b))
message(() -> c.Get("i32", "x", b))
message(() -> c.Get("text", 0, b))
message(() -> c.Set("void", 0, 1, b))
message(() -> c.Set("u8", 0, 300, b))
message(() -> c.Get("u8", 0, 5))
message(() -> c.Get("u8", 0, echo(b)))
message(() -> c.Get("u8", 0, freed))
message(() -> echo(freed))
message(() -> c.Set("ptr", 0, freed, b))
message(() -> c.Free(freed))
message(() -> c.Free(5))
message(() -> c.Text(missing))
message(() -> c.Text(b))
