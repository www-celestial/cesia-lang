use std/c
use std/fiber
use std/io
use std/list
use std/result
use std/sys
use std/text

lib = result.Unwrap(c.Open(sys.Args[1]))
bound(name, inputs, output) = result.Unwrap(c.Fn(name, inputs, output, lib))
echo(type) = bound("echo_$type", [type], type)

defn message(f)
  match fiber.Wait(fiber.Spawn(f))
    result.Err(e) -> io.Print(e.Message)
    result.Ok(v) -> io.Print("no panic: $v")
  end
end

lengthOf = bound("text_length", ["text"], "i64")

message(() -> echo("u8")(300))
message(() -> echo("i8")(-129))
message(() -> echo("u64")(-1))
message(() -> echo("i32")(1.5))
message(() -> echo("f64")("x"))
message(() -> echo("bool")(1))
message(() -> c.Fn("x", ["i33"], "i32", lib))
message(() -> c.Fn("x", ["void"], "i32", lib))
message(() -> c.Fn("x", list.Fill("i32", 61), "i32", lib))
message(() -> c.Fn("x", [], "i32", 5))
message(() -> lengthOf("a$(text.Char(0))b"))
message(() -> lengthOf(5))
message(() -> echo("ptr")(5))
message(() -> bound("huge_u64", [], "u64")())
message(() -> bound("huge_i64", [], "i64")())
