(** Calls the function of every shape in the fixture, with every class of argument. *)
use std/c
use std/io
use std/list
use std/math
use std/result
use std/sys

pow2(k) = list.Reduce((acc, i) -> acc * 2, 1, 1..k)
isFloat(mask, k) = math.Mod(math.Div(mask, pow2(k)), 2) == 1
valueAt(mask, k) = if isFloat(mask, k) k + 0.5 else k + 10 end
signature(n, mask) = [if isFloat(mask, k) "f64" else "i64" end for k in 0..n - 1]
sumOf(n, mask) = list.Reduce((acc, k) -> acc + (k + 1) * valueAt(mask, k), 0.0, 0..n - 1)

defn apply(f, n, a)
  match n
    0 -> f()
    1 -> f(a[1])
    2 -> f(a[1], a[2])
    3 -> f(a[1], a[2], a[3])
    4 -> f(a[1], a[2], a[3], a[4])
    5 -> f(a[1], a[2], a[3], a[4], a[5])
    else -> f(a[1], a[2], a[3], a[4], a[5], a[6])
  end
end

defn check(lib, kind, n, mask)
  name = "shape_$(kind)_$(n)_$mask"
  f = c.Fn(name, signature(n, mask), if kind == "d" "f64" else "i64" end, lib)?
  got = apply(f, n, [valueAt(mask, k) for k in 0..n - 1])
  want = if kind == "d" sumOf(n, mask) else 2.0 * sumOf(n, mask) end
  if 1.0 * got == want result.Ok(1) else result.Err("$name gave $got, not $want") end
end

defn allShapes(lib)
  count = 0
  for n in 0..6
    for mask in 0..pow2(n) - 1
      for kind in ["i", "d"]
        check(lib, kind, n, mask)?
        count += 1
      end
    end
  end
  result.Ok("$count shapes")
end

io.Print(c.Open(sys.Args[1]) then result.AndThen(allShapes))
