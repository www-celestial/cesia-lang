(** A block given to C is a pointer, and its address can be stored in another block. *)
use std/c
use std/io
use std/result
use std/sys
use std/value

lib = result.Unwrap(c.Open(sys.Args[1]))
echo = result.Unwrap(c.Fn("echo_ptr", ["ptr"], "ptr", lib))
b = c.Alloc(8)
holder = c.Alloc(8)
c.Set("ptr", 0, b, holder)
io.Print(echo(b) == echo(b), echo(b) == b, c.Get("ptr", 0, holder) == echo(b))
c.Set("ptr", 0, echo(b), holder)
io.Print(c.Get("ptr", 0, holder) == echo(b))
c.Set("ptr", 0, missing, holder)
io.Print(value.IsMissing(c.Get("ptr", 0, holder)))
