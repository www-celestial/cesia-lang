(** Blocks need no permission: they are checked, and counted against the memory limit. *)
use std/c
use std/io

b = c.Alloc(64)
io.Print(c.Get("i64", 0, b), c.Get("u8", 63, b), c.Get("f64", 56, b), c.Get("bool", 0, b))

defn roundTrip(type, value, last)
  c.Set(type, 0, value, b)
  c.Set(type, last, value, b)
  [c.Get(type, 0, b), c.Get(type, last, b)]
end

io.Print(roundTrip("i8", -5, 63))
io.Print(roundTrip("u8", 250, 63))
io.Print(roundTrip("i16", -300, 62))
io.Print(roundTrip("u16", 65000, 62))
io.Print(roundTrip("i32", -70000, 60))
io.Print(roundTrip("u32", 4000000000, 60))
io.Print(roundTrip("i64", -5000000000, 56))
io.Print(roundTrip("u64", 5000000000, 56))
io.Print(roundTrip("f32", 1.5, 60))
io.Print(roundTrip("f64", 0.1, 56))
io.Print(roundTrip("bool", true, 63))
io.Print(c.Free(b))
