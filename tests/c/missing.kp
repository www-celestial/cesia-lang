use c

function check()
  lib = c.open("m", version = 6)?
  c.fn("kepler_no_such_function", [], "void", lib)
end

print(c.open("kepler_no_such_library") then map_err(it.kind))
print(c.open("kepler_no_such_library") then map_err(e -> e.message then starts_with("Can't load kepler_no_such_library: ")))
print(check() then map_err(it.message))
