use crypto
use encode

defn main()
  s = crypto.open()?
  print(encode.hex(crypto.sha256("abc", s)))
  print(take(1, [encode.hex(crypto.sha512("abc", s))]))
  print(encode.hex(crypto.hmac_sha256("key", "The quick brown fox jumps over the lazy dog", s)))
  print(encode.hex(crypto.blake2b("abc", s, size = 64)))
  print(byte_length(crypto.random(16, s)), crypto.random(16, s) != crypto.random(16, s))
  print(crypto.same("abc", "abc", s), crypto.same("abc", "abd", s), crypto.same("a", "ab", s))

  key = crypto.secret_key(s)
  box = crypto.seal("zero$(char(0))byte", key, s)
  print(byte_length(box), crypto.unseal(box, key, s) then map_ok(byte_length))
  print(crypto.unseal(box, crypto.secret_key(s), s) then map_err(it.message))
  print(is_err(crypto.unseal("short", key, s)))
  other = if byte(1, box) == 120 "y" else "x" end
  print(crypto.unseal("$other$(byte_slice(2, byte_length(box), box))", key, s) then is_err)
  print(crypto.seal("same", key, s) != crypto.seal("same", key, s))

  alice = crypto.box_pair(s)
  bob = crypto.box_pair(s)
  sent = crypto.box_seal("hello bob", bob.public, alice.secret, s)
  print(crypto.box_open(sent, alice.public, bob.secret, s))
  print(is_err(crypto.box_open(sent, bob.public, bob.secret, s)))

  pair = crypto.sign_pair(s)
  signature = crypto.sign("message", pair.secret, s)
  print(byte_length(signature), crypto.verify(signature, "message", pair.public, s), crypto.verify(signature, "other", pair.public, s))

  stored = crypto.hash_password("secret", s)
  print(starts_with("$$argon2id$$", stored), crypto.check_password("secret", stored, s), crypto.check_password("wrong", stored, s))
  print(fails(() -> crypto.blake2b("abc", s, size = 100)))
  print(fails(() -> crypto.seal("m", "short", s)))
  print(fails(() -> crypto.sign("m", "short", s)))
  print(fails(() -> crypto.box_seal("m", "a", "b", s)))
  print(crypto.verify("x", "m", "y", s))
  print(crypto.check_password("p", repeat(200, "x"), s))
  Ok(missing)
end

defn fails(f)
  match wait(spawn(f))
    Ok(v) -> "no failure"
    Err(e) -> e.message
  end
end

print(main())
