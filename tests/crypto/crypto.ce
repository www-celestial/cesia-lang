use std/crypto
use std/encode
use std/fiber
use std/io
use std/list
use std/result
use std/text

defn main()
  s = crypto.Open()?
  io.Print(encode.Hex(crypto.Sha256("abc", s)))
  io.Print(list.Take(1, [encode.Hex(crypto.Sha512("abc", s))]))
  io.Print(encode.Hex(crypto.HmacSha256("key", "The quick brown fox jumps over the lazy dog", s)))
  io.Print(encode.Hex(crypto.Blake2b("abc", s, size = 64)))
  io.Print(text.ByteLength(crypto.Random(16, s)), crypto.Random(16, s) != crypto.Random(16, s))
  io.Print(crypto.IsSame("abc", "abc", s), crypto.IsSame("abc", "abd", s), crypto.IsSame("a", "ab", s))

  key = crypto.SecretKey(s)
  box = crypto.Seal("zero$(text.Char(0))byte", key, s)
  io.Print(text.ByteLength(box), crypto.Unseal(box, key, s) then result.MapOk(text.ByteLength))
  io.Print(crypto.Unseal(box, crypto.SecretKey(s), s) then result.MapErr(it.Message))
  io.Print(result.IsErr(crypto.Unseal("short", key, s)))
  other = if text.Byte(1, box) == 120 "y" else "x" end
  io.Print(crypto.Unseal("$other$(text.ByteSlice(2, text.ByteLength(box), box))", key, s) then result.IsErr)
  io.Print(crypto.Seal("same", key, s) != crypto.Seal("same", key, s))

  alice = crypto.BoxPair(s)
  bob = crypto.BoxPair(s)
  sent = crypto.BoxSeal("hello bob", bob.Public, alice.Secret, s)
  io.Print(crypto.BoxOpen(sent, alice.Public, bob.Secret, s))
  io.Print(result.IsErr(crypto.BoxOpen(sent, bob.Public, bob.Secret, s)))

  pair = crypto.SignPair(s)
  signature = crypto.Sign("message", pair.Secret, s)
  io.Print(text.ByteLength(signature), crypto.Verify(signature, "message", pair.Public, s), crypto.Verify(signature, "other", pair.Public, s))

  stored = crypto.HashPassword("secret", s)
  io.Print(text.StartsWith("$$argon2id$$", stored), crypto.CheckPassword("secret", stored, s), crypto.CheckPassword("wrong", stored, s))
  io.Print(fails(() -> crypto.Blake2b("abc", s, size = 100)))
  io.Print(fails(() -> crypto.Seal("m", "short", s)))
  io.Print(fails(() -> crypto.Sign("m", "short", s)))
  io.Print(fails(() -> crypto.BoxSeal("m", "a", "b", s)))
  io.Print(crypto.Verify("x", "m", "y", s))
  io.Print(crypto.CheckPassword("p", text.Repeat(200, "x"), s))
  result.Ok(missing)
end

defn fails(f)
  match fiber.Wait(fiber.Spawn(f))
    result.Ok(v) -> "no failure"
    result.Err(e) -> e.Message
  end
end

io.Print(main())
