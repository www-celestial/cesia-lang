(** CheckPassword and HashPassword run Argon2id, 64 MiB and tens of milliseconds, away from the fibers: a fiber that
    sleeps 1 ms keeps waking while they run, and many checks at once each give their own answer. *)
use std/crypto
use std/fiber
use std/io
use std/list
use std/result
use std/sys

s = result.Unwrap(crypto.Open())
stored = crypto.HashPassword("correct horse", s)

defn ticksDuring(f)
  stop = fiber.Channel(size = 1)
  ticker = fiber.Spawn(defn ()
    ticks = 0
    while result.IsErr(fiber.Receive(stop, timeout = 0.001))
      ticks += 1
    end
    ticks
  end)
  sys.Sleep(0)
  f()
  fiber.Send(true, stop)
  fiber.Wait(ticker).Value
end

io.Print("ticks while a password is checked:", ticksDuring(() -> crypto.CheckPassword("correct horse", stored, s)) > 5)
io.Print("ticks while a password is hashed:", ticksDuring(() -> crypto.HashPassword("staple", s)) > 5)
guesses = ["correct horse", "wrong horse", "correct horse", "Correct horse", "correct horse ", "correct horse"]
checks = [fiber.Spawn(() -> crypto.CheckPassword(g, stored, s)) for g in guesses]
io.Print("answers:", [fiber.Wait(t).Value for t in checks])
