(library
 (name kepler_sys)
 (libraries kepler unix)
 (foreign_stubs
  (language c)
  (names stubs ffi calls linalg))
 (c_library_flags
  (:include c_flags.sexp)))

(rule
 (targets calls.c)
 (action
  (with-stdout-to
   %{targets}
   (run ../gen/gen_calls.exe calls))))

(rule
 (enabled_if
  (= %{system} linux))
 (action
  (with-stdout-to
   c_flags.sexp
   (echo "(-ldl)"))))

(rule
 (enabled_if
  (<> %{system} linux))
 (action
  (with-stdout-to
   c_flags.sexp
   (echo "()"))))

(rule
 (enabled_if
  (= %{system} linux))
 (action
  (copy epoll.ml.in backend.ml)))

(rule
 (enabled_if
  (<> %{system} linux))
 (action
  (copy select.ml.in backend.ml)))
