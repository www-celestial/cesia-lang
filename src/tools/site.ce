(** cesia doc --site: the documentation of a project as static pages in a folder, read from there with no server and no
    request to anyone else. The reference has a page for each module, each public name and each keyword, from the (** *) of
    the code. The books of the project, each a folder of docs/, docs/book/ the home: their pages run their cesia blocks at each build. Run by the binary
    as cesia doc --site [folder] [--open], which gives this tool the root of the project, the folder and the folder of the
    cache, all from the top of the file system. A build that finds a mistake writes it as file:line and fails. *)
use std/sys
use std/cesia
use std/json
use std/markdown
use std/web
use std/syntax
use std/columns

quote = Char(34)
keywords = cesia.Keywords()

(* The class of each role of std/syntax, in its order: keyword, name, text, number, comment, plain, field. *)
classes = ["k", "n", "s", "m", "c", "", "f"]

escape(t) = web.Escape(t)
from(k, t) = ByteSlice(k, ByteLength(t), t)   (** The text from byte k. *)
up(path) = Repeat(Len(Split("/", path)) - 1, "../")   (** From a page to the root of the site. *)
parent(path) = Join("/", Butlast(Split("/", path)))

defn rel(path, target)
  (** The link from the page at path to the file at target, both from the root: "Sort.html" next to it, "../std/num.html". *)
  from = Butlast(Split("/", path))
  to = Split("/", target)
  k = 1
  while k <= Len(from) and k < Len(to) and from[k] == to[k]
    k += 1
  end
  Str(Repeat(Len(from) - k + 1, "../"), Join("/", Skip(k - 1, to)))
end

defn inlineHtml(text, hooks)
  (** The HTML of a text of one paragraph, without its <p>, for a list or a table. *)
  h = html(text, hooks)
  if StartsWith("<p>", h) and EndsWith("</p>\n", h) and not Contains("<p>", ByteSlice(4, ByteLength(h), h)) ByteSlice(4, ByteLength(h) - 5, h) else h end
end

defn colored(code)
  (** Cesia code as HTML, each word in a span of its role. *)
  state = syntax.FirstState
  out = []
  for line in Lines(code)
    r = syntax.Tokens(line, state)
    state = r.State
    out = Append(Join("", [if t[1] == syntax.Plain escape(t[2]) else "<span class=$quote$(classes[t[1]])$quote>$(escape(t[2]))</span>" end for t in r.Tokens]), out)
  end
  Join("\n", out)
end

codeBlock(code) = "<pre><code class=\"cesia\">$(colored(code))</code></pre>\n"

defn slug(text)
  (** The id of a heading: its letters and digits in lower case, words joined by -. *)
  words = Split(" ", Trim(Lower(Join("", [if (b >= 97 and b <= 122) or (b >= 48 and b <= 57) or b >= 128 Char(b) else " " end for b in Bytes(Lower(text))]))))
  Join("-", Filter(w -> w != "", words))
end

wordFile(w) = if w == "?" "question" else if w == ".." "range" else w end   (** The file of a keyword: ? would start the query of a URL. *)

defn shortOf(name, m)
  (** The name inside its module: Solve for num.Solve, Date.Parse for date.Date.Parse. *)
  (* A name is qualified by the code name of its module, num.Solve, or by its whole path when that name leads elsewhere:
     deps/someone/tools/src/count.Words. *)
  for prefix in [Str(m, "."), Str(Last(Split("/", m)), ".")]
    if m != "prelude" and StartsWith(prefix, name)
      return ByteSlice(ByteLength(prefix) + 1, ByteLength(name), name)
    end
  end
  name
end

modulePath(m) = "ref/$m.html"
namePath(m, name) = "ref/$m/$(shortOf(name, m)).html"
keyPath(w) = "key/$(wordFile(w)).html"

defn isNameLike(t)
  (** Is a [t] meant as a link: a capital, a dot or a keyword in a word of the code? Else it stays text, as [x] does. *)
  plain = t != "" and All([(b >= 65 and b <= 90) or (b >= 97 and b <= 122) or (b >= 48 and b <= 57) or b == 46 or b == 47 or b == 95 or b == 63 for b in Bytes(t)])
  plain and (t != Lower(t) or Contains(".", t) or t in keywords)
end

defn bookTarget(site, book, f)
  (** The page of the site that a link to f leads to, written in a page of docs/book; or missing. *)
  parts = []
  for part in Split("/", "$book/$f")
    if part == ".." and Len(parts) > 0
      parts = Butlast(parts)
    else if part != "." and part != ""
      parts = Append(part, parts)
    end
  end
  if Len(parts) < 2
    return missing
  end
  page = Str(if parts[1] == site.Home "" else "$(parts[1])/" end, bookPath(Join("/", Skip(1, parts))))
  if Has(page, site.BookPaths) page else missing end
end

defn hooksFor(site, path, where, book = missing)
  (** The hooks of std/markdown for a page: Cesia code in color, [Name] to its page, an id for each heading. A [Name] that
      leads nowhere is sent to the mistakes, with the place where it is written. *)
  defn link(target, line)
    found = Get(target, site.Targets)
    if IsSome(found)
      return rel(path, found)
    end
    if isNameLike(target)
      Send("$(where(line)): [$target] names nothing documented.", site.Mistakes)
    end
    missing
  end
  defn url(u, line)
    f = local(u)
    if IsMissing(f) or not EndsWith(".md", f)
      return u
    end
    folder = if IsMissing(book) site.Home else book end
    target = bookTarget(site, folder, f)
    if IsMissing(target)
      Send("$(where(line)): $f is no page of docs/$folder/.", site.Mistakes)
      return u
    end
    Str(rel(path, target), from(ByteLength(Split("#", u)[1]) + 1, u))
  end
  code(info, text, line) = if Split(" ", info)[1] == "cesia" codeBlock(text) else missing end
  {Code: code, Link: link, Url: url, Anchor: (level, text, line) -> slug(text)}
end

html(text, hooks) = markdown.Html(markdown.Parse(text), hooks)

defn summary(text)
  (** The first sentence of a text, on one line. *)
  line = Replace("\n", " ", Split("\n\n", text)[1])
  k = ByteFind(". ", 1, line)
  if IsMissing(k) line else ByteSlice(1, k, line) end
end

defn page(site, path, title, body)
  (** The HTML of a page: the text comes first, and the script at the end. *)
  back = up(path)
  way = wayTo(site.Tree, path)
  Str("<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n",
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n",
    "<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'self'\">\n",
    "<title>", escape(title), " - ", escape(site.Title), "</title>\n",
    "<link rel=\"stylesheet\" href=\"", back, "site.css\">\n</head>\n",
    "<body data-root=\"", back, "\">\n<a class=\"skip\" href=\"#text\">Skip to the text</a>\n",
    "<header><a class=\"home\" href=\"", back, "index.html\">", escape(site.Title), "</a>",
    "<span class=\"version\">", escape(site.Version), "</span>",
    "<a class=\"ref\" href=\"", back, "ref/index.html\">Reference</a>",
    "<input class=\"search\" type=\"search\" placeholder=\"Search  /\" aria-label=\"Search the docs\" autocomplete=\"off\"></header>\n",
    "<div class=\"page\">\n<nav class=\"side\" aria-label=\"Contents\">\n", sideColumns(site.Tree, path, way, site.Columns), "</nav>\n",
    "<main id=\"text\">\n", trail(site.Tree, path, way), body, "</main>\n</div>\n",
    "<script src=\"", back, "site.js\"></script>\n</body>\n</html>\n")
end

(* The side shows the site as the Finder shows folders, in columns: the first holds the book and the reference, each one
   opens the next, and the page's own children come last. *)

defn treeOf(book, modules, lists)
  (** The nodes of the side, by path: {Kids: path -> [{Label, Path}], Up: path -> the path above, Label: path -> label}. The
      root is "". A chapter's children are its sections; a module's are its names, and a name whose part before a dot is
      another name of the module goes under it: Date.Next under Date. *)
  kids = {}
  ups = {}
  top = []
  for p in book
    if p.File == "index.md"
      (* A book: the home, or another one under the title of its index. *)
      top = Append({Label: if p.Path == "index.html" "Book" else p.Title end, Path: p.Path}, top)
      ups[p.Path] = ""
      kids[p.Path] = [{Label: c.Title, Path: c.Path} for c in book if c.Book == p.Book and c.File != "index.md"]
    else
      ups[p.Path] = p.Index
      kids[p.Path] = [{Label: Replace("`", "", b.Text), Path: "$(p.Path)#$(slug(b.Text))", Sub: b.Level == 3} for b in p.Blocks if b.Kind == "heading" and (b.Level == 2 or b.Level == 3)]
    end
  end
  top = Append({Label: "Reference", Path: "ref/index.html"}, top)
  ups["ref/index.html"] = ""
  (* A module of a folder, std/date, goes under the folder's page, as its use writes it. *)
  kids["ref/index.html"] = Concat([{Label: m, Path: modulePath(m)} for m in modules if not Contains("/", m)],
    Append({Label: "Keywords", Path: "key/index.html"}, [{Label: g, Path: groupPath(g)} for g in groupsOf(modules)]))
  for g in groupsOf(modules)
    ups[groupPath(g)] = "ref/index.html"
    kids[groupPath(g)] = [{Label: from(ByteLength(g) + 2, m), Path: modulePath(m)} for m in modules if StartsWith("$g/", m)]
  end
  for m in modules
    ups[modulePath(m)] = if Contains("/", m) groupPath(groupOf(m)) else "ref/index.html" end
    known = Dict([{Key: n.Short, Value: n.Path} for n in lists[m]])
    for n in lists[m]
      parts = Split(".", n.Short)
      above = modulePath(m)
      label = n.Short
      k = Len(parts) - 1
      while k >= 1
        head = Join(".", Take(k, parts))
        if Has(head, known)
          above = known[head]
          label = Join(".", Skip(k, parts))
          break
        end
        k -= 1
      end
      kids[above] = Append({Label: label, Path: n.Path}, GetOr(above, [], kids))
      ups[n.Path] = above
    end
  end
  ups["key/index.html"] = "ref/index.html"
  kids["key/index.html"] = [{Label: w, Path: keyPath(w)} for w in keywords]
  for w in keywords
    ups[keyPath(w)] = "key/index.html"
  end
  kids[""] = top
  labels = {}
  for parentPath in Keys(kids)
    for c in kids[parentPath]
      labels[c.Path] = c.Label
    end
  end
  {Kids: kids, Up: ups, Label: labels}
end

groupOf(m) = Split("/", m)[1]   (** The folder of a module: std for std/date. *)
groupsOf(modules) = Unique([groupOf(m) for m in modules if Contains("/", m)])
groupPath(g) = "ref/$g.html"

defn groupBody(site, g, modules)
  (** The page of a folder of modules: what it holds, and each module with what it is for. *)
  path = groupPath(g)
  hooks = hooksFor(site, path, line -> "the folder $g")
  rows = Join("", [Str("<dt><a href=\"", rel(path, modulePath(m)), "\">", escape(m), "</a></dt><dd>", inlineHtml(summary(Doc(m)), hooks), "</dd>\n") for m in modules if StartsWith("$g/", m)])
  said = if g == "std"
    "What comes with Cesia: its libraries, written in Cesia, and the modules of its binary. A use writes std/ and the name: use std/date."
  else if g == "deps"
    "The packages taken from other projects, which cesia pkg puts in deps/. A use writes their whole path: use deps/owner/project/src/name."
  else
    "The packages of the project in its folder $g/. A use writes their path from the root: use $g/name."
  end
  Str("<h1>", escape(g), "</h1>\n<p>", escape(said), "</p>\n<dl class=\"names\">\n", rows, "</dl>\n")
end

defn wayTo(tree, path)
  (** The paths from the root to the page, the root first. The home of a site without a book is the index of the reference. *)
  node = if Has(path, tree.Up) path else "ref/index.html" end
  way = [node]
  while Has(way[1], tree.Up)
    way = Prepend(tree.Up[way[1]], way)
  end
  way
end

defn sideItem(tree, path, c, open, here)
  (** One link of a column of the side, seen from the page at path. *)
  marks = Concat(Concat(if c.Path == open and c.Path != here ["open"] else [] end, if Has(c.Path, tree.Kids) and Len(tree.Kids[c.Path]) > 0 ["more"] else [] end), if GetOr("Sub", false, c) ["sub"] else [] end)
  kind = if Len(marks) == 0 "" else " class=\"$(Join(" ", marks))\"" end
  current = if c.Path == here " aria-current=\"page\"" else "" end
  "<a href=\"$(rel(path, c.Path))\"$kind$current>$(escape(c.Label))</a>\n"
end

columnKey(path, node) = Str(parent(path), "|", node)   (** A column looks the same from every page of a folder. *)

shown(below, node) = Len(below) > 0 and not (node == "" and Len(below) == 1)   (** Does a node with these children get a column? *)

defn sideCache(tree, paths)
  (** The links of each column as the pages of each folder show them, none marked, for the pages at these paths: a page
      then makes only its two marked links, the open one and its own, instead of every link of every column. *)
  out = {}
  for path in paths
    for node in wayTo(tree, path)
      key = columnKey(path, node)
      below = GetOr(node, [], tree.Kids)
      if shown(below, node) and not Has(key, out)
        out[key] = [sideItem(tree, path, c, "", "") for c in below]
      end
    end
  end
  out
end

defn sideColumns(tree, path, way, cache = {})
  (** The columns of the side: one for each node on the way that has children, the open one marked in each. A root with one
      child shows no column. *)
  here = Last(way)
  out = []
  for k in 1..Len(way)
    below = GetOr(way[k], [], tree.Kids)
    if shown(below, way[k])
      open = if k < Len(way) way[k + 1] else "" end
      kind = if way[k] == "" " root" else if StartsWith("ref/", way[k]) or StartsWith("key/", way[k]) " code" else "" end
      plain = Get(columnKey(path, way[k]), cache)
      links = if IsMissing(plain)
        [sideItem(tree, path, c, open, here) for c in below]
      else
        [if below[i].Path == open or below[i].Path == here sideItem(tree, path, below[i], open, here) else plain[i] end for i in 1..Len(below)]
      end
      out = Append(Str("<div class=\"col", kind, "\">\n", Join("", links), "</div>\n"), out)
    end
  end
  Join("", out)
end

defn trail(tree, path, way)
  (** The way to the page above its text: Reference › std/date › Date › Next, each part a link but the last. *)
  steps = Skip(1, way)
  if Len(steps) < 2
    return ""
  end
  links = [Str("<a href=\"", rel(path, s), "\">", escape(tree.Label[s]), "</a>") for s in Butlast(steps)]
  Str("<nav class=\"trail\" aria-label=\"Where\">", Join(" <span aria-hidden=\"true\">›</span> ", Append(Str("<span>", escape(tree.Label[Last(steps)]), "</span>"), links)), "</nav>\n")
end

defn entryBody(site, path, e)
  (** The main part of the page of a name or a keyword. *)
  where(line) = "$(e.File):$(e.Line)"
  hooks = hooksFor(site, path, where)
  parts = if Len(e.Parts) == 0 "" else Str("<table class=\"parts\">\n<tbody>\n", Join("", ["<tr><th><code>$(escape(p.Name))</code></th><td>$(inlineHtml(p.Text, hooks))</td></tr>\n" for p in e.Parts]), "</tbody>\n</table>\n") end
  examples = if Len(e.Examples) == 0 "" else Str("<h2>Examples</h2>\n", codeBlock(Join("\n", e.Examples))) end
  from = if e.Builtin "Built into Cesia." else if site.Source == "" escape(where(0)) else "<a href=\"$(escape(site.Source))$(escape(e.File))#L$(e.Line)\">$(escape(e.File)):$(e.Line)</a>" end
  Str("<h1>", escape(e.Name), "</h1>\n<pre class=\"signature\"><code class=\"cesia\">", colored(e.Signature), "</code></pre>\n",
    html(e.Text, hooks), parts, examples, "<p class=\"from\">", from, "</p>\n")
end

defn pager(path, prev, next, above)
  (** The links to the page before, the page after and the page above, each {Label, Path} or missing: the keys p, n and u
      follow them. *)
  link(to, kind, before, after) = if IsMissing(to) "<span></span>" else "<a rel=\"$kind\" href=\"$(rel(path, to.Path))\">$before$(escape(to.Label))$after</a>" end
  Str("<nav class=\"pager\" aria-label=\"Pages\">", link(prev, "prev", "← ", ""), link(above, "up", "", ""), link(next, "next", "", " →"), "</nav>\n")
end

near(list, k) = {Prev: if k > 1 list[k - 1] else missing end, Next: if k < Len(list) list[k + 1] else missing end}

names(m) = [{Name: n, Short: shortOf(n, m), Path: namePath(m, n)} for n in DocNames(m)]   (** The documented names of a module, each {Name, Short, Path}. *)

withEntries(list) = [{Name: n.Name, Short: n.Short, Path: n.Path, Entry: cesia.DocEntry(n.Name)} for n in list]   (** The names with their docs, {Name, Short, Path, Entry}: only for the pages of the reference, which a kept build doesn't make. *)

defn about(e)
  (** What a list shows of a name: the first sentence of its text, else its first example. *)
  if Trim(e.Text) != "" summary(e.Text) else if Len(e.Examples) > 0 e.Examples[1] else "" end
end

defn moduleBody(site, m, list)
  (** The main part of the page of a module: what it is for, then its names. *)
  path = modulePath(m)
  hooks = hooksFor(site, path, line -> m)
  rows = Join("", ["<dt><a href=\"$(rel(path, n.Path))\">$(escape(n.Name))</a></dt><dd>$(inlineHtml(about(n.Entry), hooks))</dd>\n" for n in list])
  Str("<h1>", escape(m), "</h1>\n", html(Doc(m), hooks), "<dl class=\"names\">\n", rows, "</dl>\n")
end

defn indexBody(site, path)
  (** The main part of the index of the reference: the modules, what each is for, and the keywords. *)
  hooks = hooksFor(site, path, line -> "the index")
  rows = Join("", ["<dt><a href=\"$(rel(path, modulePath(m)))\">$(escape(m))</a></dt><dd>$(inlineHtml(summary(Doc(m)), hooks))</dd>\n" for m in site.Modules])
  words = Join(" ", ["<a href=\"$(rel(path, keyPath(w)))\"><code>$(escape(w))</code></a>" for w in keywords])
  Str("<h1>Reference</h1>\n<dl class=\"names\">\n", rows, "</dl>\n<h2>Keywords</h2>\n<p class=\"words\">", words, "</p>\n")
end

defn wordsBody(site, path)
  (** The main part of the index of the keywords: each one and what it does. *)
  hooks = hooksFor(site, path, line -> "the keywords")
  rows = Join("", [Str("<dt><a href=\"", rel(path, keyPath(w)), "\">", escape(w), "</a></dt><dd>", inlineHtml(about(cesia.DocEntry(w)), hooks), "</dd>\n") for w in keywords if IsSome(cesia.DocEntry(w))])
  Str("<h1>Keywords</h1>\n<p>The words of the language itself. Each one has its page, with examples.</p>\n<dl class=\"names\">\n", rows, "</dl>\n")
end

defn settings(root)
  (** The [site] table of the project, its name and its folders of sources: {Name, Src, Title, Source}. *)
  out = {Name: "", Src: ["src"], Title: "Cesia", Source: ""}
  file = "$root/cesia.toml"
  if not sys.Exists(file)
    return Ok(out)
  end
  tables = cesia.Toml(sys.Read(file)?)
  if IsErr(tables)
    return Err("$file:$(tables.Error.Line): $(tables.Error.Message)")
  end
  for t in tables.Value
    for e in t.Entries
      if Equal(t.Path, ["project"]) and e.Key == "name"
        out.Name = e.Value
      else if Equal(t.Path, ["project"]) and e.Key == "src"
        out.Src = e.Value
      else if Equal(t.Path, ["site"]) and e.Key == "title"
        out.Title = e.Value
      else if Equal(t.Path, ["site"]) and e.Key == "source"
        out.Source = e.Value
      else if Equal(t.Path, ["site"])
        return Err("$file:$(e.Line): [site] has title and source, not $(e.Key).")
      end
    end
  end
  Ok(out)
end

defn written(folder, pages, kept = [])
  (** Writes each page {Path, Html} under the folder, the folders first, and leaves each kept page {Path, Print} as it is.
      .pages keeps the fingerprint of each, so that a page that didn't change isn't written again, and one that is gone is
      removed. An Ok of the fingerprints, by path. *)
  manifest = "$folder/.pages"
  before = {}
  if sys.Exists(manifest)
    for line in Lines(sys.Read(manifest)?)
      parts = Split(" ", line)
      before[parts[1]] = parts[2]
    end
  end
  for dir in Unique([parent(p.Path) for p in pages])
    sys.Mkdir(if dir == "" folder else "$folder/$dir" end)?
  end
  now = {}
  for p in kept
    now[p.Path] = p.Print
  end
  for p in pages
    print = cesia.Fingerprint(p.Html)
    now[p.Path] = print
    file = "$folder/$(p.Path)"
    if GetOr(p.Path, "", before) != print or not sys.Exists(file)
      sys.Write(file, p.Html)?
    end
  end
  for path in Keys(before)
    if not Has(path, now) and sys.Exists("$folder/$path")
      sys.Remove("$folder/$path")?
    end
  end
  sys.Write(manifest, Join("", ["$k $(now[k])\n" for k in Keys(now)]))?
  Ok(now)
end

defn drained(channel)
  (** Every value a channel holds now. *)
  out = []
  got = Receive(channel, timeout = 0)
  while IsOk(got)
    out = Append(got.Value, out)
    got = Receive(channel, timeout = 0)
  end
  out
end

defn sameButCase(paths)
  (** The paths that another one equals but for case: a system that ignores case would keep only one. *)
  seen = {}
  out = []
  for p in paths
    key = Lower(p)
    if Has(key, seen)
      out = Append("$(seen[key]) and $p differ only in case.", out)
    else
      seen[key] = p
    end
  end
  out
end

(* The books: each index.md links to the other pages of its folder, in their order; docs/book/ is the home. A page is a program:
   its cesia blocks run at each build, and what they print is written under them. *)

blockWordList = "norun, fails, output=md, fold=code, fold=output, hide=code, hide=output and allow= with read, write, net, net=:PORT or ffi=m"

(* net=:8080 lets a block listen on that port, as --allow does; a server of the book listens on 127.0.0.1, the default of
   http.Serve. *)
isListen(a) = StartsWith("net=:", a) and IsInt(Number(from(6, a))) and Number(from(6, a)) >= 1 and Number(from(6, a)) <= 65535

defn blockWords(info)
  (** What the words after cesia ask of a block: {Norun, Fails, Md, Fold, Hide, Allow}, or an Err of the word it doesn't know. *)
  out = {Norun: false, Fails: false, Md: false, Fold: [], Hide: [], Allow: []}
  for w in Filter(x -> x != "", Skip(1, Split(" ", info)))
    if w == "norun"
      out.Norun = true
    else if w == "fails"
      out.Fails = true
    else if w == "output=md"
      out.Md = true
    else if w == "fold=code" or w == "fold=output"
      out.Fold = Append(from(6, w), out.Fold)
    else if w == "hide=code" or w == "hide=output"
      out.Hide = Append(from(6, w), out.Hide)
    else if StartsWith("allow=", w) and All([a in ["read", "write", "net", "ffi=m"] or isListen(a) for a in Split(",", from(7, w))])
      out.Allow = Concat(out.Allow, Split(",", from(7, w)))
    else
      return Err("$w is no word of a cesia block: they are $blockWordList.")
    end
  end
  if out.Norun and out.Fails
    return Err("a block is norun or fails, not both.")
  end
  Ok(out)
end

defn codeBlocks(blocks)
  (** The blocks of code among blocks from markdown.Parse, those in quotes and lists too, in the order of the text. *)
  out = []
  for b in blocks
    if b.Kind == "code"
      out = Append(b, out)
    else if b.Kind == "quote"
      out = Concat(out, codeBlocks(b.Blocks))
    else if b.Kind == "list"
      for item in b.Items
        out = Concat(out, codeBlocks(item))
      end
    end
  end
  out
end

defn arrows(code)
  (** Each line of a block cut at its -->, as cesia test cuts it: {At, Code, Want}, Want empty for a value to show; or
      missing. A --> in a comment or a text is no check of the book: the example of a (** *) is for cesia test. *)
  state = syntax.FirstState
  out = []
  for t in Lines(code)
    r = syntax.Tokens(t, state)
    state = r.State
    inCode = []
    at = 1
    for tok in r.Tokens
      last = at + ByteLength(tok[2]) - 1
      if tok[1] == syntax.Comment or tok[1] == syntax.String
        (* not code *)
      else if Len(inCode) > 0 and inCode[Len(inCode)].To + 1 == at
        inCode[Len(inCode)].To = last
      else
        inCode = Append({From: at, To: last}, inCode)
      end
      at += ByteLength(tok[2])
    end
    k = ByteFind("-->", 1, t)
    while IsSome(k) and not Some(s -> s.From <= k and k + 2 <= s.To, inCode)
      k = ByteFind("-->", k + 1, t)
    end
    out = Append(if IsMissing(k) missing else {At: k, Code: Trim(ByteSlice(1, k - 1, t)), Want: Trim(from(k + 3, t))} end, out)
  end
  out
end

defn whole(code)
  (** Does a piece of code close every bracket it opens, outside its texts and comments? *)
  depth = {"(": 0, "[": 0, "{": 0}
  closer = {")": "(", "]": "[", "}": "{"}
  for tok in syntax.Tokens(code, syntax.FirstState).Tokens
    if tok[1] != syntax.Comment and tok[1] != syntax.String
      for c in Chars(tok[2])
        if Has(c, depth)
          depth[c] += 1
        else if Has(c, closer)
          depth[closer[c]] -= 1
        end
      end
    end
  end
  All([d == 0 for d in Values(depth)])
end

defn freshLines(code)
  (** For each line of a block, does it start outside a comment and a text? Only such a line can be a use. *)
  state = syntax.FirstState
  out = []
  for t in Lines(code)
    out = Append(Equal(state, syntax.FirstState), out)
    state = syntax.Tokens(t, state).State
  end
  out
end

defn helpers(mark)
  (** The functions the program calls to speak to the build: each prints a line that starts with the byte 1 and the mark. A
      value is shown as cesia test shows it, its line ends as the byte 2. *)
  say = "Print(Str(Char(1), $quote$mark $quote, "
  Join("\n", ["bookAt(k) = $(say)k))",
    "bookShown(v) = Replace(Char(10), Char(2), ByteSlice(2, ByteLength(Text([v])) - 1, Text([v])))",
    "bookShow(line, v) = $(say)$(quote)= $quote, line, $quote $quote, bookShown(v)))",
    "defn bookCheck(line, got, want)",
    "  if not Equal(got, want)",
    "    $(say)$(quote)! $quote, line, $quote $quote, bookShown(want), Char(3), bookShown(got)))",
    "  end",
    "end", ""])
end

defn program(runs, chosen, mark)
  (** The program of the blocks chosen among those of a page: its use lines first, then each line of code on the line of the
      page where it is written, so that an error names that line. {Text, Uses}: Uses are the lines of the use lines. *)
  uses = []
  useLines = []
  at = {}
  last = 0
  for k in chosen
    b = runs[k]
    at[b.Line] = if b.Words.Norun "defn bookNotRun$k()" else "bookAt($k)" end
    lines = Lines(b.Text)
    cut = arrows(b.Text)
    fresh = freshLines(b.Text)
    for i in 1..Len(lines)
      t = lines[i]
      a = cut[i]
      if fresh[i] and StartsWith("use ", Trim(t))
        (* A use already on top is written once: a fails block runs again the uses of the blocks before it. *)
        if IsMissing(IndexOf(Trim(t), uses))
          uses = Append(Trim(t), uses)
          useLines = Append(b.Line + i, useLines)
        end
      else if IsSome(a) and a.Want == ""
        at[b.Line + i] = "bookShow($(b.Line + i), ($(a.Code)))"
      else if IsSome(a)
        at[b.Line + i] = "bookCheck($(b.Line + i), ($(a.Code)), ($(a.Want)))"
      else
        at[b.Line + i] = t
      end
    end
    last = b.Line + Len(lines) + 1
    if b.Words.Norun
      at[last] = "end"
    end
  end
  {Text: Str(Join("\n", Concat(uses, [GetOr(n, "", at) for n in 1..last])), "\n", helpers(mark)), Uses: useLines}
end

defn heard(out, mark)
  (** What a run printed, cut at its marks: {Output: block -> text, Values: line -> text, Wrong: [{Line, Want, Got}]}. *)
  output = {}
  values = {}
  wrong = []
  block = 0
  pieces = Split(Str(Char(1), mark, " "), out)
  for p in Skip(1, pieces)
    nl = ByteFind("\n", 1, p)
    head = if IsMissing(nl) p else ByteSlice(1, nl - 1, p) end
    rest = if IsMissing(nl) "" else from(nl + 1, p) end
    said = Replace(Char(2), "\n", from(3, head))
    space = ByteFind(" ", 1, said)
    if StartsWith("= ", head)
      values[Number(ByteSlice(1, space - 1, said))] = from(space + 1, said)
    else if StartsWith("! ", head)
      shown = Split(Char(3), from(space + 1, said))
      wrong = Append({Line: Number(ByteSlice(1, space - 1, said)), Want: shown[1], Got: shown[2]}, wrong)
    else
      block = Number(head)
    end
    if rest != ""
      output[block] = Str(GetOr(block, "", output), rest)
    end
  end
  {Output: output, Values: values, Wrong: wrong}
end

defn placed(err, run, source)
  (** The error of a run, at the place of the page it names: {Where, Message}. The message keeps the advice under the line it
      shows, not that line, nor the calls that led there. *)
  lines = Lines(err)
  first = if Len(lines) == 0 "it stopped and said nothing." else lines[1] end
  advice = [Trim(l) for l in Skip(1, lines) if not Contains(" | ", l) and not StartsWith("  in ", l) and not StartsWith("  called from ", l)]
  prefix = Str(run.Program, ":")
  if not StartsWith(prefix, first)
    return {Where: source, Message: Join("\n", Concat([first], advice))}
  end
  rest = from(ByteLength(prefix) + 1, first)
  colon = ByteFind(":", 1, rest)
  n = Number(ByteSlice(1, colon - 1, rest))
  line = if n <= Len(run.Uses) run.Uses[n] else n - Len(run.Uses) end
  after = from(colon + 1, rest)
  space = ByteFind(": ", 1, after)
  {Where: Str(source, ":", line, ":", ByteSlice(1, space - 1, after)), Message: Join("\n", Concat([from(space + 2, after)], advice))}
end

defn removed(path)
  (** Deletes a file, or a folder with all it holds; a link goes, never what it leads to. *)
  info = sys.Stat(path)
  if IsErr(info)
    return Ok(missing)
  end
  if info.Value.IsDir and not info.Value.IsLink
    for n in sys.List(path)?
      removed("$path/$n")?
    end
  end
  sys.Remove(path)
end

defn copied(source, target)
  (** A copy of the folder source, with all it holds, made at target. *)
  sys.Mkdir(target)?
  if sys.Exists(source)
    for n in sys.List(source)?
      if sys.Stat("$source/$n")?.IsDir
        copied("$source/$n", "$target/$n")?
      else
        sys.Write("$target/$n", sys.Read("$source/$n")?)?
      end
    end
  end
  Ok(missing)
end

defn ran(job, chosen, name)
  (** Runs the blocks chosen of a page as one program of .run, in a fresh copy of the files/ of its book, with the permissions its blocks
      ask for there: {Code, Out, Err, Program, Uses}. *)
  p = program(job.Runs, chosen, job.Mark)
  file = "$(job.Run)/$name.ce"
  work = "$(job.Run)/$name"
  sys.Write(file, p.Text)?
  removed(work)?
  copied(job.Files, work)?
  grants = [if a == "read" or a == "write" "$a=." else if a == "net" "net=127.0.0.1" else a end for a in Unique(FlatMap(k -> job.Runs[k].Words.Allow, chosen))]
  allow = if Len(grants) == 0 [] else ["--allow", Join(",", grants)] end
  r = sys.Run(cesia.Binary(), args = Concat(Concat(["run", "--limit", "memory=512M"], allow), [file]), dir = work, timeout = 10)?
  Ok({Code: r.Code, Out: r.Out, Err: r.Err, Program: file, Uses: p.Uses})
end

defn stopped(r, source)
  (** Why a run that should have ended well did not, or missing. *)
  if r.Code == -1
    "$source: the page ran more than 10 seconds, or a signal ended it."
  else if r.Code != 0
    e = placed(r.Err, r, source)
    "$(e.Where): $(e.Message)"
  else
    missing
  end
end

defn pageRun(job)
  (** The runs of a page: the blocks that don't fail as one program, then each block that fails after the blocks before it.
      Ok({Output: [text of each block], Values: [[line, text]]}), or an Err of the mistakes. *)
  runs = job.Runs
  main = [k for k in 1..Len(runs) if not runs[k].Words.Fails]
  r = ran(job, main, job.Name)?
  why = stopped(r, job.Source)
  if IsSome(why)
    return Err([why])
  end
  got = heard(r.Out, job.Mark)
  mistakes = ["$(job.Source):$(w.Line): $(Trim(job.Lines[w.Line])), got $(w.Got)" for w in got.Wrong]
  output = [GetOr(k, "", got.Output) for k in 1..Len(runs)]
  for k in 1..Len(runs)
    if runs[k].Words.Fails
      f = ran(job, Append(k, [j for j in main if j < k]), "$(job.Name)-$(runs[k].Line)")?
      if f.Code == 0
        mistakes = Append("$(job.Source):$(runs[k].Line): this block is marked fails, but it ran to its end.", mistakes)
      else if f.Code == -1
        mistakes = Append("$(job.Source):$(runs[k].Line): this block ran more than 10 seconds, or a signal ended it.", mistakes)
      else
        (* What the block checked and showed before it stopped counts as in any block. *)
        said = heard(f.Out, job.Mark)
        first = runs[k].Line + 1
        last = runs[k].Line + Len(Lines(runs[k].Text))
        inside(n) = n >= first and n <= last
        mistakes = Concat(mistakes, ["$(job.Source):$(w.Line): $(Trim(job.Lines[w.Line])), got $(w.Got)" for w in said.Wrong if inside(w.Line)])
        for n in Keys(said.Values)
          if inside(n)
            got.Values[n] = said.Values[n]
          end
        end
        output[k] = Str(GetOr(k, "", said.Output), placed(f.Err, f, job.Source).Message, "\n")
      end
    end
  end
  if Len(mistakes) > 0 Err(mistakes) else Ok({Output: output, Values: [[n, got.Values[n]] for n in Keys(got.Values)]}) end
end

defn worker(queue, done)
  (** Runs the pages of the queue one after the other, and sends each result with the name of its page. *)
  job = Receive(queue, timeout = 0)
  while IsOk(job)
    r = pageRun(job.Value)
    Send({Name: job.Value.Name, Result: if IsErr(r) and IsText(r.Error) Err([r.Error]) else r end}, done)
    job = Receive(queue, timeout = 0)
  end
end

defn allRun(jobs)
  (** The results of the pages to run, as many at once as the cores Cesia uses: name -> result. *)
  queue = Channel()
  for j in jobs
    Send(j, queue)
  end
  done = Channel()
  fibers = [Spawn(() -> worker(queue, done)) for i in 1..Min(columns.Cores(), Len(jobs))]
  for f in fibers
    Wait(f)
  end
  Dict([{Key: d.Name, Value: d.Result} for d in drained(done)])
end

defn filesUnder(dir)
  (** The paths of the files under a folder, from it, sorted; none if it isn't there. Names that start with a dot are left out. *)
  if not sys.Exists(dir)
    return []
  end
  out = []
  for n in sys.List(dir).Value
    if not StartsWith(".", n)
      if sys.Stat("$dir/$n").Value.IsDir
        out = Concat(out, ["$n/$p" for p in filesUnder("$dir/$n")])
      else
        out = Append(n, out)
      end
    end
  end
  out
end

defn stamp(root, config)
  (** What the runs of a page depend on beside its blocks: this Cesia, the sources of the project, and the files/ of the books. *)
  binary = sys.Stat(cesia.Binary()).Value
  parts = [cesia.Version(), Str(binary.Size, " ", binary.Modified)]
  books = if sys.Exists("$root/docs") [Str("docs/", n, "/files") for n in UnwrapOr([], sys.List("$root/docs"))] else [] end
  for dir in Concat(Concat(config.Src, ["std"]), books)
    for p in filesUnder("$root/$dir")
      parts = Append(Str(dir, "/", p, " ", cesia.Fingerprint(sys.Read("$root/$dir/$p").Value)), parts)
    end
  end
  for f in ["cesia.toml", "cesia.lock"]
    if sys.Exists("$root/$f")
      parts = Append(Str(f, " ", cesia.Fingerprint(sys.Read("$root/$f").Value)), parts)
    end
  end
  cesia.Fingerprint(Join("\n", parts))
end

defn local(u)
  (** The file of a link to a page of the site, without its #part, or missing for a link elsewhere. *)
  file = Split("#", u)[1]
  if Contains(":", file) or StartsWith("/", file) or file == "" missing else file end
end

defn linked(text)
  (** The pages that a text links to, in the order of their first link, and the line of each. *)
  seen = Channel()
  defn url(u, line)
    f = local(u)
    if IsSome(f) and EndsWith(".md", f)
      Send({File: f, Line: line}, seen)
    end
    u
  end
  html(text, {Code: markdown.Plain.Code, Link: markdown.Plain.Link, Url: url, Anchor: markdown.Plain.Anchor})
  out = []
  for l in drained(seen)
    if not (l.File in [o.File for o in out])
      out = Append(l, out)
    end
  end
  out
end

bookPath(file) = Str(ByteSlice(1, ByteLength(file) - 3, file), ".html")   (** The page of values.md: values.html. *)

defn titleOf(blocks, file)
  (** The text of the first heading of a page, without its marks of code, or its file. *)
  for b in blocks
    if b.Kind == "heading"
      return Replace("`", "", b.Text)
    end
  end
  file
end

defn pagesOf(root, name, prefix, site)
  (** The pages of the book of docs/name, its index first, then in the order of the links of its index.md, each {File,
      Source, Path, Title, Text, Blocks, Runs, Lines, Broken, Book, Index, Files}: Path is prefix and the page. Mistakes go
      to site.Mistakes, and a page with one in its blocks is Broken: it doesn't run. *)
  dir = "$root/docs/$name"
  at = "docs/$name"
  if not sys.Exists("$dir/index.md")
    Send("$at/index.md: a book starts at its index.md, which links to its other pages in their order.", site.Mistakes)
    return []
  end
  order = [l for l in linked(sys.Read("$dir/index.md").Value) if not Contains("/", l.File)]
  for l in order
    if not sys.Exists("$dir/$(l.File)")
      Send("$at/index.md:$(l.Line): $(l.File) is no page of $at/.", site.Mistakes)
    end
  end
  files = Concat(["index.md"], [l.File for l in order if sys.Exists("$dir/$(l.File)")])
  for f in filesUnder(dir)
    if EndsWith(".md", f) and not StartsWith("files/", f) and not (f in files)
      Send("$at/$f: no link of $at/index.md leads to this page.", site.Mistakes)
    end
  end
  pages = []
  for f in files
    text = sys.Read("$dir/$f").Value
    blocks = markdown.Parse(text)
    runs = []
    broken = false
    for b in codeBlocks(blocks)
      first = Split(" ", b.Info)[1]
      words = blockWords(b.Info)
      if first == "cesia" and IsErr(words)
        Send("$at/$f:$(b.Line): $(words.Error)", site.Mistakes)
        broken = true
      else if first == "cesia"
        runs = Append({Line: b.Line, Info: b.Info, Text: b.Text, Words: words.Value}, runs)
      else if first == "toml" and IsErr(cesia.Toml(b.Text))
        e = cesia.Toml(b.Text).Error
        Send("$at/$f:$(b.Line + e.Line): $(e.Message)", site.Mistakes)
      end
    end
    for r in runs
      cut = arrows(r.Text)
      fresh = freshLines(r.Text)
      for i in 1..Len(cut)
        if IsSome(cut[i]) and cut[i].Want == "error"
          Send("$at/$f:$(r.Line + i): --> error is for cesia test; here a block that stops is marked fails.", site.Mistakes)
          broken = true
        else if IsSome(cut[i]) and not (fresh[i] and whole(cut[i].Code) and whole(cut[i].Want))
          Send("$at/$f:$(r.Line + i): a --> checks the expression of its own line, and this one goes on from the lines before: name the value there, then check the name.", site.Mistakes)
          broken = true
        end
      end
    end
    pages = Append({File: f, Source: "$at/$f", Path: Str(prefix, bookPath(f)), Title: titleOf(blocks, f), Text: text, Blocks: blocks,
      Runs: runs, Lines: Lines(text), Broken: broken, Book: name, Index: Str(prefix, "index.html"), Files: "$dir/files"}, pages)
  end
  pages
end

defn booksOf(root, site)
  (** The books of the project, {Home, Pages}, the pages of the home first: each folder of docs/ with pages is a book,
      docs/book/ the home at the root of the site, and any other under its own name. A folder of docs/ with no page, as one
      of images, is none. *)
  docs = "$root/docs"
  if not sys.Exists(docs)
    return {Home: "book", Pages: []}
  end
  names = []
  for n in UnwrapOr([], sys.List(docs))
    info = sys.Stat("$docs/$n")
    if IsOk(info) and info.Value.IsDir and Some(f -> EndsWith(".md", f), filesUnder("$docs/$n"))
      names = Append(n, names)
    end
  end
  home = if "book" in names "book" else (if Len(names) > 0 names[1] else "" end) end
  ordered = Concat([n for n in names if n == home], [n for n in names if n != home])
  {Home: home, Pages: FlatMap(n -> pagesOf(root, n, if n == home "" else "$n/" end, site), ordered)}
end

defn bookRuns(pages, site, root, config)
  (** What the blocks of each page printed, from the cache when nothing they depend on changed: path -> {Output, Values}.
      The cache of a project keeps only what this build used. *)
  print = stamp(root, config)
  mark = from(8, cesia.Fingerprint(Str(sys.Now(), root)))
  kept = "$(site.Cache)/runs/$(ByteSlice(8, 23, cesia.Fingerprint(root)))"
  used = []
  out = {}
  jobs = []
  for p in pages
    if Len(p.Runs) > 0 and not p.Broken
      key = from(8, cesia.Fingerprint(Join("\n", Concat([print, p.Source], [Str(r.Line, " ", r.Info, "\n", r.Text) for r in p.Runs]))))
      file = "$kept/$key.json"
      used = Append("$key.json", used)
      before = if sys.Exists(file) json.Parse(sys.Read(file).Value) else missing end
      if IsSome(before) and IsOk(before)
        out[p.Path] = before.Value
      else
        name = ByteSlice(1, ByteLength(p.File) - 3, p.File)
        jobs = Append({Name: name, Path: p.Path, Key: file, Source: p.Source, Runs: p.Runs, Lines: p.Lines, Mark: mark, Run: site.Run, Files: p.Files}, jobs)
      end
    end
  end
  if Len(jobs) > 0
    sys.Mkdir(site.Run).Value
    sys.Mkdir(kept).Value
    results = allRun(jobs)
    for j in jobs
      r = results[j.Name]
      if IsErr(r)
        for m in r.Error
          Send(m, site.Mistakes)
        end
      else
        out[j.Path] = r.Value
        sys.Write(j.Key, json.Text(r.Value))
      end
    end
  end
  for f in if sys.Exists(kept) sys.List(kept).Value else [] end
    if not (f in used)
      sys.Remove("$kept/$f")
    end
  end
  out
end

defn shownCode(run, values)
  (** The code of a block as the page shows it: a line a --> gets the value that a had. *)
  lines = Lines(run.Text)
  cut = arrows(run.Text)
  shown = []
  for i in 1..Len(lines)
    t = lines[i]
    a = cut[i]
    value = Get(run.Line + i, values)
    shown = Append(if IsSome(a) and a.Want == "" and IsSome(value) Str(ByteSlice(1, a.At + 2, t), " ", value) else t end, shown)
  end
  Join("\n", shown)
end

defn folded(part, label, words)
  (** A part of a block, inside a details that opens on a click if the block folds it. *)
  if Lower(label) in words.Fold "<details><summary>$label</summary>\n$part</details>\n" else part end
end

defn bookBlock(run, output, values, hooks)
  (** The HTML of a cesia block of the book: its code, and under it what it printed. *)
  words = run.Words
  code = if "code" in words.Hide "" else folded(codeBlock(shownCode(run, values)), "Code", words) end
  text = if EndsWith("\n", output) ByteSlice(1, ByteLength(output) - 1, output) else output end
  shown = if words.Md html(output, hooks) else "<pre class=\"output\"><code>$(escape(text))</code></pre>\n" end
  out = if output == "" or "output" in words.Hide "" else folded(shown, "Output", words) end
  (* The permissions the block ran with, as cesia run takes them: a reader who types it needs them too. *)
  asked = [if a == "net" "net=127.0.0.1" else a end for a in words.Allow]
  allow = if Len(asked) == 0 "" else "<p class=\"allow\">Runs with <code>--allow $(escape(Join(",", asked)))</code></p>\n" end
  Str(code, allow, out)
end

defn bookBody(site, page, results)
  (** The main part of a page of the book, each cesia block with what it printed. *)
  hooks = hooksFor(site, page.Path, line -> "$(page.Source):$line", book = page.Book)
  r = GetOr(page.Path, {Output: [], Values: []}, results)
  values = Dict([{Key: v[1], Value: v[2]} for v in r.Values])
  defn code(info, text, line)
    k = IndexOf(line, [x.Line for x in page.Runs])
    if Split(" ", info)[1] != "cesia" or IsMissing(k)
      return hooks.Code(info, text, line)
    end
    bookBlock(page.Runs[k], if k <= Len(r.Output) r.Output[k] else "" end, values, hooks)
  end
  html(page.Text, {Code: code, Link: hooks.Link, Url: hooks.Url, Anchor: hooks.Anchor})
end

defn bookSearch(page)
  (** What the search knows of a page of the book: the page, and each of its sections. *)
  texts = [b.Text for b in page.Blocks if b.Kind == "paragraph"]
  out = [["page", page.Path, page.Title, if Len(texts) == 0 "" else summary(texts[1]) end, ""]]
  Concat(out, [["section", "$(page.Path)#$(slug(b.Text))", Replace("`", "", b.Text), page.Title, ""] for b in page.Blocks if b.Kind == "heading" and (b.Level == 2 or b.Level == 3)])
end

defn referencePages(site, modules, lists)
  (** The pages of the reference, {Pages, Search}: a page for each module, name and keyword, and the indexes. *)
  pages = []
  search = []
  lists = Dict([{Key: m, Value: withEntries(lists[m])} for m in modules])
  site.Columns = sideCache(site.Tree, Keys(site.Tree.Up))
  index = {Label: "Reference", Path: "ref/index.html"}
  moduleLinks = [{Label: m, Path: modulePath(m)} for m in modules]
  for k in 1..Len(modules)
    m = modules[k]
    path = modulePath(m)
    around = near(moduleLinks, k)
    above = if Contains("/", m) {Label: groupOf(m), Path: groupPath(groupOf(m))} else index end
    body = Str(moduleBody(site, m, lists[m]), pager(path, around.Prev, around.Next, above))
    pages = Append({Path: path, Html: page(site, path, m, body)}, pages)
    search = Append(["module", path, m, summary(Doc(m)), ""], search)
    nameLinks = [{Label: n.Short, Path: n.Path} for n in lists[m]]
    for j in 1..Len(lists[m])
      n = lists[m][j]
      around = near(nameLinks, j)
      body = Str(entryBody(site, n.Path, n.Entry), pager(n.Path, around.Prev, around.Next, moduleLinks[k]))
      pages = Append({Path: n.Path, Html: page(site, n.Path, n.Name, body)}, pages)
      search = Append(["name", n.Path, n.Name, about(n.Entry), n.Entry.Signature], search)
    end
  end
  wordLinks = [{Label: w, Path: keyPath(w)} for w in keywords]
  for k in 1..Len(keywords)
    w = keywords[k]
    e = cesia.DocEntry(w)
    path = keyPath(w)
    around = near(wordLinks, k)
    if IsMissing(e)
      Send("src/std/keywords.ce: the keyword $w has no block.", site.Mistakes)
    else
      body = Str(entryBody(site, path, e), pager(path, around.Prev, around.Next, {Label: "Keywords", Path: "key/index.html"}))
      pages = Append({Path: path, Html: page(site, path, w, body)}, pages)
      search = Append(["keyword", path, w, about(e), ""], search)
    end
  end
  for path in if Len(site.Book) > 0 ["ref/index.html"] else ["ref/index.html", "index.html"] end
    pages = Append({Path: path, Html: page(site, path, "Reference", indexBody(site, path))}, pages)
  end
  pages = Append({Path: "key/index.html", Html: page(site, "key/index.html", "Keywords", wordsBody(site, "key/index.html"))}, pages)
  for g in groupsOf(modules)
    pages = Append({Path: groupPath(g), Html: page(site, groupPath(g), g, Str(groupBody(site, g, modules), pager(groupPath(g), missing, missing, index)))}, pages)
  end
  {Pages: pages, Search: search}
end

defn printsIn(folder)
  (** The fingerprint of each page that the site folder holds as it was written, by path, from its .pages. *)
  prints = {}
  for line in Lines(UnwrapOr("", sys.Read("$folder/.pages")))
    parts = Split(" ", line)
    if Len(parts) == 2 and sys.Exists("$folder/$(parts[1])")
      prints[parts[1]] = parts[2]
    end
  end
  prints
end

defn saved(folder, name)
  (** The dictionary that a build kept in a file of the site folder, or missing. *)
  r = json.Parse(UnwrapOr("", sys.Read("$folder/$name")))
  if IsOk(r) and IsDict(r.Value) r.Value else missing end
end

defn keptReference(folder, key, prints)
  (** The pages of the reference that the site folder already holds, {Pages: [{Path, Print}], Search}, when they were made
      from the same key and are still as written; else missing. *)
  ref = saved(folder, ".reference")
  if IsMissing(ref) or Get("Key", ref) != key
    return missing
  end
  for p in ref.Pages
    if Get(p.Path, prints) != p.Print
      return missing
    end
  end
  ref
end

defn pageKey(key, shape, page, results)
  (** What a page of the book is made from: the reference, the titles and sections of every page, its text and its runs. *)
  cesia.Fingerprint(Str(key, "\n", shape, "\n", page.Path, "\n", page.Text, "\n", Text([GetOr(page.Path, missing, results)])))
end

defn build(root, folder, cache)
  (** The pages of the site, written into the folder; an Err lists the mistakes. *)
  config = settings(root)?
  modules = DocNames()
  lists = Dict([{Key: m, Value: names(m)} for m in modules])
  targets = {}
  for w in keywords
    targets[w] = keyPath(w)
  end
  for m in modules
    targets[m] = modulePath(m)
    for n in lists[m]
      targets[n.Name] = n.Path
    end
  end
  site = {Title: config.Title, Source: config.Source, Modules: modules, Targets: targets, Mistakes: Channel(), BookPaths: {}, Book: [], Cache: cache, Run: "$folder/.run", Tree: {}, Columns: {}, Version: cesia.Version(), Home: "book"}
  books = booksOf(root, site)
  book = books.Pages
  site.Home = books.Home
  site.Book = book
  site.Tree = treeOf(book, modules, lists)
  site.BookPaths = Dict([{Key: p.Path, Value: true} for p in book])
  results = bookRuns(book, site, root, config)
  key = cesia.Fingerprint(Str(stamp(root, config), "|", config.Title, "|", config.Source, "|", Join(",", [p.Path for p in book])))
  prints = printsIn(folder)
  kept = keptReference(folder, key, prints)
  (* A page of the book is made again only when what it is made from changed: the titles and sections of the book are in
     the side of each page, so they count for all. *)
  shape = Join("\n", [Str(p.Path, " ", p.Title, " ", Join("|", [b.Text for b in p.Blocks if b.Kind == "heading" and (b.Level == 2 or b.Level == 3)])) for p in book])
  last = saved(folder, ".book")
  before = if IsMissing(last) {} else GetOr("Pages", {}, last) end
  bookKeys = {}
  keptBook = []
  site.Columns = sideCache(site.Tree, [p.Path for p in book])
  pages = []
  search = []
  home = {Label: if Len(book) > 0 book[1].Title else "Reference" end, Path: "index.html"}
  for k in 1..Len(book)
    p = book[k]
    bookKeys[p.Path] = pageKey(key, shape, p, results)
    old = Get(p.Path, before)
    if IsSome(old) and old.Key == bookKeys[p.Path] and Get(p.Path, prints) == old.Print
      keptBook = Append({Path: p.Path, Print: old.Print}, keptBook)
    else
      same = [c for c in book if c.Book == p.Book]
      around = near([{Label: c.Title, Path: c.Path} for c in same], IndexOf(p.Path, [c.Path for c in same]))
      up = if p.Path == "index.html" missing else if p.File == "index.md" home else {Label: same[1].Title, Path: p.Index} end
      body = Str(bookBody(site, p, results), pager(p.Path, around.Prev, around.Next, up))
      pages = Append({Path: p.Path, Html: page(site, p.Path, p.Title, body)}, pages)
    end
    search = Concat(search, bookSearch(p))
  end
  (* A book with mistakes stops here: the pages of the reference would take most of the time, for nothing. *)
  early = Concat(drained(site.Mistakes), sameButCase(Concat([p.Path for p in pages], [p.Path for p in keptBook])))
  if Len(early) > 0
    return Err(Join("\n", Unique(early)))
  end
  ref = if IsSome(kept) {Pages: [], Search: kept.Search} else referencePages(site, modules, lists) end
  pages = Concat(pages, ref.Pages)
  search = Concat(search, ref.Search)
  keptPages = Concat(keptBook, if IsSome(kept) kept.Pages else [] end)
  mistakes = Concat(drained(site.Mistakes), sameButCase(Concat([p.Path for p in pages], [p.Path for p in keptPages])))
  if Len(mistakes) > 0
    return Err(Join("\n", Unique(mistakes)))
  end
  pages = Append({Path: "search.js", Html: "window.cesiaSearch = $(json.Text(search));\n"}, pages)
  pages = Append({Path: "site.css", Html: cesia.Asset("site.css")}, Append({Path: "site.js", Html: cesia.Asset("site.js")}, pages))
  now = written(folder, pages, kept = keptPages)?
  if IsMissing(kept)
    made = [{Path: p.Path, Print: now[p.Path]} for p in ref.Pages]
    sys.Write("$folder/.reference", json.Text({Key: key, Pages: made, Search: ref.Search}))?
  end
  sys.Write("$folder/.book", json.Text({Pages: Dict([{Key: p.Path, Value: {Key: bookKeys[p.Path], Print: now[p.Path]}} for p in book])}))?
  Ok(Len(pages) + Len(keptPages))
end

defn opened(file)
  (** Opens a page with the browser of the system: xdg-open, open on macOS, start on Windows. *)
  for tried in [["xdg-open", [file]], ["open", [file]], ["cmd", ["/c", "start", "", file]]]
    r = sys.Run(tried[1], args = tried[2])
    if IsOk(r) and r.Value.Code == 0
      return Ok(missing)
    end
  end
  Err("Can't open a browser: open $file by hand.")
end

defn Main()
  (** Builds the site of Args: the root of the project, the folder, the folder of the cache, and --open if it was asked. *)
  if Len(Args) < 3
    return Err("usage: cesia doc --site [folder] [--open]")
  end
  count = build(Args[1], Args[2], Args[3])?
  index = "$(Args[2])/index.html"
  Print("$count files: file://$index")
  if "--open" in Args
    opened(index)?
  end
  Ok(missing)
end
