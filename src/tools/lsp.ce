(** cesia lsp: a language server, for any editor that speaks the Language Server Protocol. Messages come on the standard
    input and go on the standard output, each a Content-Length header, an empty line and JSON. The server shows what
    cesia check finds in the lines of an open file, as it is typed; the documentation of the name under the cursor; where a
    name is defined; and the names of a package after its dot. A position counts UTF-16 code units, as the protocol does.
    Run by the binary, with the read permission only, in the folder of the project. *)
use std/cesia
use std/dict
use std/encode
use std/fiber
use std/io
use std/json
use std/list
use std/path
use std/regex
use std/result
use std/sys
use std/text
use std/value

quiet = 0.05   (** The seconds without a message after which the files that changed are checked: typing checks once. *)

between = 0.001   (** The seconds between the checks of two files, for a message to come in and be answered first. *)

(* What the server can do, as initialize answers it: the whole text at each change, and a save without its text. *)
capabilities = {
  positionEncoding: "utf-16",
  textDocumentSync: {openClose: true, change: 1, save: {includeText: false}},
  hoverProvider: true,
  definitionProvider: true,
  completionProvider: {triggerCharacters: ["."]}}

defn readMessage()
  (** The body of the next message of the input, or missing at its end. Its headers are lines up to an empty one, and
      Content-Length gives the size of the body in bytes. *)
  size = 0
  headers = 0
  line = ""
  while true
    c = sys.ReadInput(1)?
    if c == ""
      return result.Ok(missing)
    else if c != "\n"
      line = "$line$c"
    else if text.Trim(line) != ""
      headers += 1
      found = regex.Find("^[Cc]ontent-[Ll]ength: *([0-9]+)", line)
      if not value.IsMissing(found)
        size = text.Number(found.Groups[1])
      end
      line = ""
    else if headers > 0
      break
    end
  end
  sys.ReadInput(size)
end

defn reader(inbox)
  (** Puts the body of each message of the input in the inbox as it comes, then missing at the end of the input. *)
  while true
    got = readMessage()
    body = if result.IsOk(got) got.Value else missing end
    fiber.Send(body, inbox)
    if value.IsMissing(body)
      return missing
    end
  end
end

defn send(message)
  (** Writes a message on the output. io.Print ends it with a line end, which its size counts: JSON allows one after a value. *)
  body = json.Text(dict.Put("jsonrpc", "2.0", message))
  io.Print("Content-Length: $(text.ByteLength(body) + 1)\r\n\r\n$body")
end

answer(m, got) = send({id: m.id, result: got})   (** The answer to a request. *)

refuse(m, code, message) = send({id: m.id, error: {code: code, message: message}})   (** The error that answers a request. *)

after(k, s) = if k > value.Len(s) "" else text.Slice(k, value.Len(s), s) end   (** The characters of a text from the k-th. *)

upto(k, s) = if k < 1 "" else text.Slice(1, list.Min([k, value.Len(s)]), s) end   (** The first k characters of a text. *)

defn pathOf(uri)
  (** The path of a file:// URI, its %XX decoded: file:///c%3A/x is c:/x on Windows. Another URI stands for itself. *)
  if not text.StartsWith("file://", uri)
    return uri
  end
  p = encode.UrlDecode(text.Replace("+", "%2B", after(8, uri)))
  if regex.Test("^/[A-Za-z]:", p) after(2, p) else p end
end

defn uriOf(p)
  (** The file:// URI of a path, each part of it %XX encoded. *)
  slashed = text.Replace(text.Char(92), "/", p)
  parts = text.Join("/", [encode.UrlEncode(part) for part in text.Split("/", slashed)])
  if text.StartsWith("/", slashed) "file://$parts" else "file:///$parts" end
end

defn linesOf(s)
  (** The lines of a text as the protocol numbers them, from 0: a last line end opens an empty line. *)
  [if text.EndsWith("\r", l) upto(value.Len(l) - 1, l) else l end for l in text.Split("\n", s)]
end

width(c) = if text.Code(c) >= 65536 2 else 1 end   (** The UTF-16 code units of a character. *)

defn units(line, column)
  (** The UTF-16 code units of the characters of a line before a column, from 1: the character of the protocol. *)
  if text.ByteLength(line) == value.Len(line)
    return list.Max([0, list.Min([column - 1, value.Len(line)])])
  end
  n = 0
  k = 1
  for c in text.Chars(line)
    if k >= column
      return n
    end
    n += width(c)
    k += 1
  end
  n
end

defn columnOf(line, character)
  (** The column, from 1, of the character that a count of UTF-16 code units from the start of a line reaches. *)
  if text.ByteLength(line) == value.Len(line)
    return list.Min([character, value.Len(line)]) + 1
  end
  n = 0
  k = 1
  for c in text.Chars(line)
    if n >= character
      return k
    end
    n += width(c)
    k += 1
  end
  k
end

(** A range of the protocol on one line, from 0, between two counts of UTF-16 code units. end is a word of Cesia, so the keys
    are texts. *)
span(line, first, stop) = {"start": {line: line, character: first}, "end": {line: line, character: stop}}

defn diagnostic(m)
  (** A mark of cesia.Check as the protocol shows it: the span of its line, its severity, its message and its hint. *)
  line = list.Max([m.Line - 1, 0])
  stop = list.Max([m.End, m.Column + 1])
  {range: span(line, units(m.Source, m.Column), units(m.Source, stop)),
   severity: if m.Severity == "error" 1 else 2 end,
   source: "cesia",
   message: if value.IsMissing(m.Hint) m.Message else "$(m.Message)\n$(m.Hint)" end}
end

defn publish(doc)
  (** Checks an open file, with the files of its package as the disk holds them, and sends what is wrong in it. *)
  marks = cesia.Check([doc.Path], {(doc.Path): doc.Text})
  send({method: "textDocument/publishDiagnostics",
        params: {uri: doc.Uri, version: doc.Version, diagnostics: [diagnostic(m) for m in marks if m.File == doc.Path]}})
end

defn rootOf(p)
  (** The folder of the project of a file: the nearest one above it that holds a cesia.toml, else the file's own folder. *)
  dir = path.Dir(p)
  at = dir
  while at != "" and at != "/" and at != "."
    if sys.Exists("$at/cesia.toml")
      return at
    end
    up = path.Dir(at)
    if up == at
      return dir
    end
    at = up
  end
  dir
end

defn sourceFolders(root)
  (** The source folders of a project, [project] src of its cesia.toml, or src. *)
  read = sys.Read("$root/cesia.toml")
  tables = if result.IsOk(read) cesia.Toml(read.Value) else result.Err("none") end
  if result.IsOk(tables)
    for table in tables.Value
      if value.Equal(table.Path, ["project"])
        for entry in table.Entries
          if entry.Key == "src"
            return entry.Value
          end
        end
      end
    end
  end
  ["src"]
end

defn folderFiles(dir)
  (** The files of the package in a folder, without its tests, in order; none if it can't be read. *)
  names = sys.List(dir)
  if result.IsErr(names)
    return []
  end
  list.Sort(["$dir/$n" for n in names.Value if text.EndsWith(".ce", n) and not text.EndsWith(".test.ce", n)])
end

defn packageFiles(p)
  (** The files whose names a file sees without a use, itself first: those of its folder when it is in a source folder of
      its project, a package; else itself alone, a program. *)
  root = rootOf(p)
  dir = path.Dir(p)
  inside = list.Any([dir == "$root/$s" or text.StartsWith("$root/$s/", dir) for s in sourceFolders(root)])
  if not inside
    return [p]
  end
  list.Prepend(p, [f for f in folderFiles(dir) if f != p])
end

defn uses(defs)
  (** The packages that a file uses, under the name the code gives each, from its definitions: {list: "std/list", sets:
      "std/set"}. *)
  found = {}
  for d in defs
    if d.Kind == "use"
      found[d.Name] = d.Signature
    end
  end
  found
end

nameChar(c) = text.Code(c) >= 128 or regex.Test("^[A-Za-z0-9_]$", c)   (** Can the character be part of a name? *)

defn wordAt(line, column)
  (** The dotted name under a column of a line, up to the end of the part under it, {Word, First, Stop, Dotted}: in
      list.Map(f), Map gives list.Map and list gives list. First is its first column, Stop the one after it, and Dotted
      tells a name after the dot of a value, as Half in Rect(2, 1).Half(). Missing off a name. *)
  chars = text.Chars(line)
  n = value.Len(chars)
  at = column
  if at > n or not nameChar(chars[at])
    at -= 1
  end
  if at < 1 or at > n or not nameChar(chars[at])
    return missing
  end
  first = at
  while first > 1 and (nameChar(chars[first - 1]) or chars[first - 1] == ".")
    first -= 1
  end
  stop = at
  while stop < n and nameChar(chars[stop + 1])
    stop += 1
  end
  dotted = chars[first] == "."
  while chars[first] == "."
    first += 1
  end
  {Word: text.Join("", chars[first..stop]), First: first, Stop: stop + 1, Dotted: dotted}
end

defn textOf(state, p)
  (** The text of a file: that of its open buffer, else that of the disk; missing if it can't be read. *)
  for doc in dict.Values(state.Docs)
    if doc.Path == p
      return doc.Text
    end
  end
  read = sys.Read(p)
  if result.IsOk(read) read.Value else missing end
end

defn known(state, files)
  (** The state with the definitions of these files as cesia.Definitions reads them, each kept with the text it read:
      a text that doesn't read, as one being typed, keeps the definitions of the last one that did, or, when none did,
      takes those of the file on the disk. *)
  for f in files
    t = textOf(state, f)
    kept = dict.Get(f, state.Defs)
    if not value.IsMissing(t) and (value.IsMissing(kept) or kept.Text != t)
      got = cesia.Definitions(t)
      before = if value.IsMissing(kept) onDisk(f) else kept.List end
      state.Defs[f] = {Text: t, Lines: linesOf(t), List: if result.IsOk(got) got.Value else before end}
    end
  end
  state
end

defn onDisk(f)
  (** The definitions of a file as it is on the disk, or none when it doesn't read there either. *)
  read = sys.Read(f)
  got = if result.IsOk(read) cesia.Definitions(read.Value) else read end
  if result.IsOk(got) got.Value else [] end
end

defn qualified(state, used, names)
  (** Where a name of a package of the project is defined, as its files are now, open or on the disk: Area, or
      Rect.Square, a static method; {File, Def, Lines} with the signature that the package names, or missing. *)
  owner = if value.Len(names) > 1 names[1] else missing end
  for f in folderFiles(used)
    kept = dict.Get(f, state.Defs)
    for d in if value.IsMissing(kept) [] else kept.List end
      if d.Name == list.Last(names) and d.Kind != "use" and value.Equal(d.Owner, owner)
        if d.Signature != ""
          d.Signature = "$(path.Base(used)).$(d.Signature)"
        end
        return {File: f, Def: d, Lines: kept.Lines}
      end
    end
  end
  missing
end

defn definitionOf(state, doc, w, packages)
  (** Where a name that no use leads to is defined, among the definitions in the state: a name of the file's own
      package, Area or Rect.Square; or a method, after the dot of a value, that this package or a package of the project
      that the file uses defines, the first of its name. {File, Def, Lines} or missing. *)
  parts = text.Split(".", w.Word)
  name = list.Last(parts)
  owner = if value.Len(parts) > 1 parts[value.Len(parts) - 1] else if w.Dotted "" else missing end
  method = missing
  for f in filesFor(doc, owner, packages)
    kept = dict.Get(f, state.Defs)
    for d in if value.IsMissing(kept) [] else kept.List end
      if d.Name == name and d.Kind != "use" and value.IsMissing(d.Owner) == value.IsMissing(owner)
        here = {File: f, Def: d, Lines: kept.Lines}
        if value.IsMissing(owner) or d.Owner == owner
          return here
        else if value.IsMissing(method)
          method = here
        end
      end
    end
  end
  method
end

defn filesFor(doc, owner, packages)
  (** The files where a name of a file may be defined: its package; for a method, the packages of the project it uses too. *)
  files = packageFiles(doc.Path)
  if not value.IsMissing(owner)
    root = rootOf(doc.Path)
    for used in dict.Values(packages)
      if not text.StartsWith("std/", used)
        files = list.Concat(files, folderFiles("$root/$used"))
      end
    end
  end
  files
end

docName(used) = if text.StartsWith("std/", used) path.Base(used) else used end

defn target(state, doc, pos)
  (** What the name under a position of an open file leads to, and the state with the definitions it read: {State,
      Found}, Found {Word, Range, Entry} for a name that cesia doc knows, {Word, Range, Module} for the name of a package,
      {Word, Range, Local} for one of the file's own package, or missing. *)
  if pos.line >= value.Len(doc.Lines)
    return {State: state, Found: missing}
  end
  line = doc.Lines[pos.line + 1]
  w = wordAt(line, columnOf(line, pos.character))
  if value.IsMissing(w)
    return {State: state, Found: missing}
  end
  found = {Word: w.Word,
           Range: span(pos.line, units(line, w.First), units(line, w.Stop))}
  parts = text.Split(".", w.Word)
  state = known(state, [doc.Path])
  packages = uses(state.Defs[doc.Path].List)
  if not w.Dotted and dict.Has(parts[1], packages)
    used = packages[parts[1]]
    if value.Len(parts) == 1
      found.Module = used
      return {State: state, Found: found}
    end
    names = parts[2..value.Len(parts)]
    (* A package of the project: its files as the editor holds them, which the disk may not have yet. *)
    if not text.StartsWith("std/", used)
      dir = "$(rootOf(doc.Path))/$used"
      state = known(state, folderFiles(dir))
      found.Local = qualified(state, dir, names)
      if not value.IsMissing(found.Local)
        return {State: state, Found: found}
      end
    end
    found.Entry = cesia.DocEntry("$(docName(used)).$(text.Join(".", names))")
    return {State: state, Found: if value.IsMissing(found.Entry) missing else found end}
  end
  if not w.Dotted and value.Len(parts) == 1 and w.Word in cesia.Keywords()
    found.Entry = cesia.DocEntry(w.Word)
    return {State: state, Found: if value.IsMissing(found.Entry) missing else found end}
  end
  owner = if value.Len(parts) > 1 or w.Dotted "" else missing end
  state = known(state, filesFor(doc, owner, packages))
  found.Local = definitionOf(state, doc, w, packages)
  {State: state, Found: if value.IsMissing(found.Local) missing else found end}
end

defn entryText(e)
  (** The documentation of a name, in Markdown: its signature and its examples as code, its text between. *)
  parts = ["```cesia\n$(e.Signature)\n```"]
  if e.Text != ""
    parts = list.Append(e.Text, parts)
  end
  if value.Len(e.Examples) > 0
    parts = list.Append("```cesia\n$(text.Join("\n", e.Examples))\n```", parts)
  end
  text.Join("\n\n", parts)
end

defn localText(local)
  (** The documentation of a name of the file's own package, in Markdown: its signature as cesia doc gives it, else its
      line without its comment, and the text of its (** *). *)
  d = local.Def
  line = if d.Line <= value.Len(local.Lines) local.Lines[d.Line] else "" end
  cut = text.Find("(**", line)
  head = if d.Signature != "" d.Signature else text.Trim(if value.IsMissing(cut) line else upto(cut - 1, line) end) end
  if d.Text == "" "```cesia\n$head\n```" else "```cesia\n$head\n```\n\n$(d.Text)" end
end

defn hover(state, p)
  (** The documentation of the name under the cursor, or missing, and the state after it: {State, Answer}. *)
  doc = dict.Get(p.textDocument.uri, state.Docs)
  if value.IsMissing(doc)
    return {State: state, Answer: missing}
  end
  got = target(state, doc, p.position)
  t = got.Found
  if value.IsMissing(t)
    return {State: got.State, Answer: missing}
  end
  shown = if dict.Has("Entry", t)
    entryText(t.Entry)
  else if dict.Has("Module", t)
    cesia.Doc(t.Module)
  else
    localText(t.Local)
  end
  answered = if value.IsMissing(shown) or shown == "" missing else {contents: {kind: "markdown", value: shown}, range: t.Range} end
  {State: got.State, Answer: answered}
end

place(p, line, column) = {uri: uriOf(p), range: span(line, column, column)}   (** A place of a file, for the protocol. *)

defn placeOf(local)
  (** The place of a definition, at its name. *)
  d = local.Def
  line = if d.Line <= value.Len(local.Lines) local.Lines[d.Line] else "" end
  place(local.File, d.Line - 1, units(line, d.Column))
end

defn definition(state, p)
  (** Where the name under the cursor is defined, or missing, and the state after it: {State, Answer}. A name of Cesia's
      own std/ that no copy in the project holds has no file. *)
  doc = dict.Get(p.textDocument.uri, state.Docs)
  if value.IsMissing(doc)
    return {State: state, Answer: missing}
  end
  got = target(state, doc, p.position)
  state = got.State
  t = got.Found
  if value.IsMissing(t)
    return {State: state, Answer: missing}
  end
  if dict.Has("Local", t)
    return {State: state, Answer: placeOf(t.Local)}
  end
  root = rootOf(doc.Path)
  if dict.Has("Module", t)
    files = folderFiles("$root/$(t.Module)")
    return {State: state, Answer: if value.Len(files) == 0 missing else place(files[1], 0, 0) end}
  end
  e = t.Entry
  file = "$root/$(e.File)"
  if e.Builtin or value.IsMissing(textOf(state, file))
    return {State: state, Answer: missing}
  end
  state = known(state, [file])
  kept = state.Defs[file]
  at = [d for d in kept.List if d.Line == e.Line and d.Kind != "use"]
  answered = if value.Len(at) == 0 place(file, e.Line - 1, 0) else placeOf({File: file, Def: at[1], Lines: kept.Lines}) end
  {State: state, Answer: answered}
end

defn shortName(n)
  (** A documented name without its package: list.Map gives Map, geo.Rect.Area gives Rect.Area. *)
  slash = list.Last(text.Split("/", n))
  dot = text.Find(".", slash)
  if value.IsMissing(dot) n else text.Slice(dot + 1, value.Len(slash), slash) end
end

defn completion(state, p)
  (** The names of a package after its name and a dot, each with its signature and documentation, and the state after
      them: {State, Answer}. *)
  doc = dict.Get(p.textDocument.uri, state.Docs)
  if value.IsMissing(doc) or p.position.line >= value.Len(doc.Lines)
    return {State: state, Answer: []}
  end
  line = doc.Lines[p.position.line + 1]
  column = columnOf(line, p.position.character)
  before = upto(column - 1, line)
  m = regex.Find("([A-Za-z][A-Za-z0-9]*)[.][A-Za-z0-9]*$", before)
  state = known(state, [doc.Path])
  packages = uses(state.Defs[doc.Path].List)
  if value.IsMissing(m) or not dict.Has(m.Groups[1], packages)
    return {State: state, Answer: []}
  end
  items = []
  for n in cesia.DocNames(packages[m.Groups[1]])
    short = shortName(n)
    if not text.Contains(".", short)
      e = cesia.DocEntry(n)
      kind = if value.IsMissing(e) 21 else if text.Contains("(", e.Signature) 3 else if text.Contains("{", e.Signature) 22 else 21 end
      item = {label: short, kind: kind}
      if not value.IsMissing(e)
        item.detail = e.Signature
        item.documentation = {kind: "markdown", value: entryText(e)}
      end
      items = list.Append(item, items)
    end
  end
  {State: state, Answer: items}
end

defn opened(state, d, version, body)
  (** The state with a file open, or changed, and marked to be checked. *)
  p = pathOf(d.uri)
  state.Docs[d.uri] = {Uri: d.uri, Path: p, Version: version, Text: body, Lines: linesOf(body)}
  state.Dirty[d.uri] = true
  state
end

defn saved(state, uri)
  (** The state after a save: every open file of the folder of the saved one is checked again, as the other files of a
      package see what it defines. *)
  doc = dict.Get(uri, state.Docs)
  if not value.IsMissing(doc)
    for other in dict.Values(state.Docs)
      if path.Dir(other.Path) == path.Dir(doc.Path)
        state.Dirty[other.Uri] = true
      end
    end
  end
  state
end

defn closed(state, uri)
  (** The state without a file, whose marks the editor forgets. *)
  send({method: "textDocument/publishDiagnostics", params: {uri: uri, diagnostics: []}})
  state.Docs = dict.Drop(uri, state.Docs)
  state.Dirty = dict.Drop(uri, state.Dirty)
  state
end

defn answered(m, got)
  (** Answers a request with what {State, Answer} holds, and gives its state. *)
  answer(m, got.Answer)
  got.State
end

defn handle(state, m)
  (** Answers a message of the editor, and gives the state after it. *)
  method = dict.GetOr("method", "", m)
  p = dict.GetOr("params", {}, m)
  request = dict.Has("id", m)
  if method == "initialize"
    answer(m, {capabilities: capabilities, serverInfo: {name: "cesia", version: cesia.Version()}})
  else if method == "shutdown"
    state.Down = true
    answer(m, missing)
  else if method == "exit"
    sys.Exit(if state.Down 0 else 1 end)
  else if method == "textDocument/didOpen"
    state = opened(state, p.textDocument, p.textDocument.version, p.textDocument.text)
  else if method == "textDocument/didChange"
    state = opened(state, p.textDocument, p.textDocument.version, list.Last(p.contentChanges).text)
  else if method == "textDocument/didSave"
    state = saved(state, p.textDocument.uri)
  else if method == "textDocument/didClose"
    state = closed(state, p.textDocument.uri)
  else if method == "textDocument/hover"
    state = answered(m, hover(state, p))
  else if method == "textDocument/definition"
    state = answered(m, definition(state, p))
  else if method == "textDocument/completion"
    state = answered(m, completion(state, p))
  else if request
    refuse(m, -32601, "cesia lsp has no method $method.")
  end
  state
end

defn step(state, body)
  (** Reads a message and answers it in a fiber of its own: a bug in the server answers an error, and the state stays as it
      was. *)
  parsed = json.Parse(body)
  if result.IsErr(parsed) or not value.IsDict(parsed.Value)
    send({id: missing, error: {code: -32700, message: "cesia lsp can't read this message."}})
    return state
  end
  m = parsed.Value
  done = fiber.Wait(fiber.Spawn(() -> handle(state, m)))
  if result.IsOk(done)
    return done.Value
  end
  if dict.Has("id", m)
    refuse(m, -32603, "cesia lsp failed: $(done.Error.Message)")
  end
  state
end

defn checkOne(state)
  (** Checks one of the open files that changed, and gives the state without it to check, with its definitions read
      while the editor is quiet, for the next hover. *)
  uri = dict.Keys(state.Dirty)[1]
  doc = dict.Get(uri, state.Docs)
  if not value.IsMissing(doc)
    _ = fiber.Wait(fiber.Spawn(() -> publish(doc)))
    read = fiber.Wait(fiber.Spawn(() -> known(state, [doc.Path])))
    if result.IsOk(read)
      state = read.Value
    end
  end
  state.Dirty = dict.Drop(uri, state.Dirty)
  state
end

defn Main()
  (** Serves the editor until it says exit, or until the end of the input. The files that changed are checked once the
      editor is quiet, one at a time, and a message that comes between two of them is answered first: a request never waits
      for more than the check of one file. *)
  inbox = fiber.Channel()
  fiber.Spawn(() -> reader(inbox))
  state = {Docs: {}, Dirty: {}, Defs: {}, Down: false}
  pause = quiet
  while true
    got = if value.Len(state.Dirty) == 0 fiber.Receive(inbox) else fiber.Receive(inbox, timeout = pause) end
    if result.IsErr(got)
      state = checkOne(state)
      pause = between
    else if value.IsMissing(got.Value)
      sys.Exit(if state.Down 0 else 1 end)
    else
      state = step(state, got.Value)
      pause = quiet
    end
  end
  result.Ok(missing)
end
