(** cesia upgrade: Cesia itself, from its releases on GitHub, the newest one, or the nightly one with --nightly. It shows the
    notes and asks, downloads the archive of this system (bin/ and lib/), checks its fingerprint, tries the new binary, and
    only then puts it in place of the old one, with its lib/: any failure before leaves the old one as it was.
    CESIA_RELEASES=file:///folder reads folder/latest.json or folder/nightly.json instead of GitHub: for tests and mirrors.
    Run by the binary. *)
use std/sys
use std/json
use std/cesia
use std/debug
use std/http
use std/tls
use std/dict
use std/io
use std/list
use std/result
use std/text
use std/value

github = "https://api.github.com/repos/www-celestial/cesia-lang/releases"
backslash = text.Char(92)

defn parent(path)
  (** The folder of a path. *)
  parts = text.Split("/", path)
  text.Join("/", parts[1..value.Len(parts) - 1])
end

defn download(url)
  (** The bytes at a URL: a file:// one is read, an https:// one fetched, following its redirects. *)
  if text.StartsWith("file://", url)
    return sys.Read(text.Slice(8, value.Len(url), url))
  end
  secure = tls.Client(tls.Open()?)
  at = url
  for hop in 1..5
    r = http.Get(at, headers = [{Name: "User-Agent", Value: "cesia-upgrade"}], secure = secure)?
    location = http.HeaderValue("location", r.Headers)
    if r.Status >= 300 and r.Status < 400 and not value.IsMissing(location)
      at = location
    else if r.Status != 200
      return result.Err("$at answered $(r.Status).")
    else
      return result.Ok(r.Body)
    end
  end
  result.Err("$url redirects too many times.")
end

defn release(nightly)
  (** The release to install, as GitHub's API gives it: tag_name, name, body and assets. *)
  mirror = sys.Env("CESIA_RELEASES")
  url = if not value.IsMissing(mirror) and mirror != ""
    "$mirror/$(if nightly "nightly" else "latest" end).json"
  else
    "$github/$(if nightly "tags/nightly" else "latest" end)"
  end
  got = download(url)
  if result.IsErr(got)
    return result.Err("Can't read the releases of Cesia: $(if value.IsText(got.Error) got.Error else got.Error.Message end)")
  end
  json.Parse(got.Value)
end

defn system(binary)
  (** The name of this system in the names of the archives: linux-x86_64, macos-arm64, windows-x86_64. Windows is told by the
      .exe of the binary: the uname of Git's shell would say mingw64_nt. *)
  said = sys.Run("uname", args = ["-s", "-m"])
  if text.EndsWith(".exe", binary) or result.IsErr(said) or said.Value.Code != 0
    return "windows-x86_64"
  end
  words = text.Split(" ", text.Lower(text.Trim(said.Value.Out)))
  os = if words[1] == "darwin" "macos" else words[1] end
  machine = list.Last(words)
  arch = if machine == "amd64" "x86_64" else if machine == "aarch64" "arm64" else machine end
  "$os-$arch"
end

defn asset(rel, name)
  (** The download URL of an asset of a release, or missing. *)
  for a in dict.GetOr("assets", [], rel)
    if a["name"] == name
      return a["browser_download_url"]
    end
  end
  missing
end

defn versionOf(binary)
  (** What a binary of Cesia answers to version, or an Err. *)
  r = sys.Run(binary, args = ["version"])?
  if r.Code == 0 result.Ok(text.Trim(r.Out)) else result.Err("$binary didn't run: $(text.Trim(r.Err))") end
end

defn replace(home, fresh, binary)
  (** Puts the new cesia and lib/ in place of the old ones. A running binary can be renamed on every system, but not always
      replaced, so the old one is moved away first. On Windows ce.exe is a copy of cesia.exe, not a link: it gets one too. *)
  ext = if text.EndsWith(".exe", binary) ".exe" else "" end
  target = "$home/bin/cesia$ext"
  old = "$home/bin/.old-cesia$ext"
  if sys.Exists(old)
    _ = sys.Remove(old)
  end
  if sys.Exists(target)
    sys.Rename(target, old)?
  end
  moved = sys.Rename("$fresh/bin/cesia$ext", target)
  if result.IsErr(moved)
    _ = sys.Rename(old, target)
    return moved
  end
  short = "$home/bin/ce$ext"
  stat = sys.Stat(short)
  if ext != "" and result.IsOk(stat) and not stat.Value.IsLink
    sys.Rename(short, "$home/bin/.old-ce$ext")?
    sys.Write(short, sys.Read(target)?)?
  end
  if sys.Exists("$fresh/lib")
    if sys.Exists("$home/lib")
      sys.Rename("$home/lib", "$fresh/old-lib")?
    end
    sys.Rename("$fresh/lib", "$home/lib")?
  end
  _ = sys.Remove(old)
  result.Ok(missing)
end

defn removeAll(path)
  (** Deletes a folder with all it holds; a link goes, never what it points to. *)
  stat = sys.Stat(path)
  if result.IsOk(stat) and stat.Value.IsDir and not stat.Value.IsLink
    for name in sys.List(path)?
      removeAll("$path/$name")?
    end
  end
  if sys.Exists(path) or result.IsOk(sys.List(path)) sys.Remove(path) else result.Ok(missing) end
end

defn upgrade(args)
  (** cesia upgrade [--nightly]. *)
  if value.Len(args) > 1 or (value.Len(args) == 1 and args[1] != "--nightly")
    return result.Err("usage: cesia upgrade [--nightly]")
  end
  nightly = value.Len(args) == 1
  binary = text.Replace(backslash, "/", cesia.Binary())
  current = versionOf(binary)?
  mirror = sys.Env("CESIA_RELEASES")
  if cesia.Dev() and (value.IsMissing(mirror) or mirror == "")
    return result.Err("This Cesia was built from its sources ($current): git pull and dune build bring it up to date, not cesia upgrade.")
  end
  bin = parent(binary)
  home = parent(bin)
  if list.Last(text.Split("/", bin)) != "bin" or not sys.Exists("$home/lib/licenses/Cesia.txt")
    return result.Err("cesia upgrade replaces a Cesia that install.sh or install.ps1 put in place, with its bin/ and lib/ side by side, and $binary isn't one: install the new one the way this one was. Nothing changed.")
  end
  rel = release(nightly)?
  tag = dict.GetOr("tag_name", "", rel)
  title = dict.GetOr("name", tag, rel)
  later = cesia.Compare(tag, cesia.Version())
  (* From a nightly, its own stable release is a way back to stable: it is offered too. *)
  newer = if nightly title != current else later > 0 or (later == 0 and text.Contains("-nightly", current)) end
  if not newer
    io.Print("$current is the newest$(if nightly " nightly" else "" end): nothing to do.")
    return result.Ok(missing)
  end
  io.Print("$title")
  notes = text.Trim(dict.GetOr("body", "", rel))
  if notes != ""
    io.Print("")
    io.Print(notes)
    io.Print("")
  end
  io.Print("Replace $current by $title? [y/n]")
  answer = debug.ReadLine()
  if value.IsMissing(answer) or text.Lower(text.Trim(answer)) != "y"
    io.Print("Nothing changed.")
    return result.Ok(missing)
  end
  windows = system(binary) == "windows-x86_64"
  archive = "cesia-$(system(binary)).$(if windows "zip" else "tar.gz" end)"
  url = asset(rel, archive)
  print = asset(rel, "$archive.blake2")
  if value.IsMissing(url) or value.IsMissing(print)
    return result.Err("This release has no $archive with its fingerprint: nothing changed.")
  end
  bytes = download(url)?
  expected = text.Trim(download(print)?)
  if cesia.Fingerprint(bytes) != expected
    return result.Err("The download of $archive doesn't match its fingerprint: nothing changed.")
  end
  fresh = "$home/.upgrade"
  removeAll(fresh)?
  sys.Mkdir(fresh)?
  sys.Write("$fresh/$archive", bytes)?
  unpacked = sys.Run("tar", args = [if windows "-xf" else "-xzf" end, "$fresh/$archive", "-C", fresh])?
  if unpacked.Code != 0
    _ = removeAll(fresh)
    return result.Err("Can't unpack $archive: $(text.Trim(unpacked.Err)). Nothing changed.")
  end
  tried = versionOf("$fresh/bin/cesia$(if text.EndsWith(".exe", binary) ".exe" else "" end)")
  if result.IsErr(tried) or not text.StartsWith("cesia ", tried.Value)
    _ = removeAll(fresh)
    return result.Err("The new binary doesn't answer as Cesia: nothing changed.")
  end
  replace(home, fresh, binary)?
  _ = removeAll(fresh)
  io.Print("$(tried.Value) is in place.")
  result.Ok(missing)
end

defn Main()
  (** Runs the command of Args; an error is a text, which the binary shows. *)
  match upgrade(sys.Args)
    result.Err(e) -> result.Err(if value.IsText(e) e else e.Message end)
    done -> done
  end
end
