(** The superinstructions, generated by gen/gen_super.ml. *)
open Types

type op = Add | Sub | Mul
type fl = FL of int | FK of float | FX of (ctx -> float)
type il = IL of int | IK of int | IX of (ctx -> int)

val add_i : ctx -> int -> int -> int -> int
val sub_i : ctx -> int -> int -> int -> int
val mul_i : ctx -> int -> int -> int -> int

(** (a o1 b) o2 c, if a and b are leaves. *)
val float_left : op -> op -> fl -> fl -> fl -> (ctx -> float) option

(** c o2 (a o1 b) *)
val float_right : op -> op -> fl -> fl -> fl -> (ctx -> float) option

val int_left : int -> int -> op -> op -> il -> il -> il -> (ctx -> int) option
val int_right : int -> int -> op -> op -> il -> il -> il -> (ctx -> int) option
