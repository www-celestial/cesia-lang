; cesia build --target wasm: Cesia compiled ahead of time to WebAssembly. A library whose plugin cesia_wasm.cmxs the
; binary loads for cesia build only (src/bin/main.ml), so that no program pays for its code. The runtime and the loader
; it writes beside a module are in src/web/, copied here: one plugin.

(library
 (name cesia_wasm)
 (flags
  (:standard -open Cesia))
 (libraries cesia cesia_sys))

(copy_files#
 (files ../web/*.ml))

(rule
 (targets glue.ml)
 (deps ../web/glue.js)
 (action
  (with-stdout-to
   %{targets}
   (progn
    (echo "let text = {glue|")
    (cat ../web/glue.js)
    (echo "|glue}\n")))))

; The versions of packages of std/ for a page, written in Cesia: Pages.all, each package with its source.
(rule
 (targets pages.ml)
 (deps
  (glob_files ../web/*.ce))
 (action
  (with-stdout-to
   %{targets}
   (progn
    (echo "let all = [\n")
    (echo "  \"std/websocket\", {page|")
    (cat ../web/websocket.ce)
    (echo "|page};\n")
    (echo "  \"std/list\", {page|")
    (cat ../web/list.ce)
    (echo "|page};\n")
    (echo "  \"std/json\", {page|")
    (cat ../web/json.ce)
    (echo "|page};\n")
    (echo "  \"std/columns\", {page|")
    (cat ../web/columns.ce)
    (echo "|page};\n")
    (echo "  \"std/matrix\", {page|")
    (cat ../web/matrix.ce)
    (echo "|page};\n")
    (echo "  \"std/regex\", {page|")
    (cat ../web/regex.ce)
    (echo "|page};\n")
    (echo "]\n")))))

; Loaded at its first use, not at start-up: its size costs no start-up, so its code inlines as much as it gains from.
(env
 (release
  (ocamlopt_flags (-inline 200))))
