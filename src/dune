(library
 (name kepler)
 (modules_without_implementation ast types))

(rule
 (targets super.ml)
 (action
  (with-stdout-to
   %{targets}
   (run ../gen/gen_super.exe))))

(rule
 (targets embedded.ml)
 (deps
  (glob_files ../std/*.k))
 (action
  (with-stdout-to
   %{targets}
   (run ../gen/gen_embed.exe %{deps}))))
