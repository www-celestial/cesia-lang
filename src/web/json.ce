(** std/json in a program compiled to WebAssembly: Parse in Cesia, which cesia build --target wasm takes for the native
    json.Parse (json.Text is in src/web/rtstd.ml). The same values and Errs as the interpreter's: objects become
    dictionaries, null missing, an integer past 63 bits the text of its digits. *)
use std/bug
use std/list
use std/result
use std/text
use std/value

maxDepth = 1000   (* As Json.max_depth. *)

(* The Err of a mistake at byte at, from 1. *)
bad(what, at) = result.Err({Kind: "json", Message: "$what, at byte $at."})

defn space(s, i)
  (** The place of the first byte at i or after that isn't a space, a tab or a line end. *)
  n = text.ByteLength(s)
  while i <= n
    b = text.Byte(i, s)
    if not (b == 32 or b == 9 or b == 10 or b == 13)
      return i
    end
    i += 1
  end
  i
end

defn Parse(s)
  (** Reads JSON text: an Ok of the value, or an Err of the kind "json" and the place of the mistake. *)
  if not value.IsText(s)
    bug.Panic("Parse needs a text, not $s.")
  end
  got = item(s, space(s, 1), 0)
  if result.IsErr(got)
    return got
  end
  at = space(s, got.Value[2])
  if at <= text.ByteLength(s)
    return bad("Text after the value", at)
  end
  result.Ok(got.Value[1])
end

defn item(s, i, depth)
  (** The value that starts at byte i: an Ok of [value, the place after it], or an Err. *)
  if depth > maxDepth
    return bad("Too deep", i)
  end
  n = text.ByteLength(s)
  if i > n
    return bad("Expected a value", i)
  end
  b = text.Byte(i, s)
  if b == 123
    return object(s, space(s, i + 1), depth)
  else if b == 91
    return array(s, space(s, i + 1), depth)
  else if b == 34
    return string(s, i + 1)
  else if b == 45 or b >= 48 and b <= 57
    return number(s, i)
  else if word("true", s, i)
    return result.Ok([true, i + 4])
  else if word("false", s, i)
    return result.Ok([false, i + 5])
  else if word("null", s, i)
    return result.Ok([missing, i + 4])
  end
  bad("Unexpected text", i)
end

word(w, s, i) = i + text.ByteLength(w) - 1 <= text.ByteLength(s) and text.ByteSlice(i, i + text.ByteLength(w) - 1, s) == w   (* Is w at byte i? *)

defn array(s, i, depth)
  (** The rest of an array after its [. *)
  out = []
  if i <= text.ByteLength(s) and text.Byte(i, s) == 93
    return result.Ok([out, i + 1])
  end
  while true
    got = item(s, i, depth + 1)
    if result.IsErr(got)
      return got
    end
    out = list.Append(got.Value[1], out)
    i = space(s, got.Value[2])
    if i > text.ByteLength(s)
      return bad("Expected a comma or ]", i)
    end
    b = text.Byte(i, s)
    if b == 93
      return result.Ok([out, i + 1])
    end
    if b != 44
      return bad("Expected a comma or ]", i)
    end
    i = space(s, i + 1)
  end
end

defn object(s, i, depth)
  (** The rest of an object after its {: a dictionary, a later key in the place of the first. *)
  out = {}
  if i <= text.ByteLength(s) and text.Byte(i, s) == 125
    return result.Ok([out, i + 1])
  end
  while true
    if i > text.ByteLength(s) or text.Byte(i, s) != 34
      return bad("A key needs a text", i)
    end
    key = string(s, i + 1)
    if result.IsErr(key)
      return key
    end
    i = space(s, key.Value[2])
    if i > text.ByteLength(s) or text.Byte(i, s) != 58
      return bad("Expected a colon", i)
    end
    got = item(s, space(s, i + 1), depth + 1)
    if result.IsErr(got)
      return got
    end
    out[key.Value[1]] = got.Value[1]
    i = space(s, got.Value[2])
    if i > text.ByteLength(s)
      return bad("Expected a comma or }", i)
    end
    b = text.Byte(i, s)
    if b == 125
      return result.Ok([out, i + 1])
    end
    if b != 44
      return bad("Expected a comma or }", i)
    end
    i = space(s, i + 1)
  end
end

defn hex(s, i)
  (** The number of the four hex digits at byte i, or missing. *)
  if i + 3 > text.ByteLength(s)
    return missing
  end
  v = 0
  for k in i..(i + 3)
    b = text.Byte(k, s)
    d = if b >= 48 and b <= 57 b - 48 else if b >= 97 and b <= 102 b - 87 else if b >= 65 and b <= 70 b - 55 else -1 end
    if d < 0
      return missing
    end
    v = v * 16 + d
  end
  v
end

defn string(s, i)
  (** The rest of a text after its opening quote: an Ok of [the text, the place after its closing quote]. *)
  parts = []
  from = i
  n = text.ByteLength(s)
  while true
    if i > n
      return bad("A text is not closed", from - 1)
    end
    b = text.Byte(i, s)
    if b == 34
      parts = list.Append(text.ByteSlice(from, i - 1, s), parts)
      return result.Ok([text.Join("", parts), i + 1])
    end
    if b < 32
      return bad("A control character in a text", i)
    end
    if b == 92
      parts = list.Append(text.ByteSlice(from, i - 1, s), parts)
      if i + 1 > n
        return bad("A text is not closed", from - 1)
      end
      e = text.Byte(i + 1, s)
      i += 2
      if e == 117
        c = hex(s, i)
        if value.IsMissing(c)
          return bad("A \\u escape needs four hex digits", i - 2)
        end
        i += 4
        if c >= 0xD800 and c <= 0xDBFF
          low = if word("\\u", s, i) hex(s, i + 2) else missing end
          if value.IsMissing(low) or low < 0xDC00 or low > 0xDFFF
            return bad("A surrogate is alone", i - 6)
          end
          c = 0x10000 + (c - 0xD800) * 1024 + low - 0xDC00
          i += 6
        else if c >= 0xDC00 and c <= 0xDFFF
          return bad("A surrogate is alone", i - 6)
        end
        parts = list.Append(text.Char(c), parts)
      else
        k = text.Find(text.Char(e), "\"\\/bfnrt")
        if value.IsMissing(k)
          return bad("A bad escape", i - 2)
        end
        parts = list.Append(text.Char([34, 92, 47, 8, 12, 10, 13, 9][k]), parts)
      end
      from = i
    else
      i += 1
    end
  end
end

defn number(s, i)
  (** A number at byte i: an integer when it is whole and fits in 63 bits, its digits as a text when it doesn't, else a
      float. *)
  start = i
  n = text.ByteLength(s)
  if text.Byte(i, s) == 45
    i += 1
  end
  first = i
  if i <= n and text.Byte(i, s) == 48
    i += 1
  else
    i = digits(s, i)
    if i == first
      return bad("A number needs digits", i)
    end
  end
  whole = true
  if i <= n and text.Byte(i, s) == 46
    whole = false
    j = digits(s, i + 1)
    if j == i + 1
      return bad("A number needs digits", j)
    end
    i = j
  end
  if i <= n and (text.Byte(i, s) == 101 or text.Byte(i, s) == 69)
    whole = false
    i += 1
    if i <= n and (text.Byte(i, s) == 43 or text.Byte(i, s) == 45)
      i += 1
    end
    j = digits(s, i)
    if j == i
      return bad("A number needs digits", j)
    end
    i = j
  end
  t = text.ByteSlice(start, i - 1, s)
  x = text.Number(t)
  if whole and not value.IsInt(x)
    return result.Ok([t, i])
  end
  if not whole and value.IsInt(x)
    x = x * 1.0
  end
  if x - x != 0
    return bad("A number is too large", start)
  end
  result.Ok([x, i])
end

defn digits(s, i)
  (** The place after the digits at byte i. *)
  n = text.ByteLength(s)
  while i <= n and text.Byte(i, s) >= 48 and text.Byte(i, s) <= 57
    i += 1
  end
  i
end
