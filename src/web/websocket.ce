(** std/websocket in a program compiled to WebAssembly: the WebSocket of the page or of Node, by js.Call, in place of the
    one over std/net. cesia build --target wasm takes these functions for those of std/websocket that have the same name:
    Dial, Send and Close, with the same arguments and results. The browser makes the handshake and sends its own headers,
    its cookies and Origin; a message comes whole, and nothing waits for a full Messages, which the browser can't slow. *)
use std/fiber
use std/js
use std/result
use std/text
use std/value

(** A connection that Dial opened: Messages receives each message, a text, and is closed when the connection ends. *)
struct Conn { Messages, socket, events }

refused(message) = result.Err({Kind: "websocket", Message: message})   (* An Err of the kind "websocket". *)

defn Dial(url, timeout = 10, maxMessage = 67108864, headers = [])
  (** Connects to the server of a ws:// or wss:// URL within timeout seconds: an Ok of a Conn, or an Err of the kind
      "websocket". A page sends no headers of its own: headers must be empty. maxMessage is the browser's. *)
  if not (value.IsText(url) and (text.StartsWith("ws://", url) or text.StartsWith("wss://", url)))
    return refused("This URL doesn't start with ws:// or wss://: $url")
  end
  if value.Len(headers) > 0
    return refused("A WebSocket of a page sends no headers of its own: the browser sends its cookies and its Origin.")
  end
  messages = fiber.Channel()
  events = fiber.Channel()
  socket = js.Call("cesia:websocket", "Open", [url, messages, events])
  got = fiber.Receive(events, timeout = timeout)
  if result.IsOk(got) and got.Value == "open"
    return result.Ok(Conn(messages, socket, events))
  end
  js.Call("cesia:websocket", "Close", [socket])
  if result.IsErr(got) and got.Error.Kind == "timeout"
    return refused("$url gave no handshake in $timeout seconds.")
  end
  result.Err({Kind: "io", Message: "The connection to $url was refused or lost before its handshake."})
end

defn Send(message, c)
  (** Sends a text message: Ok(missing), or an Err of the kind "closed" once the connection is closing or closed. *)
  if js.Call("cesia:websocket", "Send", [c.socket, message])
    return result.Ok(missing)
  end
  result.Err({Kind: "closed", Message: "The connection is closed."})
end

defn Close(c)
  (** Closes a connection with the code 1000 and waits at most a second for its end: Ok(missing) after a close with
      1000, else an Err of the kind "websocket" that says why. *)
  js.Call("cesia:websocket", "Close", [c.socket])
  while true
    got = fiber.Receive(c.events, timeout = 1)
    if result.IsErr(got)
      return result.Err({Kind: "websocket", Message: "connection lost"})
    end
    if got.Value == "closed 1000" or got.Value == "closed 1005"
      return result.Ok(missing)
    end
    if text.StartsWith("closed", got.Value)
      return result.Err({Kind: "websocket", Message: got.Value})
    end
  end
end
