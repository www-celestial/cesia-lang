(library
 (name cesia_sys)
 (libraries cesia unix)
 (foreign_stubs
  (language c)
  (names stubs ffi calls linalg))
 (c_library_flags
  (:include c_flags.sexp)))

; The JIT's glue to MIR, which only the JIT uses: linked with MIR into its plugin (src/jit), not into the binary, whose
; start-up would pay for MIR's data.

(foreign_library
 (archive_name jitglue)
 (language c)
 (names jit)
 (include_dirs mir))

(rule
 (targets calls.c)
 (action
  (with-stdout-to
   %{targets}
   (run ../gen/gen_calls.exe calls))))

(rule
 (enabled_if
  (= %{system} linux))
 (action
  (with-stdout-to
   c_flags.sexp
   (echo "(-ldl)"))))

(rule
 (enabled_if
  (<> %{system} linux))
 (action
  (with-stdout-to
   c_flags.sexp
   (echo "()"))))

(rule
 (enabled_if
  (= %{system} linux))
 (action
  (copy epoll.ml.in backend.ml)))

(rule
 (enabled_if
  (<> %{system} linux))
 (action
  (copy select.ml.in backend.ml)))
