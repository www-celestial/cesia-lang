(library
 (name cesia)
 (modules_without_implementation ast types))

(rule
 (targets super.ml)
 (action
  (with-stdout-to
   %{targets}
   (run ../gen/gen_super.exe))))

(rule
 (targets embedded.ml)
 (deps
  (glob_files ../std/*.ce)
  (glob_files ../tools/*.ce)
  (glob_files ../tools/*.css)
  (glob_files ../tools/*.js))
 (action
  (with-stdout-to
   %{targets}
   (run ../gen/gen_embed.exe %{deps}))))
