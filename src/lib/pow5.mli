(** The tables of Ryu, generated by gen/gen_pow5.ml: 20 bytes an entry, five limbs of 30 bits, low first, each in 4
    bytes, little-endian. *)

(** Entry i, i = 0..341: the 125 high bits of 5^i (5^i itself, shifted left, while it has fewer). *)
val pow5 : string

(** Entry q, q = 0..290: floor(2^k / 5^q) + 1, where k = bits(5^q) - 1 + 125. *)
val inv : string
