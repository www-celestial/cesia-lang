(** Live screens: a page shows the answers of questions as they change, pushed to it over a WebSocket, and its own
    actions at once, before the app has answered them. Route serves the screens of a path: a screen is a page that
    connects; the app gives it its shows, each a name and a channel of the changes of an answer, and runs the actions that
    the page asks for. live.js, the page's side, comes from the same path. Each screen has a fiber of its own, which
    writes to its page alone: a page that reads nothing holds no other back.

    A break of the connection is no end: a screen whose connection broke is kept resume seconds, its shows going on and
    its frames waiting, so that the page that comes back with its token gets every frame it missed, once, and its
    actions are run once each (the connection state recovery of Socket.IO, the stateful reconnect of SignalR). Past
    that, or on another server, the page gets a new screen, whose first messages are the whole answers. *)
use std/dict
use std/encode
use std/fiber
use std/http
use std/json
use std/list
use std/log
use std/math
use std/metrics
use std/random
use std/result
use std/sys
use std/text
use std/value
use std/websocket as ws

(** A show of a screen: the page knows it by its name, and changes is a channel of std/fiber of the messages of an
    answer that changes. The first is the answer, {Group, Rows}, its rows at the group Group; each next one is a change,
    {Group, Added, Removed}, the rows that came and the rows that went with the group Group, or the answer again. A group
    is a number that grows with each change. The channel is the screen's own, and its source never waits for it: when a
    page reads too slowly, the source drops what the channel holds and sends the answer again, as cepheus.Watch does.

      Show("unpaid", fiber.Channel()).Name --> "unpaid" *)
Show(name, changes) = {Name: name, Changes: changes}

inARow = 64   (* The changes that wait at most for the reply to an action. *)
held = 0.1   (* The seconds that changes wait at most for the reply to an action. *)

defn Route(pattern, screen, a, actions = {}, resume = 120, buffer = 1048576, same = missing, who = missing, client = missing)
  (** An application with the live screens of a path added, and live.js, the page's side, at the path and /live.js.
      screen(s) gives the shows of a screen, a list of Show, or an Err that the page gets; s is {Request, Ended}: the
      HTTP request of the page, its headers and cookies to tell who it is, and a channel that closes when the screen
      ends, for the sources of its shows to stop, as cepheus.Watch does with until = s.Ended. actions maps the name of
      each action to a function (s, args) of the screen and of what the page sent: its value, an Ok's or anything that
      isn't an Err, goes back to the page, which then drops the effect it showed; an Err undoes it. Each screen's
      actions run one after the other, in the order the page asked for them; s.Key is then the action's key, which the
      page made when the action was asked and sends again with it after a break (missing from an older page), for the
      app to run it once (an Idempotency-Key), and s.Base what the page saw before it asked, for the app to refuse a
      change of a thing that changed meanwhile. A page of another origin than the app's gets a 403, as http.SameOrigin
      decides, so that no other site opens a screen with the cookies of its visitor.

      A page that says {Hello: 2} gets a screen that outlives a break: kept resume seconds (0: never) while its frames
      not yet confirmed by the page hold buffer bytes at most, for the page to come back to with its token. same(old,
      new) tells whether the request of a page that comes back is the one of the screen's page (its user, its shows):
      by default the same Cookie header and the same query. who(s), when given, is a text the page stamps its actions
      with: an action of another who is refused, as the next user of a browser sending the actions of the one before.
      client is a value the page gets as it connects, its own settings. A page that says {Hello: 1}, the version
      before, gets a screen that ends with its connection.

        app = http.Handler(http.App() then Route("/live", s -> []))
        app({Method: "GET", Path: "/live/live.js", Query: "", Headers: [], Body: ""}).Status --> 200
        handshake = [{Name: "upgrade", Value: "websocket"}, {Name: "sec-websocket-key", Value: "dGhlIHNhbXBsZSBub25jZQ=="}]
        app({Method: "GET", Path: "/live", Query: "", Headers: handshake, Body: ""}).Status --> 101
        other = list.Append({Name: "origin", Value: "https://elsewhere.example"}, list.Append({Name: "host", Value: "shop.example"}, handshake))
        app({Method: "GET", Path: "/live", Query: "", Headers: other, Body: ""}).Status --> 403 *)
  o = {Screen: screen, Actions: actions, Resume: resume, Buffer: buffer, Same: if value.IsMissing(same) sameRequest else same end, Who: who,
    Client: client, Kept: cell(dict.Dict()), Tickets: fiber.Table(100000)}
  a then http.Get("$pattern/live.js", r -> {Status: 200, Body: script, Headers: [{Name: "content-type", Value: "text/javascript; charset=utf-8"}, {Name: "cache-control", Value: "no-cache"}]}) then http.Get(pattern, r -> http.SameOrigin(s -> opening(s, o), r))
    then http.Route("CONNECT", pattern, r -> http.SameOrigin(s -> transported(s, o), r))
    then http.Get("$pattern/ticket", r -> http.SameOrigin(s -> ticketed(s, o), r))
end

(* How long a ticket of WebTransport waits for its session: a page asks for it just before. *)
ticketTime = 30

defn ticketed(request, o)
  (** A ticket for a WebTransport session, which carries no cookie (W3C WebTransport: its requests are made without
      credentials): a page asks for one by a request that has its cookies, then opens its session with it in the
      query, ?ticket=. The session then has this request's headers, its cookies among them, once, within 30 s. *)
  ticket = newToken()
  fiber.Remember(ticket, request.Headers, sys.Now() + ticketTime, o.Tickets)
  {Status: 200, Body: json.Text({Ticket: ticket}), Headers: [{Name: "content-type", Value: "application/json"}, {Name: "cache-control", Value: "no-store"}]}
end

defn transported(request, o)
  (** The response to a WebTransport session that a page asks for on the same path (http.Serve with webtransport =
      true, over HTTP/3): the same screen as over WebSocket, its messages on the first stream the page opens, each its
      length then its text (std/http3's Messages). *)
  if dict.Get("Protocol", request) != "webtransport"
    return {Status: 400, Body: "This route takes the WebTransport sessions of live.js."}
  end
  r = request
  ticket = if value.IsDict(r.Query) dict.Get("ticket", r.Query) else missing end
  if value.IsText(ticket)
    (* The headers of the request that got the ticket, once: its cookies say who the screen is for. *)
    headers = fiber.Recall(ticket, sys.Now(), o.Tickets)
    fiber.Forget(ticket, o.Tickets)
    if value.IsMissing(headers)
      return {Status: 403, Body: "This ticket is unknown, used or too old."}
    end
    r.Headers = headers
    r.Cookies = cookiesOf(headers)
    r.Query = dict.Drop("ticket", r.Query)
  end
  c = {Request: r, First: fiber.Channel(size = 1), Bound: cell(missing), Epoch: cell(0), O: o}
  {Status: 200, Body: "", Session: s -> sessioned(s, c)}
end

defn cookiesOf(headers)
  (** The cookies of a request's headers, as std/http reads them for a handler (r.Cookies). *)
  out = dict.Dict()
  line = http.HeaderValue("cookie", headers)
  if value.IsText(line)
    for part in text.Split(";", line)
      pair = text.Split("=", text.Trim(part))
      if value.Len(pair) == 2
        out[pair[1]] = encode.UrlDecode(pair[2])
      end
    end
  end
  out
end

defn sessioned(s, c)
  (** Runs a screen's session as serving runs its WebSocket: every message heard, then the screen told that it ended. *)
  got = s.Messages()
  if result.IsErr(got)
    return missing
  end
  m = got.Value
  fiber.Send({Close: () -> s.Close()}, c.First)
  next = m.Receive()
  while result.IsOk(next)
    heard(next.Value, m.Send, c)
    next = m.Receive()
  end
  m.Free()
  sc = peek(c.Bound)
  if value.IsSome(sc)
    tellScreen({Kind: "detach", Epoch: peek(c.Epoch)}, sc)
  end
end

defn sameRequest(old, new)
  (** The default same of Route: the same cookies and the same query. *)
  http.HeaderValue("cookie", old.Headers) == http.HeaderValue("cookie", new.Headers) and value.Equal(dict.Get("Query", old), dict.Get("Query", new))
end

defn cell(v)
  (** A cell: a channel of size 1 that always holds one value, what a fiber changes and the others read. *)
  c = fiber.Channel(size = 1)
  fiber.Send(v, c)
  c
end

defn peek(c)
  (** The value of a cell. *)
  v = fiber.Receive(c, timeout = 0).Value
  fiber.Send(v, c)
  v
end

defn put(v, c)
  (** A cell's value replaced. *)
  _ = fiber.Receive(c, timeout = 0)
  fiber.Send(v, c)
end

(* The token of a screen that outlives a break: 128 random bits in hex. It is no secret that guards the screen: Route's
   same does, with the request of the page that comes back. *)
newToken() = encode.Hex(text.FromBytes([random.Int(0, 255) for k in 1..16]))

defn opening(request, o)
  (** The response to the request of a screen, which http.SameOrigin let pass: the upgrade to WebSocket, or a 400 for a
      request that isn't one. The connection, once upgraded, goes to the first message of the page, its hello. *)
  key = http.HeaderValue("sec-websocket-key", request.Headers)
  asked = http.HeaderValue("upgrade", request.Headers)
  if value.IsMissing(key) or value.IsMissing(asked) or text.Lower(asked) != "websocket"
    return {Status: 400, Body: "This route takes the WebSocket connections of live.js."}
  end
  c = {Request: request, First: fiber.Channel(size = 1), Bound: cell(missing), Epoch: cell(0), O: o}
  accepted = ws.Accept(key, (m, send) -> heard(m, send, c))
  upgrade = accepted.Upgrade
  accepted.Upgrade = (conn, rest) -> serving(upgrade, conn, rest, c)
  accepted
end

defn serving(upgrade, conn, rest, c)
  (** Runs the connection of a screen, then tells its screen that it ended: a screen of a page of the version before
      ends with it, one of version 2 waits for its page to come back. *)
  fiber.Send(conn, c.First)
  done = upgrade(conn, rest)
  sc = peek(c.Bound)
  if value.IsSome(sc)
    tellScreen({Kind: "detach", Epoch: peek(c.Epoch)}, sc)
  end
  done
end

defn tellScreen(m, sc)
  (** A message for a screen's fiber, unless the screen ended. *)
  if not isClosed(sc.Ended)
    fiber.Send(m, sc.Inbox)
  end
end

isClosed(ch) = fiber.Receive(ch, timeout = 0).Error.Kind == "closed"   (* Has a channel that never gets a value closed? *)

refused(message) = {Kind: "live", Message: message}   (* An error of the kind "live". *)

defn heard(m, send, c)
  (** A message of the page, in the fiber of its connection. The first is its hello, which starts the screen, or
      attaches the connection to the screen it had, kept since a break. Each action goes to the fiber of the screen's
      actions, which runs them one after the other; their replies go to the screen's fiber, which sends them after the
      changes that came before them. An action heard twice, sent again after a break, is run once. *)
  parsed = json.Parse(m)
  p = if result.IsOk(parsed) and value.IsDict(parsed.Value) parsed.Value else {} end
  conn = fiber.Receive(c.First, timeout = 0)
  if result.IsOk(conn)
    version = dict.Get("Hello", p)
    if version == 2 and value.IsText(dict.Get("Token", p)) and attached(p, send, conn.Value, c)
      return missing
    end
    if version == 1 or version == 2
      metrics.Add("live_screens_total")
      started(c, send, conn.Value, version)
    else
      conn.Value.Close()
    end
    return missing
  end
  sc = peek(c.Bound)
  if value.IsMissing(sc)
    return missing
  end
  if "Act" in p and "Id" in p
    id = p.Id
    if sc.Resumable and value.IsInt(id)
      if id <= peek(sc.Heard)
        return missing
      end
      put(id, sc.Heard)
    end
    if not isClosed(sc.Ended)
      fiber.Send(p, sc.Acts)
    end
  else if "Got" in p and value.IsInt(p.Got)
    tellScreen({Kind: "got", Seq: p.Got}, sc)
  else if "Ping" in p and value.IsNumber(p.Ping)
    tellScreen({Kind: "pong", Text: json.Text({Pong: p.Ping, At: now()})}, sc)
    if "Got" in p and value.IsInt(p.Got)
      tellScreen({Kind: "got", Seq: p.Got}, sc)
    end
  else if "Delays" in p and value.IsDict(p.Delays)
    observed(p.Delays)
  else if "Bye" in p
    tellScreen({Kind: "bye"}, sc)
  else
    tellScreen({Kind: "error", Text: json.Text({Error: refused("The page sent a message that live.js doesn't send.")})}, sc)
  end
  missing
end

defn attached(p, send, conn, c)
  (** Attaches a connection to the screen of its token, kept since a break, when its request is the screen's (Route's
      same): true once the screen took it, and sends its page the frames it missed; false for a new screen. *)
  sc = dict.Get(p.Token, peek(c.O.Kept))
  if value.IsMissing(sc) or not c.O.Same(peek(sc.Request), c.Request)
    return false
  end
  reply = fiber.Channel(size = 1)
  tellScreen({Kind: "attach", Send: send, Conn: conn, Got: if value.IsInt(dict.Get("Got", p)) p.Got else 0 end, Request: c.Request, Reply: reply}, sc)
  got = fiber.Receive(reply, timeout = 5)
  if result.IsErr(got) or not got.Value.Ok
    return false
  end
  put(sc, c.Bound)
  put(got.Value.Epoch, c.Epoch)
  metrics.Add("live_resumed_total")
  true
end

defn started(c, send, conn, version)
  (** A new screen for a connection: its fiber, the fiber of its actions, and its token kept when it outlives a break. *)
  resumable = version == 2 and c.O.Resume > 0
  ended = fiber.Channel()
  s = {Request: c.Request, Ended: ended}
  o = c.O
  w = if value.IsMissing(o.Who) missing else o.Who(s) end
  sc = {Token: if version == 2 newToken() else missing end, V2: version == 2, Inbox: fiber.Channel(size = 64), Acts: fiber.Channel(size = 64), Heard: cell(0),
    Request: cell(c.Request), Ended: ended, Resumable: resumable, Who: if value.IsText(w) w else missing end}
  put(sc, c.Bound)
  put(1, c.Epoch)
  if resumable
    kept = peek(o.Kept)
    kept[sc.Token] = sc
    put(kept, o.Kept)
  end
  fiber.Spawn(() -> doing(sc, o))
  fiber.Spawn(() -> screening(sc, s, o, send, conn))
end

defn doing(sc, o)
  (** The fiber of a screen's actions: each one run in turn, its reply to the screen's fiber, until the screen ends. *)
  while true
    got = fiber.Select([sc.Ended, sc.Acts])
    if result.IsErr(got)
      return missing
    end
    p = got.Value.Value
    tellScreen({Kind: "acting"}, sc)
    s = {Request: peek(sc.Request), Ended: sc.Ended, Key: if value.IsText(dict.Get("Key", p)) p.Key else missing end, Base: dict.Get("Base", p)}
    other = value.IsText(sc.Who) and value.IsText(dict.Get("Who", p)) and p.Who != sc.Who
    reply = if other json.Text({Ack: p.Id, Err: {Kind: "live", Status: 403, Message: "This action was asked by another account: it is not sent."}}) else acting(s, o.Actions, p.Act, p.Id, dict.Get("Args", p)) end
    tellScreen({Kind: "ack", Text: reply}, sc)
  end
end

defn observed(d)
  (** The delays a page measured, the p50 and the p99 of its changes in milliseconds, kept in std/metrics:
      live_delay_p50_seconds and live_delay_p99_seconds, a histogram each, one count a page and a minute. *)
  p50 = dict.Get("P50", d)
  p99 = dict.Get("P99", d)
  if value.IsNumber(p50) and value.IsNumber(p99) and p50 >= 0 and p99 >= p50 and p99 < 3600000
    metrics.Observe("live_delay_p50_seconds", p50 / 1000)
    metrics.Observe("live_delay_p99_seconds", p99 / 1000)
  end
end

defn acting(s, actions, name, id, args)
  (** Runs an action of the page in a fiber of its own, and gives its reply as JSON: {Ack, Ok} or {Ack, Err}. A panic
      of the action is written in std/log, and the page learns only that it failed. *)
  f = if value.IsText(name) dict.Get(name, actions) else missing end
  if not value.IsFunction(f)
    return json.Text({Ack: id, Err: refused("This screen has no action $name.")})
  end
  done = fiber.Wait(fiber.Spawn(() -> replied(id, f(s, args))))
  if result.IsOk(done)
    return done.Value
  end
  log.Error("live: the action $name stopped", {Error: done.Error})
  json.Text({Ack: id, Err: refused("The action $name failed.")})
end

replied(id, v) = json.Text(match v
  result.Ok(x) -> {Ack: id, Ok: x}
  result.Err(e) -> {Ack: id, Err: e}
  else -> {Ack: id, Ok: v}
end)   (* The reply to an action, as JSON. *)

now() = math.Div(math.Round(sys.Now() * 1000000), 1)   (* The time, in whole microseconds since 1970: a float would take long to print. *)
number(g) = if value.IsInt(g) g else json.Text(g) end   (* A group as JSON. *)
listText(rows) = if value.Len(rows) == 0 "[]" else json.Text(rows) end   (* Rows as JSON: no call for none. *)

defn shown(screen, s)
  (** Calls screen for its shows, in a fiber of its own: an Ok of {Sources, Names}, or an Err for the page. *)
  made = fiber.Wait(fiber.Spawn(() -> screen(s)))
  shows = if result.IsOk(made) made.Value else result.Err(refused("The screen stopped.")) end
  if result.IsErr(made)
    log.Error("live: a screen stopped", {Error: made.Error})
  end
  problem = if result.IsErr(shows) shows.Error
  else if not value.IsArray(shows) or list.Any([not value.IsDict(sh) or not ("Name" in sh) or not ("Changes" in sh) for sh in shows]) refused("The screen gave no list of live.Show.")
  else if value.Len(list.Unique([sh.Name for sh in shows])) != value.Len(shows) refused("Two shows of the screen have the same name.")
  else missing end
  if value.IsMissing(problem) result.Ok({Sources: [sh.Changes for sh in shows], Names: [json.Text(sh.Name) for sh in shows]}) else result.Err(problem) end
end

defn hello(sc, o, resumed)
  (** The first frame a page of version 2 gets from its screen, not numbered: its token, whether the screen is the one
      it had (Resumed, with Heard, the last action it heard), its who and its settings. *)
  m = {Token: sc.Token, Resumed: resumed, Heard: peek(sc.Heard)}
  if value.IsText(sc.Who)
    m.Who = sc.Who
  end
  if value.IsSome(o.Client)
    m.Client = o.Client
  end
  "[$(json.Text(m))]"
end

defn screening(sc, s, o, send, conn)
  (** The fiber of a screen: it reads the changes of its shows as they come and writes each to the connection, as JSON,
      in a frame of its own, a JSON list. While a write waits for a slow page, the screen reads nothing: the source of a
      show must not wait for it, as cepheus.Watch never does. While an action of the page runs, the changes wait, at
      most held seconds, and go with its reply in one frame: the page then never draws the action's row twice, its
      effect and the change it made. The replies wait for the first message of each show, the answer, too. A screen of
      version 2 numbers its frames ({Seq} first) and keeps them until the page says it has them ({Got}), in a channel,
      oldest first, so that keeping and letting go of one costs the same whatever their number; while its connection
      is broken it keeps them, resume seconds and buffer bytes at most, and sends them to the connection that comes back
      with its token, before anything new. *)
  made = shown(o.Screen, s)
  if result.IsErr(made)
    if sc.V2
      _ = send(hello(sc, o, false))
    end
    failing(made.Error, send, sc, conn)
    ended(sc, o)
    return missing
  end
  sources = made.Value.Sources
  names = made.Value.Names
  seen = list.Fill(false, value.Len(sources))
  waiting = value.Len(sources)
  replies = []
  pending = []
  busy = 0
  epoch = 1
  seq = 0
  kept = fiber.Channel()
  keptN = 0
  bytes = 0
  lost = 0
  until = missing
  if sc.V2
    _ = send(hello(sc, o, false))
  end
  chs = list.Concat([sc.Inbox], sources)
  while true
    left = if value.IsMissing(until) missing else list.Max([0, until - sys.Now()]) end
    wait = if busy > 0 held else left end
    wait = if value.IsSome(left) and value.IsSome(wait) list.Min([wait, left]) else wait end
    got = if value.IsMissing(wait) fiber.Select(chs) else fiber.Select(chs, timeout = wait) end
    out = []
    if result.IsErr(got) and got.Error.Kind == "timeout"
      if value.IsSome(until) and sys.Now() >= until
        ended(sc, o)
        return missing
      end
      out = pending
      pending = []
    else if result.IsErr(got)
      k = list.IndexOf(got.Error.Channel, sources)
      failing(refused("The show $(json.Parse(names[k]).Value) ended."), send, sc, conn)
      ended(sc, o)
      return missing
    else if got.Value.Channel == sc.Inbox
      v = got.Value.Value
      if v.Kind == "error"
        failing(missing, send, sc, conn, last = v.Text)
        ended(sc, o)
        return missing
      else if v.Kind == "acting"
        busy += 1
      else if v.Kind == "ack"
        busy -= 1
        replies = list.Append(v.Text, replies)
        if busy == 0 or value.Len(pending) > 0
          out = pending
          pending = []
        end
      else if v.Kind == "pong"
        if value.IsSome(send)
          _ = send("[$(v.Text)]")
        end
      else if v.Kind == "got"
        n = list.Min([keptN, list.Max([0, v.Seq - (seq - keptN)])])
        bytes -= dropped(kept, n)
        keptN -= n
      else if v.Kind == "detach"
        if v.Epoch == epoch
          if not sc.Resumable
            ended(sc, o)
            return missing
          end
          send = missing
          conn = missing
          until = sys.Now() + o.Resume
        end
      else if v.Kind == "attach"
        if v.Got < lost or v.Got > seq
          fiber.Send({Ok: false}, v.Reply)
          ended(sc, o)
          return missing
        end
        n = list.Min([keptN, list.Max([0, v.Got - (seq - keptN)])])
        bytes -= dropped(kept, n)
        keptN -= n
        if value.IsSome(conn)
          old = conn
          fiber.Spawn(() -> old.Close())
        end
        put(v.Request, sc.Request)
        epoch += 1
        send = v.Send
        conn = v.Conn
        until = missing
        fiber.Send({Ok: true, Epoch: epoch}, v.Reply)
        if not replayed(send, hello(sc, o, true), kept, keptN)
          send = missing
          until = sys.Now() + o.Resume
        end
      else if v.Kind == "bye"
        ended(sc, o)
        return missing
      end
    else
      k = list.IndexOf(got.Value.Channel, sources)
      v = got.Value.Value
      rows = dict.Get("Rows", v)
      m = if value.IsMissing(rows) "{\"Show\":$(names[k]),\"Group\":$(number(v.Group)),\"Added\":$(listText(v.Added)),\"Removed\":$(listText(v.Removed)),\"At\":$(now())}" else "{\"Show\":$(names[k]),\"Group\":$(number(v.Group)),\"Rows\":$(listText(rows)),\"At\":$(now())}" end
      if not seen[k]
        seen[k] = true
        waiting -= 1
      end
      if busy > 0 and value.Len(pending) < inARow
        pending = list.Append(m, pending)
      else
        out = list.Append(m, pending)
        pending = []
      end
    end
    if waiting == 0 and value.Len(replies) > 0 and value.Len(pending) == 0
      out = list.Concat(out, replies)
      replies = []
    end
    if value.Len(out) > 0
      if not sc.Resumable
        if result.IsErr(send(if value.Len(out) == 1 "[$(out[1])]" else "[$(text.Join(",", out))]" end))
          ended(sc, o)
          return missing
        end
      else
        seq += 1
        frame = "[{\"Seq\":$seq},$(text.Join(",", out))]"
        fiber.Send(frame, kept)
        keptN += 1
        bytes += text.ByteLength(frame)
        if value.IsSome(send) and result.IsErr(send(frame))
          send = missing
          until = sys.Now() + o.Resume
        end
        while bytes > o.Buffer and keptN > 1
          if value.IsMissing(send)
            (* away, and its frames past the buffer: the page can't come back to them, the screen ends *)
            ended(sc, o)
            return missing
          end
          lost = seq - keptN + 1
          bytes -= text.ByteLength(fiber.Receive(kept).Value)
          keptN -= 1
        end
      end
    end
  end
end

defn dropped(kept, n)
  (** The n oldest frames kept let go, as the page has them: the bytes they held. A frame is kept as its text alone, its
      number known from its place: the oldest is the last number sent less those kept, plus one. *)
  out = 0
  k = 0
  while k < n
    out += text.ByteLength(fiber.Receive(kept).Value)
    k += 1
  end
  out
end

defn replayed(send, first, kept, n)
  (** The hello of a screen that a page came back to, then the n frames it kept, which it keeps still (until the page
      says it has them): true when all went. *)
  frames = []
  k = 0
  while k < n
    frames = list.Append(fiber.Receive(kept).Value, frames)
    k += 1
  end
  for f in frames
    fiber.Send(f, kept)
  end
  if result.IsErr(send(first))
    return false
  end
  for f in frames
    if result.IsErr(send(f))
      return false
    end
  end
  true
end

defn ended(sc, o)
  (** The end of a screen: its Ended closed (its shows stop), its token forgotten, and what waited for it let go. *)
  if not isClosed(sc.Ended)
    fiber.Close(sc.Ended)
  end
  if sc.Resumable
    kept = peek(o.Kept)
    put(dict.Drop(sc.Token, kept), o.Kept)
  end
  while result.IsOk(fiber.Receive(sc.Inbox, timeout = 0))
  end
  while result.IsOk(fiber.Receive(sc.Acts, timeout = 0))
  end
end

defn failing(e, send, sc, conn, last = missing)
  (** Ends a screen with an error that the page gets: the page then closes its side, or the connection closes after a
      second. *)
  if value.IsMissing(send)
    return missing
  end
  _ = send("[$(if value.IsMissing(last) json.Text({Error: e}) else last end)]")
  until = sys.Now() + 1
  while sys.Now() < until
    got = fiber.Receive(sc.Inbox, timeout = list.Max([0, until - sys.Now()]))
    if result.IsErr(got) or got.Value.Kind == "detach"
      break
    end
  end
  if value.IsSome(conn)
    conn.Close()
  end
end

(* live.js, the page's side, served at the path of Route and /live.js. *)
script = "// live.js, the page's side of std/live: connect(url, options) opens a screen of the app; live.show(name, draw) draws a
// show's rows at each change; live.act(name, args, effects, base) asks the app for an action and shows its effect at
// once; live.onStatus(f) tells the page the state of its connection.
//
// A break is no end. The page comes back by itself, after a wait drawn at random up to a bound that doubles at each
// failure (full jitter: Brooker, Exponential Backoff And Jitter, 2015), at once when the browser is online again or the
// tab is shown; to the same screen while the app keeps it (every frame it missed, once), else to a new one whose
// answers replace its rows. A silent network (no frame for DeadAfter seconds, a ping every PingEvery) is a break too.
// The actions asked meanwhile wait in order, each with the key made when it was asked, and go once the page is back:
// the app runs each once. Their bounds and the delays are the app's settings, which come with the screen.
const pageNow = () => performance.timeOrigin + performance.now()
const later = typeof requestAnimationFrame === 'function' ? requestAnimationFrame : f => setTimeout(f, 0)
const browser = typeof window === 'object' && typeof document === 'object'
// WebTransport (draft-ietf-webtrans-http3) beside WebSocket, where the browser has it, the page is https and the server
// offers it: a session on the WebSocket's own URL in https, one stream both ways, each message its length (QUIC's
// variable integer) then its UTF-8 bytes, and it acts as a WebSocket (send, close, readyState, onmessage, onclose). The
// two are raced, as Happy Eyeballs races IPv6 and IPv4 (RFC 8305): WebTransport is taken when it is ready first or
// within 300 ms of the WebSocket, the other is closed. A session that fails marks the origin for 10 minutes in
// sessionStorage, and only WebSocket goes there meanwhile, as where UDP doesn't pass: a page never waits on a blocked
// network.
const wtMark = 'cesia-webtransport-failed'
function wtFailed() { try { return Date.now() < +(sessionStorage.getItem(wtMark) || 0) } catch (e) { return false } }
function wtFail() { try { sessionStorage.setItem(wtMark, String(Date.now() + 600000)) } catch (e) {} }
// The server says that it takes sessions: <meta name=webtransport content=on> in the page (http.Serve's webtransport).
function offered() { return typeof document === 'object' && document.querySelector('meta[name=webtransport][content=on]') !== null }
function wtLength(n) {
  if (n < 64) return [n]
  if (n < 16384) return [64 | (n >> 8), n & 255]
  return [128 | (n >>> 24), (n >> 16) & 255, (n >> 8) & 255, n & 255]
}
function overTransport(url, opened, failed, hashes) {
  const s = { readyState: 0, onmessage: null, onclose: null }
  let t = null, writer = null, over = false
  const enc = new TextEncoder(), dec = new TextDecoder()
  const end = code => {
    if (over) return
    over = true
    const was = s.readyState
    s.readyState = 3
    try { if (t) t.close() } catch (e) {}
    if (was === 0) failed()
    else if (s.onclose) s.onclose({ code: code })
  }
  s.send = m => {
    const b = typeof m === 'string' ? enc.encode(m) : new Uint8Array(m), head = wtLength(b.length), all = new Uint8Array(head.length + b.length)
    all.set(head)
    all.set(b, head.length)
    writer.write(all).catch(() => end(1006))
  }
  s.close = code => end(code || 1000)
  // A certificate of 14 days at most that the page already knows by its hash, as a test's or a machine's own.
  const known = hashes && hashes.length ? { serverCertificateHashes: hashes.map(h => ({ algorithm: 'sha-256', value: Uint8Array.from(atob(h), c => c.charCodeAt(0)) })) } : undefined
  // A session carries no cookie: a ticket, asked with the page's cookies just before, says who it is for.
  const u = new URL(url), at = new URL(url)
  at.pathname = (u.pathname.endsWith('/') ? u.pathname.slice(0, -1) : u.pathname) + '/ticket'
  at.search = ''
  fetch(at, { credentials: 'same-origin', cache: 'no-store' }).then(r => r.ok ? r.json() : Promise.reject(r.status)).then(async j => {
    if (over) return
    u.searchParams.set('ticket', j.Ticket)
    t = new WebTransport(u.href, known)
    t.closed.then(() => end(1000), () => end(1006))
    await t.ready
    const stream = await t.createBidirectionalStream()
    writer = stream.writable.getWriter()
    if (over) return
    s.readyState = 1
    opened(s)
    const reader = stream.readable.getReader()
    let buf = new Uint8Array(0)
    for (;;) {
      const got = await reader.read()
      if (got.done) break
      const joined = new Uint8Array(buf.length + got.value.length)
      joined.set(buf)
      joined.set(got.value, buf.length)
      buf = joined
      for (;;) {
        if (buf.length < 1) break
        const w = 1 << (buf[0] >> 6)
        if (buf.length < w) break
        let n = buf[0] & 63
        for (let k = 1; k < w; k++) n = n * 256 + buf[k]
        if (buf.length < w + n) break
        const m = dec.decode(buf.subarray(w, w + n))
        buf = buf.slice(w + n)
        if (s.onmessage) s.onmessage({ data: m })
      }
    }
    end(1000)
  }).catch(() => end(1006))
  return s
}
// A connection to a ws: or wss: URL: ready(socket) once one is open, failed() if none could be. hashes: the
// CertificateHashes of the options, base64 SHA-256 of the server's certificate, for one no authority signed.
function dial(url, ready, failed, hashes) {
  const ws = new WebSocket(url)
  ws.binaryType = 'arraybuffer'
  const race = typeof WebTransport === 'function' && url.startsWith('wss:') && offered() && !wtFailed()
  let chosen = null, wsDead = false, wtDead = !race, grace = 0, wt = null
  const pick = s => {
    if (chosen) return
    chosen = s
    clearTimeout(grace)
    if (s !== ws) { ws.onopen = ws.onclose = null; ws.close(1000) }
    else if (wt) wt.close(1000)
    ready(s)
  }
  const dead = () => { if (!chosen && wsDead && wtDead) failed() }
  ws.onopen = () => { if (wtDead) pick(ws); else grace = setTimeout(() => pick(ws), 300) }
  ws.onclose = () => { wsDead = true; dead() }
  if (race) wt = overTransport('https:' + url.slice(4), s => pick(s), () => { wtDead = true; wtFail(); if (!chosen && ws.readyState === 1) pick(ws); dead() }, hashes)
}
const defaults = { Outbox: 'on', OutboxCount: 100, OutboxBytes: 1048576, OutboxWait: 3600, ReconnectFirst: 500, ReconnectMax: 30000, PingEvery: 15, DeadAfter: 30 }

// The same text for two rows that hold the same values, whatever the order of their keys.
function key(v) {
  if (Array.isArray(v)) return '[' + v.map(key).join(',') + ']'
  if (v !== null && typeof v === 'object') return '{' + Object.keys(v).sort().map(k => JSON.stringify(k) + ':' + key(v[k])).join(',') + '}'
  return JSON.stringify(v)
}

// Rows with their repeats: a row's key, the row, and how many times it is there.
function tally(rows, list, sign) {
  for (const row of list) {
    const k = key(row)
    const had = rows.get(k)
    const n = (had ? had.n : 0) + sign
    if (n > 0) rows.set(k, { row, n })
    else rows.delete(k)
  }
  return rows
}

function quantile(sorted, q) {
  return sorted[Math.max(0, Math.ceil(q * sorted.length) - 1)]
}

// The key of an action, made once when it is asked: 128 random bits.
function newKey() {
  if (typeof crypto === 'object' && crypto.randomUUID) return crypto.randomUUID()
  const b = crypto.getRandomValues(new Uint8Array(16))
  return Array.from(b, x => x.toString(16).padStart(2, '0')).join('')
}

class Live {
  constructor(url, options) {
    const u = new URL(url, location.href)
    u.protocol = u.protocol === 'https:' ? 'wss:' : 'ws:'
    this.url = u.href
    this.given = options || {}
    this.o = Object.assign({}, defaults, this.given)
    this.shows = new Map()
    this.pending = []
    this.next = 1
    this.handlers = []
    this.watchers = []
    this.socket = null
    this.closed = false
    this.ended = false
    this.offset = null
    this.best = Infinity
    this.delays = []
    this.frame = 0
    this.timers = []
    this.state = 'connecting'
    this.token = null
    this.seq = 0
    this.told = 0
    this.who = null
    this.attempt = 0
    this.retryAt = 0
    this.retry = 0
    this.last = 0
    this.ever = false
    this.news = null
  }

  open(opened, refused) {
    if (this.closed || this.ended) return
    clearTimeout(this.retry)
    this.retry = 0
    const dialing = this.dialing = (this.dialing || 0) + 1
    this.set('connecting')
    const gone = () => {
      if (dialing !== this.dialing) return
      if (!this.ever && refused && !this.ended) return refused({ Kind: 'live', Message: 'No screen opened at ' + this.url + '.' })
      this.lost(null)
    }
    try { dial(this.url, socket => dialing === this.dialing && !this.closed ? this.use(socket, opened, refused) : socket.close(1000), gone, this.o.CertificateHashes) } catch (e) { this.lost(null) }
  }

  // The connection that won, WebSocket or WebTransport: the hello, then every frame.
  use(socket, opened, refused) {
    this.socket = socket
    this.last = pageNow()
    socket.send(JSON.stringify(this.token === null ? { Hello: 2 } : { Hello: 2, Token: this.token, Got: this.seq }))
    socket.onmessage = e => {
      const at = pageNow()
      this.last = at
      const frame = JSON.parse(e.data)
      const first = frame[0]
      if (first && 'Token' in first) return this.hello(first, opened)
      if (first && 'Seq' in first) {
        if (first.Seq <= this.seq) return
        this.seq = first.Seq
        this.owe()
      }
      for (const m of frame) this.heard(m, at)
    }
    socket.onclose = () => {
      if (!this.ever && refused && !this.ended) return refused({ Kind: 'live', Message: 'No screen opened at ' + this.url + '.' })
      this.lost(socket)
    }
  }

  // The screen's first frame: its token, whether it is the screen the page had (then only the actions it didn't hear
  // go again), or a new one (every action not answered goes again, each show's answer will replace its rows).
  hello(m, opened) {
    const resumed = m.Resumed === true
    if (m.Client) this.o = Object.assign({}, defaults, m.Client, this.given)
    if (!resumed) this.seq = 0
    this.news = this.ever ? (resumed ? 'resumed' : 'reloaded') : null
    this.token = m.Token
    const who = 'Who' in m ? m.Who : null
    if (this.who !== null && who !== this.who) {
      for (const p of this.pending.filter(p => !p.answered && p.who !== null && p.who !== who)) this.settle(p, false, { Kind: 'live', Message: 'This action was asked by another account: it is not sent.' })
    }
    this.who = who
    for (const p of this.pending) if (p.who === null) p.who = who
    this.attempt = 0
    this.set('up')
    for (const p of this.pending) if (!p.answered && (!resumed || p.id > m.Heard)) this.send(p)
    this.ping()
    if (!this.ever) {
      this.ever = true
      if (opened) opened(this)
    }
  }

  // A break: every action waits (or fails, with the outbox off), and the page comes back after a wait at random.
  lost(socket) {
    if (socket && this.socket !== socket) return
    this.socket = null
    if (socket) socket.onclose = socket.onmessage = socket.onopen = null
    if (this.closed || this.ended) return
    if (this.o.Outbox === 'off') {
      for (const p of this.pending.filter(p => !p.answered)) this.settle(p, false, { Kind: 'live', Message: 'The connection to the app broke before it answered: the action may have run or not.' })
    }
    const wait = Math.random() * Math.min(this.o.ReconnectMax, this.o.ReconnectFirst * Math.pow(2, this.attempt))
    this.attempt = Math.min(this.attempt + 1, 30)
    this.retryAt = pageNow() + wait
    this.retry = setTimeout(() => this.open(), wait)
    this.set('down')
  }

  // Comes back at once: the browser is online again, the tab is shown, or the page asks.
  now() {
    if (this.state === 'down' && !this.closed && !this.ended) this.open()
  }

  // The page's own frames confirmed to the app, a second at most after they came.
  owe() {
    if (this.owing) return
    this.owing = setTimeout(() => {
      this.owing = 0
      if (this.socket && this.socket.readyState === 1 && this.seq > this.told) {
        this.told = this.seq
        this.socket.send(JSON.stringify({ Got: this.seq }))
      }
    }, 1000)
  }

  send(p) {
    if (!this.socket || this.socket.readyState !== 1) return
    const m = { Act: p.name, Id: p.id, Args: p.args === undefined ? null : p.args, Key: p.key }
    if (p.base !== undefined) m.Base = p.base
    if (p.who !== null) m.Who = p.who
    this.socket.send(JSON.stringify(m))
    p.sent = true
  }

  heard(m, at) {
    if ('Show' in m) {
      const s = this.get(m.Show)
      if ('Rows' in m) s.rows = tally(new Map(), m.Rows, 1)
      else tally(tally(s.rows, m.Added, 1), m.Removed, -1)
      s.group = m.Group
      for (const p of this.pending.slice()) {
        if (!(m.Show in p.effects)) continue
        if (!p.answered) p.changed.add(m.Show)
        else if (p.keep.includes(m.Show)) {
          p.keep = p.keep.filter(n => n !== m.Show)
          if (p.keep.length === 0) p.drop()
        }
      }
      if (this.offset !== null) this.delays.push(at - (m.At / 1000 - this.offset))
      if (this.delays.length >= 10000) this.report()
      this.dirty(s)
    } else if ('Ack' in m) {
      const p = this.pending.find(p => p.id === m.Ack)
      if (p && !p.answered) this.settle(p, !('Err' in m), 'Err' in m ? m.Err : m.Ok)
    } else if ('Pong' in m) {
      const trip = at - m.Pong
      if (trip < this.best) {
        this.best = trip
        this.offset = m.At / 1000 - (m.Pong + at) / 2
      }
    } else if ('Error' in m) {
      this.ended = true
      clearTimeout(this.retry)
      this.set('ended', m.Error)
      this.emit(m.Error)
      if (this.socket) this.socket.close(1000)
    }
  }

  // The reply to an action: an Err drops its effect at once; an Ok drops it on each show that a message came to since
  // the action was asked for, and keeps it on the others until their next message, at most 100 ms, so that the row
  // is drawn neither twice nor not at all, whichever of the change and the reply comes first.
  settle(p, ok, value) {
    p.keep = ok ? Object.keys(p.effects).filter(n => !p.changed.has(n)) : []
    p.answered = true
    const drop = () => {
      const i = this.pending.indexOf(p)
      if (i >= 0) this.pending.splice(i, 1)
      for (const name in p.effects) this.dirty(this.get(name))
      this.tell()
    }
    if (p.keep.length === 0) drop()
    else {
      p.drop = drop
      setTimeout(drop, 100)
    }
    if (ok) p.resolve(value)
    else p.reject(value)
  }

  get(name) {
    let s = this.shows.get(name)
    if (!s) {
      s = { name, rows: new Map(), group: null, draws: [], dirty: false }
      this.shows.set(name, s)
    }
    return s
  }

  dirty(s) {
    s.dirty = true
    if (!this.frame) this.frame = later(() => this.draw())
  }

  // Each show drawn once a frame at most: the server's rows, then the effect of each action not yet answered, in order.
  draw() {
    this.frame = 0
    for (const s of this.shows.values()) {
      if (!s.dirty || s.group === null) continue
      s.dirty = false
      let rows = []
      for (const e of s.rows.values()) for (let i = 0; i < e.n; i++) rows.push(e.row)
      for (const p of this.pending) {
        const effect = p.effects[s.name]
        if (effect) {
          try { rows = effect(rows.slice()) } catch (e) { this.emit({ Kind: 'live', Message: 'The effect of ' + p.name + ' on ' + s.name + ' failed: ' + e }) }
        }
      }
      for (const draw of s.draws) {
        try { draw(rows) } catch (e) { this.emit({ Kind: 'live', Message: 'Drawing ' + s.name + ' failed: ' + e }) }
      }
    }
  }

  // A ping every PingEvery seconds, with the frames confirmed; no frame for DeadAfter seconds is a break, even when the
  // browser hasn't seen the network go (a cable, a router, a proxy that drops idle connections).
  ping() {
    const s = this.socket
    if (!s || s.readyState !== 1) return
    if (this.state === 'up' && pageNow() - this.last > this.o.DeadAfter * 1000) {
      s.close(4000)
      return this.lost(s)
    }
    this.told = this.seq
    s.send(JSON.stringify(this.seq > 0 ? { Ping: pageNow(), Got: this.seq } : { Ping: pageNow() }))
  }

  // Actions that waited past OutboxWait fail: those never sent are not sent, the others may have run.
  expire() {
    const old = pageNow() - this.o.OutboxWait * 1000
    for (const p of this.pending.filter(p => !p.answered && p.at < old)) {
      this.settle(p, false, { Kind: 'live', Message: p.sent ? 'No reply came in time: the action may have run or not.' : 'This action waited too long to be sent: it was not sent.' })
    }
  }

  report() {
    if (this.delays.length === 0 || !this.socket || this.socket.readyState !== 1) return
    const sorted = this.delays.sort((a, b) => a - b)
    this.socket.send(JSON.stringify({ Delays: { P50: quantile(sorted, 0.5), P99: quantile(sorted, 0.99), Count: sorted.length } }))
    this.delays = []
  }

  emit(e) {
    if (this.handlers.length === 0) console.error('live:', e)
    for (const f of this.handlers) f(e)
  }

  set(state, error) {
    this.state = state
    this.error = error === undefined ? null : error
    this.tell()
  }

  // The state as onStatus gives it: State connecting, up, down or ended; Waiting, the actions not answered yet; Retry,
  // the milliseconds before the next try while down; Last, resumed or reloaded after a break; Offline, the browser's
  // own word; Error, what ended the screen.
  status() {
    return { State: this.state, Waiting: this.pending.filter(p => !p.answered).length, Retry: this.state === 'down' ? Math.max(0, this.retryAt - pageNow()) : 0,
      Last: this.news, Offline: typeof navigator === 'object' && navigator.onLine === false, Error: this.error }
  }

  tell() {
    const s = this.status()
    for (const f of this.watchers) f(s)
  }

  onStatus(f) {
    this.watchers.push(f)
    f(this.status())
  }

  show(name, draw) {
    const s = this.get(name)
    s.draws.push(draw)
    if (s.group !== null) this.dirty(s)
  }

  // An action: sent at once when connected, else kept in order until the page is back, bounded by OutboxCount and
  // OutboxBytes; base, the values the page saw, lets the app refuse a change of what changed meanwhile.
  act(name, args, effects, base) {
    if (this.closed) return Promise.reject({ Kind: 'live', Message: 'This screen is closed.' })
    if (this.o.Outbox === 'off' && this.state !== 'up') return Promise.reject({ Kind: 'live', Message: 'This page is not connected to its app.' })
    const bytes = JSON.stringify(args === undefined ? null : args).length
    const waiting = this.pending.filter(p => !p.answered)
    if (waiting.length >= this.o.OutboxCount || waiting.reduce((n, p) => n + p.bytes, 0) + bytes > this.o.OutboxBytes) {
      return Promise.reject({ Kind: 'live', Message: 'Too many actions wait to be sent: ' + waiting.length + '.' })
    }
    return new Promise((resolve, reject) => {
      const p = { id: this.next++, key: newKey(), name, args, base, who: this.who, at: pageNow(), bytes, effects: effects || {}, resolve, reject, sent: false, changed: new Set(), answered: false, keep: [] }
      this.pending.push(p)
      if (this.state === 'up') this.send(p)
      for (const n in p.effects) this.dirty(this.get(n))
      this.tell()
    })
  }

  onError(f) {
    this.handlers.push(f)
  }

  // After a sign-in that follows the end of the screen (its session gone), the page comes back, its actions with it.
  again() {
    this.ended = false
    this.token = null
    this.open()
  }

  close() {
    this.closed = true
    clearTimeout(this.retry)
    clearTimeout(this.beat)
    for (const t of this.timers) clearInterval(t)
    if (this.socket && this.socket.readyState === 1) this.socket.send(JSON.stringify({ Bye: 1 }))
    if (this.socket) this.socket.close(1000)
  }
}

export function connect(url, options) {
  return new Promise((opened, refused) => {
    const live = new Live(url, options)
    const beat = () => { if (live.closed) return; live.ping(); live.expire(); live.beat = setTimeout(beat, Math.max(1, live.o.PingEvery) * 1000) }
    live.beat = setTimeout(beat, Math.max(1, live.o.PingEvery) * 1000)
    live.timers.push(setInterval(() => live.report(), 60000))
    if (browser) {
      window.addEventListener('online', () => live.now())
      window.addEventListener('offline', () => { if (live.socket) { const s = live.socket; s.close(4000); live.lost(s) } })
      document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') live.now() })
      window.addEventListener('pagehide', () => { if (live.socket && live.socket.readyState === 1) live.socket.send(JSON.stringify({ Bye: 1 })) })
    }
    live.open(opened, e => { live.close(); refused(e) })
  })
}
"
