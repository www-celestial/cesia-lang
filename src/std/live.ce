(** Live screens: a page shows the answers of questions as they change, pushed to it over a WebSocket, and its own
    actions at once, before the app has answered them. Route serves the screens of a path: a screen is a page that
    connects; the app gives it its shows, each a name and a channel of the changes of an answer, and runs the actions that
    the page asks for. live.js, the page's side, comes from the same path. Each screen has a fiber of its own, which
    writes to its page alone: a page that reads nothing holds no other back. *)
use std/dict
use std/fiber
use std/http
use std/json
use std/list
use std/log
use std/math
use std/metrics
use std/result
use std/sys
use std/text
use std/value
use std/websocket as ws

(** A show of a screen: the page knows it by its name, and changes is a channel of std/fiber of the messages of an
    answer that changes. The first is the answer, {Group, Rows}, its rows at the group Group; each next one is a change,
    {Group, Added, Removed}, the rows that came and the rows that went with the group Group, or the answer again. A group
    is a number that grows with each change. The channel is the screen's own, and its source never waits for it: when a
    page reads too slowly, the source drops what the channel holds and sends the answer again, as cepheus.Watch does.

      Show("unpaid", fiber.Channel()).Name --> "unpaid" *)
Show(name, changes) = {Name: name, Changes: changes}

inARow = 64   (* The changes that wait at most for the reply to an action. *)
held = 0.1   (* The seconds that changes wait at most for the reply to an action. *)

defn Route(pattern, screen, a, actions = {})
  (** An application with the live screens of a path added, and live.js, the page's side, at the path and /live.js.
      screen(s) gives the shows of a screen, a list of Show, or an Err that the page gets; s is {Request, Ended}: the
      HTTP request of the page, its headers and cookies to tell who it is, and a channel that closes when the page
      leaves, for the sources of its shows to stop, as cepheus.Watch does with until = s.Ended. actions maps the name of
      each action to a function (s, args) of the screen and of what the page sent: its value, an Ok's or anything that
      isn't an Err, goes back to the page, which then drops the effect it showed; an Err undoes it. Each screen's
      actions run one after the other, in the order the page asked for them. A page of another origin than the app's
      gets a 403, as http.SameOrigin decides, so that no other site opens a screen with the cookies of its visitor.

        app = http.Handler(http.App() then Route("/live", s -> []))
        app({Method: "GET", Path: "/live/live.js", Query: "", Headers: [], Body: ""}).Status --> 200
        handshake = [{Name: "upgrade", Value: "websocket"}, {Name: "sec-websocket-key", Value: "dGhlIHNhbXBsZSBub25jZQ=="}]
        app({Method: "GET", Path: "/live", Query: "", Headers: handshake, Body: ""}).Status --> 101
        other = list.Append({Name: "origin", Value: "https://elsewhere.example"}, list.Append({Name: "host", Value: "shop.example"}, handshake))
        app({Method: "GET", Path: "/live", Query: "", Headers: other, Body: ""}).Status --> 403 *)
  a then http.Get("$pattern/live.js", r -> {Status: 200, Body: client, Headers: [{Name: "content-type", Value: "text/javascript; charset=utf-8"}, {Name: "cache-control", Value: "no-cache"}]}) then http.Get(pattern, r -> http.SameOrigin(s -> opening(s, screen, actions), r))
end

defn opening(request, screen, actions)
  (** The response to the request of a screen, which http.SameOrigin let pass: the upgrade to WebSocket, or a 400 for a
      request that isn't one. The connection, once upgraded, goes to the first message of the page, its hello. *)
  key = http.HeaderValue("sec-websocket-key", request.Headers)
  asked = http.HeaderValue("upgrade", request.Headers)
  if value.IsMissing(key) or value.IsMissing(asked) or text.Lower(asked) != "websocket"
    return {Status: 400, Body: "This route takes the WebSocket connections of live.js."}
  end
  ended = fiber.Channel()
  inbox = fiber.Channel(size = 64)
  first = fiber.Channel(size = 1)
  s = {Request: request, Ended: ended}
  accepted = ws.Accept(key, (m, send) -> heard(m, send, s, screen, actions, first, inbox))
  upgrade = accepted.Upgrade
  accepted.Upgrade = (conn, rest) -> serving(upgrade, conn, rest, first, ended)
  accepted
end

defn serving(upgrade, conn, rest, first, ended)
  (** Runs the connection of a screen, then ends the screen: ended closes, which stops its fibers and the sources of its
      shows. *)
  fiber.Send(conn, first)
  done = upgrade(conn, rest)
  fiber.Close(ended)
  done
end

refused(message) = {Kind: "live", Message: message}   (* An error of the kind "live". *)

defn heard(m, send, s, screen, actions, first, inbox)
  (** A message of the page, in the fiber of its connection. The first is its hello, which starts the screen. Each
      action runs here, one after the other, and its reply goes to the screen's fiber, which sends it after the changes
      that came before it. *)
  parsed = json.Parse(m)
  conn = fiber.Receive(first, timeout = 0)
  if result.IsOk(conn)
    if result.IsOk(parsed) and value.IsDict(parsed.Value) and dict.Get("Hello", parsed.Value) == 1
      metrics.Add("live_screens_total")
      fiber.Spawn(() -> screening(s, screen, send, conn.Value, inbox))
    else
      conn.Value.Close()
    end
    return missing
  end
  p = if result.IsOk(parsed) and value.IsDict(parsed.Value) parsed.Value else {} end
  if "Act" in p and "Id" in p
    fiber.Send({Kind: "acting", Text: ""}, inbox)
    fiber.Send({Kind: "ack", Text: acting(s, actions, p.Act, p.Id, dict.Get("Args", p))}, inbox)
  else if "Ping" in p and value.IsNumber(p.Ping)
    fiber.Send({Kind: "pong", Text: json.Text({Pong: p.Ping, At: now()})}, inbox)
  else if "Delays" in p and value.IsDict(p.Delays)
    observed(p.Delays)
  else
    fiber.Send({Kind: "error", Text: json.Text({Error: refused("The page sent a message that live.js doesn't send.")})}, inbox)
  end
  missing
end

defn observed(d)
  (** The delays a page measured, the p50 and the p99 of its changes in milliseconds, kept in std/metrics:
      live_delay_p50_seconds and live_delay_p99_seconds, a histogram each, one count a page and a minute. *)
  p50 = dict.Get("P50", d)
  p99 = dict.Get("P99", d)
  if value.IsNumber(p50) and value.IsNumber(p99) and p50 >= 0 and p99 >= p50 and p99 < 3600000
    metrics.Observe("live_delay_p50_seconds", p50 / 1000)
    metrics.Observe("live_delay_p99_seconds", p99 / 1000)
  end
end

defn acting(s, actions, name, id, args)
  (** Runs an action of the page in a fiber of its own, and gives its reply as JSON: {Ack, Ok} or {Ack, Err}. A panic
      of the action is written in std/log, and the page learns only that it failed. *)
  f = if value.IsText(name) dict.Get(name, actions) else missing end
  if not value.IsFunction(f)
    return json.Text({Ack: id, Err: refused("This screen has no action $name.")})
  end
  done = fiber.Wait(fiber.Spawn(() -> replied(id, f(s, args))))
  if result.IsOk(done)
    return done.Value
  end
  log.Error("live: the action $name stopped", {Error: done.Error})
  json.Text({Ack: id, Err: refused("The action $name failed.")})
end

replied(id, v) = json.Text(match v
  result.Ok(x) -> {Ack: id, Ok: x}
  result.Err(e) -> {Ack: id, Err: e}
  else -> {Ack: id, Ok: v}
end)   (* The reply to an action, as JSON. *)

now() = math.Div(math.Round(sys.Now() * 1000000), 1)   (* The time, in whole microseconds since 1970: a float would take long to print. *)
number(g) = if value.IsInt(g) g else json.Text(g) end   (* A group as JSON. *)
listText(rows) = if value.Len(rows) == 0 "[]" else json.Text(rows) end   (* Rows as JSON: no call for none. *)

defn shown(screen, s)
  (** Calls screen for its shows, in a fiber of its own: an Ok of {Sources, Names}, or an Err for the page. *)
  made = fiber.Wait(fiber.Spawn(() -> screen(s)))
  shows = if result.IsOk(made) made.Value else result.Err(refused("The screen stopped.")) end
  if result.IsErr(made)
    log.Error("live: a screen stopped", {Error: made.Error})
  end
  problem = if result.IsErr(shows) shows.Error
  else if not value.IsArray(shows) or list.Any([not value.IsDict(sh) or not ("Name" in sh) or not ("Changes" in sh) for sh in shows]) refused("The screen gave no list of live.Show.")
  else if value.Len(list.Unique([sh.Name for sh in shows])) != value.Len(shows) refused("Two shows of the screen have the same name.")
  else missing end
  if value.IsMissing(problem) result.Ok({Sources: [sh.Changes for sh in shows], Names: [json.Text(sh.Name) for sh in shows]}) else result.Err(problem) end
end

defn screening(s, screen, send, conn, inbox)
  (** The fiber of a screen: it reads the changes of its shows as they come and writes each to the connection, as JSON,
      in a frame of its own, a JSON list. While a write waits for a slow page, the screen reads nothing: the source of a
      show must not wait for it, as cepheus.Watch never does. While an action of the page runs, the changes wait, at
      most held seconds, and go with its reply in one frame: the page then never draws the action's row twice, its
      effect and the change it made. The replies wait for the first message of each show, the answer, too. *)
  made = shown(screen, s)
  if result.IsErr(made)
    failing(made.Error, send, s.Ended, conn)
    return missing
  end
  sources = made.Value.Sources
  names = made.Value.Names
  seen = list.Fill(false, value.Len(sources))
  waiting = value.Len(sources)
  replies = []
  pending = []
  busy = 0
  chs = list.Concat([s.Ended, inbox], sources)
  while true
    got = if busy > 0 fiber.Select(chs, timeout = held) else fiber.Select(chs) end
    out = []
    if result.IsErr(got) and got.Error.Kind == "timeout"
      out = pending
      pending = []
    else if result.IsErr(got)
      if got.Error.Channel == s.Ended
        return missing
      end
      k = list.IndexOf(got.Error.Channel, sources)
      failing(refused("The show $(json.Parse(names[k]).Value) ended."), send, s.Ended, conn)
      return missing
    else if got.Value.Channel == inbox
      v = got.Value.Value
      if v.Kind == "error"
        failing(missing, send, s.Ended, conn, last = v.Text)
        return missing
      else if v.Kind == "acting"
        busy += 1
      else if v.Kind == "ack"
        busy -= 1
        replies = list.Append(v.Text, replies)
        if busy == 0 or value.Len(pending) > 0
          out = pending
          pending = []
        end
      else
        out = [v.Text]
      end
    else
      k = list.IndexOf(got.Value.Channel, sources)
      v = got.Value.Value
      rows = dict.Get("Rows", v)
      t = if value.IsMissing(rows) "{\"Show\":$(names[k]),\"Group\":$(number(v.Group)),\"Added\":$(listText(v.Added)),\"Removed\":$(listText(v.Removed)),\"At\":$(now())}" else "{\"Show\":$(names[k]),\"Group\":$(number(v.Group)),\"Rows\":$(listText(rows)),\"At\":$(now())}" end
      if not seen[k]
        seen[k] = true
        waiting -= 1
      end
      if busy > 0 and value.Len(pending) < inARow
        pending = list.Append(t, pending)
      else
        out = list.Append(t, pending)
        pending = []
      end
    end
    if waiting == 0 and value.Len(replies) > 0 and value.Len(pending) == 0
      out = list.Concat(out, replies)
      replies = []
    end
    if value.Len(out) > 0 and result.IsErr(send(if value.Len(out) == 1 "[$(out[1])]" else "[$(text.Join(",", out))]" end))
      return missing
    end
  end
end

defn failing(e, send, ended, conn, last = missing)
  (** Ends a screen with an error that the page gets: the page then closes its side, or the connection closes after a
      second. *)
  _ = send("[$(if value.IsMissing(last) json.Text({Error: e}) else last end)]")
  _ = fiber.Receive(ended, timeout = 1)
  conn.Close()
end

(* live.js, the page's side, served at the path of Route and /live.js. *)
client = "// live.js, the page's side of std/live: connect(url) opens a screen of the app; live.show(name, draw) draws a show's
// rows at each change; live.act(name, args, effects) asks the app for an action and shows its effect at once.
const pageNow = () => performance.timeOrigin + performance.now()
const later = typeof requestAnimationFrame === 'function' ? requestAnimationFrame : f => setTimeout(f, 0)

// The same text for two rows that hold the same values, whatever the order of their keys.
function key(v) {
  if (Array.isArray(v)) return '[' + v.map(key).join(',') + ']'
  if (v !== null && typeof v === 'object') return '{' + Object.keys(v).sort().map(k => JSON.stringify(k) + ':' + key(v[k])).join(',') + '}'
  return JSON.stringify(v)
}

// Rows with their repeats: a row's key, the row, and how many times it is there.
function tally(rows, list, sign) {
  for (const row of list) {
    const k = key(row)
    const had = rows.get(k)
    const n = (had ? had.n : 0) + sign
    if (n > 0) rows.set(k, { row, n })
    else rows.delete(k)
  }
  return rows
}

function quantile(sorted, q) {
  return sorted[Math.max(0, Math.ceil(q * sorted.length) - 1)]
}

class Live {
  constructor(url) {
    const u = new URL(url, location.href)
    u.protocol = u.protocol === 'https:' ? 'wss:' : 'ws:'
    this.url = u.href
    this.shows = new Map()
    this.pending = []
    this.next = 1
    this.handlers = []
    this.socket = null
    this.closed = false
    this.ended = false
    this.wait = 250
    this.offset = null
    this.best = Infinity
    this.delays = []
    this.frame = 0
    this.timers = []
  }

  open(opened, refused) {
    const socket = new WebSocket(this.url)
    this.socket = socket
    let up = false
    socket.onopen = () => {
      up = true
      this.wait = 250
      socket.send(JSON.stringify({ Hello: 1 }))
      this.ping()
      if (opened) opened(this)
    }
    socket.onmessage = e => {
      const at = pageNow()
      for (const m of JSON.parse(e.data)) this.heard(m, at)
    }
    socket.onclose = () => {
      this.socket = null
      for (const p of this.pending.filter(p => !p.answered)) this.settle(p, false, { Kind: 'live', Message: 'The connection to the app broke before it answered: the action may have run or not.' })
      if (!up && refused) return refused({ Kind: 'live', Message: 'No screen opened at ' + this.url + '.' })
      if (!this.closed && !this.ended) {
        setTimeout(() => this.open(), this.wait * (0.5 + Math.random()))
        this.wait = Math.min(this.wait * 2, 8000)
      }
    }
  }

  heard(m, at) {
    if ('Show' in m) {
      const s = this.get(m.Show)
      if ('Rows' in m) s.rows = tally(new Map(), m.Rows, 1)
      else tally(tally(s.rows, m.Added, 1), m.Removed, -1)
      s.group = m.Group
      for (const p of this.pending.slice()) {
        if (!(m.Show in p.effects)) continue
        if (!p.answered) p.changed.add(m.Show)
        else if (p.keep.includes(m.Show)) {
          p.keep = p.keep.filter(n => n !== m.Show)
          if (p.keep.length === 0) p.drop()
        }
      }
      if (this.offset !== null) this.delays.push(at - (m.At / 1000 - this.offset))
      if (this.delays.length >= 10000) this.report()
      this.dirty(s)
    } else if ('Ack' in m) {
      const p = this.pending.find(p => p.id === m.Ack)
      if (p && !p.answered) this.settle(p, !('Err' in m), 'Err' in m ? m.Err : m.Ok)
    } else if ('Pong' in m) {
      const trip = at - m.Pong
      if (trip < this.best) {
        this.best = trip
        this.offset = m.At / 1000 - (m.Pong + at) / 2
      }
    } else if ('Error' in m) {
      this.ended = true
      this.emit(m.Error)
      if (this.socket) this.socket.close(1000)
    }
  }

  // The reply to an action: an Err drops its effect at once; an Ok drops it on each show that a message came to since
  // the action was asked for, and keeps it on the others until their next message, at most 100 ms, so that the row
  // is drawn neither twice nor not at all, whichever of the change and the reply comes first.
  settle(p, ok, value) {
    p.keep = ok ? Object.keys(p.effects).filter(n => !p.changed.has(n)) : []
    p.answered = true
    const drop = () => {
      const i = this.pending.indexOf(p)
      if (i >= 0) this.pending.splice(i, 1)
      for (const name in p.effects) this.dirty(this.get(name))
    }
    if (p.keep.length === 0) drop()
    else {
      p.drop = drop
      setTimeout(drop, 100)
    }
    if (ok) p.resolve(value)
    else p.reject(value)
  }

  get(name) {
    let s = this.shows.get(name)
    if (!s) {
      s = { name, rows: new Map(), group: null, draws: [], dirty: false }
      this.shows.set(name, s)
    }
    return s
  }

  dirty(s) {
    s.dirty = true
    if (!this.frame) this.frame = later(() => this.draw())
  }

  // Each show drawn once a frame at most: the server's rows, then the effect of each action not yet answered, in order.
  draw() {
    this.frame = 0
    for (const s of this.shows.values()) {
      if (!s.dirty || s.group === null) continue
      s.dirty = false
      let rows = []
      for (const e of s.rows.values()) for (let i = 0; i < e.n; i++) rows.push(e.row)
      for (const p of this.pending) {
        const effect = p.effects[s.name]
        if (effect) {
          try { rows = effect(rows.slice()) } catch (e) { this.emit({ Kind: 'live', Message: 'The effect of ' + p.name + ' on ' + s.name + ' failed: ' + e }) }
        }
      }
      for (const draw of s.draws) {
        try { draw(rows) } catch (e) { this.emit({ Kind: 'live', Message: 'Drawing ' + s.name + ' failed: ' + e }) }
      }
    }
  }

  ping() {
    if (this.socket && this.socket.readyState === 1) this.socket.send(JSON.stringify({ Ping: pageNow() }))
  }

  report() {
    if (this.delays.length === 0 || !this.socket || this.socket.readyState !== 1) return
    const sorted = this.delays.sort((a, b) => a - b)
    this.socket.send(JSON.stringify({ Delays: { P50: quantile(sorted, 0.5), P99: quantile(sorted, 0.99), Count: sorted.length } }))
    this.delays = []
  }

  emit(e) {
    if (this.handlers.length === 0) console.error('live:', e)
    for (const f of this.handlers) f(e)
  }

  show(name, draw) {
    const s = this.get(name)
    s.draws.push(draw)
    if (s.group !== null) this.dirty(s)
  }

  act(name, args, effects) {
    if (!this.socket || this.socket.readyState !== 1) return Promise.reject({ Kind: 'live', Message: 'This page is not connected to its app.' })
    return new Promise((resolve, reject) => {
      const p = { id: this.next++, name, effects: effects || {}, resolve, reject, sent: true, changed: new Set(), answered: false, keep: [] }
      this.pending.push(p)
      this.socket.send(JSON.stringify({ Act: name, Id: p.id, Args: args === undefined ? null : args }))
      for (const n in p.effects) this.dirty(this.get(n))
    })
  }

  onError(f) {
    this.handlers.push(f)
  }

  close() {
    this.closed = true
    for (const t of this.timers) clearInterval(t)
    if (this.socket) this.socket.close(1000)
  }
}

export function connect(url) {
  return new Promise((opened, refused) => {
    const live = new Live(url)
    live.timers.push(setInterval(() => live.ping(), 30000), setInterval(() => live.report(), 60000))
    live.open(opened, e => { live.close(); refused(e) })
  })
}
"
