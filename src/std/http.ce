(** The web: an application of routes, middleware and responses, served over HTTP/1.1, and Fetch, which asks a server. All
    of it is written in Cesia, on std/net.

      Handler(App() then Get("/", r -> Plain("hi")))({Method: "GET", Path: "/", Query: "", Headers: [], Body: ""}).Body --> "hi" *)
use std/net
use std/sys
use std/bug
use std/dict
use std/encode
use std/fiber
use std/json
use std/list
use std/log
use std/math
use std/metrics
use std/result
use std/text
use std/value
use std/websocket as ws

(* Byte offsets from 0, as HTTP counts them: where a part first occurs, or missing, and a text cut after its first k bytes. *)
defn offset(part, s)
  at = text.ByteFind(part, 1, s)
  if value.IsMissing(at) missing else at - 1 end
end
cutAt(k, s) = [text.ByteSlice(1, k, s), text.ByteSlice(k + 1, text.ByteLength(s), s)]

crlf = "\r\n"              (* The line end of HTTP. *)
blank = "$crlf$crlf"       (* The empty line that ends the head of a request or a response. *)
maxHead = 16384            (* The largest head of a request, in bytes: a longer one is answered 431. *)
(** The largest body of a request that Serve reads, in bytes, unless maxBody says otherwise.

      DefaultMaxBody --> 1048576 *)
DefaultMaxBody = 1048576
(** The seconds a connection has for each request, unless timeout says otherwise.

      DefaultTimeout --> 60 *)
DefaultTimeout = 60
(* The seconds a kept connection has for one more request when the server stops between two of its requests: one may be on
   its way, and it gets a response that says that the connection closes, where closing at once would lose it. *)
lastCall = 1

(** The standard reason text of a status code, or "Unknown".

      Reason(404) --> "Not Found"
      Reason(599) --> "Unknown" *)
Reason(status) = match status
  200 -> "OK"
  101 -> "Switching Protocols"
  201 -> "Created"
  204 -> "No Content"
  301 -> "Moved Permanently"
  302 -> "Found"
  304 -> "Not Modified"
  401 -> "Unauthorized"
  403 -> "Forbidden"
  405 -> "Method Not Allowed"
  408 -> "Request Timeout"
  409 -> "Conflict"
  422 -> "Unprocessable Content"
  429 -> "Too Many Requests"
  400 -> "Bad Request"
  404 -> "Not Found"
  413 -> "Content Too Large"
  431 -> "Request Header Fields Too Large"
  500 -> "Internal Server Error"
  501 -> "Not Implemented"
  503 -> "Service Unavailable"
  else -> "Unknown"
end

defn header(line)
  (** A header line as {Name, Value}, or missing if it isn't one: isHeader, a native of this package, refuses a name with a
      space, a folded line or a lone line end, which a proxy in front could read otherwise. *)
  at = offset(":", line)
  if value.IsMissing(at) or not isHeader(at, line)
    missing
  else
    parts = cutAt(at, line)
    {Name: text.Lower(parts[1]), Value: text.Trim(cutAt(1, parts[2])[2])}
  end
end

defn HeaderValue(name, headers)
  (** The value of the first header of this name, in lower case, or missing.

        HeaderValue("host", [{Name: "host", Value: "localhost:8080"}]) --> "localhost:8080"
        HeaderValue("cookie", []) --> missing *)
  for h in headers
    if h.Name == name
      return h.Value
    end
  end
  missing
end

defn parseRequest(buffer, limit = DefaultMaxBody)
  (** Ok of the first request and what follows it, Ok(missing) if the head isn't all there, Ok({Needs}) with the size of the
      whole request if its body isn't, or Err of a status. request, a native of this package, reads it in one pass: every
      request comes through here. *)
  request(buffer, limit, maxHead)
end

defn headerLine(h)
  (** The line of a header of a response, Name: Value. A line end in it is a bug, and stops the fiber: it would let data from a
      client write a response of its own. *)
  line = "$(h.Name): $(h.Value)"
  bug.Assert(not text.Contains("\r", line) and not text.Contains("\n", line), "This response header has a line end.")
  "$line$crlf"
end

defn render(response, headOnly = false, closing = false, streamed = "")
  (** The text of an HTTP/1.1 response from {Status, Body} and optional headers. With headOnly, the body is left out; with
      closing, a header tells the client that the server closes the connection after it. A streamed body has no length:
      streamed is "chunked" for its chunks, or "closed" for one that ends when the connection does. Every response has a
      Date, as RFC 9110 asks of a server with a clock (section 6.6.1), unless it has its own: dateLine, a native of this
      package, makes its line again only when the second changes. *)
  status = response.Status
  bug.Assert(value.IsInt(status), "This response has a status that isn't an integer.")
  body = value.Text(response.Body)
  extra = match response
    {Headers: headers} -> headers
    else -> []
  end
  custom = if value.Len(extra) == 0 "" else text.Join("", list.Map(headerLine, extra)) end
  ending = if closing "connection: close$crlf" else "" end
  lengthLine = if streamed == "chunked"
    "transfer-encoding: chunked$crlf"
  else if streamed != "" or status == 101 or status == 204
    ""
  else
    "content-length: $(text.ByteLength(body))$crlf"
  end
  shown = if headOnly or streamed != "" "" else body end
  dated = if value.Len(extra) > 0 and ownDate(extra) "" else dateLine() end
  "HTTP/1.1 $status $(Reason(status))$crlf$dated$lengthLine$custom$ending$crlf$shown"
end

defn ownDate(headers)
  (** Does a response have its own Date header? A name is read in either case, as HTTP reads it. *)
  for h in headers
    if value.IsText(h.Name) and sameBytes(h.Name, "date")
      return true
    end
  end
  false
end

(** The text of a response with just a status and its reason, after which the server closes the connection. *)
failure(status) = render({Status: status, Body: Reason(status)}, closing = true)

defn ready(response, headOnly, chunked, last = false)
  (** A response made ready to send: a struct with reply (its text, or its head when its body is streamed), upgrade (a
      function or missing), stream (the function of a body that Stream gives, missing for HEAD), chunked, and close,
      true when the server stops, or for the last response of its connection: the response tells the client, which asks
      again on a new connection, not on this one. A client that doesn't read chunks, as HTTP/1.0, gets a streamed body
      that ends with the connection. *)
  upgrade = match response
    {Upgrade: upgrade} -> upgrade
    else -> missing
  end
  stream = match response
    {Stream: stream} -> stream
    else -> missing
  end
  streamed = if value.IsMissing(stream) "" else if chunked "chunked" else "closed" end
  closing = last or stopping() or streamed == "closed"
  {Reply: render(response, headOnly = headOnly, closing = closing, streamed = streamed), Upgrade: upgrade, Stream: if headOnly missing else stream end,
    Chunked: chunked, Close: closing}
end

defn answer(handle, request, left, chunked, last = false)
  (** The response of a handler to a request, ready to send, within left seconds. A panic in the handler stops its own
      fiber only, and answers 500. A handler that takes longer gets a 503, and the connection closes while it runs on. *)
  match fiber.Wait(fiber.Spawn(() -> ready(handle(request), request.Method == "HEAD", chunked, last = last)), timeout = list.Max(0, left))
    result.Ok(done) -> done
    result.Err(e) -> {Reply: failure(if e.Kind == "timeout" 503 else 500 end), Upgrade: missing, Stream: missing, Chunked: chunked, Close: true}
  end
end

hexDigits = "0123456789abcdef"   (* The digits of the size of a chunk. *)

defn hexOf(n)
  (** The size of a chunk in hexadecimal, as RFC 9112 writes it. *)
  d = math.Mod(n, 16) + 1
  low = text.ByteSlice(d, d, hexDigits)
  if n < 16 low else "$(hexOf(math.Div(n, 16)))$low" end
end

defn pour(conn, produce, chunked, timeout)
  (** Sends a streamed body as produce gives its pieces, in a fiber of its own: each piece must come, and go out, within
      timeout seconds of the one before, or the connection closes, so that a client that stops reading holds nothing
      for long. Ok when produce returned and the body was ended, an Err when the client is gone or slow, or when produce
      panicked or gave an Err: the body is then cut short, which the client sees. *)
  defn send(piece)
    bug.Assert(value.IsText(piece), "A piece of a streamed body is a text.")
    if piece == ""
      return result.Ok(missing)
    end
    conn.Arm(timeout)
    conn.Write(if chunked "$(hexOf(text.ByteLength(piece)))$crlf$piece$crlf" else piece end)
  end
  conn.Arm(timeout)
  made = fiber.Wait(fiber.Spawn(() -> produce(send)))
  if result.IsErr(made) or result.IsErr(made.Value)
    return if result.IsErr(made) made else made.Value end
  end
  conn.Arm(timeout)
  if chunked conn.Write("0$crlf$crlf") else result.Ok(missing) end
end

(** How a connection reads, writes and closes without TLS: the wrap of Serve when it is missing, and of Fetch for http://. *)
tcp(c) = result.Ok({Read: () -> net.Read(c), Write: s -> net.Write(c, s), Close: () -> net.Close(c)})

waits(parsed) = match parsed
  {Needs: needs} -> true
  else -> false
end

defn readOn(conn)
  (** The next read of a connection, as conn.Read gives it, but when the server stops in the middle of a head or a body:
      that request is in progress, and still gets its response. A read hears of the stop once. *)
  got = conn.Read()
  if result.IsErr(got) and got.Error.Kind == "stopped" conn.Read() else got end
end

defn gather(conn, first, needed)
  (** Reads from a connection until the needed size, or to its end if the size is missing: an Ok of what arrived, which an
      early end leaves short. It reads in one pass, so a body sent a byte at a time isn't parsed again at each read. *)
  pieces = {0: first}
  total = text.ByteLength(first)
  while value.IsMissing(needed) or total < needed
    more = readOn(conn)?
    if text.ByteLength(more) == 0
      break
    end
    pieces[value.Len(pieces)] = more
    total += text.ByteLength(more)
  end
  result.Ok(text.Join("", dict.Values(pieces)))
end

lastBytes(k, s) = if text.ByteLength(s) <= k s else text.ByteSlice(text.ByteLength(s) - k + 1, text.ByteLength(s), s) end

defn readHead(conn, first)
  (** Reads until the empty line that ends a head has come, or more than a head may hold: an Ok of all that came, or of
      missing if the connection ended first. Each read is searched alone, after the last bytes before it: a head sent a
      byte at a time isn't searched or copied again at each read. *)
  pieces = {0: first}
  total = text.ByteLength(first)
  tail = lastBytes(3, first)
  while total <= maxHead
    more = readOn(conn)?
    if text.ByteLength(more) == 0
      return result.Ok(missing)
    end
    pieces[value.Len(pieces)] = more
    total += text.ByteLength(more)
    seen = "$tail$more"
    if not value.IsMissing(offset(blank, seen))
      break
    end
    tail = lastBytes(3, seen)
  end
  result.Ok(text.Join("", dict.Values(pieces)))
end

defn connection(handle, conn, buffer, options, deadline)
  (** Serves the requests of one connection, one after the other, each by its deadline, a time in seconds since 1970: its
      head and its body must have come by then, and its handler must have answered, or the client gets a 503. A slow
      client can't hold a connection with a byte at a time. A body that takes more than the bodies being read may take
      together gets a 503 at once: see hold. *)
  parsed = if buffer == "" result.Ok(missing) else parseRequest(buffer, limit = options.MaxBody) end
  streamed = if value.IsMissing(options.Streams) missing else streaming(buffer, parsed, options) end
  if not value.IsMissing(streamed)
    inPieces(handle, conn, streamed, options, deadline)
  else if result.IsErr(parsed)
    conn.Write(failure(parsed.Error))
    conn.Close()
  else if value.IsMissing(parsed.Value)
    (* Most heads come in one read. Those that don't are gathered in one pass. *)
    more = if buffer == "" conn.Read() else readHead(conn, buffer) end
    if result.IsErr(more) and more.Error.Kind == "stopped"
      (* The server stops between two requests of this connection: one may be on its way, and still gets its response. *)
      grace = list.Min(lastCall, options.Timeout)
      conn.Arm(grace)
      connection(handle, conn, buffer, options, sys.Now() + grace)
    else if result.IsErr(more) or value.IsMissing(more.Value) or more.Value == ""
      conn.Close()
    else
      connection(handle, conn, more.Value, options, deadline)
    end
  else if waits(parsed.Value)
    whole = if conn.Hold(parsed.Value.Needs) gather(conn, buffer, parsed.Value.Needs) else missing end
    if value.IsMissing(whole)
      conn.Write(failure(503))
      conn.Close()
    else if result.IsErr(whole) or text.ByteLength(whole.Value) < parsed.Value.Needs
      conn.Close()
    else
      connection(handle, conn, whole.Value, options, deadline)
    end
  else
    request = parsed.Value.Request
    request.Peer = conn.Peer
    conn.Arm(0)
    done = answer(handle, request, deadline - sys.Now(), parsed.Value.Chunked)
    conn.Arm(options.Timeout)
    sent = conn.Write(done.Reply)
    if result.IsOk(sent) and not value.IsMissing(done.Stream)
      sent = pour(conn, done.Stream, done.Chunked, options.Timeout)
      conn.Arm(options.Timeout)
    end
    next = sys.Now() + options.Timeout
    if result.IsErr(sent) or done.Close or (parsed.Value.Close and value.IsMissing(done.Upgrade))
      conn.Close()
    else if not value.IsMissing(done.Upgrade)
      _ = fiber.Wait(fiber.Spawn(() -> done.Upgrade(conn, parsed.Value.Rest)))
      conn.Close()
    else
      connection(handle, conn, parsed.Value.Rest, options, next)
    end
  end
end

defn streaming(buffer, parsed, options)
  (** A request whose route takes its body in pieces (Route's stream), when that body isn't all in the buffer or is
      larger than maxBody: {Request, First, Size, Chunked}, First the bytes of the body that came with the head, or
      {Status} to refuse it at once, a body larger than its route takes (413) or a head with a second length (400).
      Missing for any other request, which goes on as before. The head is read by request, the native, without its
      line of content-length, so that it is read as every head is, and a second length is seen. *)
  big = result.IsErr(parsed) and parsed.Error == 413
  if not (big or (result.IsOk(parsed) and waits(parsed.Value)))
    return missing
  end
  ends = offset(blank, buffer)
  if value.IsMissing(ends)
    return missing
  end
  head = text.ByteSlice(1, ends, buffer)
  at = text.ByteFind("$(crlf)content-length:", 1, head, fold = true)
  if value.IsMissing(at)
    return missing
  end
  stop = text.ByteFind(crlf, at + 2, head)
  stop = if value.IsMissing(stop) text.ByteLength(head) + 1 else stop end
  digits = text.Trim(text.ByteSlice(at + 17, stop - 1, head))
  before = text.ByteSlice(1, at - 1, head)
  after = if stop > text.ByteLength(head) "" else text.ByteSlice(stop, text.ByteLength(head), head) end
  again = parseRequest("$before$after$blank", limit = 0)
  size = text.Number(digits)
  if result.IsErr(again) or value.IsMissing(again.Value) or waits(again.Value) or not value.IsInt(size) or text.ByteLength(digits) > 18
    return {Status: 400}
  end
  request = again.Value.Request
  most = options.Streams(request.Path, request.Method)
  if value.IsMissing(most)
    return missing
  end
  if size > most
    return {Status: 413}
  end
  first = if ends + 4 >= text.ByteLength(buffer) "" else text.ByteSlice(ends + 5, text.ByteLength(buffer), buffer) end
  {Request: request, First: first, Size: size, Chunked: again.Value.Chunked}
end

(* The bytes a second that a body read in pieces is given at least, past the timeout of its request: 64 KiB. *)
leastRate = 65536

defn inPieces(handle, conn, streamed, options, deadline)
  (** Serves a request whose body comes in pieces, then closes its connection: the handler reads the body as it
      comes, by Read, within the request's deadline plus a second for each 64 KiB of its size, each piece within
      timeout seconds of the one before. *)
  if dict.Has("Status", streamed)
    conn.Write(failure(streamed.Status))
    conn.Close()
    return missing
  end
  request = streamed.Request
  request.Peer = conn.Peer
  request.Size = streamed.Size
  told = http100(request.Headers)
  start = fiber.Channel()
  pieces = fiber.Channel(size = 1)
  task = fiber.Spawn(() -> feeding(conn, streamed.First, streamed.Size, told, options.Timeout, start, pieces))
  request.Read = () -> piece(start, pieces)
  conn.Arm(0)
  done = answer(handle, request, deadline - sys.Now() + streamed.Size / leastRate, streamed.Chunked, last = true)
  fiber.Cancel(task)
  _ = fiber.Wait(task)
  conn.Arm(options.Timeout)
  sent = conn.Write(done.Reply)
  if result.IsOk(sent) and not value.IsMissing(done.Stream)
    _ = pour(conn, done.Stream, done.Chunked, options.Timeout)
  end
  conn.Close()
end

defn http100(headers)
  (** Did the client ask to be told to send its body (Expect: 100-continue, RFC 9110, section 10.1.1)? *)
  asked = HeaderValue("expect", headers)
  value.IsText(asked) and sameBytes(text.Trim(asked), "100-continue")
end

defn piece(start, pieces)
  (** The next piece of a body that comes in pieces, as the handler reads it: an Ok of its bytes, "" once it is all
      read, or an Err. The first read tells the producer to start. *)
  fiber.Send(true, start)
  got = fiber.Receive(pieces)
  if result.IsErr(got) result.Ok("") else got.Value end
end

defn feeding(conn, first, size, told, timeout, start, pieces)
  (** Reads a body of size bytes from a connection, once its handler first reads it, and gives it in pieces, an Ok of
      each, an Ok of "" at its end, or an Err when the client stops sending: each read has timeout seconds. A client
      that asked for it is told 100 Continue then, and not before: a handler that refuses the request before it reads
      its body never makes the client send it. *)
  _ = fiber.Receive(start)
  if told and text.ByteLength(first) < size
    conn.Arm(timeout)
    conn.Write("HTTP/1.1 100 Continue$crlf$crlf")
  end
  had = if text.ByteLength(first) > size text.ByteSlice(1, size, first) else first end
  got = text.ByteLength(had)
  if got > 0
    fiber.Send(result.Ok(had), pieces)
  end
  while got < size
    conn.Arm(timeout)
    more = readOn(conn)
    conn.Arm(0)
    if result.IsErr(more) or text.ByteLength(more.Value) == 0
      fiber.Send(failed("The body of this request was cut short after $got of its $size bytes."), pieces)
      fiber.Close(pieces)
      return missing
    end
    bytes = more.Value
    if got + text.ByteLength(bytes) > size
      bytes = text.ByteSlice(1, size - got, bytes)
    end
    got += text.ByteLength(bytes)
    fiber.Send(result.Ok(bytes), pieces)
  end
  fiber.Send(result.Ok(""), pieces)
  fiber.Close(pieces)
end

defn start(handle, c, options)
  (** Serves a new connection: its deadline, then TLS if the options wrap it, then its requests. The deadline starts before
      TLS, so a client that connects and says nothing reaches it too. The connection gets Arm, which sets it again: the
      deadlines are this package's own. *)
  arm(c, options.Timeout)
  deadline = sys.Now() + options.Timeout
  made = options.Wrap(c)
  if result.IsErr(made)
    net.Close(c)
  else
    w = made.Value
    conn = {Read: w.Read, Write: w.Write, Close: w.Close, Arm: s -> arm(c, s), Hold: n -> hold(c, n), Peer: net.Peer(c)}
    connection(handle, conn, "", options, deadline)
  end
end

defn acceptLoop(handle, listener, options)
  (** Accepts the connections of a listener and serves each in its fiber, until a stop signal. An accept that fails for lack of
      descriptors is tried again later, without spinning. *)
  while true
    next = net.Accept(listener)
    if result.IsOk(next)
      fiber.Spawn(() -> start(handle, next.Value, options))
    else if next.Error.Kind == "stopped"
      return result.Ok(missing)
    else
      sys.Sleep(0.1)
    end
  end
end

defn reaper(period)
  (** Closes what outlived its deadline, at each period, until the last socket is gone. *)
  while openCount() > 0
    sys.Sleep(period)
    reap()
  end
end

defn waitForConnections(deadline)
  (** Waits until no socket is open, or until the time in seconds since 1970 that deadline gives. *)
  while openCount() > 0 and sys.Now() < deadline
    sys.Sleep(0.01)
  end
end

defn serve(handle, port, host, timeout, maxBody, wrap, listener, streams = missing)
  (** Serves the requests to handle until a stop signal, then lets those in progress end, each by its deadline.
      handle(request) receives {Method, Path, Query, Headers, Body, Peer}, Peer the address of the client as net.Peer
      gives it, and returns {Status, Body}, with optional headers, and
      optional upgrade, a function of the connection and of the bytes after the request, which takes the connection over
      after the response. *)
  listener = if value.IsMissing(listener) net.Listen(port, host = host)? else listener end
  fiber.Spawn(() -> reaper(list.Max(0.01, list.Min(1.0, timeout / 2.0))))
  acceptLoop(handle, listener, {Timeout: timeout, MaxBody: maxBody, Wrap: if value.IsMissing(wrap) tcp else wrap end, Streams: streams})?
  net.Close(listener)
  waitForConnections(sys.Now() + timeout)
  result.Ok(missing)
end

failed(message) = result.Err({Kind: "http", Message: message})   (** An Err of the kind "http" with a message. *)

defn ParseUrl(url)
  (** {Host, Port, Path, Secure} of an http:// or https:// URL.

        ParseUrl("http://localhost:8080/a?b=1") --> result.Ok({Host: "localhost", Port: 8080, Path: "/a?b=1", Secure: false})
        ParseUrl("https://example.com") --> result.Ok({Host: "example.com", Port: 443, Path: "/", Secure: true})
        ParseUrl("localhost:8080") then result.MapErr(it.Kind) --> result.Err("http") *)
  secure = url then text.StartsWith("https://")
  scheme = if secure "https://" else "http://" end
  if not (url then text.StartsWith(scheme))
    failed("This URL doesn't start with http://.")
  else
    rest = cutAt(text.ByteLength(scheme), url)[2]
    slash = offset("/", rest)
    parts = if value.IsMissing(slash) [rest, "/"] else cutAt(slash, rest) end
    colon = offset(":", parts[1])
    if value.IsMissing(colon)
      result.Ok({Host: parts[1], Port: if secure 443 else 80 end, Path: parts[2], Secure: secure})
    else
      address = cutAt(colon, parts[1])
      port = text.Number(cutAt(1, address[2])[2])
      if value.IsInt(port) result.Ok({Host: address[1], Port: port, Path: parts[2], Secure: secure}) else failed("This URL has a bad port.") end
    end
  end
end

responseHeaders(head) = list.Filter(not value.IsMissing(it), list.Map(header, text.Split(crlf, head)[2..end]))

defn fullSize(head)
  (** The size of a response, from its head and the content-length: a server may keep the connection open. Missing if only
      the end of the connection tells. *)
  size = HeaderValue("content-length", responseHeaders(head))
  if value.IsText(size) and value.IsInt(text.Number(size)) text.ByteLength(head) + 4 + text.Number(size) else missing end
end

defn within(timeout, socket, f)
  (** What f gives, or an Err of kind "timeout" when it takes more than timeout seconds, the socket then closed, which ends
      what f waited for. A missing timeout waits as long as it takes. *)
  if value.IsMissing(timeout)
    return f()
  end
  waited = fiber.Wait(fiber.Spawn(f), timeout = timeout)
  if result.IsOk(waited)
    return waited.Value
  end
  net.Close(socket)
  if waited.Error.Kind == "timeout" result.Err({Kind: "timeout", Message: "The server sent nothing for $timeout seconds."}) else waited end
end

defn readResponse(read, maxBody)
  (** Reads a whole response with read, a read of the connection: an Ok of its bytes, or an Err. The head comes first, at
      most maxHead bytes, each read searched for its end alone, after the last bytes before it, so that a head sent a byte
      at a time isn't searched or copied again at each read; then the body, at most maxBody bytes after the head, the
      marks of a chunked one too, or to the end the content-length gives, or the end of the connection. *)
  pieces = {}
  total = 0
  tail = ""
  at = missing
  while value.IsMissing(at)
    more = read()?
    if text.ByteLength(more) == 0
      return result.Ok(text.Join("", dict.Values(pieces)))
    end
    pieces[value.Len(pieces)] = more
    seen = "$tail$more"
    found = offset(blank, seen)
    if not value.IsMissing(found)
      at = total - text.ByteLength(tail) + found
    else if total + text.ByteLength(more) > maxHead
      return failed("The head of this response is longer than $maxHead bytes.")
    end
    total += text.ByteLength(more)
    tail = lastBytes(3, seen)
  end
  needed = fullSize(text.ByteSlice(1, at, text.Join("", dict.Values(pieces))))
  most = if value.IsMissing(maxBody) missing else at + 4 + maxBody end
  if not value.IsMissing(most) and not value.IsMissing(needed) and needed > most
    return failed("The body of this response is longer than maxBody, $maxBody bytes.")
  end
  while value.IsMissing(needed) or total < needed
    if not value.IsMissing(most) and total > most
      return failed("The body of this response is longer than maxBody, $maxBody bytes.")
    end
    more = read()?
    if text.ByteLength(more) == 0
      break
    end
    pieces[value.Len(pieces)] = more
    total += text.ByteLength(more)
  end
  if not value.IsMissing(most) and total > most and value.IsMissing(needed)
    return failed("The body of this response is longer than maxBody, $maxBody bytes.")
  end
  result.Ok(text.Join("", dict.Values(pieces)))
end

defn hex(digits)
  (** The value of hexadecimal digits, or missing. Fifteen digits always fit in an integer. *)
  values = [offset(text.Slice(i, i, digits), "0123456789abcdef") for i in 1..value.Len(digits)]
  if value.Len(values) == 0 or value.Len(values) > 15 or missing in values
    missing
  else
    list.Reduce((acc, d) -> acc * 16 + d, 0, values)
  end
end

defn unchunk(data)
  (** Joins the chunks of a chunked body, in one pass: from is where the next size line starts. *)
  pieces = dict.Dict()
  from = 1
  while true
    at = text.ByteFind(crlf, from, data)
    if value.IsMissing(at)
      return failed("This chunked body is cut short.")
    end
    size = hex(text.Lower(text.Split(";", if at == from "" else text.ByteSlice(from, at - 1, data) end)[1]))
    start = at + 2
    if value.IsMissing(size) or text.ByteLength(data) - start + 1 < size
      return failed("This chunked body is malformed.")
    end
    if size == 0
      return result.Ok(text.Join("", dict.Values(pieces)))
    end
    pieces[value.Len(pieces)] = text.ByteSlice(start, start + size - 1, data)
    from = start + size + 2
  end
end

defn parseResponse(raw)
  (** Reads the text of a response: an Ok of {Status, Headers, Body} (a chunked body is joined), or an Err. *)
  at = offset(blank, raw)
  firstEnd = offset(crlf, raw)
  words = text.Split(" ", if value.IsMissing(firstEnd) raw else cutAt(firstEnd, raw)[1] end)
  status = if value.Len(words) >= 2 text.Number(words[2]) else missing end
  if value.IsMissing(at) or not value.IsInt(status) or not (words[1] then text.StartsWith("HTTP/"))
    failed("This response isn't HTTP.")
  else
    cut = cutAt(at, raw)
    headers = responseHeaders(cut[1])
    rest = cutAt(4, cut[2])[2]
    size = HeaderValue("content-length", headers)
    count = if value.IsText(size) text.Number(size) else text.ByteLength(rest) end
    body = if HeaderValue("transfer-encoding", headers) == "chunked"
      unchunk(rest)
    else if not value.IsInt(count) or count < 0 or count > text.ByteLength(rest)
      failed("This response is cut short.")
    else
      result.Ok(cutAt(count, rest)[1])
    end
    result.MapOk(b -> {Status: status, Headers: headers, Body: b}, body)
  end
end

clean(s) = not (text.Contains(" ", s) or text.Contains("\r", s) or text.Contains("\n", s))

defn hostOf(target)
  (** The Host header of a request to a target of ParseUrl: its port too, unless it is the scheme's own, as a browser
      writes it (RFC 9110, section 7.2), so that a server that compares the Origin of a page with it finds the same text.

        hostOf(ParseUrl("http://127.0.0.1:8090/a").Value) --> "127.0.0.1:8090"
        hostOf(ParseUrl("https://example.com/").Value) --> "example.com"
        hostOf(ParseUrl("http://example.com:443/").Value) --> "example.com:443" *)
  if target.Port == (if target.Secure 443 else 80 end) target.Host else "$(target.Host):$(target.Port)" end
end

defn Fetch(url, method = "GET", body = "", headers = [], secure = missing, timeout = 300, maxBody = missing, peer = missing)
  (** Asks a server: an Ok of {Status, Headers, Body}, as the server answered, or an Err when it can't be reached or its
      answer isn't HTTP. A 404 is a response, not an error: look at Status. For https, secure = tls.Client(api). A server
      silent for timeout seconds, as it starts TLS or between two reads of its response, gives an Err of kind
      "timeout": a slow download goes on as long as bytes come; missing waits for ever. The head of a response holds at
      most 16 KiB, and its body at most maxBody bytes, the marks of a chunked one too: past them an Err, and with missing
      the body is only bounded by the memory of the program. peer, when given, is a function of the address the
      connection reached, as net.Peer gives it ("203.0.113.7", "::1"), called once it is open and before any byte is
      sent, those of TLS too: an Err it gives closes the connection, and Fetch gives that Err. A server named by its
      host is thus checked by the very address it was found at, with no second lookup that a server of names could
      answer otherwise (DNS rebinding): what a program asks for another, at an address it was given, can't reach this
      machine or its network when peer refuses their addresses.

        Fetch("ftp://example.com/") then result.MapErr(it.Kind) --> result.Err("http")
        l = net.Listen(0)!
        fiber.Spawn(() -> Serve(App() then Get("/", r -> Plain("hi")), listener = l))
        mine(address) = if address == "127.0.0.1" result.Err({Kind: "http", Message: "not here"}) else result.Ok(missing) end
        Fetch("http://localhost:$(net.Port(l))/", peer = mine) --> result.Err({Kind: "http", Message: "not here"}) *)
  target = ParseUrl(url)?
  if not (clean(method) and clean(target.Host) and clean(target.Path))
    return failed("This request has a space or a line end where it can't.")
  end
  if target.Secure and value.IsMissing(secure)
    return failed("https needs secure = tls.Client(api), with api from tls.Open(): see std/tls.")
  end
  c = net.Connect(target.Host, target.Port)?
  if not value.IsMissing(peer)
    allowed = peer(net.Peer(c))
    if result.IsErr(allowed)
      net.Close(c)
      return allowed
    end
  end
  made = within(timeout, c, () -> if target.Secure secure(c, target.Host) else tcp(c) end)
  if result.IsErr(made)
    net.Close(c)
    return made
  end
  conn = made.Value
  custom = text.Join("", list.Map(headerLine, headers))
  sized = if body == "" and method == "GET" "" else "Content-Length: $(text.ByteLength(body))$crlf" end
  message = "$method $(target.Path) HTTP/1.1$(crlf)Host: $(hostOf(target))$(crlf)Connection: close$crlf$sized$custom$crlf$body"
  sent = conn.Write(message)
  raw = if result.IsOk(sent) readResponse(() -> within(timeout, c, conn.Read), maxBody) else sent end
  conn.Close()
  parseResponse(raw?)
end

(** An application with no route and no middleware: it answers each request with a 404.

      Handler(App())({Method: "GET", Path: "/", Query: "", Headers: [], Body: ""}).Status --> 404 *)
App() = {Routes: [], Middleware: []}

defn Route(method, pattern, handler, a, stream = missing)
  (** An application with a route added. The pattern may hold :name parts, which the handler finds in its params, and a final * for the rest of the path.
      With stream, the most bytes the body of its requests may hold, a body too large for one read or for maxBody
      comes to the handler in pieces, as an upload of a file: r.Body is "", r.Size its length, and r.Read() gives an
      Ok of its next piece, "" once it is all read, or an Err when the client stops sending. Serve then reads it only as
      the handler asks, a piece at a time, so the body is never whole in memory; a client that sent Expect:
      100-continue is told to go on at the first Read only, so a request refused before its body is read never sends
      it. A body larger than stream gets a 413 before the handler runs. The handler has the timeout of Serve, and a
      second more for each 64 KiB of the body, each piece coming within timeout seconds of the one before; the
      connection closes after its response. A smaller body that came whole is in r.Body, as for any route.

        files = App() then Route("PATCH", "/files/*", r -> Plain(r.Params["*"]))
        Handler(files)({Method: "PATCH", Path: "/files/a/b.txt", Query: "", Headers: [], Body: ""}).Body --> "a/b.txt"
        scans = App() then Route("POST", "/scans", r -> Plain("$(r.Size) bytes"), stream = 10485760)
        scans.Routes[1].Stream --> 10485760 *)
  entry = {Method: method, Parts: segments(pattern), Handler: handler, Stream: stream}
  {Routes: list.Append(entry, a.Routes), Middleware: a.Middleware}
end

(** An application with a GET route added: Handler(request) gives a response.

      hello = App() then Get("/hello/:name", r -> Plain("Hello, $(r.Params.name)!"))
      Handler(hello)({Method: "GET", Path: "/hello/Ana", Query: "", Headers: [], Body: ""}).Body --> "Hello, Ana!" *)
Get(pattern, handler, a) = Route("GET", pattern, handler, a)
(** An application with a POST route added. Another method on its path gets a 405.

      echo = App() then Post("/echo", r -> Plain(r.Body))
      Handler(echo)({Method: "POST", Path: "/echo", Query: "", Headers: [], Body: "hi"}).Body --> "hi"
      Handler(echo)({Method: "GET", Path: "/echo", Query: "", Headers: [], Body: ""}).Status --> 405 *)
Post(pattern, handler, a) = Route("POST", pattern, handler, a)
(** An application with a PUT route added.

      notes = App() then Put("/notes/:id", r -> Plain("Note $(r.Params.id): $(r.Body)"))
      Handler(notes)({Method: "PUT", Path: "/notes/7", Query: "", Headers: [], Body: "milk"}).Body --> "Note 7: milk" *)
Put(pattern, handler, a) = Route("PUT", pattern, handler, a)
(** An application with a DELETE route added.

      erase = App() then Delete("/notes/:id", r -> {Status: 204, Body: ""})
      Handler(erase)({Method: "DELETE", Path: "/notes/7", Query: "", Headers: [], Body: ""}).Status --> 204 *)
Delete(pattern, handler, a) = Route("DELETE", pattern, handler, a)
(** An application with a route added that takes any method.

      ping = App() then AnyMethod("/ping", r -> Plain(r.Method))
      Handler(ping)({Method: "OPTIONS", Path: "/ping", Query: "", Headers: [], Body: ""}).Body --> "OPTIONS" *)
AnyMethod(pattern, handler, a) = Route("*", pattern, handler, a)

(** A middleware is f(next, request), and calls next(request) to go on. What it puts in the request, as the person
    signed in, the handler finds there.

      tag(next, r) = WithHeader("x-served-by", "cesia", next(r))
      served = Handler(App() then Get("/", r -> Plain("hi")) then Wrap(tag))
      HeaderValue("x-served-by", served({Method: "GET", Path: "/", Query: "", Headers: [], Body: ""}).Headers) --> "cesia"
      signed(next, r) = next(dict.Put("User", "Ana", r))
      greeted = Handler(App() then Get("/", r -> Plain("Hello, $(r.User)!")) then Wrap(signed))
      greeted({Method: "GET", Path: "/", Query: "", Headers: [], Body: ""}).Body --> "Hello, Ana!" *)
Wrap(f, a) = {Routes: a.Routes, Middleware: list.Append(f, a.Middleware)}

(** A plain text response.

      Plain("hi") --> {Status: 200, Body: "hi", Headers: [{Name: "content-type", Value: "text/plain; charset=utf-8"}]}
      Plain("Gone", status = 410).Status --> 410 *)
Plain(s, status = 200) = {Status: status, Body: s, Headers: [type("text/plain; charset=utf-8")]}
(** An HTML response.

      Html("<b>hi</b>").Headers --> [{Name: "content-type", Value: "text/html; charset=utf-8"}] *)
Html(s, status = 200) = {Status: status, Body: s, Headers: [type("text/html; charset=utf-8")]}
(** A response with the JSON text of a value.

      Json({Units: 4}).Body --> "{\"Units\":4}"
      Json({Units: 4}).Headers --> [{Name: "content-type", Value: "application/json"}] *)
Json(data, status = 200) = {Status: status, Body: json.Text(data), Headers: [type("application/json")]}
(** A response that sends the client to another URL.

      Redirect("/login") --> {Status: 302, Body: "", Headers: [{Name: "location", Value: "/login"}]} *)
Redirect(url, status = 302) = {Status: status, Body: "", Headers: [{Name: "location", Value: url}]}
(** A 404 response.

      NotFound() --> Plain("Not Found", status = 404) *)
NotFound() = Plain("Not Found", status = 404)
type(kind) = {Name: "content-type", Value: kind}

defn Stream(produce, status = 200, headers = [])
  (** A response whose body goes out in pieces, as an export of a large table: the whole body is never in memory.
      produce(send) runs once the head has gone, and each send(piece), a text, goes to the client at once, as a chunk
      of HTTP/1.1 (RFC 9112, section 7.1). send gives an Ok, or an Err once the client is gone, or when a piece took
      more than the timeout of Serve to come or to be taken: produce stops then, as send(piece)? does. The body ends when
      produce returns; a panic in produce, or an Err that it gives, cuts it short, which the client sees as an error,
      not as a whole body. A HEAD request gets the
      head alone, without running produce; a client of HTTP/1.0 gets the pieces as they are, and the connection ends
      with the body.

        rows = Handler(App() then Get("/rows", r -> Stream(send -> send("a,b\n"), headers = [type("text/csv")])))
        rows({Method: "GET", Path: "/rows", Query: "", Headers: [], Body: ""}).Status --> 200 *)
  {Status: status, Body: "", Headers: headers, Stream: produce}
end

defn WithHeader(name, content, response)
  (** A response with one more header.

        WithHeader("cache-control", "no-store", Plain("hi")).Headers[2] --> {Name: "cache-control", Value: "no-store"} *)
  headers = match response
    {Headers: headers} -> headers
    else -> []
  end
  out = response
  out.Headers = list.Append({Name: name, Value: content}, headers)
  out
end

defn SetCookie(name, content, response, options = "Path=/; HttpOnly; SameSite=Lax")
  (** A response with a cookie set. Its content is URL-encoded.

        SetCookie("sid", "a b", Plain("hi")).Headers[2] --> {Name: "set-cookie", Value: "sid=a%20b; Path=/; HttpOnly; SameSite=Lax"} *)
  WithHeader("set-cookie", "$name=$(encode.UrlEncode(content)); $options", response)
end

defn cookies(headers)
  line = HeaderValue("cookie", headers)
  out = dict.Dict()
  if value.IsMissing(line)
    return out
  end
  for part in text.Split(";", line)
    pair = text.Split("=", text.Trim(part))
    if value.Len(pair) == 2
      out[pair[1]] = encode.UrlDecode(pair[2])
    end
  end
  out
end

defn matchPath(parts, path)
  (** Binds :name parts, and a final * takes what remains. The parameters, or missing if the path doesn't match. *)
  out = dict.Dict()
  n = value.Len(parts)
  for k in 1..n
    part = parts[k]
    if part == "*"
      out["*"] = text.Join("/", if k == 1 path else list.Skip(k - 1, path) end)
      return out
    end
    if k > value.Len(path)
      return missing
    end
    if text.StartsWith(":", part)
      out[text.ByteSlice(2, text.ByteLength(part), part)] = encode.UrlDecode(path[k])
    else if part != path[k]
      return missing
    end
  end
  if n == value.Len(path) out else missing end
end

defn enrich(request, params)
  (** The request that a handler gets: its query and its cookies read, the params of its route, and the rest as it came,
      with what a middleware put in it. *)
  r = request
  r.Query = encode.ParseQuery(request.Query)
  r.Params = params
  r.Cookies = cookies(request.Headers)
  r
end

(** The body of a form, or of JSON.

      Form({Body: "name=Ana+Lee&units=4"}) --> {name: "Ana Lee", units: "4"} *)
Form(request) = encode.ParseQuery(request.Body)
(** The body of a request read as JSON: an Ok of the value, or an Err.

      BodyJson({Body: "{\"Units\": 4}"}) --> result.Ok({Units: 4})
      BodyJson({Body: "not json"}) then result.MapErr(it.Kind) --> result.Err("json") *)
BodyJson(request) = json.Parse(request.Body)

defn settled(reply)
  (** The response of a handler that may give a result: the value of an Ok, a 500 for an Err. *)
  match reply
    result.Ok(v) -> v
    result.Err(e) -> Plain("Internal Server Error", status = 500)
    else -> reply
  end
end

defn dispatch(routes, find, request)
  (** The response of the first route added that takes the request's path and method, as each route tried in its order
      would give it: a 405 when only routes of other methods take the path, a 404 when none does. find, which router, a
      native of this package, made once from the routes, walks the tree of their parts: its cost doesn't grow with them. *)
  path = segments(request.Path)
  k = find(path, request.Method)
  if k > 0
    r = routes[k]
    settled(r.Handler(enrich(request, matchPath(r.Parts, path))))
  else if k == 0
    NotFound()
  else
    Plain("Method Not Allowed", status = 405)
  end
end

defn chain(find, a, k)
  (** Built once: a request only goes through it. *)
  if k == 0
    r -> dispatch(a.Routes, find, r)
  else
    next = chain(find, a, k - 1)
    f = a.Middleware[k]
    r -> f(next, r)
  end
end

(** The function of a request that an application is: the routes behind the middleware. Serve calls it for each request,
    and a test can call it without the network. A handler that gives an Err answers 500.

      search = Handler(App() then Get("/search", r -> Plain(r.Query["q"])))
      search({Method: "GET", Path: "/search", Query: "q=cake", Headers: [], Body: ""}).Body --> "cake"
      broken = Handler(App() then Get("/", r -> result.Err("down")))
      broken({Method: "GET", Path: "/", Query: "", Headers: [], Body: ""}).Status --> 500 *)
Handler(a) = chain(router([r.Method for r in a.Routes], [r.Parts for r in a.Routes]), a, value.Len(a.Middleware))

defn Serve(a, port = 8080, host = "127.0.0.1", timeout = DefaultTimeout, maxBody = DefaultMaxBody, wrap = missing, listener = missing)
  (** Serves an application until a stop signal, TERM, INT or HUP: then it accepts no more, lets the requests in progress
      end, each by its deadline, with a response that tells its client that the connection closes, and gives Ok. It listens
      on port, on this machine only unless host says otherwise. timeout is the seconds a connection has for each request,
      to send it and to have it answered: a handler that takes longer gets a 503 and runs on alone. maxBody is the
      largest body read, in bytes, but for a route that takes its body in pieces (Route's stream); the bodies read at
      once take at most a quarter of the memory limit, and past it a request gets a 503 at once. wrap sits under HTTP, as TLS does: wrap = tls.Server(certificate, key,
      api)?; without it, HTTP goes on TCP alone. A listener already open, as a test opens on port 0 to learn its port with
      net.Port, takes the place of port and host.

        l = net.Listen(0)!
        fiber.Spawn(() -> Serve(App() then Get("/", r -> Plain("hi")), listener = l))
        Fetch("http://localhost:$(net.Port(l))/").Value.Body --> "hi" *)
  serve(Handler(a), port, host, timeout, maxBody, wrap, listener, streams = streams(a))
end

defn streams(a)
  (** The function that gives, from the path and method of a request, the most bytes of the body of its route when the
      route takes its body in pieces (Route's stream), else missing; missing when no route does, so that the others pay
      nothing. *)
  mosts = [dict.Get("Stream", r) for r in a.Routes]
  if list.All([value.IsMissing(m) for m in mosts])
    return missing
  end
  find = router([r.Method for r in a.Routes], [r.Parts for r in a.Routes])
  (path, method) -> mostOf(find(segments(path), method), mosts)
end

mostOf(k, mosts) = if k > 0 mosts[k] else missing end   (* The most bytes of the body of route k, or missing. *)

(** An application with a WebSocket route added: onMessage(text, send) runs for each message, and send(text) answers. A
    request that isn't a WebSocket one gets a 400.

      chat = Handler(App() then Websocket("/chat", (m, send) -> send(m)))
      handshake = [{Name: "upgrade", Value: "websocket"}, {Name: "sec-websocket-key", Value: "dGhlIHNhbXBsZSBub25jZQ=="}]
      chat({Method: "GET", Path: "/chat", Query: "", Headers: handshake, Body: ""}).Status --> 101
      chat({Method: "GET", Path: "/chat", Query: "", Headers: [], Body: ""}).Status --> 400 *)
Websocket(pattern, onMessage, a, idle = ws.DefaultIdle) = Get(pattern, req -> upgrade(req.Headers, onMessage, idle), a)

defn upgrade(headers, onMessage, idle)
  (** The response that hands a WebSocket request over to std/websocket, or a 400 if it isn't one. *)
  key = HeaderValue("sec-websocket-key", headers)
  asked = HeaderValue("upgrade", headers)
  if value.IsMissing(key) or value.IsMissing(asked) or text.Lower(asked) != "websocket"
    {Status: 400, Body: "This route takes WebSocket connections."}
  else
    ws.Accept(key, onMessage, idle = idle)
  end
end

defn Logger(next, request)
  (** A middleware that writes a line of std/log for each request: its method, its path, its status, and the milliseconds
      it took.

        logged = Handler(App() then Get("/", r -> Plain("hi")) then Wrap(Logger))
        logged({Method: "GET", Path: "/nowhere", Query: "", Headers: [], Body: ""}).Status --> 404 *)
  start = sys.Now()
  response = next(request)
  ms = math.Round((sys.Now() - start) * 1000000) / 1000
  log.Info("request", {Method: request.Method, Path: request.Path, Status: response.Status, Ms: ms})
  response
end

defn Metrics(next, request)
  (** A middleware that counts each request in std/metrics: http_requests_total by method and status, and its time in
      http_request_seconds, a histogram. A route of the program shows them to Prometheus, with metrics.Text().

        counted = Handler(App() then Get("/", r -> Plain("hi")) then Wrap(Metrics))
        counted({Method: "GET", Path: "/", Query: "", Headers: [], Body: ""}).Status --> 200
        text.Contains("http_requests_total{method=\"GET\",status=\"200\"}", metrics.Text()) --> true *)
  start = sys.Now()
  response = next(request)
  metrics.Add("http_requests_total", labels = {method: request.Method, status: response.Status})
  metrics.Observe("http_request_seconds", sys.Now() - start)
  response
end

defn Cors(origin)
  (** A middleware that lets a given origin read the responses.

        shared = Handler(App() then Get("/", r -> Plain("hi")) then Wrap(Cors("https://shop.example")))
        reply = shared({Method: "GET", Path: "/", Query: "", Headers: [], Body: ""})
        HeaderValue("access-control-allow-origin", reply.Headers) --> "https://shop.example" *)
  (next, request) -> WithHeader("access-control-allow-origin", origin, next(request))
end

defn SameOrigin(next, request)
  (** A middleware against cross-site request forgery, CSRF: a request that can change something, by any method but GET,
      HEAD and OPTIONS, or that opens a WebSocket, gets a 403 when it comes from a page of another site, which the
      browser would send with the cookies of its visitor. The browser's Sec-Fetch-Site header decides when it is there:
      same-origin passes, and none, an address the person typed; same-site and cross-site don't. Without it, the Origin
      header must be http:// or https:// then the Host header the request came with, its port too, in either case;
      "null" never is. A request with neither header comes from no browser: it passes, and the program checks who sent
      it, as by a cookie or a token. The method is read as it is written: a get is checked.

        app = Handler(App() then Post("/pay", r -> Plain("paid")) then Wrap(SameOrigin))
        pay(headers) = app({Method: "POST", Path: "/pay", Query: "", Headers: headers, Body: ""}).Status
        pay([{Name: "sec-fetch-site", Value: "same-origin"}]) --> 200
        pay([{Name: "sec-fetch-site", Value: "cross-site"}, {Name: "origin", Value: "https://shop.example"}, {Name: "host", Value: "shop.example"}]) --> 403
        pay([{Name: "origin", Value: "https://shop.example"}, {Name: "host", Value: "shop.example"}]) --> 200
        pay([{Name: "origin", Value: "https://elsewhere.example"}, {Name: "host", Value: "shop.example"}]) --> 403
        pay([{Name: "origin", Value: "https://shop.example:8443"}, {Name: "host", Value: "shop.example"}]) --> 403
        pay([{Name: "origin", Value: "null"}, {Name: "host", Value: "shop.example"}]) --> 403
        pay([]) --> 200 *)
  if isSameOrigin(request) next(request) else Plain("This request comes from another origin than the app's.", status = 403) end
end

(* Do two texts hold the same bytes, the ASCII letters in either case? Any other byte, as those of é, matches only
   itself: no change of case can make the names of two hosts one. *)
sameBytes(a, b) = text.ByteLength(a) == text.ByteLength(b) and text.ByteFind(a, 1, b, fold = true) == 1

defn isSameOrigin(request)
  (** Does SameOrigin let this request pass? *)
  headers = request.Headers
  asked = HeaderValue("upgrade", headers)
  if request.Method in ["GET", "HEAD", "OPTIONS"] and not (value.IsText(asked) and sameBytes(asked, "websocket"))
    return true
  end
  site = HeaderValue("sec-fetch-site", headers)
  if value.IsText(site)
    return site == "same-origin" or site == "none"
  end
  origin = HeaderValue("origin", headers)
  host = HeaderValue("host", headers)
  value.IsMissing(origin) or (value.IsText(host) and host != "" and (sameBytes(origin, "https://$host") or sameBytes(origin, "http://$host")))
end

(* Static files under a folder. A path can't leave it. *)
types = {"html": "text/html; charset=utf-8", "css": "text/css", "js": "text/javascript", "json": "application/json",
  "png": "image/png", "jpg": "image/jpeg", "svg": "image/svg+xml", "txt": "text/plain; charset=utf-8"}

defn FileResponse(path)
  (** The response with the content of a file, typed by its extension, or a 404 if it can't be read.

        FileResponse("src/tools/site.css").Headers --> [{Name: "content-type", Value: "text/css"}]
        FileResponse("src/tools/nowhere.css").Status --> 404 *)
  parts = text.Split(".", path)
  kind = dict.GetOr(text.Lower(parts[value.Len(parts)]), "application/octet-stream", types)
  match sys.Read(path)
    result.Ok(data) -> {Status: 200, Body: data, Headers: [type(kind)]}
    else -> NotFound()
  end
end

defn Static(prefix, folder, a)
  (** An application with a route added that serves the files of a folder under a URL prefix. A path can't leave the folder.

        assets = Handler(App() then Static("/assets", "src/tools"))
        assets({Method: "GET", Path: "/assets/site.css", Query: "", Headers: [], Body: ""}).Status --> 200
        assets({Method: "GET", Path: "/assets/../tools/site.css", Query: "", Headers: [], Body: ""}).Status --> 404 *)
  serveFile(request) = static(folder, request.Params["*"])
  Get("$prefix/*", serveFile, a)
end

defn static(folder, rest)
  if ".." in text.Split("/", rest) or rest == ""
    NotFound()
  else
    FileResponse("$folder/$rest")
  end
end

(** A text, or any value as its text, with &, <, >, " and ' written as HTML writes them: for what comes from outside, in
    HTML. A template escapes its values the same way.

      Escape("<a href='x'>Tom & Jerry</a>") --> "&lt;a href=&#39;x&#39;&gt;Tom &amp; Jerry&lt;/a&gt;" *)
Escape(s) = text.Replace("'", "&#39;", text.Replace("\"", "&quot;", text.Replace(">", "&gt;", text.Replace("<", "&lt;", text.Replace("&", "&amp;", value.Text(s))))))

defn Template(source, values)
  (** The source with each {{name}} replaced by the escaped value of that name. One pass: a value that holds {{name}} isn't
      read again.

        Template("<p>Hello, {{name}}!</p>", {name: "<Ana>"}) --> "<p>Hello, &lt;Ana&gt;!</p>" *)
  parts = text.Split("{{", source)
  out = list.Fill("", value.Len(parts))
  out[1] = parts[1]
  for k in 2..value.Len(parts)
    part = parts[k]
    close = text.ByteFind("}}", 1, part)
    name = if value.IsMissing(close) missing else text.Trim(if close == 1 "" else text.ByteSlice(1, close - 1, part) end) end
    if value.IsMissing(name) or not dict.Has(name, values)
      out[k] = "{{$part"
    else
      rest = close + 2
      tail = if rest > text.ByteLength(part) "" else text.ByteSlice(rest, text.ByteLength(part), part) end
      out[k] = "$(Escape(values[name]))$tail"
    end
  end
  text.Join("", out)
end
