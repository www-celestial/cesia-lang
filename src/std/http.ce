(** The web: an application of routes, middleware and responses, served over HTTP/1.1, and Fetch, which asks a server. All
    of it is written in Cesia, on std/net.

      Handler(App() then Get("/", r -> Plain("hi")))({Method: "GET", Path: "/", Query: "", Headers: [], Body: ""}).Body --> "hi" *)
use std/net
use std/sys
use std/bug
use std/dict
use std/encode
use std/fiber
use std/json
use std/list
use std/log
use std/math
use std/metrics
use std/result
use std/text
use std/value
use std/websocket as ws

(* Byte offsets from 0, as HTTP counts them: where a part first occurs, or missing, and a text cut after its first k bytes. *)
defn offset(part, s)
  at = text.ByteFind(part, 1, s)
  if value.IsMissing(at) missing else at - 1 end
end
cutAt(k, s) = [text.ByteSlice(1, k, s), text.ByteSlice(k + 1, text.ByteLength(s), s)]

crlf = "\r\n"              (* The line end of HTTP. *)
blank = "$crlf$crlf"       (* The empty line that ends the head of a request or a response. *)
maxHead = 16384            (* The largest head of a request, in bytes: a longer one is answered 431. *)
(** The largest body of a request that Serve reads, in bytes, unless maxBody says otherwise.

      DefaultMaxBody --> 1048576 *)
DefaultMaxBody = 1048576
(** The seconds a connection has for each request, unless timeout says otherwise.

      DefaultTimeout --> 60 *)
DefaultTimeout = 60
(* The seconds a kept connection has for one more request when the server stops between two of its requests: one may be on
   its way, and it gets a response that says that the connection closes, where closing at once would lose it. *)
lastCall = 1

(** The standard reason text of a status code, or "Unknown".

      Reason(404) --> "Not Found"
      Reason(599) --> "Unknown" *)
Reason(status) = match status
  200 -> "OK"
  101 -> "Switching Protocols"
  201 -> "Created"
  204 -> "No Content"
  301 -> "Moved Permanently"
  302 -> "Found"
  304 -> "Not Modified"
  401 -> "Unauthorized"
  403 -> "Forbidden"
  405 -> "Method Not Allowed"
  408 -> "Request Timeout"
  409 -> "Conflict"
  422 -> "Unprocessable Content"
  429 -> "Too Many Requests"
  400 -> "Bad Request"
  404 -> "Not Found"
  413 -> "Content Too Large"
  431 -> "Request Header Fields Too Large"
  500 -> "Internal Server Error"
  501 -> "Not Implemented"
  503 -> "Service Unavailable"
  else -> "Unknown"
end

defn header(line)
  (** A header line as {Name, Value}, or missing if it isn't one: isHeader, a native of this package, refuses a name with a
      space, a folded line or a lone line end, which a proxy in front could read otherwise. *)
  at = offset(":", line)
  if value.IsMissing(at) or not isHeader(at, line)
    missing
  else
    parts = cutAt(at, line)
    {Name: text.Lower(parts[1]), Value: text.Trim(cutAt(1, parts[2])[2])}
  end
end

defn HeaderValue(name, headers)
  (** The value of the first header of this name, in lower case, or missing.

        HeaderValue("host", [{Name: "host", Value: "localhost:8080"}]) --> "localhost:8080"
        HeaderValue("cookie", []) --> missing *)
  for h in headers
    if h.Name == name
      return h.Value
    end
  end
  missing
end

defn parseRequest(buffer, limit = DefaultMaxBody)
  (** Ok of the first request and what follows it, Ok(missing) if the head isn't all there, Ok({Needs}) with the size of the
      whole request if its body isn't, or Err of a status. request, a native of this package, reads it in one pass: every
      request comes through here. *)
  request(buffer, limit, maxHead)
end

defn headerLine(h)
  (** The line of a header of a response, Name: Value. A line end in it is a bug, and stops the fiber: it would let data from a
      client write a response of its own. *)
  line = "$(h.Name): $(h.Value)"
  bug.Assert(not text.Contains("\r", line) and not text.Contains("\n", line), "This response header has a line end.")
  "$line$crlf"
end

defn render(response, headOnly = false, closing = false)
  (** The text of an HTTP/1.1 response from {Status, Body} and optional headers. With headOnly, the body is left out; with
      closing, a header tells the client that the server closes the connection after it. *)
  status = response.Status
  bug.Assert(value.IsInt(status), "This response has a status that isn't an integer.")
  body = value.Text(response.Body)
  extra = match response
    {Headers: headers} -> headers
    else -> []
  end
  custom = if value.Len(extra) == 0 "" else text.Join("", list.Map(headerLine, extra)) end
  ending = if closing "connection: close$crlf" else "" end
  lengthLine = if status == 101 or status == 204 "" else "content-length: $(text.ByteLength(body))$crlf" end
  shown = if headOnly "" else body end
  "HTTP/1.1 $status $(Reason(status))$crlf$lengthLine$custom$ending$crlf$shown"
end

(** The text of a response with just a status and its reason, after which the server closes the connection. *)
failure(status) = render({Status: status, Body: Reason(status)}, closing = true)

defn ready(response, headOnly)
  (** A response made ready to send: a struct with reply (its text), upgrade (a function or missing) and close, true when
      the server stops: the response tells the client, which asks again on a new connection, not on this one. *)
  upgrade = match response
    {Upgrade: upgrade} -> upgrade
    else -> missing
  end
  closing = stopping()
  {Reply: render(response, headOnly = headOnly, closing = closing), Upgrade: upgrade, Close: closing}
end

defn answer(handle, request, left)
  (** The response of a handler to a request, ready to send, within left seconds. A panic in the handler stops its own
      fiber only, and answers 500. A handler that takes longer gets a 503, and the connection closes while it runs on. *)
  match fiber.Wait(fiber.Spawn(() -> ready(handle(request), request.Method == "HEAD")), timeout = list.Max(0, left))
    result.Ok(done) -> done
    result.Err(e) -> {Reply: failure(if e.Kind == "timeout" 503 else 500 end), Upgrade: missing, Close: true}
  end
end

(** How a connection reads, writes and closes without TLS: the wrap of Serve when it is missing, and of Fetch for http://. *)
tcp(c) = result.Ok({Read: () -> net.Read(c), Write: s -> net.Write(c, s), Close: () -> net.Close(c)})

waits(parsed) = match parsed
  {Needs: needs} -> true
  else -> false
end

defn gather(conn, first, needed)
  (** Reads from a connection until the needed size, or to its end if the size is missing: an Ok of what arrived, which an
      early end leaves short. It reads in one pass, so a body sent a byte at a time isn't parsed again at each read. *)
  pieces = {0: first}
  total = text.ByteLength(first)
  while value.IsMissing(needed) or total < needed
    more = conn.Read()?
    if text.ByteLength(more) == 0
      break
    end
    pieces[value.Len(pieces)] = more
    total += text.ByteLength(more)
  end
  result.Ok(text.Join("", dict.Values(pieces)))
end

lastBytes(k, s) = if text.ByteLength(s) <= k s else text.ByteSlice(text.ByteLength(s) - k + 1, text.ByteLength(s), s) end

defn readHead(conn, first)
  (** Reads until the empty line that ends a head has come, or more than a head may hold: an Ok of all that came, or of
      missing if the connection ended first. Each read is searched alone, after the last bytes before it: a head sent a
      byte at a time isn't searched or copied again at each read. *)
  pieces = {0: first}
  total = text.ByteLength(first)
  tail = lastBytes(3, first)
  while total <= maxHead
    more = conn.Read()?
    if text.ByteLength(more) == 0
      return result.Ok(missing)
    end
    pieces[value.Len(pieces)] = more
    total += text.ByteLength(more)
    seen = "$tail$more"
    if not value.IsMissing(offset(blank, seen))
      break
    end
    tail = lastBytes(3, seen)
  end
  result.Ok(text.Join("", dict.Values(pieces)))
end

defn connection(handle, conn, buffer, options, deadline)
  (** Serves the requests of one connection, one after the other, each by its deadline, a time in seconds since 1970: its
      head and its body must have come by then, and its handler must have answered, or the client gets a 503. A slow
      client can't hold a connection with a byte at a time. A body that takes more than the bodies being read may take
      together gets a 503 at once: see hold. *)
  parsed = if buffer == "" result.Ok(missing) else parseRequest(buffer, limit = options.MaxBody) end
  if result.IsErr(parsed)
    conn.Write(failure(parsed.Error))
    conn.Close()
  else if value.IsMissing(parsed.Value)
    (* Most heads come in one read. Those that don't are gathered in one pass. *)
    more = if buffer == "" conn.Read() else readHead(conn, buffer) end
    if result.IsErr(more) and more.Error.Kind == "stopped"
      (* The server stops: a request on its way, or half come, still gets its response. *)
      grace = list.Min(lastCall, options.Timeout)
      if buffer == "" conn.Arm(grace) end
      connection(handle, conn, buffer, options, if buffer == "" sys.Now() + grace else deadline end)
    else if result.IsErr(more) or value.IsMissing(more.Value) or more.Value == ""
      conn.Close()
    else
      connection(handle, conn, more.Value, options, deadline)
    end
  else if waits(parsed.Value)
    whole = if conn.Hold(parsed.Value.Needs) gather(conn, buffer, parsed.Value.Needs) else missing end
    if value.IsMissing(whole)
      conn.Write(failure(503))
      conn.Close()
    else if result.IsErr(whole) or text.ByteLength(whole.Value) < parsed.Value.Needs
      conn.Close()
    else
      connection(handle, conn, whole.Value, options, deadline)
    end
  else
    request = parsed.Value.Request
    conn.Arm(0)
    done = answer(handle, request, deadline - sys.Now())
    conn.Arm(options.Timeout)
    next = sys.Now() + options.Timeout
    sent = conn.Write(done.Reply)
    if result.IsErr(sent) or done.Close or (parsed.Value.Close and value.IsMissing(done.Upgrade))
      conn.Close()
    else if not value.IsMissing(done.Upgrade)
      _ = fiber.Wait(fiber.Spawn(() -> done.Upgrade(conn, parsed.Value.Rest)))
      conn.Close()
    else
      connection(handle, conn, parsed.Value.Rest, options, next)
    end
  end
end

defn start(handle, c, options)
  (** Serves a new connection: its deadline, then TLS if the options wrap it, then its requests. The deadline starts before
      TLS, so a client that connects and says nothing reaches it too. The connection gets Arm, which sets it again: the
      deadlines are this package's own. *)
  arm(c, options.Timeout)
  deadline = sys.Now() + options.Timeout
  made = options.Wrap(c)
  if result.IsErr(made)
    net.Close(c)
  else
    w = made.Value
    conn = {Read: w.Read, Write: w.Write, Close: w.Close, Arm: s -> arm(c, s), Hold: n -> hold(c, n)}
    connection(handle, conn, "", options, deadline)
  end
end

defn acceptLoop(handle, listener, options)
  (** Accepts the connections of a listener and serves each in its fiber, until a stop signal. An accept that fails for lack of
      descriptors is tried again later, without spinning. *)
  while true
    next = net.Accept(listener)
    if result.IsOk(next)
      fiber.Spawn(() -> start(handle, next.Value, options))
    else if next.Error.Kind == "stopped"
      return result.Ok(missing)
    else
      sys.Sleep(0.1)
    end
  end
end

defn reaper(period)
  (** Closes what outlived its deadline, at each period, until the last socket is gone. *)
  while openCount() > 0
    sys.Sleep(period)
    reap()
  end
end

defn waitForConnections(deadline)
  (** Waits until no socket is open, or until the time in seconds since 1970 that deadline gives. *)
  while openCount() > 0 and sys.Now() < deadline
    sys.Sleep(0.01)
  end
end

defn serve(handle, port, host, timeout, maxBody, wrap, listener)
  (** Serves the requests to handle until a stop signal, then lets those in progress end, each by its deadline.
      handle(request) receives {Method, Path, Query, Headers, Body} and returns {Status, Body}, with optional headers, and
      optional upgrade, a function of the connection and of the bytes after the request, which takes the connection over
      after the response. *)
  listener = if value.IsMissing(listener) net.Listen(port, host = host)? else listener end
  fiber.Spawn(() -> reaper(list.Max(0.01, list.Min(1.0, timeout / 2.0))))
  acceptLoop(handle, listener, {Timeout: timeout, MaxBody: maxBody, Wrap: if value.IsMissing(wrap) tcp else wrap end})?
  net.Close(listener)
  waitForConnections(sys.Now() + timeout)
  result.Ok(missing)
end

failed(message) = result.Err({Kind: "http", Message: message})   (** An Err of the kind "http" with a message. *)

defn ParseUrl(url)
  (** {Host, Port, Path, Secure} of an http:// or https:// URL.

        ParseUrl("http://localhost:8080/a?b=1") --> result.Ok({Host: "localhost", Port: 8080, Path: "/a?b=1", Secure: false})
        ParseUrl("https://example.com") --> result.Ok({Host: "example.com", Port: 443, Path: "/", Secure: true})
        ParseUrl("localhost:8080") then result.MapErr(it.Kind) --> result.Err("http") *)
  secure = url then text.StartsWith("https://")
  scheme = if secure "https://" else "http://" end
  if not (url then text.StartsWith(scheme))
    failed("This URL doesn't start with http://.")
  else
    rest = cutAt(text.ByteLength(scheme), url)[2]
    slash = offset("/", rest)
    parts = if value.IsMissing(slash) [rest, "/"] else cutAt(slash, rest) end
    colon = offset(":", parts[1])
    if value.IsMissing(colon)
      result.Ok({Host: parts[1], Port: if secure 443 else 80 end, Path: parts[2], Secure: secure})
    else
      address = cutAt(colon, parts[1])
      port = text.Number(cutAt(1, address[2])[2])
      if value.IsInt(port) result.Ok({Host: address[1], Port: port, Path: parts[2], Secure: secure}) else failed("This URL has a bad port.") end
    end
  end
end

responseHeaders(head) = list.Filter(not value.IsMissing(it), list.Map(header, text.Split(crlf, head)[2..end]))

defn fullSize(head)
  (** The size of a response, from its head and the content-length: a server may keep the connection open. Missing if only
      the end of the connection tells. *)
  size = HeaderValue("content-length", responseHeaders(head))
  if value.IsText(size) and value.IsInt(text.Number(size)) text.ByteLength(head) + 4 + text.Number(size) else missing end
end

defn readResponse(conn, buffer)
  (** Reads a whole response from a connection: an Ok of {Status, Headers, Body}, or an Err. The head comes first, and is read
      once: the rest of a large response doesn't parse it again. *)
  at = offset(blank, buffer)
  if value.IsMissing(at)
    more = conn.Read()?
    if text.ByteLength(more) == 0 result.Ok(buffer) else readResponse(conn, "$buffer$more") end
  else
    gather(conn, buffer, fullSize(cutAt(at, buffer)[1]))
  end
end

defn hex(digits)
  (** The value of hexadecimal digits, or missing. Fifteen digits always fit in an integer. *)
  values = [offset(text.Slice(i, i, digits), "0123456789abcdef") for i in 1..value.Len(digits)]
  if value.Len(values) == 0 or value.Len(values) > 15 or missing in values
    missing
  else
    list.Reduce((acc, d) -> acc * 16 + d, 0, values)
  end
end

defn unchunk(data)
  (** Joins the chunks of a chunked body, in one pass: from is where the next size line starts. *)
  pieces = dict.Dict()
  from = 1
  while true
    at = text.ByteFind(crlf, from, data)
    if value.IsMissing(at)
      return failed("This chunked body is cut short.")
    end
    size = hex(text.Lower(text.Split(";", if at == from "" else text.ByteSlice(from, at - 1, data) end)[1]))
    start = at + 2
    if value.IsMissing(size) or text.ByteLength(data) - start + 1 < size
      return failed("This chunked body is malformed.")
    end
    if size == 0
      return result.Ok(text.Join("", dict.Values(pieces)))
    end
    pieces[value.Len(pieces)] = text.ByteSlice(start, start + size - 1, data)
    from = start + size + 2
  end
end

defn parseResponse(raw)
  (** Reads the text of a response: an Ok of {Status, Headers, Body} (a chunked body is joined), or an Err. *)
  at = offset(blank, raw)
  firstEnd = offset(crlf, raw)
  words = text.Split(" ", if value.IsMissing(firstEnd) raw else cutAt(firstEnd, raw)[1] end)
  status = if value.Len(words) >= 2 text.Number(words[2]) else missing end
  if value.IsMissing(at) or not value.IsInt(status) or not (words[1] then text.StartsWith("HTTP/"))
    failed("This response isn't HTTP.")
  else
    cut = cutAt(at, raw)
    headers = responseHeaders(cut[1])
    rest = cutAt(4, cut[2])[2]
    size = HeaderValue("content-length", headers)
    count = if value.IsText(size) text.Number(size) else text.ByteLength(rest) end
    body = if HeaderValue("transfer-encoding", headers) == "chunked"
      unchunk(rest)
    else if not value.IsInt(count) or count < 0 or count > text.ByteLength(rest)
      failed("This response is cut short.")
    else
      result.Ok(cutAt(count, rest)[1])
    end
    result.MapOk(b -> {Status: status, Headers: headers, Body: b}, body)
  end
end

clean(s) = not (text.Contains(" ", s) or text.Contains("\r", s) or text.Contains("\n", s))

defn Fetch(url, method = "GET", body = "", headers = [], secure = missing)
  (** Asks a server: an Ok of {Status, Headers, Body}, as the server answered, or an Err when it can't be reached or its
      answer isn't HTTP. A 404 is a response, not an error: look at Status. For https, secure = tls.Client(api).

        Fetch("ftp://example.com/") then result.MapErr(it.Kind) --> result.Err("http") *)
  target = ParseUrl(url)?
  if not (clean(method) and clean(target.Host) and clean(target.Path))
    return failed("This request has a space or a line end where it can't.")
  end
  if target.Secure and value.IsMissing(secure)
    return failed("https needs secure = tls.Client(api), with api from tls.Open(): see std/tls.")
  end
  c = net.Connect(target.Host, target.Port)?
  made = if target.Secure secure(c, target.Host) else tcp(c) end
  if result.IsErr(made)
    net.Close(c)
    return made
  end
  conn = made.Value
  custom = text.Join("", list.Map(headerLine, headers))
  sized = if body == "" and method == "GET" "" else "Content-Length: $(text.ByteLength(body))$crlf" end
  message = "$method $(target.Path) HTTP/1.1$(crlf)Host: $(target.Host)$(crlf)Connection: close$crlf$sized$custom$crlf$body"
  sent = conn.Write(message)
  raw = if result.IsOk(sent) readResponse(conn, "") else sent end
  conn.Close()
  parseResponse(raw?)
end

(** An application with no route and no middleware: it answers each request with a 404.

      Handler(App())({Method: "GET", Path: "/", Query: "", Headers: [], Body: ""}).Status --> 404 *)
App() = {Routes: [], Middleware: []}

defn Route(method, pattern, handler, a)
  (** An application with a route added. The pattern may hold :name parts, which the handler finds in its params, and a final * for the rest of the path.

        files = App() then Route("PATCH", "/files/*", r -> Plain(r.Params["*"]))
        Handler(files)({Method: "PATCH", Path: "/files/a/b.txt", Query: "", Headers: [], Body: ""}).Body --> "a/b.txt" *)
  entry = {Method: method, Parts: segments(pattern), Handler: handler}
  {Routes: list.Append(entry, a.Routes), Middleware: a.Middleware}
end

(** An application with a GET route added: Handler(request) gives a response.

      hello = App() then Get("/hello/:name", r -> Plain("Hello, $(r.Params.name)!"))
      Handler(hello)({Method: "GET", Path: "/hello/Ana", Query: "", Headers: [], Body: ""}).Body --> "Hello, Ana!" *)
Get(pattern, handler, a) = Route("GET", pattern, handler, a)
(** An application with a POST route added. Another method on its path gets a 405.

      echo = App() then Post("/echo", r -> Plain(r.Body))
      Handler(echo)({Method: "POST", Path: "/echo", Query: "", Headers: [], Body: "hi"}).Body --> "hi"
      Handler(echo)({Method: "GET", Path: "/echo", Query: "", Headers: [], Body: ""}).Status --> 405 *)
Post(pattern, handler, a) = Route("POST", pattern, handler, a)
(** An application with a PUT route added.

      notes = App() then Put("/notes/:id", r -> Plain("Note $(r.Params.id): $(r.Body)"))
      Handler(notes)({Method: "PUT", Path: "/notes/7", Query: "", Headers: [], Body: "milk"}).Body --> "Note 7: milk" *)
Put(pattern, handler, a) = Route("PUT", pattern, handler, a)
(** An application with a DELETE route added.

      erase = App() then Delete("/notes/:id", r -> {Status: 204, Body: ""})
      Handler(erase)({Method: "DELETE", Path: "/notes/7", Query: "", Headers: [], Body: ""}).Status --> 204 *)
Delete(pattern, handler, a) = Route("DELETE", pattern, handler, a)
(** An application with a route added that takes any method.

      ping = App() then AnyMethod("/ping", r -> Plain(r.Method))
      Handler(ping)({Method: "OPTIONS", Path: "/ping", Query: "", Headers: [], Body: ""}).Body --> "OPTIONS" *)
AnyMethod(pattern, handler, a) = Route("*", pattern, handler, a)

(** A middleware is f(next, request), and calls next(request) to go on.

      tag(next, r) = WithHeader("x-served-by", "cesia", next(r))
      served = Handler(App() then Get("/", r -> Plain("hi")) then Wrap(tag))
      HeaderValue("x-served-by", served({Method: "GET", Path: "/", Query: "", Headers: [], Body: ""}).Headers) --> "cesia" *)
Wrap(f, a) = {Routes: a.Routes, Middleware: list.Append(f, a.Middleware)}

(** A plain text response.

      Plain("hi") --> {Status: 200, Body: "hi", Headers: [{Name: "content-type", Value: "text/plain; charset=utf-8"}]}
      Plain("Gone", status = 410).Status --> 410 *)
Plain(s, status = 200) = {Status: status, Body: s, Headers: [type("text/plain; charset=utf-8")]}
(** An HTML response.

      Html("<b>hi</b>").Headers --> [{Name: "content-type", Value: "text/html; charset=utf-8"}] *)
Html(s, status = 200) = {Status: status, Body: s, Headers: [type("text/html; charset=utf-8")]}
(** A response with the JSON text of a value.

      Json({Units: 4}).Body --> "{\"Units\":4}"
      Json({Units: 4}).Headers --> [{Name: "content-type", Value: "application/json"}] *)
Json(data, status = 200) = {Status: status, Body: json.Text(data), Headers: [type("application/json")]}
(** A response that sends the client to another URL.

      Redirect("/login") --> {Status: 302, Body: "", Headers: [{Name: "location", Value: "/login"}]} *)
Redirect(url, status = 302) = {Status: status, Body: "", Headers: [{Name: "location", Value: url}]}
(** A 404 response.

      NotFound() --> Plain("Not Found", status = 404) *)
NotFound() = Plain("Not Found", status = 404)
type(kind) = {Name: "content-type", Value: kind}

defn WithHeader(name, content, response)
  (** A response with one more header.

        WithHeader("cache-control", "no-store", Plain("hi")).Headers[2] --> {Name: "cache-control", Value: "no-store"} *)
  headers = match response
    {Headers: headers} -> headers
    else -> []
  end
  out = response
  out.Headers = list.Append({Name: name, Value: content}, headers)
  out
end

defn SetCookie(name, content, response, options = "Path=/; HttpOnly; SameSite=Lax")
  (** A response with a cookie set. Its content is URL-encoded.

        SetCookie("sid", "a b", Plain("hi")).Headers[2] --> {Name: "set-cookie", Value: "sid=a%20b; Path=/; HttpOnly; SameSite=Lax"} *)
  WithHeader("set-cookie", "$name=$(encode.UrlEncode(content)); $options", response)
end

defn cookies(headers)
  line = HeaderValue("cookie", headers)
  out = dict.Dict()
  if value.IsMissing(line)
    return out
  end
  for part in text.Split(";", line)
    pair = text.Split("=", text.Trim(part))
    if value.Len(pair) == 2
      out[pair[1]] = encode.UrlDecode(pair[2])
    end
  end
  out
end

defn matchPath(parts, path)
  (** Binds :name parts, and a final * takes what remains. The parameters, or missing if the path doesn't match. *)
  out = dict.Dict()
  n = value.Len(parts)
  for k in 1..n
    part = parts[k]
    if part == "*"
      out["*"] = text.Join("/", if k == 1 path else list.Skip(k - 1, path) end)
      return out
    end
    if k > value.Len(path)
      return missing
    end
    if text.StartsWith(":", part)
      out[text.ByteSlice(2, text.ByteLength(part), part)] = encode.UrlDecode(path[k])
    else if part != path[k]
      return missing
    end
  end
  if n == value.Len(path) out else missing end
end

defn enrich(request, params)
  {Method: request.Method, Path: request.Path, Query: encode.ParseQuery(request.Query), Params: params,
   Headers: request.Headers, Body: request.Body, Cookies: cookies(request.Headers)}
end

(** The body of a form, or of JSON.

      Form({Body: "name=Ana+Lee&units=4"}) --> {name: "Ana Lee", units: "4"} *)
Form(request) = encode.ParseQuery(request.Body)
(** The body of a request read as JSON: an Ok of the value, or an Err.

      BodyJson({Body: "{\"Units\": 4}"}) --> result.Ok({Units: 4})
      BodyJson({Body: "not json"}) then result.MapErr(it.Kind) --> result.Err("json") *)
BodyJson(request) = json.Parse(request.Body)

defn settled(reply)
  (** The response of a handler that may give a result: the value of an Ok, a 500 for an Err. *)
  match reply
    result.Ok(v) -> v
    result.Err(e) -> Plain("Internal Server Error", status = 500)
    else -> reply
  end
end

defn dispatch(a, request)
  path = segments(request.Path)
  allowed = false
  for r in a.Routes
    params = matchPath(r.Parts, path)
    if not value.IsMissing(params)
      if r.Method == "*" or r.Method == request.Method or (r.Method == "GET" and request.Method == "HEAD")
        return settled(r.Handler(enrich(request, params)))
      end
      allowed = true
    end
  end
  if allowed Plain("Method Not Allowed", status = 405) else NotFound() end
end

defn chain(a, k)
  (** Built once: a request only goes through it. *)
  if k == 0
    r -> dispatch(a, r)
  else
    next = chain(a, k - 1)
    f = a.Middleware[k]
    r -> f(next, r)
  end
end

(** The function of a request that an application is: the routes behind the middleware. Serve calls it for each request,
    and a test can call it without the network. A handler that gives an Err answers 500.

      search = Handler(App() then Get("/search", r -> Plain(r.Query["q"])))
      search({Method: "GET", Path: "/search", Query: "q=cake", Headers: [], Body: ""}).Body --> "cake"
      broken = Handler(App() then Get("/", r -> result.Err("down")))
      broken({Method: "GET", Path: "/", Query: "", Headers: [], Body: ""}).Status --> 500 *)
Handler(a) = chain(a, value.Len(a.Middleware))

defn Serve(a, port = 8080, host = "127.0.0.1", timeout = DefaultTimeout, maxBody = DefaultMaxBody, wrap = missing, listener = missing)
  (** Serves an application until a stop signal, TERM, INT or HUP: then it accepts no more, lets the requests in progress
      end, each by its deadline, with a response that tells its client that the connection closes, and gives Ok. It listens
      on port, on this machine only unless host says otherwise. timeout is the seconds a connection has for each request,
      to send it and to have it answered: a handler that takes longer gets a 503 and runs on alone. maxBody is the
      largest body read, in bytes; the bodies read at once take at most a quarter of the memory limit, and past it a
      request gets a 503 at once. wrap sits under HTTP, as TLS does: wrap = tls.Server(certificate, key,
      api)?; without it, HTTP goes on TCP alone. A listener already open, as a test opens on port 0 to learn its port with
      net.Port, takes the place of port and host.

        l = result.Unwrap(net.Listen(0))
        fiber.Spawn(() -> Serve(App() then Get("/", r -> Plain("hi")), listener = l))
        Fetch("http://localhost:$(net.Port(l))/").Value.Body --> "hi" *)
  serve(Handler(a), port, host, timeout, maxBody, wrap, listener)
end

(** An application with a WebSocket route added: onMessage(text, send) runs for each message, and send(text) answers. A
    request that isn't a WebSocket one gets a 400.

      chat = Handler(App() then Websocket("/chat", (m, send) -> send(m)))
      handshake = [{Name: "upgrade", Value: "websocket"}, {Name: "sec-websocket-key", Value: "dGhlIHNhbXBsZSBub25jZQ=="}]
      chat({Method: "GET", Path: "/chat", Query: "", Headers: handshake, Body: ""}).Status --> 101
      chat({Method: "GET", Path: "/chat", Query: "", Headers: [], Body: ""}).Status --> 400 *)
Websocket(pattern, onMessage, a, idle = ws.DefaultIdle) = Get(pattern, req -> upgrade(req.Headers, onMessage, idle), a)

defn upgrade(headers, onMessage, idle)
  (** The response that hands a WebSocket request over to std/websocket, or a 400 if it isn't one. *)
  key = HeaderValue("sec-websocket-key", headers)
  asked = HeaderValue("upgrade", headers)
  if value.IsMissing(key) or value.IsMissing(asked) or text.Lower(asked) != "websocket"
    {Status: 400, Body: "This route takes WebSocket connections."}
  else
    ws.Accept(key, onMessage, idle = idle)
  end
end

defn Logger(next, request)
  (** A middleware that writes a line of std/log for each request: its method, its path, its status, and the milliseconds
      it took.

        logged = Handler(App() then Get("/", r -> Plain("hi")) then Wrap(Logger))
        logged({Method: "GET", Path: "/nowhere", Query: "", Headers: [], Body: ""}).Status --> 404 *)
  start = sys.Now()
  response = next(request)
  ms = math.Round((sys.Now() - start) * 1000000) / 1000
  log.Info("request", {Method: request.Method, Path: request.Path, Status: response.Status, Ms: ms})
  response
end

defn Metrics(next, request)
  (** A middleware that counts each request in std/metrics: http_requests_total by method and status, and its time in
      http_request_seconds, a histogram. A route of the program shows them to Prometheus, with metrics.Text().

        counted = Handler(App() then Get("/", r -> Plain("hi")) then Wrap(Metrics))
        counted({Method: "GET", Path: "/", Query: "", Headers: [], Body: ""}).Status --> 200
        text.Contains("http_requests_total{method=\"GET\",status=\"200\"}", metrics.Text()) --> true *)
  start = sys.Now()
  response = next(request)
  metrics.Add("http_requests_total", labels = {method: request.Method, status: response.Status})
  metrics.Observe("http_request_seconds", sys.Now() - start)
  response
end

defn Cors(origin)
  (** A middleware that lets a given origin read the responses.

        shared = Handler(App() then Get("/", r -> Plain("hi")) then Wrap(Cors("https://shop.example")))
        reply = shared({Method: "GET", Path: "/", Query: "", Headers: [], Body: ""})
        HeaderValue("access-control-allow-origin", reply.Headers) --> "https://shop.example" *)
  (next, request) -> WithHeader("access-control-allow-origin", origin, next(request))
end

(* Static files under a folder. A path can't leave it. *)
types = {"html": "text/html; charset=utf-8", "css": "text/css", "js": "text/javascript", "json": "application/json",
  "png": "image/png", "jpg": "image/jpeg", "svg": "image/svg+xml", "txt": "text/plain; charset=utf-8"}

defn FileResponse(path)
  (** The response with the content of a file, typed by its extension, or a 404 if it can't be read.

        FileResponse("src/tools/site.css").Headers --> [{Name: "content-type", Value: "text/css"}]
        FileResponse("src/tools/nowhere.css").Status --> 404 *)
  parts = text.Split(".", path)
  kind = dict.GetOr(text.Lower(parts[value.Len(parts)]), "application/octet-stream", types)
  match sys.Read(path)
    result.Ok(data) -> {Status: 200, Body: data, Headers: [type(kind)]}
    else -> NotFound()
  end
end

defn Static(prefix, folder, a)
  (** An application with a route added that serves the files of a folder under a URL prefix. A path can't leave the folder.

        assets = Handler(App() then Static("/assets", "src/tools"))
        assets({Method: "GET", Path: "/assets/site.css", Query: "", Headers: [], Body: ""}).Status --> 200
        assets({Method: "GET", Path: "/assets/../tools/site.css", Query: "", Headers: [], Body: ""}).Status --> 404 *)
  serveFile(request) = static(folder, request.Params["*"])
  Get("$prefix/*", serveFile, a)
end

defn static(folder, rest)
  if ".." in text.Split("/", rest) or rest == ""
    NotFound()
  else
    FileResponse("$folder/$rest")
  end
end

(** A text, or any value as its text, with &, <, >, " and ' written as HTML writes them: for what comes from outside, in
    HTML. A template escapes its values the same way.

      Escape("<a href='x'>Tom & Jerry</a>") --> "&lt;a href=&#39;x&#39;&gt;Tom &amp; Jerry&lt;/a&gt;" *)
Escape(s) = text.Replace("'", "&#39;", text.Replace("\"", "&quot;", text.Replace(">", "&gt;", text.Replace("<", "&lt;", text.Replace("&", "&amp;", value.Text(s))))))

defn Template(source, values)
  (** The source with each {{name}} replaced by the escaped value of that name. One pass: a value that holds {{name}} isn't
      read again.

        Template("<p>Hello, {{name}}!</p>", {name: "<Ana>"}) --> "<p>Hello, &lt;Ana&gt;!</p>" *)
  parts = text.Split("{{", source)
  out = list.Fill("", value.Len(parts))
  out[1] = parts[1]
  for k in 2..value.Len(parts)
    part = parts[k]
    close = text.ByteFind("}}", 1, part)
    name = if value.IsMissing(close) missing else text.Trim(if close == 1 "" else text.ByteSlice(1, close - 1, part) end) end
    if value.IsMissing(name) or not dict.Has(name, values)
      out[k] = "{{$part"
    else
      rest = close + 2
      tail = if rest > text.ByteLength(part) "" else text.ByteSlice(rest, text.ByteLength(part), part) end
      out[k] = "$(Escape(values[name]))$tail"
    end
  end
  text.Join("", out)
end
