defn part(name, k)
  (** The k-th part of a constant's row: its value, unit or uncertainty; missing for a name not in the table. *)
  row = dict.Get(name, table)
  if value.IsMissing(row) missing else row[k] end
end

(** The value of a constant, in the units of the table: SI, else its unit says which; missing for a name not in it.
    scipy.constants.value(name), R's constants::codata. The energy of a photon of green light, 532 nm, h c / lambda in
    joules and in electronvolts:

      Value("speed of light in vacuum") --> 299792458.0
      Value("Planck constant") * Value("speed of light in vacuum") / 532e-9 --> 3.733920784114527e-19
      Value("Planck constant") * Value("speed of light in vacuum") / 532e-9 / Value("elementary charge") --> 2.3305300457368467
      Value("speed of light") --> missing *)
Value(name) = part(name, 1)

(** The unit of a constant, as the table writes it, or missing. scipy.constants.unit(name).

      Unit("Newtonian constant of gravitation") --> "m^3 kg^-1 s^-2" *)
Unit(name) = part(name, 2)

(** The standard uncertainty of a constant, in its unit: 0.0 for an exact one, or missing. scipy gives the relative one,
    scipy.constants.precision(name), Uncertainty(name) / Value(name) here.

      Uncertainty("Newtonian constant of gravitation") --> 1.5e-15
      Uncertainty("Boltzmann constant") --> 0.0 *)
Uncertainty(name) = part(name, 3)

defn Find(part)
  (** The names of the table that hold a part, whatever its case, in alphabetical order; all of them for "".
      scipy.constants.find(sub).

        Find("boltzmann") --> ["Boltzmann constant", "Boltzmann constant in Hz/K", "Boltzmann constant in eV/K", "Boltzmann constant in inverse meter per kelvin", "Stefan-Boltzmann constant"] *)
  p = text.Lower(part)
  list.Sort([k for k in dict.Keys(table) if text.Contains(p, text.Lower(k))])
end
