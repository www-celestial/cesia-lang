(** A persistent queue open at both ends. Every operation is logarithmic, and a change gives a new queue. *)
use std/dict
use std/list

Empty() = {Items: dict.Dict(), First: 1, Last: 0}   (** A queue with nothing in it. *)
(** How many elements the queue holds.

      Count(Of([1, 2])) --> 2 *)
Count(q) = q.Last - q.First + 1
(** Is this queue empty?

      IsEmpty(Empty()) --> true *)
IsEmpty(q) = Count(q) == 0

defn Push(x, q)
  (** A queue with x added at the back.

        Items(Push(2, Of([1]))) --> [1, 2] *)
  {Items: dict.Put(q.Last + 1, x, q.Items), First: q.First, Last: q.Last + 1}
end

defn PushFront(x, q)
  (** A queue with x added at the front.

        Items(PushFront(0, Of([1]))) --> [0, 1] *)
  {Items: dict.Put(q.First - 1, x, q.Items), First: q.First - 1, Last: q.Last}
end

(** The element at the front, or missing.

      First(Of([1, 2])) --> 1 *)
First(q) = dict.Get(q.First, q.Items)
(** The element at the back, or missing.

      Last(Of([1, 2])) --> 2 *)
Last(q) = dict.Get(q.Last, q.Items)

defn Pop(q)
  (** A queue without its front element.

        Items(Pop(Of([1, 2]))) --> [2] *)
  if IsEmpty(q) q else {Items: dict.Drop(q.First, q.Items), First: q.First + 1, Last: q.Last} end
end

defn PopBack(q)
  (** A queue without its back element.

        Items(PopBack(Of([1, 2]))) --> [1] *)
  if IsEmpty(q) q else {Items: dict.Drop(q.Last, q.Items), First: q.First, Last: q.Last - 1} end
end

(** The elements from front to back.

      Items(Of([1, 2])) --> [1, 2] *)
Items(q) = [q.Items[k] for k in q.First..q.Last]
(** A queue holding the elements of an array, the first one at the front. *)
Of(xs) = list.Reduce((q, x) -> Push(x, q), Empty(), xs)
