(** The prelude written in Cesia. Sequence functions: the collection comes last. *)

defn Map(f, xs)
  (** Applies f to each element, keeping the shape.

        Map(it * 2, [1, 2]) --> [2, 4] *)
  r = [f(x) for x in xs]
  if Size(xs, 1) == 1 r else Reshape(r, Size(xs, 1), Size(xs, 2)) end
end

(** The elements for which f is true.

      Filter(it > 1, [1, 2, 3]) --> [2, 3] *)
Filter(f, xs) = [x for x in xs if f(x)]

defn Reduce(f, init, xs)
  (** Folds xs with f, starting from init.

        Reduce((a, x) -> a + x, 0, [1, 2, 3]) --> 6 *)
  acc = init
  for x in xs
    acc = f(acc, x)
  end
  acc
end

defn Scan(f, init, xs)
  (** The successive results of reduce: one per element, init excluded.

        Scan((a, x) -> a + x, 0, [1, 2, 3]) --> [1, 3, 6] *)
  out = Fill(missing, Len(xs))
  acc = init
  i = 0
  for x in xs
    acc = f(acc, x)
    i += 1
    out[i] = acc
  end
  out
end

defn Range(a, b, step = 1)
  (** From a to b, by step. Integers if all three are integers, else a + k * step.

        Range(1, 10, step = 3) --> [1, 4, 7, 10]
        Range(0, 1, step = 0.25) --> [0.0, 0.25, 0.5, 0.75, 1.0] *)
  if step == 0
    Panic("range: step can't be 0.")
  end
  if Floor(a) == a and Floor(b) == b and Floor(step) == step
    n = Div(b - a, step) + 1
    [a + k * step for k in 0:n - 1]
  else
    span = (b - a) / step
    n = if span < -1e-9 0 else Floor(span + 1e-9) + 1 end
    [a + k * step for k in 0:n - 1]
  end
end

defn row(k, members, summary)
  if IsMissing(summary)
    {Key: k, Values: members}
  else
    s = summary(members)
    if IsDict(s) merge({Key: k}, s) else {Key: k, Value: s} end
  end
end

defn Group(key, xs, summary = missing)
  (** The elements grouped by key, in order of first appearance of the keys.

        Group(Mod(it, 2), [1, 2, 3]) --> [{Key: 1, Values: [1, 3]}, {Key: 0, Values: [2]}] *)
  n = Len(xs)
  keys = Fill(missing, n)
  ids = Fill(0, n)
  count = 0
  i = 0
  for x in xs
    i += 1
    k = key(x)
    g = 0
    for j in 1:count
      if Equal(keys[j], k)
        g = j
        break
      end
    end
    if g == 0
      count += 1
      keys[count] = k
      g = count
    end
    ids[i] = g
  end
  out = Fill(missing, count)
  for g in 1:count
    members = [xs[p] for p in 1:n if ids[p] == g]
    out[g] = row(keys[g], members, summary)
  end
  out
end

defn order(keys)
  (** The positions of keys, from the largest key to the smallest. Stable merge sort. *)
  n = Len(keys)
  idx = [k for k in 1:n]
  tmp = Fill(0, n)
  width = 1
  while width < n
    lo = 1
    while lo <= n
      mid = Min(lo + width, n + 1)
      hi = Min(lo + 2 * width, n + 1)
      i = lo
      j = mid
      k = lo
      while k < hi
        if i < mid and (j >= hi or not (keys[idx[j]] > keys[idx[i]]))
          tmp[k] = idx[i]
          i += 1
        else
          tmp[k] = idx[j]
          j += 1
        end
        k += 1
      end
      lo = hi
    end
    t = idx
    idx = tmp
    tmp = t
    width = 2 * width
  end
  idx
end

defn Top(n, xs, by = missing)
  (** The n largest elements, largest first, or those with the largest by.

        Top(2, [5, 1, 9, 3]) --> [9, 5] *)
  keys = if IsMissing(by) xs else [by(x) for x in xs] end
  idx = order(keys)
  m = Min(n, Len(xs))
  [xs[idx[k]] for k in 1:m]
end

(** The elements ordered by f of each.

      SortBy(Abs, [-3, 1, 2]) --> [1, 2, -3] *)
SortBy(f, xs) = [xs[i] for i in Order(Map(f, xs))]
(** How many elements f accepts.

      Count(IsOdd, [1, 2, 3]) --> 2 *)
Count(f, xs) = Len(Filter(f, xs))
(** The results of f, joined in one list.

      FlatMap(x -> [x, x], [1, 2]) --> [1, 1, 2, 2] *)
FlatMap(f, xs) = Flatten(Map(f, xs))

defn MapValues(f, d)
  (** A dictionary with f applied to each value.

        MapValues(Inc, {"a": 1})["a"] --> 2 *)
  out = Dict()
  for k in Keys(d)
    out[k] = f(d[k])
  end
  out
end

(** A successful result.

      Ok(1).Value --> 1 *)
struct Ok { Value }

(** A failed result: the error is a value, returned rather than raised.

      Err("no").Error --> "no" *)
struct Err { Error }

(** The next step of a result: f(v) for an Ok, the Err unchanged otherwise.

      Ok(2) then AndThen(x -> Ok(x + 1)) --> Ok(3)
      Err("no") then AndThen(x -> Ok(x + 1)) --> Err("no") *)
AndThen(f, r) = match r
  Ok(v) -> f(v)
  else -> r
end

(** Applies f to the value of an Ok.

      Ok(2) then MapOk(it + 1) --> Ok(3) *)
MapOk(f, r) = match r
  Ok(v) -> Ok(f(v))
  else -> r
end

(** Applies f to the error of an Err.

      Err(2) then MapErr(it + 1) --> Err(3) *)
MapErr(f, r) = match r
  Err(e) -> Err(f(e))
  else -> r
end

(** The value of an Ok, or the default.

      Err("no") then UnwrapOr(0) --> 0 *)
UnwrapOr(default, r) = match r
  Ok(v) -> v
  else -> default
end

errorText(e) = match e
  {Message: message} -> message
  else -> Text(e)
end

(** The value of an Ok. An Err is a bug here, and stops the fiber.

      Unwrap(Ok(1)) --> 1
      Unwrap(Err("no")) --> error *)
Unwrap(r) = match r
  Ok(v) -> v
  Err(e) -> Panic("unwrap on an error: $(errorText(e))")
end

(** Is this result an Ok?

      IsOk(Ok(1)) --> true *)
IsOk(r) = match r
  Ok(v) -> true
  else -> false
end

(** Is this result an Err?

      IsErr(Err(1)) --> true *)
IsErr(r) = match r
  Err(e) -> true
  else -> false
end

defn Collect(rs)
  (** An array of results as one result: Ok of all the values, or the first Err.

        Collect([Ok(1), Ok(2)]) --> Ok([1, 2])
        Collect([Ok(1), Err("a")]) --> Err("a") *)
  errors = Filter(IsErr, rs)
  if Len(errors) > 0 errors[1] else Ok(Map(it.Value, rs)) end
end

(** Like map, with one fiber per element: useful when f waits. A panic in f comes back as a panic here.

      Pmap(it * 2, [1, 2]) --> [2, 4] *)
Pmap(f, xs) = Map(Unwrap, Map(Wait, Map(x -> Spawn(() -> f(x)), xs)))

(** One more, and one less. Both work on arrays, element by element.

      Inc(1) --> 2 *)
Inc(x) = x + 1

(**   Dec(1) --> 0 *)
Dec(x) = x - 1

(** The operators as functions, to pass to reduce or map.

      Reduce(Add, 0, [1, 2, 3]) --> 6 *)
Add(a, b) = a + b

(**   Sub(5, 2) --> 3 *)
Sub(a, b) = a - b

(**   Reduce(Mul, 1, [2, 3]) --> 6 *)
Mul(a, b) = a * b

(**   IsZero(0) --> true *)
IsZero(x) = x == 0

(**   IsPos(1) --> true *)
IsPos(x) = x > 0

(**   IsNeg(1) --> false *)
IsNeg(x) = x < 0

(**   IsEven(2) --> true *)
IsEven(x) = Mod(x, 2) == 0

(**   IsOdd(2) --> false *)
IsOdd(x) = Mod(x, 2) != 0

(**   IsSome(0) --> true *)
IsSome(x) = not IsMissing(x)

(**   Identity(3) --> 3 *)
Identity(x) = x

(** A function that always gives x.

      Constantly(7)(1) --> 7 *)
Constantly(x) = y -> x

(** f after g, after h if there is one.

      Comp(Inc, it * 2)(3) --> 7 *)
Comp(f, g, h = Identity) = x -> f(g(h(x)))

(** f with its first argument given. As the collection comes last, this names a step of a pipeline.

      Partial(Add, 2)(3) --> 5 *)
Partial(f, a) = x -> f(a, x)

(**   Complement(IsEven)(3) --> true *)
Complement(f) = x -> not f(x)

defn Juxt(f, g, h = missing)
  (** The results of several functions on one value.

        Juxt(Inc, Dec)(1) --> [2, 0] *)
  if IsMissing(h) (x -> [f(x), g(x)]) else (x -> [f(x), g(x), h(x)]) end
end

(** x through up to four functions, in order.

      Pipe(1, Inc, it * 3) --> 6 *)
Pipe(x, f, g = Identity, h = Identity, k = Identity) = k(h(g(f(x))))

(**   First([1, 2]) --> 1 *)
First(xs) = if Len(xs) == 0 missing else xs[1] end

(**   Second([1, 2]) --> 2 *)
Second(xs) = if Len(xs) < 2 missing else xs[2] end

(**   Last([1, 2]) --> 2 *)
Last(xs) = if Len(xs) == 0 missing else xs[Len(xs)] end

(**   Rest([1, 2, 3]) --> [2, 3] *)
Rest(xs) = Skip(1, xs)

(**   Butlast([1, 2, 3]) --> [1, 2] *)
Butlast(xs) = Take(Max(Len(xs) - 1, 0), xs)

(**   Nth(2, [5, 6]) --> 6 *)
Nth(k, xs) = xs[k]

(**   IsEmpty([]) --> true *)
IsEmpty(xs) = Len(xs) == 0

(**   Prepend(1, [2]) --> [1, 2] *)
Prepend(x, xs) = Concat([x], xs)

(**   TakeLast(2, [1, 2, 3]) --> [2, 3] *)
TakeLast(n, xs) = Skip(Max(Len(xs) - n, 0), xs)

(**   DropLast(2, [1, 2, 3]) --> [1] *)
DropLast(n, xs) = Take(Max(Len(xs) - n, 0), xs)

defn runLength(f, xs)
  for k in 1:Len(xs)
    if not f(xs[k])
      return k - 1
    end
  end
  Len(xs)
end

(**   TakeWhile(IsOdd, [1, 3, 4, 5]) --> [1, 3] *)
TakeWhile(f, xs) = Take(runLength(f, xs), xs)

(**   DropWhile(IsOdd, [1, 3, 4, 5]) --> [4, 5] *)
DropWhile(f, xs) = Skip(runLength(f, xs), xs)

defn FindFirst(f, xs)
  (** The first element that f accepts, or missing.

        FindFirst(IsEven, [1, 2, 4]) --> 2 *)
  for x in xs
    if f(x)
      return x
    end
  end
  missing
end

(**   Remove(IsEven, [1, 2, 3]) --> [1, 3] *)
Remove(f, xs) = Filter(x -> not f(x), xs)

(** The results of f that aren't missing.

      Keep(x -> if x > 1 x * 2 else missing end, [1, 2, 3]) --> [4, 6] *)
Keep(f, xs) = Filter(IsSome, Map(f, xs))

(**   MapIndexed((k, x) -> k * x, [5, 6]) --> [5, 12] *)
MapIndexed(f, xs) = [f(k, xs[k]) for k in 1:Len(xs)]

(**   Interleave([1, 2], ["a", "b"]) --> [1, "a", 2, "b"] *)
Interleave(a, b) = Flatten([[a[k], b[k]] for k in 1:Min(Len(a), Len(b))])

(**   Interpose(0, [1, 2]) --> [1, 0, 2] *)
Interpose(sep, xs) = Flatten([if k == 1 [xs[k]] else [sep, xs[k]] end for k in 1:Len(xs)])

defn Every(f, xs)
  (** Does f accept every element? It stops at the first refusal.

        Every(IsOdd, [1, 3]) --> true *)
  for x in xs
    if not f(x)
      return false
    end
  end
  true
end

(**   Some(IsOdd, [2, 3]) --> true *)
Some(f, xs) = not Every(Complement(f), xs)

defn Iterate(f, x, n)
  (** n values: x, f(x), f(f(x)) and so on.

        Iterate(Inc, 1, 3) --> [1, 2, 3] *)
  out = Fill(x, n)
  for k in 2:n
    out[k] = f(out[k - 1])
  end
  out
end

(**   Repeatedly(() -> 5, 2) --> [5, 5] *)
Repeatedly(f, n) = [f() for k in 1:n]

defn Frequencies(xs)
  (** How many times each value appears, in a dictionary.

        Frequencies(["a", "b", "a"])["a"] --> 2 *)
  out = Dict()
  for x in xs
    out[x] = GetOr(x, 0, out) + 1
  end
  out
end

(**   MinBy(Abs, [-3, 1, 2]) --> 1 *)
MinBy(f, xs) = if Len(xs) == 0 missing else xs[Order(Map(f, xs))[1]] end

(**   MaxBy(Abs, [-3, 1, 2]) --> -3 *)
MaxBy(f, xs) = if Len(xs) == 0 missing else xs[Order(Map(f, xs))[Len(xs)]] end

(** A dictionary with f applied to the value of a key, which is missing if the key is absent.

      Update("a", Inc, {"a": 1})["a"] --> 2 *)
Update(k, f, d) = Put(k, f(Get(k, d)), d)

defn Merge(a, b)
  (** Both dictionaries. For a key in both, b wins.

        Merge({"a": 1}, {"a": 2})["a"] --> 2 *)
  out = a
  for k in Keys(b)
    out[k] = b[k]
  end
  out
end

defn MergeWith(f, a, b)
  (** Both dictionaries. For a key in both, f combines the two values.

        MergeWith(Add, {"a": 1}, {"a": 2})["a"] --> 3 *)
  out = a
  for k in Keys(b)
    out[k] = if Has(k, out) f(out[k], b[k]) else b[k] end
  end
  out
end

defn SelectKeys(ks, d)
  (**   Len(SelectKeys(["a", "z"], {"a": 1, "b": 2})) --> 1 *)
  out = Dict()
  for k in ks
    if Has(k, d)
      out[k] = d[k]
    end
  end
  out
end

(**   Zipmap(["a", "b"], [1, 2])["b"] --> 2 *)
Zipmap(ks, vs) = Dict([{Key: ks[k], Value: vs[k]} for k in 1:Min(Len(ks), Len(vs))])

defn Invert(d)
  (**   Invert({"a": 1})[1] --> "a" *)
  out = Dict()
  for k in Keys(d)
    out[d[k]] = k
  end
  out
end

defn GetIn(path, d)
  (** The value at the end of a path of keys, or missing.

        GetIn(["a", "b"], {"a": {"b": 2}}) --> 2 *)
  at = d
  for k in path
    if not IsDict(at)
      return missing
    end
    at = Get(k, at)
  end
  at
end

defn PutIn(path, value, d)
  (** A dictionary with a value at the end of a path of keys. The dictionaries on the way are created if they are absent.

        PutIn(["a", "b"], 3, Dict())["a"]["b"] --> 3 *)
  k = path[1]
  if Len(path) == 1
    return Put(k, value, d)
  end
  inner = Get(k, d)
  Put(k, PutIn(Rest(path), value, if IsDict(inner) inner else Dict() end), d)
end

(**   UpdateIn(["a"], Inc, {"a": 1})["a"] --> 2 *)
UpdateIn(path, f, d) = PutIn(path, f(GetIn(path, d)), d)
