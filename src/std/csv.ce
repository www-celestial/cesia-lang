(** CSV, as RFC 4180 writes it: quotes around a field, doubled inside. *)
use std/columns
use std/dict
use std/list
use std/result
use std/text
use std/value

(** The rows of CSV text, each as a list of texts; an Err of the kind "csv" when a quoted field never closes. A quote
    inside a field that doesn't start with one is a quote, as Python's csv reads it. The separator is one byte.

      Parse("a,b\n1,2\n") --> [["a", "b"], ["1", "2"]]
      Parse("12\" pipe,3\n") --> [["12\" pipe", "3"]] *)
Parse(s, separator = ",") = columns.Csv(s, separator)

defn Records(s, separator = ",")
  (** Each row after the first as a dictionary, by the names of the first; an Err as Parse gives one.

        Records("a,b\n1,2\n")[1]["b"] --> "2" *)
  rows = Parse(s, separator = separator)
  if result.IsErr(rows)
    return rows
  end
  if value.Len(rows) == 0
    return []
  end
  names = rows[1]
  [dict.Dict([{Key: names[k], Value: row[k]} for k in 1..list.Min(value.Len(names), value.Len(row))]) for row in list.Skip(1, rows)]
end

defn field(x, separator)
  s = value.Text(x)
  if text.Contains(separator, s) or text.Contains("\"", s) or text.Contains("\n", s) or text.Contains("\r", s)
    "\"$(text.Replace("\"", "\"\"", s))\""
  else
    s
  end
end

defn Text(rows, separator = ",")
  (** The CSV text of rows of values, quoting the fields that need it. Every row ends with a line end. The separator is
      one byte. A list of lists is written in one pass by written, a native of this package; a row of another kind is
      refused here.

        Text([["a", 1], ["b,c", 2]]) --> "a,1\n\"b,c\",2\n"
        Text([["say \"hi\"", 1.5, missing], []], separator = ";") --> "\"say \"\"hi\"\"\";1.5;missing\n\n" *)
  fast = written(rows, separator)
  if value.IsText(fast)
    return fast
  end
  lines = [text.Join(separator, [field(x, separator) for x in row]) for row in rows]
  "$(text.Join("\n", lines))\n"
end
