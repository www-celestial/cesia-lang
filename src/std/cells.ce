(** Cells in a file of code, as a notebook has them, and a session that runs them one by one. A line that holds only a
    comment starting with %%, as (* %% Simulation *), starts a cell, and its title is the rest of the comment; the lines
    before the first one are the first cell, usually the uses. A cell reads the names that cells above it define, and a
    run reruns the cells that depend on what it defines: the file means what cesia run computes. A cell of inputs, as
    name = cells.Slider(28.0, 0.0, 50.0) or zone = cells.Choice("GMT-5", ["GMT-6", "GMT-5"]), gives values that an editor
    changes by writing them in the file. *)
use std/bug
use std/cesia
use std/columns as col
use std/date
use std/debug
use std/dict
use std/fiber
use std/io
use std/json
use std/list
use std/math
use std/random
use std/result
use std/syntax
use std/sys
use std/text
use std/value as values

(* ---- Cells and the names they read and define. *)

defn marker(line)
  (** The title of a line that starts a cell, or missing for another line. *)
  t = text.Trim(line)
  n = values.Len(t)
  if n < 6 or not text.StartsWith("(*", t) or not text.EndsWith("*)", t)
    return missing
  end
  inner = text.Trim(text.Slice(3, n - 2, t))
  if not text.StartsWith("%%", inner) or text.Contains("*)", inner)
    return missing
  end
  if values.Len(inner) == 2 "" else text.Trim(text.Slice(3, values.Len(inner), inner)) end
end

(** The source of lines first to last, from 1. *)
lines(first, last, all) = if last < first "" else text.Join("\n", [all[i] for i in first..last]) end

defn Parse(source)
  (** The cells of a source, in order: each a struct with Title, From and To (its first and last lines, from 1) and Source,
      its lines, the marker with them, so that line k of Source is line From + k - 1 of the file. The first cell holds the
      lines before the first marker, and has no title; it is empty, with To = From - 1, when a marker opens the file.

        [c.Title for c in Parse("use std/io\n(* %% Data *)\nn = 3")] --> ["", "Data"]
        Parse("use std/io\n(* %% Data *)\nn = 3")[2].From --> 2
        Parse("(* %% A *)\nx = 1")[1].To --> 0 *)
  all = text.Lines(source)
  out = []
  from = 1
  title = ""
  for i in 1..values.Len(all)
    t = marker(all[i])
    if values.IsSome(t)
      if i > 1 or values.Len(out) > 0
        out = list.Append({Title: title, From: from, To: i - 1, Source: lines(from, i - 1, all)}, out)
      else
        out = [{Title: "", From: 1, To: 0, Source: ""}]
      end
      from = i
      title = t
    end
  end
  list.Append({Title: title, From: from, To: values.Len(all), Source: lines(from, values.Len(all), all)}, out)
end

(** The name of a cell in a message: its title, or "the first cell". *)
called(cells, i) = if i == 1 or cells[i].Title == "" "the cell at line $(list.Max(1, cells[i].From))" else "the cell \"$(cells[i].Title)\" (line $(cells[i].From))" end

(** An error of a cell, at a line of the file. *)
fault(line, column, message) = {Line: line, Column: column, Message: message}

defn wordLine(name, cell)
  (** The line of the file where a name first shows as a whole word in a cell, or its first line. *)
  all = text.Lines(cell.Source)
  for k in 1..values.Len(all)
    at = text.Find(name, all[k])
    if values.IsSome(at)
      before = if at == 1 " " else text.Slice(at - 1, at - 1, all[k]) end
      last = at + values.Len(name)
      after = if last > values.Len(all[k]) " " else text.Slice(last, last, all[k]) end
      if not isNameChar(before) and not isNameChar(after)
        return cell.From + k - 1
      end
    end
  end
  cell.From
end

defn isNameChar(c)
  (** Can the character be part of a name? *)
  k = text.Code(c)
  (k >= 97 and k <= 122) or (k >= 65 and k <= 90) or (k >= 48 and k <= 57) or k == 95
end

(* The kinds of definition that a cell gives to the cells below it: a method stays with its struct. *)
shared = ["function", "struct", "interface", "value", "use"]

defn scanned(cell)
  (** The definitions and reads of a cell, with their lines in the file, or the error of a cell that doesn't read. *)
  defs = cesia.Definitions(cell.Source)
  reads = cesia.Reads(cell.Source)
  if result.IsErr(defs) or result.IsErr(reads)
    e = if result.IsErr(defs) defs.Error else reads.Error end
    return {Defs: [], Reads: [], Methods: [], Error: fault(cell.From + e.Line - 1, 1, e.Message)}
  end
  at = d -> {Name: d.Name, Line: cell.From + d.Line - 1, Column: d.Column}
  {Defs: [at(d) for d in defs.Value if d.Kind in shared], Reads: [at(r) for r in reads.Value],
    Methods: [{Name: d.Name, Owner: d.Owner, Line: cell.From + d.Line - 1, Column: d.Column} for d in defs.Value if d.Kind == "method" or d.Kind == "static"],
    Structs: [d.Name for d in defs.Value if d.Kind == "struct" or d.Kind == "interface"], Error: missing}
end

defn assigned(cell, names)
  (** Those of the names that a cell gives a value to without defining them, in a loop or a block: the source with a line
      that reads them all tells which ones it doesn't read from outside. *)
  if values.Len(names) == 0
    return []
  end
  probe = cesia.Reads("$(cell.Source)\n[$(text.Join(", ", names))]")
  if result.IsErr(probe)
    return []
  end
  free = [r.Name for r in probe.Value]
  [n for n in names if not (n in free)]
end

defn package(name)
  (** Is a name that of a package of std/? *)
  "std/$name" in cesia.DocNames()
end

defn Analyse(cells)
  (** What each cell of Parse defines and reads, and its errors: a list with one struct for each cell, with Defines and
      Reads (names), Errors (each with Line and Column in the file, and Message) and Sliders. A name is defined by one cell
      only; a cell reads only names that the cells above it define; and a name no cell defines is an error where it is
      read. Sliders lists the lines name = cells.Slider(...) of a cell, through the name that the use of std/cells of the
      first cell gives, each {Name, Line, Column, End, Value, Min, Max, Step}: Column and End are the first and the last
      columns of the value's number on its line, from 1, Step is the default one when none is written; Value, Min, Max and
      Step are Ints for a slider of Ints, else Floats, as Slider gives. Inputs lists every input of a cell, a slider
      too, the lines name = cells.Slider(...), cells.Choice(...), cells.Check(...), cells.Field(...) or cells.Date(...), each
      {Name, Kind, Line, Column, End, Value}: Kind "slider", "choice", "check", "field" or "date", Column and End the first
      and the last columns of the value as the line writes it, a text with its quotes, and Value what the function gives
      under cesia run; a slider has Min, Max and Step besides, a choice Options and a check Label, a text or missing. A
      cell with an input holds only inputs, one a line, and comments, and an input takes values written in the file,
      which its function would take.

        a = Analyse(Parse("n = 3\n(* %% Twice *)\nm = n * 2"))
        a[2].Reads --> ["n"]
        a[1].Defines --> ["n"]
        Analyse(Parse("(* %% A *)\nx = y\n(* %% B *)\ny = 1"))[2].Errors[1].Line --> 2
        s = Analyse(Parse("use std/cells\n(* %% P *)\nrho = cells.Slider(28.0, 0.0, 50.0, step = 0.5)"))[2].Sliders[1]
        [s.Name, s.Line, s.Column, s.End, s.Value, s.Step] --> ["rho", 3, 20, 23, 28.0, 0.5]
        c = Analyse(Parse("use std/cells\n(* %% P *)\nzone = cells.Choice(\"GMT-5\", [\"GMT-6\", \"GMT-5\"])"))[2].Inputs[1]
        [c.Kind, c.Column, c.End, c.Value, c.Options] --> ["choice", 21, 27, "GMT-5", ["GMT-6", "GMT-5"]] *)
  n = values.Len(cells)
  scans = [scanned(c) for c in cells]
  alias = if n == 0 missing else cellsAlias(cells[1]) end
  inputs = [inputsOf(cells[i], i, alias) for i in 1..n]
  owners = {}
  for i in 1..n
    for d in scans[i].Defs
      owners = dict.Put(d.Name, list.Append(i, dict.GetOr(d.Name, [], owners)), owners)
    end
  end
  errors = [list.Concat(if values.IsMissing(scans[i].Error) [] else [scans[i].Error] end, inputs[i].Errors) for i in 1..n]
  (* R1: one cell for a name. *)
  for i in 1..n
    for d in scans[i].Defs
      others = [j for j in owners[d.Name] if j != i]
      if values.Len(others) > 0
        errors[i] = list.Append(fault(d.Line, d.Column, "\"$(d.Name)\" is defined by $(called(cells, others[1])) too: a name is defined in one cell only."), errors[i])
      end
    end
    for m in scans[i].Methods
      if not (m.Owner in scans[i].Structs) and dict.Has(m.Owner, owners)
        errors[i] = list.Append(fault(m.Line, m.Column, "The method $(m.Owner).$(m.Name) goes in the cell of its struct, $(called(cells, owners[m.Owner][1]))."), errors[i])
      end
    end
  end
  (* R2 and R3: a name read is defined above. *)
  missingAt = {}
  for i in 1..n
    for r in scans[i].Reads
      by = dict.GetOr(r.Name, [], owners)
      if values.Len(by) == 0
        missingAt = dict.Put(r.Name, list.Append({Cell: i, Read: r}, dict.GetOr(r.Name, [], missingAt)), missingAt)
      else if list.Min(by) > i
        errors[i] = list.Append(fault(r.Line, r.Column, "\"$(r.Name)\" is defined below, in $(called(cells, list.Min(by))): move that cell above this one."), errors[i])
      end
    end
  end
  (* A loop or a block of a cell that gives a value to a name another cell defines, or that a cell reads. *)
  defined = dict.Keys(owners)
  unknown = dict.Keys(missingAt)
  hidden = {}
  for i in 1..n
    if values.IsMissing(scans[i].Error)
      own = [d.Name for d in scans[i].Defs]
      for name in assigned(cells[i], [x for x in list.Concat(defined, unknown) if not (x in own)])
        if dict.Has(name, owners)
          errors[i] = list.Append(fault(wordLine(name, cells[i]), 1, "\"$name\" is defined by $(called(cells, owners[name][1])): a loop or a block here gives it a value too, which cesia run would see there. Use another name here."), errors[i])
        else if not dict.Has(name, hidden)
          hidden = dict.Put(name, i, hidden)
        end
      end
    end
  end
  for name in unknown
    for m in missingAt[name]
      message = if dict.Has(name, hidden)
        "Name \"$name\" isn't defined by a cell: $(called(cells, hidden[name])) gives it a value only in a loop or a block. Give it its value at the top of that cell to share it."
      else if package(name)
        "$name is a package of std/: write use std/$name in the first cell."
      else
        "Name \"$name\" doesn't exist."
      end
      errors[m.Cell] = list.Append(fault(m.Read.Line, m.Read.Column, message), errors[m.Cell])
    end
  end
  [{Defines: [d.Name for d in scans[i].Defs], Reads: [r.Name for r in scans[i].Reads], Errors: list.SortBy(e -> e.Line, errors[i]), Sliders: inputs[i].Sliders, Inputs: inputs[i].Inputs} for i in 1..n]
end

defn ToRun(analysis, changed)
  (** The cells to run, in file order, after cell changed ran or was edited: that one, then each cell that reads, directly
      or through other cells, a name it defines. The first cell, the uses, reruns them all.

        a = Analyse(Parse("use std/math\n(* %% A *)\nx = 1\n(* %% B *)\ny = 2\n(* %% C *)\nz = x + 1"))
        ToRun(a, 2) --> [2, 4]
        ToRun(a, 1) --> [1, 2, 3, 4] *)
  if changed == 1
    return [i for i in 1..values.Len(analysis)]
  end
  list.Prepend(changed, readers(analysis, changed, analysis[changed].Defines))
end

defn readers(analysis, from, names)
  (** The cells below cell from that read one of names, directly or through the names of other such cells, in file order. *)
  out = []
  known = names
  for j in from + 1..values.Len(analysis)
    if list.Any([r in known for r in analysis[j].Reads])
      out = list.Append(j, out)
      known = list.Concat(known, analysis[j].Defines)
    end
  end
  out
end

(* ---- Inputs: a cell of lines name = cells.Slider(value, min, max, step = s), cells.Choice(value, options),
   cells.Check(value, label = l), cells.Field(value) or cells.Date(value), whose values the file holds. An editor changes
   one by writing its new value in the file, and Set gives that value to the session, in place. *)

(** The most steps from the min to the max of a slider. *)
mostSteps = 1000000

(** The most decimals of the min, the max and the step of a slider. *)
mostDecimals = 18

(** Is x a finite number: neither NaN nor an infinity? *)
finite(x) = values.IsNumber(x) and x - x == 0

defn decimals(x)
  (** The decimals of the shortest text of a number: 2 for 0.25, 1 for 28.0, 0 for 3 and for 1e16, 7 for 1e-7. *)
  t = "$x"
  e = text.Find("e", t)
  head = if values.IsMissing(e) t else text.Slice(1, e - 1, t) end
  shift = if values.IsMissing(e) 0 else text.Number(text.Slice(e + 1, values.Len(t), t)) end
  dot = text.Find(".", head)
  list.Max(0, (if values.IsMissing(dot) 0 else values.Len(head) - dot end) - shift)
end

(** Does a slider give Ints: are its value, its min, its max and its step, when one is written, all Ints? *)
whole(at, min, max, step) = values.IsInt(at) and values.IsInt(min) and values.IsInt(max) and (values.IsMissing(step) or values.IsInt(step))

defn stepOf(at, min, max, step)
  (** The step of a slider: the one written, else 1 for a slider of Ints, else (max - min) / 100 with two decimals more than
      min and max have, so that 0.0 to 0.7 steps by 0.007 and not by 0.006999999999999999. *)
  if values.IsSome(step)
    step
  else if whole(at, min, max, step)
    1
  else
    s = text.Number(text.Decimals(list.Max(decimals(min), decimals(max)) + 2, (max - min) / 100))
    if s > 0 s else (max - min) / 100 end
  end
end

defn stepCount(min, max, step)
  (** The number of steps from min to max: the last position is the largest one at most max, as an HTML range input has it.
      Exact for Ints; for Floats a quotient a hair below a whole number counts it, as 0.7 / 0.007 is 99.99999999999999, and
      Snap steps back from that position when its text is past max. *)
  if values.IsInt(min) and values.IsInt(max) and values.IsInt(step) math.Div(max - min, step) else math.Div(math.Floor((max - min) / step + 1e-9), 1) end
end

defn sliderFault(at, min, max, step)
  (** What is wrong with the numbers of a slider, or missing: one text for the panic of Slider and the error of Analyse. *)
  if not (finite(at) and finite(min) and finite(max) and (values.IsMissing(step) or finite(step)))
    return "cells.Slider takes finite numbers."
  end
  if not (min < max)
    return "cells.Slider needs its min below its max: $min is not below $max."
  end
  if at < min or at > max
    return "cells.Slider needs its value from its min to its max: $at is not in $min to $max."
  end
  (* The text of a position has the decimals of min and of the step, at most 20 in text.Decimals, and the default step two
     more than min and max: 18 at most each. *)
  for x in list.Concat([min, max], if values.IsMissing(step) [] else [step] end)
    if decimals(x) > mostDecimals
      return "cells.Slider takes numbers of at most $mostDecimals decimals: $x has $(decimals(x))."
    end
  end
  (* max - min of two Ints fits in 63 bits, and of Floats is finite: the steps are counted from it. *)
  ints = values.IsInt(min) and values.IsInt(max)
  if (ints and min < 0 and max > 4611686018427387903 + min) or (not ints and not finite(1.0 * max - 1.0 * min))
    return "cells.Slider needs max - min to fit in a number: $min to $max is too wide."
  end
  s = stepOf(at, min, max, step)
  if not (s > 0) or s > max - min
    return "cells.Slider needs a step above 0 and at most its max - min, $(max - min): $s is not."
  end
  if (max - min) / s > mostSteps + 1e-9
    return "cells.Slider has at most $mostSteps steps: $min to $max by $s makes more."
  end
  missing
end

defn Slider(value, min, max, step = missing)
  (** A number that an editor moves, for a notebook: gives value, as an Int when value, min, max and the step written are
      Ints, else as a Float. Written in a cell of sliders only, one a line, with numbers written there, as
      rho = cells.Slider(28.0, 0.0, 50.0, step = 0.5): Cemacs draws a slider under the line, and a move writes the new
      number in the file, so that cesia run reads it. The step goes from min to max; it is (max - min) / 100 when none is
      written, or 1 when value, min and max are Ints. Panics on numbers that aren't finite, a min not below the max, a
      value out of them, a min, a max or a step of more than 18 decimals, a max - min too wide for a number, a step not
      above 0 or past max - min, or more than 10^6 steps: Analyse says the same of the file.

        Slider(28.0, 0.0, 50.0, step = 0.5) --> 28.0
        Slider(3, 0, 10) --> 3
        Slider(3, 0, 10, step = 0.5) --> 3.0 *)
  fault = sliderFault(value, min, max, step)
  if values.IsSome(fault)
    bug.Panic(fault)
  end
  if whole(value, min, max, step) value else value * 1.0 end
end

(** The most options of a choice. *)
mostOptions = 1000

(** Is a value a text or a finite number, as a choice and a field hold? *)
plain(x) = values.IsText(x) or finite(x)

defn choiceFault(at, options)
  (** What is wrong with the value and the options of a choice, or missing: one text for the panic of Choice and the error
      of Analyse. *)
  if not values.IsArray(options)
    return "cells.Choice takes a list of texts or finite numbers as its options."
  end
  if values.Len(options) > mostOptions
    return "cells.Choice takes at most $mostOptions options: $(values.Len(options)) given."
  end
  if not list.All([plain(o) for o in options])
    return "cells.Choice takes a list of texts or finite numbers as its options."
  end
  if not plain(at) or not (at in options)
    return "cells.Choice needs its value among its options: $(literalOf(at)) is not."
  end
  missing
end

defn Choice(value, options)
  (** A value chosen among options, for a notebook: gives value, one of options, texts or finite numbers, at most 1,000.
      Written in a cell of inputs only, one a line, with values written there, as
      zone = cells.Choice("GMT-5", ["GMT-6", "GMT-5", "GMT-4"]): Cemacs draws a box under the line that opens the list, and
      a choice writes the new value in the file, so that cesia run reads it. Panics on options that are no list of texts
      and finite numbers, on more than 1,000 of them, or on a value not among them: Analyse says the same of the file.

        Choice(2026, [2025, 2026, 2027]) --> 2026
        Choice("GMT-5", ["GMT-6", "GMT-5", "GMT-4"]) --> "GMT-5" *)
  fault = choiceFault(value, options)
  if values.IsSome(fault)
    bug.Panic(fault)
  end
  value
end

defn checkFault(at, label)
  (** What is wrong with the value and the label of a check box, or missing, for Check and Analyse. *)
  if not values.IsBool(at)
    "cells.Check takes true or false as its value, not $(literalOf(at))."
  else if values.IsSome(label) and not values.IsText(label)
    "cells.Check takes a text as its label, not $(literalOf(label))."
  else
    missing
  end
end

defn Check(value, label = missing)
  (** A check box, for a notebook: gives value, true or false. Written in a cell of inputs only, one a line, as
      bold = cells.Check(false, label = "Bold line"): Cemacs draws the box under the line, [ ] or [x] and the label, and a
      click or Space writes the other value in the file, so that cesia run reads it. Panics on a value that is no true or
      false, or a label that is no text: Analyse says the same of the file.

        Check(false, label = "Bold line") --> false *)
  fault = checkFault(value, label)
  if values.IsSome(fault)
    bug.Panic(fault)
  end
  value
end

(** What is wrong with the value of a field, or missing, for Field and Analyse. *)
fieldFault(at) = if plain(at) missing else "cells.Field takes a text or a finite number, not $(literalOf(at))." end

defn Field(value)
  (** A text or a number typed in a box, for a notebook: gives value, as written, a text, an Int or a Float. Written in a
      cell of inputs only, one a line, as place = cells.Field("40.76, -73.984") or high = cells.Field(50): Cemacs draws
      the box under the line, and what is typed there is written in the file at Enter, so that cesia run reads it; a
      field of a number takes only numbers. Panics on a value that is no text or finite number: Analyse says the same of
      the file.

        Field("40.76, -73.984") --> "40.76, -73.984"
        Field(50) --> 50 *)
  fault = fieldFault(value)
  if values.IsSome(fault)
    bug.Panic(fault)
  end
  value
end

defn dayOf(y, m, d)
  (** The date of std/date of a day, at midnight in UTC, or missing for numbers that are no day of the years 0 to 9999,
      which "YYYY-MM-DD" writes. *)
  if not (values.IsInt(y) and values.IsInt(m) and values.IsInt(d)) or y < 0 or y > 9999 or m < 1 or m > 12 or d < 1 or d > date.DaysInMonth(y, m)
    return missing
  end
  date.Date(y, m, d)
end

defn dayIn(t)
  (** The date of a text written YYYY-MM-DD, as "2026-11-23", or missing. *)
  if not values.IsText(t) or values.Len(t) != 10 or text.Slice(5, 5, t) != "-" or text.Slice(8, 8, t) != "-"
    return missing
  end
  parts = [text.Slice(1, 4, t), text.Slice(6, 7, t), text.Slice(9, 10, t)]
  if not list.All([list.All([digit(c) for c in text.Chars(p)]) for p in parts])
    return missing
  end
  dayOf(text.Number(parts[1]), text.Number(parts[2]), text.Number(parts[3]))
end

(** What is wrong with the value of a date, or missing, for Date and Analyse. *)
dateFault(at) = if values.IsSome(dayIn(at)) missing else "cells.Date takes a day written YYYY-MM-DD, as \"2026-11-23\": $(literalOf(at)) is none." end

defn Date(value)
  (** A day, for a notebook: gives the date of std/date of a text written YYYY-MM-DD, at midnight in UTC. Written in a cell
      of inputs only, one a line, as day = cells.Date("2026-11-23"): Cemacs draws the box under the line, whose arrows
      change the year, the month or the day, and Enter writes the new day in the file, so that cesia run reads it.
      Panics on a text that is no day of the years 0 to 9999: Analyse says the same of the file.

        Date("2026-11-23").Day --> 23 *)
  fault = dateFault(value)
  if values.IsSome(fault)
    bug.Panic(fault)
  end
  dayIn(value)
end

(** Is a value a date of std/date? *)
isDate(x) = values.IsStruct(x) and not values.IsDict(x) and dict.Has("Year", dict.Fields(x)) and dict.Has("Month", dict.Fields(x)) and dict.Has("Day", dict.Fields(x))

defn literalOf(x)
  (** A value as a file of Cesia writes it, which reads back as the same value and never as code: a text in quotes, its \,
      its ", its ends of line, tabs and carriage returns written \\, \", \n, \t and \r and its $ written $$; a number, true
      or false as Cesia writes them; a date of std/date as its day in quotes, "2026-11-23"; anything else as its text. *)
  if values.IsText(x)
    t = text.Replace("\\", "\\\\", x)
    for pair in [["\"", "\\\""], ["\n", "\\n"], ["\t", "\\t"], ["\r", "\\r"], ["$$", "$$$$"]]
      t = text.Replace(pair[1], pair[2], t)
    end
    "\"$t\""
  else if isDate(x)
    "\"$(date.FormatDate(x))\""
  else
    values.Text(x, 80)
  end
end

(** The kind of an input of Analyse: a slider of Sliders, or of a hand, has none. *)
kindOf(input) = if values.IsDict(input) dict.GetOr("Kind", "slider", input) else "slider" end

defn optionAt(choice, x)
  (** The place of x among the options of a choice, or of its value when x is none of them. *)
  at = list.FindFirst(k -> choice.Options[k] == x, 1..values.Len(choice.Options))
  if values.IsSome(at) at else list.FindFirst(k -> choice.Options[k] == choice.Value, 1..values.Len(choice.Options)) end
end

defn Snap(slider, x, steps = 0)
  (** The position of an input of Analyse nearest to x, then steps further: {Value, Text}, Text as the file writes it and
      Value what cesia run reads from that text. For a slider, within its min and its max, a position is Min + k × Step
      for a whole k, computed and never added up, and its text has the decimals of Min and of Step, so that steps of 0.1
      write 0.3 and not 0.30000000000000004. For a choice, the option x, or the value when x is no option, then steps
      options further, within the first and the last; for a date, the day of x, a date of std/date, then steps days
      further, within the years 0 to 9999; for a check box, true or false, and for a field, a text or a number as the
      field holds, x itself. A text is written as literalOf writes it, in quotes, so that the file never reads it as code.
      An editor changes an input with it, and Set gives the value it gives with it. Panics on an x of another kind than
      the input's: Set says so in an Err.

        s = {Value: 0.0, Min: 0.0, Max: 1.0, Step: 0.1}
        Snap(s, 0.31).Text --> "0.3"
        Snap(s, 0.31, steps = 1).Value --> 0.4
        Snap(s, 0.31, steps = -10).Text --> "0.0"
        Snap({Value: 5, Min: 0, Max: 10, Step: 3}, 10).Text --> "9"
        Snap({Kind: "choice", Value: "b", Options: ["a", "b", "c"]}, "b", steps = 1).Text --> "\"c\""
        Snap({Kind: "field", Value: "x"}, "say \"$$(hi)\"").Text --> "\"say \\\"$$$$(hi)\\\"\"" *)
  kind = kindOf(slider)
  if kind != "slider"
    wrong = if kind == "choice" missing else valueFault(slider, x) end
    if values.IsSome(wrong)
      bug.Panic(wrong)
    end
    at = if kind == "choice"
      slider.Options[list.Max(1, list.Min(values.Len(slider.Options), optionAt(slider, x) + steps))]
    else if kind == "date"
      d = date.AddDays(steps, dayOf(x.Year, x.Month, x.Day))
      if d.Year > 9999 date.Date(9999, 12, 31) else if d.Year < 0 date.Date(0, 1, 1) else d end
    else
      x
    end
    return {Value: at, Text: literalOf(at)}
  end
  ints = whole(slider.Value, slider.Min, slider.Max, slider.Step)
  (* A slider of Floats counts in Floats: an Int min and a Float max may be farther apart than 63 bits hold. *)
  float = n -> if ints n else 1.0 * n end
  min = float(slider.Min)
  max = float(slider.Max)
  step = float(slider.Step)
  last = stepCount(min, max, step)
  near = math.Div(math.Round((list.Max(min, list.Min(max, float(x))) - min) / step), 1)
  k = list.Max(0, list.Min(last, near + steps))
  if ints
    at = min + k * step
    return {Value: at, Text: "$at"}
  end
  p = position(min, step, k)
  if p.Value > max and k > 0 position(min, step, k - 1) else p end
end

defn position(min, step, k)
  (** The position k of a slider of Floats, min + k × step, {Value, Text}: its text has the decimals of min and of step. *)
  t = text.Decimals(list.Max(1, list.Max(decimals(min), decimals(step))), min + k * step)
  (* A position next to 0 can round to -0.0, which the file needn't say. *)
  t = if text.StartsWith("-", t) and text.Number(t) == 0 text.Slice(2, values.Len(t), t) else t end
  {Value: text.Number(t), Text: t}
end

defn cellsAlias(first)
  (** The name that the use of std/cells of the first cell gives, or missing: cells, or the name after as. *)
  for line in text.Lines(first.Source)
    words = text.Split(" ", text.Trim(line))
    if values.Len(words) >= 2 and words[1] == "use" and words[2] == "std/cells"
      return if values.Len(words) == 4 and words[3] == "as" words[4] else "cells" end
    end
  end
  missing
end

defn codeOnly(lines, texts = true)
  (** The lines of a cell with their comments and their texts made spaces, each character in its column: only code is read
      for inputs, and an input named in a comment or in a text is none. With texts false, the texts stay, and only the
      comments are made spaces. *)
  depth = 0
  quoted = false
  out = []
  for line in lines
    cs = text.Chars(line)
    n = values.Len(cs)
    kept = []
    i = 1
    while i <= n
      c = cs[i]
      two = if i < n "$c$(cs[i + 1])" else c end
      if depth > 0 or (not quoted and two == "(*")
        depth = if two == "(*" depth + 1 else if two == "*)" depth - 1 else depth end
        wide = if two == "(*" or two == "*)" 2 else 1 end
        kept = list.Concat(kept, if wide == 2 ["  "] else [" "] end)
        i += wide
      else if quoted
        quoted = c != "\""
        kept = list.Append(if texts (if c == "\\" and i < n "  " else " " end) else if c == "\\" and i < n "$c$(cs[i + 1])" else c end, kept)
        i += if c == "\\" 2 else 1 end
      else
        quoted = c == "\""
        kept = list.Append(if quoted and texts " " else c end, kept)
        i += 1
      end
    end
    out = list.Append(text.Join("", kept), out)
  end
  out
end

(** Can the character start a name, or go on with one? *)
nameStart(c) = (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_"
nameChar(c) = nameStart(c) or (c >= "0" and c <= "9")   (** Can the character go on with a name? *)
digit(c) = c >= "0" and c <= "9"   (** Is the character a digit? *)

defn after(cs, i, test)
  (** The first place from i whose character fails test, or the place after the last one. *)
  j = i
  while j <= values.Len(cs) and test(cs[j])
    j += 1
  end
  j
end

(** The place of the first character from i that isn't a space. *)
spaced(cs, i) = after(cs, i, c -> c == " " or c == "\t")

defn numberEnd(cs, i)
  (** The place after a number written from i, possibly negative, as 28, -0.5 or 1e-3, or i when none starts there. *)
  j = if i <= values.Len(cs) and cs[i] == "-" i + 1 else i end
  k = after(cs, j, digit)
  if k == j
    return i
  end
  if k < values.Len(cs) and cs[k] == "." and digit(cs[k + 1])
    k = after(cs, k + 1, digit)
  end
  if k <= values.Len(cs) and (cs[k] == "e" or cs[k] == "E")
    e = if k < values.Len(cs) and (cs[k + 1] == "+" or cs[k + 1] == "-") k + 2 else k + 1 end
    if e <= values.Len(cs) and digit(cs[e])
      k = after(cs, e, digit)
    end
  end
  if k <= values.Len(cs) and (nameChar(cs[k]) or cs[k] == ".") i else k end
end

(** Does a character go on with a name, as Cesia reads one: a letter, a digit, _ or any character past ASCII? *)
wordChar(c) = nameChar(c) or text.Code(c) >= 128

(** The escapes of a text, by the character after its \. *)
escapes = {"n": "\n", "t": "\t", "r": "\r", "\\": "\\", "\"": "\""}

defn textAt(cs, i)
  (** The text written from place i of the characters of a line, as Cesia reads it, and the place after it: {Value, Next},
      or missing when no text starts there or it is more than a text written, with $name or $(...) in it, or doubled
      quotes, which Cesia refuses. *)
  n = values.Len(cs)
  if i > n or cs[i] != "\""
    return missing
  end
  out = []
  j = i + 1
  while j <= n
    c = cs[j]
    next = if j < n cs[j + 1] else "" end
    if c == "\\" and dict.Has(next, escapes)
      out = list.Append(escapes[next], out)
      j += 2
    else if c == "$" and next == "$"
      out = list.Append("$", out)
      j += 2
    else if c == "$" and next != "" and (next == "(" or nameStart(next) or text.Code(next) >= 128)
      return missing
    else if c == "\""
      return if next == "\"" missing else {Value: text.Join("", out), Next: j + 1} end
    else
      out = list.Append(c, out)
      j += 1
    end
  end
  missing
end

defn wordAt(cs, i, word)
  (** Is word written from place i, as a whole word? *)
  last = i + values.Len(word) - 1
  last <= values.Len(cs) and text.Join("", cs[i..last]) == word and (last == values.Len(cs) or not (wordChar(cs[last + 1]) or cs[last + 1] == "."))
end

defn valueAt(cs, i, lists = true)
  (** The value written from place i of the characters of a line and the place after it, {Value, Next}, or missing: a
      number, possibly negative, true, false, a text as textAt reads it, or with lists a list of those. *)
  n = values.Len(cs)
  if i > n
    return missing
  end
  e = numberEnd(cs, i)
  if e > i
    return {Value: text.Number(text.Join("", cs[i..e - 1])), Next: e}
  end
  for word in ["true", "false"]
    if wordAt(cs, i, word)
      return {Value: word == "true", Next: i + values.Len(word)}
    end
  end
  if cs[i] == "\""
    return textAt(cs, i)
  end
  if not lists or cs[i] != "["
    return missing
  end
  items = []
  j = spaced(cs, i + 1)
  while j <= n and cs[j] != "]"
    v = valueAt(cs, j, lists = false)
    if values.IsMissing(v)
      return missing
    end
    items = list.Append(v.Value, items)
    j = spaced(cs, v.Next)
    if j <= n and cs[j] == ","
      j = spaced(cs, j + 1)
    else if j > n or cs[j] != "]"
      return missing
    end
  end
  if j > n missing else {Value: items, Next: j + 1} end
end

(** The parameters of the function of each input, in order. *)
paramsOf = {Slider: ["value", "min", "max", "step"], Choice: ["value", "options"], Check: ["value", "label"], Field: ["value"], Date: ["value"]}

(** The parameters that a call of the function of each input must give. *)
neededOf = {Slider: ["value", "min", "max"], Choice: ["value", "options"], Check: ["value"], Field: ["value"], Date: ["value"]}

(** The error of an input whose arguments are no values written in the file. *)
unwritten(f) = if f == "Slider" "cells.Slider takes numbers written in the file, not expressions." else "cells.$f takes values written in the file, not expressions." end

defn headIn(code, alias)
  (** The first input function named in a line of code, alias.Slider, alias.Choice, alias.Check, alias.Field or alias.Date
      as a whole name, {Function, Column}, or missing. *)
  for f in dict.Keys(paramsOf)
    head = "$alias.$f"
    at = text.Find(head, code)
    if values.IsSome(at)
      after = at + values.Len(head)
      if after > values.Len(code) or not wordChar(text.Slice(after, after, code))
        return {Function: f, Column: at}
      end
    end
  end
  missing
end

defn inputCall(line, alias)
  (** The input of a line name = alias.F(...), F the function of an input, as a cell of inputs writes one: {Name, Function,
      Column, Args}, each argument {Key, Text, Value, Column, End}, its Key "" when it has no name; {Fault, Column,
      Function} for such a line whose arguments are no values written there, numbers for a slider; missing for another
      line. The line has its comments made spaces, and its texts as written. *)
  cs = text.Chars(line)
  n = values.Len(cs)
  first = spaced(cs, 1)
  i = after(cs, first, nameChar)
  if i == first or not nameStart(cs[first])
    return missing
  end
  name = text.Join("", cs[first..i - 1])
  i = spaced(cs, i)
  if i > n or cs[i] != "=" or (i < n and cs[i + 1] == "=")
    return missing
  end
  i = spaced(cs, i + 1)
  call = i
  dot = i + values.Len(alias)
  if dot >= n or text.Join("", cs[i..dot]) != "$alias."
    return missing
  end
  e = after(cs, dot + 1, nameChar)
  f = text.Join("", cs[dot + 1..e - 1])
  if not dict.Has(f, paramsOf) or (e <= n and wordChar(cs[e]))
    return missing
  end
  i = spaced(cs, e)
  bad = at -> {Fault: unwritten(f), Column: at, Function: f}
  if i > n or cs[i] != "("
    return bad(call)
  end
  args = []
  i = spaced(cs, i + 1)
  while i <= n and cs[i] != ")"
    key = ""
    j = after(cs, i, nameChar)
    if j > i and nameStart(cs[i]) and not wordAt(cs, i, "true") and not wordAt(cs, i, "false")
      k = spaced(cs, j)
      if k > n or cs[k] != "=" or (k < n and cs[k + 1] == "=")
        return bad(i)
      end
      key = text.Join("", cs[i..j - 1])
      i = spaced(cs, k + 1)
    end
    (* A slider takes numbers only, as it always did. *)
    v = if f == "Slider" (if numberEnd(cs, i) > i valueAt(cs, i) else missing end) else valueAt(cs, i) end
    if values.IsMissing(v)
      return bad(i)
    end
    args = list.Append({Key: key, Text: text.Join("", cs[i..v.Next - 1]), Value: v.Value, Column: i, End: v.Next - 1}, args)
    i = spaced(cs, v.Next)
    if i <= n and cs[i] == ","
      i = spaced(cs, i + 1)
    else if i > n or cs[i] != ")"
      return bad(i)
    end
  end
  if i > n or spaced(cs, i + 1) <= n
    return bad(list.Min(i, n))
  end
  {Name: name, Function: f, Column: call, Args: args}
end

defn argsOf(f, args)
  (** The arguments of an input's call by their parameters, as a call gives them: in order, then by name; or missing when
      a call would give them otherwise, or lacks one it needs. *)
  params = paramsOf[f]
  got = {}
  for k in 1..values.Len(args)
    a = args[k]
    p = if a.Key == "" (if k <= values.Len(params) and values.Len(got) == k - 1 params[k] else "" end) else a.Key end
    if not (p in params) or dict.Has(p, got)
      return missing
    end
    got = dict.Put(p, a, got)
  end
  if list.All([dict.Has(p, got) for p in neededOf[f]]) got else missing end
end

defn inputOf(c, line)
  (** The input of a call of inputCall on a line, {Input, Slider} with Slider missing for another kind, or {Error, Column}
      for one whose arguments its function would refuse. *)
  got = argsOf(c.Function, c.Args)
  if values.IsMissing(got)
    return {Error: unwritten(c.Function), Column: if values.Len(c.Args) > 0 c.Args[1].Column else c.Column end}
  end
  v = p -> if dict.Has(p, got) got[p].Value else missing end
  at = got["value"]
  base = {Name: c.Name, Kind: text.Lower(c.Function), Line: line, Column: at.Column, End: at.End}
  if c.Function == "Slider"
    problem = sliderFault(v("value"), v("min"), v("max"), v("step"))
    if values.IsSome(problem)
      return {Error: problem, Column: at.Column}
    end
    (* A slider of Floats is Floats, as Slider gives: its Value may be written 3, and its Min an Int far from a Float Max. *)
    float = x -> if whole(v("value"), v("min"), v("max"), v("step")) x else 1.0 * x end
    s = {Name: c.Name, Line: line, Column: at.Column, End: at.End, Value: float(v("value")), Min: float(v("min")), Max: float(v("max")),
      Step: float(stepOf(v("value"), v("min"), v("max"), v("step")))}
    return {Input: dict.Merge(base, {Value: s.Value, Min: s.Min, Max: s.Max, Step: s.Step}), Slider: s}
  end
  problem = if c.Function == "Choice" choiceFault(v("value"), v("options")) else if c.Function == "Check" checkFault(v("value"), v("label")) else if c.Function == "Field" fieldFault(v("value")) else dateFault(v("value")) end
  if values.IsSome(problem)
    return {Error: problem, Column: at.Column}
  end
  more = if c.Function == "Choice" {Options: v("options")} else if c.Function == "Check" {Label: v("label")} else if c.Function == "Date" {Value: dayIn(v("value"))} else {} end
  {Input: dict.Merge(dict.Put("Value", v("value"), base), more), Slider: missing}
end

defn inputsOf(cell, i, alias)
  (** The inputs of a cell, {Inputs, Sliders, Errors}: its lines name = cells.F(...) through alias, and the errors of R4 (a
      cell with an input holds only inputs and comments), of R5 (values written in the file) and of their values. A cell
      whose inputs are all sliders says so in the words it always used. *)
  none = {Inputs: [], Sliders: [], Errors: []}
  if values.IsMissing(alias) or not list.Any([text.Contains("$alias.$f", cell.Source) for f in dict.Keys(paramsOf)])
    return none
  end
  raw = text.Lines(cell.Source)
  code = codeOnly(raw)
  if i == 1
    for k in 1..values.Len(code)
      h = headIn(code[k], alias)
      if values.IsSome(h)
        what = if h.Function == "Slider" "Sliders" else "Inputs" end
        return {Inputs: [], Sliders: [], Errors: [fault(cell.From + k - 1, h.Column, "$what go in a cell below the uses, as (* %% Parameters *) starts one.")]}
      end
    end
    return none
  end
  flat = codeOnly(raw, texts = false)
  out = []
  sliders = []
  errors = []
  others = []
  functions = []
  for k in 1..values.Len(code)
    line = cell.From + k - 1
    h = headIn(code[k], alias)
    c = if values.IsMissing(h) missing else inputCall(flat[k], alias) end
    if values.IsMissing(c) and values.IsSome(h)
      c = {Fault: unwritten(h.Function), Column: h.Column, Function: h.Function}
    end
    if values.IsMissing(c)
      if text.Trim(code[k]) != ""
        others = list.Append({Line: line, Column: spaced(text.Chars(code[k]), 1)}, others)
      end
    else
      functions = list.Append(c.Function, functions)
      made = if dict.Has("Fault", c) {Error: c.Fault, Column: c.Column} else inputOf(c, line) end
      twin = list.FindFirst(x -> x.Name == dict.GetOr("Name", "", c), out)
      if dict.Has("Error", made)
        errors = list.Append(fault(line, made.Column, made.Error), errors)
      else if values.IsSome(twin)
        what = if twin.Kind == "slider" and c.Function == "Slider" "a slider" else "an input" end
        errors = list.Append(fault(line, 1, "\"$(c.Name)\" is $what of this cell already."), errors)
      else
        out = list.Append(made.Input, out)
        sliders = if values.IsSome(made.Slider) list.Append(made.Slider, sliders) else sliders end
      end
    end
  end
  (* A cell that names an input only in a comment or a text has none. *)
  if values.Len(functions) == 0
    return none
  end
  rule = if list.All([f == "Slider" for f in functions]) "A cell with a slider holds only sliders" else "A cell with an input holds only inputs" end
  {Inputs: out, Sliders: sliders, Errors: list.Concat(errors, [fault(o.Line, o.Column, "$rule: move line $(o.Line) to a cell below.") for o in others])}
end

defn sliderNamed(analysis, name)
  (** The slider of a name in an analysis and its cell, {Slider, Cell}, or missing. *)
  for i in 1..values.Len(analysis)
    for s in analysis[i].Sliders
      if s.Name == name
        return {Slider: s, Cell: i}
      end
    end
  end
  missing
end

defn inputNamed(analysis, name)
  (** The input of a name in an analysis and its cell, {Input, Cell}, or missing. *)
  for i in 1..values.Len(analysis)
    for s in dict.GetOr("Inputs", [], analysis[i])
      if s.Name == name
        return {Input: s, Cell: i}
      end
    end
  end
  missing
end

defn valueFault(input, x)
  (** What is wrong with a value for an input of Analyse other than a slider, as Analyse would say of it, or missing. *)
  kind = kindOf(input)
  name = dict.GetOr("Name", "", input)
  if kind == "choice"
    choiceFault(x, input.Options)
  else if kind == "check"
    checkFault(x, missing)
  else if kind == "date"
    if isDate(x) and values.IsSome(dayOf(x.Year, x.Month, x.Day)) missing else "The date $name takes a date of std/date, a day of the years 0 to 9999, not $(literalOf(x))." end
  else if values.IsText(input.Value)
    if values.IsText(x) missing else "The field $name takes a text, not $(literalOf(x))." end
  else
    if finite(x) missing else "The field $name takes a finite number, not $(literalOf(x))." end
  end
end

(* ---- A session: a Cesia process that runs the cells of one file, beside the program that asks. *)

(** The byte that starts a message of the session, on a line of its output. *)
mark = text.Char(1)

(** The start of the first line of a session, before its token. *)
told = "$(mark)token "

defn lastMark(line)
  (** The place of the last mark of a line, or missing: a message is the end of its line, and its JSON writes the byte 1
      as \u0001, so a mark that a cell printed before it, with no end of line, is never taken for it. *)
  at = text.ByteFind(mark, 1, line)
  next = at
  while values.IsSome(next)
    at = next
    next = text.ByteFind(mark, at + 1, line)
  end
  at
end

defn heard(line, token, inbox, control)
  (** Puts a line of the session where it goes, what a cell printed, an answer to a run, or another answer, and gives the
      token to read the next line with: false before the first line. That line, which no cell can print, since none has
      run, tells the token of the session, random, which each of its messages then holds: a line whose message lacks it
      is what a cell printed, as data that holds the byte 1 and JSON, and shows as it is. A session of an older std/cells
      tells none, and its messages are taken as they come. The mark is one byte: the answer after it is cut by bytes, as
      long as a scene. *)
  if values.IsBool(token)
    if text.StartsWith(told, line)
      return text.ByteSlice(text.ByteLength(told) + 1, text.ByteLength(line), line)
    end
    token = missing
  end
  at = lastMark(line)
  m = if values.IsMissing(at) result.Err(missing) else json.Parse(text.ByteSlice(at + 1, text.ByteLength(line), line)) end
  if result.IsErr(m) or not values.IsDict(m.Value) or not values.IsText(dict.GetOr("Kind", missing, m.Value)) or (values.IsSome(token) and dict.GetOr("Mark", missing, m.Value) != token)
    fiber.Send({Kind: "output", Text: line}, inbox)
    return token
  end
  if at > 1
    fiber.Send({Kind: "output", Text: text.ByteSlice(1, at - 1, line)}, inbox)
  end
  fiber.Send(m.Value, if m.Value.Kind == "answer" or m.Value.Kind == "shown" inbox else control end)
  token
end

defn reading(p, inbox, control, alive)
  (** Reads what the session writes, line by line, until its output closes. A line longer than a chunk, as a scene, keeps
      its pieces until its end comes, and is joined once: each byte is read once. *)
  partial = []
  token = false
  chunk = sys.ReadOutput(p)
  while result.IsOk(chunk) and chunk.Value != ""
    pieces = text.Split("\n", chunk.Value)
    if values.Len(pieces) == 1
      partial = list.Append(pieces[1], partial)
    else
      token = heard(text.Join("", list.Append(pieces[1], partial)), token, inbox, control)
      for k in 2..values.Len(pieces) - 1
        token = heard(pieces[k], token, inbox, control)
      end
      partial = [pieces[values.Len(pieces)]]
    end
    chunk = sys.ReadOutput(p)
  end
  if text.Join("", partial) != ""
    heard(text.Join("", partial), token, inbox, control)
  end
  code = sys.WaitExit(p)
  fiber.Close(alive)
  fiber.Send({Kind: "ended", Code: code}, inbox)
  fiber.Send({Kind: "ended", Code: code}, control)
end

defn Session(path, allow = [])
  (** Starts a session on a file: an Ok of the session, or an Err. It is a Cesia process of this binary, cesia run --cells,
      that runs none of the file: Run gives it one cell at a time, at the file level, as the prompt of cesia run --repl
      runs code, with the permissions of allow, as --allow takes them, and none else. What a cell prints is its output,
      even a line of data that looks like a message of the session: each message holds a token that the session draws at
      random as it starts. Needs the exec permission of this cesia, cesia.Binary(). *)
  args = ["run", "--cells"]
  if values.Len(allow) > 0
    args = list.Concat(args, ["--allow", text.Join(",", allow)])
  end
  p = sys.Start(cesia.Binary(), args = list.Append(path, args))?
  inbox = fiber.Channel()
  control = fiber.Channel()
  alive = fiber.Channel()
  _ = fiber.Spawn(() -> reading(p, inbox, control, alive))
  result.Ok({Path: path, Allow: allow, Process: p, Inbox: inbox, Control: control, Alive: alive, Restarted: false})
end

(** Has the session ended? Its reader closes Alive when its output closes. *)
ended(session) = fiber.Receive(session.Alive, timeout = 0).Error.Kind == "closed"

defn ask(session, command)
  (** Writes a command for the session, or gives the Err of a session that ended. *)
  gone = result.Err({Kind: "cells", Message: "The session of $(session.Path) has ended."})
  if ended(session) or result.IsErr(sys.WriteInput(session.Process, "$(json.Text(command))\n")) gone else result.Ok(missing) end
end

defn answered(session, timeout = missing)
  (** The next answer of the session of a kind other than a run's, or an Err when it ended or didn't answer in time. *)
  m = fiber.Receive(session.Control, timeout = timeout)
  if result.IsErr(m)
    return result.Err({Kind: "cells", Message: "The session of $(session.Path) didn't answer."})
  end
  if m.Value.Kind == "ended" result.Err({Kind: "cells", Message: "The session of $(session.Path) has ended."}) else result.Ok(m.Value) end
end

defn Run(session, cell, width = 640)
  (** Runs a cell of Parse in the session, and waits for it: an Ok of a struct with Output (the lines it printed), Value
      (what its last expression shows, or missing), Shown (what Show showed, in order, each {After, Value}: After the
      count of the lines of Output printed before it, Value as Value is, but a graph that can't be drawn, which is a
      Value of Kind "error" with Text), Error (missing, or a struct with Line, the line of the file or missing
      when the error is elsewhere, and Text, the error as cesia run shows it) and Seconds (the time it ran). A Value is a
      struct with Kind: "graph", a graph of std/plot, with Scene (plot.Scene at width pixels, or the graph's own width when it is less, as high as the shape of its own size asks: plot.Scene with its height missing) and Key, which
      Scene draws again at another width, for an animation of plot.Frames, Frames and Fps, and Scene its first frame,
      and for a 3D graph View, [az, el], the view of its code; "text", and Text; "table", a frame, a list of maps or structs, a row
      for each, its columns the keys of the first, or a struct of at most 20 fields as a row of field and value for each, an Ok
      of a struct as that struct, with Columns, Rows (the first 20, as texts), Count and Key, which Rows reads again a
      screen at a time; or "array", with Shape and Rows (the first 10 by 10, as texts), and for a matrix Key too. Before it runs, the names it defines are forgotten. A
      cell whose From is 0 is code typed at a prompt, which no line of the file holds: its errors name <prompt>, and a
      name it gives a value that holds one already keeps it until the code gives it another, in its place: x = x + 1 reads
      the x before, an error leaves it as it was then, and the functions defined before read the new value. An Err when
      the session has ended. *)
  runWith(session, cell, width, false)
end

defn runWith(session, cell, width, svg)
  (** Run, with the SVG of a graph in place of its scene for svg, as Html wants it. *)
  ask(session, {Do: "run", Code: cell.Source, Line: list.Max(0, cell.From), Path: session.Path, Width: width, Svg: svg})?
  output = []
  parts = []
  while true
    m = fiber.Receive(session.Inbox)
    if result.IsErr(m) or m.Value.Kind == "ended"
      return result.Err({Kind: "cells", Message: "The session of $(session.Path) has ended.", Output: output})
    end
    if m.Value.Kind == "output"
      output = list.Append(m.Value.Text, output)
    else if m.Value.Kind == "shown"
      parts = list.Append({After: values.Len(output), Value: m.Value.Value}, parts)
    else
      a = m.Value
      return result.Ok({Output: output, Value: dict.Get("Value", a), Shown: parts, Error: dict.Get("Error", a), Seconds: a.Seconds})
    end
  end
end

defn Forget(session, names)
  (** Removes names from the session, with their values: those of a cell that was deleted, whose readers must not see
      them any more. An Ok, or an Err when the session has ended. *)
  ask(session, {Do: "forget", Names: names})?
  answered(session)?
  result.Ok(missing)
end

defn Variables(session)
  (** The names that the cells run in the session define, in an Ok: a list of structs with Name, Type (as "Int",
      "Float", "Text", "Array", "Frame", "Dict", "Function" or the name of a struct), Size (the shape of an array or a frame
      as "rows × columns", the length of a text or a dictionary, or "") and Preview (the start of its text, at most 80
      characters, or the columns of a frame). Large values stay in the session: only these texts come. *)
  ask(session, {Do: "variables"})?
  result.Ok(answered(session)?.Rows)
end

defn Rows(session, name, first, last, sort = missing, filter = missing, find = missing)
  (** Rows first to last, from 1, of a table of the session, as texts, in an Ok of a struct with Columns (the names of a
      frame's columns, the keys of the first of a list of maps or structs, the numbers of a matrix's columns, "1" for a
      list, or "field" and "value" for a struct), Rows, Count, the number of rows it shows, Total, the number of rows of
      the value, and Positions, the place of each row given in the value, from 1: a viewer reads a large value a screen
      at a time, and a frame never crosses whole. The table is the value of a name, or the Key of a table that Run
      showed, which the session keeps with the last 64 graphs. sort, {Column, Descending}, orders the rows by a column
      of Columns, increasing, or decreasing with Descending true: numbers as numbers, then texts by their bytes, then the
      other values by their text, NaN and missing last whichever the way, equal values in their order. filter, a text,
      keeps the rows that hold each of its words, apart at spaces, in one cell or another: the text of a cell as the
      table shows it, in which a word is found as it is, its ASCII letters in either case, never read as a pattern;
      Count then says how many. Both are done in the session, which keeps the order for the next ask of the same table:
      a screen after the first costs its rows. find, a position of the value, gives Found too: where its row stands in
      this order, from 1, or missing when the filter leaves it out. An ask gives at most 1,000 rows, fewer for a table of
      more than 20 columns, at most 20,000 cells, and at most 256 columns; a cell is cut at 200 characters. An Err for a
      name that holds no table, or a sort or a filter it doesn't take. *)
  command = {Do: "rows", Name: name, First: first, Last: last}
  if values.IsSome(sort)
    command.Sort = sort
  end
  if values.IsSome(filter)
    command.Filter = filter
  end
  if values.IsSome(find)
    command.Find = find
  end
  ask(session, command)?
  got = answered(session)?
  if dict.Has("Error", got)
    return result.Err({Kind: "cells", Message: got.Error})
  end
  out = {Columns: got.Columns, Rows: got.Rows, Count: got.Count, Total: dict.GetOr("Total", got.Count, got), Positions: dict.GetOr("Positions", [], got)}
  result.Ok(if values.IsSome(find) dict.Put("Found", dict.Get("Found", got), out) else out end)
end

defn Scene(session, key, width, frame = 1, view = missing, mark = missing, xlim = missing, ylim = missing, points = false)
  (** The scene of a graph that a run of the session showed, by its Key, drawn again at another width, at most its own,
      and the height of its own shape, as Run draws it:
      for a pane that changed its width, for another frame of an animation, frame from 1, or for a 3D graph turned to
      view, [az, el] in degrees, as Cemacs turns it when it is dragged; mark, [i, n], rings the point i of each layer of
      n points, as row i of a table of n rows, and gives the Points of those layers, as plot.Scene does; xlim and ylim
      draw it with other ranges than its own, as Cemacs zooms it, and points = true gives the Points of all its layers and
      its Axes, as plot.Scene does. plot.Scene draws
      it in the session, one at a time, so that an animation never crosses whole and a surface crosses as the places of
      its points on the screen. The session keeps the last 64 graphs and tables that its runs showed; an Err for an older one, for a frame the graph doesn't have, for a
      view of a graph that is no 3D graph, for a mark that is no [i, n], or for ranges that plot.Scene refuses. *)
  command = {Do: "scene", Key: key, Width: width, Frame: frame, View: view}
  if values.IsSome(mark)
    command.Mark = mark
  end
  if values.IsSome(xlim)
    command.Xlim = xlim
  end
  if values.IsSome(ylim)
    command.Ylim = ylim
  end
  if points == true
    command.Points = true
  end
  ask(session, command)?
  got = answered(session)?
  if dict.Has("Error", got) result.Err({Kind: "cells", Message: got.Error}) else result.Ok(got.Scene) end
end

defn Svg(session, key)
  (** The SVG of a graph that a run of the session showed, by its Key, as plot.Svg writes it at the graph's own size and
      ranges, in an Ok: the text that plot.Save would write, which Cemacs saves beside the file of the cells. An Err for a
      graph the session no longer keeps, as Scene gives. *)
  ask(session, {Do: "svg", Key: key, Width: 0})?
  got = answered(session)?
  if dict.Has("Error", got) result.Err({Kind: "cells", Message: got.Error}) else result.Ok(got.Svg) end
end

defn Set(session, analysis, name, value)
  (** Gives the input of a name in an analysis a value, in the session, in place: the name keeps its place, so that a
      function of another cell that reads it sees the new value at once, and never a name without a value. A slider takes
      a finite number, snapped to its step as Snap does, within its min and its max; a choice one of its options; a check
      box true or false; a field a text, or a finite number when the file writes a number there; a date a date of
      std/date, of which it keeps the day. An Ok of {Value, ToRun, Text}: Value what is set, as cesia run reads it from
      Text, the value as the file writes it, Snap(input, value).Text, and ToRun the cells that read the name, directly
      or through other cells, in file order, without the cell of the input, which holds nothing else. An Err for a name
      that is no input of the analysis, a value the input doesn't take, a session that has no value for the name yet (its
      cell runs first: ToRun(analysis, cell) gives the cells), or a session that has ended. An editor writes Text in the
      file first, in place of the old value, so that the file says what the session holds. *)
  found = sliderNamed(analysis, name)
  if values.IsSome(found)
    s = found.Slider
    if not finite(value)
      return result.Err({Kind: "cells", Message: "A slider takes a finite number, not $value."})
    end
    if value < s.Min or value > s.Max
      return result.Err({Kind: "cells", Message: "$value is out of the slider $name, from $(s.Min) to $(s.Max)."})
    end
    at = Snap(s, value)
    ask(session, {Do: "set", Name: name, Text: at.Text})?
  else
    found = inputNamed(analysis, name)
    if values.IsMissing(found)
      return result.Err({Kind: "cells", Message: "\"$name\" is no input of the cells."})
    end
    wrong = valueFault(found.Input, value)
    if values.IsSome(wrong)
      return result.Err({Kind: "cells", Message: wrong})
    end
    at = Snap(found.Input, value)
    ask(session, {Do: "set", Name: name, Kind: found.Input.Kind, Text: at.Text})?
  end
  got = answered(session)?
  if dict.Has("Error", got)
    return result.Err({Kind: "cells", Message: got.Error})
  end
  result.Ok({Value: at.Value, ToRun: readers(analysis, found.Cell, [name]), Text: at.Text})
end

defn Stop(session)
  (** Stops the cell that runs, whose Run then gives the error "Stopped.": the session and the names defined before stay,
      in an Ok of the session. A session that doesn't answer within 2 seconds, as a cell in a long native computation,
      is ended and a new one starts: the Ok then has Restarted true, and the cells must run again from the top. *)
  ask(session, {Do: "stop"})?
  if result.IsOk(answered(session, timeout = 2.0))
    return result.Ok(session)
  end
  sys.Stop(session.Process)
  fresh = Session(session.Path, allow = session.Allow)?
  fresh.Restarted = true
  result.Ok(fresh)
end

defn close(session)
  (** Ends a session: it sees the end of its input. *)
  _ = sys.CloseInput(session.Process)
end

(* ---- The page of a file: each cell, its code colored and what it gave, in one HTML file that needs nothing else. *)

(** A text made safe for HTML. *)
escape(t) = text.Replace("\"", "&quot;", text.Replace(">", "&gt;", text.Replace("<", "&lt;", text.Replace("&", "&amp;", t))))

(* The class of each role of std/syntax, as the docs site colors code. *)
classes = ["k", "n", "s", "m", "c", "", "f"]

defn colored(code)
  (** Cesia code as HTML, each word in a span of its role. *)
  state = syntax.FirstState
  out = []
  for line in text.Lines(code)
    r = syntax.Tokens(line, state)
    state = r.State
    out = list.Append(text.Join("", [if t[1] == syntax.Plain escape(t[2]) else "<span class=\"$(classes[t[1]])\">$(escape(t[2]))</span>" end for t in r.Tokens]), out)
  end
  text.Join("\n", out)
end

(** Is the text of a cell a number, as a table shows one: 12, -0.833, 1e-7, nan or inf? *)
isNumberText(t) = values.IsSome(text.Number(t)) or t in ["nan", "inf", "-inf"]

(** The part of the text of a number from its decimal point, or "" for one without. *)
fractionOf(t) = (at -> if values.IsMissing(at) "" else text.ByteSlice(at, text.ByteLength(t), t) end)(text.ByteFind(".", 1, t))

defn tableHtml(columns, rows)
  (** A table in HTML, its header the columns, or none when there are none: each text escaped, a number on the right
      of its cell, its decimal point under those of its column, as figure spaces as wide as a digit fill the fraction
      of the shorter ones, and a text on the left; the header of a column of numbers on the right too. *)
  n = list.Max([values.Len(r) for r in list.Prepend(columns, rows)])
  wide = [list.Max(list.Prepend(0, [text.ByteLength(fractionOf(r[j])) for r in rows if j <= values.Len(r) and isNumberText(r[j])])) for j in 1..n]
  numeric = [list.All([j > values.Len(r) or r[j] == "" or isNumberText(r[j]) for r in rows]) and values.Len(rows) > 0 for j in 1..n]
  cell = (t, j) -> if isNumberText(t) "<td class=\"n\">$(escape(t))$(text.Repeat(wide[j] - text.ByteLength(fractionOf(t)), "&#8199;"))</td>" else "<td>$(escape(t))</td>" end
  head = if values.Len(columns) == 0 "" else "<thead><tr>$(text.Join("", [if numeric[j] "<th class=\"n\">$(escape(columns[j]))</th>" else "<th>$(escape(columns[j]))</th>" end for j in 1..values.Len(columns)]))</tr></thead>\n" end
  body = text.Join("", ["<tr>$(text.Join("", [cell(r[j], j) for j in 1..values.Len(r)]))</tr>\n" for r in rows])
  "<table$(if values.Len(columns) == 0 " class=\"array\"" else "" end)>\n$(head)<tbody>\n$(body)</tbody>\n</table>\n"
end

(** The tags of an SVG as std/plot writes it, as the browser reads them, in small letters. *)
svgTags = ["svg", "g", "path", "rect", "circle", "clippath", "defs", "text", "title", "style"]

defn plotTag(tag)
  (** Is the text of a tag, from after its < to before its >, one that std/plot writes: one of svgTags, each value of its
      attributes in double quotes, out of them no ' that would quote otherwise, and no name that starts with on, which
      runs a script? A browser ends a name at a space, a tab, an end of line or a /. *)
  if text.StartsWith("/", tag)
    return text.Lower(text.ByteSlice(2, text.ByteLength(tag), tag)) in svgTags
  end
  parts = text.Split("\"", tag)
  if math.Mod(values.Len(parts), 2) == 0
    return false
  end
  outside = text.Lower(text.Join(" ", [parts[j] for j in list.Range(1, values.Len(parts), step = 2)]))
  for c in ["\t", "\n", "\r", "\f", "/"]
    outside = text.Replace(c, " ", outside)
  end
  words = text.Split(" ", outside)
  not text.Contains("'", outside) and not text.Contains(" on", outside) and words[1] in svgTags
end

defn plotSvg(svg)
  (** Is a text an SVG as std/plot writes it: from <svg, each tag as plotTag takes it, and no javascript: address? Html
      puts it in its page as it is, so that its animations play there: another one, as a message forged by what a cell
      printed, could run a script. *)
  if not values.IsText(svg) or not text.StartsWith("<svg ", svg) or text.Contains("javascript:", text.Lower(svg))
    return false
  end
  pieces = text.Split("<", svg)
  for k in 2..values.Len(pieces)
    close = text.ByteFind(">", 1, pieces[k])
    if values.IsMissing(close) or not plotTag(text.ByteSlice(1, close - 1, pieces[k]))
      return false
    end
  end
  true
end

defn valueHtml(v, i)
  (** What a value of a cell shows, in HTML, i naming it among the values of the page. An animation starts paused on its first frame, under a box Play that runs
      and stops it, by CSS alone: the box is a check box of the page, before the SVG, focused by Tab and checked by Space. *)
  if values.IsMissing(v)
    ""
  else if v.Kind == "table"
    more = if v.Count > values.Len(v.Rows) "<p class=\"count\">$(values.Len(v.Rows)) of $(v.Count) rows</p>\n" else "<p class=\"count\">$(v.Count) rows</p>\n" end
    "$(tableHtml(v.Columns, v.Rows))$more"
  else if v.Kind == "graph" and not plotSvg(dict.GetOr("Svg", missing, v))
    "<pre class=\"value\">A graph whose SVG is not one std/plot writes: left out.</pre>\n"
  else if v.Kind == "graph" and dict.Has("Frames", v)
    "<div class=\"graph anim\"><input type=\"checkbox\" class=\"play\" id=\"play$i\"><label for=\"play$i\">Play</label>\n$(v.Svg)</div>\n"
  else if v.Kind == "graph"
    "<div class=\"graph\">$(v.Svg)</div>\n"
  else if v.Kind == "array"
    "<p class=\"count\">$(text.Join(" × ", ["$k" for k in v.Shape]))</p>\n$(tableHtml([], v.Rows))"
  else
    "<pre class=\"value\">$(escape(v.Text))</pre>\n"
  end
end

style = ":root { --page: #ffffff; --code: #f7f8fa; --ink: #1e1f22; --muted: #6c707e; --edge: #dfe1e5; --bad: #c4314b;
  --k: #0033b3; --n: #00627a; --s: #067d17; --m: #1750eb; --c: #707070; --f: #871094; --p: #080808; color-scheme: light; }
@media (prefers-color-scheme: dark) { :root { --page: #0e1013; --code: #1c1e22; --ink: #dadde2; --muted: #8d929a; --edge: #2b2e34;
  --bad: #f2667c; --k: #cf8e6d; --n: #56a8f5; --s: #6aab73; --m: #2aacb8; --c: #8a8e95; --f: #c77dbb; --p: #bcbec4; color-scheme: dark; } }
body { margin: 0; background: var(--page); color: var(--ink); font: 16px/1.6 system-ui, -apple-system, \"Segoe UI\", sans-serif; }
main { max-width: 960px; margin: 0 auto; padding: 24px 16px; }
pre, code, table { font-family: ui-monospace, \"SF Mono\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace; font-size: 14px; }
pre { background: var(--code); padding: 12px 16px; border-radius: 6px; overflow-x: auto; line-height: 1.45; margin: 0 0 8px; }
pre code { color: var(--p); }
section { margin: 0 0 28px; }
h2 { font-size: 18px; margin: 0 0 8px; }
pre.output, pre.value { background: none; border-left: 3px solid var(--edge); border-radius: 0; }
pre.error { background: none; border-left: 3px solid var(--bad); border-radius: 0; color: var(--bad); }
table { border-collapse: collapse; margin: 0 0 8px; display: block; overflow-x: auto; width: max-content; max-width: 100%; border: 1px solid var(--ink); }
th, td { padding: 2px 8px; text-align: left; white-space: pre; }
th + th, td + td { border-left: 1px solid var(--edge); } tbody tr + tr td { border-top: 1px solid var(--edge); }
th { font-weight: 700; border-bottom: 1px solid var(--ink); } th.n, td.n { text-align: right; }
.count { color: var(--muted); font-size: 14px; margin: 0 0 8px; }
.graph { margin: 0 0 8px; overflow-x: auto; } .graph svg { max-width: 100%; height: auto; }
.anim label { font-size: 14px; color: var(--muted); } .anim svg { display: block; margin-top: 4px; }
.anim .f { animation-play-state: paused; } .anim .play:checked ~ svg .f { animation-play-state: running; }
.slider { margin: 0 0 8px; font-family: ui-monospace, \"SF Mono\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace; font-size: 14px; }
.slider input { vertical-align: middle; width: 240px; max-width: 50%; } .slider .value { color: var(--muted); }
.input { margin: 0 0 8px; font-family: ui-monospace, \"SF Mono\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace; font-size: 14px; }
.input input, .input select { font: inherit; color: var(--ink); background: var(--page); border: 1px solid var(--ink); border-radius: 0; padding: 1px 6px; opacity: 1; }
.input input[type=text] { width: 240px; max-width: 60%; } .input input[type=checkbox] { accent-color: var(--ink); vertical-align: middle; }
.k { color: var(--k); } .n { color: var(--n); } .s { color: var(--s); } .m { color: var(--m); }
.c { color: var(--c); font-style: italic; } .f { color: var(--f); }
"

defn sliderHtml(s)
  (** A slider of a cell in the page, as it stands in the file: its name, a range that doesn't move, without a script to
      run again what reads it, and its value. *)
  number = x -> escape("$x")
  text.Str("<p class=\"slider\"><label>", escape(s.Name), " <input type=\"range\" min=\"", number(s.Min), "\" max=\"", number(s.Max),
    "\" step=\"", number(s.Step), "\" value=\"", number(s.Value), "\" disabled></label> <span class=\"value\">", number(s.Value), "</span></p>\n")
end

defn printedHtml(ran, i)
  (** What cell i printed and what it showed with Show, in their order, in HTML. *)
  out = []
  from = 1
  j = 0
  for part in dict.GetOr("Shown", [], ran)
    j += 1
    if part.After >= from
      out = list.Append("<pre class=\"output\">$(escape(text.Join("\n", ran.Output[from..part.After])))</pre>\n", out)
      from = part.After + 1
    end
    out = list.Append(if part.Value.Kind == "error" "<pre class=\"error\">$(escape(part.Value.Text))</pre>\n" else valueHtml(part.Value, "$i-$j") end, out)
  end
  if from <= values.Len(ran.Output)
    out = list.Append("<pre class=\"output\">$(escape(text.Join("\n", ran.Output[from..values.Len(ran.Output)])))</pre>\n", out)
  end
  out
end

defn inputHtml(x)
  (** An input of a cell in the page, other than a slider, as it stands in the file: its name and its value in a box that
      doesn't change, a list of its one value for a choice, a check box and its label, or its name, for a check, a text
      box for a field and a date box for a date; the page has no session, and nothing there runs again what reads it. Each text is escaped,
      and the ends of line of a field's text too, so that the box stays on its line of HTML. *)
  name = escape(x.Name)
  box = if x.Kind == "choice"
    "<select disabled><option selected>$(escape("$(x.Value)"))</option></select>"
  else if x.Kind == "check"
    label = if values.IsText(dict.GetOr("Label", missing, x)) escape(x.Label) else name end
    return text.Str("<p class=\"input\"><label><input type=\"checkbox\"", if x.Value " checked" else "" end, " disabled> ", label, "</label></p>\n")
  else if x.Kind == "date"
    "<input type=\"date\" value=\"$(date.FormatDate(x.Value))\" disabled>"
  else
    "<input type=\"text\" value=\"$(text.Replace("\r", "&#13;", text.Replace("\n", "&#10;", escape("$(x.Value)"))))\" disabled>"
  end
  text.Str("<p class=\"input\"><label>", name, " ", box, "</label></p>\n")
end

defn cellHtml(cell, i, errors, ran, inputs)
  (** Cell i of the page: its title, its code, then its errors, or its inputs, what it printed and its value. *)
  title = if cell.Title == "" "" else "<h2>$(escape(cell.Title))</h2>\n" end
  body = text.Join("\n", list.DropWhile(l -> values.IsSome(marker(l)), text.Lines(cell.Source)))
  code = if text.Trim(body) == "" "" else "<pre><code class=\"cesia\">$(colored(body))</code></pre>\n" end
  out = [code]
  if values.Len(errors) > 0
    out = list.Append("<pre class=\"error\">$(escape(text.Join("\n", ["line $(e.Line): $(e.Message)" for e in errors])))</pre>\n", out)
  else if values.IsSome(ran)
    out = list.Concat(out, [if kindOf(x) == "slider" sliderHtml(x) else inputHtml(x) end for x in inputs])
    out = list.Concat(out, printedHtml(ran, i))
    out = list.Append(if values.IsSome(ran.Error) "<pre class=\"error\">$(escape(ran.Error.Text))</pre>\n" else valueHtml(ran.Value, "$i") end, out)
  end
  if title == "" and text.Join("", out) == "" "" else "<section>\n$title$(text.Join("", out))</section>\n" end
end

defn Html(path, allow = [])
  (** Runs every cell of a file in a new session, from the top, and gives the page of the file in an Ok: one HTML text
      that needs no other file and no script, with each cell's title, its code colored, what it printed, its value (a
      graph as its SVG, an animation paused under a box Play, a table, an array or a text) or its error. What it shows is what cesia run computes, not the state of an editor. The
      session has the permissions of allow, as Session. Needs the read permission of the file. *)
  cells = Parse(sys.Read(path)?)
  analysis = Analyse(cells)
  session = Session(path, allow = allow)?
  parts = []
  for i in 1..values.Len(cells)
    errors = analysis[i].Errors
    ran = missing
    if values.Len(errors) == 0 and text.Trim(cells[i].Source) != ""
      r = runWith(session, cells[i], 640, true)
      if result.IsErr(r)
        return r
      end
      ran = r.Value
    end
    parts = list.Append(cellHtml(cells[i], i, errors, ran, analysis[i].Inputs), parts)
  end
  close(session)
  name = list.Last(text.Split("/", path))
  result.Ok(text.Str("<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n",
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>", escape(name), "</title>\n<style>\n", style,
    "</style>\n</head>\n<body>\n<main>\n<h1>", escape(name), "</h1>\n", text.Join("", parts), "</main>\n</body>\n</html>\n"))
end

(* ---- The side of the session: cesia run --cells starts serve, which reads one command a line. *)

defn send(token, message)
  (** Writes a message for the program that asked, on one line that starts with the byte 1, with the token of the
      session in its Mark. *)
  io.Print("$mark$(json.Text(dict.Put("Mark", token, message)))")
end

defn brief(x, n)
  (** value.Text(x, n), but a matrix of more than 1000 values shows its size. *)
  if values.IsArray(x) and values.Len(x) > 1000 and not (values.Len(values.Size(x)) == 2 and values.Size(x)[1] == 1)
    return values.Text("array of size $(text.Join(" × ", ["$d" for d in values.Size(x)]))", n)
  end
  values.Text(x, n)
end

(** Is this value a frame of std/frame? *)
isFrame(v) = values.IsDict(v) and values.Len(v) == 2 and dict.Has("Names", v) and dict.Has("Columns", v) and values.IsArray(v.Names)

defn drawn(v, width, svg, frame = 1, view = missing, mark = missing, xlim = missing, ylim = missing, points = false)
  (** The scene of a struct that is a graph of std/plot, its frame of an animation, its view of a 3D graph, its mark, its
      ranges and its points, or its SVG with svg, in an Ok; an Err of its message for a graph that can't be drawn; missing
      for a struct that is no graph. std/plot loads here, in the session, the first time: a program that only reads cells
      never pays for it. *)
  f = evalCell(if svg "use std/plot\nplot.Svg" else "use std/plot\nplot.Scene" end, 0)
  if result.IsErr(f)
    return missing
  end
  (* The scene keeps the shape of the graph's own size, at the width of the pane or its own when that is less. The
     options of a view that is asked are given only then: a project's own copy of std/plot from before them still draws. *)
  plain = values.IsMissing(mark) and values.IsMissing(xlim) and values.IsMissing(ylim) and points != true
  r = if svg f.Value(v) else if plain f.Value(v, list.Max(100, width), missing, frame = frame, view = view) else f.Value(v, list.Max(100, width), missing, frame = frame, view = view, mark = mark, xlim = xlim, ylim = ylim, points = points) end
  if result.IsErr(r) and text.Contains("needs a graph", r.Error.Message)
    return missing
  end
  r
end

defn graphShown(v, width, svg, key)
  (** What a graph shows, or missing for a struct that is no graph: its scene and its key, or its SVG with svg, and for an
      animation its count of frames and their rate, read from the scene of its first frame, and for a 3D graph its view. *)
  scene = drawn(v, width, false)
  if values.IsMissing(scene)
    return missing
  end
  if svg
    (* The SVG is drawn at the graph's own size, where a scene of this width may have no room: only the SVG says. *)
    page = drawn(v, width, true)
    if result.IsErr(page)
      return {Kind: "error", Text: page.Error.Message}
    end
    out = {Kind: "graph", Svg: page.Value}
    return if result.IsOk(scene) and dict.Has("Frames", scene.Value) dict.Merge(out, {Frames: scene.Value.Frames, Fps: scene.Value.Fps}) else out end
  end
  if result.IsErr(scene)
    return {Kind: "error", Text: scene.Error.Message}
  end
  out = {Kind: "graph", Key: key, Scene: scene.Value}
  if dict.Has("View", scene.Value)
    return dict.Put("View", scene.Value.View, out)
  end
  if dict.Has("Frames", scene.Value) dict.Merge(out, {Frames: scene.Value.Frames, Fps: scene.Value.Fps}) else out end
end

defn shown(v, width = 640, svg = false, key = 0)
  (** What a cell's value shows, as texts that JSON carries. *)
  (* A graph's fields are all private (std/plot): a struct with a public field is none, and isn't sent to plot. *)
  g = if values.IsStruct(v) and values.Len(dict.Fields(v)) == 0 graphShown(v, width, svg, key) else missing end
  if values.IsSome(g)
    return g
  end
  if values.IsMissing(v)
    missing
  else if values.IsStruct(v) and result.IsOk(v) and values.IsStruct(v.Value)
    (* An Ok of a struct, as stats.TTest gives, shows the struct. *)
    shown(v.Value, width = width, svg = svg, key = key)
  else if values.IsStruct(v) and values.Len(dict.Fields(v)) <= 20
    (* A struct of at most 20 fields: a table of its fields and their values, one row each. *)
    fs = dict.Fields(v)
    {Kind: "table", Columns: ["field", "value"], Rows: [[k, brief(fs[k], 80)] for k in dict.Keys(fs)], Count: values.Len(fs), Key: key}
  else if isFrame(v) or isRecords(v)
    t = tableOf(v)
    {Kind: "table", Columns: t.Columns, Rows: [[values.Text(cellOf(t, i, j), 80) for j in 1..values.Len(t.Columns)] for i in 1..list.Min(20, t.Count)], Count: t.Count, Key: key}
  else if values.IsArray(v) and values.Len(values.Size(v)) == 2
    shape = values.Size(v)
    if shape[1] == 1
      {Kind: "array", Shape: shape, Rows: [[values.Text(v[j], 80) for j in 1..list.Min(10, shape[2])]]}
    else
      {Kind: "array", Shape: shape, Rows: [[values.Text(v[i, j], 80) for j in 1..list.Min(10, shape[2])] for i in 1..list.Min(10, shape[1])], Key: key}
    end
  else
    {Kind: "text", Text: brief(v, 20000)}
  end
end

defn errorLine(path, e)
  (** The line of the file where an error of a cell is, from the place that starts its text, or missing. *)
  first = text.Lines(e)[1]
  if not text.StartsWith("$path:", first)
    return missing
  end
  text.Number(text.Split(":", text.Slice(values.Len(path) + 2, values.Len(first), first))[1])
end

(* The run of a cell in the session, for Show in the cell's code: {Width, Svg, Key, Count, Kept, Token}, Count the values
   shown so far, Kept a channel of those that have a Key, graphs and tables, {Key, Value}, and Token that of the messages
   of the session.
   A channel of one holds it, so that Show reads and changes it; it is empty out of a run, and out of a session. *)
running = fiber.Channel(size = 1)

defn Show(x)
  (** Shows x under the cell that runs, at this place among what the cell prints, as the value of its last expression
      shows: a graph, a table, a matrix or the text of a value; missing shows nothing. The value of the last expression
      still shows, after everything else. Gives x. Out of a session of cells, as in cesia run, it shows nothing.

        Show(42) --> 42 *)
  got = fiber.Receive(running, timeout = 0)
  if result.IsErr(got)
    return x
  end
  run = got.Value
  run.Count = run.Count + 1
  fiber.Send(run, running)
  key = "$(run.Key).$(run.Count)"
  v = shown(x, width = run.Width, svg = run.Svg, key = key)
  if values.IsMissing(v)
    return x
  end
  if dict.Has("Key", v)
    fiber.Send({Key: key, Value: x}, run.Kept)
  end
  send(run.Token, {Kind: "shown", Value: v})
  x
end

defn taken(ch)
  (** The values a channel holds, taken out. *)
  out = []
  got = fiber.Receive(ch, timeout = 0)
  while result.IsOk(got)
    out = list.Append(got.Value, out)
    got = fiber.Receive(ch, timeout = 0)
  end
  out
end

defn ran(c, key, token)
  (** Runs the code of a cell and sends its answer; gives the graphs and the tables it showed, which the session keeps,
      each {Key, Value}: those of Show, then its value when it shows as one. std/random starts again first, from the seed of the
      session and the title of the cell, as cesia test does for each test: a cell run again draws the same numbers,
      whatever ran before it. *)
  start = sys.Now()
  first = text.Lines(c.Code)
  title = if values.Len(first) == 0 "" else marker(first[1]) end
  restartRandom(if values.IsMissing(title) "" else title end)
  graphs = fiber.Channel()
  (* A run that a stop ended left its own. *)
  _ = taken(running)
  fiber.Send({Width: dict.GetOr("Width", 640, c), Svg: dict.GetOr("Svg", false, c), Key: key, Count: 0, Kept: graphs, Token: token}, running)
  r = evalCell(c.Code, c.Line)
  _ = taken(running)
  seconds = sys.Now() - start
  shows = taken(graphs)
  if result.IsErr(r)
    send(token, {Kind: "answer", Error: {Line: errorLine(c.Path, r.Error), Text: r.Error}, Seconds: seconds})
    return shows
  end
  v = shown(r.Value, width = dict.GetOr("Width", 640, c), svg = dict.GetOr("Svg", false, c), key = key)
  if values.IsSome(v) and v.Kind == "error"
    (* A graph that std/plot can't draw: its message, as an error of the cell. *)
    send(token, {Kind: "answer", Error: {Line: missing, Text: v.Text}, Seconds: seconds})
    return shows
  end
  send(token, {Kind: "answer", Value: v, Seconds: seconds})
  if values.IsSome(v) and dict.Has("Key", v) list.Append({Key: "$key", Value: r.Value}, shows) else shows end
end

defn kept(task, key, graphs)
  (** The graphs and the tables of the session once a run ended: those it showed, under their keys, and the last 64. *)
  if values.IsMissing(task)
    return graphs
  end
  w = fiber.Wait(task)
  if result.IsErr(w) or values.IsMissing(w.Value)
    return graphs
  end
  out = graphs
  for g in w.Value
    out = dict.Put(g.Key, g.Value, out)
  end
  while values.Len(out) > 64
    out = dict.Drop(dict.Keys(out)[1], out)
  end
  out
end

defn rescened(c, graphs)
  (** The answer to a scene: the graph of a key drawn at a width; or to an svg, its SVG. *)
  g = dict.Get("$(c.Key)", graphs)
  svg = c.Do == "svg"
  kind = if svg "svg" else "scene" end
  r = if values.IsMissing(g) missing else drawn(g, c.Width, svg, frame = dict.GetOr("Frame", 1, c), view = dict.GetOr("View", missing, c), mark = dict.GetOr("Mark", missing, c), xlim = dict.GetOr("Xlim", missing, c), ylim = dict.GetOr("Ylim", missing, c), points = dict.GetOr("Points", false, c)) end
  if values.IsMissing(r)
    return {Kind: kind, Error: "No graph of key $(c.Key) in the session: it holds the last 64 that its runs showed."}
  end
  if result.IsErr(r) {Kind: kind, Error: r.Error.Message} else if svg {Kind: kind, Svg: r.Value} else {Kind: kind, Scene: r.Value} end
end

defn kind(v)
  (** The type of a value, for the variables. *)
  kinds = [{Is: values.IsInt, Name: "Int"}, {Is: values.IsFloat, Name: "Float"}, {Is: values.IsBool, Name: "Bool"},
    {Is: values.IsText, Name: "Text"}, {Is: values.IsArray, Name: "Array"}, {Is: isFrame, Name: "Frame"},
    {Is: values.IsDict, Name: "Dict"}, {Is: values.IsFunction, Name: "Function"}]
  for k in kinds
    if k.Is(v)
      return k.Name
    end
  end
  if values.IsStruct(v) text.Split("(", values.Text(v, 80))[1] else "Value" end
end

defn size(v)
  (** The shape or the length of a value, for the variables. *)
  if isFrame(v)
    rows = if values.Len(v.Names) == 0 0 else values.Len(v.Columns[v.Names[1]]) end
    "$rows × $(values.Len(v.Names))"
  else if values.IsArray(v)
    text.Join(" × ", ["$k" for k in values.Size(v)])
  else if values.IsText(v) or values.IsDict(v)
    "$(values.Len(v))"
  else
    ""
  end
end

defn rows(names)
  (** The variables of the session. *)
  out = []
  for name in names
    v = valueOf(name)
    if result.IsOk(v)
      preview = if isFrame(v.Value) text.Join(", ", ["$c" for c in v.Value.Names]) else brief(v.Value, 80) end
      out = list.Append({Name: name, Type: kind(v.Value), Size: size(v.Value), Preview: values.Text(text.Replace("\n", " ", preview), 80)}, out)
    end
  end
  out
end

(* -- Tables: a frame, a matrix, a list of maps or structs, or a struct, read a screen at a time, sorted and filtered here,
   in the session, so that a large value never crosses whole. *)

(** The most rows of an answer to rows, and the most cells: a wide table gives fewer rows. *)
mostRows = 1000
mostCells = 20000

(** The most columns a table shows: those past it are left out. *)
mostColumns = 256

defn isRecord(x)
  (** Is a value a map or a struct with public fields, a row of a list of records? *)
  values.IsDict(x) and not isFrame(x) or values.IsStruct(x) and values.Len(dict.Fields(x)) > 0
end

(** Is a value a list whose first element is a map or a struct with public fields: a list of records, one row each? *)
isRecords(v) = values.IsArray(v) and values.Len(values.Size(v)) == 2 and values.Size(v)[1] == 1 and values.Size(v)[2] > 0 and isRecord(v[1])

(** The fields of a record, a map or a struct, as a map. *)
fieldsOf(x) = if values.IsStruct(x) dict.Fields(x) else x end

defn tableOf(v)
  (** The table a value shows as, {Kind, Of, Columns, Count}, or missing for a value that is none: a frame, its columns; a
      list of records, the keys of its first; a matrix, the numbers of its columns; a list, one column "1"; a struct, or
      an Ok of one, its fields and their values. *)
  if isFrame(v)
    count = if values.Len(v.Names) == 0 0 else values.Len(v.Columns[v.Names[1]]) end
    return {Kind: "frame", Of: v, Columns: list.Take(mostColumns, ["$n" for n in v.Names]), Names: list.Take(mostColumns, v.Names), Count: count}
  end
  if isRecords(v)
    names = list.Take(mostColumns, dict.Keys(fieldsOf(v[1])))
    return {Kind: "records", Of: v, Columns: ["$n" for n in names], Names: names, Count: values.Len(v)}
  end
  if values.IsArray(v) and values.Len(values.Size(v)) == 2
    shape = values.Size(v)
    if shape[1] == 1
      return {Kind: "list", Of: v, Columns: ["1"], Count: shape[2]}
    end
    return {Kind: "matrix", Of: v, Columns: ["$j" for j in 1..list.Min(mostColumns, shape[2])], Count: shape[1]}
  end
  if values.IsStruct(v) and result.IsOk(v) and values.IsStruct(v.Value)
    return tableOf(v.Value)
  end
  if values.IsStruct(v) and values.Len(dict.Fields(v)) > 0
    fs = dict.Fields(v)
    return {Kind: "fields", Of: [[k, fs[k]] for k in dict.Keys(fs)], Columns: ["field", "value"], Count: values.Len(fs)}
  end
  missing
end

defn cellOf(t, i, j)
  (** The value of row i, column j of a table. *)
  v = t.Of
  match t.Kind
    "frame" -> v.Columns[t.Names[j]][i]
    "records" -> dict.GetOr(t.Names[j], missing, fieldsOf(v[i]))
    "matrix" -> v[i, j]
    "list" -> v[i]
    else -> v[i][j]
  end
end

defn columnOf(t, j)
  (** The values of column j of a table, as an array. *)
  if t.Kind == "frame" t.Of.Columns[t.Names[j]] else [cellOf(t, i, j) for i in 1..t.Count] end
end

(** The text of a cell as a table shows it: at most 200 characters, and a struct of a field as brief cuts it. *)
cellText(t, i, j) = if t.Kind == "fields" and j == 2 brief(cellOf(t, i, j), 200) else values.Text(cellOf(t, i, j), 200) end

defn backward(xs)
  (** The positions, from 1, that put the elements of xs in decreasing order, equal ones in their order, as list.Order
      puts them in increasing order: the order of the list read backward, read backward. *)
  n = values.Len(xs)
  (n + 1) - list.Reverse(list.Order(list.Reverse(xs)))
end

defn numbered(xs, descending)
  (** The positions that order an array of numbers, increasing or decreasing, equal ones in their order, NaN last: the
      decreasing order is the increasing order of their opposites. *)
  ks = list.Order(if descending 0 - xs else xs end)
  (* list.Order puts NaN first, below every number. *)
  nans = values.Len(col.Positions(xs != xs))
  if nans == 0 ks else list.Concat(ks[nans + 1..values.Len(ks)], ks[1..nans]) end
end

defn ordered(xs, descending)
  (** The positions, from 1, that order the values of a column, increasing or decreasing, as a table sorts them: numbers
      as numbers, then texts by their bytes, then the other values by their text; NaN and missing last, whichever the
      way; equal values in their order. *)
  if values.Len(xs) == 0 or col.Kind(xs) != "value"
    return numbered(xs, descending)
  end
  numbers = []
  texts = []
  others = []
  gone = []
  for i in 1..values.Len(xs)
    x = xs[i]
    if values.IsNumber(x) and x == x
      numbers = list.Append(i, numbers)
    else if values.IsText(x)
      texts = list.Append(i, texts)
    else if values.IsMissing(x) or values.IsNumber(x)
      gone = list.Append(i, gone)
    else
      others = list.Append(i, others)
    end
  end
  by = (ps, keys) -> col.Pick(if descending backward(keys) else list.Order(keys) end, ps)
  groups = [by(numbers, col.Pick(numbers, xs)), by(texts, col.Pick(texts, xs)), by(others, [values.Text(xs[i], 200) for i in others])]
  list.Concat(list.Flatten(if descending list.Reverse(groups) else groups end), gone)
end

defn wordsOf(filter)
  (** The words of the text of a filter, apart at spaces, tabs and ends of line. *)
  out = []
  for w in text.Split(" ", text.Replace("\n", " ", text.Replace("\t", " ", filter)))
    if w != ""
      out = list.Append(w, out)
    end
  end
  out
end

(** Can a word be part of the text of a number, as 1.5e-07, -inf or nan? *)
numberish(w) = values.IsMissing(text.ByteFindAny("0123456789.-+eEinfaINFA", 1, w, not = true))

defn matching(t, words, ps)
  (** The positions of ps whose row holds every word, in one of its cells or another: the text of a cell as the table
      shows it, in which each word is found as it is, its ASCII letters in either case, never read as a pattern. Each
      word reads only the rows that the words before it kept, and a column of numbers only for a word that can be part
      of a number. *)
  out = ps
  for w in words
    hits = list.Fill(0, values.Len(out))
    for j in 1..values.Len(t.Columns)
      if t.Kind == "frame" and (col.Kind(t.Of.Columns[t.Names[j]]) == "value" or numberish(w))
        hits = hits + [if values.IsSome(text.ByteFind(w, 1, values.Text(x, 200), fold = true)) 1 else 0 end for x in col.Pick(out, t.Of.Columns[t.Names[j]])]
      else if t.Kind != "frame"
        hits = hits + [if values.IsSome(text.ByteFind(w, 1, cellText(t, p, j), fold = true)) 1 else 0 end for p in out]
      end
    end
    out = col.Pick(col.Positions(hits > 0), out)
  end
  out
end

defn viewed(t, sort, filter, seen)
  (** The positions of the rows of a table in the order it shows them, for a sort, {Column, Descending}, and a filter,
      its text; seen is what the last ask of this table kept, {Sort, Filter, Matched, Order}, which the same sort and
      filter take again, and a filter that goes on with the last one's text reads only the rows that matched it. *)
  if values.IsSome(seen) and values.Equal(seen.Sort, sort) and seen.Filter == filter
    return seen
  end
  words = wordsOf(filter)
  matched = if values.Len(words) == 0
    missing
  else if values.IsSome(seen) and seen.Filter == filter
    seen.Matched
  else if values.IsSome(seen) and values.IsSome(seen.Matched) and text.StartsWith(seen.Filter, filter)
    matching(t, words, seen.Matched)
  else
    matching(t, words, 1..t.Count)
  end
  order = matched
  if values.IsSome(sort)
    xs = columnOf(t, list.IndexOf(sort.Column, t.Columns))
    order = if values.IsMissing(matched) ordered(xs, sort.Descending) else col.Pick(ordered(col.Pick(matched, xs), sort.Descending), matched) end
  end
  {Sort: sort, Filter: filter, Matched: matched, Order: order}
end

(** Is a text the key of a graph or a table that a run showed, as 12 or 12.3, which no name can be? *)
isKey(k) = values.IsSome(text.ByteFindAny("0123456789", 1, text.ByteSlice(1, 1, k)))

defn slice(c, kept, views)
  (** The answer to rows: rows First to Last, from 1, of the value of a name of the session, or of a table a run showed,
      by its key, as texts, sorted and filtered, with the position of each in the value; and the views kept for the next
      ask, by name. *)
  name = "$(dict.GetOr("Name", "", c))"
  v = dict.Get(name, kept)
  if values.IsMissing(v)
    got = valueOf(name)
    if result.IsErr(got)
      return {Answer: {Kind: "rows", Error: "Name \"$name\" isn't in the session."}, Views: views}
    end
    v = got.Value
  end
  t = tableOf(v)
  if values.IsMissing(t)
    return {Answer: {Kind: "rows", Error: "\"$name\" holds no frame, matrix or list."}, Views: views}
  end
  sort = dict.GetOr("Sort", missing, c)
  if values.IsSome(sort) and not (values.IsDict(sort) and dict.GetOr("Column", missing, sort) in t.Columns and values.IsBool(dict.GetOr("Descending", missing, sort)))
    return {Answer: {Kind: "rows", Error: "A sort is {Column, Descending}: a column of \"$name\", $(text.Join(", ", t.Columns)), and true or false."}, Views: views}
  end
  sort = if values.IsMissing(sort) missing else {Column: sort.Column, Descending: sort.Descending} end
  filter = dict.GetOr("Filter", missing, c)
  if values.IsSome(filter) and not values.IsText(filter)
    return {Answer: {Kind: "rows", Error: "A filter is a text: the words that a row holds."}, Views: views}
  end
  filter = if values.IsMissing(filter) "" else filter end
  first = dict.GetOr("First", 1, c)
  last = dict.GetOr("Last", 0, c)
  if not (values.IsInt(first) and values.IsInt(last))
    return {Answer: {Kind: "rows", Error: "Rows are asked from a first to a last, whole numbers from 1."}, Views: views}
  end
  seen = if values.IsMissing(sort) and filter == "" missing else viewed(t, sort, filter, dict.GetOr(name, missing, views)) end
  order = if values.IsMissing(seen) missing else seen.Order end
  count = if values.IsMissing(order) t.Count else values.Len(order) end
  first = list.Max(1, first)
  last = list.Min(list.Min(last, count), first - 1 + list.Min(mostRows, math.Div(mostCells, list.Max(1, values.Len(t.Columns)))))
  ps = if values.IsMissing(order) list.Range(first, last) else (if last < first [] else order[first..last] end) end
  out = {Kind: "rows", Columns: t.Columns, Rows: [[cellText(t, p, j) for j in 1..values.Len(t.Columns)] for p in ps], Count: count, Total: t.Count, Positions: ps}
  find = dict.GetOr("Find", missing, c)
  if values.IsInt(find)
    out.Found = if values.IsMissing(order) (if find >= 1 and find <= t.Count find else missing end) else list.IndexOf(find, order) end
  end
  {Answer: out, Views: if values.IsMissing(seen) views else dict.Put(name, seen, views) end}
end

defn setTo(c)
  (** The answer to a set: the name given the value of its text in place, where it is, when it holds a value of that kind
      already: a number for a slider, as the text of its number; for another input, its Kind, the value as the file writes
      it, which is read as a value and never run. *)
  if not values.IsText(dict.GetOr("Name", missing, c)) or not values.IsText(dict.GetOr("Text", missing, c))
    return {Kind: "set", Error: "A set takes the name of a slider and the text of its number."}
  end
  kind = dict.GetOr("Kind", "slider", c)
  if kind == "slider"
    x = text.Number(c.Text)
    if not finite(x)
      return {Kind: "set", Error: "A slider takes a finite number, not $(c.Text)."}
    end
    if result.IsErr(setValue(c.Name, x))
      return {Kind: "set", Error: "\"$(c.Name)\" holds no number in the session yet: its cell runs first."}
    end
    return {Kind: "set"}
  end
  x = written(kind, c.Text)
  if values.IsMissing(x)
    return {Kind: "set", Error: "A set of a $kind takes its value as the file writes it, not $(literalOf(c.Text))."}
  end
  if result.IsErr(setValue(c.Name, x))
    what = if values.IsText(x) "text" else if values.IsBool(x) "true or false" else if isDate(x) "date" else "number" end
    return {Kind: "set", Error: "\"$(c.Name)\" holds no $what in the session yet: its cell runs first."}
  end
  {Kind: "set"}
end

defn written(kind, t)
  (** The value of an input of a kind, "choice", "check", "field" or "date", from its text as the file writes it, read as
      Analyse reads it and never run, or missing for a text that is no such value. *)
  cs = text.Chars(t)
  v = valueAt(cs, 1, lists = false)
  if values.IsMissing(v) or v.Next != values.Len(cs) + 1
    return missing
  end
  x = v.Value
  if kind == "check"
    if values.IsBool(x) x else missing end
  else if kind == "date"
    dayIn(x)
  else if (kind == "choice" or kind == "field") and plain(x)
    x
  else
    missing
  end
end

defn command(line)
  (** The command of a line, or missing for a line that isn't one. *)
  c = json.Parse(line)
  if result.IsOk(c) and values.IsDict(c.Value) and dict.Has("Do", c.Value) c.Value else missing end
end

defn serve()
  (** Reads the commands of std/cells, one a line, until the end of the input: a run starts its cell in a fiber of its
      own, which a stop cancels, and the other commands wait for it to end; the names of the cells run so far are those
      the variables show, and the graphs of the last runs are kept for Scene. Its first line tells the token of its
      messages, from the time and the seed of the system: data that a cell prints can't know it. *)
  token = text.Slice(8, 39, cesia.Fingerprint(text.Str(sys.Now(), " ", random.Seed())))
  io.Print("$told$token")
  task = missing
  key = 0
  graphs = {}
  views = {}
  known = []
  line = debug.ReadLine()
  while not values.IsMissing(line)
    c = command(line)
    if values.IsMissing(c)
      c = {Do: ""}
    end
    if c.Do != "stop"
      graphs = kept(task, key, graphs)
      task = missing
    end
    (* The views of a table that the session no longer keeps go, and those of the names once a cell may change them. *)
    changes = c.Do in ["run", "set", "forget"]
    views = dict.Dict([{Key: k, Value: views[k]} for k in dict.Keys(views) if dict.Has(k, graphs) or not (changes or isKey(k))])
    if c.Do == "run"
      defs = cesia.Definitions(c.Code)
      found = if result.IsOk(defs) [d for d in defs.Value if d.Kind in shared and d.Kind != "use"] else [] end
      names = list.Unique([d.Name for d in found])
      (* A cell forgets the names it defines, so that run again it never reads what it left. Code typed at a prompt, line 0,
         forgets its functions, structs and interfaces only: a value it gives a name that holds one goes in its place, so
         that x = x + 1 reads the x before. *)
      forgetNames([d.Name for d in found if c.Line != 0 or d.Kind != "value"])
      known = list.Concat([k for k in known if not (k in names)], names)
      key += 1
      now = key
      task = fiber.Spawn(() -> ran(c, now, token))
    else if c.Do == "stop"
      if values.IsSome(task)
        fiber.Cancel(task)
        w = fiber.Wait(task)
        if result.IsErr(w) and w.Error.Kind == "cancelled"
          send(token, {Kind: "answer", Error: {Line: missing, Text: "Stopped."}, Seconds: 0.0})
        end
        graphs = kept(task, key, graphs)
        task = missing
      end
      send(token, {Kind: "stopped"})
    else if c.Do == "forget"
      forgetNames(c.Names)
      known = [k for k in known if not (k in c.Names)]
      send(token, {Kind: "forgot"})
    else if c.Do == "variables"
      send(token, {Kind: "variables", Rows: rows(known)})
    else if c.Do == "rows"
      got = slice(c, graphs, views)
      views = got.Views
      send(token, got.Answer)
    else if c.Do == "scene" or c.Do == "svg"
      send(token, rescened(c, graphs))
    else if c.Do == "set"
      send(token, setTo(c))
    end
    line = debug.ReadLine()
  end
  _ = kept(task, key, graphs)
end
