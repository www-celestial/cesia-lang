(** Numerical computing, in the spirit of numpy. An array is a list or a matrix of floats, and the operators of the
    language already work element by element: a + b, a * 2.0, a > 0.0, matrix.Matmul(a, b), matrix.Transpose(a), list.Sum(a), list.Mean(a). *)
use std/lapack
use std/list
use std/math
use std/matrix
use std/result
use std/value

(** The library that does the large computations, or missing if the code of Cesia does them all. *)
Backend() = lapack.Name()

defn Linspace(a, b, n)
  (** n evenly spaced floats from a to b, both included.

        Linspace(0, 1, 3) --> [0.0, 0.5, 1.0] *)
  if n == 1
    return [1.0 * a]
  end
  step = (b - a) / (n - 1)
  [a + k * step for k in 0..n - 1]
end

defn Eye(n)
  (** The identity matrix of order n.

        list.Sum(Eye(2)) --> 2.0 *)
  m = matrix.Zeros(n, n)
  for k in 1..n
    m[k, k] = 1.0
  end
  m
end

defn Diag(xs)
  (** A square matrix with the elements on its diagonal and 0.0 elsewhere.

        list.Sum(Diag([1, 2])) --> 3.0 *)
  n = value.Len(xs)
  m = matrix.Zeros(n, n)
  for k in 1..n
    m[k, k] = xs[k]
  end
  m
end

defn Variance(xs)
  (** The variance of the elements: the mean of the squares of their distance from the mean.

        Variance([1.0, 3.0]) --> 1.0 *)
  d = xs - list.Mean(xs)
  list.Sum(d * d) / value.Len(xs)
end

(** The standard deviation of the elements.

      Std([1.0, 3.0]) --> 1.0 *)
Std(xs) = math.Sqrt(Variance(xs))

defn Percentile(p, xs)
  (** The value below which p percent of the elements fall, interpolating between the two nearest ones.

        Percentile(50, [1.0, 2.0, 3.0]) --> 2.0 *)
  s = list.Sort(xs)
  at = p / 100.0 * (value.Len(s) - 1) + 1
  low = math.Floor(at)
  high = math.Ceil(at)
  s[low] + (s[high] - s[low]) * (at - low)
end

(** The middle value of the elements.

      Median([3.0, 1.0, 2.0]) --> 2.0 *)
Median(xs) = Percentile(50, xs)

defn Cumsum(xs)
  (** The running sum of the elements.

        Cumsum([1.0, 2.0, 3.0]) --> [1.0, 3.0, 6.0] *)
  out = matrix.Zeros(1, value.Len(xs))
  total = 0.0
  for k in 1..value.Len(xs)
    total += xs[k]
    out[k] = total
  end
  out
end

(** The differences between consecutive elements.

      Diff([1, 4, 9]) --> [3, 5] *)
Diff(xs) = [xs[k + 1] - xs[k] for k in 1..value.Len(xs) - 1]
(** The dot product of two arrays.

      Dot([1, 2], [3, 4]) --> 11 *)
Dot(a, b) = list.Sum(a * b)
(** The Euclidean length of an array.

      Norm([3.0, 4.0]) --> 5.0 *)
Norm(xs) = math.Sqrt(Dot(xs, xs))

defn Covariance(a, b)
  (** The covariance of two arrays of the same length.

        math.Abs(Covariance([1.0, 2.0, 3.0], [2.0, 4.0, 6.0]) - 4.0 / 3.0) < 1e-9 --> true *)
  list.Mean((a - list.Mean(a)) * (b - list.Mean(b)))
end

(** The correlation of two arrays of the same length, from -1 to 1.

      math.Abs(Correlation([1.0, 2.0, 3.0], [2.0, 4.0, 6.0]) - 1.0) < 1e-9 --> true *)
Correlation(a, b) = Covariance(a, b) / (Std(a) * Std(b))

defn Histogram(bins, xs)
  (** The elements counted in a number of equal bins, as a struct with counts and edges.

        Histogram(2, [1, 2, 3, 4]).Counts --> [2, 2] *)
  low = list.Min(xs)
  high = list.Max(xs)
  width = (high - low) / bins
  counts = list.Fill(0, bins)
  for x in xs
    k = if width == 0.0 1 else list.Min(math.Floor((x - low) / width) + 1, bins) end
    counts[k] += 1
  end
  {Counts: counts, Edges: [low + k * width for k in 0..bins]}
end

SumRows(m) = [list.Sum(m[i, :]) for i in 1..value.Size(m, 1)]   (** The sum of each row of a matrix. *)
(** The sum of each column of a matrix.

      SumCols(Eye(2)) --> [1.0, 1.0] *)
SumCols(m) = [list.Sum(m[:, j]) for j in 1..value.Size(m, 2)]

defn eliminate(m, b)
  (** Gaussian elimination with partial pivoting: the triangle, the swaps and their sign. *)
  n = value.Size(m, 1)
  sign = 1.0
  for col in 1..n
    pivot = col
    for r in col + 1..n
      if math.Abs(m[r, col]) > math.Abs(m[pivot, col])
        pivot = r
      end
    end
    if math.Abs(m[pivot, col]) < 1e-14
      return {Singular: true, M: m, B: b, Sign: 0.0}
    end
    if pivot != col
      sign = -sign
      for c in 1..n
        t = m[col, c]
        m[col, c] = m[pivot, c]
        m[pivot, c] = t
      end
      for c in 1..value.Size(b, 2)
        t = b[col, c]
        b[col, c] = b[pivot, c]
        b[pivot, c] = t
      end
    end
    for r in col + 1..n
      f = m[r, col] / m[col, col]
      if f != 0.0
        for c in col..n
          m[r, c] = m[r, c] - f * m[col, c]
        end
        for c in 1..value.Size(b, 2)
          b[r, c] = b[r, c] - f * b[col, c]
        end
      end
    end
  end
  {Singular: false, M: m, B: b, Sign: sign}
end

defn Det(m)
  (** The determinant of a square matrix.

        math.Abs(Det(matrix.Reshape([1.0, 3.0, 2.0, 4.0], 2, 2)) + 2.0) < 1e-9 --> true *)
  fast = lapack.Det(m)
  if not value.IsMissing(fast)
    return fast
  end
  t = eliminate(m, matrix.Zeros(value.Size(m, 1), 1))
  if t.Singular
    return 0.0
  end
  d = t.Sign
  for k in 1..value.Size(m, 1)
    d = d * t.M[k, k]
  end
  d
end

defn back(t)
  n = value.Size(t.M, 1)
  x = t.B
  for c in 1..value.Size(x, 2)
    for r in list.Range(n, 1, step = -1)
      s = x[r, c]
      for k in r + 1..n
        s = s - t.M[r, k] * x[k, c]
      end
      x[r, c] = s / t.M[r, r]
    end
  end
  x
end

singular() = result.Err({Kind: "math", Message: "This matrix is singular."})

defn solved(m, b)
  (** x of a x = b, with a library for a large a. b has as many rows as a. *)
  fast = lapack.Solve(m, b)
  if not value.IsMissing(fast)
    return if value.IsArray(fast) result.Ok(fast) else singular() end
  end
  t = eliminate(m, b)
  if t.Singular singular() else result.Ok(back(t)) end
end

defn Solve(m, b)
  (** The x of m * x = b, in an Ok, or an Err of the kind "math" if the matrix is singular.

        Solve(Eye(2), [1.0, 2.0]).Value --> [1.0, 2.0] *)
  n = value.Size(m, 1)
  result.MapOk(x -> matrix.Reshape(x, 1, n), solved(m, matrix.Reshape(b, n, 1)))
end

(** The inverse of a square matrix, in an Ok, or an Err of the kind "math" if it is singular.

      list.Sum(Inverse(Eye(2)).Value) --> 2.0 *)
Inverse(m) = solved(m, Eye(value.Size(m, 1)))

defn Qr(m)
  (** The QR factorization of a matrix with at least as many rows as columns, as a struct with Q and R: through LAPACK when
      the machine has it, else by Gram-Schmidt, twice for accuracy. *)
  fast = lapack.Qr(m)
  if not value.IsMissing(fast)
    return fast
  end
  rows = value.Size(m, 1)
  cols = value.Size(m, 2)
  q = matrix.Zeros(rows, cols)
  r = matrix.Zeros(cols, cols)
  for j in 1..cols
    v = m[:, j]
    for pass in 1..2
      for i in 1..j - 1
        qi = q[:, i]
        c = Dot(qi, v)
        r[i, j] = r[i, j] + c
        v = v - qi * c
      end
    end
    sizeV = Norm(v)
    r[j, j] = sizeV
    for i in 1..rows
      q[i, j] = if sizeV == 0.0 0.0 else v[i] / sizeV end
    end
  end
  {Q: q, R: r}
end

defn Eigen(a)
  (** The eigenvalues and eigenvectors of a symmetric matrix, by Jacobi rotations. *)
  fast = lapack.Eigen(a)
  if not value.IsMissing(fast)
    return fast
  end
  n = value.Size(a, 1)
  v = Eye(n)
  for sweep in 1..60
    off = 0.0
    for p in 1..n
      for q in p + 1..n
        off += a[p, q] * a[p, q]
      end
    end
    if off < 1e-22
      break
    end
    for p in 1..n
      for q in p + 1..n
        if math.Abs(a[p, q]) > 1e-300
          theta = (a[q, q] - a[p, p]) / (2.0 * a[p, q])
          t = math.Sign(theta) / (math.Abs(theta) + math.Sqrt(theta * theta + 1.0))
          t = if theta == 0.0 1.0 else t end
          c = 1.0 / math.Sqrt(t * t + 1.0)
          s = t * c
          for k in 1..n
            akp = a[k, p]
            akq = a[k, q]
            a[k, p] = c * akp - s * akq
            a[k, q] = s * akp + c * akq
          end
          for k in 1..n
            apk = a[p, k]
            aqk = a[q, k]
            a[p, k] = c * apk - s * aqk
            a[q, k] = s * apk + c * aqk
          end
          for k in 1..n
            vkp = v[k, p]
            vkq = v[k, q]
            v[k, p] = c * vkp - s * vkq
            v[k, q] = s * vkp + c * vkq
          end
        end
      end
    end
  end
  {Values: [a[k, k] for k in 1..n], Vectors: v}
end

defn LeastSquares(a, b)
  (** The x of the smallest |ax - b|, through the normal equations. *)
  t = matrix.Transpose(a)
  Solve(matrix.Matmul(t, a), matrix.Matmul(t, matrix.Reshape(b, value.Len(b), 1)))
end

defn Polyfit(degree, xs, ys)
  (** The coefficients of a polynomial of a degree through points, the constant first. *)
  a = matrix.Zeros(value.Len(xs), degree + 1)
  for i in 1..value.Len(xs)
    for j in 1..degree + 1
      a[i, j] = 1.0 * xs[i] ^ (j - 1)
    end
  end
  result.Unwrap(LeastSquares(a, ys))
end

defn Polyval(coefficients, x)
  (** The value of a polynomial at x, given its coefficients with the constant first.

        Polyval([1, 2], 3) --> 7.0 *)
  total = 0.0
  for k in list.Range(value.Len(coefficients), 1, step = -1)
    total = total * x + coefficients[k]
  end
  total
end

defn Trapezoid(xs, ys)
  (** The area under the points (xs, ys), by the trapezoid rule.

        Trapezoid([0, 1], [0, 2]) --> 1.0 *)
  total = 0.0
  for k in 1..value.Len(xs) - 1
    total += (xs[k + 1] - xs[k]) * (ys[k] + ys[k + 1]) / 2.0
  end
  total
end

defn Interpolate(x, xs, ys)
  (** The value at x of the line through the nearest points of (xs, ys), which are sorted by xs. Past the last point it gives the last y.

        Interpolate(0.5, [0, 1], [0, 2]) --> 1.0 *)
  for k in 1..value.Len(xs) - 1
    if x <= xs[k + 1]
      return ys[k] + (ys[k + 1] - ys[k]) * (x - xs[k]) / (xs[k + 1] - xs[k])
    end
  end
  ys[value.Len(ys)]
end

defn dft(re, im, direction)
  (** A discrete Fourier transform: radix 2 for powers of two, the plain sum otherwise. Parts are separate arrays. *)
  n = value.Len(re)
  outRe = matrix.Zeros(1, n)
  outIm = matrix.Zeros(1, n)
  for k in 1..n
    for t in 1..n
      angle = direction * 2.0 * math.Pi * (k - 1) * (t - 1) / n
      c = math.Cos(angle)
      s = math.Sin(angle)
      outRe[k] = outRe[k] + re[t] * c - im[t] * s
      outIm[k] = outIm[k] + re[t] * s + im[t] * c
    end
  end
  {Re: outRe, Im: outIm}
end

defn radix2(re, im, direction)
  n = value.Len(re)
  if n == 1
    return {Re: re, Im: im}
  end
  half = math.Div(n, 2)
  even = radix2([re[2 * k - 1] for k in 1..half], [im[2 * k - 1] for k in 1..half], direction)
  odd = radix2([re[2 * k] for k in 1..half], [im[2 * k] for k in 1..half], direction)
  outRe = matrix.Zeros(1, n)
  outIm = matrix.Zeros(1, n)
  for k in 1..half
    angle = direction * 2.0 * math.Pi * (k - 1) / n
    c = math.Cos(angle)
    s = math.Sin(angle)
    tr = odd.Re[k] * c - odd.Im[k] * s
    ti = odd.Re[k] * s + odd.Im[k] * c
    outRe[k] = even.Re[k] + tr
    outIm[k] = even.Im[k] + ti
    outRe[k + half] = even.Re[k] - tr
    outIm[k + half] = even.Im[k] - ti
  end
  {Re: outRe, Im: outIm}
end

isPower(n) = n > 0 and math.BitAnd(n, n - 1) == 0

defn transform(re, im, direction)
  if isPower(value.Len(re)) radix2(re, im, direction) else dft(re, im, direction) end
end

(** The Fourier transform of an array, as a struct with re and im.

      Fft([1.0, 0.0, 0.0, 0.0]).Re --> [1.0, 1.0, 1.0, 1.0] *)
Fft(xs) = transform(xs, matrix.Zeros(1, value.Len(xs)), -1.0)

defn Ifft(f)
  (** The inverse of fft, from a struct with re and im. *)
  r = transform(f.Re, f.Im, 1.0)
  n = 1.0 * value.Len(f.Re)
  {Re: r.Re / n, Im: r.Im / n}
end

(** Random numbers that a seed repeats, for simulations: xorshift, never for secrets. A generator is a value. *)
Seeded(seed) = {State: math.BitOr(math.BitXor(seed, 88172645463325252), 1)}

defn next(state)
  x = state
  x = math.BitXor(x, math.BitShift(x, 13))
  x = math.BitXor(x, math.BitShift(x, -7))
  math.BitXor(x, math.BitShift(x, 17))
end

defn Uniform(n, generator)
  (** n floats in [0, 1) from a generator, as a struct with values and the next generator. See seeded.

        value.Len(Uniform(3, Seeded(1)).Values) --> 3 *)
  values = matrix.Zeros(1, n)
  s = generator.State
  for k in 1..n
    s = next(s)
    values[k] = math.BitAnd(s, 1099511627775) / 1099511627776.0
  end
  {Values: values, Next: {State: s}}
end

defn Normal(n, generator)
  (** n floats from the normal distribution (mean 0, deviation 1) from a generator, as a struct with values and the next generator.

        value.Len(Normal(3, Seeded(1)).Values) --> 3 *)
  u = Uniform(2 * n, generator)
  values = matrix.Zeros(1, n)
  for k in 1..n
    a = 1.0 - u.Values[2 * k - 1]
    b = u.Values[2 * k]
    values[k] = math.Sqrt(-2.0 * math.Log(a)) * math.Cos(2.0 * math.Pi * b)
  end
  {Values: values, Next: u.Next}
end
