(** Numerical computing, in the spirit of numpy. An array is a list or a matrix of floats, and the operators of the
    language already work element by element: a + b, a * 2.0, a > 0.0, matrix.Matmul(a, b), matrix.Transpose(a), list.Sum(a), list.Mean(a). *)
use std/bug
use std/lapack
use std/list
use std/math
use std/matrix
use std/result
use std/text
use std/value

(** The library that does the large computations, or missing if the code of Cesia does them all. It has no example, as
    its answer depends on the machine. *)
Backend() = lapack.Name()

defn Linspace(a, b, n)
  (** n evenly spaced floats from a to b, both included.

        Linspace(0, 1, 3) --> [0.0, 0.5, 1.0] *)
  if n == 1
    return [1.0 * a]
  end
  step = (b - a) / (n - 1)
  [a + k * step for k in 0..n - 1]
end

defn Eye(n)
  (** The identity matrix of order n.

        list.Sum(Eye(2)) --> 2.0 *)
  m = matrix.Zeros(n, n)
  for k in 1..n
    m[k, k] = 1.0
  end
  m
end

defn Diag(xs)
  (** A square matrix with the elements on its diagonal and 0.0 elsewhere.

        list.Sum(Diag([1, 2])) --> 3.0 *)
  n = value.Len(xs)
  m = matrix.Zeros(n, n)
  for k in 1..n
    m[k, k] = xs[k]
  end
  m
end

defn Variance(xs, sample = false)
  (** The variance of the elements: the mean of the squares of their distance from the mean, over n, as numpy's var;
      with sample, over n - 1, the variance of a sample as R's var and stats compute it.

        Variance([1.0, 3.0]) --> 1.0
        Variance([1.0, 3.0], sample = true) --> 2.0 *)
  d = xs - list.Mean(xs)
  list.Sum(d * d) / (if sample value.Len(xs) - 1 else value.Len(xs) end)
end

(** The standard deviation of the elements, over n; with sample, over n - 1, R's sd.

      Std([1.0, 3.0]) --> 1.0
      Std([1.0, 3.0], sample = true) --> 1.4142135623730951 *)
Std(xs, sample = false) = math.Sqrt(Variance(xs, sample = sample))

defn Percentile(p, xs)
  (** The value below which p percent of the elements fall, interpolating between the two nearest ones.

        Percentile(50, [1.0, 2.0, 3.0]) --> 2.0 *)
  s = list.Sort(xs)
  at = p / 100.0 * (value.Len(s) - 1) + 1
  low = math.Floor(at)
  high = math.Ceil(at)
  s[low] + (s[high] - s[low]) * (at - low)
end

(** The middle value of the elements.

      Median([3.0, 1.0, 2.0]) --> 2.0 *)
Median(xs) = Percentile(50, xs)

defn Cumsum(xs)
  (** The running sum of the elements.

        Cumsum([1.0, 2.0, 3.0]) --> [1.0, 3.0, 6.0] *)
  out = matrix.Zeros(1, value.Len(xs))
  total = 0.0
  for k in 1..value.Len(xs)
    total += xs[k]
    out[k] = total
  end
  out
end

(** The differences between consecutive elements.

      Diff([1, 4, 9]) --> [3, 5] *)
Diff(xs) = [xs[k + 1] - xs[k] for k in 1..value.Len(xs) - 1]
defn Dot(a, b)
  (** The dot product of two arrays: list.Sum(a * b), in one pass with no array of the products when both hold floats
      and have one shape.

        Dot([1, 2], [3, 4]) --> 11 *)
  d = dot(a, b)
  if value.IsMissing(d) list.Sum(a * b) else d end
end
(** The Euclidean length of an array.

      Norm([3.0, 4.0]) --> 5.0 *)
Norm(xs) = math.Sqrt(Dot(xs, xs))

defn Covariance(a, b, sample = false)
  (** The covariance of two arrays of the same length, over n; with sample, over n - 1, R's cov.

        math.Abs(Covariance([1.0, 2.0, 3.0], [2.0, 4.0, 6.0]) - 4.0 / 3.0) < 1e-9 --> true
        Covariance([1.0, 2.0, 3.0], [2.0, 4.0, 6.0], sample = true) --> 2.0 *)
  if sample
    return list.Sum((a - list.Mean(a)) * (b - list.Mean(b))) / (value.Len(a) - 1)
  end
  list.Mean((a - list.Mean(a)) * (b - list.Mean(b)))
end

(** The correlation of two arrays of the same length, from -1 to 1.

      math.Abs(Correlation([1.0, 2.0, 3.0], [2.0, 4.0, 6.0]) - 1.0) < 1e-9 --> true *)
Correlation(a, b) = Covariance(a, b) / (Std(a) * Std(b))

defn Histogram(bins, xs)
  (** The elements counted in a number of equal bins, as a struct with counts and edges.

        Histogram(2, [1, 2, 3, 4]).Counts --> [2, 2] *)
  low = list.Min(xs)
  high = list.Max(xs)
  width = (high - low) / bins
  counts = list.Fill(0, bins)
  for x in xs
    k = if width == 0.0 1 else list.Min(math.Floor((x - low) / width) + 1, bins) end
    counts[k] += 1
  end
  {Counts: counts, Edges: [low + k * width for k in 0..bins]}
end

defn factor(m)
  (** Gaussian elimination with partial pivoting, in the order of the textbook: at each column the row of the largest
      element in absolute value comes up, then each row below loses the multiple of it that makes its element 0. The
      multipliers are kept where those zeros would be. {Singular, Lu, Perm, Sign}: Singular when a pivot is under 1e-14
      in absolute value; Perm, the rows of m in the order of the elimination; Sign, that of the permutation. The work is
      luFactor's, native code, on the square of the first columns of m; a panic when m is no matrix of numbers. *)
  t = luFactor(m)
  if value.IsMissing(t)
    bug.Panic("num: m is $(brief(m)); give a square matrix of numbers.")
  end
  t
end

struct LuFactors
  (** The LU factorization of a square matrix m, which Lu gives: Gaussian elimination with partial pivoting, which writes
      m, its rows in another order, as L U, L lower triangular with ones on its diagonal and U upper triangular, as
      MATLAB's lu and scipy's lu_factor. f.Solve(b) then gives the x of m x = b for each b, at the cost of two triangular
      solves, about n^2 operations, without the n^3 / 3 of the elimination again.

        f = Lu(matrix.Reshape([2, 2], [2.0, 4.0, 1.0, 3.0])).Value
        f.Solve([3.0, 7.0]) --> [1.0, 1.0] *)
  lu    (* L under the diagonal, without its ones, and U on and above it, in one matrix of the order of m *)
  perm  (* the rows of m in the order of the elimination: row k of L U is row perm[k] of m *)
  sign  (* the sign of that permutation, 1.0 or -1.0 *)
end

defn Lu(m)
  (** The LU factorization of a square matrix, in an Ok of a LuFactors, or an Err of the kind "math" if the matrix is singular:
      when a pivot, the largest element left in its column, is under 1e-14 in absolute value, as Solve says. The code
      of Cesia does it for every order; Solve, Det and Inverse use it below the order where LAPACK takes over.

        f = Lu(matrix.Reshape([2, 2], [4.0, 2.0, 2.0, 3.0])).Value
        f.Solve([6.0, 5.0]) --> [1.0, 1.0]
        f.Solve(Eye(2)) then matrix.Matmul(matrix.Reshape([2, 2], [4.0, 2.0, 2.0, 3.0]), it) --> [1.0 0.0; 0.0 1.0]
        Lu(matrix.Reshape([2, 2], [1.0, 2.0, 2.0, 4.0])).Error.Message --> "This matrix is singular." *)
  dims = if value.IsArray(m) value.Size(m) else [] end
  if value.Len(dims) != 2 or dims[1] != dims[2] or dims[1] == 0
    bug.Panic("num.Lu: m is $(brief(m)); give a square matrix of numbers.")
  end
  t = luFactor(m)
  if value.IsMissing(t)
    for k in 1..value.Len(m)
      if not value.IsNumber(m[k])
        bug.Panic("num.Lu: m[$k] is $(brief(m[k])); give a square matrix of numbers.")
      end
    end
  end
  if t.Singular singular() else result.Ok(LuFactors(t.Lu, t.Perm, t.Sign)) end
end

defn brief(v)
  (** A value as a panic shows it: its text, a text in quotes, cut past 60 characters. *)
  s = if value.IsText(v) "\"$(value.Text(v, 61))\"" else value.Text(v, 61) end
  if value.Len(s) > 60 "$(text.Slice(1, 57, s))..." else s end
end

defn (f LuFactors) Solve(b)
  (** The x of m x = b, for the m of the factorization f: b an array of n numbers, a row or a column, gives x in the
      same shape; b a matrix of n rows gives x with a column for each of its columns. The operations are those of Solve,
      in the same order, so both give the same bits.

        f = Lu(matrix.Reshape([2, 2], [2.0, 1.0, 1.0, 3.0])).Value
        f.Solve([3.0; 5.0]) --> [0.8; 1.4] *)
  x = luSolve(f.lu, f.perm, b)
  if value.IsMissing(x)
    bug.Panic("LuFactors.Solve: b is $(brief(b)); give $(value.Len(f.perm)) numbers, or a matrix of $(value.Len(f.perm)) rows.")
  end
  x
end

defn Det(m)
  (** The determinant of a square matrix.

        math.Abs(Det(matrix.Reshape([2, 2], [1.0, 3.0, 2.0, 4.0])) + 2.0) < 1e-9 --> true *)
  fast = lapack.Det(m)
  if not value.IsMissing(fast)
    return fast
  end
  t = factor(m)
  if t.Singular
    return 0.0
  end
  d = t.Sign
  for k in 1..value.Size(m, 1)
    d = d * t.Lu[k, k]
  end
  d
end

singular() = result.Err({Kind: "math", Message: "This matrix is singular."})

defn solved(m, b)
  (** x of a x = b, with a library for a large a. b has as many rows as a. *)
  fast = lapack.Solve(m, b)
  if not value.IsMissing(fast)
    return if value.IsArray(fast) result.Ok(fast) else singular() end
  end
  t = factor(m)
  if t.Singular singular() else result.Ok(LuFactors(t.Lu, t.Perm, t.Sign).Solve(b)) end
end

defn Solve(m, b)
  (** The x of m * x = b, in an Ok, or an Err of the kind "math" if the matrix is singular: when a pivot of the
      elimination, the largest element left in its column, is under 1e-14 in absolute value. Lu keeps the elimination
      for many b.

        Solve(Eye(2), [1.0, 2.0]).Value --> [1.0, 2.0] *)
  n = value.Size(m, 1)
  result.MapOk(x -> matrix.Reshape([1, n], x), solved(m, matrix.Reshape([n, 1], b)))
end

(** The inverse of a square matrix, in an Ok, or an Err of the kind "math" if it is singular.

      list.Sum(Inverse(Eye(2)).Value) --> 2.0 *)
Inverse(m) = solved(m, Eye(value.Size(m, 1)))

defn Qr(m)
  (** The QR factorization of a matrix with at least as many rows as columns, as a struct with Q and R: through LAPACK when
      the machine has it, else by Gram-Schmidt, twice for accuracy.

        m = matrix.Reshape([2, 2], [3.0, 4.0, 0.0, 5.0])
        value.Text(math.Round(Qr(m).R)) --> "[5.0 4.0; 0.0 3.0]"
        value.Text(math.Round(Qr(m).Q * 10) / 10) --> "[0.6 -0.8; 0.8 0.6]" *)
  fast = lapack.Qr(m)
  if not value.IsMissing(fast)
    return fast
  end
  rows = value.Size(m, 1)
  cols = value.Size(m, 2)
  q = matrix.Zeros(rows, cols)
  r = matrix.Zeros(cols, cols)
  for j in 1..cols
    v = m[:, j]
    for pass in 1..2
      for i in 1..j - 1
        qi = q[:, i]
        c = Dot(qi, v)
        r[i, j] = r[i, j] + c
        v = v - qi * c
      end
    end
    sizeV = Norm(v)
    r[j, j] = sizeV
    for i in 1..rows
      q[i, j] = if sizeV == 0.0 0.0 else v[i] / sizeV end
    end
  end
  {Q: q, R: r}
end

defn Eigen(a)
  (** The eigenvalues and eigenvectors of a symmetric matrix, by Jacobi rotations.

        math.Round(Eigen(matrix.Reshape([2, 2], [2.0, 1.0, 1.0, 2.0])).Values) --> [1.0, 3.0] *)
  fast = lapack.Eigen(a)
  if not value.IsMissing(fast)
    return fast
  end
  n = value.Size(a, 1)
  v = Eye(n)
  for sweep in 1..60
    off = 0.0
    for p in 1..n
      for q in p + 1..n
        off += a[p, q] * a[p, q]
      end
    end
    if off < 1e-22
      break
    end
    for p in 1..n
      for q in p + 1..n
        if math.Abs(a[p, q]) > 1e-300
          theta = (a[q, q] - a[p, p]) / (2.0 * a[p, q])
          t = math.Sign(theta) / (math.Abs(theta) + math.Sqrt(theta * theta + 1.0))
          t = if theta == 0.0 1.0 else t end
          c = 1.0 / math.Sqrt(t * t + 1.0)
          s = t * c
          for k in 1..n
            akp = a[k, p]
            akq = a[k, q]
            a[k, p] = c * akp - s * akq
            a[k, q] = s * akp + c * akq
          end
          for k in 1..n
            apk = a[p, k]
            aqk = a[q, k]
            a[p, k] = c * apk - s * aqk
            a[q, k] = s * apk + c * aqk
          end
          for k in 1..n
            vkp = v[k, p]
            vkq = v[k, q]
            v[k, p] = c * vkp - s * vkq
            v[k, q] = s * vkp + c * vkq
          end
        end
      end
    end
  end
  {Values: [a[k, k] for k in 1..n], Vectors: v}
end

defn LeastSquares(a, b)
  (** The x of the smallest |ax - b|, through the normal equations.

        a = matrix.Reshape([4, 2], [1.0, 1.0, 1.0, 1.0, 0.0, 1.0, 2.0, 3.0])
        math.Round(LeastSquares(a, [0.0, 1.0, 1.0, 2.0]).Value * 100) / 100 --> [0.1, 0.6] *)
  t = matrix.Transpose(a)
  Solve(matrix.Matmul(t, a), matrix.Matmul(t, matrix.Reshape([value.Len(b), 1], b)))
end

defn Polyfit(degree, xs, ys)
  (** The coefficients of a polynomial of a degree through points, the constant first.

        math.Round(Polyfit(2, [0, 1, 2, 3], [1, 6, 17, 34])) --> [1.0, 2.0, 3.0] *)
  a = matrix.Zeros(value.Len(xs), degree + 1)
  for i in 1..value.Len(xs)
    for j in 1..degree + 1
      a[i, j] = 1.0 * xs[i] ^ (j - 1)
    end
  end
  result.Unwrap(LeastSquares(a, ys))
end

defn Polyval(coefficients, x)
  (** The value of a polynomial at x, given its coefficients with the constant first.

        Polyval([1, 2], 3) --> 7.0 *)
  total = 0.0
  for k in list.Range(value.Len(coefficients), 1, step = -1)
    total = total * x + coefficients[k]
  end
  total
end

defn Trapezoid(xs, ys)
  (** The area under the points (xs, ys), by the trapezoid rule.

        Trapezoid([0, 1], [0, 2]) --> 1.0 *)
  total = 0.0
  for k in 1..value.Len(xs) - 1
    total += (xs[k + 1] - xs[k]) * (ys[k] + ys[k + 1]) / 2.0
  end
  total
end

defn Interpolate(x, xs, ys)
  (** The value at x of the line through the nearest points of (xs, ys), which are sorted by xs. Past the last point it gives the last y.

        Interpolate(0.5, [0, 1], [0, 2]) --> 1.0 *)
  for k in 1..value.Len(xs) - 1
    if x <= xs[k + 1]
      return ys[k] + (ys[k + 1] - ys[k]) * (x - xs[k]) / (xs[k + 1] - xs[k])
    end
  end
  ys[value.Len(ys)]
end

defn dft(re, im, direction)
  (** A discrete Fourier transform: radix 2 for powers of two, the plain sum otherwise. Parts are separate arrays. *)
  n = value.Len(re)
  outRe = matrix.Zeros(1, n)
  outIm = matrix.Zeros(1, n)
  for k in 1..n
    for t in 1..n
      angle = direction * 2.0 * math.Pi * (k - 1) * (t - 1) / n
      c = math.Cos(angle)
      s = math.Sin(angle)
      outRe[k] = outRe[k] + re[t] * c - im[t] * s
      outIm[k] = outIm[k] + re[t] * s + im[t] * c
    end
  end
  {Re: outRe, Im: outIm}
end

defn radix2(re, im, direction)
  n = value.Len(re)
  if n == 1
    return {Re: re, Im: im}
  end
  half = math.Div(n, 2)
  even = radix2([re[2 * k - 1] for k in 1..half], [im[2 * k - 1] for k in 1..half], direction)
  odd = radix2([re[2 * k] for k in 1..half], [im[2 * k] for k in 1..half], direction)
  outRe = matrix.Zeros(1, n)
  outIm = matrix.Zeros(1, n)
  for k in 1..half
    angle = direction * 2.0 * math.Pi * (k - 1) / n
    c = math.Cos(angle)
    s = math.Sin(angle)
    tr = odd.Re[k] * c - odd.Im[k] * s
    ti = odd.Re[k] * s + odd.Im[k] * c
    outRe[k] = even.Re[k] + tr
    outIm[k] = even.Im[k] + ti
    outRe[k + half] = even.Re[k] - tr
    outIm[k + half] = even.Im[k] - ti
  end
  {Re: outRe, Im: outIm}
end

isPower(n) = n > 0 and math.BitAnd(n, n - 1) == 0

defn transform(re, im, direction)
  if isPower(value.Len(re)) radix2(re, im, direction) else dft(re, im, direction) end
end

(** The Fourier transform of an array, as a struct with re and im.

      Fft([1.0, 0.0, 0.0, 0.0]).Re --> [1.0, 1.0, 1.0, 1.0] *)
Fft(xs) = transform(xs, matrix.Zeros(1, value.Len(xs)), -1.0)

defn Ifft(f)
  (** The inverse of fft, from a struct with re and im.

        math.Round(Ifft(Fft([1.0, 2.0, 3.0, 4.0])).Re) --> [1.0, 2.0, 3.0, 4.0] *)
  r = transform(f.Re, f.Im, 1.0)
  n = 1.0 * value.Len(f.Re)
  {Re: r.Re / n, Im: r.Im / n}
end

defn Uniform(n)
  (** n floats from 0 included to 1 excluded, drawn by std/random: one generator for the whole program, so that cesia run
      --seed N gives the same ones again. Never for secrets.

        value.Len(Uniform(3)) --> 3 *)
  uniform(n)
end

defn Normal(n)
  (** n floats from the normal distribution, of mean 0 and deviation 1, drawn by std/random as Uniform's are.

        value.Len(Normal(3)) --> 3 *)
  u = Uniform(2 * n)
  values = matrix.Zeros(1, n)
  for k in 1..n
    a = 1.0 - u[2 * k - 1]
    b = u[2 * k]
    values[k] = math.Sqrt(-2.0 * math.Log(a)) * math.Cos(2.0 * math.Pi * b)
  end
  values
end
