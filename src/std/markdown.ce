(** Markdown to HTML: the part of CommonMark that GitHub shows the same way, and its tables. ATX and setext headings,
    paragraphs, emphasis, code spans, fenced code, nested and ordered lists, quotes, tables, links with their URL or a name
    in brackets, rules and hard breaks; no indented code, no raw HTML, no reference definitions. Raw HTML is text: everything a page shows
    is escaped, so a text from anyone is safe in it, and a link leads only to http, https, mailto or a page of the site.
    GitHub's alerts too: a quote whose first line is [!NOTE], [!TIP], [!IMPORTANT], [!WARNING] or [!CAUTION]. And its
    formulas, $...$ in a line and a paragraph of $$...$$, for hooks that write them.
    Parse gives the blocks with their lines; Html writes them, and asks its hooks for the colors of code, the target of a
    name in brackets, the anchor of a heading and the HTML of a formula. *)
use std/dict
use std/list
use std/math
use std/text
use std/value

(** Hooks that add nothing: code in a plain pre, a name in brackets left as text, a link to its address as written,
    headings without an anchor.

      Html(Parse("[Sort]"), Plain) --> "<p>[Sort]</p>\n" *)
Plain = {Code: (info, code, line) -> missing, Link: (target, line) -> missing, Url: (url, line) -> url, Anchor: (level, title, line) -> missing}

(* The text with &, <, > and " written as HTML writes them, as CommonMark writes them: http.Escape is the one for programs. *)
escape(s) = text.Replace("\"", "&quot;", text.Replace(">", "&gt;", text.Replace("<", "&lt;", text.Replace("&", "&amp;", s))))

(* The bytes that may start something inline: \ ` * _ [ ] < and the line end, and $ for hooks that write formulas. Any other
   byte is text. *)
specials = [b == 92 or b == 96 or b == 42 or b == 95 or b == 91 or b == 93 or b == 60 or b == 10 for b in 0..255]
mathSpecials = [specials[b + 1] or b == 36 for b in 0..255]

isPunct(b) = (b >= 33 and b <= 47) or (b >= 58 and b <= 64) or (b >= 91 and b <= 96) or (b >= 123 and b <= 126)

from(k, t) = text.ByteSlice(k, text.ByteLength(t), t)   (** The text from byte k. *)

defn indentOf(t)
  (** The spaces at the start of a line. *)
  n = text.ByteLength(t)
  i = 1
  while i <= n and text.Byte(i, t) == 32
    i += 1
  end
  i - 1
end

isBlank(t) = indentOf(t) == text.ByteLength(t)
dropSpaces(n, t) = from(list.Min(n, indentOf(t)) + 1, t)   (** The line without at most n spaces at its start. *)

(* The blocks. A line is {T, N}: its text, tabs as four spaces, and its number in the file. *)

defn heading(t)
  (** An ATX heading, {Level, Text}, or missing. A closing run of # goes when a space or nothing is before it. *)
  i = indentOf(t)
  n = text.ByteLength(t)
  if i > 3
    return missing
  end
  j = i + 1
  while j <= n and text.Byte(j, t) == 35
    j += 1
  end
  level = j - i - 1
  if level < 1 or level > 6 or (j <= n and text.Byte(j, t) != 32)
    return missing
  end
  words = text.Trim(from(j, t))
  k = text.ByteLength(words)
  while k >= 1 and text.Byte(k, words) == 35
    k -= 1
  end
  if k < text.ByteLength(words) and (k == 0 or text.Byte(k, words) == 32)
    words = text.Trim(text.ByteSlice(1, k, words))
  end
  {Level: level, Text: words}
end

defn isRule(t)
  (** Is this line a thematic break: three or more -, * or _, alone with spaces? *)
  i = indentOf(t)
  n = text.ByteLength(t)
  if i > 3 or i >= n
    return false
  end
  c = text.Byte(i + 1, t)
  if c != 45 and c != 42 and c != 95
    return false
  end
  count = 0
  for j in (i + 1)..n
    b = text.Byte(j, t)
    if b == c
      count += 1
    else if b != 32
      return false
    end
  end
  count >= 3
end

defn setextLevel(t)
  (** 1 for a line of =, 2 for a line of -, which make the paragraph above them a heading; 0 for another line. *)
  i = indentOf(t)
  if i > 3 or i >= text.ByteLength(t)
    return 0
  end
  c = text.Byte(i + 1, t)
  if c != 61 and c != 45
    return 0
  end
  if text.Replace(text.Char(c), "", text.Trim(t)) != ""
    return 0
  end
  if c == 61 1 else 2 end
end

defn fenceOf(t)
  (** An opening fence, {Char, Size, Indent, Info}, or missing. *)
  i = indentOf(t)
  n = text.ByteLength(t)
  if i > 3 or i >= n
    return missing
  end
  c = text.Byte(i + 1, t)
  if c != 96 and c != 126
    return missing
  end
  j = i + 1
  while j <= n and text.Byte(j, t) == c
    j += 1
  end
  info = text.Trim(from(j, t))
  if j - i - 1 < 3 or (c == 96 and text.Contains("`", info))
    return missing
  end
  {Char: c, Size: j - i - 1, Indent: i, Info: info}
end

defn closesFence(t, f)
  (** Does this line close the fence f: as many of its character or more, alone with spaces? *)
  i = indentOf(t)
  n = text.ByteLength(t)
  if i > 3
    return false
  end
  j = i + 1
  while j <= n and text.Byte(j, t) == f.Char
    j += 1
  end
  j - i - 1 >= f.Size and isBlank(from(j, t))
end

defn quoted(t)
  (** The line inside a quote, without its > and the space after it, or missing. *)
  i = indentOf(t)
  n = text.ByteLength(t)
  if i > 3 or i >= n or text.Byte(i + 1, t) != 62
    return missing
  end
  if i + 2 <= n and text.Byte(i + 2, t) == 32 from(i + 3, t) else from(i + 2, t) end
end

defn markerOf(t)
  (** A list marker, {Ordered, Char, Start, Content, Empty}, or missing: Content is the column where the text of the item
      starts, and Empty says that nothing follows the marker. *)
  i = indentOf(t)
  n = text.ByteLength(t)
  if i > 3 or i >= n
    return missing
  end
  c = text.Byte(i + 1, t)
  j = i + 2
  ordered = false
  start = 1
  if c >= 48 and c <= 57
    j = i + 1
    while j <= n and j - i <= 10 and text.Byte(j, t) >= 48 and text.Byte(j, t) <= 57
      j += 1
    end
    if j > n or j - i - 1 > 9 or (text.Byte(j, t) != 46 and text.Byte(j, t) != 41)
      return missing
    end
    start = text.Number(text.ByteSlice(i + 1, j - 1, t))
    c = text.Byte(j, t)
    ordered = true
    j += 1
  else if c != 45 and c != 43 and c != 42
    return missing
  end
  if j <= n and text.Byte(j, t) != 32
    return missing
  end
  rest = from(j, t)
  spaces = indentOf(rest)
  empty = isBlank(rest)
  content = if empty or spaces > 4 j else j - 1 + spaces end
  {Ordered: ordered, Char: c, Start: start, Content: content, Empty: empty}
end

defn interrupts(t)
  (** Does this line start a block that ends a paragraph? A list does only when its first item has text, and an ordered one
      only from 1. *)
  m = markerOf(t)
  isRule(t) or value.IsSome(heading(t)) or value.IsSome(fenceOf(t)) or value.IsSome(quoted(t)) or
    (value.IsSome(m) and not m.Empty and (not m.Ordered or m.Start == 1))
end

defn cells(t)
  (** The cells of a row of a table: the parts between its |, without those at its ends, trimmed. A \| stays in its cell. *)
  s = text.Trim(t)
  if text.StartsWith("|", s)
    s = from(2, s)
  end
  if text.EndsWith("|", s) and not text.EndsWith("\\|", s)
    s = text.ByteSlice(1, text.ByteLength(s) - 1, s)
  end
  out = []
  cell = 1
  i = 1
  n = text.ByteLength(s)
  while i <= n
    b = text.Byte(i, s)
    if b == 92
      i += 2
    else if b == 124
      out = list.Append(text.Replace("\\|", "|", text.Trim(text.ByteSlice(cell, i - 1, s))), out)
      cell = i + 1
      i += 1
    else
      i += 1
    end
  end
  list.Append(text.Replace("\\|", "|", text.Trim(text.ByteSlice(cell, n, s))), out)
end

defn alignments(t)
  (** The alignment of each cell of a delimiter row, "", "left", "center" or "right", or missing for a line that is none. *)
  if not text.Contains("-", t)
    return missing
  end
  out = []
  for c in cells(t)
    n = text.ByteLength(c)
    left = n > 0 and text.Byte(1, c) == 58
    right = n > 1 and text.Byte(n, c) == 58
    inner = text.ByteSlice(if left 2 else 1 end, if right n - 1 else n end, c)
    if inner == "" or text.Replace("-", "", inner) != ""
      return missing
    end
    out = list.Append(if left and right "center" else if right "right" else if left "left" else "" end, out)
  end
  out
end

defn tableAt(ls, i)
  (** Do lines i and i + 1 start a table: a row with a |, then a delimiter row of as many cells? *)
  if i >= value.Len(ls) or not text.Contains("|", ls[i].T) or indentOf(ls[i].T) > 3
    return false
  end
  a = alignments(ls[i + 1].T)
  value.IsSome(a) and value.Len(a) == value.Len(cells(ls[i].T))
end

defn tableFrom(ls, i, gap)
  (** The table that starts at line i, and the line after it. *)
  align = alignments(ls[i + 1].T)
  width = value.Len(align)
  rows = []
  j = i + 2
  while j <= value.Len(ls) and not isBlank(ls[j].T) and not interrupts(ls[j].T)
    row = cells(ls[j].T)
    rows = list.Append([if k <= value.Len(row) row[k] else "" end for k in 1..width], rows)
    j += 1
  end
  {Block: {Kind: "table", Align: align, Head: cells(ls[i].T), Rows: rows, Line: ls[i].N, Gap: gap}, Next: j}
end

defn fenced(ls, i, f)
  (** The text of the code that a fence opens at line i, up to its closing fence or the end, and the line after it. *)
  body = []
  j = i + 1
  n = value.Len(ls)
  while j <= n and not closesFence(ls[j].T, f)
    body = list.Append(dropSpaces(f.Indent, ls[j].T), body)
    j += 1
  end
  {Text: if value.Len(body) == 0 "" else text.Str(text.Join("\n", body), "\n") end, Next: list.Min(j, n) + 1}
end

defn mayGoOn(t)
  (** Can a line that follows this one go on its paragraph, as the lazy lines of CommonMark do? *)
  not isBlank(t) and value.IsMissing(fenceOf(t)) and value.IsMissing(heading(t)) and not isRule(t)
end

defn quoteAt(ls, i)
  (** The lines of the quote that starts at line i, without their >, and the line after it. A line without > goes on a
      paragraph that the quote ends with. *)
  inner = []
  j = i
  lazy = false
  while j <= value.Len(ls)
    q = quoted(ls[j].T)
    if value.IsSome(q)
      inner = list.Append({T: q, N: ls[j].N}, inner)
      lazy = mayGoOn(q)
    else if lazy and not isBlank(ls[j].T) and not interrupts(ls[j].T)
      inner = list.Append(ls[j], inner)
    else
      break
    end
    j += 1
  end
  {Lines: inner, Next: j}
end

defn itemAt(ls, i, m)
  (** The lines of the list item that starts at line i, without the indent of its content; the line after it; and whether
      blank lines end it, which belong to the list. *)
  t = ls[i].T
  lines = [{T: if m.Empty "" else from(m.Content + 1, t) end, N: ls[i].N}]
  lazy = not m.Empty and mayGoOn(lines[1].T)
  ended = false
  j = i + 1
  while j <= value.Len(ls)
    t = ls[j].T
    if isBlank(t)
      (* An item can start with one blank line only: an empty one ends there. *)
      ended = ended or (m.Empty and j == i + 1)
      lines = list.Append({T: "", N: ls[j].N}, lines)
      lazy = false
    else if ended
      break
    else if indentOf(t) >= m.Content
      lines = list.Append({T: from(m.Content + 1, t), N: ls[j].N}, lines)
      lazy = mayGoOn(lines[value.Len(lines)].T)
    else if lazy and not interrupts(t) and value.IsMissing(markerOf(t))
      lines = list.Append(ls[j], lines)
    else
      break
    end
    j += 1
  end
  k = value.Len(lines)
  while k > 1 and lines[k].T == ""
    k -= 1
  end
  {Lines: list.Take(k, lines), Next: j, Trailing: k < value.Len(lines)}
end

defn listAt(ls, i, m, gap)
  (** The list that starts at line i: its items while their markers are of its kind. It is loose when a blank line is between
      two items, or between two blocks of one item. *)
  items = []
  loose = false
  trailing = false
  j = i
  while j <= value.Len(ls)
    k = markerOf(ls[j].T)
    if value.IsMissing(k) or isRule(ls[j].T) or k.Ordered != m.Ordered or k.Char != m.Char
      break
    end
    loose = loose or trailing
    r = itemAt(ls, j, k)
    blocks = blocksOf(r.Lines)
    loose = loose or list.Any([b.Gap for b in blocks])
    items = list.Append(blocks, items)
    trailing = r.Trailing
    j = r.Next
  end
  block = {Kind: "list", Ordered: m.Ordered, Start: m.Start, Tight: not loose, Items: items, Line: ls[i].N, Gap: gap}
  {Block: block, Next: j, Trailing: trailing}
end

paragraph(para, gap) = {Kind: "paragraph", Text: text.Trim(text.Join("\n", [dropSpaces(text.ByteLength(l.T), l.T) for l in para])), Line: para[1].N, Gap: gap}

defn blocksOf(ls)
  (** The blocks of lines {T, N}. Gap says that a blank line is before a block that isn't the first. *)
  out = []
  para = []
  paraGap = false
  blank = false
  i = 1
  n = value.Len(ls)
  while i <= n
    t = ls[i].T
    if isBlank(t)
      if value.Len(para) > 0
        out = list.Append(paragraph(para, paraGap), out)
        para = []
      end
      blank = true
      i += 1
    else if value.Len(para) > 0 and setextLevel(t) > 0
      out = list.Append({Kind: "heading", Level: setextLevel(t), Text: paragraph(para, false).Text, Line: para[1].N, Gap: paraGap}, out)
      para = []
      i += 1
    else if value.Len(para) > 0 and not interrupts(t) and not tableAt(ls, i)
      para = list.Append(ls[i], para)
      i += 1
    else
      if value.Len(para) > 0
        out = list.Append(paragraph(para, paraGap), out)
        para = []
      end
      gap = blank and value.Len(out) > 0
      blank = false
      f = fenceOf(t)
      h = heading(t)
      m = markerOf(t)
      if value.IsSome(f)
        r = fenced(ls, i, f)
        out = list.Append({Kind: "code", Info: unescaped(f.Info), Text: r.Text, Line: ls[i].N, Gap: gap}, out)
        i = r.Next
      else if value.IsSome(h)
        out = list.Append({Kind: "heading", Level: h.Level, Text: h.Text, Line: ls[i].N, Gap: gap}, out)
        i += 1
      else if isRule(t)
        out = list.Append({Kind: "rule", Line: ls[i].N, Gap: gap}, out)
        i += 1
      else if value.IsSome(quoted(t))
        r = quoteAt(ls, i)
        out = list.Append({Kind: "quote", Blocks: blocksOf(r.Lines), Line: ls[i].N, Gap: gap}, out)
        i = r.Next
      else if value.IsSome(m)
        r = listAt(ls, i, m, gap)
        out = list.Append(r.Block, out)
        blank = r.Trailing
        i = r.Next
      else if tableAt(ls, i)
        r = tableFrom(ls, i, gap)
        out = list.Append(r.Block, out)
        i = r.Next
      else
        para = [ls[i]]
        paraGap = gap
        i += 1
      end
    end
  end
  if value.Len(para) > 0 list.Append(paragraph(para, paraGap), out) else out end
end

defn detabbed(line)
  (** A line whose tabs at its start are spaces, up to the next multiple of four: the others stay. *)
  if not text.Contains("\t", line)
    return line
  end
  i = 1
  width = 0
  while i <= text.ByteLength(line) and (text.Byte(i, line) == 32 or text.Byte(i, line) == 9)
    width = if text.Byte(i, line) == 9 width + 4 - math.Mod(width, 4) else width + 1 end
    i += 1
  end
  text.Str(text.Repeat(width, " "), from(i, line))
end

defn Parse(s)
  (** The blocks of a Markdown text, each a dictionary with its Kind and the Line it starts on: "heading" {Level, Text},
      "paragraph" {Text}, "code" {Info, Text}, "quote" {Blocks}, "list" {Ordered, Start, Tight, Items, each an array of
      blocks}, "table" {Align, Head, Rows} and "rule". The texts are as written: Html reads what is inside them.

        Parse("# Title")[1].Level --> 1
        Parse("a\n\n```cesia\nx\n```")[2].Info --> "cesia"
        Parse("a\n\n- b")[2].Line --> 3 *)
  ls = text.Lines(s)
  blocksOf([{T: detabbed(ls[k]), N: k} for k in 1..value.Len(ls)])
end

(* Inline: the text of a paragraph, a heading or a cell becomes nodes, {K: 0, H} for HTML, {K: 1, C, N, O, X, Orig} for a run
   of * or _ that may open or close emphasis, {K: 2, At, Active} for a [, and {K: 3, H, Inner} for a strong emphasis, whose
   tags go when it is right inside another one, as GitHub writes it; then emphasis pairs the runs. *)

nodeHtml(x) = if x.K == 0 or x.K == 3 x.H else if x.K == 1 text.Repeat(x.N, text.Char(x.C)) else "[" end
textNode(t) = {K: 0, H: escape(t)}
ruleOfThree(o, c) = (o.X or c.O) and math.Mod(o.Orig + c.Orig, 3) == 0 and not (math.Mod(o.Orig, 3) == 0 and math.Mod(c.Orig, 3) == 0)

defn emphasized(nodes)
  (** The HTML of inline nodes, once their runs of * and _ are paired as CommonMark pairs them. *)
  xs = nodes
  c = 1
  while c <= value.Len(xs)
    closer = xs[c]
    if closer.K == 1 and closer.X and closer.N > 0
      found = 0
      o = c - 1
      while o >= 1 and found == 0
        d = xs[o]
        if d.K == 1 and d.C == closer.C and d.O and d.N > 0 and not ruleOfThree(d, closer)
          found = o
        end
        o -= 1
      end
      if found == 0
        if not closer.O
          xs[c] = {K: 0, H: nodeHtml(closer)}
        end
        c += 1
      else
        d = xs[found]
        taken = if d.N >= 2 and closer.N >= 2 2 else 1 end
        inner = text.Join("", [if taken == 2 and xs[k].K == 3 xs[k].Inner else nodeHtml(xs[k]) end for k in (found + 1)..(c - 1)])
        made = if taken == 2 {K: 3, H: "<strong>$inner</strong>", Inner: inner} else {K: 0, H: "<em>$inner</em>"} end
        opener = {K: 1, C: d.C, N: d.N - taken, O: d.O, X: d.X, Orig: d.Orig}
        rest = {K: 1, C: closer.C, N: closer.N - taken, O: closer.O, X: closer.X, Orig: closer.Orig}
        xs = list.Concat(list.Take(found - 1, xs), list.Concat([opener, made, rest], list.Skip(c, xs)))
        c = found + 2
      end
    else
      c += 1
    end
  end
  text.Join("", list.Map(nodeHtml, xs))
end

defn unescaped(t)
  (** A text without the \ before its punctuation. *)
  if not text.Contains("\\", t)
    return t
  end
  out = []
  i = 1
  n = text.ByteLength(t)
  while i <= n
    if text.Byte(i, t) == 92 and i < n and isPunct(text.Byte(i + 1, t))
      i += 1
    end
    out = list.Append(text.ByteSlice(i, i, t), out)
    i += 1
  end
  text.Join("", out)
end

defn isSafe(url)
  (** Can a link lead there: a page of the site, or a URL of http, https or mailto? Any other scheme, javascript: first, is
      refused. *)
  colon = text.ByteFind(":", 1, url)
  if value.IsMissing(colon)
    return true
  end
  scheme = text.Lower(text.ByteSlice(1, colon - 1, url))
  isScheme = scheme != "" and list.All([(b >= 97 and b <= 122) or (b >= 48 and b <= 57) or b == 43 or b == 45 or b == 46 for b in text.Bytes(scheme)])
  not isScheme or scheme == "http" or scheme == "https" or scheme == "mailto"
end

defn skipSpaces(t, j)
  i = j
  while i <= text.ByteLength(t) and (text.Byte(i, t) == 32 or text.Byte(i, t) == 10)
    i += 1
  end
  i
end

defn linkTail(t, i)
  (** After the ] of a link, its (destination "title"): {Dest, Title, Next}, or missing if none is there. *)
  n = text.ByteLength(t)
  if i > n or text.Byte(i, t) != 40
    return missing
  end
  j = skipSpaces(t, i + 1)
  dest = ""
  if j <= n and text.Byte(j, t) == 60
    close = text.ByteFind(">", j + 1, t)
    if value.IsMissing(close)
      return missing
    end
    dest = text.ByteSlice(j + 1, close - 1, t)
    if text.Contains("\n", dest) or text.Contains("<", dest)
      return missing
    end
    j = close + 1
  else
    start = j
    depth = 0
    while j <= n and text.Byte(j, t) > 32 and not (text.Byte(j, t) == 41 and depth == 0)
      b = text.Byte(j, t)
      if b == 92 and j < n
        j += 2
      else
        if b == 40
          depth += 1
        else if b == 41
          depth -= 1
        end
        j += 1
      end
    end
    dest = text.ByteSlice(start, j - 1, t)
  end
  spaced = j <= n and (text.Byte(j, t) == 32 or text.Byte(j, t) == 10)
  j = skipSpaces(t, j)
  title = missing
  if j <= n and spaced and (text.Byte(j, t) == 34 or text.Byte(j, t) == 39 or text.Byte(j, t) == 40)
    close = if text.Byte(j, t) == 40 41 else text.Byte(j, t) end
    k = j + 1
    while k <= n and text.Byte(k, t) != close
      k += if text.Byte(k, t) == 92 2 else 1 end
    end
    if k > n
      return missing
    end
    title = unescaped(text.ByteSlice(j + 1, k - 1, t))
    j = skipSpaces(t, k + 1)
  end
  if j > n or text.Byte(j, t) != 41
    return missing
  end
  {Dest: unescaped(dest), Title: title, Next: j + 1}
end

(* The bytes a URL keeps as they are; any other is written %XX, as CommonMark does. *)
urlBytes = [(b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or text.Contains(text.Char(b), "-_.+!*'(),%#@?=;:/&$~") for b in 0..127]

defn hrefOf(url)
  (** A URL as an href holds it: percent-encoded where it must be, and escaped. *)
  out = []
  for b in text.Bytes(url)
    out = list.Append(if b < 128 and urlBytes[b + 1] text.Char(b) else text.Str("%", encodeHex(b)) end, out)
  end
  escape(text.Join("", out))
end

encodeHex(b) = text.Str(text.ByteSlice(math.Div(b, 16) + 1, math.Div(b, 16) + 1, "0123456789ABCDEF"), text.ByteSlice(math.Mod(b, 16) + 1, math.Mod(b, 16) + 1, "0123456789ABCDEF"))

defn anchor(url, title, inner)
  (** The HTML of a link. *)
  more = if value.IsMissing(title) "" else " title=\"$(escape(title))\"" end
  "<a href=\"$(hrefOf(url))\"$more>$inner</a>"
end

defn codeSpan(t, i)
  (** The code span whose run of backticks starts at byte i: {Html, Next}, or missing if no run of that length closes it. *)
  n = text.ByteLength(t)
  j = i
  while j <= n and text.Byte(j, t) == 96
    j += 1
  end
  size = j - i
  while j <= n
    p = text.ByteFind("`", j, t)
    if value.IsMissing(p)
      return missing
    end
    q = p
    while q <= n and text.Byte(q, t) == 96
      q += 1
    end
    if q - p == size
      code = text.Replace("\n", " ", text.ByteSlice(i + size, p - 1, t))
      m = text.ByteLength(code)
      if m >= 2 and text.Byte(1, code) == 32 and text.Byte(m, code) == 32 and text.Trim(code) != ""
        code = text.ByteSlice(2, m - 1, code)
      end
      return {Html: "<code>$(escape(code))</code>", Next: q}
    end
    j = q
  end
  missing
end

defn autolink(t, i)
  (** The link of <http://...>, <https://...> or <mailto:...> at byte i: {Html, Next}, or missing. *)
  close = text.ByteFind(">", i + 1, t)
  if value.IsMissing(close)
    return missing
  end
  url = text.ByteSlice(i + 1, close - 1, t)
  if url == "" or text.Contains(" ", url) or text.Contains("<", url) or text.Contains("\n", url)
    return missing
  end
  colon = text.ByteFind(":", 1, url)
  lower = text.Lower(url)
  if value.IsMissing(colon) and value.Len(text.Split("@", url)) == 2 and not text.StartsWith("@", url) and not text.EndsWith("@", url)
    return {Html: anchor(text.Str("mailto:", url), missing, escape(url)), Next: close + 1}
  end
  if not (text.StartsWith("http://", lower) or text.StartsWith("https://", lower) or text.StartsWith("mailto:", lower))
    return missing
  end
  {Html: anchor(url, missing, escape(url)), Next: close + 1}
end

defn lastBracket(nodes)
  (** The position of the last [ among the nodes, or 0. *)
  k = value.Len(nodes)
  while k >= 1 and nodes[k].K != 2
    k -= 1
  end
  k
end

defn mathSpan(t, i)
  (** The formula whose $ is at byte i, as GitHub reads one: {Tex, Next}, or missing. The $ that opens has no space after it;
      the next $ closes it, with no space before it and no digit after it, on the same line, and no ` between them: "it
      costs $5 and $6" holds none. *)
  n = text.ByteLength(t)
  if i >= n or text.Byte(i + 1, t) == 32 or text.Byte(i + 1, t) == 10 or text.Byte(i + 1, t) == 36
    return missing
  end
  c = text.ByteFind("$", i + 1, t)
  if value.IsMissing(c)
    return missing
  end
  tex = text.ByteSlice(i + 1, c - 1, t)
  before = text.Byte(c - 1, t)
  digit = c < n and text.Byte(c + 1, t) >= 48 and text.Byte(c + 1, t) <= 57
  if before == 32 or before == 92 or digit or text.Contains("\n", tex) or text.Contains("`", tex)
    return missing
  end
  {Tex: tex, Next: c + 1}
end

defn inline(t, hooks, line)
  (** The HTML of the text of a paragraph, a heading or a cell. *)
  nodes = []
  n = text.ByteLength(t)
  i = 1
  plain = 1
  formula = dict.GetOr("Math", missing, hooks)
  starts = if value.IsMissing(formula) specials else mathSpecials end
  while i <= n
    b = text.Byte(i, t)
    if not starts[b + 1]
      i += 1
    else
      upto = i - 1
      if b == 10
        while upto >= plain and text.Byte(upto, t) == 32
          upto -= 1
        end
      end
      if upto >= plain
        nodes = list.Append(textNode(text.ByteSlice(plain, upto, t)), nodes)
      end
      if b == 10
        nodes = list.Append({K: 0, H: if i - 1 - upto >= 2 "<br />\n" else "\n" end}, nodes)
        i = i + 1
        while i <= n and text.Byte(i, t) == 32
          i += 1
        end
      else if b == 92
        if i < n and text.Byte(i + 1, t) == 10
          nodes = list.Append({K: 0, H: "<br />\n"}, nodes)
          i += 2
          while i <= n and text.Byte(i, t) == 32
            i += 1
          end
        else if i < n and isPunct(text.Byte(i + 1, t))
          nodes = list.Append(textNode(text.ByteSlice(i + 1, i + 1, t)), nodes)
          i += 2
        else
          nodes = list.Append(textNode("\\"), nodes)
          i += 1
        end
      else if b == 96
        span = codeSpan(t, i)
        if value.IsSome(span)
          nodes = list.Append({K: 0, H: span.Html}, nodes)
          i = span.Next
        else
          j = i
          while j <= n and text.Byte(j, t) == 96
            j += 1
          end
          nodes = list.Append({K: 0, H: text.ByteSlice(i, j - 1, t)}, nodes)
          i = j
        end
      else if b == 42 or b == 95
        j = i
        while j <= n and text.Byte(j, t) == b
          j += 1
        end
        before = if i > 1 text.Byte(i - 1, t) else 32 end
        after = if j <= n text.Byte(j, t) else 32 end
        spaceBefore = before == 32 or before == 10
        spaceAfter = after == 32 or after == 10
        left = not spaceAfter and (not isPunct(after) or spaceBefore or isPunct(before))
        right = not spaceBefore and (not isPunct(before) or spaceAfter or isPunct(after))
        opens = if b == 42 left else left and (not right or isPunct(before)) end
        closes = if b == 42 right else right and (not left or isPunct(after)) end
        nodes = list.Append({K: 1, C: b, N: j - i, O: opens, X: closes, Orig: j - i}, nodes)
        i = j
      else if b == 91
        nodes = list.Append({K: 2, At: i + 1, Active: true}, nodes)
        i += 1
      else if b == 93
        k = lastBracket(nodes)
        tail = if k > 0 and nodes[k].Active linkTail(t, i + 1) else missing end
        target = if k > 0 and nodes[k].Active and value.IsMissing(tail) hooks.Link(text.ByteSlice(nodes[k].At, i - 1, t), line) else missing end
        url = if value.IsSome(tail) hooks.Url(tail.Dest, line) else missing end
        if value.IsSome(tail) and isSafe(url)
          inner = emphasized(list.Skip(k, nodes))
          nodes = list.Append({K: 0, H: anchor(url, tail.Title, inner)}, list.Take(k - 1, nodes))
          nodes = [if x.K == 2 {K: 2, At: x.At, Active: false} else x end for x in nodes]
          i = tail.Next
        else if value.IsSome(target)
          inner = emphasized(list.Skip(k, nodes))
          nodes = list.Append({K: 0, H: anchor(target, missing, inner)}, list.Take(k - 1, nodes))
          nodes = [if x.K == 2 {K: 2, At: x.At, Active: false} else x end for x in nodes]
          i += 1
        else
          if k > 0
            nodes[k] = {K: 0, H: "["}
          end
          nodes = list.Append({K: 0, H: "]"}, nodes)
          i += 1
        end
      else if b == 36
        span = mathSpan(t, i)
        made = if value.IsSome(span) formula(span.Tex, false, line + text.Count("\n", text.ByteSlice(1, i, t))) else missing end
        if value.IsSome(made)
          nodes = list.Append({K: 0, H: made}, nodes)
          i = span.Next
        else
          nodes = list.Append(textNode("$"), nodes)
          i += 1
        end
      else
        link = autolink(t, i)
        if value.IsSome(link)
          nodes = list.Append({K: 0, H: link.Html}, nodes)
          i = link.Next
        else
          nodes = list.Append({K: 0, H: "&lt;"}, nodes)
          i += 1
        end
      end
      plain = i
    end
  end
  if plain <= n
    nodes = list.Append(textNode(text.ByteSlice(plain, n, t)), nodes)
  end
  emphasized(nodes)
end

(* The writer adds a line end before a block when the last text written doesn't end with one, as CommonMark's does. *)

defn cr(out)
  last = value.Len(out)
  if last > 0 and not text.EndsWith("\n", out[last])
    list.Append("\n", out)
  else
    out
  end
end

defn written(b, hooks, tight, out)
  (** The HTML of block b added to out. In a tight list, a paragraph has no <p>. *)
  kind = b.Kind
  shown = if kind == "paragraph" display(b, hooks) else missing end
  alert = if kind == "quote" alertOf(b) else missing end
  if value.IsSome(shown)
    list.Append(shown, cr(out))
  else if value.IsSome(alert)
    inner = list.Reduce((o, x) -> written(x, hooks, false, o), list.Append("<div class=\"alert $(alert.Kind)\">\n<p class=\"alert-title\">$(alert.Title)</p>\n", cr(out)), alert.Blocks)
    list.Append("</div>\n", cr(inner))
  else if kind == "paragraph"
    if tight
      list.Append(inline(b.Text, hooks, b.Line), out)
    else
      list.Append(text.Str("<p>", inline(b.Text, hooks, b.Line), "</p>\n"), cr(out))
    end
  else if kind == "heading"
    id = hooks.Anchor(b.Level, b.Text, b.Line)
    attribute = if value.IsMissing(id) "" else " id=\"$(escape(id))\"" end
    list.Append(text.Str("<h", b.Level, attribute, ">", inline(b.Text, hooks, b.Line), "</h", b.Level, ">\n"), cr(out))
  else if kind == "code"
    colored = hooks.Code(b.Info, b.Text, b.Line)
    language = if b.Info == "" "" else " class=\"language-$(escape(text.Split(" ", b.Info)[1]))\"" end
    html = if value.IsMissing(colored) "<pre><code$language>$(escape(b.Text))</code></pre>\n" else colored end
    list.Append(html, cr(out))
  else if kind == "rule"
    list.Append("<hr />\n", cr(out))
  else if kind == "quote"
    inner = list.Reduce((o, x) -> written(x, hooks, false, o), list.Append("<blockquote>\n", cr(out)), b.Blocks)
    list.Append("</blockquote>\n", cr(inner))
  else if kind == "list"
    open = if not b.Ordered "<ul>\n" else if b.Start == 1 "<ol>\n" else "<ol start=\"$(b.Start)\">\n" end
    o = list.Append(open, cr(out))
    for item in b.Items
      o = list.Append("<li>", cr(o))
      for x in item
        o = written(x, hooks, b.Tight, if b.Tight and x.Kind == "paragraph" o else cr(o) end)
      end
      if not b.Tight and value.Len(item) > 0
        o = cr(o)
      end
      o = list.Append("</li>\n", o)
    end
    list.Append(if b.Ordered "</ol>\n" else "</ul>\n" end, o)
  else
    list.Append(table(b, hooks), cr(out))
  end
end

defn display(b, hooks)
  (** The HTML of a paragraph that is one formula, $$ ... $$, for hooks that write formulas; else missing. *)
  formula = dict.GetOr("Math", missing, hooks)
  t = b.Text
  n = text.ByteLength(t)
  if value.IsMissing(formula) or n < 4 or not text.StartsWith("$$$$", t) or not text.EndsWith("$$$$", t)
    return missing
  end
  made = formula(text.Trim(text.ByteSlice(3, n - 2, t)), true, b.Line)
  if value.IsMissing(made) missing else text.Str(made, "\n") end
end

alertKinds = ["NOTE", "TIP", "IMPORTANT", "WARNING", "CAUTION"]

defn alertOf(b)
  (** A quote that is one of GitHub's alerts, {Kind, Title, Blocks}: its first line is [!NOTE], [!TIP], [!IMPORTANT], [!WARNING]
      or [!CAUTION], in any case, and something follows it. Else missing. *)
  if value.Len(b.Blocks) == 0 or b.Blocks[1].Kind != "paragraph"
    return missing
  end
  first = b.Blocks[1]
  lines = text.Split("\n", first.Text)
  mark = text.Upper(text.Trim(lines[1]))
  if text.ByteLength(mark) < 4 or not text.StartsWith("[!", mark) or not text.EndsWith("]", mark)
    return missing
  end
  word = text.ByteSlice(3, text.ByteLength(mark) - 1, mark)
  if not (word in alertKinds)
    return missing
  end
  rest = text.Trim(text.Join("\n", list.Skip(1, lines)))
  blocks = list.Concat(if rest == "" [] else [{Kind: "paragraph", Text: rest, Line: first.Line + 1, Gap: false}] end, list.Skip(1, b.Blocks))
  if value.Len(blocks) == 0
    return missing
  end
  {Kind: text.Lower(word), Title: text.Str(text.ByteSlice(1, 1, word), text.Lower(text.ByteSlice(2, text.ByteLength(word), word))), Blocks: blocks}
end

defn table(b, hooks)
  (** The HTML of a table. *)
  attribute(k) = if b.Align[k] == "" "" else " align=\"$(b.Align[k])\"" end
  row(cs, tag) = text.Str("<tr>\n", text.Join("", ["<$tag$(attribute(k))>$(inline(cs[k], hooks, b.Line))</$tag>\n" for k in 1..value.Len(cs)]), "</tr>\n")
  head = text.Str("<table>\n<thead>\n", row(b.Head, "th"), "</thead>\n")
  body = if value.Len(b.Rows) == 0 "" else text.Str("<tbody>\n", text.Join("", [row(r, "td") for r in b.Rows]), "</tbody>\n") end
  text.Str(head, body, "</table>\n")
end

defn Html(blocks, hooks)
  (** The HTML of blocks from Parse. hooks has Code(info, code, line), the HTML of a block of code or missing for a plain
      pre; Link(target, line), the URL of a [target] or missing to leave it as text; Url(url, line), the address a link
      written `[text](url)` leads to; and Anchor(level, title, line), the id of a heading or missing. Plain gives none of them.
      With Math(tex, display, line) too, the text between two $ of a line, or a paragraph between $$ and $$ (display is
      true), is a formula, whose HTML it gives, or missing to leave the text as it is; without it, a $ is text.

        Html(Parse("Some *words*."), Plain) --> "<p>Some <em>words</em>.</p>\n"
        Html(Parse("<script>"), Plain) --> "<p>&lt;script&gt;</p>\n" *)
  text.Join("", list.Reduce((out, b) -> written(b, hooks, false, out), [], blocks))
end
