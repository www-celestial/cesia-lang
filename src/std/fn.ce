(** Functions made of functions: compose them, or run several on one value. To fix an argument, write it, as
    list.Map(it + 2, xs); to pass a value through steps, then. *)
use std/value
use std/math

(**   Identity(3) --> 3 *)
Identity(x) = x
(** A function that always gives x.

      Constantly(7)(1) --> 7 *)
Constantly(x) = y -> x
(** f after g, after h if there is one.

      Compose(math.Inc, it * 2)(3) --> 7 *)
Compose(f, g, h = Identity) = x -> f(g(h(x)))
(**   Complement(math.IsEven)(3) --> true *)
Complement(f) = x -> not f(x)

defn Juxt(f, g, h = missing)
  (** The results of several functions on one value.

        Juxt(math.Inc, math.Dec)(1) --> [2, 0] *)
  if value.IsMissing(h) (x -> [f(x), g(x)]) else (x -> [f(x), g(x), h(x)]) end
end
