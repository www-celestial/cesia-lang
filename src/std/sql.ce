(** Databases through SQL, on SQLite: a pool of connections, rows as maps that share their keys, typed rows, transactions
    and streams. Values only go through ?, never into the text: one statement per call, and sql.Script for a schema. URLs:
    sqlite:PATH and sqlite::memory:. A file needs read and write, for itself and for the files SQLite keeps beside it,
    PATH-wal, PATH-shm and PATH-journal: grant its folder. It uses WAL and foreign keys; a busy database is waited for in
    the fiber, so the other fibers run meanwhile. *)
use std/columns
use std/json
use std/sqlite3
use std/date
use std/bug
use std/dict
use std/fiber
use std/list
use std/matrix
use std/result
use std/text
use std/value

batch = 1024
dateFields = ["Year", "Month", "Day", "Hour", "Minute", "Second", "Offset"]

fault(code, message) = {Kind: "sql", Code: code, Message: message}
failure(code, message) = result.Err(fault(code, message))
doneError() = failure("done", "This transaction has ended: use it only inside its function.")
failed(r) = match r
  result.Err(_) -> true
  else -> false
end
errorOf(r) = match r
  result.Err(e) -> e
  else -> missing
end
codeOf(r) = if failed(r) and value.IsDict(errorOf(r)) dict.Get("Code", errorOf(r)) else missing end
isPanic(x) = value.IsDict(x) and dict.Has("Panic", x)
rethrow(out) = if isPanic(out) bug.Panic(out.Panic) else out end
panicOf(r) = errorOf(r) then {Panic: "$(it.Message) ($(it.File):$(it.Line))"}

defn Open(url, max = 8, wait = 5)
  (** An Ok of a database: a pool of at most max connections, each opened when first needed. A call that finds them all
      busy waits at most wait seconds, then gives an Err with Code "pool". sqlite::memory: keeps one connection, since each
      would hold its own database. Another URL is an Err with Code "url".

        db = result.Unwrap(Open("sqlite::memory:"))
        Open("postgres://localhost/shop") then result.MapErr(it.Code) --> result.Err("url") *)
  if not text.StartsWith("sqlite:", url)
    return failure("url", "No database for $url: use sqlite:PATH or sqlite::memory:.")
  end
  size = if url == "sqlite::memory:" 1 else max end
  if not (value.IsInt(size) and size >= 1)
    return failure("pool", "max is a number of connections, 1 or more.")
  end
  pool = sqlite3.Pool(text.Slice(8, value.Len(url), url), size, wait)?
  result.Ok({Pool: pool, Wait: wait, Tx: false})
end

defn isSet(ch)
  (** Does this one-value channel hold its value? It keeps it. *)
  got = fiber.Receive(ch, timeout = 0)
  if failed(got)
    return false
  end
  fiber.Send(got?, ch)
  true
end

defn sqlValue(v)
  (** A value as SQL takes it: a date.Date as its text in UTC, a list or a map as its JSON. *)
  if value.IsMissing(v) or value.IsBool(v) or value.IsNumber(v) or value.IsText(v)
    return result.Ok(v)
  end
  if value.IsStruct(v) and value.Equal(dict.Keys(dict.Fields(v)), dateFields)
    return result.Ok(text.Replace("T", " ", text.Replace("Z", "", date.Format(date.Utc(v)))))
  end
  if value.IsStruct(v)
    return failure("params", "A struct can't be a value of SQL: give its fields, as dict.Fields(u).Name.")
  end
  if value.IsArray(v) or value.IsDict(v)
    return result.Ok(json.Text(v))
  end
  failure("params", "A function can't be a value of SQL.")
end

defn bound(ps)
  (** The values of a list of parameters: the list itself when SQL takes them all as they are. *)
  if not value.IsArray(ps)
    return failure("params", "The parameters are a list of values, one for each ?: [] for none.")
  end
  for p in ps
    if not (value.IsText(p) or value.IsNumber(p) or value.IsMissing(p) or value.IsBool(p))
      return converted(ps)
    end
  end
  result.Ok(ps)
end

defn converted(ps)
  out = []
  for p in ps
    out = list.Append(sqlValue(p)?, out)
  end
  result.Ok(out)
end

defn rowsOf(b)
  (** The maps of a batch, their keys made public names. *)
  if value.Len(b.Cells) == 0
    return result.Ok([])
  end
  rows = columns.Rows(b.Names, b.Cells, public = true)
  if failed(rows) fault("names", errorOf(rows).Message) then result.Err(it) else rows end
end

defn typed(as, rows)
  (** as(row) for each row: an Ok of the values, or the first Err with the number of its row. *)
  if value.IsMissing(as)
    return result.Ok(rows)
  end
  out = []
  for k in 1..value.Len(rows)
    v = as(rows[k])
    if failed(v)
      e = errorOf(v)
      return result.Err(if value.IsDict(e) dict.Put("Row", k, e) else dict.Put("Row", k, fault("as", value.Text(e))) end)
    end
    out = list.Append(if result.IsOk(v) v? else v end, out)
  end
  result.Ok(out)
end

at(db) = if db.Tx db.Conn else db.Pool end
ended(db) = db.Tx and db.Depth > 0 and isSet(db.Done)

defn settle(r, f, sql, params, db)
  (** What a native call of sqlite3 gave: as it is, or again with the values converted, or the Err of a transaction that
      ended, whose connection the pool took back. *)
  if result.IsOk(r)
    return r
  end
  code = codeOf(r)
  if code == "convert"
    return f(sql, bound(params)?, at(db)) then if codeOf(it) == "closed" and db.Tx doneError() else it end
  end
  if code == "closed" and db.Tx
    return doneError()
  end
  r
end

defn held(f, db)
  (** f(conn) on a connection of db, or on the one of the transaction db is. Outside one, f runs in a fiber of its own, so
      that a panic in it gives the connection back, then panics again. *)
  if db.Tx
    if ended(db)
      return doneError()
    end
    r = f(db.Conn)
    return if codeOf(r) == "closed" doneError() else r end
  end
  conn = sqlite3.Take(db.Pool)?
  r = fiber.Wait(fiber.Spawn(() -> f(conn)))
  sqlite3.Give(conn, db.Pool)
  if failed(r)
    bug.Panic(panicOf(r).Panic)
  end
  r?
end

defn Exec(sql, params, db)
  (** Runs one statement that changes rows: an Ok of {Changed, LastId}, the rows it changed and the id of the last row
      inserted.

        Script("create table notes (id integer primary key, title text not null)", db)
        Exec("insert into notes (title) values (?)", ["buy bread"], db) --> result.Ok({Changed: 1, LastId: 1})
        Exec("insert into notes (title) values (?)", ["call Bo"], db) --> result.Ok({Changed: 1, LastId: 2})
        Exec("insert into notes (title) values (?)", [missing], db) then result.MapErr(it.Code) --> result.Err("23502") *)
  if ended(db)
    return doneError()
  end
  r = sqlite3.Exec(sql, params, at(db))
  if result.IsOk(r) r else settle(r, sqlite3.Exec, sql, params, db) end
end

defn Query(sql, params, db, as = missing)
  (** An Ok of every row, each a map from its column names made public names: created_at is read r.CreatedAt. NULL is
      missing. With as, as(row) for each, as User.From: an Ok of the values, or the first Err with Row, its number.

        Query("select id, title from notes order by id", [], db) --> result.Ok([{Id: 1, Title: "buy bread"}, {Id: 2, Title: "call Bo"}])
        Query("select id as note_id from notes where title = ?", ["call Bo"], db) --> result.Ok([{NoteId: 2}])
        Query("select title from notes where id > ?", [1], db, as = r -> result.Ok(r.Title)) --> result.Ok(["call Bo"]) *)
  if ended(db)
    return doneError()
  end
  r = sqlite3.Query(sql, params, at(db))
  if result.IsOk(r) and value.IsMissing(as) r else typed(as, settle(r, sqlite3.Query, sql, params, db)?) end
end

defn One(sql, params, db, as = missing)
  (** An Ok of the first row, or of missing if there is none; with as, of as(row).

        One("select title from notes where id = ?", [2], db) --> result.Ok({Title: "call Bo"})
        One("select title from notes where id = ?", [9], db) --> result.Ok(missing) *)
  if ended(db)
    return doneError()
  end
  r = sqlite3.One(sql, params, at(db))
  if result.IsOk(r) and value.IsMissing(as)
    return r
  end
  row = settle(r, sqlite3.One, sql, params, db)?
  if value.IsMissing(row) result.Ok(missing) else typed(as, [row]) then result.MapOk(it[1]) end
end

defn cursorOn(sql, ps, conn)
  (** A cursor on one statement, its values converted if SQL doesn't take them as they are. *)
  c = sqlite3.Run(sql, ps, conn)
  if codeOf(c) == "convert" sqlite3.Run(sql, bound(ps)?, conn) else c end
end

defn rowsAt(b, cursor)
  (** The maps of a batch; an Err closes the cursor, which may still have rows. *)
  rows = rowsOf(b)
  if failed(rows) and not b.Done
    sqlite3.Close(cursor)
  end
  rows
end

defn eachBatch(f, as, rows)
  (** f on each row of a batch, in the fiber of the batch: the first Err stops. *)
  for r in typed(as, rows)?
    out = f(r)
    if failed(out)
      return out
    end
  end
  result.Ok(value.Len(rows))
end

defn each(f, sql, ps, as, conn)
  cursor = cursorOn(sql, ps, conn)?
  count = 0
  done = false
  while not done
    b = sqlite3.Next(batch, cursor)?
    rows = rowsAt(b, cursor)?
    done = b.Done
    r = fiber.Wait(fiber.Spawn(() -> eachBatch(f, as, rows)))
    if failed(r) or failed(r?)
      if not done
        sqlite3.Close(cursor)
      end
      return if failed(r) result.Err(panicOf(r)) else r? end
    end
    count = count + r??
  end
  result.Ok(count)
end

defn Each(f, sql, params, db, as = missing)
  (** Calls f on each row, one batch of rows in memory at a time, whatever the size: an Ok of the count. An Err of f stops
      and is given back; a panic in f gives the connection back, then panics again.

        Each(r -> result.Ok(r.Title), "select title from notes", [], db) --> result.Ok(2)
        Each(r -> result.Err(r.Title), "select title from notes order by id", [], db) --> result.Err("buy bread") *)
  r = held(conn -> each(f, sql, params, as, conn), db)
  if failed(r) and isPanic(errorOf(r))
    bug.Panic(errorOf(r).Panic)
  end
  r
end

defn tableCells(sql, ps, conn)
  (** The names and every cell of a statement. *)
  cursor = cursorOn(sql, ps, conn)?
  b = sqlite3.Next(batch, cursor)?
  names = b.Names
  parts = [b.Cells]
  while not b.Done
    b = sqlite3.Next(batch, cursor)?
    parts = list.Append(b.Cells, parts)
  end
  result.Ok({Names: names, Cells: list.Flatten(parts)})
end

defn Table(sql, params, db)
  (** An Ok of {Names, Columns}: Columns a map from each name, made a public name, to its column, a list. A column of
      integers or of floats holds them without a box, as std/frame and the natives of columns want.

        Table("select id, title from notes order by id", [], db) --> result.Ok({Names: ["Id", "Title"], Columns: {Id: [1, 2], Title: ["buy bread", "call Bo"]}}) *)
  b = held(conn -> tableCells(sql, params, conn), db)?
  n = value.Len(b.Names)
  if n == 0
    return result.Ok({Names: [], Columns: dict.Dict()})
  end
  names = dict.Keys(rowsOf({Names: b.Names, Cells: [missing for k in 1..n]})?[1])
  rows = value.Len(b.Cells) / n
  m = matrix.Reshape([n, rows], b.Cells)
  cols = dict.Dict()
  for k in 1..n
    cols = dict.Put(names[k], if rows == 0 [] else [x for x in m[k, :]] end, cols)
  end
  result.Ok({Names: names, Columns: cols})
end

defn Script(sql, db)
  (** Runs several statements, never with parameters: a schema, a migration. An Ok of missing, or the first Err.

        Script("alter table notes add done boolean not null default false; create index by_done on notes (done)", db) --> result.Ok(missing)
        One("select done from notes where id = ?", [1], db) --> result.Ok({Done: false}) *)
  if ended(db)
    return doneError()
  end
  r = sqlite3.Script(sql, at(db))
  if codeOf(r) == "closed" and db.Tx doneError() else r end
end

txExec(sql, tx) = sqlite3.Exec(sql, [], tx.Conn)

defn undo(texts, tx, out)
  (** Rolls back, and gives out. *)
  for t in texts
    _ = txExec(t, tx)
  end
  out
end

defn keep(texts, rollback, tx, v)
  (** Commits: an Ok of v, or the Err of the commit, rolled back. *)
  for t in texts
    c = txExec(t, tx)
    if failed(c)
      return undo(rollback, tx, c)
    end
  end
  result.Ok(v)
end

defn finish(r, commit, rollback, tx)
  (** What f gave, r from Wait: an Ok or a plain value commits, an Err or a panic rolls back. *)
  if failed(r)
    return undo(rollback, tx, panicOf(r))
  end
  v = r?
  if failed(v)
    return undo(rollback, tx, v)
  end
  keep(commit, rollback, tx, if result.IsOk(v) v? else v end)
end

defn Transaction(f, db, read = false)
  (** f(tx) inside a transaction, tx usable as db in every call: an Ok of f commits and gives its value, an Err rolls back
      and gives it, a panic rolls back and panics again. Anything else commits, as an Ok. Inside one, a Transaction of tx
      is a savepoint, rolled back alone. read opens a plain BEGIN, for reads only; else BEGIN IMMEDIATE takes the write
      lock at once. It runs in a fiber of its own: a caller stopped by fiber.Cancel leaves it to end as f says, so that no
      transaction stays open, holding the write lock and its connection.

        add(titles, tx) = [Exec("insert into notes (title) values (?)", [t], tx)?.LastId for t in titles]
        Transaction(tx -> add(["pay rent", "feed cat"], tx), db) --> result.Ok([3, 4])
        Transaction(tx -> add(["water plants", missing], tx), db) then result.MapErr(it.Code) --> result.Err("23502")
        One("select id from notes where title = ?", ["water plants"], db) --> result.Ok(missing) *)
  rethrow(result.Unwrap(fiber.Wait(fiber.Spawn(() -> if db.Tx savepoint(f, db) else whole(f, db, read) end))))
end

defn whole(f, db, read)
  conn = sqlite3.Take(db.Pool)?
  tx = {Pool: db.Pool, Conn: conn, Tx: true, Done: fiber.Channel(), Depth: 0}
  begun = txExec(if read "begin" else "begin immediate" end, tx)
  if failed(begun)
    sqlite3.Give(conn, db.Pool)
    return begun
  end
  r = fiber.Wait(fiber.Spawn(() -> f(tx)))
  fiber.Send(true, tx.Done)
  out = finish(r, ["commit"], ["rollback"], tx)
  sqlite3.Give(conn, db.Pool)
  out
end

defn savepoint(f, tx)
  if isSet(tx.Done)
    return doneError()
  end
  name = "s$(tx.Depth + 1)"
  inner = {Pool: tx.Pool, Conn: tx.Conn, Tx: true, Done: fiber.Channel(), Depth: tx.Depth + 1}
  txExec("savepoint $name", tx)?
  r = fiber.Wait(fiber.Spawn(() -> f(inner)))
  fiber.Send(true, inner.Done)
  finish(r, ["release $name"], ["rollback to $name", "release $name"], tx)
end

defn Close(db)
  (** Closes the free connections now, the others when they come back: a call after it is an Err with Code "closed".

        Close(db)
        Query("select title from notes", [], db) then result.MapErr(it.Code) --> result.Err("closed") *)
  sqlite3.Close(db.Pool)
end
