(** Databases through SQL, on SQLite: a pool of connections, rows as maps that share their keys, typed rows, transactions
    and streams. Values only go through ?, never into the text: one statement per call, and sql.Script for a schema. URLs:
    sqlite:PATH and sqlite::memory:. A file needs read and write, and uses WAL and foreign keys; a busy database is waited
    for in the fiber, so the other fibers run meanwhile. *)
use columns
use json
use sqlite3
use pkg/date

batch = 1024
dateFields = ["Year", "Month", "Day", "Hour", "Minute", "Second"]

fault(code, message) = {Kind: "sql", Code: code, Message: message}
failure(code, message) = Err(fault(code, message))
doneError() = failure("done", "This transaction has ended: use it only inside its function.")
failed(r) = match r
  Err(_) -> true
  else -> false
end
errorOf(r) = match r
  Err(e) -> e
  else -> missing
end
codeOf(r) = if failed(r) and IsDict(errorOf(r)) Get("Code", errorOf(r)) else missing end
isPanic(x) = IsDict(x) and Has("Panic", x)
rethrow(out) = if isPanic(out) Panic(out.Panic) else out end
panicOf(r) = errorOf(r) then {Panic: "$(it.Message) ($(it.File):$(it.Line))"}

defn Open(url, max = 8, wait = 5)
  (** An Ok of a database: a pool of at most max connections, each opened when first needed. A call that finds them all
      busy waits at most wait seconds, then gives an Err with Code "pool". sqlite::memory: keeps one connection, since each
      would hold its own database. Another URL is an Err with Code "url". *)
  if not StartsWith("sqlite:", url)
    return failure("url", "No database for $url: use sqlite:PATH or sqlite::memory:.")
  end
  size = if url == "sqlite::memory:" 1 else max end
  if not (IsInt(size) and size >= 1)
    return failure("pool", "max is a number of connections, 1 or more.")
  end
  pool = sqlite3.Pool(Slice(8, Len(url), url), size, wait)?
  Ok({Pool: pool, Wait: wait, Tx: false})
end

defn isSet(ch)
  (** Does this one-value channel hold its value? It keeps it. *)
  got = Receive(ch, timeout = 0)
  if failed(got)
    return false
  end
  Send(got?, ch)
  true
end

defn value(v)
  (** A value as SQL takes it: a date.Date as its text, a list or a map as its JSON. *)
  if IsMissing(v) or IsBool(v) or IsNumber(v) or IsText(v)
    return Ok(v)
  end
  if IsStruct(v) and Equal(Keys(Fields(v)), dateFields)
    return Ok(Replace("T", " ", Replace("Z", "", date.Format(v))))
  end
  if IsStruct(v)
    return failure("params", "A struct can't be a value of SQL: give its fields, as Fields(u).Name.")
  end
  if IsArray(v) or IsDict(v)
    return Ok(json.Text(v))
  end
  failure("params", "A function can't be a value of SQL.")
end

defn bound(ps)
  (** The values of a list of parameters: the list itself when SQL takes them all as they are. *)
  if not IsArray(ps)
    return failure("params", "The parameters are a list of values, one for each ?: [] for none.")
  end
  for p in ps
    if not (IsText(p) or IsNumber(p) or IsMissing(p) or IsBool(p))
      return converted(ps)
    end
  end
  Ok(ps)
end

defn converted(ps)
  out = []
  for p in ps
    out = Append(value(p)?, out)
  end
  Ok(out)
end

defn rowsOf(b)
  (** The maps of a batch, their keys made public names. *)
  if Len(b.Cells) == 0
    return Ok([])
  end
  rows = columns.Rows(b.Names, b.Cells, public = true)
  if failed(rows) fault("names", errorOf(rows).Message) then Err(it) else rows end
end

defn typed(as, rows)
  (** as(row) for each row: an Ok of the values, or the first Err with the number of its row. *)
  if IsMissing(as)
    return Ok(rows)
  end
  out = []
  for k in 1:Len(rows)
    v = as(rows[k])
    if failed(v)
      e = errorOf(v)
      return Err(if IsDict(e) Put("Row", k, e) else Put("Row", k, fault("as", Text(e))) end)
    end
    out = Append(if IsOk(v) v? else v end, out)
  end
  Ok(out)
end

at(db) = if db.Tx db.Conn else db.Pool end
ended(db) = db.Tx and db.Depth > 0 and isSet(db.Done)

defn settle(r, f, text, params, db)
  (** What a native call of sqlite3 gave: as it is, or again with the values converted, or the Err of a transaction that
      ended, whose connection the pool took back. *)
  if IsOk(r)
    return r
  end
  code = codeOf(r)
  if code == "convert"
    return f(text, bound(params)?, at(db)) then if codeOf(it) == "closed" and db.Tx doneError() else it end
  end
  if code == "closed" and db.Tx
    return doneError()
  end
  r
end

defn held(f, db)
  (** f(conn) on a connection of db, or on the one of the transaction db is. Outside one, f runs in a fiber of its own, so
      that a panic in it gives the connection back, then panics again. *)
  if db.Tx
    if ended(db)
      return doneError()
    end
    r = f(db.Conn)
    return if codeOf(r) == "closed" doneError() else r end
  end
  conn = sqlite3.Take(db.Pool)?
  r = Wait(Spawn(() -> f(conn)))
  sqlite3.Give(conn, db.Pool)
  if failed(r)
    Panic(panicOf(r).Panic)
  end
  r?
end

defn Exec(text, params, db)
  (** Runs one statement that changes rows: an Ok of {Changed, LastId}, the rows it changed and the id of the last row
      inserted. *)
  if ended(db)
    return doneError()
  end
  r = sqlite3.Exec(text, params, at(db))
  if IsOk(r) r else settle(r, sqlite3.Exec, text, params, db) end
end

defn Query(text, params, db, as = missing)
  (** An Ok of every row, each a map from its column names made public names: created_at is read r.CreatedAt. NULL is
      missing. With as, as(row) for each, as User.From: an Ok of the values, or the first Err with Row, its number. *)
  if ended(db)
    return doneError()
  end
  r = sqlite3.Query(text, params, at(db))
  if IsOk(r) and IsMissing(as) r else typed(as, settle(r, sqlite3.Query, text, params, db)?) end
end

defn One(text, params, db, as = missing)
  (** An Ok of the first row, or of missing if there is none; with as, of as(row). *)
  if ended(db)
    return doneError()
  end
  r = sqlite3.One(text, params, at(db))
  if IsOk(r) and IsMissing(as)
    return r
  end
  row = settle(r, sqlite3.One, text, params, db)?
  if IsMissing(row) Ok(missing) else typed(as, [row]) then MapOk(it[1]) end
end

defn cursorOn(text, ps, conn)
  (** A cursor on one statement, its values converted if SQL doesn't take them as they are. *)
  c = sqlite3.Run(text, ps, conn)
  if codeOf(c) == "convert" sqlite3.Run(text, bound(ps)?, conn) else c end
end

defn rowsAt(b, cursor)
  (** The maps of a batch; an Err closes the cursor, which may still have rows. *)
  rows = rowsOf(b)
  if failed(rows) and not b.Done
    sqlite3.Close(cursor)
  end
  rows
end

defn eachBatch(f, as, rows)
  (** f on each row of a batch, in the fiber of the batch: the first Err stops. *)
  for r in typed(as, rows)?
    out = f(r)
    if failed(out)
      return out
    end
  end
  Ok(Len(rows))
end

defn each(f, text, ps, as, conn)
  cursor = cursorOn(text, ps, conn)?
  count = 0
  done = false
  while not done
    b = sqlite3.Next(batch, cursor)?
    rows = rowsAt(b, cursor)?
    done = b.Done
    r = Wait(Spawn(() -> eachBatch(f, as, rows)))
    if failed(r) or failed(r?)
      if not done
        sqlite3.Close(cursor)
      end
      return if failed(r) Err(panicOf(r)) else r? end
    end
    count = count + r??
  end
  Ok(count)
end

defn Each(f, text, params, db, as = missing)
  (** Calls f on each row, one batch of rows in memory at a time, whatever the size: an Ok of the count. An Err of f stops
      and is given back; a panic in f gives the connection back, then panics again. *)
  r = held(conn -> each(f, text, params, as, conn), db)
  if failed(r) and isPanic(errorOf(r))
    Panic(errorOf(r).Panic)
  end
  r
end

defn tableCells(text, ps, conn)
  (** The names and every cell of a statement. *)
  cursor = cursorOn(text, ps, conn)?
  b = sqlite3.Next(batch, cursor)?
  names = b.Names
  parts = [b.Cells]
  while not b.Done
    b = sqlite3.Next(batch, cursor)?
    parts = Append(b.Cells, parts)
  end
  Ok({Names: names, Cells: Flatten(parts)})
end

defn Table(text, params, db)
  (** An Ok of {Names, Columns}: Columns a map from each name, made a public name, to its column, a list. A column of
      integers or of floats holds them without a box, as pkg/frame and the natives of columns want. *)
  b = held(conn -> tableCells(text, params, conn), db)?
  n = Len(b.Names)
  if n == 0
    return Ok({Names: [], Columns: Dict()})
  end
  names = Keys(rowsOf({Names: b.Names, Cells: [missing for k in 1:n]})?[1])
  rows = Len(b.Cells) / n
  m = Reshape(b.Cells, n, rows)
  cols = Dict()
  for k in 1:n
    cols = Put(names[k], if rows == 0 [] else [x for x in m[k, :]] end, cols)
  end
  Ok({Names: names, Columns: cols})
end

defn Script(text, db)
  (** Runs several statements, never with parameters: a schema, a migration. An Ok of missing, or the first Err. *)
  if ended(db)
    return doneError()
  end
  r = sqlite3.Script(text, at(db))
  if codeOf(r) == "closed" and db.Tx doneError() else r end
end

txExec(text, tx) = sqlite3.Exec(text, [], tx.Conn)

defn undo(texts, tx, out)
  (** Rolls back, and gives out. *)
  for t in texts
    txExec(t, tx)
  end
  out
end

defn keep(texts, rollback, tx, v)
  (** Commits: an Ok of v, or the Err of the commit, rolled back. *)
  for t in texts
    c = txExec(t, tx)
    if failed(c)
      return undo(rollback, tx, c)
    end
  end
  Ok(v)
end

defn finish(r, commit, rollback, tx)
  (** What f gave, r from Wait: an Ok or a plain value commits, an Err or a panic rolls back. *)
  if failed(r)
    return undo(rollback, tx, panicOf(r))
  end
  v = r?
  if failed(v)
    return undo(rollback, tx, v)
  end
  keep(commit, rollback, tx, if IsOk(v) v? else v end)
end

defn Transaction(f, db, read = false)
  (** f(tx) inside a transaction, tx usable as db in every call: an Ok of f commits and gives its value, an Err rolls back
      and gives it, a panic rolls back and panics again. Anything else commits, as an Ok. Inside one, a Transaction of tx
      is a savepoint, rolled back alone. read opens a plain BEGIN, for reads only; else BEGIN IMMEDIATE takes the write
      lock at once. *)
  if db.Tx
    return savepoint(f, db)
  end
  conn = sqlite3.Take(db.Pool)?
  tx = {Pool: db.Pool, Conn: conn, Tx: true, Done: Channel(), Depth: 0}
  begun = txExec(if read "begin" else "begin immediate" end, tx)
  if failed(begun)
    sqlite3.Give(conn, db.Pool)
    return begun
  end
  r = Wait(Spawn(() -> f(tx)))
  Send(true, tx.Done)
  out = finish(r, ["commit"], ["rollback"], tx)
  sqlite3.Give(conn, db.Pool)
  rethrow(out)
end

defn savepoint(f, tx)
  if isSet(tx.Done)
    return doneError()
  end
  name = "s$(tx.Depth + 1)"
  inner = {Pool: tx.Pool, Conn: tx.Conn, Tx: true, Done: Channel(), Depth: tx.Depth + 1}
  txExec("savepoint $name", tx)?
  r = Wait(Spawn(() -> f(inner)))
  Send(true, inner.Done)
  rethrow(finish(r, ["release $name"], ["rollback to $name", "release $name"], tx))
end

defn Close(db)
  (** Closes the free connections now, the others when they come back: a call after it is an Err with Code "closed". *)
  sqlite3.Close(db.Pool)
end
