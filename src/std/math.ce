(** Numbers: arithmetic, rounding, trigonometry, bits and the tests of a number. Each function of one number also works on an
    array, element by element. *)

(** One more, and one less. Both work on arrays, element by element.

      Inc(1) --> 2 *)
Inc(x) = x + 1
(** One less: x - 1.

      Dec(1) --> 0 *)
Dec(x) = x - 1
(** The operators as functions, to pass to list.Reduce or list.Map.

      Add(1, 2) --> 3 *)
Add(a, b) = a + b
(** a - b, as a function.

      Sub(5, 2) --> 3 *)
Sub(a, b) = a - b
(** a * b, as a function.

      Mul(2, 3) --> 6 *)
Mul(a, b) = a * b
(** Is x zero? 0.0 is.

      IsZero(0) --> true *)
IsZero(x) = x == 0
(** Is x greater than zero?

      IsPos(1) --> true *)
IsPos(x) = x > 0
(** Is x less than zero?

      IsNeg(1) --> false *)
IsNeg(x) = x < 0
(** Is x even: a multiple of 2?

      IsEven(2) --> true *)
IsEven(x) = Mod(x, 2) == 0
(** Is x odd: not a multiple of 2?

      IsOdd(2) --> false *)
IsOdd(x) = Mod(x, 2) != 0
