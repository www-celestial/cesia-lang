(** Special functions: the gamma and beta functions and their logarithms, the incomplete gamma and beta ratios, the error
    function and their inverses, as scipy.special and R give them. Each comes from a published method, said at its
    function, and the chapter Statistics of the book gives the precision measured for each. A function of x also works
    on an array, element by element; its other arguments are numbers. *)
use std/bug
use std/columns as col
use std/math
use std/matrix
use std/value

(* The constants are written out where they are used, as machine code reads a literal but not a name of the module:
   2.220446049250313e-16 is 2.220446049250313e-16, 2^-52, the distance from 1.0 to the next float; 1.0 / 0.0 is the infinity;
   0.9189385332046728 is log sqrt(2 pi), 2.5066282746310002 sqrt(2 pi), 0.5641895835477563 1 / sqrt(pi),
   1.4142135623730951 sqrt 2, and 3.141592653589793 pi. A whole number near x is (x + 1.5 2^52) - 1.5 2^52, as
   math.Floor isn't machine code either, nor math.Pi and math.Nan, written 0.0 / 0.0. *)

defn brief(v)
  (** A value as an error shows it. *)
  if value.IsText(v) "\"$v\"" else value.Text(v) end
end

defn floats(x, name)
  (** An array of numbers as an array of floats of the same shape, or a panic that names what isn't a number. *)
  if not value.IsArray(x)
    bug.Panic("$name: x is $(brief(x)); give a number or an array of numbers.")
  end
  if col.Kind(x) == "value"
    for k in 1..value.Len(x)
      if not value.IsNumber(x[k])
        bug.Panic("$name: x[$k] is $(brief(x[k])); give numbers.")
      end
    end
  end
  1.0 * x
end

(* One loop for each function over an array, each its own, as a loop that calls a function given as a value becomes
   machine code only for the first function it meets; and each calls its function through a local name, f = erfF,
   which the JIT makes native for an argument read from an array, where a direct call needs types it can't infer. *)

defn number(v, what, name)
  (** v as a float, or a panic that names it. *)
  if not value.IsNumber(v)
    bug.Panic("$name: $what is $(brief(v)); give one number.")
  end
  1.0 * v
end

(* ---- Elementary helpers, from the floats of exp and log alone. *)

defn log1p(x)
  (** log(1 + x), accurate for a small x: Goldberg (1991), theorem 4. *)
  if x > 1.0e300
    return math.Log(x)
  end
  u = 1.0 + x
  if u == 1.0
    return x
  end
  if u <= 0.0
    return if u == 0.0 (-(1.0 / 0.0)) else (0.0 / 0.0) end
  end
  math.Log(u) * x / (u - 1.0)
end

defn expm1(x)
  (** exp(x) - 1, accurate for a small x, by Kahan's correction of exp(x) - 1. *)
  if x > 709.0
    return math.Exp(x)
  end
  u = math.Exp(x)
  if u == 1.0
    return x
  end
  um = u - 1.0
  if um == -1.0
    return -1.0
  end
  um * x / math.Log(u)
end

defn log1pmx(x)
  (** log(1 + x) - x. For |x| <= 1/2, from log(1 + x) = 2 atanh(s), s = x / (2 + x), and x - 2 s = s x, so that the
      difference loses nothing. *)
  if x < -0.5 or x > 0.5
    return log1p(x) - x
  end
  s = x / (2.0 + x)
  t = s * s
  w = 0.3333333333333333 + t * (0.2 + t * (0.14285714285714285 + t * (0.1111111111111111 + t * (0.09090909090909091
    + t * (0.07692307692307693 + t * (0.06666666666666667 + t * (0.058823529411764705 + t * (0.05263157894736842
    + t * (0.047619047619047616 + t * (0.043478260869565216 + t * (0.04 + t * (0.037037037037037035
    + t * (0.034482758620689655 + t * (0.03225806451612903 + t * (0.030303030303030304 + t * (0.02857142857142857
    + t * 0.02702702702702703))))))))))))))))
  -s * x + 2.0 * s * t * w
end

defn corr(x)
  (** Stirling's correction for x >= 10: log Gamma(x) - ((x - 1/2) log x - x + log sqrt(2 pi)), the series of the
      Bernoulli numbers B(2k) / (2k (2k - 1) x^(2k - 1)), eight terms. *)
  r = 1.0 / x
  r2 = r * r
  r * (0.08333333333333333 + r2 * (-0.002777777777777778 + r2 * (0.0007936507936507937 + r2 * (-0.0005952380952380953
    + r2 * (0.0008417508417508417 + r2 * (-0.0019175269175269176 + r2 * (0.00641025641025641
    + r2 * -0.029550653594771242)))))))
end

defn g2(z)
  (** log Gamma(2 + z) for |z| <= 1/2: (1 - gamma) z + sum (-1)^k (zeta(k) - 1) z^k / k, k from 2 to 28, the Taylor series
      at 2 (Abramowitz and Stegun 6.1.33), whose coefficients were computed to 60 digits. *)
  s = 0.3224670334241132 + z * (-0.0673523010531981 + z * (0.020580808427784546 + z * (-0.007385551028673986
    + z * (0.0028905103307415234 + z * (-0.001192753911703261 + z * (0.0005096695247430425
    + z * (-0.00022315475845357939 + z * (9.945751278180853e-05 + z * (-4.492623673813314e-05
    + z * (2.050721277567069e-05 + z * (-9.439488275268397e-06 + z * (4.374866789907488e-06
    + z * (-2.039215753801366e-06 + z * (9.55141213040742e-07 + z * (-4.492469198764566e-07
    + z * (2.1207184805554665e-07 + z * (-1.0043224823968099e-07 + z * (4.7698101693639804e-08
    + z * (-2.2711094608943164e-08 + z * (1.0838659214896955e-08 + z * (-5.183475041970047e-09
    + z * (2.4836745438024785e-09 + z * (-1.1921401405860912e-09 + z * (5.731367241678862e-10
    + z * (-2.7595228851242334e-10 + z * 1.330476437424449e-10)))))))))))))))))))))))))
  z * (0.42278433509846713 + z * s)
end

defn sinpi(x)
  (** sin(pi x), from x - n, n the nearest whole number, a difference that is exact. *)
  if math.Abs(x) >= 4503599627370496.0
    return 0.0
  end
  n = (x + 6755399441055744.0) - 6755399441055744.0
  t = math.Sin(3.141592653589793 * (x - n))
  h = 0.5 * n
  if h == (h + 6755399441055744.0) - 6755399441055744.0 t else 0.0 - t end
end

(* ---- Gamma and beta. *)

defn lgamma(x)
  (** log |Gamma(x)|. *)
  if x != x
    return x
  end
  if x <= 0.0
    if math.Abs(x) >= 4503599627370496.0 or x == (x + 6755399441055744.0) - 6755399441055744.0
      return 1.0 / 0.0
    end
    return math.Log(3.141592653589793 / math.Abs(sinpi(x) * x)) - lgamma(-x)
  end
  if x < 0.5
    return g2(x) - math.Log(x) - log1p(x)
  end
  if x < 1.5
    return g2(x - 1.0) - log1p(x - 1.0)
  end
  if x <= 2.5
    return g2(x - 2.0)
  end
  if x < 10.0
    y = x
    p = 1.0
    while y > 2.5
      y = y - 1.0
      p = p * y
    end
    return g2(y - 2.0) + math.Log(p)
  end
  if x > 2.55e305
    return (1.0 / 0.0)
  end
  (x - 0.5) * math.Log(x) - x + 0.9189385332046728 + corr(x)
end

defn gammaF(x)
  (** Gamma(x). *)
  if x != x
    return x
  end
  if x <= 0.0
    if x == 0.0
      return 1.0 / x
    end
    if math.Abs(x) >= 4503599627370496.0 or x == (x + 6755399441055744.0) - 6755399441055744.0
      return (0.0 / 0.0)
    end
    return 3.141592653589793 / (sinpi(x) * (-x) * gammaF(-x))
  end
  if x < 0.5
    return math.Exp(g2(x)) / (x * (1.0 + x))
  end
  if x < 1.5
    return math.Exp(g2(x - 1.0)) / x
  end
  if x < 10.0
    y = x
    p = 1.0
    while y > 2.5
      y = y - 1.0
      p = p * y
    end
    return math.Exp(g2(y - 2.0)) * p
  end
  if x > 171.7
    return (1.0 / 0.0)
  end
  h = x ^ ((x - 0.5) / 2.0)
  2.5066282746310002 * h * (h * math.Exp(-x)) * math.Exp(corr(x))
end

defn lbeta(a, b)
  (** log B(a, b), a, b >= 0. For large arguments, Stirling's series with its corrections apart, so that nothing large
      cancels: log Gamma(q) - log Gamma(p + q) = -(q - 1/2) log1pmx(p / q) + p / (2 q) - p log(p + q) + corrections. *)
  p = if a < b a else b end
  q = if a < b b else a end
  if p != p or q != q or p < 0.0
    return (0.0 / 0.0)
  end
  if p == 0.0
    return (1.0 / 0.0)
  end
  if q == (1.0 / 0.0)
    return -(1.0 / 0.0)
  end
  if p >= 10.0
    c = corr(p) + corr(q) - corr(p + q)
    return -0.5 * math.Log(q) + 0.9189385332046728 + c + (p - 0.5) * math.Log(p / (p + q)) + q * log1p(-p / (p + q))
  end
  if q >= 10.0
    c = corr(q) - corr(p + q)
    return lgamma(p) + c - (q - 0.5) * log1pmx(p / q) + 0.5 * p / q - p * math.Log(p + q)
  end
  math.Log(gammaF(p) * (gammaF(q) / gammaF(p + q)))
end

defn betaF(a, b)
  (** B(a, b). *)
  if a + b < 171.0 and a > 0.0 and b > 0.0
    p = if a < b b else a end
    q = if a < b a else b end
    return gammaF(p) / gammaF(p + q) * gammaF(q)
  end
  if a != a or b != b or a < 0.0 or b < 0.0
    return (0.0 / 0.0)
  end
  math.Exp(lbeta(a, b))
end

defn gammaArray(xs)
  (** gammaF(x) for each element. *)
  f = gammaF
  n = value.Len(xs)
  out = matrix.Zeros(1, n)
  for k in 1..n
    out[k] = f(xs[k])
  end
  out
end

defn Gamma(x)
  (** The gamma function: (n - 1)! at a whole n, and pi / (sin(pi x) Gamma(1 - x)) below 0; infinite at 0 with the sign
      of the zero, NaN at the negative whole numbers. From the Taylor series of log Gamma at 2, then the recurrence
      Gamma(x + 1) = x Gamma(x), and Stirling's series from 10.

        Gamma(5) --> 24.0
        Gamma(0.5) --> 1.772453850905516
        Gamma([1, 2, 3]) --> [1.0, 1.0, 2.0] *)
  if value.IsNumber(x)
    return gammaF(1.0 * x)
  end
  matrix.Reshape(value.Size(x), gammaArray(floats(x, "special.Gamma")))
end

defn lgammaArray(xs)
  (** lgamma(x) for each element. *)
  f = lgamma
  n = value.Len(xs)
  out = matrix.Zeros(1, n)
  for k in 1..n
    out[k] = f(xs[k])
  end
  out
end

defn LogGamma(x)
  (** The logarithm of |Gamma(x)|, which stays finite where Gamma overflows, past 171.6.

        LogGamma(100) --> 359.1342053695754
        LogGamma(0.5) --> 0.5723649429247001 *)
  if value.IsNumber(x)
    return lgamma(1.0 * x)
  end
  matrix.Reshape(value.Size(x), lgammaArray(floats(x, "special.LogGamma")))
end

defn betaArray(a, xs)
  (** betaF(a, x) for each element. *)
  f = betaF
  n = value.Len(xs)
  out = matrix.Zeros(1, n)
  for k in 1..n
    out[k] = f(a, xs[k])
  end
  out
end

defn Beta(a, b)
  (** The beta function, B(a, b) = Gamma(a) Gamma(b) / Gamma(a + b), for a and b of 0 or more; b may be an array.

        Beta(2, 3) --> 0.08333333333333333 *)
  if value.IsNumber(a) and value.IsNumber(b)
    return betaF(1.0 * a, 1.0 * b)
  end
  a = number(a, "a", "special.Beta")
  matrix.Reshape(value.Size(b), betaArray(a, floats(b, "special.Beta")))
end

defn lbetaArray(a, xs)
  (** lbeta(a, x) for each element. *)
  f = lbeta
  n = value.Len(xs)
  out = matrix.Zeros(1, n)
  for k in 1..n
    out[k] = f(a, xs[k])
  end
  out
end

defn LogBeta(a, b)
  (** The logarithm of B(a, b), which stays finite for large a and b; b may be an array.

        LogBeta(1000, 1000) --> -1388.482601635902 *)
  if value.IsNumber(a) and value.IsNumber(b)
    return lbeta(1.0 * a, 1.0 * b)
  end
  a = number(a, "a", "special.LogBeta")
  matrix.Reshape(value.Size(b), lbetaArray(a, floats(b, "special.LogBeta")))
end

(* ---- The error function: the rational approximations of Cody (1969), on three intervals, the coefficients of his
   SPECFUN (1993). *)

defn erfSmall(y)
  (** erf(y) for |y| <= 0.46875. *)
  z = y * y
  num = 3209.3775891384694 + z * (377.485237685302 + z * (113.86415415105016 + z * (3.1611237438705655
    + z * 0.18577770618460315)))
  den = 2844.236833439171 + z * (1282.6165260773723 + z * (244.02463793444417 + z * (23.601290952344122 + z)))
  y * num / den
end

defn erfcScaled(y)
  (** erfc(y) exp(y^2) for y > 0.46875. *)
  if y <= 4.0
    num = 1230.3393547979972 + y * (2051.0783778260716 + y * (1712.0476126340707 + y * (881.952221241769
      + y * (298.6351381974001 + y * (66.11919063714163 + y * (8.883149794388377 + y * (0.5641884969886701
      + y * 2.1531153547440383e-08)))))))
    den = 1230.3393548037495 + y * (3439.3676741437216 + y * (4362.619090143247 + y * (3290.7992357334597
      + y * (1621.3895745666903 + y * (537.1811018620099 + y * (117.6939508913125 + y * (15.744926110709835 + y)))))))
    return num / den
  end
  z = 1.0 / (y * y)
  num = 0.0006587491615298378 + z * (0.016083785148742275 + z * (0.12578172611122926 + z * (0.36034489994980445
    + z * (0.30532663496123236 + z * 0.016315387137302097))))
  den = 0.0023352049762686918 + z * (0.06051834131244132 + z * (0.5279051029514285 + z * (1.8729528499234673
    + z * (2.568520192289822 + z))))
  (0.5641895835477563 - z * num / den) / y
end

defn expMinusSquare(x, h)
  (** exp(-h x^2), h = 1 or 1/2, with x split into a number of 1/16ths, whose square is exact, and the rest: the square
      of a large x would lose its last digits, and the exponential multiplies that error by x^2. *)
  if x > 40.0
    return 0.0
  end
  xs = ((x * 16.0 + 6755399441055744.0) - 6755399441055744.0) / 16.0
  d = (x - xs) * (x + xs)
  math.Exp(-h * xs * xs) * math.Exp(-h * d)
end

defn erfcF(x)
  (** erfc(x). *)
  if x != x
    return x
  end
  y = math.Abs(x)
  if y <= 0.46875
    return 1.0 - erfSmall(x)
  end
  r = if y > 27.3 0.0 else expMinusSquare(y, 1.0) * erfcScaled(y) end
  if x < 0.0 2.0 - r else r end
end

defn erfF(x)
  (** erf(x). *)
  if x != x
    return x
  end
  y = math.Abs(x)
  if y <= 0.46875
    return erfSmall(x)
  end
  r = if y > 6.0 0.0 else expMinusSquare(y, 1.0) * erfcScaled(y) end
  if x < 0.0 r - 1.0 else 1.0 - r end
end

defn erfArray(xs)
  (** erfF(x) for each element. *)
  f = erfF
  n = value.Len(xs)
  out = matrix.Zeros(1, n)
  for k in 1..n
    out[k] = f(xs[k])
  end
  out
end

defn Erf(x)
  (** The error function, 2 / sqrt(pi) times the integral of exp(-t^2) from 0 to x.

        Erf(0.5) --> 0.5204998778130465
        Erf([0, 2]) --> [0.0, 0.9953222650189527] *)
  if value.IsNumber(x)
    return erfF(1.0 * x)
  end
  matrix.Reshape(value.Size(x), erfArray(floats(x, "special.Erf")))
end

defn erfcArray(xs)
  (** erfcF(x) for each element. *)
  f = erfcF
  n = value.Len(xs)
  out = matrix.Zeros(1, n)
  for k in 1..n
    out[k] = f(xs[k])
  end
  out
end

defn Erfc(x)
  (** The complementary error function, 1 - Erf(x), computed directly so that it keeps its digits for a large x, down
      to about 1e-308 at x = 26.5.

        Erfc(5) --> 1.537459794428035e-12 *)
  if value.IsNumber(x)
    return erfcF(1.0 * x)
  end
  matrix.Reshape(value.Size(x), erfcArray(floats(x, "special.Erfc")))
end

defn erfcxF(x)
  (** erfc(x) exp(x^2). *)
  if x != x
    return x
  end
  y = math.Abs(x)
  if y <= 0.46875
    return math.Exp(x * x) * (1.0 - erfSmall(x))
  end
  if x > 0.0
    return erfcScaled(x)
  end
  if x < -26.7
    return (1.0 / 0.0)
  end
  e = 1.0 / expMinusSquare(y, 1.0)
  2.0 * e - erfcScaled(y)
end

defn erfcxArray(xs)
  (** erfcxF(x) for each element. *)
  f = erfcxF
  n = value.Len(xs)
  out = matrix.Zeros(1, n)
  for k in 1..n
    out[k] = f(xs[k])
  end
  out
end

defn Erfcx(x)
  (** The scaled complementary error function, Erfc(x) exp(x^2), which stays near 1 / (x sqrt(pi)) for a large x
      where Erfc underflows; the normal law's cumulative distribution of std/stats is built on it.

        Erfcx(30) --> 0.01879588886141675 *)
  if value.IsNumber(x)
    return erfcxF(1.0 * x)
  end
  matrix.Reshape(value.Size(x), erfcxArray(floats(x, "special.Erfcx")))
end

(* ---- The normal quantile: PPND16 of Wichura (1988), rational approximations in three regions of p. *)

defn ndtri(q, r)
  (** The quantile of the standard normal at p, given q = p - 1/2 and r = min(p, 1 - p), each exact from its caller. *)
  if math.Abs(q) <= 0.425
    s = 0.180625 - q * q
    num = 3.3871328727963665 + s * (133.14166789178438 + s * (1971.5909503065513 + s * (13731.69376550946
      + s * (45921.95393154987 + s * (67265.7709270087 + s * (33430.57558358813 + s * 2509.0809287301227))))))
    den = 1.0 + s * (42.31333070160091 + s * (687.1870074920579 + s * (5394.196021424751 + s * (21213.794301586597
      + s * (39307.89580009271 + s * (28729.085735721943 + s * 5226.495278852546))))))
    return q * (num / den)
  end
  if r <= 0.0
    return if q < 0.0 (-(1.0 / 0.0)) else (1.0 / 0.0) end
  end
  s = math.Sqrt(-math.Log(r))
  z = 0.0
  if s <= 5.0
    t = s - 1.6
    num = 1.4234371107496835 + t * (4.630337846156546 + t * (5.769497221460691 + t * (3.6478483247632045
      + t * (1.2704582524523684 + t * (0.2417807251774506 + t * (0.022723844989269184 + t * 0.0007745450142783414))))))
    den = 1.0 + t * (2.053191626637759 + t * (1.6763848301838038 + t * (0.6897673349851 + t * (0.14810397642748008
      + t * (0.015198666563616457 + t * (0.0005475938084995345 + t * 1.0507500716444169e-09))))))
    z = num / den
  else
    t = s - 5.0
    num = 6.657904643501103 + t * (5.463784911164114 + t * (1.7848265399172913 + t * (0.29656057182850487
      + t * (0.026532189526576124 + t * (0.0012426609473880784 + t * (2.7115555687434876e-05
      + t * 2.0103343992922881e-07))))))
    den = 1.0 + t * (0.599832206555888 + t * (0.1369298809227358 + t * (0.014875361290850615 + t * (0.0007868691311456133
      + t * (1.8463183175100548e-05 + t * (1.421511758316446e-07 + t * 2.0442631033899397e-15))))))
    z = num / den
  end
  if q < 0.0 (-z) else z end
end

defn erfInvF(y)
  if y != y or y < -1.0 or y > 1.0
    return (0.0 / 0.0)
  end
  ndtri(0.5 * y, 0.5 * (1.0 - math.Abs(y))) / 1.4142135623730951
end

defn erfcInvF(y)
  if y != y or y < 0.0 or y > 2.0
    return (0.0 / 0.0)
  end
  -ndtri(0.5 * (y - 1.0), 0.5 * (if y < 1.0 y else 2.0 - y end)) / 1.4142135623730951
end

defn erfInvArray(xs)
  (** erfInvF(x) for each element. *)
  f = erfInvF
  n = value.Len(xs)
  out = matrix.Zeros(1, n)
  for k in 1..n
    out[k] = f(xs[k])
  end
  out
end

defn ErfInv(y)
  (** The inverse of Erf: the x where Erf(x) = y, for y from -1 to 1; NaN outside. From the normal quantile of Wichura
      (1988), as Erf(x) = 2 P(Z <= x sqrt 2) - 1.

        ErfInv(0.5) --> 0.4769362762044698 *)
  if value.IsNumber(y)
    return erfInvF(1.0 * y)
  end
  matrix.Reshape(value.Size(y), erfInvArray(floats(y, "special.ErfInv")))
end

defn erfcInvArray(xs)
  (** erfcInvF(x) for each element. *)
  f = erfcInvF
  n = value.Len(xs)
  out = matrix.Zeros(1, n)
  for k in 1..n
    out[k] = f(xs[k])
  end
  out
end

defn ErfcInv(y)
  (** The inverse of Erfc: the x where Erfc(x) = y, for y from 0 to 2, which keeps its digits for a small y.

        ErfcInv(1e-100) --> 15.065574702592643 *)
  if value.IsNumber(y)
    return erfcInvF(1.0 * y)
  end
  matrix.Reshape(value.Size(y), erfcInvArray(floats(y, "special.ErfcInv")))
end

(* ---- The incomplete gamma ratios P(a, x) and Q(a, x) = 1 - P(a, x), by the regions of DiDonato and Morris (1986):
   Temme's uniform expansion near the transition x = a for a large a, the series of P below it, Legendre's continued
   fraction for Q above it, and for a small a a series of Q itself. *)

defn gam1(a)
  (** 1 / Gamma(1 + a) - 1 for 0 <= a <= 1, without the cancellation near a = 0 and a = 1. *)
  if a <= 0.5
    return expm1(log1p(a) - g2(a))
  end
  expm1(-g2(a - 1.0))
end

defn rcomp(a, x)
  (** x^a e^-x / Gamma(a), a > 0, x > 0: by pow and exp where neither overflows, else in logarithms, through
      lambda = x / a for a large a: sqrt(a / (2 pi)) exp(a (log lambda - lambda + 1) - corr(a)). *)
  t = a * math.Log(x)
  if a < 171.0 and x < 708.0 and t < 709.0 and t - x > -708.0
    return x ^ a * math.Exp(-x) / gammaF(a)
  end
  if a < 20.0
    return math.Exp(t - x - lgamma(a))
  end
  math.Sqrt(a / (2.0 * 3.141592653589793)) * math.Exp(a * log1pmx((x - a) / a) - corr(a))
end

defn temme(a, x, up)
  (** Q(a, x), or P with upper false, for a >= 20 and 0.6 <= x / a <= 1.4: Temme's uniform asymptotic expansion
      (DLMF 8.12.3, 8.12.4, 8.12.7): Q = erfc(eta sqrt(a / 2)) / 2 + exp(-a eta^2 / 2) / sqrt(2 pi a) sum c_k(eta) a^-k,
      eta^2 / 2 = lambda - 1 - log lambda. The coefficients d(k, n) of c_k(eta) = sum d(k, n) eta^n come from the
      recurrence of DLMF 8.12.12, computed exactly in rationals: 12 terms in k, 142 coefficients in all, enough for
      1e-18 at a = 20 and |eta| = 0.48. *)
  m = (x - a) / a
  phi = -log1pmx(m)
  eta = math.Sqrt(2.0 * phi)
  if m < 0.0
    eta = -eta
  end
  c0 = -0.3333333333333333 + eta * (0.08333333333333333 + eta * (-0.014814814814814815 + eta * (0.0011574074074074073 +
    eta * (0.0003527336860670194 + eta * (-0.0001787551440329218 + eta * (3.919263178522438e-05 + eta *
    (-2.185448510679992e-06 + eta * (-1.85406221071516e-06 + eta * (8.296711340953087e-07 + eta *
    (-1.7665952736826078e-07 + eta * (6.707853543401498e-09 + eta * (1.0261809784240309e-08 + eta *
    (-4.382036018453353e-09 + eta * (9.14769958223679e-10 + eta * (-2.5514193994946248e-11 + eta *
    (-5.830772132550426e-11 + eta * (2.4361948020667415e-11 + eta * (-5.0276692801141755e-12))))))))))))))))))
  c1 = -0.001851851851851852 + eta * (-0.003472222222222222 + eta * (0.0026455026455026454 + eta *
    (-0.0009902263374485596 + eta * (0.00020576131687242798 + eta * (-4.018775720164609e-07 + eta *
    (-1.8098550334489977e-05 + eta * (7.64916091608111e-06 + eta * (-1.6120900894563446e-06 + eta *
    (4.647127802807434e-09 + eta * (1.378633446915721e-07 + eta * (-5.752545603517705e-08 + eta *
    (1.1951628599778148e-08 + eta * (-1.7543241719747647e-11 + eta * (-1.0091543710600413e-09 + eta *
    (4.162792991842583e-10 + eta * (-8.56390702649298e-11))))))))))))))))
  c2 = 0.004133597883597883 + eta * (-0.0026813271604938273 + eta * (0.0007716049382716049 + eta *
    (2.0093878600823047e-06 + eta * (-0.0001073665322636516 + eta * (5.2923448829120125e-05 + eta *
    (-1.2760635188618728e-05 + eta * (3.423578734096138e-08 + eta * (1.3721957309062934e-06 + eta *
    (-6.298992138380055e-07 + eta * (1.4280614206064242e-07 + eta * (-2.0477098421990866e-10 + eta *
    (-1.409252991086752e-08 + eta * (6.228974084922022e-09 + eta * (-1.3670488396617114e-09 + eta *
    (9.428356159014678e-13 + eta * (1.2872252400089318e-10))))))))))))))))
  c3 = 0.0006494341563786008 + eta * (0.00022947209362139917 + eta * (-0.0004691894943952557 + eta *
    (0.00026772063206283885 + eta * (-7.561801671883977e-05 + eta * (-2.396505113867297e-07 + eta *
    (1.1082654115347302e-05 + eta * (-5.6749528269915965e-06 + eta * (1.4230900732435883e-06 + eta *
    (-2.7861080291528143e-11 + eta * (-1.6958404091930278e-07 + eta * (8.099464905388083e-08 + eta *
    (-1.9111168485973655e-08 + eta * (2.3928620439808118e-12 + eta * (2.0620131815488797e-09 + eta *
    (-9.460496661855133e-10)))))))))))))))
  c4 = -0.0008618882909167117 + eta * (0.0007840392217200666 + eta * (-0.0002990724803031902 + eta *
    (-1.4638452578843418e-06 + eta * (6.641498215465122e-05 + eta * (-3.968365047179435e-05 + eta *
    (1.1375726970678419e-05 + eta * (2.507497226237533e-10 + eta * (-1.6954149536558305e-06 + eta *
    (8.907507532205309e-07 + eta * (-2.292934834000805e-07 + eta * (2.956794137544049e-11 + eta *
    (2.8865829742708783e-08 + eta * (-1.4189739437803219e-08)))))))))))))
  c5 = -0.00033679855336635813 + eta * (-6.972813758365857e-05 + eta * (0.0002772753244959392 + eta *
    (-0.00019932570516188847 + eta * (6.797780477937208e-05 + eta * (1.419062920643967e-07 + eta *
    (-1.3594048189768693e-05 + eta * (8.018470256334202e-06 + eta * (-2.291481176508095e-06 + eta *
    (-3.252473551298454e-10 + eta * (3.4652846491085265e-07 + eta * (-1.8447187191171344e-07 + eta *
    (4.8240967037894184e-08))))))))))))
  c6 = 0.0005313079364639922 + eta * (-0.0005921664373536939 + eta * (0.0002708782096718045 + eta *
    (7.902353232660328e-07 + eta * (-8.153969367561969e-05 + eta * (5.61168275310625e-05 + eta *
    (-1.8329116582843375e-05 + eta * (-3.0796134506033047e-09 + eta * (3.465155368803609e-06 + eta *
    (-2.0291327396058603e-06 + eta * (5.788792863149004e-07))))))))))
  c7 = 0.00034436760689237765 + eta * (5.171790908260592e-05 + eta * (-0.00033493161081142234 + eta *
    (0.0002812695154763237 + eta * (-0.00010976582244684731 + eta * (-1.2741009095484485e-07 + eta *
    (2.7744451511563645e-05 + eta * (-1.8263488805711332e-05 + eta * (5.7876949497350525e-06))))))))
  c8 = -0.0006526239185953094 + eta * (0.0008394987206720873 + eta * (-0.000438297098541721 + eta *
    (-6.969091458420552e-07 + eta * (0.00016644846642067547 + eta * (-0.00012783517679769218 + eta *
    (4.629953263691304e-05 + eta * (4.557909867922708e-09 + eta * (-1.0595271125805195e-05))))))))
  c9 = -0.0005967612901927463 + eta * (-7.204895416020011e-05 + eta * (0.0006782308837667328 + eta *
    (-0.0006401475260262758 + eta * (0.00027750107634328704 + eta * (1.819700838046515e-07 + eta *
    (-8.479507117068503e-05))))))
  c10 = 0.0013324454494800656 + eta * (-0.0019144384985654776 + eta * (0.0011089369134596636 + eta * (9.9324041226423e-07
    + eta * (-0.0005087450129309319 + eta * (0.00042735056665392886)))))
  c11 = 0.001579727660730835 + eta * (0.00016251626278391583 + eta * (-0.0020633421035543276 + eta *
    (0.00213896861856891)))
  r = 1.0 / a
  s = c0 + r * (c1 + r * (c2 + r * (c3 + r * (c4 + r * (c5 + r * (c6 + r * (c7 + r * (c8 + r * (c9 + r * (c10
    + r * c11))))))))))
  w = math.Exp(-a * phi) / math.Sqrt(2.0 * 3.141592653589793 * a) * s
  y = eta * math.Sqrt(a / 2.0)
  if up > 0.5
    return 0.5 * erfcF(y) + w
  end
  0.5 * erfcF(-y) - w
end

defn gammaSmall(a, x, up)
  (** P(a, x) or Q(a, x) for a < 1 and x <= 1.5: P = x^a / Gamma(a + 1) (1 + a T), T = sum (-x)^n / (n! (a + n)), and
      Q = -expm1(a log x) - x^a u - x^a (1 + u) a T, u = 1 / Gamma(a + 1) - 1, whose three terms are each of the size
      of a: Q keeps its digits as a goes to 0. *)
  t = 0.0
  term = 1.0
  n = 1.0
  while n < 200.0
    term = -term * x / n
    c = term / (a + n)
    t = t + c
    if math.Abs(c) <= 2.220446049250313e-16 * math.Abs(t)
      break
    end
    n = n + 1.0
  end
  la = a * math.Log(x)
  xa = math.Exp(la)
  u = gam1(a)
  if up > 0.5
    return -expm1(la) - xa * u - xa * (1.0 + u) * a * t
  end
  xa * (1.0 + u) * (1.0 + a * t)
end

defn gammaSeries(a, x)
  (** P(a, x) = x^a e^-x / Gamma(a + 1) sum x^n / ((a + 1) ... (a + n)), for x < a + 1. *)
  s = 1.0
  term = 1.0
  n = 1.0
  while n < 2000.0
    term = term * x / (a + n)
    s = s + term
    if term <= 2.220446049250313e-16 * s
      break
    end
    n = n + 1.0
  end
  rcomp(a, x) / a * s
end

defn gammaFraction(a, x)
  (** Q(a, x) by Legendre's continued fraction (DLMF 8.9.2), evaluated forward by the modified method of Lentz,
      for x >= a + 1, where it converges fast. *)
  tiny = 1.0e-300
  b = x + 1.0 - a
  c = 1.0 / tiny
  d = 1.0 / b
  h = d
  i = 1.0
  while i < 2000.0
    an = -i * (i - a)
    b = b + 2.0
    d = an * d + b
    if math.Abs(d) < tiny
      d = tiny
    end
    c = b + an / c
    if math.Abs(c) < tiny
      c = tiny
    end
    d = 1.0 / d
    delta = d * c
    h = h * delta
    if math.Abs(delta - 1.0) <= 2.220446049250313e-16
      break
    end
    i = i + 1.0
  end
  rcomp(a, x) * h
end

defn gammaInc(a, x, up)
  (** P(a, x), or Q(a, x) when up is 1.0: a number, not a boolean, so that the function becomes machine code. *)
  if a != a or x != x or a < 0.0 or x < 0.0
    return (0.0 / 0.0)
  end
  if a == 0.0 or x == (1.0 / 0.0)
    return if up > 0.5 0.0 else 1.0 end
  end
  if x == 0.0 or a == (1.0 / 0.0)
    return if up > 0.5 1.0 else 0.0 end
  end
  if a >= 20.0 and x >= 0.6 * a and x <= 1.4 * a
    return temme(a, x, up)
  end
  if a < 1.0 and x <= 1.5
    return gammaSmall(a, x, up)
  end
  if x < a + 1.0
    p = gammaSeries(a, x)
    return if up > 0.5 1.0 - p else p end
  end
  q = gammaFraction(a, x)
  if up > 0.5 q else 1.0 - q end
end

defn gammaIncArray(a, xs, up)
  (** gammaInc(a, x, up) for each element. *)
  f = gammaInc
  n = value.Len(xs)
  out = matrix.Zeros(1, n)
  for k in 1..n
    out[k] = f(a, xs[k], up)
  end
  out
end

defn GammaInc(a, x, upper = false)
  (** The regularized lower incomplete gamma function P(a, x), the integral of t^(a - 1) e^-t from 0 to x over
      Gamma(a), for a >= 0 and x >= 0; with upper, Q(a, x) = 1 - P(a, x), computed directly so that a small Q keeps its
      digits. NaN for a negative argument. x may be an array. The regions of DiDonato and Morris (1986): Temme's
      uniform expansion near x = a for a >= 20, series and continued fractions elsewhere.

        GammaInc(2, 1) --> 0.2642411176571153
        GammaInc(2, 1, upper = true) --> 0.7357588823428847
        GammaInc(100, 200, upper = true) --> 1.843893649711574e-15 *)
  up = if upper 1.0 else 0.0 end
  if value.IsNumber(a) and value.IsNumber(x)
    return gammaInc(1.0 * a, 1.0 * x, up)
  end
  a = number(a, "a", "special.GammaInc")
  matrix.Reshape(value.Size(x), gammaIncArray(a, floats(x, "special.GammaInc"), up))
end

(* ---- The incomplete beta ratio I_x(a, b): the power series for a small x, the continued fraction elsewhere, both for
   the tail below the mean, and the other tail by the symmetry I_x(a, b) = 1 - I_(1 - x)(b, a). *)

defn brcomp(a, b, x, y)
  (** x^a y^b / B(a, b), y = 1 - x. For a, b >= 10, through Stirling's series: sqrt(a b / (2 pi (a + b)))
      exp(a log1pmx(e1) + b log1pmx(e2) - corrections), e1 = x / x0 - 1, e2 = y / y0 - 1, x0 = a / (a + b), where
      (a + b) (x - x0) = b x - a y keeps its digits near the mean. *)
  if a >= 10.0 and b >= 10.0
    num = b * x - a * y
    t = a * log1pmx(num / a) + b * log1pmx(-num / b)
    c = corr(a) + corr(b) - corr(a + b)
    return math.Sqrt(a * b / (a + b) / (2.0 * 3.141592653589793)) * math.Exp(t - c)
  end
  lx = if x <= 0.5 math.Log(x) else log1p(-y) end
  ly = if x <= 0.5 log1p(-x) else math.Log(y) end
  math.Exp(a * lx + b * ly - lbeta(a, b))
end

defn betaSeries(a, b, x)
  (** I_x(a, b) = x^a / (a B(a, b)) (1 + a sum (1 - b)_n x^n / (n! (a + n))), for a small x. *)
  s = 0.0
  term = 1.0
  n = 1.0
  while n < 5000.0
    term = term * (n - b) * x / n
    c = term / (a + n)
    s = s + c
    if math.Abs(c) <= 2.220446049250313e-16 * math.Abs(s)
      break
    end
    n = n + 1.0
  end
  math.Exp(a * math.Log(x) - lbeta(a, b)) / a * (1.0 + a * s)
end

defn betaEven(a, b, x, m)
  (** The term d(2m) of the continued fraction of I_x(a, b), DLMF 8.17.22. *)
  m * (b - m) * x / ((a + 2.0 * m - 1.0) * (a + 2.0 * m))
end

defn betaOdd(a, b, x, m)
  (** The term d(2m + 1). *)
  -(a + m) * (a + b + m) * x / ((a + 2.0 * m) * (a + 2.0 * m + 1.0))
end

defn betaFraction(a, b, x, y)
  (** I_x(a, b) for x below the mean, by the even part of the continued fraction of DLMF 8.17.22: with d_n its terms,
      f = 1 - d_1 / T0, T_m = 1 + d_(2m + 1) + d_(2m + 2) - d_(2m + 2) d_(2m + 3) / T_(m + 1), where 1 + d_(2m + 1) is
      written with lambda = a y - b x: near the mean, 1 + d_1 is a small difference of large numbers, which lambda
      gives exactly. Evaluated forward by the modified method of Lentz. *)
  lam = a * y - b * x
  tiny = 1.0e-300
  h = 0.0
  c = 0.0
  d = 0.0
  m = 0.0
  while m < 20000.0
    big = a + 2.0 * m
    n1 = a * (1.0 + m * (3.0 - x)) + m * (2.0 + m * (4.0 - x)) + (a + m) * lam
    e = n1 / (big * (big + 1.0)) + betaEven(a, b, x, m + 1.0)
    if m == 0.0
      h = if math.Abs(e) < tiny tiny else e end
      c = h
      d = 0.0
    else
      an = -betaEven(a, b, x, m) * betaOdd(a, b, x, m)
      d = e + an * d
      if math.Abs(d) < tiny
        d = tiny
      end
      c = e + an / c
      if math.Abs(c) < tiny
        c = tiny
      end
      d = 1.0 / d
      delta = c * d
      h = h * delta
      if math.Abs(delta - 1.0) <= 2.220446049250313e-16
        break
      end
    end
    m = m + 1.0
  end
  f = 1.0 + (a - lam) / ((a + 1.0) * h)
  brcomp(a, b, x, y) / a * f
end

defn betaInc(a, b, x, y, up)
  (** I_x(a, b), or 1 - I_x(a, b) when up is 1.0; y = 1 - x, given apart so that a caller with y keeps its digits. *)
  if a != a or b != b or x != x or a < 0.0 or b < 0.0 or x < 0.0 or x > 1.0 or (a == 0.0 and b == 0.0)
    return (0.0 / 0.0)
  end
  if a == 0.0 or y == 0.0
    return if up > 0.5 0.0 else 1.0 end
  end
  if b == 0.0 or x == 0.0
    return if up > 0.5 1.0 else 0.0 end
  end
  if x * (a + b) > a
    w = betaTail(b, a, y, x)
    return if up > 0.5 w else 1.0 - w end
  end
  w = betaTail(a, b, x, y)
  if up > 0.5 1.0 - w else w end
end

defn betaTail(a, b, x, y)
  (** I_x(a, b) for x below the mean: the series for a small x, else the continued fraction. *)
  if (b * x <= 1.0 and x <= 0.5) or (x <= 0.1 and b < 40.0)
    return betaSeries(a, b, x)
  end
  betaFraction(a, b, x, y)
end

defn betaIncArray(a, b, xs, up)
  (** betaInc(a, b, x, 1.0 - x, up) for each element. *)
  f = betaInc
  n = value.Len(xs)
  out = matrix.Zeros(1, n)
  for k in 1..n
    out[k] = f(a, b, xs[k], 1.0 - xs[k], up)
  end
  out
end

defn BetaInc(a, b, x, upper = false)
  (** The regularized incomplete beta function I_x(a, b), the integral of t^(a - 1) (1 - t)^(b - 1) from 0 to x over
      B(a, b), for a, b >= 0 and x from 0 to 1; with upper, 1 - I_x(a, b), computed directly. NaN outside. x may be an
      array. The smaller tail comes from the power series or the continued fraction, the larger as one minus it.

        BetaInc(2, 3, 0.5) --> 0.6875
        BetaInc(1000, 1000, 0.45) --> 3.683198869007556e-6 *)
  up = if upper 1.0 else 0.0 end
  if value.IsNumber(a) and value.IsNumber(b) and value.IsNumber(x)
    return betaInc(1.0 * a, 1.0 * b, 1.0 * x, 1.0 - x, up)
  end
  a = number(a, "a", "special.BetaInc")
  b = number(b, "b", "special.BetaInc")
  matrix.Reshape(value.Size(x), betaIncArray(a, b, floats(x, "special.BetaInc"), up))
end
