(* QUIC's variable-length integers, RFC 9000, section 16: 1, 2, 4 or 8 bytes, the two high bits of the first telling. *)
defn Varint(n)
  (** The bytes of an integer from 0 to 2^62 - 1 as QUIC writes it.

        text.Bytes(Varint(37)) --> [37]
        text.Bytes(Varint(15293)) --> [123, 189]
        text.Bytes(Varint(494878333)) --> [157, 127, 62, 125] *)
  if n < 64
    text.FromBytes([n])
  else if n < 16384
    text.FromBytes([64 + math.Div(n, 256), math.Mod(n, 256)])
  else if n < 1073741824
    big(n, 4, 128)
  else
    big(n, 8, 192)
  end
end

defn big(n, width, mark)
  (** n in width bytes, big-endian, the first one marked. *)
  out = []
  left = n
  for k in 1..width
    out = list.Append(math.Mod(left, 256), out)
    left = math.Div(left, 256)
  end
  bytes = list.Reverse(out)
  bytes[1] = bytes[1] + mark
  text.FromBytes(bytes)
end

defn ReadVarint(s, at)
  (** The integer that starts at byte at of s, from 1: {Value, Next}, or missing when s ends first.

        ReadVarint(text.FromBytes([157, 127, 62, 125]), 1) --> {Value: 494878333, Next: 5}
        ReadVarint(text.FromBytes([123]), 1) --> missing *)
  if at > text.ByteLength(s)
    return missing
  end
  first = text.Byte(at, s)
  width = [1, 2, 4, 8][math.Div(first, 64) + 1]
  if at + width - 1 > text.ByteLength(s)
    return missing
  end
  v = math.Mod(first, 64)
  for k in 1..(width - 1)
    shifted = v * 256
    v = shifted + text.Byte(at + k, s)
  end
  {Value: v, Next: at + width}
end

Frame(kind, payload) = "$(Varint(kind))$(Varint(text.ByteLength(payload)))$payload"   (** A frame: its type, its length, its payload. *)

(* QPACK's integers with a prefix (RFC 9204, section 4.1.1, as HPACK's, RFC 7541 5.1) and its strings (4.1.2). *)
defn prefixed(first, bits, n)
  (** n in the low bits of a first byte whose high bits are first, then 7 bits a byte if it doesn't fit. *)
  most = math.BitShift(1, bits) - 1
  if n < most
    return text.FromBytes([first + n])
  end
  out = [first + most]
  left = n - most
  while left >= 128
    out = list.Append(math.Mod(left, 128) + 128, out)
    left = math.Div(left, 128)
  end
  text.FromBytes(list.Append(left, out))
end

defn readPrefixed(s, at, bits)
  (** The integer with a prefix of bits that starts at byte at: {Value, Next}, or missing when s ends first or it is
      past 2^62. *)
  if at > text.ByteLength(s)
    return missing
  end
  most = math.BitShift(1, bits) - 1
  v = math.BitAnd(text.Byte(at, s), most)
  next = at + 1
  if v < most
    return {Value: v, Next: next}
  end
  shift = 0
  while true
    if next > text.ByteLength(s) or shift > 56
      return missing
    end
    b = text.Byte(next, s)
    part = math.BitShift(math.BitAnd(b, 127), shift)
    v = v + part
    next += 1
    shift += 7
    if b < 128
      return {Value: v, Next: next}
    end
  end
end

defn readString(s, at, bits)
  (** A string whose length has a prefix of bits, the bit above them saying Huffman: {Value, Next}, or missing. *)
  if at > text.ByteLength(s)
    return missing
  end
  coded = math.BitAnd(text.Byte(at, s), math.BitShift(1, bits)) != 0
  n = readPrefixed(s, at, bits)
  if value.IsMissing(n) or n.Next + n.Value - 1 > text.ByteLength(s)
    return missing
  end
  raw = if n.Value == 0 "" else text.ByteSlice(n.Next, n.Next + n.Value - 1, s) end
  plain = if coded huffman(raw, huffmanCodes, huffmanLengths) else raw end
  if value.IsMissing(plain) missing else {Value: plain, Next: n.Next + n.Value} end
end

defn DecodeHead(block)
  (** The fields of a head that QPACK encoded, as {Name, Value} in their order: an Ok of them, or an Err when it refers
      to the dynamic table, which this side keeps empty, or isn't QPACK (QPACK_DECOMPRESSION_FAILED, RFC 9204 section
      2.2.3).

        DecodeHead(text.FromBytes([0, 0, 209, 193])) --> result.Ok([{Name: ":method", Value: "GET"}, {Name: ":path", Value: "/"}])
        DecodeHead(text.FromBytes([0, 0, 80, 140, 241, 227, 194, 229, 242, 58, 107, 160, 171, 144, 244, 255])) --> result.Ok([{Name: ":authority", Value: "www.example.com"}])
        DecodeHead(text.FromBytes([2, 0, 128])).Error.Message --> "This head refers to QPACK's dynamic table, which is empty." *)
  first = readPrefixed(block, 1, 8)
  base = if value.IsMissing(first) missing else readPrefixed(block, first.Next, 7) end
  if value.IsMissing(base)
    return failed("This head isn't QPACK.")
  end
  if first.Value != 0
    return failed("This head refers to QPACK's dynamic table, which is empty.")
  end
  fields = []
  at = base.Next
  n = text.ByteLength(block)
  while at <= n
    b = text.Byte(at, block)
    field = if b >= 192
      (* Indexed field line, static: 11xxxxxx. *)
      i = readPrefixed(block, at, 6)
      row = if value.IsMissing(i) or i.Value > 98 missing else staticTable[i.Value + 1] end
      if value.IsMissing(row) missing else {Name: row[1], Value: row[2], Next: i.Next} end
    else if b >= 128
      missing
    else if b >= 64
      (* Literal field line with a name reference: 01NTxxxx, T = 1 the static table. *)
      i = readPrefixed(block, at, 4)
      v = if value.IsMissing(i) missing else readString(block, i.Next, 7) end
      if value.IsMissing(v) or math.BitAnd(b, 16) == 0 or i.Value > 98 missing else {Name: staticTable[i.Value + 1][1], Value: v.Value, Next: v.Next} end
    else if b >= 32
      (* Literal field line with a literal name: 001NHxxx. *)
      name = readString(block, at, 3)
      v = if value.IsMissing(name) missing else readString(block, name.Next, 7) end
      if value.IsMissing(v) missing else {Name: name.Value, Value: v.Value, Next: v.Next} end
    else
      missing
    end
    if value.IsMissing(field)
      return failed(if b < 64 and (b >= 128 or b < 32) "This head refers to QPACK's dynamic table, which is empty." else "This head isn't QPACK." end)
    end
    fields = list.Append({Name: field.Name, Value: field.Value}, fields)
    at = field.Next
  end
  result.Ok(fields)
end

defn EncodeHead(fields)
  (** The bytes of a head as QPACK encodes it without the dynamic table: a field of the static table by its index, a
      known name by its index and its value, the others literally, all without Huffman.

        text.Bytes(EncodeHead([{Name: ":status", Value: "200"}])) --> [0, 0, 217]
        DecodeHead(EncodeHead([{Name: ":status", Value: "200"}, {Name: "x-id", Value: "7"}])) --> result.Ok([{Name: ":status", Value: "200"}, {Name: "x-id", Value: "7"}]) *)
  parts = [text.FromBytes([0, 0])]
  for f in fields
    whole = indexOf("$(f.Name) $(f.Value)")
    parts = list.Append(if not value.IsMissing(whole)
      prefixed(192, 6, whole)
    else
      named = indexOf(f.Name)
      lit = "$(prefixed(0, 7, text.ByteLength(f.Value)))$(f.Value)"
      if value.IsMissing(named) "$(prefixed(32, 3, text.ByteLength(f.Name)))$(f.Name)$lit" else "$(prefixed(80, 4, named))$lit" end
    end, parts)
  end
  text.Join("", parts)
end

(* Reading a stream frame by frame. A buffer holds what came after the last frame read. *)

defn gathered(st, buf, n)
  (** The first n bytes of what a stream sends, after buf: an Ok of {Bytes, Rest}, Ok(missing) when it ends first, or
      an Err when it was reset. Reads are joined once, not at each read. *)
  pieces = [buf]
  have = text.ByteLength(buf)
  while have < n
    got = st.Read()?
    if got == ""
      return result.Ok(missing)
    end
    pieces = list.Append(got, pieces)
    have += text.ByteLength(got)
  end
  all = if value.Len(pieces) == 1 buf else text.Join("", pieces) end
  rest = if have == n "" else text.ByteSlice(n + 1, have, all) end
  result.Ok({Bytes: if have == n all else text.ByteSlice(1, n, all) end, Rest: rest})
end

defn frameOf(st, buf, most)
  (** The next frame of a stream: an Ok of {Type, Payload, Rest}, of missing at a clean end, of {Type, Size, Rest} when
      its payload is larger than most (not read), or an Err when the stream was reset or ends inside a frame. *)
  b = buf
  while true
    kind = ReadVarint(b, 1)
    size = if value.IsMissing(kind) missing else ReadVarint(b, kind.Next) end
    if not value.IsMissing(size)
      rest = if size.Next > text.ByteLength(b) "" else text.ByteSlice(size.Next, text.ByteLength(b), b) end
      if size.Value > most
        return result.Ok({Type: kind.Value, Size: size.Value, Rest: rest})
      end
      payload = gathered(st, rest, size.Value)?
      if value.IsMissing(payload)
        return failed("The stream ended inside a frame.")
      end
      return result.Ok({Type: kind.Value, Payload: payload.Bytes, Rest: payload.Rest})
    end
    got = st.Read()?
    if got == ""
      return if b == "" result.Ok(missing) else failed("The stream ended inside a frame.") end
    end
    b = "$b$got"
  end
end

has(x, xs) = not value.IsMissing(list.IndexOf(x, xs))   (* Is x one of xs? *)

known(kind) = kind == dataFrame or kind == headersFrame   (* The frames of a request stream; others are skipped. *)

(** The settings this server sends (RFC 9114, section 7.2.4): no dynamic table and no blocked stream (RFC 9204, 5),
    the largest head, extended CONNECT (RFC 9220) for WebTransport, and HTTP datagrams (RFC 9297), which Chrome asks
    of a server of WebTransport even though no datagram ever comes: OpenSSL has none (RFC 9221). *)
defn settings(webtransport)
  pairs = [[1, 0], [7, 0], [6, MaxHead]]
  if webtransport
    (* SETTINGS_ENABLE_CONNECT_PROTOCOL, SETTINGS_H3_DATAGRAM, WebTransport's draft 02 (ENABLE_WEBTRANSPORT) and 07 and
       later (WEBTRANSPORT_MAX_SESSIONS), the two that browsers speak. *)
    pairs = list.Concat(pairs, [[8, 1], [51, 1], [727725890, 1], [3332460650, 16]])
  end
  text.Join("", ["$(Varint(p[1]))$(Varint(p[2]))" for p in pairs])
end

defn requestOf(fields, peer)
  (** The request a handler of std/http gets, from the fields of a head: an Ok of {Method, Path, Query, Headers, Body,
      Peer}, with Protocol for an extended CONNECT, or an Err of a status when the head is malformed (RFC 9114, section
      4.3): a name in capitals, a pseudo-header unknown, twice or after a field, or one missing. Host comes from
      :authority, and the cookies of many fields are one header again (section 4.2.1). *)
  pseudo = {}
  headers = []
  cookies = []
  for f in fields
    if text.StartsWith(":", f.Name)
      if value.Len(headers) > 0 or dict.Has(f.Name, pseudo) or not has(f.Name, [":method", ":scheme", ":authority", ":path", ":protocol"])
        return result.Err(400)
      end
      pseudo[f.Name] = f.Value
    else if text.Lower(f.Name) != f.Name or has(f.Name, ["connection", "keep-alive", "proxy-connection", "transfer-encoding", "upgrade"])
      return result.Err(400)
    else if f.Name == "cookie"
      cookies = list.Append(f.Value, cookies)
    else
      headers = list.Append({Name: f.Name, Value: f.Value}, headers)
    end
  end
  method = dict.Get(":method", pseudo)
  path = dict.Get(":path", pseudo)
  authority = dict.Get(":authority", pseudo)
  connect = method == "CONNECT"
  if value.IsMissing(method) or (not connect or dict.Has(":protocol", pseudo)) and (value.IsMissing(path) or value.IsMissing(dict.Get(":scheme", pseudo)))
    return result.Err(400)
  end
  if value.Len(cookies) > 0
    headers = list.Append({Name: "cookie", Value: text.Join("; ", cookies)}, headers)
  end
  if not value.IsMissing(authority) and value.IsMissing(list.FindFirst(h -> h.Name == "host", headers))
    headers = list.Concat([{Name: "host", Value: authority}], headers)
  end
  target = if value.IsMissing(path) "/" else path end
  q = text.ByteFind("?", 1, target)
  r = {Method: method, Path: if value.IsMissing(q) target else text.ByteSlice(1, q - 1, target) end,
    Query: if value.IsMissing(q) "" else text.ByteSlice(q + 1, text.ByteLength(target), target) end, Headers: headers, Body: "", Peer: peer}
  if dict.Has(":protocol", pseudo)
    r.Protocol = pseudo[":protocol"]
  end
  result.Ok(r)
end

(* The headers HTTP/3 doesn't carry: they belong to one connection of HTTP/1.1 (RFC 9114, section 4.2). *)
hopByHop = ["connection", "keep-alive", "proxy-connection", "transfer-encoding", "upgrade"]

defn headOf(response, options, size)
  (** The head of a response, encoded: :status, the response's headers in lower case but those of one connection, a
      date unless it has its own, and its length when it isn't streamed. A line end in a header is a bug, as in std/http. *)
  status = response.Status
  bug.Assert(value.IsInt(status) and status >= 100 and status <= 999, "This response has a status that isn't an integer of 3 digits.")
  fields = [{Name: ":status", Value: "$status"}]
  dated = false
  extra = match response
    {Headers: headers} -> headers
    else -> []
  end
  for h in extra
    name = text.Lower(h.Name)
    v = value.Text(h.Value)
    bug.Assert(not text.Contains("\r", v) and not text.Contains("\n", v) and not text.Contains("\r", name) and not text.Contains("\n", name), "This response header has a line end.")
    if not has(name, hopByHop)
      fields = list.Append({Name: name, Value: v}, fields)
      dated = dated or name == "date"
    end
  end
  if not dated
    fields = list.Append({Name: "date", Value: options.Date()}, fields)
  end
  if not value.IsMissing(size)
    fields = list.Append({Name: "content-length", Value: "$size"}, fields)
  end
  EncodeHead(fields)
end

(* Serving. *)

defn bodyOf(st, rest, most)
  (** The body of a request, its DATA frames until the end of the stream: an Ok of it, or an Err of a status, 413 past
      most bytes, 400 when the stream ends inside a frame or sends another head. Trailers are read and dropped. *)
  pieces = []
  total = 0
  buf = rest
  while true
    f = frameOf(st, buf, MaxHead)
    if result.IsErr(f)
      return result.Err(400)
    end
    if value.IsMissing(f.Value)
      return result.Ok(text.Join("", pieces))
    end
    fr = f.Value
    if fr.Type == dataFrame and dict.Has("Size", fr)
      (* A DATA frame larger than a head: read in pieces, each counted against most. *)
      if total + fr.Size > most
        return result.Err(413)
      end
      got = gathered(st, fr.Rest, fr.Size)
      if result.IsErr(got) or value.IsMissing(got.Value)
        return result.Err(400)
      end
      pieces = list.Append(got.Value.Bytes, pieces)
      total += fr.Size
      buf = got.Value.Rest
    else if dict.Has("Size", fr)
      return result.Err(if fr.Type == headersFrame 431 else 400 end)
    else if fr.Type == dataFrame
      total += text.ByteLength(fr.Payload)
      if total > most
        return result.Err(413)
      end
      pieces = list.Append(fr.Payload, pieces)
      buf = fr.Rest
    else
      buf = fr.Rest
    end
  end
end

defn answered(handle, request, timeout)
  (** The response of the handler, within timeout seconds, as std/http gives it: a panic answers 500, a handler that
      takes longer 503, and runs on alone. *)
  match fiber.Wait(fiber.Spawn(() -> handle(request)), timeout = list.Max(0, timeout))
    result.Ok(done) -> done
    result.Err(e) -> {Status: if e.Kind == "timeout" 503 else 500 end, Body: if e.Kind == "timeout" "Service Unavailable" else "Internal Server Error" end}
  end
end

defn reply(st, response, head, options)
  (** Sends a response on its stream and ends it: the head, then the body in DATA frames, as one write when it is whole,
      or as Stream's produce gives its pieces, each within the timeout of Serve. *)
  produce = match response
    {Stream: f} -> f
    else -> missing
  end
  body = if head or not value.IsMissing(produce) "" else value.Text(response.Body) end
  size = if value.IsMissing(produce) text.ByteLength(value.Text(response.Body)) else missing end
  first = Frame(headersFrame, headOf(response, options, size))
  st.Write(if body == "" first else "$first$(Frame(dataFrame, body))" end)?
  if not value.IsMissing(produce) and not head
    defn send(piece)
      bug.Assert(value.IsText(piece), "A piece of a streamed body is a text.")
      if piece == ""
        return result.Ok(missing)
      end
      match fiber.Wait(fiber.Spawn(() -> st.Write(Frame(dataFrame, piece))), timeout = options.Timeout)
        result.Ok(r) -> r
        result.Err(e) -> failed("The client took no piece of the body in $(options.Timeout) seconds.")
      end
    end
    made = fiber.Wait(fiber.Spawn(() -> produce(send)))
    if result.IsErr(made) or result.IsErr(made.Value)
      st.Reset(generalError)
      return failed("The body was cut short.")
    end
  end
  st.End()
end

defn refuse(st, status, options)
  (** Answers a request that never reaches its handler: 400, 413 or 431. *)
  names = {400: "Bad Request", 413: "Content Too Large", 425: "Too Early", 431: "Request Header Fields Too Large"}
  _ = reply(st, {Status: status, Body: dict.Get(status, names), Headers: [{Name: "content-type", Value: "text/plain; charset=utf-8"}]}, false, options)
end

defn exchange(st, conn, handle, options)
  (** One request and its response, on a stream that the client opened. The head must come within the timeout, and
      every head is at most MaxHead bytes. *)
  deadline = sys.Now() + options.Timeout
  buf = ""
  head = missing
  while value.IsMissing(head)
    got = fiber.Wait(fiber.Spawn(() -> frameOf(st, buf, MaxHead)), timeout = options.Timeout)
    if result.IsErr(got) or result.IsErr(got.Value) or value.IsMissing(got.Value.Value)
      st.Reset(requestRejected)
      return st.Free()
    end
    f = got.Value.Value
    if f.Type == headersFrame and dict.Has("Size", f)
      refuse(st, 431, options)
      return st.Free()
    else if f.Type == dataFrame
      conn.Close(frameUnexpected)
      return st.Free()
    else if f.Type == headersFrame
      head = f
    else if dict.Has("Size", f)
      st.Reset(excessiveLoad)
      return st.Free()
    end
    buf = f.Rest
  end
  fields = DecodeHead(head.Payload)
  if result.IsErr(fields)
    (* QPACK_DECOMPRESSION_FAILED is an error of the connection (RFC 9204, section 2.2.3). *)
    conn.Close(512)
    return st.Free()
  end
  made = requestOf(fields.Value, conn.Peer)
  if result.IsErr(made)
    refuse(st, made.Error, options)
    return st.Free()
  end
  request = made.Value
  body = if request.Method == "CONNECT" result.Ok("") else bodyOf(st, head.Rest, options.MaxBody) end
  if result.IsErr(body)
    refuse(st, body.Error, options)
    return st.Free()
  end
  request.Body = body.Value
  response = answered(handle, request, deadline - sys.Now())
  _ = reply(st, response, request.Method == "HEAD", options)
  st.Free()
end

defn incoming(st, conn)
  (** A stream of one way that the client opened: its control stream, whose first frame must be its SETTINGS and which
      must stay open (RFC 9114, section 6.2.1); QPACK's streams, of which the encoder's may only set a capacity of 0,
      since this side keeps no table (RFC 9204, section 4.3.1); any other type, read and dropped. *)
  kind = frameKind(st)
  if result.IsErr(kind) or value.IsMissing(kind.Value)
    return st.Free()
  end
  if kind.Value.Type == controlStream
    first = frameOf(st, kind.Value.Rest, MaxHead)
    if result.IsErr(first) or value.IsMissing(first.Value) or first.Value.Type != settingsFrame
      conn.Close(missingSettings)
      return st.Free()
    end
    buf = first.Value.Rest
    while true
      f = frameOf(st, buf, MaxHead)
      if result.IsErr(f) or value.IsMissing(f.Value)
        if not conn.Ended()
          conn.Close(criticalClosed)
        end
        return st.Free()
      end
      if f.Value.Type == settingsFrame or f.Value.Type == dataFrame or f.Value.Type == headersFrame
        conn.Close(frameUnexpected)
        return st.Free()
      end
      buf = f.Value.Rest
    end
  end
  if kind.Value.Type == encoderStream and not capacityZero(kind.Value.Rest, st)
    conn.Close(encoderError)
    return st.Free()
  end
  (* Read and dropped, a read at a time: nothing of it is kept. *)
  got = st.Read()
  while result.IsOk(got) and got.Value != ""
    got = st.Read()
  end
  st.Free()
end

defn frameKind(st)
  (** The type that starts a stream of one way: an Ok of {Type, Rest}, or of missing if it ends first. *)
  buf = ""
  while true
    kind = ReadVarint(buf, 1)
    if not value.IsMissing(kind)
      return result.Ok({Type: kind.Value, Rest: if kind.Next > text.ByteLength(buf) "" else text.ByteSlice(kind.Next, text.ByteLength(buf), buf) end})
    end
    got = st.Read()?
    if got == ""
      return result.Ok(missing)
    end
    buf = "$buf$got"
  end
end

defn capacityZero(first, st)
  (** Does the encoder's stream only set the capacity of its table to 0 (Set Dynamic Table Capacity, 001xxxxx)? Any
      insertion overflows a table of 0 bytes. It reads what came, and lets the rest be read and checked by the caller. *)
  at = 1
  while at <= text.ByteLength(first)
    b = text.Byte(at, first)
    if b < 32 or b >= 64
      return false
    end
    n = readPrefixed(first, at, 5)
    if value.IsMissing(n) or n.Value != 0
      return false
    end
    at = n.Next
  end
  true
end

defn connection(conn, handle, options, state)
  (** Serves one connection: its control stream with this server's SETTINGS, then a fiber for each request. At a stop
      signal, a GOAWAY tells the client the last request served (RFC 9114, section 5.2), the requests begun end, each
      by its deadline, and the connection closes with H3_NO_ERROR. *)
  control = conn.Open(true)
  if result.IsErr(control)
    return conn.Close(generalError)
  end
  ctl = control.Value
  sent = ctl.Write("$(Varint(controlStream))$(Frame(settingsFrame, settings(options.WebTransport)))")
  if result.IsErr(sent)
    return conn.Close(generalError)
  end
  count(state, "open", 1)
  tasks = []
  next = 0
  while true
    got = conn.Accept()
    if result.IsErr(got)
      if got.Error.Kind == "stopped"
        _ = ctl.Write(Frame(goawayFrame, Varint(next)))
        deadline = sys.Now() + options.Timeout
        for t in tasks
          _ = fiber.Wait(t, timeout = list.Max(0, deadline - sys.Now()))
        end
        conn.Close(noError)
      end
      break
    end
    st = got.Value
    kind = math.Mod(st.Id, 4)
    if kind == 0
      next = st.Id + 4
      tasks = list.Append(fiber.Spawn(() -> exchange(st, conn, handle, options)), [t for t in tasks if result.IsErr(fiber.Wait(t, timeout = 0))])
    else if kind == 2
      fiber.Spawn(() -> incoming(st, conn))
    else
      st.Free()
    end
  end
  ctl.Free()
  count(state, "open", -1)
end

defn count(state, key, step)
  (** Adds a step to a count that every fiber of a server shares. *)
  now = fiber.Recall(key, 1, state)
  fiber.Remember(key, (if value.IsMissing(now) 0 else now end) + step, 2, state)
end

defn Server(certificate, key, api, port = 443, host = "127.0.0.1", validate = true)
  (** What http.Serve takes as http3 to serve HTTP/3 beside TCP: a QUIC listener on UDP port, which may be the TCP port
      of HTTPS, as browsers look for it (Alt-Svc, RFC 7838: Serve tells every response of TCP). certificate, key and
      validate are as quic.Server takes them, api what quic.Open gave. An Err when OpenSSL has no QUIC server, a file
      can't be read or the port is taken: Serve then serves TCP alone. It needs OpenSSL, so it has no example here. *)
  q = quic.Server(certificate, key, api, port = port, host = host, alpn = ["h3"], validate = validate)?
  result.Ok({Port: q.Port, Quic: q, Serve: (handle, options) -> serve(q, handle, options)})
end

defn serve(q, handle, options)
  (** Serves HTTP/3 until a stop signal, then lets each connection end its requests and waits for them, at most the
      timeout of Serve and a second. options are std/http's: Timeout, MaxBody, Date, WebTransport. *)
  state = fiber.Table(16)
  task = fiber.Spawn(() -> quic.Serve(q, conn -> connection(conn, handle, options, state)))
  _ = fiber.Receive(sys.Stops())
  deadline = sys.Now() + options.Timeout + 1
  sys.Sleep(0.05)
  while sys.Now() < deadline and (fiber.Recall("open", 1, state) then (n -> not value.IsMissing(n) and n > 0))
    sys.Sleep(0.01)
  end
  quic.Close(q)
  _ = fiber.Wait(task)
  result.Ok(missing)
end

(* The client. *)

defn Client(api, verify = true, ca = missing, most = 1000)
  (** What http.Fetch takes as http3, to ask over HTTP/3 the servers that offer it: a server's Alt-Svc header (RFC 7838)
      names its port of HTTP/3, and the next requests to that origin go there, on one connection kept open, until its
      max-age passes. A QUIC failure, as UDP blocked on the way, sends the request over TCP at once, and that origin is
      not tried again for 5 minutes, as browsers do. api is what quic.Open gave; verify and ca as tls.Client takes them.
      It keeps at most most origins. Its functions are those http.Fetch calls: Offered(host, port), the port of HTTP/3
      to ask, or missing; Ask(host, port, method, path, headers, body, timeout, maxBody, peer); Learn(host, port,
      header), from an Alt-Svc header; Broken(host, port).

        c = Client(missing)
        c.Learn("example.com", 443, "h3=\":8443\"; ma=60, h2=\":443\"")
        c.Offered("example.com", 443) --> 8443
        c.Learn("example.com", 443, "clear")
        c.Offered("example.com", 443) --> missing
        c.Learn("example.com", 443, "h3=\"other.example:443\"")
        c.Offered("example.com", 443) --> missing *)
  c = {Api: api, Verify: verify, Ca: ca, Offers: fiber.Table(most), Pool: fiber.Table(most)}
  {Offered: (host, port) -> offered(c, host, port), Learn: (host, port, header) -> learn(c, host, port, header),
    Broken: (host, port) -> broken(c, host, port),
    Ask: (host, port, method, path, headers, body, timeout, maxBody, peer) -> ask(c, host, port, method, path, headers, body, timeout, maxBody, peer)}
end

(* How long an origin whose HTTP/3 failed waits before it is tried again: 5 minutes. *)
brokenFor = 300

defn learn(client, host, port, header)
  (** Keeps what an Alt-Svc header of host:port offers: its HTTP/3 port on the same host, until its max-age (24 hours
      by default), or nothing more after "clear". An offer of another host is left: the client would have to check that
      host's certificate for this origin, and gains nothing a server can't give on its own host. *)
  origin = "$host:$port"
  if text.Trim(header) == "clear"
    fiber.Forget(origin, client.Offers)
    return missing
  end
  for entry in text.Split(",", header)
    parts = [text.Trim(p) for p in text.Split(";", entry)]
    offer = text.Split("=", parts[1])
    if value.Len(offer) == 2 and offer[1] == "h3"
      quoted = text.Trim(offer[2])
      at = text.ByteFind(":", 1, quoted)
      on = if value.IsMissing(at) missing else text.Number(text.ByteSlice(at + 1, text.ByteLength(quoted) - 1, quoted)) end
      same = not value.IsMissing(at) and at == 2
      age = 86400
      for p in list.Skip(1, parts)
        kv = text.Split("=", p)
        if value.Len(kv) == 2 and text.Trim(kv[1]) == "ma" and value.IsInt(text.Number(text.Trim(kv[2])))
          age = text.Number(text.Trim(kv[2]))
        end
      end
      if same and value.IsInt(on) and on > 0 and on < 65536
        fiber.Remember(origin, on, sys.Now() + age, client.Offers)
        return missing
      end
    end
  end
end

defn offered(client, host, port)
  (** The HTTP/3 port that host:port offered and that didn't fail lately, or missing. *)
  if not value.IsMissing(fiber.Recall("broken $host:$port", sys.Now(), client.Offers))
    return missing
  end
  fiber.Recall("$host:$port", sys.Now(), client.Offers)
end

defn broken(client, host, port)
  (** Says that HTTP/3 failed for host:port: TCP for the next 5 minutes. *)
  fiber.Remember("broken $host:$port", true, sys.Now() + brokenFor, client.Offers)
  fiber.Forget("$host:$port", client.Pool)
end

defn dialed(client, host, port, timeout, peer)
  (** The connection kept for host:port, or a new one with its control stream and its SETTINGS. *)
  kept = fiber.Recall("$host:$port", sys.Now(), client.Pool)
  if not value.IsMissing(kept) and not kept.Ended()
    return result.Ok(kept)
  end
  conn = quic.Dial(host, port, client.Api, verify = client.Verify, ca = client.Ca, timeout = timeout, peer = peer)?
  control = conn.Open(true)
  sent = if result.IsOk(control) control.Value.Write("$(Varint(controlStream))$(Frame(settingsFrame, settings(false)))") else control end
  if result.IsErr(sent)
    conn.Close(generalError)
    return sent
  end
  (* The server's own streams of one way: its control stream and QPACK's, read and dropped as a server reads them. *)
  fiber.Spawn() do
    got = conn.Accept()
    while result.IsOk(got)
      st = got.Value
      fiber.Spawn(() -> incoming(st, conn))
      got = conn.Accept()
    end
  end
  fiber.Remember("$host:$port", conn, sys.Now() + 3600, client.Pool)
  result.Ok(conn)
end

defn ask(client, host, port, method, path, headers, body, timeout, maxBody, peer)
  (** One request over HTTP/3 to host:port: an Ok of {Status, Headers, Body}, as http.Fetch gives it, or an Err. Each
      frame of the response must come within timeout seconds, and its body be at most maxBody bytes. *)
  conn = dialed(client, host, port, timeout, peer)?
  opened = conn.Open(false)
  if result.IsErr(opened)
    fiber.Forget("$host:$port", client.Pool)
    return opened
  end
  st = opened.Value
  authority = if port == 443 host else "$host:$port" end
  fields = [{Name: ":method", Value: method}, {Name: ":scheme", Value: "https"}, {Name: ":authority", Value: authority}, {Name: ":path", Value: path}]
  for h in headers
    name = text.Lower(h.Name)
    if not has(name, ["host", "connection", "keep-alive", "proxy-connection", "transfer-encoding", "upgrade", "content-length"])
      fields = list.Append({Name: name, Value: h.Value}, fields)
    end
  end
  head = Frame(headersFrame, EncodeHead(fields))
  sent = st.Write(if body == "" head else "$head$(Frame(dataFrame, body))" end)
  if result.IsOk(sent)
    sent = st.End()
  end
  got = if result.IsOk(sent) fiber.Wait(fiber.Spawn(() -> response(st, timeout, maxBody)), timeout = if value.IsMissing(timeout) missing else timeout * 10 end) else sent end
  st.Free()
  match got
    result.Ok(r) -> r
    result.Err(e) -> failed("The HTTP/3 request to $host:$port failed: $(value.Text(dict.Get("Message", e)))")
  end
end

defn response(st, timeout, maxBody)
  (** The response on a stream: its final head, after any of 1xx, then its body. *)
  buf = ""
  while true
    f = frameOf(st, buf, MaxHead * 4)?
    if value.IsMissing(f) or dict.Has("Size", f)
      return failed("This response has no head, or one too large.")
    end
    buf = f.Rest
    if f.Type == headersFrame
      fields = DecodeHead(f.Payload)?
      status = text.Number(dict.Get("Value", list.FindFirst(x -> x.Name == ":status", fields)))
      if not value.IsInt(status)
        return failed("This response has no status.")
      end
      if status >= 200
        body = bodyOf(st, buf, if value.IsMissing(maxBody) 4611686018427387903 else maxBody end)
        if result.IsErr(body)
          return failed(if body.Error == 413 "The body of this response is larger than maxBody." else "The body of this response was cut short." end)
        end
        return result.Ok({Status: status, Headers: [x for x in fields if not text.StartsWith(":", x.Name)], Body: body.Value})
      end
    end
  end
end
