(** HTTP/3, RFC 9114: HTTP over QUIC, each request on a stream of its own, and QPACK (RFC 9204), its compression of
    headers. Server serves the handler of an application of std/http, the same routes and middleware as HTTP/1.1, and
    http.Serve runs it beside TCP with http3 = Server(...); Client asks over HTTP/3 for http.Fetch, once a server said that
    it speaks it. QPACK runs without its dynamic table (capacity 0, RFC 9204, section 3.2.3): no table to fill, no stream
    of the encoder or the decoder, and a request's head is the static table and literals. Run with --allow
    ffi=ssl,ffi=crypto, as std/quic. *)
use std/bug
use std/dict
use std/fiber
use std/list
use std/log
use std/math
use std/quic
use std/result
use std/sys
use std/text
use std/value

failed(message) = result.Err({Kind: "http", Message: message})   (* An Err of the kind "http", as std/http gives. *)

(* Frame types (RFC 9114, section 7.2), stream types (6.2), settings (7.2.4.1, RFC 9204 5, RFC 9220 3, RFC 9297 2.1.1)
   and error codes (8.1, RFC 9204 6). *)
dataFrame = 0
headersFrame = 1
settingsFrame = 4
goawayFrame = 7
controlStream = 0
encoderStream = 2
decoderStream = 3
noError = 256              (* H3_NO_ERROR, 0x100 *)
generalError = 257         (* H3_GENERAL_PROTOCOL_ERROR *)
frameUnexpected = 261      (* H3_FRAME_UNEXPECTED, 0x105 *)
frameError = 262           (* H3_FRAME_ERROR *)
excessiveLoad = 263        (* H3_EXCESSIVE_LOAD *)
requestRejected = 267      (* H3_REQUEST_REJECTED, 0x10b *)
missingSettings = 266      (* H3_MISSING_SETTINGS, 0x10a *)
criticalClosed = 260       (* H3_CLOSED_CRITICAL_STREAM, 0x104 *)
encoderError = 514         (* QPACK_ENCODER_STREAM_ERROR, 0x202 *)
(** The largest head of a request in bytes, as the server says in its SETTINGS (MAX_FIELD_SECTION_SIZE): the 16 KiB of
    HTTP/1.1's head. A larger one is answered 431.

      MaxHead --> 16384 *)
MaxHead = 16384

staticTable = [
  [":authority", ""], [":path", "/"], ["age", "0"], ["content-disposition", ""], ["content-length", "0"],
  ["cookie", ""], ["date", ""], ["etag", ""], ["if-modified-since", ""], ["if-none-match", ""],
  ["last-modified", ""], ["link", ""], ["location", ""], ["referer", ""], ["set-cookie", ""], [":method", "CONNECT"],
  [":method", "DELETE"], [":method", "GET"], [":method", "HEAD"], [":method", "OPTIONS"], [":method", "POST"],
  [":method", "PUT"], [":scheme", "http"], [":scheme", "https"], [":status", "103"], [":status", "200"],
  [":status", "304"], [":status", "404"], [":status", "503"], ["accept", "*/*"],
  ["accept", "application/dns-message"], ["accept-encoding", "gzip, deflate, br"], ["accept-ranges", "bytes"],
  ["access-control-allow-headers", "cache-control"], ["access-control-allow-headers", "content-type"],
  ["access-control-allow-origin", "*"], ["cache-control", "max-age=0"], ["cache-control", "max-age=2592000"],
  ["cache-control", "max-age=604800"], ["cache-control", "no-cache"], ["cache-control", "no-store"],
  ["cache-control", "public, max-age=31536000"], ["content-encoding", "br"], ["content-encoding", "gzip"],
  ["content-type", "application/dns-message"], ["content-type", "application/javascript"],
  ["content-type", "application/json"], ["content-type", "application/x-www-form-urlencoded"],
  ["content-type", "image/gif"], ["content-type", "image/jpeg"], ["content-type", "image/png"],
  ["content-type", "text/css"], ["content-type", "text/html; charset=utf-8"], ["content-type", "text/plain"],
  ["content-type", "text/plain;charset=utf-8"], ["range", "bytes=0-"],
  ["strict-transport-security", "max-age=31536000"],
  ["strict-transport-security", "max-age=31536000; includesubdomains"],
  ["strict-transport-security", "max-age=31536000; includesubdomains; preload"], ["vary", "accept-encoding"],
  ["vary", "origin"], ["x-content-type-options", "nosniff"], ["x-xss-protection", "1; mode=block"],
  [":status", "100"], [":status", "204"], [":status", "206"], [":status", "302"], [":status", "400"],
  [":status", "403"], [":status", "421"], [":status", "425"], [":status", "500"], ["accept-language", ""],
  ["access-control-allow-credentials", "FALSE"], ["access-control-allow-credentials", "TRUE"],
  ["access-control-allow-headers", "*"], ["access-control-allow-methods", "get"],
  ["access-control-allow-methods", "get, post, options"], ["access-control-allow-methods", "options"],
  ["access-control-expose-headers", "content-length"], ["access-control-request-headers", "content-type"],
  ["access-control-request-method", "get"], ["access-control-request-method", "post"], ["alt-svc", "clear"],
  ["authorization", ""], ["content-security-policy", "script-src 'none'; object-src 'none'; base-uri 'none'"],
  ["early-data", "1"], ["expect-ct", ""], ["forwarded", ""], ["if-range", ""], ["origin", ""],
  ["purpose", "prefetch"], ["server", ""], ["timing-allow-origin", "*"], ["upgrade-insecure-requests", "1"],
  ["user-agent", ""], ["x-forwarded-for", ""], ["x-frame-options", "deny"], ["x-frame-options", "sameorigin"]
]

(* The static table by "name value" and by name, for the encoder: built at the first response, not at load. *)
staticIndex = fiber.Table(256)

defn indexOf(key)
  (** The index of a field or of a name in the static table, from 0, or missing. *)
  if value.IsMissing(fiber.Recall("ready", 1, staticIndex))
    for k in 1..value.Len(staticTable)
      row = staticTable[k]
      if value.IsMissing(fiber.Recall("$(row[1]) $(row[2])", 1, staticIndex))
        fiber.Remember("$(row[1]) $(row[2])", k - 1, 2, staticIndex)
      end
      if value.IsMissing(fiber.Recall(row[1], 1, staticIndex))
        fiber.Remember(row[1], k - 1, 2, staticIndex)
      end
    end
    fiber.Remember("ready", true, 2, staticIndex)
  end
  fiber.Recall(key, 1, staticIndex)
end

(* HPACK's Huffman code, RFC 7541, appendix B: the code and the length in bits of each byte, then of the end of string. *)
huffmanCodes = [
  8184, 8388568, 268435426, 268435427, 268435428, 268435429, 268435430, 268435431, 268435432, 16777194, 1073741820, 268435433,
