(** C++ has no stable binary interface, so Cesia reaches it through a small C layer, generated here, compiled once by
    the C++ compiler and loaded with c. A C++ exception becomes a panic. Templates work through their concrete types. *)
use std/c
use std/sys
use std/bug
use std/cesia
use std/dict
use std/fiber
use std/list
use std/result
use std/text
use std/value

cppTypes = {"i8": "int8_t", "u8": "uint8_t", "i16": "int16_t", "u16": "uint16_t", "i32": "int32_t", "u32": "uint32_t",
  "i64": "int64_t", "u64": "uint64_t", "f32": "float", "f64": "double", "bool": "bool", "ptr": "void *",
  "text": "const char *", "void": "void"}

(** What can be wrapped. call is the C++ name, when it isn't the name in Cesia.

      Fn("gcd", ["i64", "i64"], "i64", call = "std::gcd<long, long>").Call --> "std::gcd<long, long>"
      Fn("abs", ["i32"], "i32").Call --> "abs" *)
Fn(name, args, ret, call = missing) = {Name: name, Args: args, Ret: ret, Call: if value.IsMissing(call) name else call end}
(** A method of a class, described like fn.

      Method("push", ["i32"], "void", call = "push_back").Call --> "push_back" *)
Method(name, args, ret, call = missing) = Fn(name, args, ret, call = call)
(** A class to wrap: its name in Cesia, its C++ type, its methods and the argument types of its constructor.

      Class("Numbers", "std::vector<int>", [Method("count", [], "u64", call = "size")]).Type --> "std::vector<int>" *)
Class(name, type, methods, new = []) = {Name: name, Type: type, Methods: methods, New: new}

arguments(types) = text.Join(", ", ["a$k" for k in 1..value.Len(types)])

defn params(types, first)
  text.Join(", ", list.Concat(first, ["$(cppTypes[types[k]]) a$k" for k in 1..value.Len(types)]))
end

defn body(ret, call)
  if ret == "void"
    "KP_TRY $call; KP_CATCH()"
  else if ret == "text"
    "KP_TRY kp_text = $call; return kp_text.c_str(); KP_CATCH(nullptr)"
  else
    "KP_TRY return $call; KP_CATCH(0)"
  end
end

export(ret, name, params, body) = "$(cppTypes[ret]) $name($params) { $body }"

defn method(cls, m)
  object = "static_cast<$(cls.Type) *>(self)"
  export(m.Ret, "$(cls.Name)_$(m.Name)", params(m.Args, ["void *self"]), body(m.Ret, "$object->$(m.Call)($(arguments(m.Args)))"))
end

defn class(cls)
  new = export("ptr", "$(cls.Name)_new", params(cls.New, []), body("ptr", "new $(cls.Type)($(arguments(cls.New)))"))
  delete = "void $(cls.Name)_delete(void *self) { delete static_cast<$(cls.Type) *>(self); }"
  text.Join("\n", list.Concat([new, delete], [method(cls, m) for m in cls.Methods]))
end

function(f) = export(f.Ret, f.Name, params(f.Args, []), body(f.Ret, "$(f.Call)($(arguments(f.Args)))"))

defn Source(spec)
  (** The C++ source of the layer: a C function for each function, and new, delete and each method for a class.

        spec = {Name: "demo", Include: ["<numeric>"], Classes: [], Functions: [Fn("gcd", ["i64", "i64"], "i64", call = "std::gcd<long, long>")]}
        list.Filter(l -> text.StartsWith("int64_t gcd", l), text.Lines(Source(spec))) --> ["int64_t gcd(int64_t a1, int64_t a2) { KP_TRY return std::gcd<long, long>(a1, a2); KP_CATCH(0) }"] *)
  includes = text.Join("\n", ["#include $i" for i in spec.Include])
  parts = list.Concat([class(cls) for cls in spec.Classes], [function(f) for f in spec.Functions])
  "// Generated by std/cpp.ce.
#include <cstdint>
#include <exception>
#include <string>
$includes

static thread_local std::string kp_text, kp_error;
static thread_local bool kp_failed = false;
#define KP_TRY try {
#define KP_CATCH(value) } catch (const std::exception &e) { kp_failed = true; kp_error = e.what(); } \\
  catch (...) { kp_failed = true; kp_error = \"a C++ exception\"; } return value;

extern \"C\" {
const char *kp_take_error() { if (!kp_failed) return nullptr; kp_failed = false; return kp_error.c_str(); }
$(text.Join("\n", parts))
}
"
end

defn after(v, takeError)
  e = takeError()
  if value.IsMissing(e) v else bug.Panic("C++: $e") end
end

defn guard(f, n, t)
  match n
    0 -> () -> after(f(), t)
    1 -> a -> after(f(a), t)
    2 -> (a, b) -> after(f(a, b), t)
    3 -> (a, b, d) -> after(f(a, b, d), t)
    4 -> (a, b, d, e) -> after(f(a, b, d, e), t)
    5 -> (a, b, d, e, g) -> after(f(a, b, d, e, g), t)
    else -> bug.Panic("A function of cpp.Wrap takes at most 5 arguments.")
  end
end

defn bind(lib, takeError, name, args, ret)
  f = c.Fn(name, args, ret, lib)?
  result.Ok(guard(f, value.Len(args), takeError))
end

(** The flags of the compiler. *)
flags = ["-std=c++20", "-shared", "-fPIC", "-O2"]

defn compile(compiler, cppFile, library)
  r = sys.Run(compiler, args = list.Concat(flags, ["-o", library, cppFile]))?
  if r.Code == 0
    result.Ok(missing)
  else
    result.Err({Kind: "cpp", Message: r.Err})
  end
end

defn quietly(f)
  (** What f gives, an Ok or an Err, or an Err when it stops, as for a permission the program doesn't have. *)
  got = fiber.Wait(fiber.Spawn(f))
  if result.IsOk(got) got.Value else got end
end

defn headers(spec, folder)
  (** The headers that the source includes by "name", from folder, and those that they include so, from their own
      folder, each once, with its text: what the library is made of beside the source. One that can't be read counts
      as empty. *)
  todo = ["$folder/$(text.Slice(2, value.Len(h) - 1, h))" for h in spec.Include if text.StartsWith("\"", h)]
  seen = dict.Dict()
  while value.Len(todo) > 0 and value.Len(seen) < 1000
    path = todo[1]
    todo = todo[2..end]
    if not dict.Has(path, seen)
      got = quietly(() -> sys.Read(path))
      seen[path] = result.UnwrapOr("", got)
      folders = text.Split("/", path)
      here = text.Join("/", folders[1..value.Len(folders) - 1])
      for line in text.Lines(seen[path])
        parts = text.Split("\"", text.Trim(line))
        if text.StartsWith("#include", text.Trim(line)) and value.Len(parts) >= 3
          todo = list.Append("$here/$(parts[2])", todo)
        end
      end
    end
  end
  text.Join("\n", ["$p\n$(seen[p])" for p in list.Sort(dict.Keys(seen))])
end

defn keyOf(spec, folder, compiler, source)
  (** What the library is made of: the source, its headers of the project, the compiler, as its --version tells, and its
      flags, as a fingerprint of 128 bits. *)
  said = quietly(() -> sys.Run(compiler, args = ["--version"]))
  version = if result.IsOk(said) said.Value.Out else "" end
  text.Slice(8, 39, cesia.Fingerprint(text.Join("\n", [source, headers(spec, folder), compiler, version, text.Join(" ", flags)])))
end

defn Wrap(spec, folder = ".", compiler = "c++")
  (** Compiles what changed into folder, made if it isn't there, loads it, and gives a dictionary of functions: "name",
      "Class.method", "Class.new". The library is made again when its source, a header of the project that the source
      includes by "name", the compiler or its flags change: the first line of its .cpp keeps the fingerprint of them
      all. It is compiled under a name of its own, then renamed, so that no program loads one half written; and the
      fingerprint of each library Wrap makes is kept in Cesia's cache, the person's alone, so that a library put in
      folder by someone else, as one a cloned project holds, is never loaded: it is made again. It needs a C++ compiler,
      so it has no example here: the chapter [C and C++](https://www-celestial.github.io/cesia-lang/c.html#c) runs one. *)
  cppFile = "$folder/$(spec.Name)_cesia.cpp"
  library = "$folder/lib$(spec.Name)_cesia.so"
  source = Source(spec)
  key = keyOf(spec, folder, compiler, source)
  stamped = "// Key $key\n$source"
  print = () -> result.UnwrapOr("", result.MapOk(cesia.Fingerprint, sys.Read(library)))
  same = sys.Exists(cppFile) and sys.Exists(library) and result.UnwrapOr("", sys.Read(cppFile)) == stamped and kept(key) == print()
  if not same
    sys.Mkdir(folder)?
    sys.Write(cppFile, stamped)?
    fresh = "$folder/.lib$(spec.Name)_cesia.$(text.Slice(8, 23, cesia.Fingerprint(text.Str(sys.Now(), key)))).so"
    made = compile(compiler, cppFile, fresh)
    if result.IsErr(made)
      _ = quietly(() -> sys.Remove(fresh))
      return made
    end
    sys.Rename(fresh, library)?
    keep(key, print())
  end
  lib = c.Open(library)?
  takeError = c.Fn("kp_take_error", [], "text", lib)?
  out = dict.Dict()
  for f in spec.Functions
    out[f.Name] = bind(lib, takeError, f.Name, f.Args, f.Ret)?
  end
  for cls in spec.Classes
    out["$(cls.Name).new"] = bind(lib, takeError, "$(cls.Name)_new", cls.New, "ptr")?
    out["$(cls.Name).delete"] = bind(lib, takeError, "$(cls.Name)_delete", ["ptr"], "void")?
    for m in cls.Methods
      out["$(cls.Name).$(m.Name)"] = bind(lib, takeError, "$(cls.Name)_$(m.Name)", list.Concat(["ptr"], m.Args), m.Ret)?
    end
  end
  result.Ok(out)
end
