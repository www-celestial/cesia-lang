(** C++ has no stable binary interface, so Cesia reaches it through a small C layer, generated here, compiled once by
    the C++ compiler and loaded with c. A C++ exception becomes a panic. Templates work through their concrete types. *)
use c
use sys

cppTypes = {"i8": "int8_t", "u8": "uint8_t", "i16": "int16_t", "u16": "uint16_t", "i32": "int32_t", "u32": "uint32_t",
  "i64": "int64_t", "u64": "uint64_t", "f32": "float", "f64": "double", "bool": "bool", "ptr": "void *",
  "text": "const char *", "void": "void"}

(** What can be wrapped. call is the C++ name, when it isn't the name in Cesia. *)
Fn(name, args, ret, call = missing) = {Name: name, Args: args, Ret: ret, Call: if IsMissing(call) name else call end}
(** A method of a class, described like fn. *)
Method(name, args, ret, call = missing) = Fn(name, args, ret, call = call)
(** A class to wrap: its name in Cesia, its C++ type, its methods and the argument types of its constructor. *)
Class(name, type, methods, new = []) = {Name: name, Type: type, Methods: methods, New: new}

arguments(types) = Join(", ", ["a$k" for k in 1:Len(types)])

defn params(types, first)
  Join(", ", Concat(first, ["$(cppTypes[types[k]]) a$k" for k in 1:Len(types)]))
end

defn body(ret, call)
  if ret == "void"
    "KP_TRY $call; KP_CATCH()"
  else if ret == "text"
    "KP_TRY kp_text = $call; return kp_text.c_str(); KP_CATCH(nullptr)"
  else
    "KP_TRY return $call; KP_CATCH(0)"
  end
end

export(ret, name, params, body) = "$(cppTypes[ret]) $name($params) { $body }"

defn method(cls, m)
  object = "static_cast<$(cls.Type) *>(self)"
  export(m.Ret, "$(cls.Name)_$(m.Name)", params(m.Args, ["void *self"]), body(m.Ret, "$object->$(m.Call)($(arguments(m.Args)))"))
end

defn class(cls)
  new = export("ptr", "$(cls.Name)_new", params(cls.New, []), body("ptr", "new $(cls.Type)($(arguments(cls.New)))"))
  delete = "void $(cls.Name)_delete(void *self) { delete static_cast<$(cls.Type) *>(self); }"
  Join("\n", Concat([new, delete], [method(cls, m) for m in cls.Methods]))
end

function(f) = export(f.Ret, f.Name, params(f.Args, []), body(f.Ret, "$(f.Call)($(arguments(f.Args)))"))

defn Source(spec)
  (** The C++ source of the layer. *)
  includes = Join("\n", ["#include $i" for i in spec.Include])
  parts = Concat([class(cls) for cls in spec.Classes], [function(f) for f in spec.Functions])
  "// Generated by std/cpp.ce.
#include <cstdint>
#include <exception>
#include <string>
$includes

static thread_local std::string kp_text, kp_error;
static thread_local bool kp_failed = false;
#define KP_TRY try {
#define KP_CATCH(value) } catch (const std::exception &e) { kp_failed = true; kp_error = e.what(); } \\
  catch (...) { kp_failed = true; kp_error = \"a C++ exception\"; } return value;

extern \"C\" {
const char *kp_take_error() { if (!kp_failed) return nullptr; kp_failed = false; return kp_error.c_str(); }
$(Join("\n", parts))
}
"
end

defn after(value, takeError)
  e = takeError()
  if IsMissing(e) value else Panic("C++: $e") end
end

defn guard(f, n, t)
  match n
    0 -> () -> after(f(), t)
    1 -> a -> after(f(a), t)
    2 -> (a, b) -> after(f(a, b), t)
    3 -> (a, b, d) -> after(f(a, b, d), t)
    4 -> (a, b, d, e) -> after(f(a, b, d, e), t)
    5 -> (a, b, d, e, g) -> after(f(a, b, d, e, g), t)
    else -> Panic("cpp: a function takes at most 5 arguments.")
  end
end

defn bind(lib, takeError, name, args, ret)
  f = c.Fn(name, args, ret, lib)?
  Ok(guard(f, Len(args), takeError))
end

defn compile(compiler, cppFile, library)
  r = sys.Run(compiler, args = ["-std=c++20", "-shared", "-fPIC", "-O2", "-o", library, cppFile])?
  if r.Code == 0
    Ok(missing)
  else
    Err({Kind: "cpp", Message: r.Err})
  end
end

defn Wrap(spec, folder = ".", compiler = "c++")
  (** Compiles what changed, loads it, and gives a dictionary of functions: "name", "Class.method", "Class.new". *)
  cppFile = "$folder/$(spec.Name)_cesia.cpp"
  library = "$folder/lib$(spec.Name)_cesia.so"
  text = Source(spec)
  same = sys.Exists(cppFile) and sys.Exists(library) and UnwrapOr("", sys.Read(cppFile)) == text
  if not same
    sys.Write(cppFile, text)?
    compile(compiler, cppFile, library)?
  end
  lib = c.Open(library)?
  takeError = c.Fn("kp_take_error", [], "text", lib)?
  out = Dict()
  for f in spec.Functions
    out[f.Name] = bind(lib, takeError, f.Name, f.Args, f.Ret)?
  end
  for cls in spec.Classes
    out["$(cls.Name).new"] = bind(lib, takeError, "$(cls.Name)_new", cls.New, "ptr")?
    out["$(cls.Name).delete"] = bind(lib, takeError, "$(cls.Name)_delete", ["ptr"], "void")?
    for m in cls.Methods
      out["$(cls.Name).$(m.Name)"] = bind(lib, takeError, "$(cls.Name)_$(m.Name)", Concat(["ptr"], m.Args), m.Ret)?
    end
  end
  Ok(out)
end
