(** Undo and redo: values don't change, so a history only keeps the ones it saw. *)
use std/list
use std/value

(** A history that starts at a state and keeps at most limit past states. *)
Of(state, limit = 1000) = {Past: [], Present: state, Future: [], Limit: limit}
(** The state now.

      Current(Of(1)) --> 1 *)
Current(h) = h.Present

defn Record(state, h)
  (** A history with a new state, which forgets what could be redone. *)
  past = list.Append(h.Present, h.Past)
  kept = if value.Len(past) > h.Limit list.Skip(1, past) else past end
  {Past: kept, Present: state, Future: [], Limit: h.Limit}
end

(** Is there a past state to go back to?

      CanUndo(Of(1)) --> false *)
CanUndo(h) = value.Len(h.Past) > 0
(** Is there an undone state to go forward to?

      CanRedo(Of(1)) --> false *)
CanRedo(h) = value.Len(h.Future) > 0

defn Undo(h)
  (** The history one state back, or the same one if there is none.

        Current(Undo(Record(2, Of(1)))) --> 1 *)
  if not CanUndo(h)
    return h
  end
  n = value.Len(h.Past)
  {Past: list.Take(n - 1, h.Past), Present: h.Past[n], Future: list.Append(h.Present, h.Future), Limit: h.Limit}
end

defn Redo(h)
  (** The history one state forward after an undo, or the same one if there is none.

        Current(Redo(Undo(Record(2, Of(1))))) --> 2 *)
  if not CanRedo(h)
    return h
  end
  n = value.Len(h.Future)
  {Past: list.Append(h.Present, h.Past), Present: h.Future[n], Future: list.Take(n - 1, h.Future), Limit: h.Limit}
end
