(** Shapes: what a value that comes from outside must be, as the body of a request, a form, a query, the settings of a
    program or a line of a file. A shape is a map that says it: Text(1, 200), Int(1, 1000000), Money(2), Record({...}).
    Read(shape, x) gives an Ok of the value made clean (spaces trimmed, an e-mail in lower case, a date in seconds since
    1970), or an Err of a map from each wrong field to what is wrong. Nothing passes without a bound: a text has its most
    bytes, a number its range, a list its most items. The same shape runs in a page, in WebAssembly, and on the server,
    which checks again: it is pure Cesia. Out(shape, x) gives a value back to the outside: the fields the shape declares
    and no other, dates written as text.

      Read(Record({Name: Text(1, 20), Age: Int(0, 150)}), {Name: "  Ada ", Age: 36}) --> result.Ok({Name: "Ada", Age: 36})
      Read(Record({Name: Text(1, 20)}), {Name: ""}) --> result.Err({Name: "Text of 1 to 20 bytes."}) *)
use std/date
use std/dict
use std/list
use std/math
use std/result
use std/text
use std/value

(* The largest Int a shape takes unless it says otherwise: 2^30 - 1, which an Int holds in a page too (WebAssembly). *)
most = 1073741823

shape(kind, optional, default, more) = dict.Put("Kind", kind, dict.Put("Optional", optional, dict.Put("Default", default, more)))

(** A text of min to max bytes of valid UTF-8, its spaces at both ends trimmed, without control characters; lines =
    true lets it hold line ends and tabs. optional: it may be absent, and is then default.

      Read(Text(1, 5), " hi ") --> result.Ok("hi")
      Read(Text(1, 5, optional = true, default = "x"), missing) --> result.Ok("x") *)
Text(min = 0, max = 1000, lines = false, optional = false, default = missing) = shape("text", optional, default, {Min: min, Max: max, Lines: lines})

(** A text that is a secret, as a password or a token: read as Text, never trimmed, written "(secret)" by Masked, and
    never given back by Out.

      Masked(Record({Login: Text(), Password: Secret()}), {Login: "ada", Password: "hunter2hunter2"}) --> {Login: "ada", Password: "(secret)"} *)
Secret(min = 1, max = 4096, optional = false, default = missing) = shape("secret", optional, default, {Min: min, Max: max, Lines: false})

(** A whole number from min to max: by default from -(2^30 - 1) to 2^30 - 1, which a page holds too.

      Read(Int(1, 10), 11) --> result.Err({"": "A whole number from 1 to 10."}) *)
Int(min = -most, max = most, optional = false, default = missing) = shape("int", optional, default, {Min: min, Max: max})

(** A number from min to max, whole or not; never NaN nor infinite. *)
Float(min = -1e15, max = 1e15, optional = false, default = missing) = shape("float", optional, default, {Min: min, Max: max})

(** An amount of money with at most scale decimals, from min to max, as a Float: Money(2) takes 12.5 and 12.50, not 12.505.

      Read(Money(2), 12.505) --> result.Err({"": "An amount from 0 to 1000000000, with at most 2 decimals."}) *)
Money(scale = 2, min = 0, max = 1000000000, optional = false, default = missing) = shape("money", optional, default, {Scale: scale, Min: min, Max: max})

(** true or false. *)
Bool(optional = false, default = missing) = shape("bool", optional, default, {})

(** A day written as 2026-11-25, read as its seconds since 1970 at 00:00 UTC, as Cepheus keeps a date; Out writes it back.

      Read(Date(), "2026-12-01") --> result.Ok(1796083200)
      Out(Date(), 1796083200) --> "2026-12-01" *)
Date(optional = false, default = missing) = shape("date", optional, default, {})

(** An instant written as 2026-11-25T18:30:00Z, or with an offset as +01:00, read as its seconds since 1970, as Cepheus
    keeps an instant (a cepheus.Date); Out writes it back in UTC, to the second.

      Read(Time(), "2026-12-01T09:30:00+01:00") --> result.Ok(1796113800)
      Out(Time(), 1796113800) --> "2026-12-01T08:30:00Z" *)
Time(optional = false, default = missing) = shape("time", optional, default, {})

(** An e-mail address of the usual form, at most max bytes, in lower case.

      Read(Email(), " Ada@Example.COM ") --> result.Ok("ada@example.com") *)
Email(max = 254, optional = false, default = missing) = shape("email", optional, default, {Max: max})

(** The id of a thing: a whole number above 0. In a page, an id past 2^30 - 1 is refused with this message rather than
    read wrong. *)
Id(optional = false, default = missing) = shape("id", optional, default, {})

(** An address of the web, http:// or https:// then a host, at most max bytes; https = true takes https:// only.

      Read(Url(https = true), "http://example.com") --> result.Err({"": "An address that starts with https://."}) *)
Url(max = 2000, https = false, optional = false, default = missing) = shape("url", optional, default, {Max: max, Https: https})

(** One of a list of values.

      Read(OneOf(["unpaid", "paid"]), "late") --> result.Err({"": "One of: unpaid, paid."}) *)
OneOf(values, optional = false, default = missing) = shape("oneof", optional, default, {Values: values})

(** A list of min to max values of a shape. A wrong item is named by its place: Lines.2.Qty.

      Read(List(Int(0, 9), 1, 3), [1, 2]) --> result.Ok([1, 2]) *)
List(of, min = 0, max = 100, optional = false, default = missing) = shape("list", optional, default, {Of: of, Min: min, Max: max})

(** A map of fields, each with its shape. Read keeps the fields of the shape and drops any other, so that a field the
    sender adds never reaches what is written; Out gives the fields of the shape only, so that a field added later to
    the data never leaves by accident.

      Read(Record({A: Int()}), {A: 1, Admin: true}) --> result.Ok({A: 1}) *)
Record(fields, optional = false, default = missing) = shape("record", optional, default, {Fields: fields})

defn Read(shape, x, texts = false)
  (** An Ok of x made clean by its shape, or an Err of a map from each wrong field to its message: the field's path
      from the top, as Lines.2.Qty, or "" for the value itself. texts = true reads values written as texts, as a query,
      a form or the environment give them: "42" for an Int, "true" for a Bool, and "" for an absent field.

        Read(Record({Page: Int(1, 99, optional = true, default = 1)}), {Page: "3"}, texts = true) --> result.Ok({Page: 3}) *)
  got = read(shape, x, texts, "")
  if result.IsOk(got)
    return got
  end
  wrong = {}
  for w in got.Error
    if not dict.Has(w[1], wrong)
      wrong[w[1]] = w[2]
    end
  end
  result.Err(wrong)
end

defn tens(k)
  (** 10 to the power k, exactly. *)
  out = 1
  for i in 1..k
    out = out * 10
  end
  out
end

fail(path, message) = result.Err([[path, message]])
join(path, name) = if path == "" "$name" else "$path.$name" end

defn plain(s, lines)
  (** Is s valid UTF-8 without control characters, line ends and tabs too when lines? *)
  text.IsUtf8(s) and value.IsMissing(text.ByteFindAny(if lines bad else badLine end, 1, s))
end
bad = text.FromBytes([b for b in 0..31 if b != 9 and b != 10 and b != 13] then list.Append(127))
badLine = text.FromBytes(list.Append(127, [b for b in 0..31]))

defn number(x, texts)
  (** x as a number: itself, or the number a text writes when texts; missing otherwise, NaN and infinities too. *)
  n = if texts and value.IsText(x) and text.ByteLength(x) <= 40 text.Number(text.Trim(x)) else x end
  if value.IsNumber(n) and n == n and math.Abs(n) < 1e300 n else missing end
end

defn read(shape, x, texts, path)
  if texts and x == ""
    x = missing
  end
  if value.IsMissing(x)
    return if shape.Optional result.Ok(shape.Default) else fail(path, "Required.") end
  end
  kind = shape.Kind
  if kind == "text" or kind == "secret"
    s = if not value.IsText(x) missing else if kind == "text" text.Trim(x) else x end
    if value.IsMissing(s) or text.ByteLength(s) < shape.Min or text.ByteLength(s) > shape.Max
      return fail(path, "Text of $(shape.Min) to $(shape.Max) bytes.")
    end
    return if plain(s, shape.Lines) result.Ok(s) else fail(path, "Text without control characters.") end
  end
  if kind == "int" or kind == "id"
    n = number(x, texts)
    lo = if kind == "id" 1 else shape.Min end
    if value.IsInt(n) and n >= lo and (kind == "id" or n <= shape.Max)
      return result.Ok(n)
    end
    return fail(path, if kind == "id" "An id." else "A whole number from $(shape.Min) to $(shape.Max)." end)
  end
  if kind == "float" or kind == "money"
    n = number(x, texts)
    ok = value.IsNumber(n) and n >= shape.Min and n <= shape.Max
    if kind == "float"
      return if ok result.Ok(n) else fail(path, "A number from $(shape.Min) to $(shape.Max).") end
    end
    unit = tens(shape.Scale)
    if ok and math.Abs(math.Round(n * unit) - n * unit) < 0.000001 * unit
      return result.Ok(n)
    end
    return fail(path, "An amount from $(shape.Min) to $(shape.Max), with at most $(shape.Scale) decimals.")
  end
  if kind == "bool"
    b = if texts and x in ["true", "1", "on"] true else if texts and x in ["false", "0", "off"] false else x end
    return if value.IsBool(b) result.Ok(b) else fail(path, "true or false.") end
  end
  if kind == "date"
    d = if value.IsText(x) and text.ByteLength(x) == 10 date.Parse(x) else result.Err("") end
    return if result.IsOk(d) result.Ok(date.ToUnix(d.Value)) else fail(path, "A date, as 2026-11-25.") end
  end
  if kind == "time"
    d = if value.IsText(x) and text.ByteLength(x) >= 19 and text.ByteLength(x) <= 30 and text.Contains("T", x) date.Parse(x) else result.Err("") end
    return if result.IsOk(d) result.Ok(date.ToUnix(d.Value)) else fail(path, "An instant, as 2026-11-25T18:30:00Z.") end
  end
  if kind == "email"
    return email(x, shape.Max, path)
  end
  if kind == "url"
    return url(x, shape, path)
  end
  if kind == "oneof"
    for v in shape.Values
      if value.Equal(v, x)
        return result.Ok(v)
      end
    end
    return fail(path, "One of: $(text.Join(", ", [value.Text(v) for v in shape.Values])).")
  end
  if kind == "list"
    if not value.IsArray(x) or value.Len(x) < shape.Min or value.Len(x) > shape.Max
      return fail(path, "A list of $(shape.Min) to $(shape.Max) items.")
    end
    return gather([read(shape.Of, x[k], texts, join(path, k)) for k in 1..value.Len(x)], items -> items)
  end
  if kind == "record"
    if not value.IsDict(x)
      return fail(path, "An object with fields.")
    end
    names = dict.Keys(shape.Fields)
    return gather([read(shape.Fields[n], dict.Get(n, x), texts, join(path, n)) for n in names], values -> record(names, values))
  end
  fail(path, "Not a shape of std/check.")
end

defn record(names, values)
  (** The map of names to values, without the fields whose value is missing. *)
  out = {}
  for k in 1..value.Len(names)
    if not value.IsMissing(values[k])
      out[names[k]] = values[k]
    end
  end
  out
end

defn gather(results, make)
  (** An Ok of make(the values) when every result is Ok, else an Err of all their wrong fields. *)
  wrong = list.Flatten([r.Error for r in results if result.IsErr(r)])
  if value.Len(wrong) > 0 result.Err(wrong) else result.Ok(make([r.Value for r in results])) end
end

defn email(x, max, path)
  s = if value.IsText(x) text.Lower(text.Trim(x)) else "" end
  at = text.Split("@", s)
  ok = text.ByteLength(s) <= max and value.Len(at) == 2 and at[1] != "" and plain(s, false) and not text.Contains(" ", s)
  parts = if ok text.Split(".", at[2]) else [] end
  if ok and value.Len(parts) >= 2 and not list.Any([p == "" for p in parts]) result.Ok(s) else fail(path, "An e-mail address, as ada@example.com.") end
end

defn url(x, shape, path)
  s = if value.IsText(x) text.Trim(x) else "" end
  scheme = if text.StartsWith("https://", s) 9 else if text.StartsWith("http://", s) and not shape.Https 8 else 0 end
  host = if scheme > 0 text.Split("/", text.ByteSlice(scheme, text.ByteLength(s), s))[1] else "" end
  ok = scheme > 0 and host != "" and text.ByteLength(s) <= shape.Max and plain(s, false) and not text.Contains(" ", s)
  if ok result.Ok(s) else fail(path, if shape.Https "An address that starts with https://." else "An address that starts with https:// or http://." end) end
end

defn Out(shape, x)
  (** x given back to the outside by its shape: of a Record, the fields it declares and no other; of a List, each item;
      a Date as its text; a Secret never (missing). Out trusts x: it reads what the program made, and checks nothing.

        Out(Record({Id: Id(), Name: Text()}), {Id: 7, Name: "Ada", Office: 3}) --> {Id: 7, Name: "Ada"} *)
  if value.IsMissing(x)
    return missing
  end
  kind = shape.Kind
  if kind == "record" and value.IsDict(x)
    out = {}
    for pair in dict.Pairs(shape.Fields)
      v = Out(pair.Value, dict.Get(pair.Key, x))
      if not value.IsMissing(v)
        out[pair.Key] = v
      end
    end
    return out
  end
  if kind == "list" and value.IsArray(x)
    return [Out(shape.Of, v) for v in x]
  end
  if kind == "date" and value.IsNumber(x)
    return date.FormatDate(date.FromUnix(x))
  end
  if kind == "time" and value.IsNumber(x)
    return date.Format(date.FromUnix(x))
  end
  if kind == "secret" missing else x end
end

defn Masked(shape, x)
  (** x with each value of a Secret written "(secret)", to log it: a password, a token never reach a log. *)
  if shape.Kind == "secret"
    return if value.IsMissing(x) missing else "(secret)" end
  end
  if shape.Kind == "record" and value.IsDict(x)
    out = x
    for pair in dict.Pairs(shape.Fields)
      if dict.Has(pair.Key, x)
        out[pair.Key] = Masked(pair.Value, x[pair.Key])
      end
    end
    return out
  end
  if shape.Kind == "list" and value.IsArray(x) [Masked(shape.Of, v) for v in x] else x end
end

defn Schema(shape)
  (** The JSON Schema (2020-12) of a shape, as OpenAPI 3.1 and later describe a body: a map to write with json.Text.
      Text lengths are in bytes here, where JSON Schema counts characters: the schema is never stricter than Read.

        Schema(Int(1, 9)) --> {type: "integer", minimum: 1, maximum: 9} *)
  kind = shape.Kind
  if kind == "text" {type: "string", minLength: shape.Min, maxLength: shape.Max}
  else if kind == "secret" {type: "string", format: "password", writeOnly: true, minLength: shape.Min, maxLength: shape.Max}
  else if kind == "int" {type: "integer", minimum: shape.Min, maximum: shape.Max}
  else if kind == "float" {type: "number", minimum: shape.Min, maximum: shape.Max}
  else if kind == "money" {type: "number", minimum: shape.Min, maximum: shape.Max, multipleOf: 1 / tens(shape.Scale)}
  else if kind == "bool" {type: "boolean"}
  else if kind == "date" {type: "string", format: "date"}
  else if kind == "time" {type: "string", format: "date-time"}
  else if kind == "email" {type: "string", format: "email", maxLength: shape.Max}
  else if kind == "id" {type: "integer", minimum: 1}
  else if kind == "url" {type: "string", format: "uri", maxLength: shape.Max}
  else if kind == "oneof" {enum: shape.Values}
  else if kind == "list" {type: "array", items: Schema(shape.Of), minItems: shape.Min, maxItems: shape.Max}
  else {type: "object", properties: dict.Dict([{Key: p.Key, Value: Schema(p.Value)} for p in dict.Pairs(shape.Fields)]),
    required: [p.Key for p in dict.Pairs(shape.Fields) if not p.Value.Optional]}
  end
end
