(** A persistent leftist heap: the smallest key comes out first. *)
use std/dict
use std/value

(** A heap with nothing in it.

      Items(Empty()) --> [] *)
Empty() = missing
(** Is this heap empty?

      IsEmpty(Empty()) --> true *)
IsEmpty(h) = value.IsMissing(h)
rank(h) = if value.IsMissing(h) 0 else h.Rank end

defn node(key, item, a, b)
  if rank(a) >= rank(b)
    {Key: key, Value: item, Left: a, Right: b, Rank: rank(b) + 1}
  else
    {Key: key, Value: item, Left: b, Right: a, Rank: rank(a) + 1}
  end
end

defn Merge(a, b)
  (** One heap from two.

        Items(Merge(Insert(2, "b", Empty()), Insert(1, "a", Empty()))) --> [{Key: 1, Value: "a"}, {Key: 2, Value: "b"}] *)
  if value.IsMissing(a)
    b
  else if value.IsMissing(b)
    a
  else if a.Key <= b.Key
    node(a.Key, a.Value, a.Left, Merge(a.Right, b))
  else
    node(b.Key, b.Value, b.Left, Merge(a, b.Right))
  end
end

(** A heap with a value added under a key; the smallest key comes out first.

      Peek(Insert(1, "a", Empty())).Value --> "a" *)
Insert(key, item, h) = Merge(node(key, item, missing, missing), h)
(** The smallest key and its value, as a struct with key and value. The heap must not be empty.

      Peek(Insert(2, "b", Insert(1, "a", Empty()))).Key --> 1 *)
Peek(h) = {Key: h.Key, Value: h.Value}
(** The heap without its smallest key. The heap must not be empty.

      Peek(Pop(Insert(2, "b", Insert(1, "a", Empty())))).Key --> 2 *)
Pop(h) = Merge(h.Left, h.Right)

defn Items(h)
  (** All the entries as structs with key and value, smallest key first.

        value.Len(Items(Insert(1, "a", Empty()))) --> 1 *)
  out = dict.Dict()
  while not value.IsMissing(h)
    out[value.Len(out) + 1] = Peek(h)
    h = Pop(h)
  end
  dict.Values(out)
end
