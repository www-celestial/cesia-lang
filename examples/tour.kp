-- The language in one file: kepler run examples/tour.kp

-- Functions: the short form, and the long one, which gives its last value.
double(x) = x * 2

defn greet(name)
  "Hello, $name"
end

print(greet("world"))

-- Arrays start at 1.
numbers = [1, 2, 3, 4]
print(numbers[1])

-- Functions come first, the collection last.
print(map(double, numbers))
print(filter(x -> x > 2, numbers))
print(reduce((total, x) -> total + x, 0, numbers))

-- A pipeline, where it is the current element.
print(numbers then filter(it > 1) then map(it * 10))

-- Structs.
point = {x: 1, y: 2}
print(point.x + point.y)

-- Loops and conditions.
for n in 1:3
  if n == 2
    print("two")
  else
    print(n)
  end
end

-- Errors are values: Ok or Err, and ? passes an Err on to the caller.
defn half(n)
  if mod(n, 2) == 0
    Ok(n / 2)
  else
    Err({kind: "odd", message: "$n is odd"})
  end
end

defn quarter(n)
  once = half(n)?
  half(once)
end

print(quarter(8))
print(quarter(6))

-- match takes structures apart.
describe(result) = match result
  Ok(value) -> "got $value"
  Err(e) -> "failed: $(e.message)"
end

print(describe(quarter(6)))

-- Fibers run side by side.
task = spawn(() -> double(21))
print(wait(task))
