(** A material editor: drag a node, turn the light on the sphere, move Metallic or Roughness, press t for the other theme.
    Run from the root of the repository: cesia run --allow ffi=SDL3,ffi=SDL3_ttf examples/material.ce *)
use sdl
use examples/scene as scene

defn opened()
  first = sdl.Open("Cesia", 1280, 720, "examples/fonts/AdwaitaSans-Regular.ttf", size = 13, light = true)?
  second = sdl.AddFont("strong", "examples/fonts/NotoSans-Medium.ttf", 13, first, light = true)?
  third = sdl.AddFont("code", "examples/fonts/JetBrainsMono-Regular.ttf", 13, second)?
  sdl.AddFont("large", "examples/fonts/AdwaitaSans-Regular.ttf", 42, third, light = true)
end

defn main()
  begun = scene.Start(opened()?)?
  sdl.Run(begun.State, scene.Update, scene.View, begun.Window, moving = scene.Moving)
  sdl.Close(begun.Window)
  Ok(missing)
end

Print(main())
