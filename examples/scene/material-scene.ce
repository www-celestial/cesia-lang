(** The scene of a material editor: a sphere lit by Cesia, a graph of nodes, details, a palette and a code pane. examples/material.ce
    runs it, and bench/ui-frame.ce measures it. c is used for one thing: the pixels of the sphere, which follow the mouse. *)
use c
use sdl
use ui

sharpSize = 208
quickSize = 64
tintColor = 0xD98F4E
vec = 0xE8C547
number = 0x8BC34A
channel = 0xE5534B

pin(name, color) = {Name: name, Color: color}

nodes = [
  {X: 330, Y: 126, Width: 150, Title: "Base Tint", Color: 0x6E7B2A, Inputs: [], Outputs: [pin("RGB", vec)], Body: 64},
  {X: 330, Y: 258, Width: 150, Title: "T_Brushed_D", Color: 0x2A6FA8, Inputs: [pin("UVs", vec)], Outputs: [pin("RGB", vec), pin("R", channel)], Body: 80},
  {X: 560, Y: 176, Width: 112, Title: "Multiply", Color: 0x3F7A54, Inputs: [pin("A", vec), pin("B", vec)], Outputs: [pin("", vec)], Body: 0},
  {X: 560, Y: 384, Width: 112, Title: "Metallic", Color: 0x3F7A54, Inputs: [], Outputs: [pin("", number)], Body: 0},
  {X: 560, Y: 452, Width: 112, Title: "Roughness", Color: 0x3F7A54, Inputs: [], Outputs: [pin("", number)], Body: 0},
  {X: 790, Y: 126, Width: 200, Title: "M_Surface", Color: 0x7A5A2E, Outputs: [], Body: 0, Inputs: [pin("Base Color", vec), pin("Metallic", number), pin("Specular", number), pin("Roughness", number),
    pin("Anisotropy", number), pin("Emissive Color", number), pin("Opacity", number), pin("Normal", number), pin("Tangent", number), pin("Ambient Occlusion", number)]}
]

link(from, output, to, input, color) = {From: from, Output: output, To: to, Input: input, Color: color}
links = [link(1, 1, 3, 1, vec), link(2, 1, 3, 2, vec), link(3, 1, 6, 1, vec), link(4, 1, 6, 2, number), link(5, 1, 6, 4, number), link(2, 2, 6, 3, channel)]

row(name) = {Name: name, Header: false}
head(name) = {Name: name, Header: true}
palette = [head("Math"), row("Add"), row("Lerp"), row("Multiply"), row("Power"), row("Saturate"), head("Texture"), row("TextureCoordinate"), row("TextureSample"), row("Panner"),
  head("Constants"), row("Constant"), row("Constant3Vector"), row("Time"), head("Utility"), row("Fresnel"), row("If"), row("StaticSwitch"), row("VertexNormal")]

menus = ["File", "Edit", "Asset", "Window", "Tools", "Help"]

defn tools(th)
  tool = (shape, name) -> {Shape: shape, Name: name, Color: th.Muted}
  [tool(ui.Icons.Save, "Save"), tool(ui.Icons.Browse, "Browse"), missing, {Shape: ui.Icons.Apply, Name: "Apply", Color: 0x57B368}, missing, tool(ui.Icons.Search, "Search"), tool(ui.Icons.Home, "Home"),
    tool(ui.Icons.Hierarchy, "Hierarchy"), missing, {Shape: ui.Icons.Live, Name: "Live Update", Color: 0x3B9BFF}, tool(ui.Icons.Stats, "Stats")]
end

clamp01(x) = Max(0.0, Min(1.0, x))
smooth(t) = t * t * (3.0 - 2.0 * t)
mix(a, b, t) = a + (b - a) * t

defn ShadeSphere(block, n, rough, metal, turn)
  (** The sphere: a diffuse part, a highlight that tightens as roughness falls, and a sky that metal reflects. *)
  radius = n / 2.0 - 1.5
  center = n / 2.0
  lx = -0.46 * Cos(turn) + 0.634 * Sin(turn)
  ly = 0.62
  lz = 0.46 * Sin(turn) + 0.634 * Cos(turn)
  size = Sqrt(lx * lx + ly * ly + (lz + 1.0) * (lz + 1.0))
  hx = lx / size
  hy = ly / size
  hz = (lz + 1.0) / size
  smoothness = 1.0 - rough
  power = 4.0 + 900.0 * smoothness * smoothness * smoothness
  strength = 0.25 + 3.2 * smoothness * smoothness
  sheen = 1.0 - rough * 0.82
  spread = 0.04 + rough * 0.9
  br = 0.72
  bg = 0.31
  bb = 0.09
  fr = mix(0.04, br, metal)
  fg = mix(0.04, bg, metal)
  fb = mix(0.04, bb, metal)
  matte = 1.0 - metal
  for y in 0:(n - 1)
    ny = (center - y - 0.5) / radius
    for x in 0:(n - 1)
      nx = (x + 0.5 - center) / radius
      r2 = nx * nx + ny * ny
      if r2 >= 1.06
        c.Set("u32", (y * n + x) * 4, 0, block)
      else
        nz = Sqrt(Max(0.0, 1.0 - r2))
        coverage = clamp01((1.0 - Sqrt(r2)) * radius + 0.5)
        diffuse = Max(0.0, nx * lx + ny * ly + nz * lz)
        nh = Max(0.0, nx * hx + ny * hy + nz * hz)
        spec = strength * (nh ^ power)
        edge = 1.0 - nz
        rim = edge * edge * edge * edge * edge
        up = 2.0 * nz * ny
        horizon = smooth(clamp01((up + spread) / (2.0 * spread)))
        env = mix(0.04 + 0.10 * clamp01(-up), 0.34 + 0.72 * clamp01(up), horizon)
        light = 0.10 + 0.95 * diffuse
        r = br * matte * light + fr * env + (fr + (1.0 - fr) * rim) * spec + rim * 0.08 * sheen
        g = bg * matte * light + fg * env + (fg + (1.0 - fg) * rim) * spec + rim * 0.08 * sheen
        b = bb * matte * light + fb * env + (fb + (1.0 - fb) * rim) * spec + rim * 0.09 * sheen
        pr = sdl.WholeNumber(255.0 * Sqrt(1.0 - Exp(-1.5 * r)))
        pg = sdl.WholeNumber(255.0 * Sqrt(1.0 - Exp(-1.5 * g)))
        pb = sdl.WholeNumber(255.0 * Sqrt(1.0 - Exp(-1.5 * b)))
        c.Set("u32", (y * n + x) * 4, pr + pg * 256 + pb * 65536 + sdl.WholeNumber(coverage * 255.0) * 0x1000000, block)
      end
    end
  end
end

defn layout(w, h)
  (** The panels follow the size of the window. *)
  body = {X: 4, Y: 68, Width: Max(0, w - 8), Height: Max(0, h - 72)}
  columns = ui.Left(292, body)
  sides = ui.Right(236, columns.Rest)
  center = ui.Left(4, ui.Right(4, sides.Rest).Rest).Rest
  stack = ui.Top(250, columns.Part)
  pane = ui.Bottom(192, center)
  {Menu: {X: 0, Y: 0, Width: w, Height: 24}, Tools: {X: 0, Y: 28, Width: w, Height: 32}, Viewport: stack.Part, Details: ui.Top(4, stack.Rest).Rest, Graph: ui.Bottom(4, pane.Rest).Rest, Code: pane.Part, Palette: sides.Part}
end

graphArea(rect) = {X: rect.X + 2, Y: rect.Y + 28, Width: Max(0, rect.Width - 4), Height: Max(0, rect.Height - 30)}
paletteArea(rect) = {X: rect.X + 8, Y: rect.Y + 60, Width: Max(0, rect.Width - 16), Height: Max(0, rect.Height - 68)}

(** The slider k of the details: 0 for Metallic, 1 for Roughness. *)
SliderRect(details, k) = {X: details.X + 130, Y: details.Y + 246 + k * 26, Width: Max(0, details.Width - 138), Height: 22}

defn Start(window)
  sharp = sdl.Image(sharpSize, sharpSize, window)?
  quick = sdl.Image(quickSize, quickSize, sharp.Window)?
  brushed = sdl.Image(62, 62, quick.Window)?
  sky = sdl.Image(2, 32, brushed.Window)?
  floorImage = sdl.Image(64, 16, sky.Window)?
  w = floorImage.Window
  sdl.FillImage((x, y) -> sdl.Rgba(132 + Mod(y * 37 + Div(x, 19) * 13, 15) + Mod(y * 5, 6), 132 + Mod(y * 37 + Div(x, 19) * 13, 15) + Mod(y * 5, 6), 132 + Mod(y * 37 + Div(x, 19) * 13, 15) + Mod(y * 5, 6), 255), brushed.Image, w)
  sdl.FillImage((x, y) -> sdl.Rgba(51 - y, 59 - y, 69 - Div(y * 16, 10), 255), sky.Image, w)
  sdl.FillImage((x, y) -> sdl.Rgba(0, 0, 0, sdl.WholeNumber(200.0 * smooth(clamp01(1.0 - Sqrt(((x + 0.5 - 32.0) / 32.0) ^ 2 + ((y + 0.5 - 8.0) / 8.0) ^ 2))))), floorImage.Image, w)
  ShadeSphere(sharp.Image.Pixels, sharpSize, 0.32, 0.9, 0.0)
  sdl.ShowImage(sharp.Image, w)
  ShadeSphere(quick.Image.Pixels, quickSize, 0.32, 0.9, 0.0)
  sdl.ShowImage(quick.Image, w)
  images = {Sharp: sharp.Image, Quick: quick.Image, Brushed: brushed.Image, Sky: sky.Image, Floor: floorImage.Image}
  hover = ui.ListRow(2, palette, paletteArea(layout(1280, 720).Palette)) * 1.0
  m = sdl.Measure(w)
  Ok({Window: w, State: {Width: 1280, Height: 720, Rects: layout(1280, 720), WidthOf: m.Width, Line: m.Height, BigWidth: sdl.TextSize("MATERIAL", w, font = "large").Width, Window: w, Images: images, Nodes: nodes, Picked: 3,
    Dark: true, Rough: 0.32, ShownRough: 0.32, Metal: 0.9, ShownMetal: 0.9, Light: 0.0, ShownLight: 0.0, Lit: {Rough: 0.32, Metal: 0.9, Light: 0.0}, Sharp: true, Rested: true,
    Hover: hover, Target: hover, Dragging: 0, Grab: {X: 0, Y: 0}, LastX: 0, Mouse: {X: -1, Y: -1}, Fps: 0.0}})
end

themeOf(state) = if state.Dark ui.Dark else ui.Light end

defn codeLines(state)
  [[[5, "-- The material, as the graph computes it."]],
   [[1, "defn "], [2, "surface"], [6, "("], [7, "uv"], [6, ")"]],
   [[6, "  grain = sample(brushed, uv)"]],
   [[6, "  {base_color: tint * grain.rgb,"]],
   [[6, "   specular: grain.r,"]],
   [[6, "   metallic: "], [4, ui.TwoDecimals(state.ShownMetal)], [6, ","]],
   [[6, "   roughness: "], [4, ui.TwoDecimals(state.ShownRough)], [6, "}"]],
   [[1, "end"]]]
end

label(x, y, words, color) = {Kind: "text", X: x, Y: y, Text: words, Color: color}

defn viewport(state, look)
  r = state.Rects.Viewport
  th = look.Theme
  size = 176
  x = r.X + Div(r.Width - size, 2)
  y = r.Y + 42
  counter = if Moving(state) and state.Fps > 0.0 [label(r.X + r.Width - 56, r.Y + 226, "$(sdl.Whole(state.Fps)) fps", 0x8A8A8A)] else [] end
  Flatten([ui.Panel("Viewport", r, look), [{Kind: "image", Image: state.Images.Sky, X: r.X + 4, Y: r.Y + 28, Width: Max(0, r.Width - 8), Height: Max(0, r.Height - 32)},
    {Kind: "image", Image: state.Images.Floor, X: x + 6, Y: y + 158, Width: size - 12, Height: 26},
    {Kind: "image", Image: if state.Sharp state.Images.Sharp else state.Images.Quick end, X: x, Y: y, Width: size, Height: size},
    {Kind: "box", X: r.X + 10, Y: r.Y + 34, Width: 34, Height: 20, Color: 0x2B2F36, Radius: 4}, label(r.X + 18, r.Y + 34 + Div(20 - look.Height, 2), "Lit", 0xD0D0D0),
    {Kind: "box", X: r.X + 48, Y: r.Y + 34, Width: 48, Height: 20, Color: 0x2B2F36, Radius: 4}, label(r.X + 56, r.Y + 34 + Div(20 - look.Height, 2), "Persp", 0xA8A8A8),
    label(r.X + 10, r.Y + 226, "Base pass: 184 instructions", 0x8A8A8A)], counter])
end

defn details(state, look)
  r = state.Rects.Details
  th = look.Theme
  x = r.X + 8
  w = Max(0, r.Width - 16)
  fieldX = r.X + 130
  fieldW = Max(0, r.Width - 138)
  rectAt = y -> {X: fieldX, Y: r.Y + y, Width: fieldW, Height: 22}
  name = (y, words) -> label(x + 10, r.Y + y + Div(22 - look.Height, 2), words, th.Muted)
  Flatten([ui.Panel("Details", r, look), ui.Field("Search details", {X: x, Y: r.Y + 32, Width: w, Height: 22}, look, hint = true),
    ui.Section("Material", {X: x, Y: r.Y + 60, Width: w, Height: 22}, look),
    [name(86, "Material Domain")], ui.Dropdown("Surface", rectAt(86), look),
    [name(112, "Blend Mode")], ui.Dropdown("Opaque", rectAt(112), look),
    [name(138, "Shading Model")], ui.Dropdown("Default Lit", rectAt(138), look),
    [name(164, "Two Sided")], ui.Checkbox(false, rectAt(164), look),
    ui.Section("Parameters", {X: x, Y: r.Y + 194, Width: w, Height: 22}, look),
    [name(220, "Base Color")], ui.Swatch(tintColor, "#D98F4E", rectAt(220), look),
    [name(246, "Metallic")], ui.Slider(state.ShownMetal, SliderRect(r, 0), look),
    [name(272, "Roughness")], ui.Slider(state.ShownRough, SliderRect(r, 1), look),
    ui.Section("Advanced", {X: x, Y: r.Y + 304, Width: w, Height: 22}, look),
    [name(330, "Tessellation")], ui.Checkbox(true, rectAt(330), look),
    [name(356, "Displacement")], ui.Field("0.0", rectAt(356), look)])
end

defn nodeInsides(state, look)
  n = state.Nodes
  th = look.Theme
  [{Kind: "box", X: n[1].X + 10, Y: n[1].Y + 34, Width: 56, Height: 48, Color: tintColor, Radius: 4}, {Kind: "ring", X: n[1].X + 10, Y: n[1].Y + 34, Width: 56, Height: 48, Color: th.Edge, Radius: 4},
    {Kind: "image", Image: state.Images.Brushed, X: n[2].X + 44, Y: n[2].Y + 34, Width: 62, Height: 62}, {Kind: "ring", X: n[2].X + 44, Y: n[2].Y + 34, Width: 62, Height: 62, Color: th.Edge, Radius: 4},
    label(n[4].X + 13, n[4].Y + 32, ui.TwoDecimals(state.ShownMetal), th.Muted), label(n[5].X + 13, n[5].Y + 32, ui.TwoDecimals(state.ShownRough), th.Muted)]
end

defn graph(state, look)
  r = state.Rects.Graph
  th = look.Theme
  area = graphArea(r)
  Flatten([ui.Panel("Material Graph", r, look, active = true), [{Kind: "box", X: area.X, Y: area.Y, Width: area.Width, Height: area.Height, Color: th.Graph, Radius: 4}], ui.Grid(area, look),
    [{Kind: "text", Font: "large", X: r.X + r.Width - 14 - state.BigWidth, Y: r.Y + r.Height - 56, Text: "MATERIAL", Color: th.Big}, label(r.X + 12, r.Y + 34, "M_Surface  >  Material Graph", th.Muted), label(r.X + r.Width - 62, r.Y + 34, "Zoom 1:1", th.Muted)],
    ui.Links(links, state.Nodes, look), ui.Nodes(state.Nodes, state.Picked, links, look), nodeInsides(state, look)])
end

markedLine(state) = match state.Dragging
  1 -> 6
  2 -> 7
  else -> 0
end

defn View(state)
  th = themeOf(state)
  look = ui.Look(th, state.WidthOf, state.Line)
  r = state.Rects
  codeArea = {X: r.Code.X, Y: r.Code.Y + 28, Width: r.Code.Width, Height: Max(0, r.Code.Height - 28)}
  listArea = paletteArea(r.Palette)
  Flatten([[{Kind: "clear", Color: th.Ground}], ui.MenuBar(menus, "M_Surface", r.Menu, look), ui.ToolBar(tools(th), state.Mouse, r.Tools, look), [{Kind: "rect", X: 0, Y: 62, Width: state.Width, Height: 1, Color: th.Edge}],
    viewport(state, look), details(state, look), graph(state, look), ui.Panel("Cesia", r.Code, look), [{Kind: "box", X: r.Code.X + 2, Y: r.Code.Y + 28, Width: Max(0, r.Code.Width - 4), Height: Max(0, r.Code.Height - 30), Color: th.Code, Radius: 4}], ui.Code(codeLines(state), markedLine(state), codeArea, look),
    ui.Panel("Palette", r.Palette, look), ui.Field("Search nodes", {X: r.Palette.X + 8, Y: r.Palette.Y + 32, Width: Max(0, r.Palette.Width - 16), Height: 22}, look, hint = true), ui.List(palette, 4, state.Hover, listArea, look)])
end

(** Something still eases, or the sharp sphere hasn't come back. *)
Moving(state) = state.Dragging == 1 or state.Dragging == 2 or not state.Rested or not ui.Rests(state.ShownRough, state.Rough) or not ui.Rests(state.ShownMetal, state.Metal) or not ui.Rests(state.ShownLight, state.Light) or not ui.Rests(state.Hover, state.Target)

defn onPress(state, point)
  s = state
  r = s.Rects
  if ui.Contains(point, SliderRect(r.Details, 0))
    s.Dragging = 1
    s.Metal = ui.SliderValue(point, SliderRect(r.Details, 0))
  else if ui.Contains(point, SliderRect(r.Details, 1))
    s.Dragging = 2
    s.Rough = ui.SliderValue(point, SliderRect(r.Details, 1))
  else if ui.Contains(point, r.Viewport)
    s.Dragging = 3
    s.LastX = point.X
  else if ui.Contains(point, graphArea(r.Graph))
    s.Picked = ui.NodeAt(point, s.Nodes)
    if s.Picked > 0
      s.Dragging = 4
      s.Grab = {X: point.X - s.Nodes[s.Picked].X, Y: point.Y - s.Nodes[s.Picked].Y}
    end
  end
  s
end

defn onMove(state, point)
  s = state
  s.Mouse = point
  if s.Dragging == 1
    s.Metal = ui.SliderValue(point, SliderRect(s.Rects.Details, 0))
  else if s.Dragging == 2
    s.Rough = ui.SliderValue(point, SliderRect(s.Rects.Details, 1))
  else if s.Dragging == 3
    s.Light = s.Light + (point.X - s.LastX) * 0.014
    s.LastX = point.X
  else if s.Dragging == 4
    s.Nodes = ui.MoveNode(s.Picked, point, s.Grab, graphArea(s.Rects.Graph), s.Nodes)
  end
  area = paletteArea(s.Rects.Palette)
  if ui.Contains(point, area)
    s.Target = ui.ListRow(ui.RowAt(point.Y, palette, area), palette, area) * 1.0
  end
  s
end

defn relight(state)
  (** While a value moves, the small sphere keeps the frame rate. Once it rests, the sharp one comes back. *)
  s = state
  changed = Abs(s.ShownRough - s.Lit.Rough) + Abs(s.ShownMetal - s.Lit.Metal) + Abs(s.ShownLight - s.Lit.Light)
  if changed > 0.004
    ShadeSphere(s.Images.Quick.Pixels, quickSize, s.ShownRough, s.ShownMetal, s.ShownLight)
    sdl.ShowImage(s.Images.Quick, s.Window)
    s.Lit = {Rough: s.ShownRough, Metal: s.ShownMetal, Light: s.ShownLight}
    s.Sharp = false
    s.Rested = false
  else if not s.Rested and s.Dragging == 0
    ShadeSphere(s.Images.Sharp.Pixels, sharpSize, s.ShownRough, s.ShownMetal, s.ShownLight)
    sdl.ShowImage(s.Images.Sharp, s.Window)
    s.Sharp = true
    s.Rested = true
  end
  s
end

defn onTick(state, seconds)
  s = state
  s.ShownRough = ui.Ease(s.ShownRough, s.Rough, seconds)
  s.ShownMetal = ui.Ease(s.ShownMetal, s.Metal, seconds)
  s.ShownLight = ui.Ease(s.ShownLight, s.Light, seconds)
  s.Hover = ui.Ease(s.Hover, s.Target, seconds)
  if seconds > 0.0
    s.Fps = if s.Fps == 0.0 1.0 / seconds else s.Fps + (1.0 / seconds - s.Fps) * 0.04 end
  end
  relight(s)
end

defn onMouse(state, event)
  s = state
  point = {X: event.X, Y: event.Y}
  if event.Action == "down"
    s = onPress(s, point)
  else if event.Action == "up"
    s.Dragging = 0
  else if event.Action == "move"
    s = onMove(s, point)
  end
  s
end

defn onResize(state, event)
  s = state
  s.Width = event.Width
  s.Height = event.Height
  s.Rects = layout(event.Width, event.Height)
  s
end

defn onKey(state, event)
  s = state
  if event.Key == "t"
    s.Dark = not s.Dark
  end
  s
end

defn Update(event, state)
  match event.Kind
    "quit" -> missing
    "key" -> onKey(state, event)
    "mouse" -> onMouse(state, event)
    "tick" -> onTick(state, event.Seconds)
    "resize" -> onResize(state, event)
    else -> state
  end
end
