-- A material editor: drag a node, turn the light on the sphere, move Metallic or Roughness, press t for the other theme.
-- Run from the root of the repository: kepler run --allow ffi=SDL3,ffi=SDL3_ttf examples/material.kp
use sdl
use "./material_scene" as scene

defn opened()
  first = sdl.open("Kepler", 1280, 720, "fonts/AdwaitaSans-Regular.ttf", size = 13, light = true)?
  second = sdl.add_font("strong", "fonts/NotoSans-Medium.ttf", 13, first, light = true)?
  third = sdl.add_font("code", "fonts/JetBrainsMono-Regular.ttf", 13, second)?
  sdl.add_font("large", "fonts/AdwaitaSans-Regular.ttf", 42, third, light = true)
end

defn main()
  begun = scene.start(opened()?)?
  sdl.run(begun.state, scene.update, scene.view, begun.window, moving = scene.moving)
  sdl.close(begun.window)
  Ok(missing)
end

print(main())
