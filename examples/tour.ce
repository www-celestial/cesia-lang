(** The language in one file: cesia run examples/tour.ce *)
use std/fiber
use std/io
use std/list
use std/math
use std/result

double(x) = x * 2   (** Functions: the short form, and the long one, which gives its last value. *)

defn greet(name)
  "Hello, $name"
end

io.Print(greet("world"))

(* Arrays start at 1. *)
numbers = [1, 2, 3, 4]
io.Print(numbers[1])

io.Print(list.Map(double, numbers))   (** Functions come first, the collection last. *)
io.Print(list.Filter(x -> x > 2, numbers))
io.Print(list.Reduce((total, x) -> total + x, 0, numbers))

io.Print(numbers then list.Filter(it > 1) then list.Map(it * 10))   (** A pipeline, where it is the current element. *)

(* Structs. *)
point = {X: 1, Y: 2}
io.Print(point.X + point.Y)

(* Loops and conditions. *)
for n in 1..3
  if n == 2
    io.Print("two")
  else
    io.Print(n)
  end
end

defn half(n)
  (** Errors are values: Ok or Err, and ? passes an Err on to the caller. *)
  if math.Mod(n, 2) == 0
    result.Ok(n / 2)
  else
    result.Err({Kind: "odd", Message: "$n is odd"})
  end
end

defn quarter(n)
  once = half(n)?
  half(once)
end

io.Print(quarter(8))
io.Print(quarter(6))

describe(r) = match r   (** match takes structures apart. *)
  result.Ok(value) -> "got $value"
  result.Err(e) -> "failed: $(e.Message)"
end

io.Print(describe(quarter(6)))

(* Fibers run side by side. *)
task = fiber.Spawn(() -> double(21))
io.Print(fiber.Wait(task))
