(** The language in one file: cesia run examples/tour.ce *)

double(x) = x * 2   (** Functions: the short form, and the long one, which gives its last value. *)

defn greet(name)
  "Hello, $name"
end

Print(greet("world"))

(* Arrays start at 1. *)
numbers = [1, 2, 3, 4]
Print(numbers[1])

Print(Map(double, numbers))   (** Functions come first, the collection last. *)
Print(Filter(x -> x > 2, numbers))
Print(Reduce((total, x) -> total + x, 0, numbers))

Print(numbers then Filter(it > 1) then Map(it * 10))   (** A pipeline, where it is the current element. *)

(* Structs. *)
point = {X: 1, Y: 2}
Print(point.X + point.Y)

(* Loops and conditions. *)
for n in 1:3
  if n == 2
    Print("two")
  else
    Print(n)
  end
end

defn half(n)
  (** Errors are values: Ok or Err, and ? passes an Err on to the caller. *)
  if Mod(n, 2) == 0
    Ok(n / 2)
  else
    Err({Kind: "odd", Message: "$n is odd"})
  end
end

defn quarter(n)
  once = half(n)?
  half(once)
end

Print(quarter(8))
Print(quarter(6))

describe(result) = match result   (** match takes structures apart. *)
  Ok(value) -> "got $value"
  Err(e) -> "failed: $(e.Message)"
end

Print(describe(quarter(6)))

(* Fibers run side by side. *)
task = Spawn(() -> double(21))
Print(Wait(task))
