(** A small web app: GET shows the notes, POST adds one.
      cesia run --allow read=notes.txt,write=notes.txt,net=:8080 examples/notes.ce
      curl -d "buy milk" localhost:8080
      curl localhost:8080 *)
use std/http
use std/sys
use std/io
use std/result
use std/text

file = "notes.txt"

defn listed()
  (** The notes, or an Err that the server answers with a 500. *)
  result.Ok(http.Plain(if sys.Exists(file) sys.Read(file)? else "" end))
end

defn added(request)
  (** The notes, after the body of the request is added to them. *)
  sys.Append(file, "$(request.Body)$(text.Char(10))")?
  listed()
end

app = http.App() then http.Get("/", r -> listed()) then http.Post("/", added)
io.Print(http.Serve(app, port = 8080))
