(** A small web app: GET shows the notes, POST adds one.
      cesia run --allow read=notes.txt,write=notes.txt,net=:8080 examples/notes.ce
      curl -d "buy milk" localhost:8080
      curl localhost:8080 *)
use std/http
use std/sys
use std/io
use std/result
use std/text

file = "notes.txt"

defn handle(request)
  if request.Method == "POST"
    sys.Append(file, "$(request.Body)$(text.Char(10))")?
  end
  notes = if sys.Exists(file) sys.Read(file)? else "" end
  result.Ok({Status: 200, Body: notes})
end

reply(request) = match handle(request)
  result.Ok(response) -> response
  result.Err(e) -> {Status: 500, Body: e.Message}
end

io.Print(http.Serve(http.App() then http.AnyMethod("*", reply), port = 8080))
