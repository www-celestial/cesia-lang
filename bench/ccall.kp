-- The cost of a call to a trivial C function.
use c
use sys

function repeat_call(f, n)
  for i in 1:n
    f(-5)
  end
end

lib = unwrap(c.open("c", version = 6))
abs_value = unwrap(c.fn("abs", ["i32"], "i32", lib))
n = 10000000
start = sys.now()
repeat_call(abs_value, n)
print("calls per second: $(floor(n / (sys.now() - start)))")
