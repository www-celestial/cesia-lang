use std/io
use std/matrix

defn mm(n)
  a = matrix.Zeros(n * n)
  b = matrix.Zeros(n * n)
  c = matrix.Zeros(n * n)
  for i in 0..n - 1
    for j in 0..n - 1
      a[i * n + j + 1] = (i + j) * 0.5
      b[i * n + j + 1] = (i - j) * 0.25
    end
  end
  for i in 0..n - 1
    for j in 0..n - 1
      s = 0.0
      for k in 0..n - 1
        s = s + a[i * n + k + 1] * b[k * n + j + 1]
      end
      c[i * n + j + 1] = s
    end
  end
  c[n + 2]
end
io.Print(mm(300))
