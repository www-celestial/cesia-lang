(** The cost of a call to a trivial C function. *)
use std/c
use std/sys
use std/io
use std/math
use std/result

defn repeatCall(f, n)
  for i in 1..n
    f(-5)
  end
end

lib = result.Unwrap(c.Open("c", version = 6))
absValue = result.Unwrap(c.Fn("abs", ["i32"], "i32", lib))
n = 10000000
start = sys.Now()
repeatCall(absValue, n)
io.Print("calls per second: $(math.Floor(n / (sys.Now() - start)))")
