function mm(n)
  a = zeros(n * n)
  b = zeros(n * n)
  c = zeros(n * n)
  for i in 0:n - 1
    for j in 0:n - 1
      a[i * n + j + 1] = (i + j) * 0.5
      b[i * n + j + 1] = (i - j) * 0.25
    end
  end
  for i in 0:n - 1
    for j in 0:n - 1
      s = 0.0
      for k in 0:n - 1
        s = s + a[i * n + k + 1] * b[k * n + j + 1]
      end
      c[i * n + j + 1] = s
    end
  end
  c[n + 2]
end
print(mm(300))
