(** The worst case of a window: every line of a full screen changes at every frame. Run through tools/frame-bench.sh. *)
use std/sdl
use std/sys
use std/io
use std/list
use std/math
use std/result
use std/text

lines = 55
columns = 200
frames = 300
letters = text.Join("", list.Fill("abcdefghijklmnopqrstuvwxyz", 12))

defn line(row, n)
  (** A line taken from a long text, as an editor would, and different at each frame. *)
  from = 1 + math.Mod(row * 3 + n, 26)
  {Kind: "text", X: 8, Y: 8 + (row - 1) * 19, Text: text.Slice(from, from + columns - 1, letters), Color: 0xE0E0E0}
end

view(n) = [if k == 0 {Kind: "clear", Color: 0x1E1E1E} else line(k, n) end for k in 0..lines]

defn run(window, n)
  if n > frames window else run(sdl.Frame(view(n), window), n + 1) end
end

defn measure()
  window = sdl.Open("Cesia speed gate", 1920, 1080, "examples/fonts/JetBrainsMono-Regular.ttf", vsync = false)?
  start = sys.Now()
  last = run(window, 1)
  seconds = sys.Now() - start
  sdl.Close(last)
  result.Ok(frames / seconds)
end

match measure()
  result.Ok(rate) -> io.Print("frames per second: $(math.Floor(rate))")
  result.Err(e) -> io.Print(e.Message)
end
