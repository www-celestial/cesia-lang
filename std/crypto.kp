-- Cryptography through libsodium: never written by hand here. Run with --allow ffi=sodium.
-- Texts hold bytes: encode.hex and encode.base64 give them a printable form.
use c

secret_key_size = 32
nonce_size = 24
mac_size = 16
public_key_size = 32
sign_public_size = 32
sign_secret_size = 64
signature_size = 64
password_size = 128

defn _block(s)
  b = c.alloc(max(byte_length(s), 1))
  c.store(s, 0, b)
  b
end

_ints() = ["ptr", "ptr", "u64"]

-- Loads libsodium: an Ok of the api that the other functions take as their last argument s, or an Err.
defn open()
  lib = c.open("sodium", version = 26)?
  init = c.fn("sodium_init", [], "i32", lib)?
  if init() < 0
    return Err({kind: "crypto", message: "libsodium couldn't start."})
  end
  Ok({
    random: c.fn("randombytes_buf", ["ptr", "u64"], "void", lib)?,
    sha256: c.fn("crypto_hash_sha256", _ints(), "i32", lib)?,
    sha512: c.fn("crypto_hash_sha512", _ints(), "i32", lib)?,
    blake2b: c.fn("crypto_generichash", ["ptr", "u64", "ptr", "u64", "ptr", "u64"], "i32", lib)?,
    hmac_size: c.fn("crypto_auth_hmacsha256_statebytes", [], "u64", lib)?,
    hmac_init: c.fn("crypto_auth_hmacsha256_init", ["ptr", "ptr", "u64"], "i32", lib)?,
    hmac_update: c.fn("crypto_auth_hmacsha256_update", _ints(), "i32", lib)?,
    hmac_final: c.fn("crypto_auth_hmacsha256_final", ["ptr", "ptr"], "i32", lib)?,
    secret_seal: c.fn("crypto_secretbox_easy", ["ptr", "ptr", "u64", "ptr", "ptr"], "i32", lib)?,
    secret_open: c.fn("crypto_secretbox_open_easy", ["ptr", "ptr", "u64", "ptr", "ptr"], "i32", lib)?,
    box_pair: c.fn("crypto_box_keypair", ["ptr", "ptr"], "i32", lib)?,
    box_seal: c.fn("crypto_box_easy", ["ptr", "ptr", "u64", "ptr", "ptr", "ptr"], "i32", lib)?,
    box_open: c.fn("crypto_box_open_easy", ["ptr", "ptr", "u64", "ptr", "ptr", "ptr"], "i32", lib)?,
    sign_pair: c.fn("crypto_sign_keypair", ["ptr", "ptr"], "i32", lib)?,
    sign: c.fn("crypto_sign_detached", ["ptr", "ptr", "ptr", "u64", "ptr"], "i32", lib)?,
    verify: c.fn("crypto_sign_verify_detached", ["ptr", "ptr", "u64", "ptr"], "i32", lib)?,
    hash_password: c.fn("crypto_pwhash_str", ["ptr", "ptr", "u64", "u64", "u64"], "i32", lib)?,
    check_password: c.fn("crypto_pwhash_str_verify", ["ptr", "ptr", "u64"], "i32", lib)?,
    password_ops: c.fn("crypto_pwhash_opslimit_interactive", [], "u64", lib)?,
    password_memory: c.fn("crypto_pwhash_memlimit_interactive", [], "u64", lib)?,
    compare: c.fn("sodium_memcmp", ["ptr", "ptr", "u64"], "i32", lib)?
  })
end

_sized(value, size, name) = assert(byte_length(value) == size, "$name has $size bytes.")

-- Runs f on a fresh output block and the blocks of the inputs, then gives the output bytes.
defn _out(size, inputs, f)
  out = c.alloc(max(size, 1))
  blocks = map(_block, inputs)
  status = f(out, blocks)
  result = c.load(0, size, out)
  c.free(out)
  map(c.free, blocks)
  {status: status, bytes: result}
end

-- n random bytes from the system, as a text.
defn random(n, s)
  _out(n, [], (out, blocks) -> s.random(out, n)).bytes
end

-- A status other than 0 is a bug here: the zeros of a failed call must never pass for a result.
defn _done(r)
  assert(r.status == 0, "libsodium refused this call.")
  r.bytes
end

-- The SHA-256 hash of a text, as 32 bytes.
sha256(text_value, s) = _done(_out(32, [text_value], (out, b) -> s.sha256(out, b[1], byte_length(text_value))))
-- The SHA-512 hash of a text, as 64 bytes.
sha512(text_value, s) = _done(_out(64, [text_value], (out, b) -> s.sha512(out, b[1], byte_length(text_value))))

-- The BLAKE2b hash of a text, as a number of bytes from 16 to 64 (32 by default).
defn blake2b(text_value, s, size = 32)
  assert(size >= 16 and size <= 64, "blake2b needs a size from 16 to 64.")
  _done(_out(size, [text_value], (out, b) -> s.blake2b(out, size, b[1], byte_length(text_value), missing, 0)))
end

-- The HMAC-SHA-256 of a text under a key, as 32 bytes.
defn hmac_sha256(key, text_value, s)
  state = c.alloc(s.hmac_size())
  r = _out(32, [key, text_value], (out, b) -> _hmac(s, state, out, b, byte_length(key), byte_length(text_value)))
  c.free(state)
  _done(r)
end

defn _hmac(s, state, out, b, key_size, size)
  bit_or(bit_or(s.hmac_init(state, b[1], key_size), s.hmac_update(state, b[2], size)), s.hmac_final(state, out))
end

-- The same inputs can't tell where they differ by the time they take.
defn same(a, b, s)
  if byte_length(a) != byte_length(b)
    return false
  end
  _out(0, [a, b], (out, blocks) -> s.compare(blocks[1], blocks[2], byte_length(a))).status == 0
end

_refused() = Err({kind: "crypto", message: "This message was changed, or the key is wrong."})

-- Symmetric encryption. A nonce is never used twice with a key: the default takes a random one, kept in front.
secret_key(s) = random(secret_key_size, s)

-- f(out, blocks, size) gets the message or the body, then the nonce, then the keys, in blocks.
defn _sealed(message, keys, s, f)
  nonce = random(nonce_size, s)
  size = byte_length(message)
  r = _out(size + mac_size, concat([message, nonce], keys), (out, b) -> f(out, b, size))
  "$nonce$(_done(r))"
end

defn _opened(sealed, keys, f)
  total = byte_length(sealed)
  if total < nonce_size + mac_size
    return _refused()
  end
  nonce = byte_slice(1, nonce_size, sealed)
  body = byte_slice(nonce_size + 1, total, sealed)
  size = byte_length(body)
  r = _out(size - mac_size, concat([body, nonce], keys), (out, b) -> f(out, b, size))
  if r.status == 0 Ok(r.bytes) else _refused() end
end

-- A message encrypted and authenticated under a 32-byte key. The random nonce is kept in front of the result.
defn seal(message, key, s)
  _sized(key, secret_key_size, "A key")
  _sealed(message, [key], s, (out, b, size) -> s.secret_seal(out, b[1], size, b[2], b[3]))
end

-- The message of a result of seal, in an Ok, or an Err if it was changed or the key is wrong.
defn unseal(sealed, key, s)
  _sized(key, secret_key_size, "A key")
  _opened(sealed, [key], (out, b, size) -> s.secret_open(out, b[1], size, b[2], b[3]))
end

-- Public keys: a pair gives {public, secret}.
defn _pair(public_size, secret_size, f)
  public = c.alloc(public_size)
  secret = c.alloc(secret_size)
  f(public, secret)
  out = {public: c.load(0, public_size, public), secret: c.load(0, secret_size, secret)}
  c.free(public)
  c.free(secret)
  out
end

-- A new key pair for box_seal, as a struct with public and secret.
box_pair(s) = _pair(public_key_size, secret_key_size, s.box_pair)

-- A message encrypted for the owner of a public key, and authenticated by the sender's secret key. The nonce is kept in front.
defn box_seal(message, to_public, from_secret, s)
  _sized(to_public, public_key_size, "A public key")
  _sized(from_secret, secret_key_size, "A secret key")
  _sealed(message, [to_public, from_secret], s, (out, b, size) -> s.box_seal(out, b[1], size, b[2], b[3], b[4]))
end

-- The message of a result of box_seal, in an Ok, or an Err if it was changed or the keys are wrong.
defn box_open(sealed, from_public, to_secret, s)
  _sized(from_public, public_key_size, "A public key")
  _sized(to_secret, secret_key_size, "A secret key")
  _opened(sealed, [from_public, to_secret], (out, b, size) -> s.box_open(out, b[1], size, b[2], b[3], b[4]))
end

-- A new key pair for sign, as a struct with public and secret.
sign_pair(s) = _pair(sign_public_size, sign_secret_size, s.sign_pair)

-- The 64-byte signature of a message under a secret signing key.
defn sign(message, secret, s)
  _sized(secret, sign_secret_size, "A secret key")
  size = byte_length(message)
  _done(_out(signature_size, [message, secret], (out, b) -> s.sign(out, missing, b[1], size, b[2])))
end

-- Is this signature the one of the message under the public signing key?
defn verify(signature, message, public, s)
  if byte_length(signature) != signature_size or byte_length(public) != sign_public_size
    return false
  end
  size = byte_length(message)
  _out(0, [signature, message, public], (out, b) -> s.verify(b[1], b[2], size, b[3])).status == 0
end

-- Passwords: the result holds its own salt and settings, and is safe to store.
defn hash_password(password, s)
  size = byte_length(password)
  r = _done(_out(password_size, [password], (out, b) -> s.hash_password(out, b[1], size, s.password_ops(), s.password_memory())))
  byte_slice(1, byte_find(char(0), 1, r) - 1, r)
end

-- Does the password match a result of hash_password?
defn check_password(password, stored, s)
  if byte_length(stored) >= password_size
    return false
  end
  size = byte_length(password)
  padded = "$stored$(repeat(password_size - byte_length(stored), char(0)))"
  _out(0, [padded, password], (out, b) -> s.check_password(b[1], b[2], size)).status == 0
end
