-- A persistent leftist heap: the smallest key comes out first.

-- A heap with nothing in it.
empty() = missing
-- Is this heap empty?
--
--   is_empty(empty()) --> true
is_empty(h) = is_missing(h)
_rank(h) = if is_missing(h) 0 else h.rank end

defn _node(key, value, a, b)
  if _rank(a) >= _rank(b)
    {key: key, value: value, left: a, right: b, rank: _rank(b) + 1}
  else
    {key: key, value: value, left: b, right: a, rank: _rank(a) + 1}
  end
end

-- One heap from two.
defn merge(a, b)
  if is_missing(a)
    b
  else if is_missing(b)
    a
  else if a.key <= b.key
    _node(a.key, a.value, a.left, merge(a.right, b))
  else
    _node(b.key, b.value, b.left, merge(a, b.right))
  end
end

-- A heap with a value added under a key; the smallest key comes out first.
--
--   peek(insert(1, "a", empty())).value --> "a"
insert(key, value, h) = merge(_node(key, value, missing, missing), h)
-- The smallest key and its value, as a struct with key and value. The heap must not be empty.
--
--   peek(insert(2, "b", insert(1, "a", empty()))).key --> 1
peek(h) = {key: h.key, value: h.value}
-- The heap without its smallest key. The heap must not be empty.
--
--   peek(pop(insert(2, "b", insert(1, "a", empty())))).key --> 2
pop(h) = merge(h.left, h.right)

-- All the entries as structs with key and value, smallest key first.
--
--   length(items(insert(1, "a", empty()))) --> 1
defn items(h)
  out = dict()
  while not is_missing(h)
    out[length(out) + 1] = peek(h)
    h = pop(h)
  end
  values(out)
end
