-- TLS through OpenSSL, with memory buffers: the sockets stay with net, so a fiber never blocks the others during a
-- handshake. Run with --allow ffi=ssl,ffi=crypto.
use c
use net

_chunk = 65536

-- Loads OpenSSL: an Ok of the api that server and client take, or an Err.
defn open()
  ssl = c.open("ssl", version = 3)?
  lib = c.open("crypto", version = 3)?
  Ok({
    server_method: c.fn("TLS_server_method", [], "ptr", ssl)?,
    client_method: c.fn("TLS_client_method", [], "ptr", ssl)?,
    ctx_new: c.fn("SSL_CTX_new", ["ptr"], "ptr", ssl)?,
    use_chain: c.fn("SSL_CTX_use_certificate_chain_file", ["ptr", "text"], "i32", ssl)?,
    use_key: c.fn("SSL_CTX_use_PrivateKey_file", ["ptr", "text", "i32"], "i32", ssl)?,
    default_paths: c.fn("SSL_CTX_set_default_verify_paths", ["ptr"], "i32", ssl)?,
    set_verify: c.fn("SSL_CTX_set_verify", ["ptr", "i32", "ptr"], "void", ssl)?,
    ssl_new: c.fn("SSL_new", ["ptr"], "ptr", ssl)?,
    ssl_free: c.fn("SSL_free", ["ptr"], "void", ssl)?,
    set_bio: c.fn("SSL_set_bio", ["ptr", "ptr", "ptr"], "void", ssl)?,
    accept_state: c.fn("SSL_set_accept_state", ["ptr"], "void", ssl)?,
    connect_state: c.fn("SSL_set_connect_state", ["ptr"], "void", ssl)?,
    handshake: c.fn("SSL_do_handshake", ["ptr"], "i32", ssl)?,
    ssl_read: c.fn("SSL_read", ["ptr", "ptr", "i32"], "i32", ssl)?,
    ssl_write: c.fn("SSL_write", ["ptr", "ptr", "i32"], "i32", ssl)?,
    get_error: c.fn("SSL_get_error", ["ptr", "i32"], "i32", ssl)?,
    shutdown: c.fn("SSL_shutdown", ["ptr"], "i32", ssl)?,
    control: c.fn("SSL_ctrl", ["ptr", "i32", "i64", "text"], "i64", ssl)?,
    set_host: c.fn("SSL_set1_host", ["ptr", "text"], "i32", ssl)?,
    clear_errors: c.fn("ERR_clear_error", [], "void", lib)?,
    bio_new: c.fn("BIO_new", ["ptr"], "ptr", lib)?,
    bio_mem: c.fn("BIO_s_mem", [], "ptr", lib)?,
    bio_read: c.fn("BIO_read", ["ptr", "ptr", "i32"], "i32", lib)?,
    bio_write: c.fn("BIO_write", ["ptr", "ptr", "i32"], "i32", lib)?
  })
end

_failed(message) = Err({kind: "tls", message: message})

-- The state of one connection: its handles are C objects, so a copy of this value is the same connection.
defn _link(api, ctx, socket)
  ssl = api.ssl_new(ctx)
  incoming = api.bio_new(api.bio_mem())
  outgoing = api.bio_new(api.bio_mem())
  api.set_bio(ssl, incoming, outgoing)
  {api: api, ssl: ssl, incoming: incoming, outgoing: outgoing, socket: socket, block: c.alloc(_chunk)}
end

-- Sends what OpenSSL wrote.
defn _flush(t)
  n = t.api.bio_read(t.outgoing, t.block, _chunk)
  while n > 0
    net.write(t.socket, c.load(0, n, t.block))?
    n = t.api.bio_read(t.outgoing, t.block, _chunk)
  end
  Ok(missing)
end

-- Gives OpenSSL what the other side sent. False at the end of the connection.
defn _feed(t)
  got = net.read(t.socket)?
  n = byte_length(got)
  if n == 0
    return Ok(false)
  end
  c.store(got, 0, t.block)
  t.api.bio_write(t.incoming, t.block, n)
  Ok(true)
end

defn _shake(t)
  while true
    t.api.clear_errors()
    r = t.api.handshake(t.ssl)
    _flush(t)?
    if r == 1
      return Ok(missing)
    end
    e = t.api.get_error(t.ssl, r)
    if e != 2
      return _failed("The TLS handshake failed.")
    end
    if not _feed(t)?
      return _failed("The connection closed during the TLS handshake.")
    end
  end
end

defn _read(t)
  while true
    t.api.clear_errors()
    n = t.api.ssl_read(t.ssl, t.block, _chunk)
    if n > 0
      return Ok(c.load(0, n, t.block))
    end
    e = t.api.get_error(t.ssl, n)
    if e == 6
      return Ok("")
    end
    if e != 2
      return _failed("A TLS read failed.")
    end
    _flush(t)?
    if not _feed(t)?
      return _failed("The connection ended without a TLS close.")
    end
  end
end

defn _write(t, s)
  size = byte_length(s)
  at = 0
  while at < size
    piece = byte_slice(at + 1, min(at + _chunk, size), s)
    c.store(piece, 0, t.block)
    t.api.clear_errors()
    n = t.api.ssl_write(t.ssl, t.block, byte_length(piece))
    if n <= 0
      return _failed("A TLS write failed.")
    end
    at += n
    _flush(t)?
  end
  Ok(missing)
end

defn _release(t)
  t.api.ssl_free(t.ssl)
  c.free(t.block)
end

defn _close(t)
  t.api.clear_errors()
  t.api.shutdown(t.ssl)
  _flush(t)
  _release(t)
  net.close(t.socket)
end

-- The handshake, and what it took back if it fails: a client that talks nonsense leaves nothing behind.
defn _shaken(t)
  r = _shake(t)
  if is_err(r)
    _release(t)
    r
  else
    Ok(_io(t))
  end
end

defn _io(t)
  {read: () -> _read(t), write: s -> _write(t, s), close: () -> _close(t), arm: s -> net.arm(t.socket, s)}
end

-- For http.serve and web.serve: wrap = tls.server(certificate, key, api)?
defn server(certificate, key, api)
  ctx = api.ctx_new(api.server_method())
  if api.use_chain(ctx, certificate) != 1
    return _failed("Can't read the certificate $certificate.")
  end
  if api.use_key(ctx, key, 1) != 1
    return _failed("Can't read the key $key.")
  end
  Ok(socket -> _accept(api, ctx, socket))
end

defn _accept(api, ctx, socket)
  t = _link(api, ctx, socket)
  api.accept_state(t.ssl)
  _shaken(t)
end

-- For http.request: secure = tls.client(api). With verify = false, any certificate passes: only for tests.
defn client(api, verify = true)
  ctx = api.ctx_new(api.client_method())
  if verify
    api.default_paths(ctx)
    api.set_verify(ctx, 1, missing)
  end
  (socket, host) -> _connect(api, ctx, socket, host, verify)
end

defn _connect(api, ctx, socket, host, verify)
  t = _link(api, ctx, socket)
  api.control(t.ssl, 55, 0, host)
  if verify
    api.set_host(t.ssl, host)
  end
  api.connect_state(t.ssl)
  _shaken(t)
end
