-- CSV, as RFC 4180 writes it: quotes around a field, doubled inside.

_is_special(c, separator) = c == "\"" or c == separator or c == "\n" or c == "\r"

-- Rows gather in a dictionary and unquoted runs are cut in one piece: a push or a copy per step would be quadratic.
defn parse(s, separator = ",")
  rows = dict()
  row = []
  field = ""
  quoted = false
  i = 1
  n = byte_length(s)
  while i <= n
    c = byte_slice(i, i, s)
    if quoted
      if c == "\""
        if i < n and byte_slice(i + 1, i + 1, s) == "\""
          field = "$field\""
          i += 2
        else
          quoted = false
          i += 1
        end
      else
        at = byte_find("\"", i, s)
        stop = if is_missing(at) n else at - 1 end
        field = "$field$(byte_slice(i, stop, s))"
        i = stop + 1
      end
    else if c == "\""
      quoted = true
      i += 1
    else if c == separator
      row = push(field, row)
      field = ""
      i += 1
    else if c == "\n" or c == "\r"
      if c == "\r" and i < n and byte_slice(i + 1, i + 1, s) == "\n"
        i += 1
      end
      rows[length(rows) + 1] = push(field, row)
      row = []
      field = ""
      i += 1
    else
      start = i
      while i <= n and not _is_special(byte_slice(i, i, s), separator)
        i += 1
      end
      field = "$field$(byte_slice(start, i - 1, s))"
    end
  end
  if field != "" or length(row) > 0
    rows[length(rows) + 1] = push(field, row)
  end
  values(rows)
end

-- Each row after the first as a dictionary, by the names of the first.
defn records(s, separator = ",")
  rows = parse(s, separator = separator)
  if length(rows) == 0
    return []
  end
  names = rows[1]
  [dict([{key: names[k], value: row[k]} for k in 1:min(length(names), length(row))]) for row in skip(1, rows)]
end

defn _field(x, separator)
  s = text(x)
  if contains(separator, s) or contains("\"", s) or contains("\n", s) or contains("\r", s)
    "\"$(replace("\"", "\"\"", s))\""
  else
    s
  end
end

defn write(rows, separator = ",")
  lines = [join(separator, [_field(x, separator) for x in row]) for row in rows]
  "$(join("\n", lines))\n"
end
