-- A persistent text: a balanced tree of chunks, so that an edit in a large file stays logarithmic and a copy is free.
-- Positions count bytes from 0, and lines count from 1.

_chunk = 1024

_newlines(s) = length(split("\n", s)) - 1
_leaf(s) = {left: missing, right: missing, text: s, size: byte_length(s), lines: _newlines(s), height: 0}
_is_leaf(r) = is_missing(r.left)

defn _node(a, b)
  {left: a, right: b, text: "", size: a.size + b.size, lines: a.lines + b.lines, height: 1 + max(a.height, b.height)}
end

defn _balance(a, b)
  if a.height > b.height + 1
    if a.left.height >= a.right.height
      _node(a.left, _node(a.right, b))
    else
      _node(_node(a.left, a.right.left), _node(a.right.right, b))
    end
  else if b.height > a.height + 1
    if b.right.height >= b.left.height
      _node(_node(a, b.left), b.right)
    else
      _node(_node(a, b.left.left), _node(b.left.right, b.right))
    end
  else
    _node(a, b)
  end
end

defn join_ropes(a, b)
  if a.size == 0
    b
  else if b.size == 0
    a
  else if _is_leaf(a) and _is_leaf(b) and a.size + b.size <= _chunk
    _leaf("$(a.text)$(b.text)")
  else if a.height > b.height + 1
    _balance(a.left, join_ropes(a.right, b))
  else if b.height > a.height + 1
    _balance(join_ropes(a, b.left), b.right)
  else
    _node(a, b)
  end
end

defn of(s)
  n = byte_length(s)
  if n <= _chunk
    return _leaf(s)
  end
  half = div(n, 2)
  join_ropes(of(byte_slice(1, half, s)), of(byte_slice(half + 1, n, s)))
end

-- The bytes before a position, and the others.
defn split_at(at, r)
  if at <= 0
    [_leaf(""), r]
  else if at >= r.size
    [r, _leaf("")]
  else if _is_leaf(r)
    [_leaf(byte_slice(1, at, r.text)), _leaf(byte_slice(at + 1, r.size, r.text))]
  else if at < r.left.size
    parts = split_at(at, r.left)
    [parts[1], join_ropes(parts[2], r.right)]
  else
    parts = split_at(at - r.left.size, r.right)
    [join_ropes(r.left, parts[1]), parts[2]]
  end
end

size(r) = r.size
line_count(r) = r.lines + 1

defn insert(at, s, r)
  parts = split_at(at, r)
  join_ropes(join_ropes(parts[1], of(s)), parts[2])
end

defn delete(from, to, r)
  parts = split_at(from, r)
  join_ropes(parts[1], split_at(to - from, parts[2])[2])
end

_pieces(r) = if _is_leaf(r) [r.text] else concat(_pieces(r.left), _pieces(r.right)) end

text(r) = join("", _pieces(r))
slice(from, to, r) = text(split_at(to - from, split_at(from, r)[2])[1])

-- The position of the first byte after the nth newline.
defn _after_newline(n, r)
  if n <= 0
    0
  else if _is_leaf(r)
    at = 0
    for k in 1:n
      at = byte_find("\n", at + 1, r.text)
    end
    at
  else if n <= r.left.lines
    _after_newline(n, r.left)
  else
    r.left.size + _after_newline(n - r.left.lines, r.right)
  end
end

line_start(n, r) = _after_newline(n - 1, r)

defn line_end(n, r)
  if n >= line_count(r) r.size else line_start(n + 1, r) - 1 end
end

line(n, r) = slice(line_start(n, r), line_end(n, r), r)

-- The line of a position.
defn line_of(at, r)
  if at <= 0
    1
  else if at >= r.size
    r.lines + 1
  else if _is_leaf(r)
    _newlines(byte_slice(1, at, r.text)) + 1
  else if at <= r.left.size
    line_of(at, r.left)
  else
    r.left.lines + line_of(at - r.left.size, r.right)
  end
end
