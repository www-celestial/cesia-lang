-- The prelude written in Kepler. Sequence functions: the collection comes last.

-- Applies f to each element, keeping the shape.
--
--   map(it * 2, [1, 2]) --> [2, 4]
defn map(f, xs)
  r = [f(x) for x in xs]
  if size(xs, 1) == 1 r else reshape(r, size(xs, 1), size(xs, 2)) end
end

-- The elements for which f is true.
--
--   filter(it > 1, [1, 2, 3]) --> [2, 3]
filter(f, xs) = [x for x in xs if f(x)]

-- Folds xs with f, starting from init.
--
--   reduce((a, x) -> a + x, 0, [1, 2, 3]) --> 6
defn reduce(f, init, xs)
  acc = init
  for x in xs
    acc = f(acc, x)
  end
  acc
end

-- The successive results of reduce: one per element, init excluded.
--
--   scan((a, x) -> a + x, 0, [1, 2, 3]) --> [1, 3, 6]
defn scan(f, init, xs)
  out = fill(missing, length(xs))
  acc = init
  i = 0
  for x in xs
    acc = f(acc, x)
    i += 1
    out[i] = acc
  end
  out
end

-- From a to b, by step. Integers if all three are integers, else a + k * step.
--
--   range(1, 10, step = 3) --> [1, 4, 7, 10]
--   range(0, 1, step = 0.25) --> [0.0, 0.25, 0.5, 0.75, 1.0]
defn range(a, b, step = 1)
  if step == 0
    panic("range: step can't be 0.")
  end
  if floor(a) == a and floor(b) == b and floor(step) == step
    n = div(b - a, step) + 1
    [a + k * step for k in 0:n - 1]
  else
    span = (b - a) / step
    n = if span < -1e-9 0 else floor(span + 1e-9) + 1 end
    [a + k * step for k in 0:n - 1]
  end
end

defn _row(k, members, summary)
  if is_missing(summary)
    {key: k, values: members}
  else
    s = summary(members)
    if is_struct(s) _merge({key: k}, s) else {key: k, value: s} end
  end
end

-- The elements grouped by key, in order of first appearance of the keys.
--
--   group(mod(it, 2), [1, 2, 3]) --> [{key: 1, values: [1, 3]}, {key: 0, values: [2]}]
defn group(key, xs, summary = missing)
  n = length(xs)
  keys = fill(missing, n)
  ids = fill(0, n)
  count = 0
  i = 0
  for x in xs
    i += 1
    k = key(x)
    g = 0
    for j in 1:count
      if equal(keys[j], k)
        g = j
        break
      end
    end
    if g == 0
      count += 1
      keys[count] = k
      g = count
    end
    ids[i] = g
  end
  out = fill(missing, count)
  for g in 1:count
    members = [xs[p] for p in 1:n if ids[p] == g]
    out[g] = _row(keys[g], members, summary)
  end
  out
end

-- The positions of keys, from the largest key to the smallest. Stable merge sort.
defn _order(keys)
  n = length(keys)
  idx = [k for k in 1:n]
  tmp = fill(0, n)
  width = 1
  while width < n
    lo = 1
    while lo <= n
      mid = min(lo + width, n + 1)
      hi = min(lo + 2 * width, n + 1)
      i = lo
      j = mid
      k = lo
      while k < hi
        if i < mid and (j >= hi or not (keys[idx[j]] > keys[idx[i]]))
          tmp[k] = idx[i]
          i += 1
        else
          tmp[k] = idx[j]
          j += 1
        end
        k += 1
      end
      lo = hi
    end
    t = idx
    idx = tmp
    tmp = t
    width = 2 * width
  end
  idx
end

-- The n largest elements, largest first, or those with the largest by.
--
--   top(2, [5, 1, 9, 3]) --> [9, 5]
defn top(n, xs, by = missing)
  keys = if is_missing(by) xs else [by(x) for x in xs] end
  idx = _order(keys)
  m = min(n, length(xs))
  [xs[idx[k]] for k in 1:m]
end

sort_by(f, xs) = [xs[i] for i in order(map(f, xs))]
count(f, xs) = length(filter(f, xs))
flat_map(f, xs) = flatten(map(f, xs))

defn map_values(f, d)
  out = dict()
  for k in keys(d)
    out[k] = f(d[k])
  end
  out
end

-- A successful result.
--
--   Ok(1).value --> 1
struct Ok { value }

-- A failed result: the error is a value, returned rather than raised.
--
--   Err("no").error --> "no"
struct Err { error }

-- The next step of a result: f(v) for an Ok, the Err unchanged otherwise.
--
--   Ok(2) then and_then(x -> Ok(x + 1)) --> Ok(3)
--   Err("no") then and_then(x -> Ok(x + 1)) --> Err("no")
and_then(f, r) = match r
  Ok(v) -> f(v)
  else -> r
end

-- Applies f to the value of an Ok.
--
--   Ok(2) then map_ok(it + 1) --> Ok(3)
map_ok(f, r) = match r
  Ok(v) -> Ok(f(v))
  else -> r
end

-- Applies f to the error of an Err.
--
--   Err(2) then map_err(it + 1) --> Err(3)
map_err(f, r) = match r
  Err(e) -> Err(f(e))
  else -> r
end

-- The value of an Ok, or the default.
--
--   Err("no") then unwrap_or(0) --> 0
unwrap_or(default, r) = match r
  Ok(v) -> v
  else -> default
end

_error_text(e) = match e
  {message} -> message
  else -> text(e)
end

-- The value of an Ok. An Err is a bug here, and stops the fiber.
--
--   unwrap(Ok(1)) --> 1
--   unwrap(Err("no")) --> error
unwrap(r) = match r
  Ok(v) -> v
  Err(e) -> panic("unwrap on an error: $(_error_text(e))")
end

-- Is this result an Ok?
--
--   is_ok(Ok(1)) --> true
is_ok(r) = match r
  Ok(v) -> true
  else -> false
end

-- Is this result an Err?
--
--   is_err(Err(1)) --> true
is_err(r) = match r
  Err(e) -> true
  else -> false
end

-- An array of results as one result: Ok of all the values, or the first Err.
--
--   collect([Ok(1), Ok(2)]) --> Ok([1, 2])
--   collect([Ok(1), Err("a")]) --> Err("a")
defn collect(rs)
  errors = filter(is_err, rs)
  if length(errors) > 0 errors[1] else Ok(map(it.value, rs)) end
end

-- Like map, with one fiber per element: useful when f waits. A panic in f comes back as a panic here.
--
--   pmap(it * 2, [1, 2]) --> [2, 4]
pmap(f, xs) = map(unwrap, map(wait, map(x -> spawn(() -> f(x)), xs)))
