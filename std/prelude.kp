-- The prelude written in Kepler. Sequence functions: the collection comes last.

-- Applies f to each element, keeping the shape.
--
--   map(it * 2, [1, 2]) --> [2, 4]
defn map(f, xs)
  r = [f(x) for x in xs]
  if size(xs, 1) == 1 r else reshape(r, size(xs, 1), size(xs, 2)) end
end

-- The elements for which f is true.
--
--   filter(it > 1, [1, 2, 3]) --> [2, 3]
filter(f, xs) = [x for x in xs if f(x)]

-- Folds xs with f, starting from init.
--
--   reduce((a, x) -> a + x, 0, [1, 2, 3]) --> 6
defn reduce(f, init, xs)
  acc = init
  for x in xs
    acc = f(acc, x)
  end
  acc
end

-- The successive results of reduce: one per element, init excluded.
--
--   scan((a, x) -> a + x, 0, [1, 2, 3]) --> [1, 3, 6]
defn scan(f, init, xs)
  out = fill(missing, length(xs))
  acc = init
  i = 0
  for x in xs
    acc = f(acc, x)
    i += 1
    out[i] = acc
  end
  out
end

-- From a to b, by step. Integers if all three are integers, else a + k * step.
--
--   range(1, 10, step = 3) --> [1, 4, 7, 10]
--   range(0, 1, step = 0.25) --> [0.0, 0.25, 0.5, 0.75, 1.0]
defn range(a, b, step = 1)
  if step == 0
    panic("range: step can't be 0.")
  end
  if floor(a) == a and floor(b) == b and floor(step) == step
    n = div(b - a, step) + 1
    [a + k * step for k in 0:n - 1]
  else
    span = (b - a) / step
    n = if span < -1e-9 0 else floor(span + 1e-9) + 1 end
    [a + k * step for k in 0:n - 1]
  end
end

defn _row(k, members, summary)
  if is_missing(summary)
    {key: k, values: members}
  else
    s = summary(members)
    if is_struct(s) _merge({key: k}, s) else {key: k, value: s} end
  end
end

-- The elements grouped by key, in order of first appearance of the keys.
--
--   group(mod(it, 2), [1, 2, 3]) --> [{key: 1, values: [1, 3]}, {key: 0, values: [2]}]
defn group(key, xs, summary = missing)
  n = length(xs)
  keys = fill(missing, n)
  ids = fill(0, n)
  count = 0
  i = 0
  for x in xs
    i += 1
    k = key(x)
    g = 0
    for j in 1:count
      if equal(keys[j], k)
        g = j
        break
      end
    end
    if g == 0
      count += 1
      keys[count] = k
      g = count
    end
    ids[i] = g
  end
  out = fill(missing, count)
  for g in 1:count
    members = [xs[p] for p in 1:n if ids[p] == g]
    out[g] = _row(keys[g], members, summary)
  end
  out
end

-- The positions of keys, from the largest key to the smallest. Stable merge sort.
defn _order(keys)
  n = length(keys)
  idx = [k for k in 1:n]
  tmp = fill(0, n)
  width = 1
  while width < n
    lo = 1
    while lo <= n
      mid = min(lo + width, n + 1)
      hi = min(lo + 2 * width, n + 1)
      i = lo
      j = mid
      k = lo
      while k < hi
        if i < mid and (j >= hi or not (keys[idx[j]] > keys[idx[i]]))
          tmp[k] = idx[i]
          i += 1
        else
          tmp[k] = idx[j]
          j += 1
        end
        k += 1
      end
      lo = hi
    end
    t = idx
    idx = tmp
    tmp = t
    width = 2 * width
  end
  idx
end

-- The n largest elements, largest first, or those with the largest by.
--
--   top(2, [5, 1, 9, 3]) --> [9, 5]
defn top(n, xs, by = missing)
  keys = if is_missing(by) xs else [by(x) for x in xs] end
  idx = _order(keys)
  m = min(n, length(xs))
  [xs[idx[k]] for k in 1:m]
end

sort_by(f, xs) = [xs[i] for i in order(map(f, xs))]
count(f, xs) = length(filter(f, xs))
flat_map(f, xs) = flatten(map(f, xs))

defn map_values(f, d)
  out = dict()
  for k in keys(d)
    out[k] = f(d[k])
  end
  out
end

-- A successful result.
--
--   Ok(1).value --> 1
struct Ok { value }

-- A failed result: the error is a value, returned rather than raised.
--
--   Err("no").error --> "no"
struct Err { error }

-- The next step of a result: f(v) for an Ok, the Err unchanged otherwise.
--
--   Ok(2) then and_then(x -> Ok(x + 1)) --> Ok(3)
--   Err("no") then and_then(x -> Ok(x + 1)) --> Err("no")
and_then(f, r) = match r
  Ok(v) -> f(v)
  else -> r
end

-- Applies f to the value of an Ok.
--
--   Ok(2) then map_ok(it + 1) --> Ok(3)
map_ok(f, r) = match r
  Ok(v) -> Ok(f(v))
  else -> r
end

-- Applies f to the error of an Err.
--
--   Err(2) then map_err(it + 1) --> Err(3)
map_err(f, r) = match r
  Err(e) -> Err(f(e))
  else -> r
end

-- The value of an Ok, or the default.
--
--   Err("no") then unwrap_or(0) --> 0
unwrap_or(default, r) = match r
  Ok(v) -> v
  else -> default
end

_error_text(e) = match e
  {message} -> message
  else -> text(e)
end

-- The value of an Ok. An Err is a bug here, and stops the fiber.
--
--   unwrap(Ok(1)) --> 1
--   unwrap(Err("no")) --> error
unwrap(r) = match r
  Ok(v) -> v
  Err(e) -> panic("unwrap on an error: $(_error_text(e))")
end

-- Is this result an Ok?
--
--   is_ok(Ok(1)) --> true
is_ok(r) = match r
  Ok(v) -> true
  else -> false
end

-- Is this result an Err?
--
--   is_err(Err(1)) --> true
is_err(r) = match r
  Err(e) -> true
  else -> false
end

-- An array of results as one result: Ok of all the values, or the first Err.
--
--   collect([Ok(1), Ok(2)]) --> Ok([1, 2])
--   collect([Ok(1), Err("a")]) --> Err("a")
defn collect(rs)
  errors = filter(is_err, rs)
  if length(errors) > 0 errors[1] else Ok(map(it.value, rs)) end
end

-- Like map, with one fiber per element: useful when f waits. A panic in f comes back as a panic here.
--
--   pmap(it * 2, [1, 2]) --> [2, 4]
pmap(f, xs) = map(unwrap, map(wait, map(x -> spawn(() -> f(x)), xs)))

-- One more, and one less. Both work on arrays, element by element.
--
--   inc(1) --> 2
inc(x) = x + 1

--   dec(1) --> 0
dec(x) = x - 1

-- The operators as functions, to pass to reduce or map.
--
--   reduce(add, 0, [1, 2, 3]) --> 6
add(a, b) = a + b

--   sub(5, 2) --> 3
sub(a, b) = a - b

--   reduce(mul, 1, [2, 3]) --> 6
mul(a, b) = a * b

--   is_zero(0) --> true
is_zero(x) = x == 0

--   is_pos(1) --> true
is_pos(x) = x > 0

--   is_neg(1) --> false
is_neg(x) = x < 0

--   is_even(2) --> true
is_even(x) = mod(x, 2) == 0

--   is_odd(2) --> false
is_odd(x) = mod(x, 2) != 0

--   is_some(0) --> true
is_some(x) = not is_missing(x)

--   identity(3) --> 3
identity(x) = x

-- A function that always gives x.
--
--   constantly(7)(1) --> 7
constantly(x) = y -> x

-- f after g, after h if there is one.
--
--   comp(inc, it * 2)(3) --> 7
comp(f, g, h = identity) = x -> f(g(h(x)))

-- f with its first argument given. As the collection comes last, this names a step of a pipeline.
--
--   partial(add, 2)(3) --> 5
partial(f, a) = x -> f(a, x)

--   complement(is_even)(3) --> true
complement(f) = x -> not f(x)

-- The results of several functions on one value.
--
--   juxt(inc, dec)(1) --> [2, 0]
defn juxt(f, g, h = missing)
  if is_missing(h) (x -> [f(x), g(x)]) else (x -> [f(x), g(x), h(x)]) end
end

-- x through up to four functions, in order.
--
--   pipe(1, inc, it * 3) --> 6
pipe(x, f, g = identity, h = identity, k = identity) = k(h(g(f(x))))

--   first([1, 2]) --> 1
first(xs) = if length(xs) == 0 missing else xs[1] end

--   second([1, 2]) --> 2
second(xs) = if length(xs) < 2 missing else xs[2] end

--   last([1, 2]) --> 2
last(xs) = if length(xs) == 0 missing else xs[length(xs)] end

--   rest([1, 2, 3]) --> [2, 3]
rest(xs) = skip(1, xs)

--   butlast([1, 2, 3]) --> [1, 2]
butlast(xs) = take(max(length(xs) - 1, 0), xs)

--   nth(2, [5, 6]) --> 6
nth(k, xs) = xs[k]

--   is_empty([]) --> true
is_empty(xs) = length(xs) == 0

--   prepend(1, [2]) --> [1, 2]
prepend(x, xs) = concat([x], xs)

--   take_last(2, [1, 2, 3]) --> [2, 3]
take_last(n, xs) = skip(max(length(xs) - n, 0), xs)

--   drop_last(2, [1, 2, 3]) --> [1]
drop_last(n, xs) = take(max(length(xs) - n, 0), xs)

defn _run_length(f, xs)
  for k in 1:length(xs)
    if not f(xs[k])
      return k - 1
    end
  end
  length(xs)
end

--   take_while(is_odd, [1, 3, 4, 5]) --> [1, 3]
take_while(f, xs) = take(_run_length(f, xs), xs)

--   drop_while(is_odd, [1, 3, 4, 5]) --> [4, 5]
drop_while(f, xs) = skip(_run_length(f, xs), xs)

-- The first element that f accepts, or missing.
--
--   find_first(is_even, [1, 2, 4]) --> 2
defn find_first(f, xs)
  for x in xs
    if f(x)
      return x
    end
  end
  missing
end

--   remove(is_even, [1, 2, 3]) --> [1, 3]
remove(f, xs) = filter(x -> not f(x), xs)

-- The results of f that aren't missing.
--
--   keep(x -> if x > 1 x * 2 else missing end, [1, 2, 3]) --> [4, 6]
keep(f, xs) = filter(is_some, map(f, xs))

--   map_indexed((k, x) -> k * x, [5, 6]) --> [5, 12]
map_indexed(f, xs) = [f(k, xs[k]) for k in 1:length(xs)]

--   interleave([1, 2], ["a", "b"]) --> [1, "a", 2, "b"]
interleave(a, b) = flatten([[a[k], b[k]] for k in 1:min(length(a), length(b))])

--   interpose(0, [1, 2]) --> [1, 0, 2]
interpose(sep, xs) = flatten([if k == 1 [xs[k]] else [sep, xs[k]] end for k in 1:length(xs)])

-- Does f accept every element? It stops at the first refusal.
--
--   every(is_odd, [1, 3]) --> true
defn every(f, xs)
  for x in xs
    if not f(x)
      return false
    end
  end
  true
end

--   some(is_odd, [2, 3]) --> true
some(f, xs) = not every(complement(f), xs)

-- n values: x, f(x), f(f(x)) and so on.
--
--   iterate(inc, 1, 3) --> [1, 2, 3]
defn iterate(f, x, n)
  out = fill(x, n)
  for k in 2:n
    out[k] = f(out[k - 1])
  end
  out
end

--   repeatedly(() -> 5, 2) --> [5, 5]
repeatedly(f, n) = [f() for k in 1:n]

-- How many times each value appears, in a dictionary.
--
--   frequencies(["a", "b", "a"])["a"] --> 2
defn frequencies(xs)
  out = dict()
  for x in xs
    out[x] = get_or(x, 0, out) + 1
  end
  out
end

--   min_by(abs, [-3, 1, 2]) --> 1
min_by(f, xs) = if length(xs) == 0 missing else xs[order(map(f, xs))[1]] end

--   max_by(abs, [-3, 1, 2]) --> -3
max_by(f, xs) = if length(xs) == 0 missing else xs[order(map(f, xs))[length(xs)]] end

-- A dictionary with f applied to the value of a key, which is missing if the key is absent.
--
--   update("a", inc, {"a": 1})["a"] --> 2
update(k, f, d) = put(k, f(get(k, d)), d)

-- Both dictionaries. For a key in both, b wins.
--
--   merge({"a": 1}, {"a": 2})["a"] --> 2
defn merge(a, b)
  out = a
  for k in keys(b)
    out[k] = b[k]
  end
  out
end

-- Both dictionaries. For a key in both, f combines the two values.
--
--   merge_with(add, {"a": 1}, {"a": 2})["a"] --> 3
defn merge_with(f, a, b)
  out = a
  for k in keys(b)
    out[k] = if has(k, out) f(out[k], b[k]) else b[k] end
  end
  out
end

--   length(select_keys(["a", "z"], {"a": 1, "b": 2})) --> 1
defn select_keys(ks, d)
  out = dict()
  for k in ks
    if has(k, d)
      out[k] = d[k]
    end
  end
  out
end

--   zipmap(["a", "b"], [1, 2])["b"] --> 2
zipmap(ks, vs) = dict([{key: ks[k], value: vs[k]} for k in 1:min(length(ks), length(vs))])

--   invert({"a": 1})[1] --> "a"
defn invert(d)
  out = dict()
  for k in keys(d)
    out[d[k]] = k
  end
  out
end

-- The value at the end of a path of keys, or missing.
--
--   get_in(["a", "b"], {"a": {"b": 2}}) --> 2
defn get_in(path, d)
  at = d
  for k in path
    if not is_dict(at)
      return missing
    end
    at = get(k, at)
  end
  at
end

-- A dictionary with a value at the end of a path of keys. The dictionaries on the way are created if they are absent.
--
--   put_in(["a", "b"], 3, dict())["a"]["b"] --> 3
defn put_in(path, value, d)
  k = path[1]
  if length(path) == 1
    return put(k, value, d)
  end
  inner = get(k, d)
  put(k, put_in(rest(path), value, if is_dict(inner) inner else dict() end), d)
end

--   update_in(["a"], inc, {"a": 1})["a"] --> 2
update_in(path, f, d) = put_in(path, f(get_in(path, d)), d)
