-- Web applications on http: routes, parameters, middleware, JSON, cookies, static files and templates.
use http
use json
use encode
use sys
use websocket as ws

app() = {routes: [], middleware: []}

_segments(path) = filter(s -> s != "", split("/", path))

defn route(method, pattern, handler, a)
  entry = {method: method, parts: _segments(pattern), handler: handler}
  {routes: push(entry, a.routes), middleware: a.middleware}
end

get(pattern, handler, a) = route("GET", pattern, handler, a)
post(pattern, handler, a) = route("POST", pattern, handler, a)
put_route(pattern, handler, a) = route("PUT", pattern, handler, a)
delete(pattern, handler, a) = route("DELETE", pattern, handler, a)
any_method(pattern, handler, a) = route("*", pattern, handler, a)

-- A middleware is f(next, request), and calls next(request) to go on.
wrap(f, a) = {routes: a.routes, middleware: push(f, a.middleware)}

-- Responses.
plain(s, status = 200) = {status: status, body: s, headers: [_type("text/plain; charset=utf-8")]}
html(s, status = 200) = {status: status, body: s, headers: [_type("text/html; charset=utf-8")]}
send_json(value, status = 200) = {status: status, body: json.text(value), headers: [_type("application/json")]}
redirect(url, status = 302) = {status: status, body: "", headers: [{name: "location", value: url}]}
not_found() = plain("Not Found", status = 404)
_type(value) = {name: "content-type", value: value}

defn with_header(name, value, response)
  headers = match response
    {headers} -> headers
    else -> []
  end
  out = response
  out.headers = push({name: name, value: value}, headers)
  out
end

defn set_cookie(name, value, response, options = "Path=/; HttpOnly; SameSite=Lax")
  with_header("set-cookie", "$name=$(encode.url_encode(value)); $options", response)
end

defn _cookies(headers)
  line = get_header("cookie", headers)
  out = dict()
  if is_missing(line)
    return out
  end
  for part in split(";", line)
    pair = split("=", trim(part))
    if length(pair) == 2
      out[pair[1]] = encode.url_decode(pair[2])
    end
  end
  out
end

get_header(name, headers) = http.header_value(name, headers)

-- Binds :name parts, and a final * takes what remains. The parameters, or missing if the path doesn't match.
defn _match(parts, path)
  out = dict()
  n = length(parts)
  for k in 1:n
    part = parts[k]
    if part == "*"
      out["*"] = join("/", skip(k - 1, path))
      return out
    end
    if k > length(path)
      return missing
    end
    if starts_with(":", part)
      out[byte_slice(2, byte_length(part), part)] = encode.url_decode(path[k])
    else if part != path[k]
      return missing
    end
  end
  if n == length(path) out else missing end
end

defn _enrich(request, params)
  {method: request.method, path: request.path, query: encode.parse_query(request.query), params: params,
   headers: request.headers, body: request.body, cookies: _cookies(request.headers)}
end

-- The body of a form, or of JSON.
form(request) = encode.parse_query(request.body)
body_json(request) = json.parse(request.body)

defn _result(value)
  match value
    Ok(v) -> v
    Err(e) -> plain("Internal Server Error", status = 500)
    else -> value
  end
end

defn _dispatch(a, request)
  path = _segments(request.path)
  allowed = false
  for r in a.routes
    params = _match(r.parts, path)
    if not is_missing(params)
      if r.method == "*" or r.method == request.method or (r.method == "GET" and request.method == "HEAD")
        return _result(r.handler(_enrich(request, params)))
      end
      allowed = true
    end
  end
  if allowed plain("Method Not Allowed", status = 405) else not_found() end
end

-- Built once: a request only goes through it.
defn _chain(a, k)
  if k == 0
    r -> _dispatch(a, r)
  else
    next = _chain(a, k - 1)
    f = a.middleware[k]
    r -> f(next, r)
  end
end

handler(a) = _chain(a, length(a.middleware))

-- Serves until a stop signal. Options go to http.serve.
defn serve(a, port = 8080, host = "127.0.0.1", timeout = http.default_timeout, max_body = http.default_max_body, wrap = http.plain)
  http.serve(handler(a), port = port, host = host, timeout = timeout, max_body = max_body, wrap = wrap)
end

-- A WebSocket route: on_message(text, send) runs for each message, and send(text) answers.
websocket(pattern, on_message, a, idle = ws.default_idle) = get(pattern, req -> ws.accept(req.headers, on_message, idle = idle), a)

-- Middleware.
defn logger(next, request)
  response = next(request)
  print("$(request.method) $(request.path) $(response.status)")
  response
end

defn cors(origin)
  (next, request) -> with_header("access-control-allow-origin", origin, next(request))
end

-- Static files under a folder. A path can't leave it.
_types = {"html": "text/html; charset=utf-8", "css": "text/css", "js": "text/javascript", "json": "application/json",
  "png": "image/png", "jpg": "image/jpeg", "svg": "image/svg+xml", "txt": "text/plain; charset=utf-8"}

defn file_response(path)
  parts = split(".", path)
  kind = get_or(lower(parts[length(parts)]), "application/octet-stream", _types)
  match sys.read(path)
    Ok(data) -> {status: 200, body: data, headers: [_type(kind)]}
    else -> not_found()
  end
end

defn static(prefix, folder, a)
  serve_file(request) = _static(folder, request.params["*"])
  get("$prefix/*", serve_file, a)
end

defn _static(folder, rest)
  if ".." in split("/", rest) or rest == ""
    not_found()
  else
    file_response("$folder/$rest")
  end
end

-- HTML: escape() for what comes from outside, and {{name}} in a template, escaped.
escape(s) = replace("'", "&#39;", replace("\"", "&quot;", replace(">", "&gt;", replace("<", "&lt;", replace("&", "&amp;", text(s))))))

-- One pass: a value that holds {{name}} isn't read again.
defn template(source, values)
  parts = split("{{", source)
  out = fill("", length(parts))
  out[1] = parts[1]
  for k in 2:length(parts)
    part = parts[k]
    close = byte_find("}}", 1, part)
    name = if is_missing(close) missing else trim(if close == 1 "" else byte_slice(1, close - 1, part) end) end
    if is_missing(name) or not has(name, values)
      out[k] = "{{$part"
    else
      rest = close + 2
      tail = if rest > byte_length(part) "" else byte_slice(rest, byte_length(part), part) end
      out[k] = "$(escape(values[name]))$tail"
    end
  end
  join("", out)
end
