-- Text forms of bytes: hexadecimal, Base64 and URLs.

_hex_digits = "0123456789abcdef"
_base64_digits = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
_digit(k, digits) = byte_slice(k + 1, k + 1, digits)

defn hex(s)
  join("", ["$(_digit(div(b, 16), _hex_digits))$(_digit(mod(b, 16), _hex_digits))" for b in bytes(s)])
end

defn _hex_value(b)
  if b >= 48 and b <= 57
    b - 48
  else if b >= 97 and b <= 102
    b - 87
  else if b >= 65 and b <= 70
    b - 55
  else
    missing
  end
end

_bad(what) = Err({kind: "encoding", message: "This isn't valid $what."})

defn unhex(s)
  codes = bytes(s)
  n = length(codes)
  if mod(n, 2) != 0
    return _bad("hexadecimal")
  end
  out = fill(0, div(n, 2))
  for k in 1:div(n, 2)
    high = _hex_value(codes[2 * k - 1])
    low = _hex_value(codes[2 * k])
    if is_missing(high) or is_missing(low)
      return _bad("hexadecimal")
    end
    out[k] = 16 * high + low
  end
  Ok(from_bytes(out))
end

defn base64(s)
  codes = bytes(s)
  n = length(codes)
  parts = fill("", div(n + 2, 3))
  k = 1
  while k <= n
    a = codes[k]
    b = if k + 1 <= n codes[k + 1] else 0 end
    d = if k + 2 <= n codes[k + 2] else 0 end
    word = a * 65536 + b * 256 + d
    one = _digit(div(word, 262144), _base64_digits)
    two = _digit(mod(div(word, 4096), 64), _base64_digits)
    three = if k + 1 <= n _digit(mod(div(word, 64), 64), _base64_digits) else "=" end
    four = if k + 2 <= n _digit(mod(word, 64), _base64_digits) else "=" end
    parts[div(k + 2, 3)] = "$one$two$three$four"
    k += 3
  end
  join("", parts)
end

defn _base64_value(b)
  if b >= 65 and b <= 90
    b - 65
  else if b >= 97 and b <= 122
    b - 71
  else if b >= 48 and b <= 57
    b + 4
  else if b == 43 or b == 45
    62
  else if b == 47 or b == 95
    63
  else
    missing
  end
end

-- Takes the standard alphabet and the one of URLs, with or without padding.
defn unbase64(s)
  clean = replace("=", "", s)
  codes = bytes(clean)
  n = length(codes)
  if mod(n, 4) == 1
    return _bad("Base64")
  end
  out = fill(0, div(n * 3, 4))
  used = 0
  word = 0
  bits = 0
  for code in codes
    v = _base64_value(code)
    if is_missing(v)
      return _bad("Base64")
    end
    word = word * 64 + v
    bits += 6
    if bits >= 8
      bits -= 8
      used += 1
      out[used] = mod(div(word, 2 ^ bits), 256)
      word = mod(word, 2 ^ bits)
    end
  end
  Ok(from_bytes(take(used, out)))
end

_url_safe(b) = (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or (b >= 48 and b <= 57) or b == 45 or b == 46 or b == 95 or b == 126

defn url_encode(s)
  join("", [if _url_safe(b) char(b) else "%$(upper(hex(from_bytes([b]))))" end for b in bytes(s)])
end

-- Decodes %41, and + as a space, as forms write it.
defn url_decode(s)
  if not contains("%", s) and not contains("+", s)
    return s
  end
  codes = bytes(s)
  n = length(codes)
  out = fill(0, n)
  used = 0
  k = 1
  while k <= n
    b = codes[k]
    used += 1
    if b == 37 and k + 2 <= n and not is_missing(_hex_value(codes[k + 1])) and not is_missing(_hex_value(codes[k + 2]))
      out[used] = 16 * _hex_value(codes[k + 1]) + _hex_value(codes[k + 2])
      k += 3
    else if b == 43
      out[used] = 32
      k += 1
    else
      out[used] = b
      k += 1
    end
  end
  from_bytes(take(used, out))
end

-- The fields of a query or a form: a=1&b=two
defn parse_query(s)
  out = dict()
  if s == ""
    return out
  end
  for part in split("&", s)
    pair = split("=", part)
    if pair[1] != ""
      value = if length(pair) >= 2 url_decode(join("=", skip(1, pair))) else "" end
      out[url_decode(pair[1])] = value
    end
  end
  out
end

-- SHA-1 is broken for signatures. It stays here because the WebSocket handshake asks for it.
defn sha1(s)
  m = bytes(s)
  n = length(m)
  padded = concat(concat(m, [128]), fill(0, mod(55 - n, 64)))
  size_bits = n * 8
  padded = concat(padded, [mod(div(size_bits, 256 ^ (8 - k)), 256) for k in 1:8])
  h = [1732584193, 4023233417, 2562383102, 271733878, 3285377520]
  mask = 4294967295
  rotate(x, k) = bit_and(bit_or(bit_shift(x, k), bit_shift(x, k - 32)), mask)
  for start in range(1, length(padded), step = 64)
    w = fill(0, 80)
    for t in 1:16
      at = start + 4 * (t - 1)
      w[t] = padded[at] * 16777216 + padded[at + 1] * 65536 + padded[at + 2] * 256 + padded[at + 3]
    end
    for t in 17:80
      w[t] = rotate(bit_xor(bit_xor(bit_xor(w[t - 3], w[t - 8]), w[t - 14]), w[t - 16]), 1)
    end
    a = h[1]
    b = h[2]
    d = h[3]
    e = h[4]
    f = h[5]
    for t in 1:80
      if t <= 20
        mix = bit_or(bit_and(b, d), bit_and(bit_and(bit_not(b), mask), e))
        k = 1518500249
      else if t <= 40
        mix = bit_xor(bit_xor(b, d), e)
        k = 1859775393
      else if t <= 60
        mix = bit_or(bit_or(bit_and(b, d), bit_and(b, e)), bit_and(d, e))
        k = 2400959708
      else
        mix = bit_xor(bit_xor(b, d), e)
        k = 3395469782
      end
      next = bit_and(rotate(a, 5) + mix + f + k + w[t], mask)
      f = e
      e = d
      d = rotate(b, 30)
      b = a
      a = next
    end
    h = [bit_and(h[1] + a, mask), bit_and(h[2] + b, mask), bit_and(h[3] + d, mask), bit_and(h[4] + e, mask), bit_and(h[5] + f, mask)]
  end
  from_bytes(flatten([[div(x, 16777216), mod(div(x, 65536), 256), mod(div(x, 256), 256), mod(x, 256)] for x in h]))
end
