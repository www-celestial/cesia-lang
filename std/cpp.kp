-- C++ has no stable binary interface, so Kepler reaches it through a small C layer, generated here, compiled once by
-- the C++ compiler and loaded with c. A C++ exception becomes a panic. Templates work through their concrete types.
use c
use sys

_types = {"i8": "int8_t", "u8": "uint8_t", "i16": "int16_t", "u16": "uint16_t", "i32": "int32_t", "u32": "uint32_t",
  "i64": "int64_t", "u64": "uint64_t", "f32": "float", "f64": "double", "bool": "bool", "ptr": "void *",
  "text": "const char *", "void": "void"}

-- What can be wrapped. call is the C++ name, when it isn't the name in Kepler.
fn(name, args, ret, call = missing) = {name: name, args: args, ret: ret, call: if is_missing(call) name else call end}
method(name, args, ret, call = missing) = fn(name, args, ret, call = call)
class(name, type, methods, new = []) = {name: name, type: type, methods: methods, new: new}

_arguments(types) = join(", ", ["a$k" for k in 1:length(types)])

defn _params(types, first)
  join(", ", concat(first, ["$(_types[types[k]]) a$k" for k in 1:length(types)]))
end

defn _body(ret, call)
  if ret == "void"
    "KP_TRY $call; KP_CATCH()"
  else if ret == "text"
    "KP_TRY kp_text = $call; return kp_text.c_str(); KP_CATCH(nullptr)"
  else
    "KP_TRY return $call; KP_CATCH(0)"
  end
end

_export(ret, name, params, body) = "$(_types[ret]) $name($params) { $body }"

defn _method(cls, m)
  object = "static_cast<$(cls.type) *>(self)"
  _export(m.ret, "$(cls.name)_$(m.name)", _params(m.args, ["void *self"]), _body(m.ret, "$object->$(m.call)($(_arguments(m.args)))"))
end

defn _class(cls)
  new = _export("ptr", "$(cls.name)_new", _params(cls.new, []), _body("ptr", "new $(cls.type)($(_arguments(cls.new)))"))
  delete = "void $(cls.name)_delete(void *self) { delete static_cast<$(cls.type) *>(self); }"
  join("\n", concat([new, delete], [_method(cls, m) for m in cls.methods]))
end

_function(f) = _export(f.ret, f.name, _params(f.args, []), _body(f.ret, "$(f.call)($(_arguments(f.args)))"))

-- The C++ source of the layer.
defn source(spec)
  includes = join("\n", ["#include $i" for i in spec.include])
  parts = concat([_class(cls) for cls in spec.classes], [_function(f) for f in spec.functions])
  "// Generated by std/cpp.kp.
#include <cstdint>
#include <exception>
#include <string>
$includes

static thread_local std::string kp_text, kp_error;
static thread_local bool kp_failed = false;
#define KP_TRY try {
#define KP_CATCH(value) } catch (const std::exception &e) { kp_failed = true; kp_error = e.what(); } \\
  catch (...) { kp_failed = true; kp_error = \"a C++ exception\"; } return value;

extern \"C\" {
const char *kp_take_error() { if (!kp_failed) return nullptr; kp_failed = false; return kp_error.c_str(); }
$(join("\n", parts))
}
"
end

defn _after(value, take_error)
  e = take_error()
  if is_missing(e) value else panic("C++: $e") end
end

defn _guard(f, n, t)
  match n
    0 -> () -> _after(f(), t)
    1 -> a -> _after(f(a), t)
    2 -> (a, b) -> _after(f(a, b), t)
    3 -> (a, b, d) -> _after(f(a, b, d), t)
    4 -> (a, b, d, e) -> _after(f(a, b, d, e), t)
    5 -> (a, b, d, e, g) -> _after(f(a, b, d, e, g), t)
    else -> panic("cpp: a function takes at most 5 arguments.")
  end
end

defn _bind(lib, take_error, name, args, ret)
  f = c.fn(name, args, ret, lib)?
  Ok(_guard(f, length(args), take_error))
end

defn _compile(compiler, cpp_file, library)
  r = sys.run(compiler, args = ["-std=c++20", "-shared", "-fPIC", "-O2", "-o", library, cpp_file])?
  if r.code == 0
    Ok(missing)
  else
    Err({kind: "cpp", message: r.err})
  end
end

-- Compiles what changed, loads it, and gives a dictionary of functions: "name", "Class.method", "Class.new".
defn wrap(spec, folder = ".", compiler = "c++")
  cpp_file = "$folder/$(spec.name)_kepler.cpp"
  library = "$folder/lib$(spec.name)_kepler.so"
  text = source(spec)
  same = sys.exists(cpp_file) and sys.exists(library) and unwrap_or("", sys.read(cpp_file)) == text
  if not same
    sys.write(cpp_file, text)?
    _compile(compiler, cpp_file, library)?
  end
  lib = c.open(library)?
  take_error = c.fn("kp_take_error", [], "text", lib)?
  out = dict()
  for f in spec.functions
    out[f.name] = _bind(lib, take_error, f.name, f.args, f.ret)?
  end
  for cls in spec.classes
    out["$(cls.name).new"] = _bind(lib, take_error, "$(cls.name)_new", cls.new, "ptr")?
    out["$(cls.name).delete"] = _bind(lib, take_error, "$(cls.name)_delete", ["ptr"], "void")?
    for m in cls.methods
      out["$(cls.name).$(m.name)"] = _bind(lib, take_error, "$(cls.name)_$(m.name)", concat(["ptr"], m.args), m.ret)?
    end
  end
  Ok(out)
end
